        (
          bucket.count /
          count
        ) *
        Math.abs(
          hitRate -
          avgProbability
        );
    });

    return {

      count,

      brier:
        brierSum / count,

      ece,

      averageProbability:
        predictedSum / count,

      hitRate:
        outcomeSum / count

    };
