   * Only the four markets that passed D74.
   *
   * Lambda weights exactly match current
   * production.
   */
  const markets = [

    {
      market: "Home Runs",
      columnName: "Home Runs",
      season: 1.00,
      recent: 0.00,
      type: "hitter"
    },

    {
      market: "Total Bases",
      columnName: "Total Bases",
      season: 1.00,
      recent: 0.00,
      type: "hitter"
    },

    {
      market: "Hits + Runs + RBIs",
      columnName: "Hits + Runs + RBIs",
      season: 0.95,
      recent: 0.05,
      type: "hitter"
    },

    {
      market: "Pitcher Earned Runs",
      columnName: "Pitcher Earned Runs",
      season: 0.60,
      recent: 0.40,
      type: "pitcher"
    }

  ];

  const thresholds = [
    0.5,
    1.5,
    2.5,
    3.5,
    4.5,
    5.5
  ];

  /*
   * Candidate shrinkage strengths.
   *
   * 0 = raw Poisson.
   * 0.50 = 50% shrinkage toward the
   * threshold-specific training base rate.
   */
  const strengths = [];

  for (
    let percent = 0;
    percent <= 50;
    percent += 5
  ) {

    strengths.push(
      percent / 100
    );
  }

  markets.forEach(market => {

    market.column =
      header.indexOf(
        market.columnName
      );

    if (market.column === -1) {
      throw new Error(
        `Required column "${market.columnName}" not found.`
      );
    }

  });

  /*
   * Build chronological player histories.
   */
  const playerGames = {};

  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    const row =
      values[i];

    const playerId =
      String(
        row[playerIdCol] || ""
      );

    if (!playerId) {
      continue;
    }

    if (!playerGames[playerId]) {
      playerGames[playerId] = [];
    }

    playerGames[playerId].push(row);
  }

  Object.values(playerGames)
    .forEach(games => {

      games.sort(
        (a, b) =>
          new Date(
            a[gameDateCol]
          ) -
          new Date(
            b[gameDateCol]
          )
      );

    });

  /*
   * P(X <= k)
   */
  function poissonCDF(
    k,
    lambda
  ) {

    if (
      !Number.isFinite(lambda) ||
      lambda < 0 ||
      k < 0
    ) {
      return 0;
    }

    let probability =
      Math.exp(-lambda);

    let sum =
      probability;

    for (
      let i = 1;
      i <= k;
      i++
    ) {

      probability *=
        lambda / i;

      sum +=
        probability;
    }

    return Math.min(
      1,
      Math.max(
        0,
        sum
      )
    );
  }

  function clampProbability(
    probability
  ) {

    return Math.min(
      0.999,
      Math.max(
        0.001,
        probability
      )
    );
  }

  function shrinkProbability(
    rawProbability,
    baseRate,
    strength
  ) {

    return clampProbability(
      (
        rawProbability *
        (1 - strength)
      ) +
      (
        baseRate *
        strength
      )
    );
  }

