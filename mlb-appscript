function isMLBTrendEligibleGame_(game) {
  if (!game) return false;

  const gameId =
    String(game.id || "").trim();

  const gameDate =
    getMLBGameAZDate_(game);

  /*
   * Permanently exclude the 2026 MLB All-Star Game.
   */
  if (
    gameId === "8712499" ||
    gameDate === "2026-07-14"
  ) {
    Logger.log(
      `Excluded 2026 MLB All-Star Game: ` +
      `Game ID ${gameId}, date ${gameDate}`
    );

    return false;
  }

  const homeTeam =
    getMLBTeamName_(
      game.home_team || {}
    );

  const awayTeam =
    getMLBTeamName_(
      game.away_team ||
      game.visitor_team ||
      {}
    );

  const searchableText = [
    homeTeam,
    awayTeam,
    game.name,
    game.title,
    game.description,
    game.game_type,
    game.type,
    game.season_type,
    game.status
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();

  const excludedTerms = [
    "all-star",
    "all star",
    "all-stars",
    "all stars",
    "american league",
    "national league",
    "exhibition",
    "spring training"
  ];

  const isExcluded =
    excludedTerms.some(term =>
      searchableText.includes(term)
    );

  if (isExcluded) {
    Logger.log(
      `Excluded non-trend MLB game ${gameId}: ` +
      `${awayTeam} at ${homeTeam}`
    );

    return false;
  }

  return true;
}

