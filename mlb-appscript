    if (!Number.isFinite(odds)) {
      return null;
    }

    if (odds === 0) {
      return null;
    }

    if (odds > 0) {
      return (
        100 /
        (odds + 100)
      );
    }

    return (
      Math.abs(odds) /
      (Math.abs(odds) + 100)
    );
  }


