  );

  const actualHeaders =
    sheet
      .getRange(
        1,
        1,
        1,
        expectedColumnCount
      )
      .getValues()[0];

  const headerMismatches = [];

  expectedHeaders.forEach(
    (expected, index) => {

      const actual =
        actualHeaders[index];

      if (
