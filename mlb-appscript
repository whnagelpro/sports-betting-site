              ) /
              baseline.mae
            ) * 100
          : 0;

      const rmseImprovement =
        baseline && baseline.rmse
          ? (
              (
                baseline.rmse -
                result.rmse
              ) /
              baseline.rmse
            ) * 100
          : 0;

      output.push([
        result.market,
        result.weights,
        result.seasonWeight,
        result.recentWeight,
        result.predictions,
        result.mae,
        result.rmse,
        maeImprovement,
        rmseImprovement,
        result === bestMAE
          ? "YES"
          : "",
        result === bestRMSE
          ? "YES"
          : ""
      ]);

    });

