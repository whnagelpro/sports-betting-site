      ).length,

    modeledMarketRows:
      modeledMarketRows,

    exactTrendMatches:
      exactTrendMatches,

    projectionEligibleRows:
      projectionEligibleRows,

    completeProjectionRows:
      completeProjectionRows,

    rowsWithProbabilityPair:
      rowsWithProbabilityPair,

    player37Present:
      targetProps.length > 0,

    results:
      results
  };


  Logger.log(
    JSON.stringify(
      summary,
      null,
      2
    )
