/**
 * ============================================================================
 * P13 D4 — MLB UNIVERSAL DECISION + TREND FIELDS
 * ============================================================================
 *
 * Builds universal Y:AG:
 *
 *   Y   Best Side
 *   Z   Best EV
 *   AA  Best Model Probability
 *   AB  Best Price Edge
 *   AC  Trend Score
 *   AD  Trend Strength
 *   AE  Risk Score
 *   AF  Risk Tier
 *   AG  Model Confidence
 *
 * IMPORTANT:
 * - Best Side is the mathematically strongest AVAILABLE EV side.
 * - This is NOT yet the final P15 actionable recommendation threshold.
 * - Missing data stays unavailable.
 * - Existing MLB trend/risk outputs are preserved.
 * - AH:AJ remain outside this helper and deferred to P15.
 * ============================================================================
 */


function americanOddsToImpliedProbabilityMLB_(
  americanOdds
) {
  if (
    americanOdds === "" ||
    americanOdds === null ||
    americanOdds === undefined
  ) {
    return null;
  }


  const odds =
    Number(
      americanOdds
    );


  if (
    !Number.isFinite(odds) ||
    odds === 0
  ) {
    return null;
  }


  if (odds > 0) {
    return (
      100 /
      (
        odds + 100
      )
    );
  }


  return (
    Math.abs(odds) /
    (
      Math.abs(odds) + 100
    )
  );
}


function getMLBTrendRowForProp_(
  playerId,
  propType,
  trendIndex
) {
  const normalizedPropType =
    normalizeMLBStatType_(
      propType
    );


  if (
    !playerId ||
    !normalizedPropType ||
    !trendIndex
  ) {
    return null;
  }


  return (
    trendIndex[
      `${String(playerId)}::${normalizedPropType}`
    ] || null
  );
}


function getNullableMLBNumericField_(
  row,
  fieldName
) {
  if (!row) {
    return null;
  }


  const rawValue =
    row[fieldName];


  if (
    rawValue === "" ||
    rawValue === null ||
    rawValue === undefined
  ) {
    return null;
  }


  const numericValue =
    Number(
      rawValue
    );


  return Number.isFinite(
    numericValue
  )
    ? numericValue
    : null;
}


function getNullableMLBTextField_(
  row,
  fieldName
) {
  if (!row) {
    return null;
  }


  const rawValue =
    row[fieldName];


  if (
    rawValue === "" ||
    rawValue === null ||
    rawValue === undefined
  ) {
    return null;
  }


  const textValue =
    String(
      rawValue
    ).trim();


  return textValue
    ? textValue
    : null;
}


function buildMLBUniversalDecisionTrendFields_({
  playerId,
  propType,
  modelProbOver,
  modelProbUnder,
  evOver,
  evUnder,
  overOdds,
  underOdds,
