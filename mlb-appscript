function getMLBObjectsFromSheet_(sheet) {
  const values = sheet.getDataRange().getValues();

  if (values.length < 2) return [];

  const headers = values[0];

  return values.slice(1).map(row => {
    const obj = {};

    headers.forEach((header, index) => {
      obj[header] = row[index];
    });

    return obj;
  });
}

function avgMLB_(values) {
  const nums = values
    .map(Number)
    .filter(value => !Number.isNaN(value));

  if (!nums.length) return 0;

  return nums.reduce((sum, value) => sum + value, 0) / nums.length;
}

function stdDevMLB_(values) {
  const nums = values
    .map(Number)
    .filter(value => !Number.isNaN(value));

  if (nums.length < 2) return 0;

  const mean = avgMLB_(nums);
  const variance = avgMLB_(nums.map(value => Math.pow(value - mean, 2)));

  return Math.sqrt(variance);
}

function consistencyScoreMLB_(values) {
  const mean = avgMLB_(values);

  if (!mean) return 0;

  const cv = stdDevMLB_(values) / mean;

  return Math.max(0, Math.min(100, 100 - cv * 100));
}

function trendScoreMLB_(recentAvg, seasonAvg) {
  if (!seasonAvg) return 0;

  return ((recentAvg - seasonAvg) / seasonAvg) * 100;
}

function trendDirectionMLB_(score) {
  if (score >= 7.5) return "Up";
  if (score <= -7.5) return "Down";

  return "Flat";
}

function riskTierMLB_(consistency, absTrendScore) {
  if (consistency >= 75 && absTrendScore <= 20) return "Low";
  if (consistency >= 55) return "Medium";

  return "High";
}

function normalizedTrendScoreMLB_(trendScore) {
  const score = Number(trendScore || 0);

  // Cap raw trend movement at +/- 50%
  // -50 = 0
  //   0 = 50
  // +50 = 100
  const capped = Math.max(-50, Math.min(50, score));

  return Math.max(
    0,
    Math.min(
      100,
      capped + 50
    )
  );
}


function trendStrengthScoreMLB_(strength) {
  const value = String(strength || "")
    .trim()
    .toLowerCase();

  if (value.includes("elite")) return 100;
  if (value.includes("strong")) return 80;
  if (value.includes("moderate")) return 60;
  if (value.includes("weak")) return 35;
  if (value.includes("cold")) return 15;

  return 0;
}


function riskScoreMLB_(riskTier) {
  const value = String(riskTier || "")
    .trim()
    .toLowerCase();

  if (value === "low") return 100;
  if (value === "medium") return 70;
  if (value === "high") return 35;

  return 50;
}


function sportacularScoreMLB_({
  normalizedTrendScore,
  consistency,
  hitRateLast5,
  hitRateLast10
}) {

  const trend = Math.max(
    0,
    Math.min(100, Number(normalizedTrendScore || 0))
  );

  const consistencyScore = Math.max(
    0,
    Math.min(100, Number(consistency || 0))
  );

  const hit5 = Math.max(
    0,
    Math.min(100, Number(hitRateLast5 || 0) * 100)
  );

  const hit10 = Math.max(
    0,
    Math.min(100, Number(hitRateLast10 || 0) * 100)
  );

  const score =
    trend * 0.30 +
    consistencyScore * 0.30 +
    hit5 * 0.20 +
    hit10 * 0.20;

  return Math.round(
    Math.max(0, Math.min(100, score)) * 10
  ) / 10;
}

function backtestMLBLambdaWeights() {

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const logsSheet =
    ss.getSheetByName("MLB Player Game Logs");

  if (!logsSheet) {
    throw new Error(
      'Sheet "MLB Player Game Logs" not found.'
    );
  }

  const values =
    logsSheet.getDataRange().getValues();

  if (values.length < 12) {
    throw new Error(
      "Not enough MLB Player Game Logs to run backtest."
    );
  }

  const header = values[0];

  const playerIdCol =
    header.indexOf("Player ID");

  const gameDateCol =
    header.indexOf("Game Date");

  if (
    playerIdCol === -1 ||
    gameDateCol === -1
  ) {
    throw new Error(
      "Required Player ID or Game Date column not found."
    );
  }

  const marketColumns = [
    ["Hits", "Hits"],
    ["Runs", "Runs"],
    ["RBIs", "RBIs"],
    ["Home Runs", "Home Runs"],
    ["Total Bases", "Total Bases"],
    ["Walks", "Walks"],
    ["Strikeouts", "Strikeouts"],
    ["Stolen Bases", "Stolen Bases"]
  ];

  const markets = marketColumns
    .map(([label, columnName]) => ({
      label,
      column:
        header.indexOf(columnName)
    }))
    .filter(market => market.column !== -1);

  if (!markets.length) {
    throw new Error(
      "No supported MLB stat columns found."
    );
  }

  const weightSets = [];

  for (
    let seasonPercent = 100;
    seasonPercent >= 0;
    seasonPercent -= 5
  ) {

    const seasonWeight =
      seasonPercent / 100;

    const recentWeight =
      1 - seasonWeight;

    weightSets.push({
      season: seasonWeight,
      recent: recentWeight
    });

  }

  const playerGames = {};

  for (let i = 1; i < values.length; i++) {

    const row = values[i];

    const playerId =
      String(row[playerIdCol] || "");

    if (!playerId) continue;

    if (!playerGames[playerId]) {
      playerGames[playerId] = [];
    }

    playerGames[playerId].push(row);
  }

  Object.values(playerGames)
    .forEach(games => {

      games.sort((a, b) => {

        return (
          new Date(a[gameDateCol]) -
          new Date(b[gameDateCol])
        );

      });

    });

  const results = [];

  markets.forEach(market => {

    weightSets.forEach(weights => {

      let absoluteError = 0;
      let squaredError = 0;
      let predictions = 0;

      Object.values(playerGames)
        .forEach(games => {

          /*
           * Require at least 11 previous games:
           *
           * - season-to-date average
           * - previous 10-game average
           * - then predict the NEXT game
           */

          for (
            let targetIndex = 11;
            targetIndex < games.length;
            targetIndex++
          ) {

            const previousGames =
              games.slice(0, targetIndex);

            const recentGames =
              previousGames.slice(-10);

            const seasonValues =
              previousGames
                .map(row =>
                  Number(row[market.column])
                )
                .filter(Number.isFinite);

            const recentValues =
              recentGames
                .map(row =>
                  Number(row[market.column])
                )
                .filter(Number.isFinite);

            const actual =
              Number(
                games[targetIndex][market.column]
              );

            if (
              !seasonValues.length ||
              !recentValues.length ||
              !Number.isFinite(actual)
            ) {
              continue;
            }

            const seasonAvg =
              seasonValues.reduce(
                (sum, value) => sum + value,
                0
              ) / seasonValues.length;

            const recentAvg =
              recentValues.reduce(
                (sum, value) => sum + value,
                0
              ) / recentValues.length;

            const prediction =
              (seasonAvg * weights.season) +
              (recentAvg * weights.recent);

            const error =
              prediction - actual;

            absoluteError +=
              Math.abs(error);

            squaredError +=
              error * error;

            predictions++;

          }

        });

      if (!predictions) return;

      const mae =
        absoluteError / predictions;

      const rmse =
        Math.sqrt(
          squaredError / predictions
        );

      results.push({
        market: market.label,
        seasonWeight: weights.season,
        recentWeight: weights.recent,
        predictions,
        mae,
        rmse
      });

    });

  });

  if (!results.length) {
    throw new Error(
      "Backtest produced no valid predictions."
    );
  }

  const seasonOnlyByMarket = {};

  results.forEach(result => {

    if (
      result.seasonWeight === 1 &&
      result.recentWeight === 0
    ) {
      seasonOnlyByMarket[result.market] =
        result;
    }

  });

  const bestByMarket = {};

  results.forEach(result => {

    const existing =
      bestByMarket[result.market];

    if (
      !existing ||
      result.mae < existing.mae
    ) {
      bestByMarket[result.market] =
        result;
    }

  });

  const outputSheetName =
    "MLB Model Backtest";

  let outputSheet =
    ss.getSheetByName(outputSheetName);

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(outputSheetName);
  }

  outputSheet.clearContents();

  const output = [[
    "Market",
    "Season Weight",
    "Last 10 Weight",
    "Predictions",
    "MAE",
    "RMSE",
    "MAE Improvement vs Season Only",
    "Best MAE?"
  ]];

  results.forEach(result => {

    const best =
      bestByMarket[result.market];

    const seasonOnly =
      seasonOnlyByMarket[result.market];

    let improvement = "";

    if (
      seasonOnly &&
      Number.isFinite(seasonOnly.mae) &&
      seasonOnly.mae > 0
    ) {

      improvement =
        (
          seasonOnly.mae -
          result.mae
        ) /
        seasonOnly.mae;

    }

    output.push([
      result.market,
      result.seasonWeight,
      result.recentWeight,
      result.predictions,
      result.mae,
      result.rmse,
      improvement,
      result === best ? "YES" : ""
    ]);

  });

  outputSheet
    .getRange(
      1,
      1,
      output.length,
      output[0].length
    )
    .setValues(output);

  outputSheet
    .getRange(
      2,
      2,
      output.length - 1,
      2
    )
    .setNumberFormat("0%");

  outputSheet
    .getRange(
      2,
      5,
      output.length - 1,
      2
    )
    .setNumberFormat("0.0000");

  outputSheet
    .getRange(
      2,
      7,
      output.length - 1,
      1
    )
    .setNumberFormat("0.000%");

  outputSheet.autoResizeColumns(
    1,
    output[0].length
  );

  Logger.log(
    "MLB Lambda weight backtest complete."
  );

}

function validateMLBThresholdCalibrationExpanded() {

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const logsSheet =
    ss.getSheetByName("MLB Player Game Logs");

  if (!logsSheet) {
    throw new Error(
      'Sheet "MLB Player Game Logs" not found.'
    );
  }

  const values =
    logsSheet.getDataRange().getValues();

  if (values.length < 12) {
    throw new Error(
      "Not enough MLB Player Game Logs for threshold calibration."
    );
  }

  const header = values[0];

  const playerIdCol =
    header.indexOf("Player ID");

  const gameDateCol =
    header.indexOf("Game Date");

  const pitcherOutsCol =
    header.indexOf("Pitcher Outs");

  if (
    playerIdCol === -1 ||
    gameDateCol === -1 ||
    pitcherOutsCol === -1
  ) {
    throw new Error(
      "Required Player ID, Game Date, or Pitcher Outs column not found."
    );
  }

  /*
   * Only the four markets that passed D74.
   *
   * Lambda weights exactly match current
   * production.
   */
  const markets = [

    {
      market: "Home Runs",
      columnName: "Home Runs",
      season: 1.00,
      recent: 0.00,
      type: "hitter"
    },

    {
      market: "Total Bases",
      columnName: "Total Bases",
      season: 1.00,
      recent: 0.00,
      type: "hitter"
    },

    {
      market: "Hits + Runs + RBIs",
      columnName: "Hits + Runs + RBIs",
      season: 0.95,
      recent: 0.05,
      type: "hitter"
    },

    {
      market: "Pitcher Earned Runs",
      columnName: "Pitcher Earned Runs",
      season: 0.60,
      recent: 0.40,
      type: "pitcher"
    }

  ];

  const thresholds = [
    0.5,
    1.5,
    2.5,
    3.5,
    4.5,
    5.5
  ];

  /*
   * Candidate shrinkage strengths.
   *
   * 0 = raw Poisson.
   * 0.50 = 50% shrinkage toward the
   * threshold-specific training base rate.
   */
  const strengths = [];

  for (
    let percent = 0;
    percent <= 100;
    percent += 5
  ) {

    strengths.push(
      percent / 100
    );
  }

  markets.forEach(market => {

    market.column =
      header.indexOf(
        market.columnName
      );

    if (market.column === -1) {
      throw new Error(
        `Required column "${market.columnName}" not found.`
      );
    }

  });

  /*
   * Build chronological player histories.
   */
  const playerGames = {};

  for (
    let i = 1;
    i < values.length;
    i++
  ) {

    const row =
      values[i];

    const playerId =
      String(
        row[playerIdCol] || ""
      );

    if (!playerId) {
      continue;
    }

    if (!playerGames[playerId]) {
      playerGames[playerId] = [];
    }

    playerGames[playerId].push(row);
  }

  Object.values(playerGames)
    .forEach(games => {

      games.sort(
        (a, b) =>
          new Date(
            a[gameDateCol]
          ) -
          new Date(
            b[gameDateCol]
          )
      );

    });

  /*
   * P(X <= k)
   */
  function poissonCDF(
    k,
    lambda
  ) {

    if (
      !Number.isFinite(lambda) ||
      lambda < 0 ||
      k < 0
    ) {
      return 0;
    }

    let probability =
      Math.exp(-lambda);

    let sum =
      probability;

    for (
      let i = 1;
      i <= k;
      i++
    ) {

      probability *=
        lambda / i;

      sum +=
        probability;
    }

    return Math.min(
      1,
      Math.max(
        0,
        sum
      )
    );
  }

  function clampProbability(
    probability
  ) {

    return Math.min(
      0.999,
      Math.max(
        0.001,
        probability
      )
    );
  }

  function shrinkProbability(
    rawProbability,
    baseRate,
    strength
  ) {

    return clampProbability(
      (
        rawProbability *
        (1 - strength)
      ) +
      (
        baseRate *
        strength
      )
    );
  }

  /*
   * Brier + ECE calculation.
   */
  function calculateMetrics(
    observations,
    transform
  ) {

    if (!observations.length) {
      return null;
    }

    let brierSum = 0;

    let predictedSum = 0;

    let outcomeSum = 0;

    const buckets =
      Array.from(
        { length: 10 },
        () => ({
          count: 0,
          probabilitySum: 0,
          outcomeSum: 0
        })
      );

    observations.forEach(obs => {

      const probability =
        transform(
          obs.probability
        );

      const outcome =
        obs.outcome;

      const error =
        probability -
        outcome;

      brierSum +=
        error * error;

      predictedSum +=
        probability;

      outcomeSum +=
        outcome;

      let bucketIndex =
        Math.floor(
          probability * 10
        );

      if (bucketIndex >= 10) {
        bucketIndex = 9;
      }

      if (bucketIndex < 0) {
        bucketIndex = 0;
      }

      const bucket =
        buckets[bucketIndex];

      bucket.count++;

      bucket.probabilitySum +=
        probability;

      bucket.outcomeSum +=
        outcome;
    });

    const count =
      observations.length;

    let ece = 0;

    buckets.forEach(bucket => {

      if (!bucket.count) {
        return;
      }

      const avgProbability =
        bucket.probabilitySum /
        bucket.count;

      const hitRate =
        bucket.outcomeSum /
        bucket.count;

      ece +=
        (
          bucket.count /
          count
        ) *
        Math.abs(
          hitRate -
          avgProbability
        );
    });

    return {

      count,

      brier:
        brierSum / count,

      ece,

      averageProbability:
        predictedSum / count,

      hitRate:
        outcomeSum / count

    };
  }

  const output = [];

  markets.forEach(market => {

    /*
     * Generate observations separately for
     * every threshold.
     */
    thresholds.forEach(line => {

      const observations = [];

      Object.values(playerGames)
        .forEach(allGames => {

          /*
           * Use the same hitter/pitcher
           * participation separation as D73/D74.
           */
          const games =
            allGames.filter(row => {

              const pitcherOuts =
                Number(
                  row[pitcherOutsCol]
                );

              if (
                market.type ===
                "pitcher"
              ) {

                return (
                  Number.isFinite(
                    pitcherOuts
                  ) &&
                  pitcherOuts > 0
                );
              }

              return (
                !Number.isFinite(
                  pitcherOuts
                ) ||
                pitcherOuts <= 0
              );
            });

          if (games.length < 12) {
            return;
          }

          for (
            let targetIndex = 11;
            targetIndex <
              games.length;
            targetIndex++
          ) {

            const previousGames =
              games.slice(
                0,
                targetIndex
              );

            const recentGames =
              previousGames.slice(-10);

            const actualRaw =
              games[targetIndex][
                market.column
              ];

            if (
              actualRaw === "" ||
              actualRaw === null ||
              actualRaw === undefined
            ) {
              continue;
            }

            const actual =
              Number(
                actualRaw
              );

            if (
              !Number.isFinite(
                actual
              )
            ) {
              continue;
            }

            const seasonValues =
              previousGames
                .map(row => {

                  const raw =
                    row[
                      market.column
                    ];

                  if (
                    raw === "" ||
                    raw === null ||
                    raw === undefined
                  ) {
                    return null;
                  }

                  const value =
                    Number(raw);

                  return Number.isFinite(
                    value
                  )
                    ? value
                    : null;
                })
                .filter(
                  Number.isFinite
                );

            const recentValues =
              recentGames
                .map(row => {

                  const raw =
                    row[
                      market.column
                    ];

                  if (
                    raw === "" ||
                    raw === null ||
                    raw === undefined
                  ) {
                    return null;
                  }

                  const value =
                    Number(raw);

                  return Number.isFinite(
                    value
                  )
                    ? value
                    : null;
                })
                .filter(
                  Number.isFinite
                );

            if (
              !seasonValues.length ||
              !recentValues.length
            ) {
              continue;
            }

            const seasonAvg =
              seasonValues.reduce(
                (sum, value) =>
                  sum + value,
                0
              ) /
              seasonValues.length;

            const recentAvg =
              recentValues.reduce(
                (sum, value) =>
                  sum + value,
                0
              ) /
              recentValues.length;

            const lambda =
              (
                seasonAvg *
                market.season
              ) +
              (
                recentAvg *
                market.recent
              );

            if (
              !Number.isFinite(
                lambda
              ) ||
              lambda < 0
            ) {
              continue;
            }

            const requiredCount =
              Math.floor(line) + 1;

            const probability =
              1 -
              poissonCDF(
                requiredCount - 1,
                lambda
              );

            observations.push({

              date:
                new Date(
                  games[
                    targetIndex
                  ][gameDateCol]
                ),

              probability:
                clampProbability(
                  probability
                ),

              outcome:
                actual >=
                  requiredCount
                    ? 1
                    : 0

            });

          }

        });

      if (
        observations.length < 100
      ) {
        return;
      }

      /*
       * GLOBAL chronological 75/25 split
       * separately for this exact
       * market + threshold.
