   * 0 = raw Poisson.
   * 0.50 = 50% shrinkage toward the
   * threshold-specific training base rate.
   */
  const strengths = [];

  for (
    let percent = 0;
    percent <= 50;
    percent += 5
  ) {

    strengths.push(
      percent / 100
    );
  }

  markets.forEach(market => {

