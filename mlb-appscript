}) {
  // --------------------------------------------------------------------------
  // TREND / RISK / CONFIDENCE
  // --------------------------------------------------------------------------

  const trendRow =
    getMLBTrendRowForProp_(
      playerId,
      propType,
      trendIndex
    );


  // Prefer the normalized numeric trend output already generated by MLB.
  // Fall back to the original Trend Score only if needed.
  let trendScore =
    getNullableMLBNumericField_(
      trendRow,
      "Normalized Trend Score"
    );


  if (trendScore === null) {
    trendScore =
      getNullableMLBNumericField_(
        trendRow,
        "Trend Score"
      );
  }


  // Universal AD is a descriptive strength field.
  // Preserve the existing MLB Trend Strength label.
  const trendStrength =
    getNullableMLBTextField_(
      trendRow,
      "Trend Strength"
    );


  // MLB already has a numeric Risk Score in its validated trends pipeline.
  const riskScore =
    getNullableMLBNumericField_(
      trendRow,
      "Risk Score"
    );


  const riskTier =
    getNullableMLBTextField_(
      trendRow,
      "Risk Tier"
    );


  let modelConfidence = null;


  if (trendRow) {
    const calculatedConfidence =
      calculateTrendConfidence_(
        trendRow
      );


    if (
      calculatedConfidence !== null &&
      calculatedConfidence !== undefined &&
      Number.isFinite(
        Number(
          calculatedConfidence
        )
      )
    ) {
      modelConfidence =
        Number(
          calculatedConfidence
        );
    }
  }


  // --------------------------------------------------------------------------
  // DECISION FIELDS
  // --------------------------------------------------------------------------

  const overAvailable =
    evOver !== null &&
    evOver !== undefined &&
    Number.isFinite(
      Number(evOver)
    ) &&
    modelProbOver !== null &&
    modelProbOver !== undefined &&
    Number.isFinite(
      Number(modelProbOver)
    );


  const underAvailable =
    evUnder !== null &&
    evUnder !== undefined &&
    Number.isFinite(
      Number(evUnder)
    ) &&
    modelProbUnder !== null &&
    modelProbUnder !== undefined &&
    Number.isFinite(
      Number(modelProbUnder)
    );


  let bestSide =
    "No Play";

  let bestEV =
    null;

  let bestModelProbability =
    null;

  let selectedOdds =
    null;


  if (
    overAvailable &&
    underAvailable
  ) {
    if (
      Number(evOver) >=
      Number(evUnder)
    ) {
      bestSide =
        "Over";

      bestEV =
        Number(evOver);

      bestModelProbability =
        Number(modelProbOver);

      selectedOdds =
        overOdds;

    } else {

      bestSide =
        "Under";

      bestEV =
        Number(evUnder);

      bestModelProbability =
        Number(modelProbUnder);

      selectedOdds =
        underOdds;
    }

  } else if (overAvailable) {

    bestSide =
      "Over";

    bestEV =
      Number(evOver);

    bestModelProbability =
      Number(modelProbOver);

    selectedOdds =
      overOdds;

  } else if (underAvailable) {

    bestSide =
      "Under";

    bestEV =
      Number(evUnder);

    bestModelProbability =
      Number(modelProbUnder);

    selectedOdds =
      underOdds;
  }


  // --------------------------------------------------------------------------
  // BEST PRICE EDGE
  //
  // Selected-side model probability minus sportsbook implied probability.
  // --------------------------------------------------------------------------

  let bestPriceEdge =
    null;


  if (
    bestSide !== "No Play" &&
    bestModelProbability !== null
  ) {
    const impliedProbability =
      americanOddsToImpliedProbabilityMLB_(
        selectedOdds
      );


    if (
      impliedProbability !== null
    ) {
      bestPriceEdge =
        bestModelProbability -
        impliedProbability;
    }
  }


  return {
    bestSide,
    bestEV,
    bestModelProbability,
    bestPriceEdge,
    trendScore,
    trendStrength,
    riskScore,
    riskTier,
    modelConfidence
  };
}

