/**
 * ============================================================================
 * P13 D3 — MLB UNIVERSAL PLAYER PROP PROBABILITY + EV
 * ============================================================================
 *
 * Builds universal U:X:
 *
 *   U Model Prob Over
 *   V Model Prob Under
 *   W EV Over
 *   X EV Under
 *
 * Uses the already-validated MLB projection from P13 D2.
 *
 * Supported MLB Player Props are discrete count markets, so Poisson is used.
 *
 * IMPORTANT:
 * - Half-point line: Over/Under probabilities sum to 1.
 * - Integer line: equality is a PUSH and is excluded from both win probs.
 * - Unsupported / unavailable inputs remain null.
 * ============================================================================
 */


function poissonCDFMLB_(k, lambda) {
  if (
    !Number.isFinite(lambda) ||
    lambda < 0
  ) {
    return null;
  }

  if (k < 0) {
    return 0;
  }

  const floorK =
    Math.floor(k);

  let probability =
    Math.exp(-lambda);

  let sum =
    probability;

  for (
    let i = 1;
    i <= floorK;
    i++
  ) {
    probability *=
      lambda / i;

    sum +=
      probability;
  }

  return Math.min(
    1,
    Math.max(
      0,
      sum
    )
  );
}


function poissonPMFMLB_(k, lambda) {
  if (
    !Number.isFinite(lambda) ||
    lambda < 0 ||
    !Number.isInteger(k) ||
    k < 0
  ) {
    return 0;
  }

  let probability =
    Math.exp(-lambda);

  for (
    let i = 1;
    i <= k;
    i++
  ) {
    probability *=
      lambda / i;
  }

  return probability;
}


function getMLBPoissonSideProbabilities_(
  projectedStat,
  lineValue
) {
  if (
    projectedStat === null ||
    projectedStat === undefined ||
    projectedStat === "" ||
    lineValue === null ||
    lineValue === undefined ||
    lineValue === ""
  ) {
    return {
      overProbability: null,
      underProbability: null,
      pushProbability: null
    };
  }
  const lambda =
    Number(
      projectedStat
    );

  const line =
    Number(
      lineValue
    );


  if (
    !Number.isFinite(lambda) ||
    lambda < 0 ||
    !Number.isFinite(line) ||
    line < 0
  ) {
    return {
      overProbability: null,
      underProbability: null,
      pushProbability: null
    };
  }


  const isIntegerLine =
    Number.isInteger(line);


  // --------------------------------------------------------------------------
  // INTEGER LINE
  //
  // Example 1.0:
  //   Over wins on 2+
  //   Under wins on 0
  //   Exactly 1 = push
  // --------------------------------------------------------------------------

  if (isIntegerLine) {
    const pushCount =
      line;

    const underProbability =
      poissonCDFMLB_(
        pushCount - 1,
        lambda
      );

    const pushProbability =
      poissonPMFMLB_(
        pushCount,
        lambda
      );

    const overProbability =
      1 -
      poissonCDFMLB_(
        pushCount,
        lambda
      );


    return {
      overProbability:
        Math.max(
          0,
          Math.min(
            1,
            overProbability
          )
        ),

      underProbability:
        Math.max(
          0,
          Math.min(
            1,
            underProbability
          )
        ),

      pushProbability:
        Math.max(
          0,
          Math.min(
            1,
            pushProbability
          )
        )
    };
  }


  // --------------------------------------------------------------------------
  // NON-INTEGER / HALF-POINT LINE
  //
  // Example 1.5:
  //   Over wins on 2+
  //   Under wins on 0 or 1
  //   No push
  // --------------------------------------------------------------------------

  const underMax =
    Math.floor(line);

  const underProbability =
    poissonCDFMLB_(
      underMax,
      lambda
    );

  const overProbability =
    1 -
    underProbability;


  return {
    overProbability:
      Math.max(
        0,
        Math.min(
          1,
          overProbability
        )
      ),

    underProbability:
      Math.max(
        0,
        Math.min(
          1,
          underProbability
        )
      ),

    pushProbability:
      0
  };
}


function americanOddsToDecimalMLB_(americanOdds) {
  if (
    americanOdds === "" ||
    americanOdds === null ||
    americanOdds === undefined
  ) {
    return null;
  }

  const odds =
    Number(
      americanOdds
    );

  if (
    !Number.isFinite(odds) ||
    odds === 0
  ) {
    return null;
  }


  if (odds > 0) {
    return (
      1 +
      odds / 100
    );
  }


  return (
    1 +
    100 / Math.abs(odds)
  );
}


function calculateMLBExpectedValue_(
  winProbability,
  americanOdds,
  pushProbability
) {
  if (
    winProbability === null ||
    winProbability === undefined ||
    !Number.isFinite(
      Number(winProbability)
    )
  ) {
    return null;
  }


  const decimalOdds =
    americanOddsToDecimalMLB_(
      americanOdds
    );


  if (decimalOdds === null) {
    return null;
  }


  const winProb =
    Number(
      winProbability
    );

  const pushProb =
    (
      pushProbability === null ||
      pushProbability === undefined
    )
      ? 0
      : Number(
          pushProbability
        );


  if (
    !Number.isFinite(winProb) ||
    winProb < 0 ||
    winProb > 1 ||
    !Number.isFinite(pushProb) ||
    pushProb < 0 ||
    pushProb > 1
  ) {
    return null;
  }


  const loseProbability =
    Math.max(
      0,
      1 -
      winProb -
      pushProb
    );


  // $1 stake:
  //
  // win  -> profit = decimalOdds - 1
  // lose -> profit = -1
  // push -> profit = 0
  return (
    winProb *
    (
      decimalOdds -
      1
    )
  ) -
  loseProbability;
}


function buildMLBUniversalPropProbabilityEV_({
  propType,
  projectedStat,
  lineValue,
  overOdds,
  underOdds,
  currentGames,
  statStdDev
}) {
  const normalizedPropType =
    normalizeMLBStatType_(
      propType
    );


  const supported =
    Object.prototype.hasOwnProperty.call(
      MLB_PROP_PROJECTION_WEIGHTS,
      normalizedPropType
    );


  if (!supported) {
    return {
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null,
      pushProbability: null,
      probabilityReliability: null
    };
  }


  if (
    projectedStat === "" ||
    projectedStat === null ||
    projectedStat === undefined ||
    lineValue === "" ||
    lineValue === null ||
    lineValue === undefined
  ) {
    return {
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null,
      pushProbability: null,
      probabilityReliability: null
    };
  }


  // --------------------------------------------------------------------------
  // RAW MLB POISSON PROBABILITIES
  // --------------------------------------------------------------------------

  const probabilities =
    getMLBPoissonSideProbabilities_(
      projectedStat,
      lineValue
    );


  if (
    probabilities.overProbability === null ||
    probabilities.underProbability === null
  ) {
    return {
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null,
      pushProbability: null,
      probabilityReliability: null
    };
  }


  // --------------------------------------------------------------------------
  // D10AB — MLB PROBABILITY RELIABILITY
  //
  // Pull extreme raw Poisson probabilities toward 50% when the historical
  // sample and/or volatility do not justify full confidence.
  // --------------------------------------------------------------------------

  const probabilityReliability =
    getMLBPropProbabilityReliability_({
      currentGames,
      projectedStat,
      statStdDev
    });


  // --------------------------------------------------------------------------
  // D10AB — PUSH-AWARE PROBABILITY CALIBRATION
  //
  // For half-point lines:
  //   pushProbability = 0
  //   Over + Under = 1
  //
  // For integer lines:
  //   some probability mass belongs to the push.
  //   We therefore calibrate Over/Under CONDITIONAL on there being a decision,
  //   then scale them back into the available non-push probability mass.
  //
  // This guarantees:
  //
  //   calibratedOver +
  //   calibratedUnder +
  //   pushProbability
  //   = 1
  // --------------------------------------------------------------------------

  const pushProbability =
    Number.isFinite(
      Number(
        probabilities.pushProbability
      )
    )
      ? Math.max(
          0,
          Math.min(
            1,
            Number(
              probabilities.pushProbability
            )
          )
        )
      : 0;


  const decisionProbability =
    Math.max(
      0,
      1 -
      pushProbability
    );


  let calibratedOverProbability =
    null;


  let calibratedUnderProbability =
    null;


  if (decisionProbability > 0) {

    // Convert the raw probabilities into probabilities conditional on
    // the wager producing a win/loss decision rather than a push.

    const conditionalOverProbability =
      probabilities.overProbability /
      decisionProbability;


    const conditionalUnderProbability =
      probabilities.underProbability /
      decisionProbability;


    const calibratedConditionalOver =
      calibrateMLBPropProbability_(
        conditionalOverProbability,
        probabilityReliability
      );


    const calibratedConditionalUnder =
      calibrateMLBPropProbability_(
        conditionalUnderProbability,
        probabilityReliability
      );


    if (
      calibratedConditionalOver !== null &&
      calibratedConditionalUnder !== null
    ) {

      // Scale the calibrated decision probabilities back into the
      // original non-push probability mass.

      calibratedOverProbability =
        calibratedConditionalOver *
        decisionProbability;


      calibratedUnderProbability =
        calibratedConditionalUnder *
        decisionProbability;
    }
  }

  if (
    calibratedOverProbability === null ||
    calibratedUnderProbability === null
  ) {
    return {
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null,
      pushProbability:
        probabilities.pushProbability,
      probabilityReliability
    };
  }


  // --------------------------------------------------------------------------
  // EV MUST USE THE CALIBRATED PROBABILITIES
  // --------------------------------------------------------------------------

  const evOver =
    calculateMLBExpectedValue_(
      calibratedOverProbability,
      overOdds,
      probabilities.pushProbability
    );


  const evUnder =
    calculateMLBExpectedValue_(
      calibratedUnderProbability,
      underOdds,
      probabilities.pushProbability
    );


  return {
    modelProbOver:
      calibratedOverProbability,

    modelProbUnder:
      calibratedUnderProbability,

    evOver,

    evUnder,

    pushProbability:
      probabilities.pushProbability,

    probabilityReliability
  };
}

