function getMLBHistoricalStatValue_(row, normalizedPropType) {
  if (!row) return null;

  const valueByMarket = {
    hits:
      row["Hits"],

    runs:
      row["Runs"],

    rbis:
      row["RBIs"],

    home_runs:
      row["Home Runs"],

    total_bases:
      row["Total Bases"],

    walks:
      row["Walks"],

    strikeouts:
      row["Strikeouts"],

    stolen_bases:
      row["Stolen Bases"],

    hits_runs_rbis:
      (
        Number(row["Hits"]) +
        Number(row["Runs"]) +
        Number(row["RBIs"])
      ),

    pitcher_strikeouts:
      row["Pitcher Strikeouts"],

    pitcher_outs:
      row["Pitcher Outs"],

    pitcher_earned_runs:
      row["Pitcher Earned Runs"],

    pitcher_hits_allowed:
      row["Pitcher Hits Allowed"],

    pitcher_walks:
      row["Pitcher Walks"]
  };


  if (
    !Object.prototype.hasOwnProperty.call(
      valueByMarket,
      normalizedPropType
    )
  ) {
    return null;
  }


  const rawValue =
    valueByMarket[
      normalizedPropType
    ];


  if (
    rawValue === "" ||
    rawValue === null ||
    rawValue === undefined
  ) {
    return null;
  }


  const numericValue =
    Number(rawValue);


  return Number.isFinite(numericValue)
    ? numericValue
    : null;
}


function buildMLBPlayerPropHistoryIndex_() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName(
      "MLB Player Game Logs"
    );

  if (!sheet) {
    throw new Error(
      'Sheet "MLB Player Game Logs" not found.'
    );
  }


  const values =
    sheet.getDataRange().getValues();

  if (values.length < 2) {
    return {};
  }


  const headers =
    values[0];

  const playerIdIndex =
    headers.indexOf(
      "Player ID"
    );

  const gameDateIndex =
    headers.indexOf(
      "Game Date"
    );


  if (playerIdIndex === -1) {
    throw new Error(
      'Column "Player ID" not found in MLB Player Game Logs.'
    );
  }


  const historyIndex = {};


  for (
    let rowIndex = 1;
    rowIndex < values.length;
    rowIndex++
  ) {
    const valuesRow =
      values[rowIndex];

    const playerId =
      String(
        valuesRow[playerIdIndex] ?? ""
      ).trim();


    if (!playerId) {
      continue;
    }


    const row = {};

    headers.forEach(
      (header, columnIndex) => {
        row[header] =
          valuesRow[columnIndex];
      }
    );


    if (!historyIndex[playerId]) {
      historyIndex[playerId] = [];
    }


    historyIndex[playerId].push(
      row
    );
  }


  // Keep history chronological.
  if (gameDateIndex !== -1) {
    Object.keys(historyIndex).forEach(
      playerId => {
        historyIndex[playerId].sort(
          (a, b) => {
            const aTime =
              new Date(
                a["Game Date"]
              ).getTime();

            const bTime =
              new Date(
                b["Game Date"]
              ).getTime();


            if (
              !Number.isFinite(aTime) ||
              !Number.isFinite(bTime)
            ) {
              return 0;
            }


            return aTime - bTime;
          }
        );
      }
    );
  }


  return historyIndex;
}


