 */
function testMLBFrontendPlayerPropsConsumerContract_D10AR() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Player Props");

  if (!sheet) {
    throw new Error('D10AR: "Player Props" sheet was not found.');
  }

  const EXPECTED_HEADERS = [
    "Game Id",
    "Game Date",
    "Away Team",
    "Home Team",
    "Id",
    "Player Id",
    "Vendor",
    "Prop Type",
    "Line Value",
    "Type",
    "Odds",
    "Updated At",
