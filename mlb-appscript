            a[gameDateCol]
          ) -
          new Date(
            b[gameDateCol]
          )
      );

    });

  /*
   * P(X <= k)
   */
  function poissonCDF(
    k,
    lambda
  ) {

    if (
      !Number.isFinite(lambda) ||
      lambda < 0 ||
      k < 0
    ) {
      return 0;
    }

    let probability =
      Math.exp(-lambda);

    let sum =
      probability;

    for (
      let i = 1;
      i <= k;
      i++
    ) {

      probability *=
        lambda / i;

      sum +=
        probability;
    }

    return Math.min(
      1,
      Math.max(
        0,
        sum
      )
    );
  }

