    if (
      !Number.isFinite(probability) ||
      !Number.isFinite(odds) ||
      odds === 0
    ) {
      return null;
    }

    const profit =
      odds > 0
        ? odds / 100
        : 100 / Math.abs(odds);

    return (
      probability * profit -
