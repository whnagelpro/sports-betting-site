        finiteOrNull_(
          row["Stat Std Dev"]
        );


      const epsilon =
        1e-9;


      const baselineMatches =
        liveBaseline !== null &&
        Math.abs(
          liveBaseline -
          Number(
            context.playerBaseline
          )
        ) <= epsilon;


      const trendMatches =
        liveTrendAdjustment !== null &&
        Math.abs(
          liveTrendAdjustment -
          Number(
            context.trendAdjustment
          )
        ) <= epsilon;


      const projectedMatches =
        liveProjectedStat !== null &&
        Math.abs(
          liveProjectedStat -
          Number(
            context.projectedStat
          )
        ) <= epsilon;


      const expectedStdDev =
        context.statStdDev;


      const stdDevMatches =
        expectedStdDev === null
          ? liveStdDev === null
          : (
              liveStdDev !== null &&
              Math.abs(
                liveStdDev -
                Number(
                  expectedStdDev
                )
              ) <= epsilon
            );


      if (
        baselineMatches &&
        trendMatches &&
        projectedMatches &&
        stdDevMatches
      ) {

        projectionParityRows++;

      } else {

        projectionParityViolations.push({
          row:
            index + 2,

