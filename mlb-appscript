// ------------------------------------------------------
// MAIN MOTHER PIPELINE
// ------------------------------------------------------

function runMLBDailyAnalyticsPipeline() {

  clearMLBDailyAnalyticsContinuationTriggers_();

  const state =
    getMLBDailyAnalyticsState_();

  Logger.log(
    `MLB mother pipeline starting/resuming. Stage: ${state.stage}`
  );


  // ====================================================
  // PLAYER GAME LOGS
  // ====================================================

  if (
    state.stage ===
    "PLAYER_GAME_LOGS"
  ) {

    if (
      state.playerMonthIndex <
      MLB_DAILY_PLAYER_GAME_LOG_JOBS.length
    ) {

      const job =
        MLB_DAILY_PLAYER_GAME_LOG_JOBS[
          state.playerMonthIndex
        ];

      const success =
        runMLBDailyAnalyticsStep_(
          state,
          job.name,
          job.fn
        );

      if (!success) {
        return;
      }

      state.playerMonthIndex += 1;

      saveMLBDailyAnalyticsState_(
        state
      );

      scheduleMLBDailyAnalyticsContinuation_();

      return;

    }

    state.stage =
      "TEAM_GAME_LOGS";

    saveMLBDailyAnalyticsState_(
      state
    );

  }


  // ====================================================
  // TEAM GAME LOGS
  // ====================================================

  if (
    state.stage ===
    "TEAM_GAME_LOGS"
  ) {

    if (
      state.teamMonthIndex <
      MLB_DAILY_TEAM_GAME_LOG_JOBS.length
    ) {

      const job =
        MLB_DAILY_TEAM_GAME_LOG_JOBS[
          state.teamMonthIndex
        ];

      const success =
        runMLBDailyAnalyticsStep_(
          state,
          job.name,
          job.fn
        );

      if (!success) {
        return;
      }

      state.teamMonthIndex += 1;

      saveMLBDailyAnalyticsState_(
        state
      );

      scheduleMLBDailyAnalyticsContinuation_();

      return;

    }

    state.stage =
      "PLAYER_SEASON_STATS";

    saveMLBDailyAnalyticsState_(
      state
    );

  }


  // ====================================================
  // PLAYER SEASON STATS
  // ====================================================

  if (
    state.stage ===
    "PLAYER_SEASON_STATS"
  ) {

    const success =
      runMLBDailyAnalyticsStep_(
        state,
        "Player Season Stats",
        refreshMLBPlayerSeasonStatsSheet
      );

    if (!success) {
      return;
    }

    state.stage =
      "TEAM_SEASON_STATS";

    saveMLBDailyAnalyticsState_(
      state
    );

  }


  // ====================================================
  // TEAM SEASON STATS
  // ====================================================

  if (
    state.stage ===
    "TEAM_SEASON_STATS"
  ) {

    const success =
      runMLBDailyAnalyticsStep_(
        state,
        "Team Season Stats",
        refreshMLBTeamSeasonStatsSheet
      );

    if (!success) {
      return;
    }

    state.stage =
      "PLAYER_TRENDS";

    saveMLBDailyAnalyticsState_(
      state
    );

  }


  // ====================================================
  // PLAYER TRENDS
  // ====================================================

  if (
    state.stage ===
    "PLAYER_TRENDS"
  ) {

    const success =
      runMLBDailyAnalyticsStep_(
        state,
        "Player Trends",
        refreshMLBPlayerTrendsSheet
      );

    if (!success) {
      return;
    }

    state.stage =
      "TEAM_TRENDS";

    saveMLBDailyAnalyticsState_(
      state
    );

  }


  // ====================================================
  // TEAM TRENDS
  // ====================================================

  if (
    state.stage ===
    "TEAM_TRENDS"
  ) {

    const success =
      runMLBDailyAnalyticsStep_(
        state,
        "Team Trends",
        refreshMLBTeamTrendsOutputSheet
      );

    if (!success) {
      return;
    }

    state.stage =
      "TOP_PLAYER_TRENDS";

    saveMLBDailyAnalyticsState_(
      state
    );

  }


  // ====================================================
  // TOP PLAYER TRENDS
  // ====================================================

  if (
    state.stage ===
    "TOP_PLAYER_TRENDS"
  ) {

    const success =
      runMLBDailyAnalyticsStep_(
        state,
        "Top Player Trends",
        refreshMLBTopPlayerTrendsSheet
      );

    if (!success) {
      return;
    }

    state.stage =
      "TOP_TEAM_TRENDS";

    saveMLBDailyAnalyticsState_(
      state
    );

  }


  // ====================================================
  // TOP TEAM TRENDS
  // ====================================================

  if (
    state.stage ===
    "TOP_TEAM_TRENDS"
  ) {

    const success =
      runMLBDailyAnalyticsStep_(
        state,
        "Top Team Trends",
        refreshMLBTopTeamTrendsSheet
      );

    if (!success) {
      return;
    }

    state.stage =
      "COMPLETE";

    state.completed =
      true;

    saveMLBDailyAnalyticsState_(
      state
    );

  }


  // ====================================================
  // COMPLETE
  // ====================================================

  if (
    state.stage ===
    "COMPLETE"
  ) {

    clearMLBDailyAnalyticsContinuationTriggers_();

    Logger.log(
      "MLB DAILY ANALYTICS MOTHER PIPELINE COMPLETE."
    );

  }

}


