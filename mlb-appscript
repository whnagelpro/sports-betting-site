  const rawRows = [];
  const helperRows = [];
  const seenOddsIds = new Set();

  odds.forEach(item => {
    const gameId = String(item.game_id || "");
    const gameInfo = gameMap[gameId];
    const oddsId = String(item.id || "");

    if (!gameInfo) return;

    // Prevent duplicate odds rows if API repeats any entries
    if (oddsId && seenOddsIds.has(oddsId)) return;
    if (oddsId) seenOddsIds.add(oddsId);

    rawRows.push([
      item.id || "",
      item.game_id || "",
      item.vendor || "",
      item.spread_away_value || "",
      item.spread_away_odds || "",
      item.spread_home_value || "",
      item.spread_home_odds || "",
      item.moneyline_away_odds || "",
      item.moneyline_home_odds || "",
      item.total_value || "",
      item.total_over_odds || "",
      item.total_under_odds || "",
      item.updated_at || ""
    ]);

    helperRows.push([
      gameInfo.game_date || "",
      gameInfo.away_team || "",
      gameInfo.home_team || ""
    ]);
  });

  clearMLBGameOddsSheet_(sheet);

  sheet.getRange(1, 1, 1, rawHeaders.length).setValues([rawHeaders]);
  sheet.getRange(1, 14, 1, formulaHeaders.length).setValues([formulaHeaders]);

  if (!rawRows.length) {
    Logger.log("No MLB game odds rows matched the Schedule tab game IDs.");
    return;
  }

  sheet.getRange(3, 1, rawRows.length, 13).setValues(rawRows);
  sheet.getRange(3, 22, helperRows.length, 3).setValues(helperRows);

  copyGameOddsFormulaBlockDown_("Game Odds", 14, 31);
  formatGameOddsModelColumns_(sheet);

  Logger.log(`Wrote ${rawRows.length} MLB game odds rows to "${sheetName}" using Schedule tab game IDs.`);
}

