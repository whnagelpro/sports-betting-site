          );

        const rowGameId =
          String(row[gameIdIndex] || "").trim();

        const matchesAllStarDate =
          rowDate === excludedDate;

        const matchesAllStarGameId =
          rowGameId === excludedGameId;

        /*
         * Remove a row if either:
         * 1. It belongs to the known All-Star Game ID, or
         * 2. It is dated July 14, 2026.
         */
        return !(
          matchesAllStarGameId ||
          matchesAllStarDate
        );
      });

    const removedCount =
      values.length - 1 - remainingRows.length;

    sheet.clearContents();

    sheet
      .getRange(
        1,
        1,
        1,
        headers.length
      )
      .setValues([headers]);

    if (remainingRows.length > 0) {
      sheet
        .getRange(
          2,
          1,
          remainingRows.length,
          headers.length
        )
        .setValues(remainingRows);
    }

    sheet.setFrozenRows(1);

    Logger.log(
      `Removed ${removedCount} rows from ${sheetName} ` +
      `for date ${excludedDate} or Game ID ${excludedGameId}.`
    );
  });
}

function normalizeMLBLogDateForCleanup_(value) {
  if (!value) return "";

  if (
    Object.prototype.toString.call(value) ===
    "[object Date]"
  ) {
    return Utilities.formatDate(
      value,
      SPORTACULAR_TIMEZONE,
      "yyyy-MM-dd"
    );
  }

  const raw = String(value).trim();

  if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) {
    return raw;
  }

  const mmddyyyyMatch = raw.match(
    /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/
  );

  if (mmddyyyyMatch) {
    const month =
      mmddyyyyMatch[1].padStart(2, "0");

    const day =
      mmddyyyyMatch[2].padStart(2, "0");

    const year =
      mmddyyyyMatch[3];

    return `${year}-${month}-${day}`;
  }

  const parsed = new Date(raw);

  if (!isNaN(parsed.getTime())) {
    return Utilities.formatDate(
      parsed,
      SPORTACULAR_TIMEZONE,
      "yyyy-MM-dd"
    );
  }

  return raw;
}

function getMLBCompletedGamesForDateRange_(startDate, endDate) {
  const selectedGamesMap = {};

  const fetchStartDate =
    addDaysToDateString_(startDate, -1);

  const fetchEndDate =
    addDaysToDateString_(endDate, 1);

  let current =
    new Date(fetchStartDate + "T00:00:00");

  const end =
    new Date(fetchEndDate + "T00:00:00");

  while (current <= end) {
    const apiDateString =
      Utilities.formatDate(
        current,
        SPORTACULAR_TIMEZONE,
        "yyyy-MM-dd"
      );

    Logger.log(
      `Checking MLB API games for ${apiDateString}`
    );

    const games =
      fetchAllMLBGamesForDate_(apiDateString)
        .filter(isCompletedMLBGame_)
        .filter(isMLBTrendEligibleGame_)
        .filter(game => {
          const azDate =
            getMLBGameAZDate_(game);

          return (
            azDate >= startDate &&
            azDate <= endDate
          );
        });

    games.forEach(game => {
      if (game.id) {
        selectedGamesMap[
          String(game.id)
        ] = game;
      }
    });

    current.setDate(
      current.getDate() + 1
    );

    Utilities.sleep(100);
  }

  return Object.values(
    selectedGamesMap
  );
}

function upsertRowsByKey_(sheet, headers, newRows, keyColumnIndexes) {
  const existingValues = sheet.getDataRange().getValues();

  const existingRows =
    existingValues.length > 1 ? existingValues.slice(1) : [];

  const rowMap = {};

  existingRows.forEach(row => {
    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  newRows.forEach(row => {
    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  const finalRows = Object.values(rowMap).sort((a, b) =>
    new Date(b[0]).getTime() - new Date(a[0]).getTime()
  );

  writeMLBOutputSheet_(sheet, headers, finalRows);
}

function upsertRowsByKeyForDateRange_(sheet, headers, newRows, keyColumnIndexes, startDate, endDate) {
  const existingValues = sheet.getDataRange().getValues();
  const existingRows = existingValues.length > 1 ? existingValues.slice(1) : [];
  const rowMap = {};

  existingRows.forEach(row => {
    const rowDate = String(row[0] || "");

    if (rowDate >= startDate && rowDate <= endDate) {
      return;
    }

    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  newRows.forEach(row => {
    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  const finalRows = Object.values(rowMap).sort((a, b) =>
    new Date(b[0]).getTime() - new Date(a[0]).getTime()
  );

  writeMLBOutputSheet_(sheet, headers, finalRows);
}

