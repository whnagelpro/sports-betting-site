    if (!gameId || !teamName) return;

    const key = `${gameId}_${teamName}`;

    if (!map[key]) {
      map[key] = {
        runs: 0,
        hits: 0,
        homeRuns: 0,
        totalBases: 0,
        strikeouts: 0,
        rowCount: 0
      };
