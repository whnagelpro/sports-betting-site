      value === "" ||
      value === null ||
      typeof value === "undefined"
    ) {
      return false;
    }

    const n =
      Number(value);

    return Number.isFinite(n);
  }


  function num_(value) {

    return finite_(value)
      ? Number(value)
      : null;
  }


  function text_(value) {

    return String(
      value === null ||
      typeof value === "undefined"
        ? ""
        : value
    ).trim();
  }


  function approxEqual_(a, b, tolerance) {

    if (
      !finite_(a) ||
      !finite_(b)
    ) {
      return false;
    }

    return (
      Math.abs(
        Number(a) -
        Number(b)
      ) <= tolerance
    );
  }


  function americanImpliedProbability_(odds) {

    if (!finite_(odds)) {
      return null;
    }

    const n =
      Number(odds);

    if (n === 0) {
      return null;
    }

    if (n > 0) {
      return 100 / (n + 100);
    }

    return (-n) / ((-n) + 100);
  }


  function expectedEV_(probability, odds) {

    if (
      !finite_(probability) ||
      !finite_(odds)
    ) {
      return null;
    }

    const p =
      Number(probability);

    const americanOdds =
      Number(odds);

    if (
      p < 0 ||
      p > 1 ||
      americanOdds === 0
    ) {
      return null;
    }

    const profit =
      americanOdds > 0
        ? americanOdds / 100
        : 100 / Math.abs(americanOdds);

    return (
      p * profit -
      (1 - p)
    );
  }


  // --------------------------------------------------------------------------
  // RESULT COLLECTION
  // --------------------------------------------------------------------------

  const results = [];


  function addResult_(
    name,
    pass,
    details
  ) {

    const result =
      Object.assign(
        {
          name:
            name,

          pass:
            !!pass
        },
