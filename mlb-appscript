  }

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;

  const numCols = endCol - startCol + 1;
  const templateRange = sheet.getRange(2, startCol, 1, numCols);

  if (lastRow > 2) {
    sheet.getRange(3, startCol, lastRow - 2, numCols).clearContent();
