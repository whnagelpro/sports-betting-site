    const splitIndex =
      Math.floor(
        observations.length *
        0.75
      );

    const training =
      observations.slice(
        0,
        splitIndex
      );

    const holdout =
      observations.slice(
        splitIndex
      );

    if (
      !training.length ||
      !holdout.length
    ) {
      return;
    }

    const trainingBaseRate =
      training.reduce(
        (sum, obs) =>
          sum + obs.outcome,
        0
      ) /
      training.length;

    /*
     * Choose shrinkage strength using
     * TRAINING data only.
     *
     * Primary objective: lowest Brier.
     * Tie-breaker: lowest ECE.
     */
    let bestStrength = null;
    let bestTrainingMetrics = null;

    strengths.forEach(
      strength => {

        const metrics =
          calculateMetrics(
            training,
            probability =>
              shrinkProbability(
                probability,
                trainingBaseRate,
                strength
              )
          );

        if (!metrics) {
          return;
        }

        if (
          bestTrainingMetrics === null ||
          metrics.brier <
            bestTrainingMetrics.brier ||
          (
            Math.abs(
              metrics.brier -
              bestTrainingMetrics.brier
            ) < 1e-12 &&
            metrics.ece <
              bestTrainingMetrics.ece
          )
        ) {

          bestStrength =
            strength;

          bestTrainingMetrics =
            metrics;
        }

      }
    );

    /*
     * Evaluate BOTH raw Poisson and the
     * training-selected calibrator on the
     * untouched holdout.
     */
    const rawHoldout =
      calculateMetrics(
        holdout,
        probability =>
          probability
      );

    const calibratedHoldout =
      calculateMetrics(
        holdout,
        probability =>
          shrinkProbability(
            probability,
            trainingBaseRate,
            bestStrength
          )
      );

    if (
      !rawHoldout ||
      !calibratedHoldout
    ) {
      return;
    }

    const brierImprovement =
      rawHoldout.brier
        ? (
            (
              rawHoldout.brier -
              calibratedHoldout.brier
            ) /
            rawHoldout.brier
          ) * 100
        : 0;

    const eceImprovement =
      rawHoldout.ece
        ? (
            (
              rawHoldout.ece -
              calibratedHoldout.ece
            ) /
            rawHoldout.ece
          ) * 100
        : 0;

    output.push([

      market.market,

      training.length,

      holdout.length,

      trainingBaseRate,

      bestStrength,

      rawHoldout.brier,

      calibratedHoldout.brier,

      brierImprovement,

      rawHoldout.ece,

      calibratedHoldout.ece,

      eceImprovement,

      rawHoldout.averageProbability,

      calibratedHoldout.averageProbability,

      rawHoldout.hitRate,

      (
        calibratedHoldout.brier <
          rawHoldout.brier &&
        calibratedHoldout.ece <
          rawHoldout.ece
      )
        ? "PASS"
        : "FAIL"

    ]);

  });

  const sheetName =
    "MLB Calibration Backtest";

  let outputSheet =
    ss.getSheetByName(
      sheetName
    );

  if (!outputSheet) {

    outputSheet =
      ss.insertSheet(
        sheetName
      );
  }

  outputSheet.clearContents();

  const headers = [

    "Market",

    "Training Observations",

    "Holdout Observations",

    "Training Base Rate",

    "Selected Shrinkage",

    "Raw Holdout Brier",

    "Calibrated Holdout Brier",

    "Brier Improvement %",

    "Raw Holdout ECE",

    "Calibrated Holdout ECE",

    "ECE Improvement %",

    "Raw Avg Probability",

    "Calibrated Avg Probability",

    "Holdout Hit Rate",

    "Calibration Decision"

  ];

  outputSheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([
      headers
    ]);

  if (output.length) {

    outputSheet
      .getRange(
        2,
        1,
        output.length,
        headers.length
      )
      .setValues(
        output
      );
  }

  outputSheet.setFrozenRows(1);

  outputSheet.autoResizeColumns(
    1,
    headers.length
  );

  Logger.log(
    `MLB calibration backtest complete. ${output.length} markets evaluated.`
  );

}

function auditMLBPoissonProbabilityCalibration() {

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const logsSheet =
    ss.getSheetByName("MLB Player Game Logs");

  if (!logsSheet) {
    throw new Error(
      'Sheet "MLB Player Game Logs" not found.'
    );
  }

  const values =
    logsSheet.getDataRange().getValues();

  if (values.length < 12) {
    throw new Error(
      "Not enough MLB Player Game Logs for calibration audit."
    );
  }

  const header = values[0];

  const playerIdCol =
    header.indexOf("Player ID");

  const gameDateCol =
    header.indexOf("Game Date");

  const pitcherOutsCol =
    header.indexOf("Pitcher Outs");

  if (
    playerIdCol === -1 ||
    gameDateCol === -1 ||
    pitcherOutsCol === -1
  ) {
    throw new Error(
      "Required Player ID, Game Date, or Pitcher Outs column not found."
    );
  }

  /*
   * These are the exact production Lambda weights
   * currently used by Sportacular.
   */
  const markets = [

    {
      market: "Hits",
      columnName: "Hits",
      season: 1.00,
      recent: 0.00,
      type: "hitter"
    },

    {
      market: "Runs",
      columnName: "Runs",
      season: 1.00,
      recent: 0.00,
      type: "hitter"
    },

    {
      market: "RBIs",
      columnName: "RBIs",
      season: 1.00,
      recent: 0.00,
      type: "hitter"
    },

    {
      market: "Home Runs",
      columnName: "Home Runs",
      season: 1.00,
      recent: 0.00,
      type: "hitter"
    },

    {
      market: "Total Bases",
      columnName: "Total Bases",
      season: 1.00,
      recent: 0.00,
      type: "hitter"
    },

    {
      market: "Walks",
      columnName: "Walks",
      season: 1.00,
      recent: 0.00,
      type: "hitter"
    },

    {
      market: "Strikeouts",
      columnName: "Strikeouts",
      season: 0.85,
      recent: 0.15,
      type: "hitter"
    },

    {
      market: "Stolen Bases",
      columnName: "Stolen Bases",
      season: 1.00,
      recent: 0.00,
      type: "hitter"
    },

    {
      market: "Hits + Runs + RBIs",
      columnName: "Hits + Runs + RBIs",
      season: 0.95,
      recent: 0.05,
      type: "hitter"
    },

    {
      market: "Pitcher Strikeouts",
      columnName: "Pitcher Strikeouts",
      season: 0.65,
      recent: 0.35,
      type: "pitcher"
    },

    {
      market: "Pitcher Outs",
      columnName: "Pitcher Outs",
      season: 0.10,
      recent: 0.90,
      type: "pitcher"
    },

    {
      market: "Pitcher Earned Runs",
      columnName: "Pitcher Earned Runs",
      season: 0.60,
      recent: 0.40,
      type: "pitcher"
    },

    {
      market: "Pitcher Hits Allowed",
      columnName: "Pitcher Hits Allowed",
      season: 0.80,
      recent: 0.20,
      type: "pitcher"
    },

    {
      market: "Pitcher Walks",
      columnName: "Pitcher Walks",
      season: 0.80,
      recent: 0.20,
      type: "pitcher"
    }

  ];

  markets.forEach(market => {

    market.column =
      header.indexOf(market.columnName);

    if (market.column === -1) {
      throw new Error(
        `Required column "${market.columnName}" not found.`
      );
    }

  });

  /*
   * Build chronological player histories.
   */
  const playerGames = {};

  for (let i = 1; i < values.length; i++) {

    const row = values[i];

    const playerId =
      String(row[playerIdCol] || "");

    if (!playerId) continue;

    if (!playerGames[playerId]) {
      playerGames[playerId] = [];
    }

    playerGames[playerId].push(row);
  }

  Object.values(playerGames)
    .forEach(games => {

      games.sort((a, b) =>
        new Date(a[gameDateCol]) -
        new Date(b[gameDateCol])
      );

    });

  /*
   * Poisson CDF implemented directly so this audit
   * does not depend on spreadsheet formulas.
   *
   * Returns P(X <= k).
   */
  function poissonCDF(k, lambda) {

    if (
      !Number.isFinite(lambda) ||
      lambda < 0 ||
      k < 0
    ) {
      return 0;
    }

    let probability =
      Math.exp(-lambda);

    let sum = probability;

    for (let i = 1; i <= k; i++) {

      probability *=
        lambda / i;

      sum += probability;

    }

    return Math.min(
      1,
      Math.max(0, sum)
    );
  }

  /*
   * Calibration buckets:
   * 0-10%, 10-20%, ... 90-100%.
   */
  function getBucket(probability) {

    let index =
      Math.floor(
        probability * 10
      );

    if (index >= 10) {
      index = 9;
    }

    if (index < 0) {
      index = 0;
    }

    return index;
  }

  const summaryOutput = [];

  const bucketOutput = [];

  markets.forEach(market => {

    const observations = [];

    Object.values(playerGames)
      .forEach(allGames => {

        /*
         * Separate hitter and pitcher histories.
         */
        const games =
          allGames.filter(row => {

            const pitcherOuts =
              Number(
                row[pitcherOutsCol]
              );

            if (market.type === "pitcher") {

              return (
                Number.isFinite(pitcherOuts) &&
                pitcherOuts > 0
              );

            }

            /*
             * Pitchers can hit in rare contexts,
             * but our current MLB data structure
             * represents hitter observations with
             * Pitcher Outs = 0.
             */
            return (
              !Number.isFinite(pitcherOuts) ||
              pitcherOuts <= 0
            );

          });

        if (games.length < 12) {
          return;
        }

        /*
         * Chronological 75/25 holdout.
         */
        const holdoutStart =
          Math.floor(
            games.length * 0.75
          );

        if (holdoutStart < 11) {
          return;
        }

        for (
          let targetIndex = holdoutStart;
          targetIndex < games.length;
          targetIndex++
        ) {

          const previousGames =
            games.slice(
              0,
              targetIndex
            );

          const recentGames =
            previousGames.slice(-10);

          if (
            previousGames.length < 11 ||
            recentGames.length < 10
          ) {
            continue;
          }

          const actualRaw =
            games[targetIndex][
              market.column
            ];

          if (
            actualRaw === "" ||
            actualRaw === null ||
            actualRaw === undefined
          ) {
            continue;
          }

          const actual =
            Number(actualRaw);

          if (!Number.isFinite(actual)) {
            continue;
          }

          const seasonValues =
            previousGames
              .map(row =>
                Number(
                  row[market.column]
                )
              )
              .filter(Number.isFinite);

          const recentValues =
            recentGames
              .map(row =>
                Number(
                  row[market.column]
                )
              )
              .filter(Number.isFinite);

          if (
            !seasonValues.length ||
            !recentValues.length
          ) {
            continue;
          }

          const seasonAvg =
            seasonValues.reduce(
              (sum, value) =>
                sum + value,
              0
            ) /
            seasonValues.length;

          const recentAvg =
            recentValues.reduce(
              (sum, value) =>
                sum + value,
              0
            ) /
            recentValues.length;

          const lambda =
            (
              seasonAvg *
              market.season
            ) +
            (
              recentAvg *
              market.recent
            );

          if (
            !Number.isFinite(lambda) ||
            lambda < 0
          ) {
            continue;
          }

          /*
           * Audit several common half-point
           * thresholds for every count market.
           *
           * line 0.5 => event X >= 1
           * line 1.5 => event X >= 2
           * etc.
           */
          const thresholds = [
            0.5,
            1.5,
            2.5,
            3.5,
            4.5,
            5.5
          ];

          thresholds.forEach(line => {

            const requiredCount =
              Math.floor(line) + 1;

            const probability =
              1 -
              poissonCDF(
                requiredCount - 1,
                lambda
              );

            const outcome =
              actual >= requiredCount
                ? 1
                : 0;

            observations.push({
              probability,
              outcome,
              line
            });

          });

        }

      });

    if (!observations.length) {
      return;
    }

    let brierSum = 0;
    let probabilitySum = 0;
    let outcomeSum = 0;

    const buckets =
      Array.from(
        { length: 10 },
        () => ({
          count: 0,
          probabilitySum: 0,
          outcomeSum: 0
        })
      );

    observations.forEach(observation => {

      const error =
        observation.probability -
        observation.outcome;

      brierSum +=
        error * error;

      probabilitySum +=
        observation.probability;

      outcomeSum +=
        observation.outcome;

      const bucket =
        getBucket(
          observation.probability
        );

      buckets[bucket].count++;

      buckets[bucket].probabilitySum +=
        observation.probability;

      buckets[bucket].outcomeSum +=
        observation.outcome;

    });

    const sampleSize =
      observations.length;

    const averageProbability =
      probabilitySum /
      sampleSize;

    const actualHitRate =
      outcomeSum /
      sampleSize;

    const brierScore =
      brierSum /
      sampleSize;

    /*
     * Expected Calibration Error (ECE):
     * weighted absolute gap between each bucket's
     * average predicted probability and hit rate.
     */
    let ece = 0;

    buckets.forEach(
      (bucket, index) => {

        if (!bucket.count) {
          return;
        }

        const avgProbability =
          bucket.probabilitySum /
          bucket.count;

        const hitRate =
          bucket.outcomeSum /
          bucket.count;

        const gap =
          hitRate -
          avgProbability;

        ece +=
          (
            bucket.count /
            sampleSize
          ) *
          Math.abs(gap);

        bucketOutput.push([
          market.market,
          `${index * 10}-${(index + 1) * 10}%`,
          bucket.count,
          avgProbability,
          hitRate,
          gap,
          Math.abs(gap)
        ]);

      }
    );

    summaryOutput.push([
      market.market,
      market.season,
      market.recent,
      sampleSize,
      averageProbability,
      actualHitRate,
      actualHitRate -
        averageProbability,
      brierScore,
      ece
    ]);

  });

  /*
   * Summary sheet.
   */
  const summarySheetName =
    "MLB Probability Calibration";

  let summarySheet =
    ss.getSheetByName(
      summarySheetName
    );

  if (!summarySheet) {

    summarySheet =
      ss.insertSheet(
        summarySheetName
      );

  }

  summarySheet.clearContents();

  const summaryHeaders = [
    "Market",
    "Season Weight",
    "Last 10 Weight",
    "Probability Observations",
    "Average Predicted Probability",
    "Actual Hit Rate",
    "Overall Calibration Gap",
    "Brier Score",
    "Expected Calibration Error"
  ];

  summarySheet
    .getRange(
      1,
      1,
      1,
      summaryHeaders.length
    )
    .setValues([
      summaryHeaders
    ]);

  if (summaryOutput.length) {

    summarySheet
      .getRange(
        2,
        1,
        summaryOutput.length,
        summaryHeaders.length
      )
      .setValues(
        summaryOutput
      );

  }

  summarySheet.setFrozenRows(1);

  summarySheet.autoResizeColumns(
    1,
    summaryHeaders.length
  );

  /*
   * Bucket-detail sheet.
   */
  const bucketSheetName =
    "MLB Calibration Buckets";

  let bucketSheet =
    ss.getSheetByName(
      bucketSheetName
    );

  if (!bucketSheet) {

    bucketSheet =
      ss.insertSheet(
        bucketSheetName
      );

  }

  bucketSheet.clearContents();

  const bucketHeaders = [
    "Market",
    "Probability Bucket",
    "Observations",
    "Average Predicted Probability",
    "Actual Hit Rate",
    "Calibration Gap",
    "Absolute Calibration Gap"
  ];

  bucketSheet
    .getRange(
      1,
      1,
      1,
      bucketHeaders.length
    )
    .setValues([
      bucketHeaders
    ]);

  if (bucketOutput.length) {

    bucketSheet
      .getRange(
        2,
        1,
        bucketOutput.length,
        bucketHeaders.length
      )
      .setValues(
        bucketOutput
      );

  }

  bucketSheet.setFrozenRows(1);

  bucketSheet.autoResizeColumns(
    1,
    bucketHeaders.length
  );

  Logger.log(
    `MLB probability calibration audit complete. ${summaryOutput.length} markets analyzed.`
  );

}

function validateMLBPitcherLambdaHoldout() {

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const logsSheet =
    ss.getSheetByName("MLB Player Game Logs");

  if (!logsSheet) {
    throw new Error(
      'Sheet "MLB Player Game Logs" not found.'
    );
  }

  const values =
    logsSheet.getDataRange().getValues();

  if (values.length < 12) {
    throw new Error(
      "Not enough MLB Player Game Logs to run pitcher holdout."
    );
  }

  const header = values[0];

  const playerIdCol =
    header.indexOf("Player ID");

  const gameDateCol =
    header.indexOf("Game Date");

  const pitcherOutsCol =
    header.indexOf("Pitcher Outs");

  if (
    playerIdCol === -1 ||
    gameDateCol === -1 ||
    pitcherOutsCol === -1
  ) {
    throw new Error(
      "Required Player ID, Game Date, or Pitcher Outs column not found."
    );
  }

  /*
   * Candidate weights come directly from D70.
   * 100/0 is included for every market as the
   * season-only baseline.
   */
  const marketConfigs = [
    {
      market: "Pitcher Strikeouts",
      columnName: "Pitcher Strikeouts",
      candidates: [
        { label: "100/0", season: 1.00, recent: 0.00 },
        { label: "65/35", season: 0.65, recent: 0.35 },
        { label: "50/50", season: 0.50, recent: 0.50 }
      ]
    },
    {
      market: "Pitcher Outs",
      columnName: "Pitcher Outs",
      candidates: [
        { label: "100/0", season: 1.00, recent: 0.00 },
        { label: "10/90", season: 0.10, recent: 0.90 }
      ]
    },
    {
      market: "Pitcher Earned Runs",
      columnName: "Pitcher Earned Runs",
      candidates: [
        { label: "100/0", season: 1.00, recent: 0.00 },
        { label: "60/40", season: 0.60, recent: 0.40 },
        { label: "40/60", season: 0.40, recent: 0.60 }
      ]
    },
    {
      market: "Pitcher Hits Allowed",
      columnName: "Pitcher Hits Allowed",
      candidates: [
        { label: "100/0", season: 1.00, recent: 0.00 },
        { label: "80/20", season: 0.80, recent: 0.20 },
        { label: "55/45", season: 0.55, recent: 0.45 }
      ]
    },
    {
      market: "Pitcher Walks",
      columnName: "Pitcher Walks",
      candidates: [
        { label: "100/0", season: 1.00, recent: 0.00 },
        { label: "80/20", season: 0.80, recent: 0.20 },
        { label: "35/65", season: 0.35, recent: 0.65 }
      ]
    }
  ];

  marketConfigs.forEach(config => {

    config.column =
      header.indexOf(config.columnName);

    if (config.column === -1) {
      throw new Error(
        `Required column "${config.columnName}" not found.`
      );
    }

  });

  /*
   * Build pitcher-only chronological histories.
   */
  const playerGames = {};

  for (let i = 1; i < values.length; i++) {

    const row = values[i];

    const playerId =
      String(row[playerIdCol] || "");

    if (!playerId) continue;

    const pitcherOuts =
      Number(row[pitcherOutsCol]);

    if (
      !Number.isFinite(pitcherOuts) ||
      pitcherOuts <= 0
    ) {
      continue;
    }

    if (!playerGames[playerId]) {
      playerGames[playerId] = [];
    }

    playerGames[playerId].push(row);
  }

  Object.values(playerGames)
    .forEach(games => {

      games.sort((a, b) => {
        return (
          new Date(a[gameDateCol]) -
          new Date(b[gameDateCol])
        );
      });

    });

  const output = [];

  marketConfigs.forEach(config => {

    const results =
      config.candidates.map(candidate => {

        let absoluteError = 0;
        let squaredError = 0;
        let predictions = 0;

        Object.values(playerGames)
          .forEach(games => {

            /*
             * Earlier 75% establishes the initial
             * training history.
             *
             * Only the later 25% is scored.
             */
            const holdoutStart =
              Math.floor(
                games.length * 0.75
              );

            if (holdoutStart < 11) {
              return;
            }

            for (
              let targetIndex = holdoutStart;
              targetIndex < games.length;
              targetIndex++
            ) {

              const previousGames =
                games.slice(
                  0,
                  targetIndex
                );

              const recentGames =
                previousGames.slice(-10);

              if (
                previousGames.length < 11 ||
                recentGames.length < 10
              ) {
                continue;
              }

              const actualRaw =
                games[targetIndex][
                  config.column
                ];

              if (
                actualRaw === "" ||
                actualRaw === null ||
                actualRaw === undefined
              ) {
                continue;
              }

              const actual =
                Number(actualRaw);

              if (!Number.isFinite(actual)) {
                continue;
              }

              const seasonValues =
                previousGames
                  .map(row => {

                    const raw =
                      row[config.column];

                    if (
                      raw === "" ||
                      raw === null ||
                      raw === undefined
                    ) {
                      return null;
                    }

                    const value =
                      Number(raw);

                    return Number.isFinite(value)
                      ? value
                      : null;
                  })
                  .filter(Number.isFinite);

              const recentValues =
                recentGames
                  .map(row => {

                    const raw =
                      row[config.column];

                    if (
                      raw === "" ||
                      raw === null ||
                      raw === undefined
                    ) {
                      return null;
                    }

                    const value =
                      Number(raw);

                    return Number.isFinite(value)
                      ? value
                      : null;
                  })
                  .filter(Number.isFinite);

              if (
                !seasonValues.length ||
                !recentValues.length
              ) {
                continue;
              }

              const seasonAverage =
                seasonValues.reduce(
                  (sum, value) =>
                    sum + value,
                  0
                ) /
                seasonValues.length;

              const recentAverage =
                recentValues.reduce(
                  (sum, value) =>
                    sum + value,
                  0
                ) /
                recentValues.length;

              const prediction =
                (
                  seasonAverage *
                  candidate.season
                ) +
                (
                  recentAverage *
                  candidate.recent
                );

              const error =
                prediction - actual;

              absoluteError +=
                Math.abs(error);

              squaredError +=
                error * error;

              predictions++;

            }

          });

        return {
          label: candidate.label,
          season: candidate.season,
          recent: candidate.recent,
          predictions,
          mae:
            predictions
              ? absoluteError / predictions
              : null,
          rmse:
            predictions
              ? Math.sqrt(
                  squaredError / predictions
                )
              : null
        };

      });

    const baseline =
      results.find(result =>
        result.label === "100/0"
      );

    const validResults =
      results.filter(result =>
        result.mae !== null &&
        result.rmse !== null
      );

    if (!validResults.length) {
      return;
    }

    const bestMAE =
      validResults.reduce(
        (best, current) =>
          current.mae < best.mae
            ? current
            : best
