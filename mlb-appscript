  function nearlyEqual(actual, expected, tolerance) {

    const epsilon =
      tolerance === undefined
        ? 1e-9
        : tolerance;

    return (
      Number.isFinite(Number(actual)) &&
      Number.isFinite(Number(expected)) &&
      Math.abs(
        Number(actual) -
        Number(expected)
      ) <= epsilon
    );
  }


  function expectedEV(probability, odds) {

    if (
      probability === null ||
      probability === undefined ||
      odds === null ||
      odds === undefined
    ) {
      return null;
    }

    const p = Number(probability);
    const americanOdds = Number(odds);

    if (
      !Number.isFinite(p) ||
      !Number.isFinite(americanOdds) ||
      americanOdds === 0
    ) {
      return null;
    }

    const profit =
      americanOdds > 0
        ? americanOdds / 100
        : 100 / Math.abs(americanOdds);

    return (
      p * profit -
      (1 - p)
    );
  }


