function testMLBConsumerContractExportReadiness_D10AM() {

  const TEST_NAME =
    "D10AM MLB CONSUMER CONTRACT / EXPORT READINESS AUDIT";

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName("Player Props");

  if (!sheet) {
