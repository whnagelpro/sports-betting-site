  statStdDev,
  evOver,
  evUnder,
  bestModelProbability,
  bestPriceEdge,
  trendScore,
  modelConfidence
}) {

  const candidateSide =
    selectUniversalCandidateSide_({
      evOver,
      evUnder
    });


  let bestEV =
    null;


  if (
    candidateSide === "Over"
  ) {
    bestEV =
      getUniversalNullableNumber_(
        evOver
      );

  } else if (
    candidateSide === "Under"
  ) {
    bestEV =
      getUniversalNullableNumber_(
        evUnder
      );
  }


  const risk =
    calculateUniversalRisk_({
      projectedStat,
      lineValue,
      statStdDev
    });


  const sportacularEdge =
    calculateUniversalSportacularEdge_({
      bestEV,
      bestPriceEdge
    });


  const sportacularScore =
    calculateUniversalSportacularScore_({
      candidateSide,
      sportacularEdge,
      modelConfidence,
      riskScore:
        risk.riskScore,
      trendScore
    });


  const actionability =
    evaluateUniversalActionability_({
      candidateSide,
      bestEV,
      bestModelProbability,
      bestPriceEdge,
      riskScore:
        risk.riskScore,
      modelConfidence,
      sportacularEdge,
      sportacularScore
    });


  return {
    candidateSide,

    finalBestSide:
      actionability.finalBestSide,

    bestEV,

    riskScore:
      risk.riskScore,

    riskTier:
      risk.riskTier,

    sportacularScore,

    sportacularEdge,

    confidenceTier:
      actionability.confidenceTier,

    actionable:
      actionability.actionable,

    evaluable:
      actionability.evaluable
  };
}


