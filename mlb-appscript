        candidateProbabilityMismatchCount++;

        if (
          candidateProbabilitySamples.length < 10
        ) {

          candidateProbabilitySamples.push({
            row:
              sheetRow,

            candidateSide:
              candidateSide,

            expectedProbability:
              expectedProbability,

            actualProbability:
              bestModelProbability
          });
        }
      }
    }


    // ------------------------------------------------------------------------
    // UNIVERSAL RISK
    // ------------------------------------------------------------------------

    const riskScore =
      row[30]; // AE


    if (
      finite_(riskScore)
    ) {

      populatedRiskRows++;

      const risk =
        Number(riskScore);


      if (
        risk < 0 ||
        risk > 100
      ) {

        invalidRiskScoreCount++;

        if (
          riskSamples.length < 10
        ) {

          riskSamples.push({
            row:
              sheetRow,

            riskScore:
              risk,

            riskTier:
              riskTier
          });
        }
      }
    }


    // ------------------------------------------------------------------------
    // SPORTACULAR SCORING
    // ------------------------------------------------------------------------

    const modelConfidence =
      row[32]; // AG

    const sportacularScore =
      row[33]; // AH

    const sportacularEdge =
      row[34]; // AI


    if (
      finite_(sportacularScore) ||
      finite_(sportacularEdge) ||
      !missing_(confidenceTier)
    ) {

      populatedScoringRows++;


      const scoreValid =
        missing_(sportacularScore) ||
        (
          finite_(sportacularScore) &&
          Number(sportacularScore) >= 0 &&
          Number(sportacularScore) <= 100
        );


      const edgeValid =
        missing_(sportacularEdge) ||
        (
          finite_(sportacularEdge) &&
          Number(sportacularEdge) >= 0 &&
          Number(sportacularEdge) <= 100
        );


      if (
        !scoreValid ||
        !edgeValid
      ) {

        invalidScoringCount++;

        if (
          scoringSamples.length < 10
        ) {

          scoringSamples.push({
            row:
              sheetRow,

            sportacularScore:
              sportacularScore,

            sportacularEdge:
              sportacularEdge,

            confidenceTier:
              confidenceTier
          });
        }
      }
    }


    // ------------------------------------------------------------------------
    // FINAL ACTIONABILITY
    // ------------------------------------------------------------------------

    const actionable =
      finalBestSide === "Over" ||
      finalBestSide === "Under";


    if (actionable) {

      actionableRows++;


      const clearsFrozenGates =
        finite_(bestEV) &&
        Number(bestEV) >=
          SPORTACULAR_PLAYER_PROP_SCORING
            .minimumBestEV &&

        finite_(bestModelProbability) &&
        Number(bestModelProbability) >=
          SPORTACULAR_PLAYER_PROP_SCORING
            .minimumBestModelProbability &&

        finite_(row[27]) &&
        Number(row[27]) >=
          SPORTACULAR_PLAYER_PROP_SCORING
            .minimumBestPriceEdge &&

        finite_(modelConfidence) &&
        Number(modelConfidence) >=
          SPORTACULAR_PLAYER_PROP_SCORING
            .minimumModelConfidence &&

        finite_(sportacularScore) &&
        Number(sportacularScore) >=
          SPORTACULAR_PLAYER_PROP_SCORING
            .minimumSportacularScore;


      if (!clearsFrozenGates) {

        actionableGateViolationCount++;

        if (
          gateViolationSamples.length < 10
        ) {

          gateViolationSamples.push({
            row:
              sheetRow,

            bestSide:
              finalBestSide,

            bestEV:
              bestEV,

            bestModelProbability:
              bestModelProbability,

            bestPriceEdge:
              row[27],

            modelConfidence:
              modelConfidence,

            sportacularScore:
              sportacularScore
          });
        }
      }


      if (
        missing_(confidenceTier) ||
        confidenceTier === "No Play"
      ) {

        actionabilityAgreementViolationCount++;

        if (
          agreementSamples.length < 10
        ) {

          agreementSamples.push({
            row:
              sheetRow,

            bestSide:
              finalBestSide,

            confidenceTier:
              confidenceTier
          });
        }
      }

    } else if (
      finalBestSide === "No Play"
    ) {

      noPlayRows++;


      if (
        !missing_(confidenceTier) &&
        confidenceTier !== "No Play"
      ) {

        actionabilityAgreementViolationCount++;

        if (
          agreementSamples.length < 10
        ) {

          agreementSamples.push({
            row:
              sheetRow,

            bestSide:
              finalBestSide,

            confidenceTier:
              confidenceTier
          });
        }
      }
    }
  }


  // ==========================================================================
  // FULL-DATASET ASSERTIONS
  // ==========================================================================

  addResult_(
    "All live MLB production numeric values are finite when populated",
    invalidNumberCount === 0,
    {
      violations:
        invalidNumberCount,

      samples:
        invalidNumberSamples
    }
  );


  addResult_(
    "All evaluable MLB probabilities remain inside zero-to-one bounds",
    invalidProbabilityCount === 0,
    {
      evaluableProbabilityRows:
        evaluableProbabilityRows,

      violations:
        invalidProbabilityCount,

      samples:
        invalidProbabilitySamples
    }
  );


  addResult_(
    "All evaluable MLB Over/Under probability pairs sum to one",
    probabilityMassViolationCount === 0,
    {
      evaluableProbabilityRows:
        evaluableProbabilityRows,

      violations:
        probabilityMassViolationCount,

      samples:
        probabilityMassSamples
    }
  );


  addResult_(
    "All live MLB final Best Side values use frozen vocabulary",
    invalidBestSideCount === 0,
    {
      violations:
        invalidBestSideCount,

      samples:
        bestSideSamples
    }
  );


  addResult_(
    "All populated MLB Confidence Tier values use frozen P15 vocabulary",
    invalidConfidenceTierCount === 0,
    {
      violations:
        invalidConfidenceTierCount,

      samples:
        confidenceTierSamples
    }
  );


  addResult_(
    "All populated MLB Risk Tier values use frozen universal vocabulary",
    invalidRiskTierCount === 0,
    {
      violations:
        invalidRiskTierCount,

      samples:
        riskTierSamples
    }
  );


  addResult_(
    "All live MLB Best EV values agree with the internal EV candidate",
    candidateBestEVMismatchCount === 0,
    {
      violations:
        candidateBestEVMismatchCount,

      samples:
        bestEVSamples
    }
  );


  addResult_(
    "All live MLB Best Model Probability values agree with the internal EV candidate",
    candidateProbabilityMismatchCount === 0,
    {
      violations:
        candidateProbabilityMismatchCount,

      samples:
        candidateProbabilitySamples
    }
  );


  addResult_(
    "All populated MLB universal Risk Scores remain inside zero-to-100",
    invalidRiskScoreCount === 0,
    {
      populatedRiskRows:
        populatedRiskRows,

      violations:
        invalidRiskScoreCount,

      samples:
        riskSamples
    }
  );


  addResult_(
    "All populated MLB Sportacular scoring values remain inside frozen bounds",
    invalidScoringCount === 0,
    {
      populatedScoringRows:
        populatedScoringRows,

      violations:
        invalidScoringCount,

      samples:
        scoringSamples
    }
  );


  addResult_(
    "Every actionable MLB production row clears all frozen gates",
    actionableGateViolationCount === 0,
    {
      actionableRows:
        actionableRows,

      violations:
        actionableGateViolationCount,

      samples:
        gateViolationSamples
    }
  );


  addResult_(
    "Live MLB Best Side and Confidence Tier agree on final actionability",
    actionabilityAgreementViolationCount === 0,
    {
      actionableRows:
        actionableRows,

      noPlayRows:
        noPlayRows,

      violations:
        actionabilityAgreementViolationCount,

      samples:
        agreementSamples
    }
  );


  // ==========================================================================
  // SUMMARY
  // ==========================================================================

  const passed =
    results.filter(
      result => result.pass
    ).length;


  const failed =
    results.length -
    passed;


  const summary = {

    test:
      "D10AI MLB LIVE PRODUCTION OUTPUT INTEGRITY AUDIT",

    tests:
      results.length,

    passed:
      passed,

    failed:
      failed,

    pass:
      failed === 0,

    productionRows:
      populatedRows,

    evaluableProbabilityRows:
      evaluableProbabilityRows,

    actionableRows:
      actionableRows,

    noPlayRows:
      noPlayRows,

    populatedRiskRows:
      populatedRiskRows,

    populatedScoringRows:
      populatedScoringRows,

    frozenThresholds: {

      minimumBestEV:
        SPORTACULAR_PLAYER_PROP_SCORING
          .minimumBestEV,

      minimumBestModelProbability:
        SPORTACULAR_PLAYER_PROP_SCORING
          .minimumBestModelProbability,

      minimumBestPriceEdge:
        SPORTACULAR_PLAYER_PROP_SCORING
          .minimumBestPriceEdge,

      minimumModelConfidence:
        SPORTACULAR_PLAYER_PROP_SCORING
          .minimumModelConfidence,

      minimumSportacularScore:
        SPORTACULAR_PLAYER_PROP_SCORING
          .minimumSportacularScore
    },

    results:
      results
  };


  Logger.log(
    JSON.stringify(
      summary,
      null,
      2
    )
  );


  if (!summary.pass) {

    throw new Error(
      "D10AI MLB live production output integrity audit failed."
    );
  }


  return summary;
}

/**
 * ============================================================================
 * D10AJ — MLB LIVE PRODUCTION IDENTITY / DUPLICATE INTEGRITY AUDIT
 * ============================================================================
 *
 * READ-ONLY.
 *
 * Audits the live "Player Props" A:AJ output for:
 * - frozen 36-column contract
 * - populated production identity
 * - duplicate provider IDs
 * - provider-ID identity collisions
 * - exact duplicate A:N provider rows
 * - duplicate universal A:AJ rows
 * - game/provider consistency
 * - blank rows inside the production range
 * - stale data immediately below the live dataset
 *
 * Does NOT:
 * - call the API
 * - refresh Player Props
 * - modify spreadsheet data
 * ============================================================================
 */
function testMLBLiveProductionIdentityDuplicateIntegrity_D10AJ() {

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName("Player Props");

  if (!sheet) {
    throw new Error(
      'D10AJ: Production "Player Props" sheet was not found.'
    );
  }


  const results = [];

  function addResult_(name, pass, details) {

    const result =
      Object.assign(
        {
          name: name,
          pass: Boolean(pass)
        },
        details || {}
      );

    results.push(result);

    Logger.log(
      JSON.stringify(result)
    );
  }


  function text_(value) {

    if (
      value === null ||
      value === undefined
    ) {
      return "";
    }

    return String(value).trim();
  }


  function canonicalValue_(value) {

    if (
      value === null ||
      value === undefined ||
      value === ""
    ) {
      return "";
    }

    if (
      Object.prototype.toString.call(value) ===
      "[object Date]"
    ) {
      return value.toISOString();
    }

    return String(value);
  }


  function keyFromColumns_(row, start, endExclusive) {

    const parts = [];

    for (
      let c = start;
      c < endExclusive;
      c++
    ) {

      parts.push(
        canonicalValue_(
          row[c]
        )
      );
    }

    return parts.join("\u001F");
  }


  const expectedHeaders =
    MLB_UNIVERSAL_PLAYER_PROPS_HEADERS.slice();

  const expectedWidth =
    expectedHeaders.length;


  // ==========================================================================
  // BASIC CONTRACT
  // ==========================================================================

  addResult_(
    "D10AJ MLB universal contract remains exactly 36 columns",
    expectedWidth === 36,
    {
      actual:
        expectedWidth,

      expected:
        36
    }
  );


  const lastRow =
    sheet.getLastRow();

  const lastColumn =
    sheet.getLastColumn();


  addResult_(
    "D10AJ live Player Props sheet contains production rows",
    lastRow >= 2,
    {
      lastRow:
        lastRow,

      productionRows:
        Math.max(
          0,
          lastRow - 1
        )
    }
  );


  addResult_(
    "D10AJ live Player Props sheet contains exactly the frozen A:AJ width",
    lastColumn === expectedWidth,
    {
      actualLastColumn:
        lastColumn,

      expectedLastColumn:
        expectedWidth
    }
  );


  if (lastRow < 2) {

    throw new Error(
      "D10AJ: No live MLB production rows are available."
    );
  }


  const actualHeaders =
    sheet
      .getRange(
        1,
        1,
        1,
        expectedWidth
      )
      .getValues()[0];


  const headerMismatches = [];

  for (
    let c = 0;
    c < expectedWidth;
    c++
  ) {

    if (
      actualHeaders[c] !==
      expectedHeaders[c]
    ) {

      headerMismatches.push({
        column:
          c + 1,

        expected:
          expectedHeaders[c],

        actual:
          actualHeaders[c]
      });
    }
  }


  addResult_(
    "D10AJ live A:AJ headers exactly match frozen universal contract",
    headerMismatches.length === 0,
    {
      mismatchCount:
        headerMismatches.length,

      samples:
        headerMismatches.slice(
          0,
          10
        )
    }
  );


  // ==========================================================================
  // READ LIVE DATA
  // ==========================================================================

  const rowCount =
    lastRow - 1;


  const rows =
    sheet
      .getRange(
        2,
        1,
        rowCount,
        expectedWidth
      )
      .getValues();


  // A:N provider fields:
  //
  // A Game Id
  // B Game Date
  // C Away Team
  // D Home Team
  // E Id
  // F Player Id
  // G Vendor
  // H Prop Type
  // I Line Value
  // J Type
  // K Odds
  // L Updated At
  // M Over Odds
  // N Under Odds


  let populatedRows = 0;
  let blankRowsInsideProduction = 0;

  let missingGameIdCount = 0;
  let missingProviderIdCount = 0;
  let missingPlayerIdCount = 0;
  let missingVendorCount = 0;
  let missingPropTypeCount = 0;

  let duplicateProviderIdCount = 0;
  let providerIdentityCollisionCount = 0;

  let exactProviderRowDuplicateCount = 0;
  let exactUniversalRowDuplicateCount = 0;

  let inconsistentGameIdentityCount = 0;


  const blankRowSamples = [];

  const missingGameIdSamples = [];
  const missingProviderIdSamples = [];
  const missingPlayerIdSamples = [];
  const missingVendorSamples = [];
  const missingPropTypeSamples = [];

  const duplicateProviderIdSamples = [];
  const providerCollisionSamples = [];

  const providerDuplicateSamples = [];
  const universalDuplicateSamples = [];

  const gameIdentitySamples = [];


  const providerIdFirstSeen =
    new Map();

  const providerIdIdentity =
    new Map();

  const providerRowFirstSeen =
    new Map();

  const universalRowFirstSeen =
    new Map();

  const gameIdentity =
    new Map();


  // ==========================================================================
  // SCAN EVERY LIVE ROW
  // ==========================================================================

  for (
    let r = 0;
    r < rows.length;
    r++
  ) {

    const row =
      rows[r];

    const sheetRow =
      r + 2;


    const hasData =
      row.some(
        value =>
          value !== "" &&
          value !== null
      );


    if (!hasData) {

      blankRowsInsideProduction++;

      if (
        blankRowSamples.length < 10
      ) {

        blankRowSamples.push(
          sheetRow
        );
      }

      continue;
    }


    populatedRows++;


    const gameId =
      text_(row[0]);

    const gameDate =
      canonicalValue_(
        row[1]
      );

    const awayTeam =
      text_(row[2]);

    const homeTeam =
      text_(row[3]);

    const providerId =
      text_(row[4]);

    const playerId =
      text_(row[5]);

    const vendor =
      text_(row[6]);

    const propType =
      text_(row[7]);


    // ------------------------------------------------------------------------
    // REQUIRED PRODUCTION IDENTITY
    // ------------------------------------------------------------------------

    if (!gameId) {

      missingGameIdCount++;

      if (
        missingGameIdSamples.length < 10
      ) {

        missingGameIdSamples.push(
          sheetRow
        );
      }
    }


    if (!providerId) {

      missingProviderIdCount++;

      if (
        missingProviderIdSamples.length < 10
      ) {

        missingProviderIdSamples.push(
          sheetRow
        );
      }
    }


    if (!playerId) {

      missingPlayerIdCount++;

      if (
        missingPlayerIdSamples.length < 10
      ) {

        missingPlayerIdSamples.push(
          sheetRow
        );
      }
    }


    if (!vendor) {

      missingVendorCount++;

      if (
        missingVendorSamples.length < 10
      ) {

        missingVendorSamples.push(
          sheetRow
        );
      }
    }


    if (!propType) {

      missingPropTypeCount++;

      if (
        missingPropTypeSamples.length < 10
      ) {

        missingPropTypeSamples.push(
          sheetRow
        );
      }
    }


    // ------------------------------------------------------------------------
    // PROVIDER ID UNIQUENESS
    //
    // refreshMLBPlayerPropsSheet() explicitly deduplicates nonblank prop.id.
    // Therefore no nonblank provider ID should appear twice in live output.
    // ------------------------------------------------------------------------

    if (providerId) {

      if (
        providerIdFirstSeen.has(
          providerId
        )
      ) {

        duplicateProviderIdCount++;

        if (
          duplicateProviderIdSamples.length < 10
        ) {

          duplicateProviderIdSamples.push({
            providerId:
              providerId,

            firstRow:
              providerIdFirstSeen.get(
                providerId
              ),

            duplicateRow:
              sheetRow
          });
        }

      } else {

        providerIdFirstSeen.set(
          providerId,
          sheetRow
        );
      }


      // ----------------------------------------------------------------------
      // SAME PROVIDER ID MUST NOT REPRESENT DIFFERENT MARKET IDENTITY
      // ----------------------------------------------------------------------

      const identityKey =
        [
          gameId,
          playerId,
          vendor,
          propType
        ].join("\u001F");


      if (
        providerIdIdentity.has(
          providerId
        )
      ) {

        const firstIdentity =
          providerIdIdentity.get(
            providerId
          );


        if (
          firstIdentity.identityKey !==
          identityKey
        ) {

          providerIdentityCollisionCount++;

          if (
            providerCollisionSamples.length < 10
          ) {

            providerCollisionSamples.push({
              providerId:
                providerId,

              firstRow:
                firstIdentity.row,

              collisionRow:
                sheetRow,

              firstIdentity:
                firstIdentity.identityKey,

              collisionIdentity:
                identityKey
            });
          }
        }

      } else {

        providerIdIdentity.set(
          providerId,
          {
            row:
              sheetRow,

            identityKey:
              identityKey
          }
        );
      }
    }


    // ------------------------------------------------------------------------
    // EXACT A:N PROVIDER-ROW DUPLICATES
    // ------------------------------------------------------------------------

    const providerRowKey =
      keyFromColumns_(
        row,
        0,
        14
      );


    if (
      providerRowFirstSeen.has(
        providerRowKey
      )
    ) {

      exactProviderRowDuplicateCount++;

      if (
        providerDuplicateSamples.length < 10
      ) {

        providerDuplicateSamples.push({
          firstRow:
            providerRowFirstSeen.get(
              providerRowKey
            ),

          duplicateRow:
            sheetRow,

          providerId:
            providerId
        });
      }

    } else {

      providerRowFirstSeen.set(
        providerRowKey,
        sheetRow
      );
    }


    // ------------------------------------------------------------------------
    // EXACT A:AJ UNIVERSAL-ROW DUPLICATES
    // ------------------------------------------------------------------------

    const universalRowKey =
      keyFromColumns_(
        row,
        0,
        expectedWidth
      );


    if (
      universalRowFirstSeen.has(
        universalRowKey
      )
    ) {

      exactUniversalRowDuplicateCount++;

      if (
        universalDuplicateSamples.length < 10
      ) {

        universalDuplicateSamples.push({
          firstRow:
            universalRowFirstSeen.get(
              universalRowKey
            ),

          duplicateRow:
            sheetRow,

          providerId:
            providerId
        });
      }

    } else {

      universalRowFirstSeen.set(
        universalRowKey,
        sheetRow
      );
    }


    // ------------------------------------------------------------------------
    // GAME IDENTITY CONSISTENCY
    //
    // Every occurrence of a Game Id should preserve the same:
    // Game Date + Away Team + Home Team.
    // ------------------------------------------------------------------------

    if (gameId) {

      const gameKey =
        [
          gameDate,
          awayTeam,
          homeTeam
        ].join("\u001F");


      if (
        gameIdentity.has(
          gameId
        )
      ) {

        const firstGame =
          gameIdentity.get(
            gameId
          );


        if (
          firstGame.gameKey !==
          gameKey
        ) {

          inconsistentGameIdentityCount++;

          if (
            gameIdentitySamples.length < 10
          ) {

            gameIdentitySamples.push({
              gameId:
                gameId,

              firstRow:
                firstGame.row,

              inconsistentRow:
                sheetRow,

              firstIdentity:
                firstGame.gameKey,

              inconsistentIdentity:
                gameKey
            });
          }
        }

      } else {

        gameIdentity.set(
          gameId,
          {
            row:
              sheetRow,

            gameKey:
              gameKey
          }
        );
      }
    }
  }


  // ==========================================================================
  // STALE DATA BOUNDARY
  //
  // clearPlayerPropsData_() runs before each refresh. If the previous refresh
  // contained more rows than the current refresh, old values must not survive
  // immediately below the new live output.
  // ==========================================================================

  const maxRows =
    sheet.getMaxRows();


  let staleBoundaryCellCount = 0;

  const staleBoundarySamples = [];


  if (
    lastRow < maxRows
  ) {

    const rowsToInspect =
      Math.min(
        25,
        maxRows - lastRow
      );


    const belowValues =
      sheet
        .getRange(
          lastRow + 1,
          1,
          rowsToInspect,
          expectedWidth
        )
        .getValues();


    for (
      let r = 0;
      r < belowValues.length;
      r++
    ) {

      for (
        let c = 0;
        c < belowValues[r].length;
        c++
      ) {

        const value =
          belowValues[r][c];


        if (
          value !== "" &&
          value !== null
        ) {

          staleBoundaryCellCount++;

          if (
            staleBoundarySamples.length < 10
          ) {

            staleBoundarySamples.push({
              row:
                lastRow + 1 + r,

              column:
                c + 1,

              value:
                value
            });
          }
        }
      }
    }
  }


  // ==========================================================================
  // ASSERTIONS
  // ==========================================================================

  addResult_(
    "D10AJ live production range contains no blank rows",
    blankRowsInsideProduction === 0,
    {
      violations:
        blankRowsInsideProduction,

      samples:
        blankRowSamples
    }
  );


  addResult_(
    "Every live MLB production row has a Game Id",
    missingGameIdCount === 0,
    {
      violations:
        missingGameIdCount,

      samples:
        missingGameIdSamples
    }
  );


  addResult_(
    "Every live MLB production row has a provider Id",
    missingProviderIdCount === 0,
    {
      violations:
        missingProviderIdCount,

      samples:
        missingProviderIdSamples
    }
  );


  addResult_(
    "Every live MLB production row has a Player Id",
    missingPlayerIdCount === 0,
    {
      violations:
        missingPlayerIdCount,

      samples:
        missingPlayerIdSamples
    }
  );


  addResult_(
    "Every live MLB production row has a Vendor",
    missingVendorCount === 0,
    {
      violations:
        missingVendorCount,

      samples:
        missingVendorSamples
    }
  );


  addResult_(
    "Every live MLB production row has a Prop Type",
    missingPropTypeCount === 0,
    {
      violations:
        missingPropTypeCount,

      samples:
        missingPropTypeSamples
    }
  );


  addResult_(
    "Live MLB provider IDs are unique after refresh deduplication",
    duplicateProviderIdCount === 0,
    {
      uniqueProviderIds:
        providerIdFirstSeen.size,

      duplicateOccurrences:
        duplicateProviderIdCount,

      samples:
        duplicateProviderIdSamples
    }
  );


  addResult_(
    "No MLB provider ID maps to conflicting production identities",
    providerIdentityCollisionCount === 0,
    {
      violations:
        providerIdentityCollisionCount,

      samples:
        providerCollisionSamples
    }
  );


  addResult_(
    "Live MLB output contains no exact duplicate A:N provider rows",
    exactProviderRowDuplicateCount === 0,
    {
      violations:
        exactProviderRowDuplicateCount,

      samples:
        providerDuplicateSamples
    }
  );


  addResult_(
    "Live MLB output contains no exact duplicate A:AJ universal rows",
    exactUniversalRowDuplicateCount === 0,
    {
      violations:
        exactUniversalRowDuplicateCount,

      samples:
        universalDuplicateSamples
    }
  );


  addResult_(
    "Every MLB Game Id preserves one Game Date / Away / Home identity",
    inconsistentGameIdentityCount === 0,
    {
      uniqueGames:
        gameIdentity.size,

      violations:
        inconsistentGameIdentityCount,

      samples:
        gameIdentitySamples
    }
  );


  addResult_(
    "No stale MLB A:AJ values survive immediately below live production output",
    staleBoundaryCellCount === 0,
    {
      inspectedRowsBelowOutput:
        Math.min(
          25,
          Math.max(
            0,
            maxRows - lastRow
          )
        ),

      violations:
