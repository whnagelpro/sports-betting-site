function removeLegacyMLBAnalyticsTriggers() {

    const KEEP_HANDLERS = new Set([
        "refreshMLBScheduleSheet",
        "refreshMLBRostersSheet",
        "refreshMLBPlayerPropsSheet",
        "refreshMLBGameOddsSheet"
    ]);

    const triggers =
        ScriptApp.getProjectTriggers();

    let kept = 0;
    let deleted = 0;

    Logger.log(
        "=============================================="
    );

    Logger.log(
        "MLB LEGACY ANALYTICS TRIGGER CLEANUP STARTING"
    );

    Logger.log(
        `Triggers before cleanup: ${triggers.length}`
    );

    Logger.log(
        "=============================================="
    );

    triggers.forEach(trigger => {

        const handler =
            trigger.getHandlerFunction();

        if (KEEP_HANDLERS.has(handler)) {

            Logger.log(
                `KEEPING: ${handler}`
            );

            kept++;

            return;
        }

        /*
         * Safety boundary:
         *
         * Delete only known MLB analytics handlers.
         * Do not delete an unknown trigger merely because
         * it is not in KEEP_HANDLERS.
         */
        const isLegacyMLBAnalyticsTrigger =
            /^refreshMLBPlayerGameLogs/.test(handler) ||
            /^refreshMLBTeamGameLogs/.test(handler) ||
            handler === "refreshMLBPlayerTrendPipeline" ||
            handler === "refreshMLBTeamTrendPipeline" ||
            handler === "refreshMLBTopPlayerTrendPipeline" ||
            handler === "refreshMLBTopTeamTrendPipeline";

        if (!isLegacyMLBAnalyticsTrigger) {

            Logger.log(
                `LEAVING UNCHANGED: ${handler}`
            );

            return;
        }

        Logger.log(
            `DELETING LEGACY ANALYTICS TRIGGER: ${handler}`
        );

        ScriptApp.deleteTrigger(trigger);

        deleted++;

    });

    const remaining =
        ScriptApp.getProjectTriggers();

    Logger.log(
        "=============================================="
    );

    Logger.log(
        `Deleted legacy analytics triggers: ${deleted}`
    );

    Logger.log(
        `Explicitly kept operational triggers: ${kept}`
    );

    Logger.log(
        `Triggers remaining: ${remaining.length}`
    );

    Logger.log(
        "Remaining handlers:"
    );

    remaining.forEach((trigger, index) => {

        Logger.log(
            `${index + 1}. ${trigger.getHandlerFunction()}`
        );

    });

    Logger.log(
        "=============================================="
    );

    Logger.log(
        "MLB LEGACY ANALYTICS TRIGGER CLEANUP COMPLETE"
    );

}

