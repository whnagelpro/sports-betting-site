function refreshMLBPlayerGameLogsForDateRange_(startDate, endDate) {
  ensureMLBTrendTabs_();

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("MLB Player Game Logs");

  const headers = [
    "Game Date", "Game ID", "Player ID", "Player Name", "Team", "Opponent",
    "Hits", "Runs", "RBIs", "Home Runs", "Total Bases", "Strikeouts", "Walks",
    "Stolen Bases", "Hits + Runs + RBIs", "Pitcher Strikeouts", "Pitcher Outs",
    "Pitcher Earned Runs", "Pitcher Hits Allowed", "Pitcher Walks"
  ];

  Logger.log(`Refreshing MLB Player Game Logs from ${startDate} to ${endDate}`);

  const selectedGames = getMLBCompletedGamesForDateRange_(startDate, endDate);
  if (!selectedGames.length) return;

  const gameMap = {};
  const gameIds = selectedGames.map(game => {
    const gameId = String(game.id || "");
    gameMap[gameId] = {
      date: getMLBGameAZDate_(game),
      homeTeam: getMLBTeamName_(game.home_team || {}),
      awayTeam: getMLBTeamName_(game.away_team || game.visitor_team || {})
    };
    return gameId;
  }).filter(Boolean);

  const statRows = fetchAllMLBStatsForGameIds_(gameIds);
  const rows = [];

  statRows.forEach(stat => {
    const gameId = String(stat.game_id || (stat.game && stat.game.id) || "");
    const gameInfo = gameMap[gameId] || {};

    const playerId = stat.player_id || (stat.player && stat.player.id) || "";
    const playerName = getMLBPlayerNameFromStat_(stat);

    const teamName = stat.team_name || getMLBTeamName_(stat.team || {}) || "";

    const opponent =
      teamName === gameInfo.homeTeam ? gameInfo.awayTeam :
      teamName === gameInfo.awayTeam ? gameInfo.homeTeam : "";

    const hits = getMLBGameStatFlexible_(stat, ["batting_h", "hits", "h"]);
    const runs = getMLBGameStatFlexible_(stat, ["batting_r", "runs", "runs_scored"]);
    const rbis = getMLBGameStatFlexible_(stat, ["batting_rbi", "rbis", "rbi"]);
    const homeRuns = getMLBGameStatFlexible_(stat, ["batting_hr", "home_runs", "hr"]);
    const totalBases = getMLBGameStatFlexible_(stat, ["batting_tb", "total_bases", "tb"]);
    const strikeouts = getMLBGameStatFlexible_(stat, ["batting_so", "strikeouts", "k"]);
    const walks = getMLBGameStatFlexible_(stat, ["batting_bb", "walks", "bb"]);
    const stolenBases = getMLBGameStatFlexible_(stat, ["batting_sb", "stolen_bases", "sb"]);

    const pitcherStrikeouts = getMLBGameStatFlexible_(stat, ["p_k", "pitching_k", "pitching_so"]);
    const pitcherOuts = getMLBGameStatFlexible_(stat, ["pitching_outs", "outs_recorded", "pitcher_outs"]);
    const pitcherEarnedRuns = getMLBGameStatFlexible_(stat, ["pitching_er", "earned_runs", "er"]);
    const pitcherHitsAllowed = getMLBGameStatFlexible_(stat, ["p_hits", "pitching_h", "hits_allowed"]);
    const pitcherWalks = getMLBGameStatFlexible_(stat, ["p_bb", "pitching_bb", "walks_allowed", "pitcher_walks"]);

    if (!playerId && !playerName) return;

    const played =
      hits > 0 || runs > 0 || rbis > 0 || homeRuns > 0 || totalBases > 0 ||
      strikeouts > 0 || walks > 0 || stolenBases > 0 ||
      pitcherStrikeouts > 0 || pitcherOuts > 0 || pitcherEarnedRuns > 0 ||
      pitcherHitsAllowed > 0 || pitcherWalks > 0;

    if (!played) return;

    rows.push([
      gameInfo.date, gameId, playerId, playerName, teamName, opponent,
      hits, runs, rbis, homeRuns, totalBases, strikeouts, walks, stolenBases,
      hits + runs + rbis, pitcherStrikeouts, pitcherOuts, pitcherEarnedRuns,
      pitcherHitsAllowed, pitcherWalks
    ]);
  });

  upsertRowsByKeyForDateRange_(sheet, headers, rows, [1, 2], startDate, endDate);
  Logger.log(`Upserted ${rows.length} MLB player game-log rows for ${startDate} to ${endDate}.`);
}

function getMLBPlayerNameFromStat_(stat) {
  const player = stat.player || {};

  const fullName =
    player.full_name ||
    player.name ||
    stat.player_name ||
    "";

  if (fullName) return fullName;

  return `${player.first_name || ""} ${player.last_name || ""}`.trim();
}

