      underProbability,
      overOdds,
      underOdds,
      overEV,
      underEV,

      bestSide:
        decision.bestSide,

      bestEV:
        decision.bestEV,

      bestModelProbability:
        decision.bestModelProbability,

      bestPriceEdge:
        decision.bestPriceEdge
    },

    results
  };


  Logger.log(
    JSON.stringify(
      summary,
      null,
      2
    )
  );


  if (!summary.pass) {
    throw new Error(
      "D10AC MLB probability / price / EV integration audit failed."
    );
  }


  return summary;
}

