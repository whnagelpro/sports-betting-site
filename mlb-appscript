    "Last Updated",
    "Normalized Trend Score",
    "Trend Strength Score",
    "Risk Score",
    "Sportacular Score"
  ];

  const logs = getMLBObjectsFromSheet_(logSheet);
  const grouped = {};

  logs.forEach(row => {
    const playerId = String(row["Player ID"] || "");
    if (!playerId) return;

    if (!grouped[playerId]) {
      grouped[playerId] = {
        playerId,
        playerName: row["Player Name"] || "",
        team: row["Team"] || "",
        games: []
      };
    }

    grouped[playerId].games.push({
      date: row["Game Date"],
      hits: Number(row["Hits"] || 0),
      runs: Number(row["Runs"] || 0),
      rbis: Number(row["RBIs"] || 0),
      homeRuns: Number(row["Home Runs"] || 0),
      totalBases: Number(row["Total Bases"] || 0),
      strikeouts: Number(row["Strikeouts"] || 0),
      walks: Number(row["Walks"] || 0),
      stolenBases: Number(row["Stolen Bases"] || 0),
      hrr: Number(row["Hits + Runs + RBIs"] || 0),
      pitcherStrikeouts: Number(row["Pitcher Strikeouts"] || 0),
      pitcherOuts: Number(row["Pitcher Outs"] || 0),
      pitcherEarnedRuns: Number(row["Pitcher Earned Runs"] || 0),
      pitcherHitsAllowed: Number(row["Pitcher Hits Allowed"] || 0),
      pitcherWalks: Number(row["Pitcher Walks"] || 0)
    });
  });

  const now = new Date();
  const rows = [];

  Object.values(grouped).forEach(player => {
    const games = player.games.sort((a, b) => new Date(b.date) - new Date(a.date));

    MLB_PLAYER_TREND_STATS.forEach(stat => {
      const values = games.map(g => Number(g[stat.key] || 0));
      const hasAnyData =
        values.some(v => Number(v) > 0);

      const seasonAvg = avgMLB_(values);
      const last3 = avgMLB_(values.slice(0, 3));
      const last5 = avgMLB_(values.slice(0, 5));
      const last10 = avgMLB_(values.slice(0, 10));
      const consistency = consistencyScoreMLB_(values);
      const score = trendScoreMLB_(last5, seasonAvg);

      const hitRateLast3 = hitRateMLB_(values.slice(0, 3), 1);
      const hitRateLast5 = hitRateMLB_(values.slice(0, 5), 1);
      const hitRateLast10 = hitRateMLB_(values.slice(0, 10), 1);
      const aboveSeasonPct = aboveSeasonPctMLB_(last5, seasonAvg);
      const strength = trendStrengthMLB_(hitRateLast5, aboveSeasonPct, score);

      const riskTier =
        riskTierMLB_(
          consistency,
          Math.abs(score)
        );

      const normalizedTrendScore =
        normalizedTrendScoreMLB_(score);

      const trendStrengthScore =
        trendStrengthScoreMLB_(strength);

      const riskScore =
        riskScoreMLB_(riskTier);

      const hasSample =
        seasonAvg > 0 ||
        last3 > 0 ||
        last5 > 0 ||
        last10 > 0;

      const sportacularScore =
        hasSample
          ? sportacularScoreMLB_({
              normalizedTrendScore,
              consistency,
              hitRateLast5,
              hitRateLast10
            })
          : "";
      const note = buildMLBTrendNote_(
        player.playerName,
        normalizeMLBStatType_(stat.label),
        seasonAvg,
        last5,
        hitRateLast5,
        score
      );

      if (!hasAnyData) {
        return;
      }

      rows.push([
        player.playerId,
        player.playerName,
        player.team,
        stat.label,
        seasonAvg,
        last3,
        last5,
        last10,
        trendDirectionMLB_(score),
        score,
        consistency,
        riskTier,
        hitRateLast3,
        hitRateLast5,
        hitRateLast10,
        aboveSeasonPct,
        strength,
        note,
        now,
        normalizedTrendScore,
        trendStrengthScore,
        riskScore,
        sportacularScore
      ]);
    });
  });

  rows.sort((a, b) =>
    String(a[1] || "").localeCompare(String(b[1] || "")) ||
    String(a[3] || "").localeCompare(String(b[3] || ""))
  );

  writeMLBOutputSheet_(sheet, headers, rows);

  sheet.getRange("M:O").setNumberFormat("0%");
  sheet.getRange("P:P").setNumberFormat("0.0");
  sheet.getRange("T:V").setNumberFormat("0.0");
  sheet.getRange("W:W").setNumberFormat("0.0");

  Logger.log(`Wrote ${rows.length} rows to MLB Player Trends with hit-rate metrics.`);
}

