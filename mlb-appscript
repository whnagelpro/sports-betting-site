/**
 * ============================================================================
 * P13 D4 — MLB UNIVERSAL DECISION + TREND FIELDS
 * ============================================================================
 *
 * Builds universal Y:AG:
 *
 *   Y   Best Side
 *   Z   Best EV
 *   AA  Best Model Probability
 *   AB  Best Price Edge
 *   AC  Trend Score
 *   AD  Trend Strength
 *   AE  Risk Score
 *   AF  Risk Tier
 *   AG  Model Confidence
 *
 * IMPORTANT:
 * - Best Side is the mathematically strongest AVAILABLE EV side.
 * - This is NOT yet the final P15 actionable recommendation threshold.
 * - Missing data stays unavailable.
 * - Existing MLB trend/risk outputs are preserved.
 * - AH:AJ remain outside this helper and deferred to P15.
 * ============================================================================
 */


function americanOddsToImpliedProbabilityMLB_(
  americanOdds
) {
  if (
    americanOdds === "" ||
    americanOdds === null ||
    americanOdds === undefined
  ) {
    return null;
  }


  const odds =
    Number(
      americanOdds
    );


  if (
    !Number.isFinite(odds) ||
    odds === 0
  ) {
    return null;
  }


  if (odds > 0) {
    return (
      100 /
      (
        odds + 100
      )
    );
  }


  return (
    Math.abs(odds) /
    (
      Math.abs(odds) + 100
    )
  );
}


function getMLBTrendRowForProp_(
  playerId,
  propType,
  trendIndex
) {
  const normalizedPropType =
    normalizeMLBStatType_(
      propType
    );


  if (
    !playerId ||
    !normalizedPropType ||
    !trendIndex
  ) {
    return null;
  }


  return (
    trendIndex[
      `${String(playerId)}::${normalizedPropType}`
    ] || null
  );
}


function getNullableMLBNumericField_(
  row,
  fieldName
) {
  if (!row) {
    return null;
  }


  const rawValue =
    row[fieldName];


  if (
    rawValue === "" ||
    rawValue === null ||
    rawValue === undefined
  ) {
    return null;
  }


  const numericValue =
    Number(
      rawValue
    );


  return Number.isFinite(
    numericValue
  )
    ? numericValue
    : null;
}


function getNullableMLBTextField_(
  row,
  fieldName
) {
  if (!row) {
    return null;
  }


  const rawValue =
    row[fieldName];


  if (
    rawValue === "" ||
    rawValue === null ||
    rawValue === undefined
  ) {
    return null;
  }


  const textValue =
    String(
      rawValue
    ).trim();


  return textValue
    ? textValue
    : null;
}


function buildMLBUniversalDecisionTrendFields_({
  playerId,
  propType,
  modelProbOver,
  modelProbUnder,
  evOver,
  evUnder,
  overOdds,
  underOdds,
  trendIndex
}) {
  // --------------------------------------------------------------------------
  // TREND / RISK / CONFIDENCE
  // --------------------------------------------------------------------------

  const trendRow =
    getMLBTrendRowForProp_(
      playerId,
      propType,
      trendIndex
    );


  // Prefer the normalized numeric trend output already generated by MLB.
  // Fall back to the original Trend Score only if needed.
  let trendScore =
    getNullableMLBNumericField_(
      trendRow,
      "Normalized Trend Score"
    );


  if (trendScore === null) {
    trendScore =
      getNullableMLBNumericField_(
        trendRow,
        "Trend Score"
      );
  }


  // Universal AD is a descriptive strength field.
  // Preserve the existing MLB Trend Strength label.
  const trendStrength =
    getNullableMLBTextField_(
      trendRow,
      "Trend Strength"
    );


  // MLB already has a numeric Risk Score in its validated trends pipeline.
  const riskScore =
    getNullableMLBNumericField_(
      trendRow,
      "Risk Score"
    );


  const riskTier =
    getNullableMLBTextField_(
      trendRow,
      "Risk Tier"
    );


  let modelConfidence = null;


  if (trendRow) {
    const calculatedConfidence =
      calculateTrendConfidence_(
        trendRow
      );


    if (
      calculatedConfidence !== null &&
      calculatedConfidence !== undefined &&
      Number.isFinite(
        Number(
          calculatedConfidence
        )
      )
    ) {
      modelConfidence =
        Number(
          calculatedConfidence
        );
    }
  }


  // --------------------------------------------------------------------------
  // DECISION FIELDS
  // --------------------------------------------------------------------------

  const overAvailable =
    evOver !== null &&
    evOver !== undefined &&
    Number.isFinite(
      Number(evOver)
    ) &&
    modelProbOver !== null &&
    modelProbOver !== undefined &&
    Number.isFinite(
      Number(modelProbOver)
    );


  const underAvailable =
    evUnder !== null &&
    evUnder !== undefined &&
    Number.isFinite(
      Number(evUnder)
    ) &&
    modelProbUnder !== null &&
    modelProbUnder !== undefined &&
    Number.isFinite(
      Number(modelProbUnder)
    );


  let bestSide =
    "No Play";

  let bestEV =
    null;

  let bestModelProbability =
    null;

  let selectedOdds =
    null;


  if (
    overAvailable &&
    underAvailable
  ) {
    if (
      Number(evOver) >=
      Number(evUnder)
    ) {
      bestSide =
        "Over";

      bestEV =
        Number(evOver);

      bestModelProbability =
        Number(modelProbOver);

      selectedOdds =
        overOdds;

    } else {

      bestSide =
        "Under";

      bestEV =
        Number(evUnder);

      bestModelProbability =
        Number(modelProbUnder);

      selectedOdds =
        underOdds;
    }

  } else if (overAvailable) {

    bestSide =
      "Over";

    bestEV =
      Number(evOver);

    bestModelProbability =
      Number(modelProbOver);

    selectedOdds =
      overOdds;

  } else if (underAvailable) {

    bestSide =
      "Under";

    bestEV =
      Number(evUnder);

    bestModelProbability =
      Number(modelProbUnder);

    selectedOdds =
      underOdds;
  }


  // --------------------------------------------------------------------------
  // BEST PRICE EDGE
  //
  // Selected-side model probability minus sportsbook implied probability.
  // --------------------------------------------------------------------------

  let bestPriceEdge =
    null;


  if (
    bestSide !== "No Play" &&
    bestModelProbability !== null
  ) {
    const impliedProbability =
      americanOddsToImpliedProbabilityMLB_(
        selectedOdds
      );


    if (
      impliedProbability !== null
    ) {
      bestPriceEdge =
        bestModelProbability -
        impliedProbability;
    }
  }


  return {
    bestSide,
    bestEV,
    bestModelProbability,
    bestPriceEdge,
    trendScore,
    trendStrength,
    riskScore,
    riskTier,
    modelConfidence
  };
}

