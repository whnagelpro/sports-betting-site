function getTodayDisplayString_() {
  return Utilities.formatDate(new Date(), "America/Phoenix", "MM/dd/yyyy");
}

/**
 * Reads today's MLB slate from the Game Odds tab.
 * Uses:
 *   B = Game Id
 *   X = Game Date
 *   Y = Away Team
 *   Z = Home Team
 *
 * Returns a map keyed by game ID.
 * @returns {Object}
 */
function getTodayMLBGameMapFromGameOdds_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Game Odds");

  if (!sheet) {
    throw new Error('Sheet "Game Odds" not found.');
  }

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) {
    return {};
  }

  const todayDisplay = getTodayDisplayString_();

  // Read B:Z so we can access B, X, Y, Z by index
  const values = sheet.getRange(2, 2, lastRow - 1, 25).getDisplayValues();
  const gameMap = {};

  values.forEach(row => {
    const gameId = row[0];   // B
    const gameDate = row[22]; // X
    const awayTeam = row[23]; // Y
    const homeTeam = row[24]; // Z

    if (!gameId) return;
    if (!gameDate) return;

    if (gameDate === todayDisplay) {
      if (!gameMap[gameId]) {
        gameMap[gameId] = {
          game_id: gameId,
          game_date: gameDate,
          away_team: awayTeam || "",
          home_team: homeTeam || ""
        };
      }
    }
  });

  return gameMap;
}

// ============================================================================
// D10AB — MLB PROP PROBABILITY RELIABILITY CALIBRATION
//
// Purpose:
//   Reduce overconfidence in raw MLB Poisson probabilities when:
//   1. The historical sample is small.
//   2. The stat is volatile relative to the player's projection.
//
// IMPORTANT:
//   Step 1 is TEST-ONLY.
//   Nothing in production calls this helper yet.
// ============================================================================

function getMLBPropProbabilityReliability_({
  currentGames,
  projectedStat,
  statStdDev
}) {
  const games =
    Number(currentGames);

  const projection =
    Number(projectedStat);

  const stdDev =
    Number(statStdDev);


  // --------------------------------------------------------------------------
  // 1. SAMPLE-SIZE RELIABILITY
  //
  // MLB stabilizes more slowly than the NFL helper because of the larger
  // schedule and greater game-to-game variance in many hitter markets.
  //
  // 0 games  -> 0.55
  // 1 game   -> 0.575
  // 2 games  -> 0.60
  // 5 games  -> 0.675
  // 10 games -> 0.80
  // 18+      -> 1.00
  // --------------------------------------------------------------------------

  const safeGames =
    Number.isFinite(games)
      ? Math.max(0, games)
      : 0;


  const sampleReliability =
    Math.min(
      1,
      0.55 +
      (
        Math.min(
          safeGames,
          18
        ) / 18
      ) * 0.45
    );


  // --------------------------------------------------------------------------
  // 2. VOLATILITY RELIABILITY
  //
  // Compare historical standard deviation with the projected mean.
  //
  // Higher relative volatility = less confidence that the raw Poisson
  // probability should be trusted at full strength.
  // --------------------------------------------------------------------------

  let volatilityReliability =
    1;


  if (
    Number.isFinite(projection) &&
    projection > 0 &&
    Number.isFinite(stdDev) &&
    stdDev >= 0
  ) {
    const coefficientOfVariation =
      stdDev / projection;


    // Smooth penalty rather than a hard threshold.
    volatilityReliability =
      1 /
      (
        1 +
        0.35 *
        coefficientOfVariation
      );


    // Do not allow volatility alone to destroy the model signal.
    volatilityReliability =
      Math.max(
        0.55,
        Math.min(
          1,
          volatilityReliability
        )
      );
  }


  // --------------------------------------------------------------------------
  // 3. COMBINED RELIABILITY
  //
  // Sample size and volatility both matter.
  // --------------------------------------------------------------------------

  const reliability =
    Math.max(
      0.50,
      Math.min(
        1,
        sampleReliability *
        volatilityReliability
      )
    );


  return reliability;
}


// ============================================================================
// Pull a raw probability toward 50% according to reliability.
//
// reliability = 1.00 -> raw probability unchanged
// reliability = 0.50 -> half of the distance from 50% is retained
// ============================================================================

function calibrateMLBPropProbability_(
  rawProbability,
  reliability
) {
  const raw =
    Number(rawProbability);

  const rel =
    Number(reliability);


  if (
    !Number.isFinite(raw) ||
    raw < 0 ||
    raw > 1 ||
    !Number.isFinite(rel)
  ) {
    return null;
  }


  const safeReliability =
    Math.max(
      0,
      Math.min(
        1,
        rel
      )
    );


  return (
    0.5 +
    (
      raw - 0.5
    ) *
    safeReliability
  );
}


// ============================================================================
// D10AB TEST
// ============================================================================

function testMLBPlayerPropProbabilityReliability() {
  const tests = [];


  function addTest(
    name,
    condition,
    details
  ) {
    tests.push({
      test: name,
      pass: Boolean(condition),
      ...details
    });
  }


  // --------------------------------------------------------------------------
  // TEST 1 — Reliability increases with sample size.
  // --------------------------------------------------------------------------

  const sampleSizes =
    [
      0,
      1,
      2,
      5,
      10,
      18,
      30
    ];


  const sampleResults =
    sampleSizes.map(
      currentGames => ({
        currentGames,

        reliability:
          getMLBPropProbabilityReliability_({
            currentGames,
            projectedStat: 1,
            statStdDev: 0
          })
      })
    );


  let samplePass = true;


  for (
    let i = 1;
    i < sampleResults.length;
    i++
  ) {
    if (
      sampleResults[i].reliability <
      sampleResults[i - 1].reliability
    ) {
      samplePass = false;
      break;
    }
  }


  addTest(
    "MLB reliability increases with sample size",
    samplePass &&
    sampleResults[0].reliability < 1 &&
    sampleResults[
      sampleResults.length - 1
    ].reliability === 1,
    {
      results: sampleResults
    }
  );


  // --------------------------------------------------------------------------
  // TEST 2 — More volatility lowers reliability.
  // --------------------------------------------------------------------------

  const lowVolatility =
    getMLBPropProbabilityReliability_({
      currentGames: 18,
      projectedStat: 1,
      statStdDev: 0.25
    });


  const mediumVolatility =
    getMLBPropProbabilityReliability_({
      currentGames: 18,
      projectedStat: 1,
      statStdDev: 1
    });


  const highVolatility =
    getMLBPropProbabilityReliability_({
      currentGames: 18,
      projectedStat: 1,
      statStdDev: 2
    });


  addTest(
    "MLB volatility reduces reliability",
    lowVolatility >
      mediumVolatility &&
    mediumVolatility >
      highVolatility,
    {
      lowVolatility,
      mediumVolatility,
      highVolatility
    }
  );


  // --------------------------------------------------------------------------
  // TEST 3 — Reliability stays inside safe bounds.
  // --------------------------------------------------------------------------

  const extremeReliability =
    getMLBPropProbabilityReliability_({
      currentGames: 0,
      projectedStat: 0.2,
      statStdDev: 5
    });


  addTest(
    "MLB reliability stays within safe bounds",
    extremeReliability >= 0.50 &&
    extremeReliability <= 1,
    {
      extremeReliability
    }
  );


  // --------------------------------------------------------------------------
  // TEST 4 — A raw 100% probability gets pulled away from certainty.
  // --------------------------------------------------------------------------

  const exampleReliability =
    getMLBPropProbabilityReliability_({
      currentGames: 10,
      projectedStat: 0.9,
      statStdDev: 1.2
    });


  const calibratedExtreme =
    calibrateMLBPropProbability_(
      1,
      exampleReliability
    );


  addTest(
    "100% raw probability is pulled away from certainty",
    calibratedExtreme > 0.5 &&
    calibratedExtreme < 1,
    {
      reliability:
        exampleReliability,

      rawProbability:
        1,

      calibratedProbability:
        calibratedExtreme
    }
  );


  // --------------------------------------------------------------------------
  // TEST 5 — 50% stays 50%.
  // --------------------------------------------------------------------------

  const calibratedNeutral =
    calibrateMLBPropProbability_(
      0.5,
      0.6
    );


  addTest(
    "50% probability remains neutral",
    Math.abs(
      calibratedNeutral - 0.5
    ) < 1e-12,
    {
      calibratedProbability:
        calibratedNeutral
    }
  );


  // --------------------------------------------------------------------------
  // TEST 6 — Full reliability leaves probability unchanged.
  // --------------------------------------------------------------------------

  const rawProbability =
    0.73;


  const fullReliabilityProbability =
    calibrateMLBPropProbability_(
      rawProbability,
      1
    );


  addTest(
    "Full reliability preserves raw probability",
    Math.abs(
      fullReliabilityProbability -
      rawProbability
    ) < 1e-12,
    {
      rawProbability,

      calibratedProbability:
        fullReliabilityProbability
    }
  );


  const pass =
    tests.every(
      test =>
        test.pass === true
    );


  const output = {
    test:
      "D10AB MLB PROP PROBABILITY RELIABILITY",

    pass,

    results:
      tests
  };


  Logger.log(
    JSON.stringify(
      output,
      null,
      2
    )
  );


  return output;
}

// ============================================================================
// D10AB STEP 3 — MLB PRODUCTION-STYLE PROBABILITY CALIBRATION TEST
//
// Purpose:
//   Verify that a Brenton-Doyle-style Total Bases market no longer produces
//   an unrealistic near-100% probability after D10AB reliability calibration.
//
// TEST ONLY — does not modify production output.
// ============================================================================

function testMLBProductionStyleProbabilityCalibration() {
  const tests = [];


  function assertTest(
    name,
    condition,
    details
  ) {
    const pass =
      Boolean(
        condition
      );


    const result = {
      name,
      pass,
      ...details
    };


    tests.push(
      result
    );


    Logger.log(
      JSON.stringify(
        result
      )
    );


    if (!pass) {
      throw new Error(
        `D10AB production-style calibration test failed: ${name}`
      );
    }
  }


  // --------------------------------------------------------------------------
  // Representative Total Bases scenario.
  //
  // This intentionally mirrors the shape of the live problem:
  //
  //   projected production << sportsbook line
  //
  // Previously, raw Poisson probability could display essentially 100%
  // on the Under side.
  // --------------------------------------------------------------------------

  const projectedStat =
    0.90;


  const lineValue =
    4.5;


  const currentGames =
    10;


  const statStdDev =
    1.20;


  const overOdds =
    -105;


  const underOdds =
    -105;


  // --------------------------------------------------------------------------
  // RAW POISSON — diagnostic baseline
  // --------------------------------------------------------------------------

  const raw =
    getMLBPoissonSideProbabilities_(
      projectedStat,
      lineValue
    );


  // --------------------------------------------------------------------------
  // PRODUCTION FUNCTION — includes D10AB calibration
  // --------------------------------------------------------------------------

  const calibrated =
    buildMLBUniversalPropProbabilityEV_({
      propType:
        "Total Bases",

      projectedStat,

      lineValue,

      overOdds,

      underOdds,

      currentGames,

      statStdDev
    });


  Logger.log(
    JSON.stringify(
      {
        test:
          "D10AB MLB PRODUCTION-STYLE CALIBRATION",

        inputs: {
          projectedStat,
          lineValue,
          currentGames,
          statStdDev,
          overOdds,
          underOdds
        },

        raw,

        calibrated
      },
      null,
      2
    )
  );


  // --------------------------------------------------------------------------
  // TEST 1 — Production probabilities exist.
  // --------------------------------------------------------------------------

  assertTest(
    "Calibrated probabilities exist",

    calibrated.modelProbOver !== null &&
    calibrated.modelProbUnder !== null &&
    Number.isFinite(
      calibrated.modelProbOver
    ) &&
    Number.isFinite(
      calibrated.modelProbUnder
    ),

    {
      modelProbOver:
        calibrated.modelProbOver,

      modelProbUnder:
        calibrated.modelProbUnder
    }
  );


  // --------------------------------------------------------------------------
  // TEST 2 — Reliability exists and is bounded.
  // --------------------------------------------------------------------------

  assertTest(
    "Probability reliability exists and is bounded",

    Number.isFinite(
      calibrated.probabilityReliability
    ) &&
    calibrated.probabilityReliability >= 0.50 &&
    calibrated.probabilityReliability <= 1,

    {
      probabilityReliability:
        calibrated.probabilityReliability
    }
  );


  // --------------------------------------------------------------------------
  // TEST 3 — Extreme Under probability is pulled away from certainty.
  // --------------------------------------------------------------------------

  assertTest(
    "Extreme Under probability is pulled below 100%",

    calibrated.modelProbUnder < 1,

    {
      rawUnder:
        raw.underProbability,

      calibratedUnder:
        calibrated.modelProbUnder
    }
  );


  // --------------------------------------------------------------------------
  // TEST 4 — Calibration actually reduces the extreme Under probability.
  // --------------------------------------------------------------------------

  assertTest(
    "Calibration reduces extreme Under probability",

    calibrated.modelProbUnder <
      raw.underProbability,

    {
      rawUnder:
        raw.underProbability,

      calibratedUnder:
        calibrated.modelProbUnder
    }
  );


  // --------------------------------------------------------------------------
  // TEST 5 — Half-point probability contract remains intact.
  //
  // 4.5 cannot push, so Over + Under must equal exactly 1.
  // --------------------------------------------------------------------------

  assertTest(
    "Half-point probabilities still sum to 1",

    Math.abs(
      (
        calibrated.modelProbOver +
        calibrated.modelProbUnder
      ) -
      1
    ) < 1e-9,

    {
      modelProbOver:
        calibrated.modelProbOver,

      modelProbUnder:
        calibrated.modelProbUnder,

      total:
        calibrated.modelProbOver +
        calibrated.modelProbUnder
    }
  );


  // --------------------------------------------------------------------------
  // TEST 6 — No push exists at 4.5.
  // --------------------------------------------------------------------------

  assertTest(
    "Half-point Total Bases line has zero push probability",

    Math.abs(
      Number(
        calibrated.pushProbability
      )
    ) < 1e-12,

    {
      pushProbability:
        calibrated.pushProbability
    }
  );


  // --------------------------------------------------------------------------
  // TEST 7 — EV survives calibration.
  // --------------------------------------------------------------------------

  assertTest(
    "Calibrated EV values exist",

    calibrated.evOver !== null &&
    calibrated.evUnder !== null &&
    Number.isFinite(
      calibrated.evOver
    ) &&
    Number.isFinite(
      calibrated.evUnder
    ),

    {
      evOver:
        calibrated.evOver,

      evUnder:
        calibrated.evUnder
    }
  );


  // --------------------------------------------------------------------------
  // FINAL RESULT
  // --------------------------------------------------------------------------

  const pass =
    tests.every(
      test =>
        test.pass === true
    );


  const output = {
    test:
      "D10AB MLB PRODUCTION-STYLE PROBABILITY CALIBRATION",

    tests:
      tests.length,

    passed:
      tests.filter(
        test =>
          test.pass === true
      ).length,

    pass,

    results:
      tests
  };


  Logger.log(
    JSON.stringify(
      output,
      null,
      2
    )
  );


  return output;
}

