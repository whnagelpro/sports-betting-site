 */
function buildMLBUniversalPlayerPropRow_({
  providerRow,
  identity,
  historicalContext,
  probabilityEV,
  decisionTrend,
  sportacularScoring
}) {

  const scoring =
    sportacularScoring || {};


  const row = [

    // A:N — PROVIDER
    providerRow["Game Id"] ?? "",          // A
    providerRow["Game Date"] ?? "",        // B
    providerRow["Away Team"] ?? "",        // C
    providerRow["Home Team"] ?? "",        // D
    providerRow["Id"] ?? "",               // E
    providerRow["Player Id"] ?? "",        // F
    providerRow["Vendor"] ?? "",           // G
    providerRow["Prop Type"] ?? "",        // H
    providerRow["Line Value"] ?? "",       // I
    providerRow["Type"] ?? "",             // J
    providerRow["Odds"] ?? "",             // K
    providerRow["Updated At"] ?? "",       // L
    providerRow["Over Odds"] ?? "",        // M
    providerRow["Under Odds"] ?? "",       // N


    // O:P — IDENTITY
    identity
      ? identity.playerName ?? ""
      : "",                                // O

    identity
      ? identity.team ?? ""
      : "",                                // P


    // Q:T — FROZEN MLB HISTORICAL / PROJECTION MODEL
    historicalContext.playerBaseline ??
      "",                                  // Q

    historicalContext.trendAdjustment ??
      "",                                  // R

    historicalContext.projectedStat ??
      "",                                  // S

    historicalContext.statStdDev ??
      "",                                  // T


    // U:X — FROZEN MLB PROBABILITY / EV MODEL
    probabilityEV.modelProbOver ??
      "",                                  // U

    probabilityEV.modelProbUnder ??
      "",                                  // V

    probabilityEV.evOver ??
      "",                                  // W

    probabilityEV.evUnder ??
      "",                                  // X


    // Y — P15 FINAL ACTIONABILITY
    scoring.finalBestSide ??
      "No Play",                           // Y


    // Z:AD — EXISTING MLB DECISION / TREND SIGNALS
    decisionTrend.bestEV ??
      "",                                  // Z

    decisionTrend.bestModelProbability ??
      "",                                  // AA

    decisionTrend.bestPriceEdge ??
      "",                                  // AB

    decisionTrend.trendScore ??
      "",                                  // AC

    decisionTrend.trendStrength ??
      "",                                  // AD


    // AE:AF — P15 UNIVERSAL RISK
    scoring.riskScore ??
      "",                                  // AE

    scoring.riskTier ??
      "",                                  // AF


    // AG — PRESERVE MLB MODEL CONFIDENCE
    decisionTrend.modelConfidence ??
      "",                                  // AG


    // AH:AJ — P15 UNIVERSAL SPORTACULAR SCORING
    scoring.sportacularScore ??
      "",                                  // AH

    scoring.sportacularEdge ??
      "",                                  // AI

    scoring.confidenceTier ??
      ""                                   // AJ
  ];


  if (
    row.length !==
    MLB_UNIVERSAL_PLAYER_PROPS_HEADERS.length
  ) {
    throw new Error(
      `Invalid MLB universal Player Props row width. Expected ${MLB_UNIVERSAL_PLAYER_PROPS_HEADERS.length}, received ${row.length}.`
    );
  }


  return row;
}

const MLB_PLAYER_IDENTITY_FALLBACK_CACHE_ = {};

/**
 * Full one-provider-row MLB universal production pipeline.
 *
 * Frozen MLB model:
 *
 * provider
 *   ↓
 * Q:T projection
 *   ↓
 * U:X probability + EV
 *   ↓
 * Z:AD + AG MLB decision/trend/confidence
 *   ↓
 * P15 universal scoring
 *   ↓
 * final Y + AE:AF + AH:AJ
 */
function buildMLBUniversalPropRowFromProvider_({
  providerRow,
  historyIndex,
  trendIndex,
  playerIdentityIndex
}) {

  const playerId =
    String(
      providerRow["Player Id"] ?? ""
    ).trim();


  const propType =
    providerRow["Prop Type"];


  let identity =
    playerIdentityIndex[
      playerId
    ] || null;


  if (
    !identity ||
    !identity.playerName
  ) {

    if (
      !Object.prototype.hasOwnProperty.call(
        MLB_PLAYER_IDENTITY_FALLBACK_CACHE_,
        playerId
      )
    ) {

      MLB_PLAYER_IDENTITY_FALLBACK_CACHE_[
        playerId
      ] =
        fetchMLBPlayerIdentityById_(
          playerId
        );
    }


    const fallbackIdentity =
      MLB_PLAYER_IDENTITY_FALLBACK_CACHE_[
        playerId
      ];


    if (
      fallbackIdentity &&
      fallbackIdentity.playerName
    ) {

      identity =
        fallbackIdentity;


      // Promote the resolved identity into the production index so every
      // subsequent prop for this player uses the same resolved identity.
      playerIdentityIndex[
        playerId
      ] =
        fallbackIdentity;
    }
  }


  identity =
    identity || {
      playerName: null,
      team: null
    };


  // --------------------------------------------------------------------------
  // Q:T — FROZEN MLB HISTORICAL / PROJECTION MODEL
  // --------------------------------------------------------------------------

  const historicalContext =
    buildMLBUniversalPropHistoricalContext_({
      playerId,
      propType,
      historyIndex,
      trendIndex
    });


  // --------------------------------------------------------------------------
  // U:X — FROZEN MLB PROBABILITY / EV MODEL
  // --------------------------------------------------------------------------

  const playerHistory =
    historyIndex[
      String(playerId)
    ] || [];


  const probabilityEV =
    buildMLBUniversalPropProbabilityEV_({
      propType,

      projectedStat:
        historicalContext.projectedStat,

      lineValue:
        providerRow["Line Value"],

      overOdds:
        providerRow["Over Odds"],

      underOdds:
        providerRow["Under Odds"],

      // D10AB — reliability inputs
      currentGames:
        playerHistory.length,

      statStdDev:
        historicalContext.statStdDev
    });


  // --------------------------------------------------------------------------
  // EXISTING MLB DECISION / TREND / CONFIDENCE
  //
  // Preserves:
  // Z  Best EV
  // AA Best Model Probability
  // AB Best Price Edge
  // AC Trend Score
  // AD Trend Strength
  // AG Model Confidence
  //
  // Existing MLB risk information may still be calculated internally,
  // but P15 now owns final AE/AF.
  // --------------------------------------------------------------------------

  const decisionTrend =
    buildMLBUniversalDecisionTrendFields_({
      playerId,
      propType,

      modelProbOver:
        probabilityEV.modelProbOver,

      modelProbUnder:
        probabilityEV.modelProbUnder,

      evOver:
        probabilityEV.evOver,

      evUnder:
        probabilityEV.evUnder,

      overOdds:
        providerRow["Over Odds"],

      underOdds:
        providerRow["Under Odds"],

      trendIndex
    });


  // --------------------------------------------------------------------------
  // P15 UNIVERSAL SPORTACULAR SCORING
  // --------------------------------------------------------------------------

  const sportacularScoring =
    buildUniversalSportacularScoring_({

      // I
      lineValue:
        providerRow["Line Value"],

      // S
      projectedStat:
        historicalContext.projectedStat,

      // T
      statStdDev:
        historicalContext.statStdDev,

      // W
      evOver:
        probabilityEV.evOver,

      // X
      evUnder:
        probabilityEV.evUnder,

      // AA
      bestModelProbability:
        decisionTrend.bestModelProbability,

      // AB
      bestPriceEdge:
        decisionTrend.bestPriceEdge,

      // AC
      trendScore:
        decisionTrend.trendScore,

      // AG
      modelConfidence:
        decisionTrend.modelConfidence
    });


  // --------------------------------------------------------------------------
  // FINAL A:AJ
  // --------------------------------------------------------------------------

  return buildMLBUniversalPlayerPropRow_({
    providerRow,
    identity,
    historicalContext,
    probabilityEV,
    decisionTrend,
    sportacularScoring
  });
}

