          expectedBestEV === null ||
          bestEV === null ||
          !approxEqual_(
            expectedBestEV,
            bestEV,
            1e-9
          )
        ) {

          bestEVViolations.push({
            row:
              sheetRow,

            providerId:
              providerId,

            playerName:
              playerName,

            propType:
              propType,

            candidateSide:
              candidateSide,

            expectedBestEV:
              expectedBestEV,

            actualBestEV:
              bestEV
          });
        }


        if (
          expectedBestProbability !== null
        ) {

          if (
            bestModelProbability === null ||
            !approxEqual_(
