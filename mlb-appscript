function getDefaultMLBDailyAnalyticsState_() {

  return {

    stage: "PLAYER_GAME_LOGS",

    playerMonthIndex: 0,

    teamMonthIndex: 0,

    completed: false,

    lastSuccessfulStep: null,

    lastError: null,

    updatedAt: null

  };

}


function getMLBDailyAnalyticsState_() {

  const properties =
    PropertiesService.getScriptProperties();

  const raw =
    properties.getProperty(
      MLB_DAILY_ANALYTICS_STATE_KEY
    );

  if (!raw) {

    return getDefaultMLBDailyAnalyticsState_();

  }

  try {

    return JSON.parse(raw);

  } catch (error) {

    Logger.log(
      "MLB mother pipeline state could not be parsed. Resetting state."
    );

    return getDefaultMLBDailyAnalyticsState_();

  }

}


function saveMLBDailyAnalyticsState_(state) {

  state.updatedAt =
    new Date().toISOString();

  PropertiesService
    .getScriptProperties()
    .setProperty(
      MLB_DAILY_ANALYTICS_STATE_KEY,
      JSON.stringify(state)
    );

}


function clearMLBDailyAnalyticsState_() {

  PropertiesService
    .getScriptProperties()
    .deleteProperty(
      MLB_DAILY_ANALYTICS_STATE_KEY
    );

}


// ------------------------------------------------------
// CONTINUATION TRIGGERS
// ------------------------------------------------------

function clearMLBDailyAnalyticsContinuationTriggers_() {

  const triggers =
    ScriptApp.getProjectTriggers();

  triggers.forEach(trigger => {

    if (
      trigger.getHandlerFunction() ===
      MLB_DAILY_ANALYTICS_HANDLER
    ) {

      ScriptApp.deleteTrigger(trigger);

    }

  });

}


function scheduleMLBDailyAnalyticsContinuation_() {

  clearMLBDailyAnalyticsContinuationTriggers_();

  ScriptApp
    .newTrigger(
      MLB_DAILY_ANALYTICS_HANDLER
    )
    .timeBased()
    .after(
      MLB_DAILY_ANALYTICS_RETRY_DELAY_MS
    )
    .create();

  Logger.log(
    "MLB mother pipeline continuation scheduled."
  );

}


// ------------------------------------------------------
// RUN ONE PIPELINE STEP SAFELY
// ------------------------------------------------------

function runMLBDailyAnalyticsStep_(
  state,
  stepName,
  fn
) {

  try {

    Logger.log(
      `MLB mother pipeline: refreshing ${stepName}`
    );

    fn();

    state.lastSuccessfulStep =
      stepName;

    state.lastError =
      null;

    saveMLBDailyAnalyticsState_(
      state
    );

    return true;

  } catch (error) {

    state.lastError =
      String(
        error && error.stack
          ? error.stack
          : error
      );

    saveMLBDailyAnalyticsState_(
      state
    );

    Logger.log(
      `MLB mother pipeline step FAILED: ${stepName}`
    );

    Logger.log(
      state.lastError
    );

    scheduleMLBDailyAnalyticsContinuation_();

    return false;

  }

}

