    "https://api.balldontlie.io/mlb/v1/players?player_ids[]=" +
      encodeURIComponent(TARGET_PLAYER_ID)
  ];


  const attempts = [];


  for (let i = 0; i < urls.length; i++) {

    const url = urls[i];

    let response = null;
    let status = null;
    let body = "";
    let parsed = null;
    let error = null;


    try {

      response =
        UrlFetchApp.fetch(
          url,
          {
            method: "get",
            headers: {
              Authorization: API_KEY
            },
            muteHttpExceptions: true
          }
        );


      status =
        response.getResponseCode();

      body =
        response.getContentText();


      try {

        parsed =
          body
            ? JSON.parse(body)
