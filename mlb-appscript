function buildMLBTeamGameStatsMap_(statRows) {
  const map = {};

  statRows.forEach(row => {
    const gameId = String(
      row.game_id ||
      (row.game && row.game.id) ||
      ""
    ).trim();

    const rawTeamName =
      row.team_name ||
      (row.team && getMLBTeamName_(row.team)) ||
      "";

    const teamName = normalizeMLBTeamName_(rawTeamName);

    if (!gameId || !teamName) return;

    const key = `${gameId}_${teamName}`;

    if (!map[key]) {
      map[key] = {
        runs: 0,
        hits: 0,
        homeRuns: 0,
        totalBases: 0,
        strikeouts: 0,
        rowCount: 0
      };
    }

    const hits = getMLBGameStatFlexible_(row, ["hits", "h", "batting_h"]);
    const runs = getMLBGameStatFlexible_(row, ["runs", "runs_scored", "batting_r"]);
    const homeRuns = getMLBGameStatFlexible_(row, ["home_runs", "hr", "batting_hr"]);
    const totalBases = getMLBGameStatFlexible_(row, ["total_bases", "tb", "batting_tb"]);
    const strikeouts = getMLBGameStatFlexible_(row, ["strikeouts", "k", "batting_so"]);

    map[key].runs += runs;
    map[key].hits += hits;
    map[key].homeRuns += homeRuns;
    map[key].totalBases += totalBases;
    map[key].strikeouts += strikeouts;
    map[key].rowCount += 1;
  });

  return map;
}

