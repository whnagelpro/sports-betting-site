    }
  );

  // --------------------------------------------------------------------------
  // SUMMARY
  // --------------------------------------------------------------------------

  const failed =
    results.filter(
      result => !result.pass
    ).length;

  const passed =
    results.length - failed;

  const summary = {

    test:
