            const previousGames =
              games.slice(
                0,
                targetIndex
              );

            const recentGames =
              previousGames.slice(-10);

            const actualRaw =
              games[targetIndex][
                market.column
              ];

            if (
              actualRaw === "" ||
              actualRaw === null ||
              actualRaw === undefined
            ) {
              continue;
            }

            const actual =
              Number(
                actualRaw
              );

            if (
              !Number.isFinite(
                actual
              )
            ) {
              continue;
            }

            const seasonValues =
              previousGames
                .map(row => {

                  const raw =
                    row[
                      market.column
                    ];

                  if (
                    raw === "" ||
                    raw === null ||
                    raw === undefined
                  ) {
                    return null;
                  }

                  const value =
                    Number(raw);

                  return Number.isFinite(
                    value
                  )
                    ? value
                    : null;
                })
                .filter(
                  Number.isFinite
                );

            const recentValues =
              recentGames
                .map(row => {

                  const raw =
                    row[
                      market.column
                    ];

                  if (
                    raw === "" ||
                    raw === null ||
                    raw === undefined
                  ) {
                    return null;
                  }

                  const value =
                    Number(raw);

                  return Number.isFinite(
                    value
                  )
                    ? value
                    : null;
                })
                .filter(
                  Number.isFinite
                );

            if (
              !seasonValues.length ||
              !recentValues.length
            ) {
              continue;
            }

            const seasonAvg =
              seasonValues.reduce(
                (sum, value) =>
                  sum + value,
                0
              ) /
              seasonValues.length;

            const recentAvg =
              recentValues.reduce(
                (sum, value) =>
                  sum + value,
                0
              ) /
              recentValues.length;

            const lambda =
              (
                seasonAvg *
                market.season
              ) +
              (
                recentAvg *
                market.recent
              );

            if (
              !Number.isFinite(
                lambda
              ) ||
              lambda < 0
            ) {
              continue;
            }

            const requiredCount =
              Math.floor(line) + 1;

            const probability =
              1 -
              poissonCDF(
                requiredCount - 1,
                lambda
              );

            observations.push({

              date:
                new Date(
                  games[
                    targetIndex
                  ][gameDateCol]
                ),

              probability:
                clampProbability(
                  probability
                ),

              outcome:
                actual >=
                  requiredCount
                    ? 1
                    : 0

            });

          }

        });

      if (
        observations.length < 100
      ) {
        return;
      }

      /*
       * GLOBAL chronological 75/25 split
       * separately for this exact
       * market + threshold.
       */
      observations.sort(
        (a, b) =>
          a.date -
          b.date
      );

      const splitIndex =
        Math.floor(
          observations.length *
          0.75
        );

      const training =
        observations.slice(
          0,
          splitIndex
        );

      const holdout =
        observations.slice(
          splitIndex
        );

      if (
        !training.length ||
        !holdout.length
      ) {
        return;
      }

      /*
       * Threshold-specific training base rate.
       */
      const trainingBaseRate =
        training.reduce(
          (sum, obs) =>
            sum + obs.outcome,
          0
        ) /
        training.length;

      /*
       * Select shrinkage using TRAINING ONLY.
       */
      let bestStrength = null;

      let bestTrainingMetrics = null;

      strengths.forEach(
        strength => {

          const metrics =
            calculateMetrics(
              training,
              probability =>
                shrinkProbability(
                  probability,
                  trainingBaseRate,
                  strength
                )
            );

          if (!metrics) {
            return;
          }

          if (
            bestTrainingMetrics === null ||
            metrics.brier <
              bestTrainingMetrics.brier ||
            (
              Math.abs(
                metrics.brier -
                bestTrainingMetrics.brier
              ) < 1e-12 &&
              metrics.ece <
                bestTrainingMetrics.ece
            )
          ) {

            bestStrength =
              strength;

            bestTrainingMetrics =
              metrics;
          }

        }
      );

      /*
       * Evaluate raw vs calibrated on the
       * untouched threshold-specific holdout.
       */
      const rawHoldout =
        calculateMetrics(
          holdout,
          probability =>
            probability
        );

      const calibratedHoldout =
        calculateMetrics(
          holdout,
          probability =>
            shrinkProbability(
              probability,
              trainingBaseRate,
              bestStrength
            )
        );

      if (
        !rawHoldout ||
        !calibratedHoldout
      ) {
        return;
      }

      const brierImprovement =
        rawHoldout.brier
          ? (
              (
                rawHoldout.brier -
                calibratedHoldout.brier
              ) /
              rawHoldout.brier
            ) * 100
          : 0;

      const eceImprovement =
        rawHoldout.ece
          ? (
              (
                rawHoldout.ece -
                calibratedHoldout.ece
              ) /
              rawHoldout.ece
            ) * 100
          : 0;

      const decision =
        (
          bestStrength > 0 &&
          calibratedHoldout.brier <
            rawHoldout.brier &&
          calibratedHoldout.ece <
            rawHoldout.ece
        )
          ? "PASS"
          : "FAIL";

      output.push([

        market.market,

        line,

        training.length,

        holdout.length,

        trainingBaseRate,

        bestStrength,

        rawHoldout.brier,

        calibratedHoldout.brier,

        brierImprovement,

        rawHoldout.ece,

        calibratedHoldout.ece,

        eceImprovement,

        rawHoldout.averageProbability,

        calibratedHoldout.averageProbability,

        rawHoldout.hitRate,

        decision

      ]);

    });

  });

  const sheetName =
    "MLB Threshold Calibration";

  let outputSheet =
    ss.getSheetByName(
      sheetName
    );

  if (!outputSheet) {

    outputSheet =
      ss.insertSheet(
        sheetName
      );
  }

  outputSheet.clearContents();

  const headers = [

    "Market",

    "Threshold",

    "Training Observations",

    "Holdout Observations",

    "Training Base Rate",

    "Selected Shrinkage",

    "Raw Holdout Brier",

    "Calibrated Holdout Brier",

    "Brier Improvement %",

    "Raw Holdout ECE",

    "Calibrated Holdout ECE",

    "ECE Improvement %",

    "Raw Avg Probability",

    "Calibrated Avg Probability",

    "Holdout Hit Rate",

    "Calibration Decision"

  ];

  outputSheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([
      headers
    ]);

  if (output.length) {

    outputSheet
      .getRange(
        2,
        1,
        output.length,
        headers.length
      )
      .setValues(
        output
      );
  }

  outputSheet.setFrozenRows(1);

  outputSheet.autoResizeColumns(
    1,
    headers.length
  );

  Logger.log(
    `MLB threshold calibration complete. ${output.length} market-threshold rows evaluated.`
  );

}

