      formulaCellCount: formulaCellCount,
      samples: formulaSamples
    }
  );


  // --------------------------------------------------------------------------
  // 3. REQUIRED ROUTING / MARKET IDENTITY
  // --------------------------------------------------------------------------

  const identityViolations = [];
  const marketViolations = [];
  const unsafeTextViolations = [];

  const providerIds = new Set();
  const duplicateProviderIds = [];

  let actionableRows = 0;
  let noPlayRows = 0;
  let partialNoPlayRows = 0;

  const actionablePayloadViolations = [];
  const noPlaySafetyViolations = [];
  const profileMap = new Map();

  rows.forEach(function(row, offset) {

    const sheetRow = offset + 2;

    const gameId = text_(row[IDX.gameId]);
    const gameDate = text_(row[IDX.gameDate]);
    const awayTeam = text_(row[IDX.awayTeam]);
    const homeTeam = text_(row[IDX.homeTeam]);

    const providerId = text_(row[IDX.providerId]);
    const playerId = text_(row[IDX.playerId]);
    const playerName = text_(row[IDX.playerName]);
    const team = text_(row[IDX.team]);

    const vendor = text_(row[IDX.vendor]);
    const propType = text_(row[IDX.propType]);
    const type = text_(row[IDX.type]);

    const bestSide = text_(row[IDX.bestSide]);
    const confidenceTier =
      text_(row[IDX.confidenceTier]);

    const missingIdentity = [];

    if (!gameId) missingIdentity.push("Game Id");
    if (!gameDate) missingIdentity.push("Game Date");
    if (!awayTeam) missingIdentity.push("Away Team");
    if (!homeTeam) missingIdentity.push("Home Team");
    if (!providerId) missingIdentity.push("Id");
    if (!playerId) missingIdentity.push("Player Id");
    if (!playerName) missingIdentity.push("Player Name");
    if (!team) missingIdentity.push("Team");

    if (missingIdentity.length) {
      identityViolations.push({
        row: sheetRow,
        providerId: providerId,
        playerId: playerId,
        playerName: playerName,
        missing: missingIdentity
      });
    }

    const missingMarket = [];

    if (!vendor) missingMarket.push("Vendor");
    if (!propType) missingMarket.push("Prop Type");
    if (!type) missingMarket.push("Type");

    if (missingMarket.length) {
      marketViolations.push({
        row: sheetRow,
        providerId: providerId,
        playerName: playerName,
        missing: missingMarket
      });
    }


    // ------------------------------------------------------------------------
    // Provider identity uniqueness
    // ------------------------------------------------------------------------

    if (providerId) {
      if (providerIds.has(providerId)) {
        if (duplicateProviderIds.length < 10) {
          duplicateProviderIds.push({
            row: sheetRow,
            providerId: providerId
          });
        }
      } else {
        providerIds.add(providerId);
      }
    }


    // ------------------------------------------------------------------------
    // Profile-routing stability
    // ------------------------------------------------------------------------

    if (playerId && playerName) {

      if (!profileMap.has(playerId)) {
        profileMap.set(playerId, {
          names: new Set(),
          teams: new Set(),
          rows: 0,
          actionableRows: 0
        });
      }

      const profile = profileMap.get(playerId);

      profile.names.add(playerName);

      if (team) {
        profile.teams.add(team);
      }

      profile.rows++;
    }


    // ------------------------------------------------------------------------
    // CSV / consumer text safety
    // ------------------------------------------------------------------------

    row.forEach(function(value, columnIndex) {

      if (
        hasUnsafeControlChars_(value) ||
        hasSpreadsheetFormulaPrefix_(value)
      ) {

        if (unsafeTextViolations.length < 20) {
          unsafeTextViolations.push({
            row: sheetRow,
            column: columnIndex + 1,
            header: actualHeaders[columnIndex],
            value: String(value)
          });
        }
      }
    });


    // ------------------------------------------------------------------------
    // Final actionability
    // ------------------------------------------------------------------------

    const actionable =
      bestSide === "Over" ||
      bestSide === "Under";

    if (actionable) {

      actionableRows++;

      if (
        playerId &&
        profileMap.has(playerId)
      ) {
        profileMap.get(playerId).actionableRows++;
      }

      const selectedOdds =
        bestSide === "Over"
          ? row[IDX.overOdds]
          : row[IDX.underOdds];

      const requiredAnalytics = {
        selectedOdds: selectedOdds,
        playerBaseline: row[IDX.playerBaseline],
        projectedStat: row[IDX.projectedStat],
        statStdDev: row[IDX.statStdDev],
        bestEV: row[IDX.bestEV],
        bestModelProbability:
          row[IDX.bestModelProbability],
        bestPriceEdge: row[IDX.bestPriceEdge],
        riskScore: row[IDX.riskScore],
        modelConfidence:
          row[IDX.modelConfidence],
        sportacularScore:
          row[IDX.sportacularScore],
        sportacularEdge:
          row[IDX.sportacularEdge]
      };

      const missingAnalytics = [];

      Object.keys(requiredAnalytics)
        .forEach(function(key) {
          if (!finite_(requiredAnalytics[key])) {
            missingAnalytics.push(key);
          }
        });

      if (!text_(row[IDX.riskTier])) {
        missingAnalytics.push("riskTier");
      }

      if (!confidenceTier) {
        missingAnalytics.push("confidenceTier");
      }

      if (missingAnalytics.length) {
        actionablePayloadViolations.push({
          row: sheetRow,
          providerId: providerId,
          playerId: playerId,
          playerName: playerName,
          bestSide: bestSide,
          missing: missingAnalytics
        });
      }

    } else if (bestSide === "No Play") {

      noPlayRows++;

      const incompleteModel =
        !finite_(row[IDX.projectedStat]) ||
        !finite_(row[IDX.modelProbOver]) ||
        !finite_(row[IDX.modelProbUnder]) ||
        !finite_(row[IDX.sportacularScore]);

      if (incompleteModel) {
        partialNoPlayRows++;
      }

      if (
        confidenceTier &&
        confidenceTier !== "No Play"
      ) {
        noPlaySafetyViolations.push({
          row: sheetRow,
          providerId: providerId,
          playerName: playerName,
          bestSide: bestSide,
          confidenceTier: confidenceTier
        });
      }

    } else {

      noPlaySafetyViolations.push({
        row: sheetRow,
        providerId: providerId,
        playerName: playerName,
        bestSide: bestSide,
        confidenceTier: confidenceTier,
        reason: "Unexpected Best Side vocabulary"
      });
    }
  });


  addResult_(
    "Every exported MLB row exposes complete website routing identity",
    identityViolations.length === 0,
    {
      violations: identityViolations.length,
      samples: identityViolations.slice(0, 10)
    }
  );

  addResult_(
    "Every exported MLB row exposes complete market identity",
    marketViolations.length === 0,
    {
      violations: marketViolations.length,
      samples: marketViolations.slice(0, 10)
    }
  );

  addResult_(
    "MLB provider Id remains unique for website row identity",
    duplicateProviderIds.length === 0,
    {
      uniqueProviderIds: providerIds.size,
      violations: duplicateProviderIds.length,
      samples: duplicateProviderIds
    }
  );

  addResult_(
    "Website-facing MLB values contain no unsafe control/formula-prefixed text",
    unsafeTextViolations.length === 0,
    {
      violations: unsafeTextViolations.length,
      samples: unsafeTextViolations.slice(0, 10)
    }
  );


  // --------------------------------------------------------------------------
  // 4. PROFILE ROUTING CONSISTENCY
  // --------------------------------------------------------------------------

  const profileViolations = [];
  const profileSamples = [];

  profileMap.forEach(function(profile, playerId) {

    if (
      profile.names.size !== 1 ||
      profile.teams.size !== 1
    ) {
      profileViolations.push({
        playerId: playerId,
        names: Array.from(profile.names),
        teams: Array.from(profile.teams),
        rows: profile.rows
      });
    }

    if (profileSamples.length < 10) {
      profileSamples.push({
        playerId: playerId,
        playerName:
          Array.from(profile.names)[0] || "",
        team:
          Array.from(profile.teams)[0] || "",
        rows: profile.rows,
        actionableRows:
          profile.actionableRows
      });
    }
  });

  addResult_(
    "MLB Player Id maps consistently to one frontend profile identity",
    profileViolations.length === 0,
    {
      uniqueProfilePlayers: profileMap.size,
      violations: profileViolations.length,
      samples: profileViolations.slice(0, 10)
    }
  );

  addResult_(
    "Live MLB export exposes player-profile consumer coverage",
    profileMap.size > 0,
    {
      uniqueProfilePlayers: profileMap.size,
      samplePlayers: profileSamples
    }
  );


  // --------------------------------------------------------------------------
  // 5. ACTIONABLE / NO-PLAY PAYLOAD
  // --------------------------------------------------------------------------

  addResult_(
    "Every actionable MLB website row exposes complete analytics payload",
    actionablePayloadViolations.length === 0,
    {
      actionableRows: actionableRows,
      violations:
        actionablePayloadViolations.length,
      samples:
        actionablePayloadViolations.slice(0, 10)
    }
  );

  addResult_(
    "MLB No Play rows remain safely represented for website consumers",
    noPlaySafetyViolations.length === 0,
    {
      noPlayRows: noPlayRows,
      partialNoPlayRows: partialNoPlayRows,
      violations: noPlaySafetyViolations.length,
      samples: noPlaySafetyViolations.slice(0, 10)
    }
  );


  // --------------------------------------------------------------------------
  // FINAL SUMMARY
  // --------------------------------------------------------------------------

  const failed =
    results.filter(function(result) {
      return !result.pass;
    }).length;

  const summary = {
    test: TEST_NAME,
    tests: results.length,
    passed: results.length - failed,
    failed: failed,
    pass: failed === 0,

    productionRows: rows.length,
    uniqueProviderIds: providerIds.size,
    uniqueProfilePlayers: profileMap.size,
    actionableRows: actionableRows,
    noPlayRows: noPlayRows,
    partialNoPlayRows: partialNoPlayRows,

    results: results
  };

  Logger.log(
    JSON.stringify(
      summary,
      null,
      2
    )
  );

  if (failed > 0) {
    throw new Error(
      "D10AQ MLB website export / frontend payload readiness audit failed."
    );
  }

  return summary;
}

/**
 * ============================================================
 * D10AR — MLB FRONTEND PLAYER PROPS CONSUMER CONTRACT AUDIT
 * ============================================================
 *
 * READ-ONLY.
 *
 * Verifies that the frozen universal A:AJ production output
 * exposes exactly the fields required by the website-side
