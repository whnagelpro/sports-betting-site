/**
 * ============================================================================
 * D10AM-F4 — MLB DIRECT PLAYER IDENTITY FALLBACK
 * ============================================================================
 *
 * Resolves a BALldontlie MLB player directly by Player ID when that player is
 * absent from the normal Rosters-based identity index.
 *
 * This does NOT replace Rosters as the primary identity source.
 * It is a narrow fallback for provider Player IDs missing from Rosters.
 *
 * Returns:
 *   {
 *     playerName: string|null,
 *     team: string|null
 *   }
 * ============================================================================
 */
function fetchMLBPlayerIdentityById_(playerId) {

  const normalizedPlayerId =
    String(
      playerId ?? ""
    ).trim();


  if (!normalizedPlayerId) {
    return {
      playerName: null,
      team: null
    };
  }


  try {

    const response =
      fetchApi_(
        "/mlb/v1/players/" +
        encodeURIComponent(
          normalizedPlayerId
        )
      );


    const player =
      response &&
      response.data
        ? response.data
        : null;


    if (!player) {
      return {
        playerName: null,
        team: null
      };
    }


    const firstName =
      String(
        player.first_name ?? ""
      ).trim();


    const lastName =
      String(
        player.last_name ?? ""
      ).trim();


    const fullName =
      String(
        player.full_name ?? ""
      ).trim() ||
      [
        firstName,
        lastName
      ]
        .filter(Boolean)
        .join(" ")
        .trim();


    const team =
      player.team &&
      typeof player.team === "object"
        ? String(
            player.team.abbreviation ??
            ""
          ).trim()
        : "";


    return {
      playerName:
        fullName || null,

      team:
        team || null
    };


  } catch (error) {

    Logger.log(
      `MLB identity fallback failed for Player ID ${normalizedPlayerId}: ${
        error &&
        error.message
          ? error.message
          : error
      }`
    );


    return {
      playerName: null,
      team: null
    };
  }
}

