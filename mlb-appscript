/**
 * ============================================================================
 * P13 D5 — MLB UNIVERSAL A:AJ PLAYER PROP ROW ASSEMBLER
 * ============================================================================
 *
 * Combines:
 *   A:N   Provider/raw prop data
 *   O:P   Player identity
 *   Q:T   Historical/projection context
 *   U:X   Probability + EV
 *   Y:AG  Decision/trend/risk/confidence
 *   AH:AJ Deferred to P15
 * ============================================================================
 */


function buildMLBPlayerIdentityIndex_() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName("Rosters");

  if (!sheet) {
    throw new Error(
      'Sheet "Rosters" not found.'
    );
  }


  const values =
    sheet.getDataRange().getValues();

  if (values.length < 2) {
    return {};
  }


  const headers =
    values[0];


  const idIndex =
    headers.indexOf("Id");

  const fullNameIndex =
    headers.indexOf("Full Name");

  const teamAbbreviationIndex =
    headers.indexOf("Team Abbreviation");


  if (idIndex === -1) {
    throw new Error(
      'Column "Id" not found in Rosters.'
    );
  }


  if (fullNameIndex === -1) {
    throw new Error(
      'Column "Full Name" not found in Rosters.'
    );
  }


  if (teamAbbreviationIndex === -1) {
    throw new Error(
      'Column "Team Abbreviation" not found in Rosters.'
    );
  }


  const index = {};


  for (
    let rowIndex = 1;
    rowIndex < values.length;
    rowIndex++
  ) {
    const row =
      values[rowIndex];


    const playerId =
      String(
        row[idIndex] ?? ""
      ).trim();


    if (!playerId) {
      continue;
    }


    const playerName =
      String(
        row[fullNameIndex] ?? ""
      ).trim();


    const team =
      String(
        row[teamAbbreviationIndex] ?? ""
      ).trim();


    index[playerId] = {
      playerName:
        playerName || null,

      team:
        team || null
    };
  }


  return index;
}

/**
