    "Under Odds",
    "Player Name",
    "Team",
    "Player Baseline",
    "Trend Adjustment",
    "Projected Stat",
    "Stat Std Dev",
    "Model Prob Over",
    "Model Prob Under",
    "EV Over",
    "EV Under",
    "Best Side",
    "Best EV",
    "Best Model Probability",
    "Best Price Edge",
    "Trend Score",
    "Trend Strength",
    "Risk Score",
    "Risk Tier",
    "Model Confidence",
    "Sportacular Score",
    "Sportacular Edge",
    "Confidence Tier"
  ];

  const FRONTEND_REQUIRED_HEADERS = [
    "Game Id",
    "Game Date",
    "Away Team",
    "Home Team",
    "Player Id",
    "Vendor",
    "Prop Type",
    "Line Value",
    "Odds",
    "Over Odds",
    "Under Odds",
    "Player Name",
    "Model Prob Over",
    "Model Prob Under",
    "EV Over",
    "EV Under",
    "Best Side",
    "Best EV",
    "Best Model Probability",
    "Best Price Edge",
    "Trend Score",
    "Trend Strength",
    "Risk Score",
    "Risk Tier",
    "Model Confidence",
    "Sportacular Score",
    "Sportacular Edge",
    "Confidence Tier"
  ];

  const lastRow = sheet.getLastRow();
  const lastColumn = sheet.getLastColumn();

  const headers =
    lastColumn > 0
      ? sheet
          .getRange(1, 1, 1, Math.min(lastColumn, 36))
          .getDisplayValues()[0]
          .map(v => String(v || "").trim())
      : [];

  const rows =
    lastRow > 1
      ? sheet
          .getRange(2, 1, lastRow - 1, 36)
          .getValues()
      : [];

  const headerIndex = {};

  headers.forEach((header, index) => {
    headerIndex[header] = index;
  });

  const results = [];

  function record(name, pass, details) {
    const result = Object.assign(
      {
        name: name,
        pass: !!pass
      },
      details || {}
    );

    results.push(result);

    Logger.log(JSON.stringify(result));
  }

  function text(row, header) {
    const index = headerIndex[header];

    if (index === undefined) {
      return "";
    }

    const value = row[index];

    if (value === null || value === undefined) {
      return "";
    }

    return String(value).trim();
  }

  function numberOrNull(row, header) {
    const raw = text(row, header);

    if (raw === "") {
      return null;
    }

    const value = Number(raw);

    return Number.isFinite(value)
      ? value
      : null;
  }

  // ----------------------------------------------------------
  // 1. Frozen width
  // ----------------------------------------------------------

  record(
    "D10AR universal MLB contract remains exactly 36 columns",
    EXPECTED_HEADERS.length === 36,
    {
      actual: EXPECTED_HEADERS.length,
      expected: 36
    }
  );

  // ----------------------------------------------------------
  // 2. Production rows exist
  // ----------------------------------------------------------

  record(
    "Live MLB Player Props contains production rows for frontend consumer audit",
    rows.length > 0,
    {
      productionRows: rows.length
    }
  );

  // ----------------------------------------------------------
  // 3. Exact frozen headers
  // ----------------------------------------------------------

  const headerMismatches = [];

  EXPECTED_HEADERS.forEach((expected, index) => {
    const actual = headers[index] || "";

    if (actual !== expected) {
      headerMismatches.push({
        column: index + 1,
        expected: expected,
        actual: actual
      });
    }
  });

  record(
    "Live MLB A:AJ headers remain exact frozen universal contract",
    headerMismatches.length === 0,
    {
      mismatchCount: headerMismatches.length,
      samples: headerMismatches.slice(0, 10)
    }
  );

  // ----------------------------------------------------------
  // 4. Every field consumed by script.js exists
  // ----------------------------------------------------------

  const missingFrontendHeaders =
    FRONTEND_REQUIRED_HEADERS.filter(
      header => headerIndex[header] === undefined
    );

  record(
    "Frozen MLB output exposes every field consumed by frontend buildPropsFromRows",
    missingFrontendHeaders.length === 0,
    {
      requiredHeaders: FRONTEND_REQUIRED_HEADERS.length,
      missingHeaders: missingFrontendHeaders
    }
  );

  // ----------------------------------------------------------
  // 5. Routing identity
  // ----------------------------------------------------------

  const routingViolations = [];

  rows.forEach((row, index) => {
    const playerId = text(row, "Player Id");
    const playerName = text(row, "Player Name");

    if (!playerId || !playerName) {
      routingViolations.push({
        row: index + 2,
        playerId: playerId,
        playerName: playerName
      });
    }
  });

  record(
    "Every MLB frontend row exposes player-profile routing identity",
    routingViolations.length === 0,
    {
      violations: routingViolations.length,
      samples: routingViolations.slice(0, 10)
    }
  );

  // ----------------------------------------------------------
  // 6. Market identity required by buildPropsFromRows()
  // ----------------------------------------------------------

  const marketViolations = [];

  rows.forEach((row, index) => {
    const gameDate = text(row, "Game Date");
    const vendor = text(row, "Vendor");
    const propType = text(row, "Prop Type");
    const lineValue = text(row, "Line Value");

    if (
      !gameDate ||
      !vendor ||
      !propType ||
      lineValue === ""
    ) {
      marketViolations.push({
        row: index + 2,
        gameDate: gameDate,
        vendor: vendor,
        propType: propType,
        lineValue: lineValue
      });
    }
  });

  record(
    "Every MLB row exposes frontend market identity",
    marketViolations.length === 0,
    {
      violations: marketViolations.length,
      samples: marketViolations.slice(0, 10)
    }
  );

  // ----------------------------------------------------------
  // 7. Best Side vocabulary
  // ----------------------------------------------------------

  const sideViolations = [];

  let overRows = 0;
  let underRows = 0;
  let noPlayRows = 0;

  rows.forEach((row, index) => {
    const bestSide = text(row, "Best Side");

    if (bestSide === "Over") {
      overRows++;
      return;
    }

    if (bestSide === "Under") {
      underRows++;
      return;
    }

    if (
      bestSide === "" ||
      bestSide === "No Play"
    ) {
      noPlayRows++;
      return;
    }

    sideViolations.push({
      row: index + 2,
      playerId: text(row, "Player Id"),
      playerName: text(row, "Player Name"),
      bestSide: bestSide
    });
  });

  record(
    "MLB Best Side values are safe for frontend actionability routing",
    sideViolations.length === 0,
    {
      overRows: overRows,
      underRows: underRows,
      noPlayRows: noPlayRows,
      violations: sideViolations.length,
      samples: sideViolations.slice(0, 10)
    }
  );

  // ----------------------------------------------------------
  // 8. Actionable rows have selected probability + EV + odds
  // ----------------------------------------------------------

  const actionableViolations = [];
  let actionableRows = 0;

  rows.forEach((row, index) => {
    const bestSide = text(row, "Best Side");

    if (
      bestSide !== "Over" &&
      bestSide !== "Under"
    ) {
      return;
    }

    actionableRows++;

    const probability =
      bestSide === "Over"
        ? numberOrNull(row, "Model Prob Over")
        : numberOrNull(row, "Model Prob Under");

    const ev =
      bestSide === "Over"
        ? numberOrNull(row, "EV Over")
        : numberOrNull(row, "EV Under");

    const odds =
      bestSide === "Over"
        ? text(row, "Over Odds")
        : text(row, "Under Odds");

    if (
      probability === null ||
      ev === null ||
      odds === ""
    ) {
      actionableViolations.push({
        row: index + 2,
        playerId: text(row, "Player Id"),
        playerName: text(row, "Player Name"),
        bestSide: bestSide,
        probability: probability,
        ev: ev,
        odds: odds
      });
    }
  });

  record(
    "Every actionable MLB row can be materialized by frontend buildPropsFromRows",
    actionableViolations.length === 0,
    {
      actionableRows: actionableRows,
      violations: actionableViolations.length,
      samples: actionableViolations.slice(0, 10)
    }
  );

  // ----------------------------------------------------------
  // 9. Best EV parity with selected EV
  // ----------------------------------------------------------

  const bestEVViolations = [];

  rows.forEach((row, index) => {
    const bestSide = text(row, "Best Side");

    if (
      bestSide !== "Over" &&
      bestSide !== "Under"
    ) {
      return;
    }

    const selectedEV =
      bestSide === "Over"
        ? numberOrNull(row, "EV Over")
        : numberOrNull(row, "EV Under");

    const bestEV =
      numberOrNull(row, "Best EV");

    if (
      selectedEV === null ||
      bestEV === null ||
      Math.abs(selectedEV - bestEV) > 1e-9
    ) {
      bestEVViolations.push({
        row: index + 2,
        playerId: text(row, "Player Id"),
        playerName: text(row, "Player Name"),
        bestSide: bestSide,
        selectedEV: selectedEV,
        bestEV: bestEV
      });
    }
  });

  record(
    "Frontend MLB Best EV agrees with selected side EV",
    bestEVViolations.length === 0,
    {
      actionableRows: actionableRows,
      violations: bestEVViolations.length,
      samples: bestEVViolations.slice(0, 10)
    }
  );

  // ----------------------------------------------------------
  // 10. Best Model Probability parity
  // ----------------------------------------------------------

  const probabilityViolations = [];

  rows.forEach((row, index) => {
    const bestSide = text(row, "Best Side");

    if (
      bestSide !== "Over" &&
      bestSide !== "Under"
    ) {
      return;
    }

    const selectedProbability =
      bestSide === "Over"
        ? numberOrNull(row, "Model Prob Over")
        : numberOrNull(row, "Model Prob Under");

    const bestProbability =
      numberOrNull(row, "Best Model Probability");

    if (
      selectedProbability === null ||
      bestProbability === null ||
      Math.abs(
        selectedProbability -
        bestProbability
      ) > 1e-9
    ) {
      probabilityViolations.push({
        row: index + 2,
        playerId: text(row, "Player Id"),
        playerName: text(row, "Player Name"),
        bestSide: bestSide,
        selectedProbability: selectedProbability,
        bestModelProbability: bestProbability
      });
    }
  });

  record(
    "Frontend MLB Best Model Probability agrees with selected side probability",
    probabilityViolations.length === 0,
    {
      actionableRows: actionableRows,
      violations: probabilityViolations.length,
      samples: probabilityViolations.slice(0, 10)
    }
  );

  // ----------------------------------------------------------
  // 11. Final model payload survives into frontend contract
  // ----------------------------------------------------------

  const scoringViolations = [];

  rows.forEach((row, index) => {
    const bestSide = text(row, "Best Side");

    if (
      bestSide !== "Over" &&
      bestSide !== "Under"
    ) {
      return;
    }

    const requiredNumeric = [
      "Best EV",
      "Best Model Probability",
      "Best Price Edge",
      "Model Confidence",
      "Sportacular Score",
      "Sportacular Edge"
    ];

    const missingNumeric =
      requiredNumeric.filter(
        header =>
          numberOrNull(row, header) === null
      );

    const confidenceTier =
      text(row, "Confidence Tier");

    if (
      missingNumeric.length > 0 ||
      !confidenceTier
    ) {
      scoringViolations.push({
        row: index + 2,
        playerId: text(row, "Player Id"),
        playerName: text(row, "Player Name"),
        bestSide: bestSide,
        missingNumeric: missingNumeric,
        confidenceTier: confidenceTier
      });
    }
  });

  record(
    "Every actionable MLB frontend row retains final Sportacular scoring payload",
    scoringViolations.length === 0,
    {
      actionableRows: actionableRows,
      violations: scoringViolations.length,
      samples: scoringViolations.slice(0, 10)
    }
  );

  // ----------------------------------------------------------
  // 12. Player-profile URL identity is stable
  // ----------------------------------------------------------

  const playerIdToName = {};
  const identityViolations = [];

  rows.forEach((row, index) => {
    const playerId = text(row, "Player Id");
    const playerName = text(row, "Player Name");

    if (!playerId || !playerName) {
      return;
    }

    if (
      playerIdToName[playerId] &&
      playerIdToName[playerId] !== playerName
    ) {
      identityViolations.push({
        row: index + 2,
        playerId: playerId,
        expectedPlayerName:
          playerIdToName[playerId],
        actualPlayerName:
          playerName
      });

      return;
    }

    playerIdToName[playerId] = playerName;
  });

  record(
    "MLB frontend Player Id remains stable for player.html routing",
    identityViolations.length === 0,
    {
      uniqueProfilePlayers:
        Object.keys(playerIdToName).length,
      violations: identityViolations.length,
      samples: identityViolations.slice(0, 10)
    }
  );

  // ----------------------------------------------------------
  // Summary
  // ----------------------------------------------------------

  const failed =
    results.filter(result => !result.pass).length;

  const summary = {
    test:
      "D10AR MLB FRONTEND PLAYER PROPS CONSUMER CONTRACT AUDIT",

    tests:
      results.length,

    passed:
      results.length - failed,

    failed:
      failed,

    pass:
      failed === 0,

    productionRows:
      rows.length,

    actionableRows:
      actionableRows,

    overRows:
      overRows,

    underRows:
      underRows,

    noPlayRows:
      noPlayRows,

    uniqueProfilePlayers:
      Object.keys(playerIdToName).length,

    results:
      results
  };

  Logger.log(
    JSON.stringify(
      summary,
      null,
      2
    )
  );

  if (failed > 0) {
    throw new Error(
      "D10AR MLB frontend Player Props consumer contract audit failed."
    );
  }

  return summary;
}

