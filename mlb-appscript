function backtestMLBPitcherLambdaWeights() {

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const logsSheet =
    ss.getSheetByName("MLB Player Game Logs");

  if (!logsSheet) {
    throw new Error(
      'Sheet "MLB Player Game Logs" not found.'
    );
  }

  const values =
    logsSheet.getDataRange().getValues();

  if (values.length < 12) {
    throw new Error(
      "Not enough MLB Player Game Logs to run pitcher Lambda backtest."
    );
  }

  const header = values[0];

  const playerIdCol =
    header.indexOf("Player ID");

  const gameDateCol =
    header.indexOf("Game Date");

  const markets = [
    {
      name: "Pitcher Strikeouts",
      column: "Pitcher Strikeouts"
    },
    {
      name: "Pitcher Outs",
      column: "Pitcher Outs"
    },
    {
      name: "Pitcher Earned Runs",
      column: "Pitcher Earned Runs"
    },
    {
      name: "Pitcher Hits Allowed",
      column: "Pitcher Hits Allowed"
    },
    {
      name: "Pitcher Walks",
      column: "Pitcher Walks"
    }
  ];

  if (
    playerIdCol === -1 ||
    gameDateCol === -1
  ) {
    throw new Error(
      "Required Player ID or Game Date column not found."
    );
  }

  markets.forEach(market => {

    market.columnIndex =
      header.indexOf(market.column);

    if (market.columnIndex === -1) {
      throw new Error(
        `Required column "${market.column}" not found.`
      );
    }

  });

  const playerGames = {};

  for (let i = 1; i < values.length; i++) {

    const row = values[i];

    const playerId =
      String(row[playerIdCol] || "");

    if (!playerId) continue;

    /*
     * A positive Pitcher Outs value identifies
     * an actual pitching appearance and prevents
     * hitter rows from entering this backtest.
     */
    const pitcherOutsCol =
      header.indexOf("Pitcher Outs");

    const pitcherOuts =
      Number(row[pitcherOutsCol]);

    if (
      !Number.isFinite(pitcherOuts) ||
      pitcherOuts <= 0
    ) {
      continue;
    }

    if (!playerGames[playerId]) {
      playerGames[playerId] = [];
    }

    playerGames[playerId].push(row);
  }

  Object.values(playerGames)
    .forEach(games => {

      games.sort((a, b) => {
        return (
          new Date(a[gameDateCol]) -
          new Date(b[gameDateCol])
        );
      });

    });

  const weightCandidates = [];

  /*
   * Test season-only through Last-10-only
   * in 5 percentage-point increments.
   */
  for (
    let recentPercent = 0;
    recentPercent <= 100;
    recentPercent += 5
  ) {

    weightCandidates.push({
      season:
        (100 - recentPercent) / 100,

      recent:
        recentPercent / 100,

      label:
        `${100 - recentPercent}/${recentPercent}`
    });

  }

  const output = [];

  markets.forEach(market => {

    const marketResults = [];

    weightCandidates.forEach(weights => {

      let absoluteError = 0;
      let squaredError = 0;
      let predictions = 0;

      Object.values(playerGames)
        .forEach(games => {

          /*
           * Require 11 prior pitching appearances
           * so every prediction has a complete
           * previous Last-10 sample.
           */
          for (
            let targetIndex = 11;
            targetIndex < games.length;
            targetIndex++
          ) {

            const previousGames =
              games.slice(0, targetIndex);

            const recentGames =
              previousGames.slice(-10);

            const actual =
              Number(
                games[targetIndex][
                  market.columnIndex
                ]
              );

            if (!Number.isFinite(actual)) {
              continue;
            }

            const seasonValues =
              previousGames
                .map(row =>
                  Number(
                    row[market.columnIndex]
                  )
                )
                .filter(Number.isFinite);

            const recentValues =
              recentGames
                .map(row =>
                  Number(
                    row[market.columnIndex]
                  )
                )
                .filter(Number.isFinite);

            if (
              !seasonValues.length ||
              !recentValues.length
            ) {
              continue;
            }

            const seasonAvg =
              seasonValues.reduce(
                (sum, value) =>
                  sum + value,
                0
              ) /
              seasonValues.length;

            const recentAvg =
              recentValues.reduce(
                (sum, value) =>
                  sum + value,
                0
              ) /
              recentValues.length;

            const prediction =
              (seasonAvg * weights.season) +
              (recentAvg * weights.recent);

            const error =
              prediction - actual;

            absoluteError +=
              Math.abs(error);

            squaredError +=
              error * error;

            predictions++;

          }

        });

      const mae =
        predictions
          ? absoluteError / predictions
          : null;

      const rmse =
        predictions
          ? Math.sqrt(
              squaredError / predictions
            )
          : null;

      marketResults.push({
        market: market.name,
        weights: weights.label,
        seasonWeight: weights.season,
        recentWeight: weights.recent,
        predictions,
        mae,
        rmse
      });

    });

    const validResults =
      marketResults.filter(result =>
        result.mae !== null &&
        result.rmse !== null
      );

    if (!validResults.length) {
      return;
    }

    const baseline =
      validResults.find(result =>
        result.weights === "100/0"
      );

    const bestMAE =
      validResults.reduce(
