function writeMLBOutputSheet_(sheet, headers, rows) {
  sheet.clearContents();

  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);

  if (rows.length > 0) {
    sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
  }

  sheet.autoResizeColumns(1, headers.length);
}

function getMLBObjectsFromSheet_(sheet) {
  const values = sheet.getDataRange().getValues();

  if (values.length < 2) return [];

  const headers = values[0];

  return values.slice(1).map(row => {
    const obj = {};

    headers.forEach((header, index) => {
      obj[header] = row[index];
    });

    return obj;
  });
}

function avgMLB_(values) {
  const nums = values
    .map(Number)
    .filter(value => !Number.isNaN(value));

  if (!nums.length) return 0;

  return nums.reduce((sum, value) => sum + value, 0) / nums.length;
}

function stdDevMLB_(values) {
  const nums = values
    .map(Number)
    .filter(value => !Number.isNaN(value));

  if (nums.length < 2) return 0;

  const mean = avgMLB_(nums);
  const variance = avgMLB_(nums.map(value => Math.pow(value - mean, 2)));

  return Math.sqrt(variance);
}

function consistencyScoreMLB_(values) {
  const mean = avgMLB_(values);

  if (!mean) return 0;

  const cv = stdDevMLB_(values) / mean;

  return Math.max(0, Math.min(100, 100 - cv * 100));
}

function trendScoreMLB_(recentAvg, seasonAvg) {
  if (!seasonAvg) return 0;

  return ((recentAvg - seasonAvg) / seasonAvg) * 100;
}

function trendDirectionMLB_(score) {
  if (score >= 7.5) return "Up";
  if (score <= -7.5) return "Down";

  return "Flat";
}

function riskTierMLB_(consistency, absTrendScore) {
  if (consistency >= 75 && absTrendScore <= 20) return "Low";
  if (consistency >= 55) return "Medium";

  return "High";
}

function normalizedTrendScoreMLB_(trendScore) {
  const score = Number(trendScore || 0);

  // Cap raw trend movement at +/- 50%
  // -50 = 0
  //   0 = 50
  // +50 = 100
  const capped = Math.max(-50, Math.min(50, score));

  return Math.max(
    0,
    Math.min(
      100,
      capped + 50
    )
  );
}


function trendStrengthScoreMLB_(strength) {
  const value = String(strength || "")
    .trim()
    .toLowerCase();

  if (value.includes("elite")) return 100;
  if (value.includes("strong")) return 80;
  if (value.includes("moderate")) return 60;
  if (value.includes("weak")) return 35;
  if (value.includes("cold")) return 15;

  return 0;
}


function riskScoreMLB_(riskTier) {
  const value = String(riskTier || "")
    .trim()
    .toLowerCase();

  if (value === "low") return 100;
  if (value === "medium") return 70;
  if (value === "high") return 35;

  return 50;
}


function sportacularScoreMLB_({
  normalizedTrendScore,
  consistency,
  hitRateLast5,
  hitRateLast10
}) {

  const trend = Math.max(
    0,
    Math.min(100, Number(normalizedTrendScore || 0))
  );

  const consistencyScore = Math.max(
    0,
    Math.min(100, Number(consistency || 0))
  );

  const hit5 = Math.max(
    0,
    Math.min(100, Number(hitRateLast5 || 0) * 100)
  );

  const hit10 = Math.max(
    0,
    Math.min(100, Number(hitRateLast10 || 0) * 100)
  );

  const score =
    trend * 0.30 +
    consistencyScore * 0.30 +
    hit5 * 0.20 +
    hit10 * 0.20;

  return Math.round(
    Math.max(0, Math.min(100, score)) * 10
  ) / 10;
}

function getMLBOpponentFromStat_(stat) {
  const game = stat.game || {};
  const team = stat.team || {};

  const teamId = String(team.id || "");
  const homeTeamId = String((game.home_team && game.home_team.id) || "");
  const awayTeamId = String(
    (game.away_team && game.away_team.id) ||
    (game.visitor_team && game.visitor_team.id) ||
    ""
  );

  if (teamId && teamId === homeTeamId) {
    return getMLBTeamName_(game.away_team || game.visitor_team || {});
  }

  if (teamId && teamId === awayTeamId) {
    return getMLBTeamName_(game.home_team || {});
  }

  return "";
}

function refreshMLBPlayerPropsSheet() {
  const sheetName = "Player Props";
  const scheduleSheetName = "Schedule";

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);
  const scheduleSheet = ss.getSheetByName(scheduleSheetName);

  const trendsSheet =
    ss.getSheetByName("MLB Player Trends");

  if (!trendsSheet) {
    throw new Error('Sheet "MLB Player Trends" not found.');
  }

  if (!sheet) {
    throw new Error(`Sheet "${sheetName}" not found.`);
  }

  if (!scheduleSheet) {
    throw new Error(`Sheet "${scheduleSheetName}" not found.`);
  }

  ensurePropFormulaTemplates_(sheet);
  ensureNameFormulaTemplates_(sheet);

  const trendValues =
    trendsSheet.getDataRange().getValues();

  const trendHeader =
    trendValues[0];

  const trendMap = {};

  const playerIdCol =
    trendHeader.indexOf("Player ID");

  const statTypeCol =
    trendHeader.indexOf("Stat Type");

  const trendScoreCol =
    trendHeader.indexOf("Normalized Trend Score");

  const trendStrengthCol =
    trendHeader.indexOf("Trend Strength Score");

  const riskScoreCol =
    trendHeader.indexOf("Risk Score");

  const sportacularScoreCol =
    trendHeader.indexOf("Sportacular Score");

  for (let i = 1; i < trendValues.length; i++) {

    const row = trendValues[i];

    const key =
      row[playerIdCol] +
      "|" +
      normalizeMLBStatType_(row[statTypeCol]);

    trendMap[key] = {

      trendScore:
        Number(row[trendScoreCol]) || 0,

      trendStrength:
        Number(row[trendStrengthCol]) || 0,

      riskScore:
        Number(row[riskScoreCol]) || 0,

      sportacularScore:
        Number(row[sportacularScoreCol]) || 0

    };

  }

  Logger.log("Refreshing MLB player props using Schedule tab game IDs...");

  const games = getGamesFromScheduleSheet_(scheduleSheet);

  if (!games.length) {
    clearPlayerPropsData_(sheet);
    Logger.log("No schedule rows found, so Player Props was cleared.");
    return;
  }

  const gameMap = {};
  games.forEach(game => {
    gameMap[String(game.id)] = {
      game_date: game.game_date || "",
      away_team: game.away_team || "",
      home_team: game.home_team || ""
    };
  });

  let allRows = [];

  games.forEach((game, index) => {
    Logger.log(`Fetching props for game ${index + 1}/${games.length} (ID: ${game.id})`);

    const props = fetchAllMLBPlayerPropsForGame_(game.id);
    const gameInfo = gameMap[String(game.id)] || {};

    props.forEach(prop => {
      const playerId =
        prop.player_id ||
        (prop.player && prop.player.id) ||
        "";

      const vendor =
        prop.vendor ||
        prop.sportsbook ||
        prop.bookmaker ||
        "";

      const propType =
        prop.prop_type ||
        prop.market ||
        "";

      const trendKey =
        playerId +
        "|" +
        normalizeMLBStatType_(propType);

      const trend =
        trendMap[trendKey] || null;

      const trendScore =
        trend ? trend.trendScore : "";

      const trendStrength =
        trend ? trend.trendStrength : "";

      const riskScore =
        trend ? trend.riskScore : "";

      const sportacularScore =
        trend ? trend.sportacularScore : "";

      const lineValue =
        prop.line ||
        prop.line_value ||
        "";

      const typeValue =
        (prop.market && prop.market.type) ||
        "";

      const odds =
        (prop.market && prop.market.odds) ||
        "";

      const updatedAt =
        prop.updated_at ||
        "";

      const overOdds =
        (prop.market && prop.market.over_odds) ||
        "";

      const underOdds =
        (prop.market && prop.market.under_odds) ||
        "";

      allRows.push([
      game.id,
      gameInfo.game_date,
      gameInfo.away_team,
      gameInfo.home_team,
      prop.id || "",
      playerId,
      vendor,
      propType,
      lineValue,
      typeValue,
      odds,
      updatedAt,
      overOdds,
      underOdds,

      "",     // O Decimal Odds
      "",     // P Implied Probability
      "",     // Q Vig-Free Probability
      "",     // R Lambda
      "",     // S Poisson Over
      "",     // T Poisson Milestone
      "",     // U EV

      "",     // V First Name
      "",     // W Last Name

      trendScore,
      trendStrength,
      riskScore,
      sportacularScore,

      "",
      ""
      ]);
    });

    Utilities.sleep(200);
  });

  clearPlayerPropsData_(sheet);

  if (!allRows.length) {
    Logger.log("No MLB player props were returned for the schedule slate.");
    return;
  }

  sheet.getRange(3, 1, allRows.length, 29).setValues(allRows);

  copyFormulaTemplatesDown_(sheet, allRows.length);

  sheet.getRange(3, 24, allRows.length, 4).setNumberFormat("0.0");

  Logger.log(`Wrote ${allRows.length} MLB player props rows to "${sheetName}"`);
}

