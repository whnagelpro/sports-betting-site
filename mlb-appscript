  function approximatelyEqual_(a, b, tolerance) {

    if (
      !Number.isFinite(a) ||
      !Number.isFinite(b)
    ) {
      return false;
    }

    return (
      Math.abs(a - b) <=
      (tolerance || 1e-9)
    );
