  const playerGames = {};

  for (let i = 1; i < values.length; i++) {

    const row = values[i];

    const playerId =
      String(row[playerIdCol] || "");

    if (!playerId) continue;

    const pitcherOuts =
      Number(row[pitcherOutsCol]);

    if (
      !Number.isFinite(pitcherOuts) ||
      pitcherOuts <= 0
    ) {
      continue;
    }

    if (!playerGames[playerId]) {
      playerGames[playerId] = [];
    }

    playerGames[playerId].push(row);
  }

  Object.values(playerGames)
    .forEach(games => {

      games.sort((a, b) => {
        return (
          new Date(a[gameDateCol]) -
          new Date(b[gameDateCol])
        );
      });

    });

  const output = [];

  marketConfigs.forEach(config => {

    const results =
      config.candidates.map(candidate => {

        let absoluteError = 0;
        let squaredError = 0;
        let predictions = 0;

        Object.values(playerGames)
          .forEach(games => {

            /*
             * Earlier 75% establishes the initial
             * training history.
             *
             * Only the later 25% is scored.
             */
            const holdoutStart =
              Math.floor(
                games.length * 0.75
              );

            if (holdoutStart < 11) {
              return;
            }

            for (
              let targetIndex = holdoutStart;
              targetIndex < games.length;
              targetIndex++
            ) {

              const previousGames =
                games.slice(
                  0,
                  targetIndex
                );

              const recentGames =
                previousGames.slice(-10);

              if (
                previousGames.length < 11 ||
                recentGames.length < 10
              ) {
                continue;
              }

              const actualRaw =
                games[targetIndex][
                  config.column
                ];

              if (
                actualRaw === "" ||
                actualRaw === null ||
                actualRaw === undefined
              ) {
                continue;
              }

              const actual =
                Number(actualRaw);

              if (!Number.isFinite(actual)) {
                continue;
              }

              const seasonValues =
                previousGames
                  .map(row => {

                    const raw =
                      row[config.column];

                    if (
                      raw === "" ||
                      raw === null ||
                      raw === undefined
                    ) {
                      return null;
                    }

                    const value =
                      Number(raw);

                    return Number.isFinite(value)
                      ? value
                      : null;
                  })
                  .filter(Number.isFinite);

              const recentValues =
                recentGames
                  .map(row => {

                    const raw =
                      row[config.column];

                    if (
                      raw === "" ||
                      raw === null ||
                      raw === undefined
                    ) {
                      return null;
                    }

                    const value =
                      Number(raw);

                    return Number.isFinite(value)
                      ? value
                      : null;
                  })
                  .filter(Number.isFinite);

              if (
                !seasonValues.length ||
                !recentValues.length
              ) {
                continue;
              }

              const seasonAverage =
                seasonValues.reduce(
                  (sum, value) =>
                    sum + value,
                  0
                ) /
                seasonValues.length;

              const recentAverage =
                recentValues.reduce(
                  (sum, value) =>
                    sum + value,
                  0
                ) /
                recentValues.length;

              const prediction =
                (
                  seasonAverage *
                  candidate.season
                ) +
                (
                  recentAverage *
                  candidate.recent
                );

              const error =
                prediction - actual;

              absoluteError +=
                Math.abs(error);

              squaredError +=
                error * error;

              predictions++;

            }

          });

        return {
          label: candidate.label,
          season: candidate.season,
          recent: candidate.recent,
          predictions,
          mae:
            predictions
              ? absoluteError / predictions
              : null,
          rmse:
            predictions
              ? Math.sqrt(
                  squaredError / predictions
                )
              : null
        };

      });

    const baseline =
      results.find(result =>
        result.label === "100/0"
      );

    const validResults =
      results.filter(result =>
        result.mae !== null &&
        result.rmse !== null
      );

    if (!validResults.length) {
      return;
    }

    const bestMAE =
      validResults.reduce(
        (best, current) =>
          current.mae < best.mae
            ? current
            : best
      );

    const bestRMSE =
      validResults.reduce(
        (best, current) =>
          current.rmse < best.rmse
            ? current
            : best
      );

    validResults.forEach(result => {

      const maeImprovement =
        baseline &&
        baseline.mae
          ? (
              (
                baseline.mae -
                result.mae
              ) /
              baseline.mae
            ) * 100
          : 0;

      const rmseImprovement =
        baseline &&
        baseline.rmse
          ? (
              (
                baseline.rmse -
                result.rmse
              ) /
              baseline.rmse
            ) * 100
          : 0;

      output.push([
        config.market,
        result.label,
        result.season,
        result.recent,
        result.predictions,
        result.mae,
        result.rmse,
        maeImprovement,
        rmseImprovement,
        result === bestMAE
          ? "YES"
          : "",
        result === bestRMSE
          ? "YES"
          : ""
      ]);

    });

  });

  const sheetName =
    "MLB Pitcher Model Holdout";

  let outputSheet =
    ss.getSheetByName(sheetName);

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(sheetName);
  }

  outputSheet.clearContents();

  const headers = [
    "Market",
    "Weights",
    "Season Weight",
    "Last 10 Weight",
    "Predictions",
    "MAE",
    "RMSE",
    "MAE Improvement vs 100/0 %",
    "RMSE Improvement vs 100/0 %",
    "Best MAE",
    "Best RMSE"
  ];

  outputSheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([headers]);

  if (output.length) {

    outputSheet
      .getRange(
        2,
        1,
        output.length,
        headers.length
      )
      .setValues(output);

  }

  outputSheet.setFrozenRows(1);

  outputSheet.autoResizeColumns(
    1,
    headers.length
  );

  Logger.log(
    `MLB pitcher holdout complete. ${output.length} model rows written.`
  );

}

