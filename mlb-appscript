    rowsWithProbabilityPair > 0,
    {
      rowsWithProjection:
        rowsWithProjection,

      rowsWithProbabilityPair:
        rowsWithProbabilityPair,

      projectionWithoutProbability:
        projectionWithoutProbability.length,

      samples:
