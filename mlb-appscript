function buildMLBUniversalPropHistoricalContext_({
  playerId,
  propType,
  historyIndex,
  trendIndex
}) {
  const normalizedPropType =
    normalizeMLBStatType_(
      propType
    );


  const weights =
    MLB_PROP_PROJECTION_WEIGHTS[
      normalizedPropType
    ] || null;


  // Unsupported/unmodeled market.
  if (!weights) {
    return {
      playerBaseline: null,
      trendAdjustment: null,
      projectedStat: null,
      statStdDev: null
    };
  }


  const trend =
    trendIndex[
      `${String(playerId)}::${normalizedPropType}`
    ] || null;


  if (!trend) {
    return {
      playerBaseline: null,
      trendAdjustment: null,
      projectedStat: null,
      statStdDev: null
    };
  }


  const seasonAvgRaw =
    trend["Season Avg"];

  const last10AvgRaw =
    trend["Last 10 Avg"];


  if (
    seasonAvgRaw === "" ||
    seasonAvgRaw === null ||
    seasonAvgRaw === undefined
  ) {
    return {
      playerBaseline: null,
      trendAdjustment: null,
      projectedStat: null,
      statStdDev: null
    };
  }


  const seasonAvg =
    Number(
      seasonAvgRaw
    );


  if (
    !Number.isFinite(seasonAvg) ||
    seasonAvg < 0
  ) {
    return {
      playerBaseline: null,
      trendAdjustment: null,
      projectedStat: null,
      statStdDev: null
    };
  }


  let trendAdjustment = 0;


  if (weights.recent > 0) {
    if (
      last10AvgRaw !== "" &&
      last10AvgRaw !== null &&
      last10AvgRaw !== undefined
    ) {
      const last10Avg =
        Number(
          last10AvgRaw
        );


      if (
        Number.isFinite(last10Avg) &&
        last10Avg >= 0
      ) {
        trendAdjustment =
          weights.recent *
          (
            last10Avg -
            seasonAvg
          );
      }
    }
  }


  const projectedStat =
    seasonAvg +
    trendAdjustment;


  const playerHistory =
    historyIndex[
      String(playerId)
    ] || [];


  const historicalValues =
    playerHistory
      .map(
        row =>
          getMLBHistoricalStatValue_(
            row,
            normalizedPropType
          )
      )
      .filter(
        value =>
          value !== null &&
          Number.isFinite(value)
      );


  let statStdDev = null;


  if (historicalValues.length >= 2) {
    statStdDev =
      stdDevMLB_(
        historicalValues
      );
  }


  return {
    playerBaseline:
      seasonAvg,

    trendAdjustment,

    projectedStat,

    statStdDev
  };
}

