  const gameDateCol =
    header.indexOf("Game Date");

  const hitsCol =
    header.indexOf("Hits");

  const runsCol =
    header.indexOf("Runs");

  const rbisCol =
    header.indexOf("RBIs");

  if (
    playerIdCol === -1 ||
    gameDateCol === -1 ||
    hitsCol === -1 ||
    runsCol === -1 ||
    rbisCol === -1
  ) {
    throw new Error(
      "Required Player ID, Game Date, Hits, Runs, or RBIs column not found."
    );
  }

  const playerGames = {};

  for (let i = 1; i < values.length; i++) {

    const row = values[i];

    const playerId =
      String(row[playerIdCol] || "");

    if (!playerId) continue;

    if (!playerGames[playerId]) {
      playerGames[playerId] = [];
    }

    playerGames[playerId].push(row);
  }

  Object.values(playerGames)
    .forEach(games => {

      games.sort((a, b) => {
        return (
          new Date(a[gameDateCol]) -
          new Date(b[gameDateCol])
        );
      });

    });

  const models = [
    {
      name: "Season Only 100/0",
      season: 1.00,
      recent: 0.00
    },
    {
      name: "Season + Last 10 95/5",
      season: 0.95,
      recent: 0.05
    },
    {
      name: "Season + Last 10 90/10",
      season: 0.90,
      recent: 0.10
    }
  ];

  const results = models.map(model => {

    let absoluteError = 0;
    let squaredError = 0;
    let predictions = 0;

    Object.values(playerGames)
      .forEach(games => {

        /*
         * Use the earlier 75% of each player's
         * chronological games as the initial
         * training period.
         *
         * Predictions are scored only on the
         * later 25% holdout period.
         */
        const holdoutStart =
          Math.floor(games.length * 0.75);

        if (holdoutStart < 11) {
          return;
        }

        for (
          let targetIndex = holdoutStart;
          targetIndex < games.length;
          targetIndex++
        ) {

          const previousGames =
            games.slice(0, targetIndex);

          const recentGames =
            previousGames.slice(-10);

          if (
            previousGames.length < 11 ||
            recentGames.length < 10
          ) {
            continue;
          }

          const actualRow =
            games[targetIndex];

          const actualHits =
            Number(actualRow[hitsCol]);

          const actualRuns =
            Number(actualRow[runsCol]);

          const actualRBIs =
            Number(actualRow[rbisCol]);

          if (
            !Number.isFinite(actualHits) ||
            !Number.isFinite(actualRuns) ||
            !Number.isFinite(actualRBIs)
          ) {
            continue;
          }

          const actual =
            actualHits +
            actualRuns +
            actualRBIs;

          const seasonValues =
            previousGames
              .map(row => {

                const hits =
                  Number(row[hitsCol]);

                const runs =
                  Number(row[runsCol]);

                const rbis =
                  Number(row[rbisCol]);

                if (
                  !Number.isFinite(hits) ||
                  !Number.isFinite(runs) ||
                  !Number.isFinite(rbis)
                ) {
                  return null;
                }

                return hits + runs + rbis;
              })
              .filter(Number.isFinite);

          const recentValues =
            recentGames
              .map(row => {

                const hits =
                  Number(row[hitsCol]);

                const runs =
                  Number(row[runsCol]);

                const rbis =
                  Number(row[rbisCol]);

                if (
                  !Number.isFinite(hits) ||
                  !Number.isFinite(runs) ||
                  !Number.isFinite(rbis)
                ) {
                  return null;
                }

                return hits + runs + rbis;
              })
              .filter(Number.isFinite);

          if (
            !seasonValues.length ||
            !recentValues.length
          ) {
            continue;
          }

          const seasonAverage =
            seasonValues.reduce(
              (sum, value) => sum + value,
              0
            ) /
            seasonValues.length;

          const recentAverage =
            recentValues.reduce(
              (sum, value) => sum + value,
              0
            ) /
            recentValues.length;

          const prediction =
            (
              seasonAverage *
              model.season
            ) +
            (
              recentAverage *
              model.recent
            );

          if (!Number.isFinite(prediction)) {
            continue;
          }

          const error =
            prediction - actual;

          absoluteError +=
            Math.abs(error);

          squaredError +=
            error * error;

          predictions++;

        }

      });

    if (!predictions) {
      return null;
    }

    return {
      name: model.name,
      seasonWeight: model.season,
      recentWeight: model.recent,
      predictions,
      mae:
        absoluteError / predictions,
      rmse:
        Math.sqrt(
          squaredError / predictions
        )
    };

  }).filter(Boolean);

  if (!results.length) {
    throw new Error(
      "H+R+RBI holdout produced no valid predictions."
    );
  }

  const baseline =
    results.find(
      result =>
        result.seasonWeight === 1 &&
        result.recentWeight === 0
    );

  const bestMAE =
    results.reduce(
      (best, result) =>
        !best || result.mae < best.mae
          ? result
          : best,
      null
    );

  const bestRMSE =
    results.reduce(
      (best, result) =>
        !best || result.rmse < best.rmse
          ? result
          : best,
      null
    );

  const outputSheetName =
    "MLB H+R+RBI Holdout";

  let outputSheet =
    ss.getSheetByName(outputSheetName);

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(outputSheetName);
  }

  outputSheet.clearContents();

  const output = [[
    "Model",
    "Season Weight",
    "Last 10 Weight",
    "Predictions",
    "MAE",
    "RMSE",
    "MAE Improvement vs Season Only",
    "RMSE Improvement vs Season Only",
    "Best MAE?",
    "Best RMSE?"
  ]];

  results.forEach(result => {

    const maeImprovement =
      baseline && baseline.mae > 0
        ? (
            baseline.mae -
            result.mae
          ) /
          baseline.mae
        : "";

    const rmseImprovement =
      baseline && baseline.rmse > 0
        ? (
            baseline.rmse -
            result.rmse
          ) /
          baseline.rmse
        : "";

    output.push([
      result.name,
      result.seasonWeight,
      result.recentWeight,
      result.predictions,
      result.mae,
      result.rmse,
      maeImprovement,
      rmseImprovement,
      result === bestMAE
        ? "YES"
        : "",
      result === bestRMSE
        ? "YES"
        : ""
    ]);

  });

  outputSheet
    .getRange(
      1,
      1,
      output.length,
      output[0].length
    )
    .setValues(output);

  outputSheet
    .getRange(
      2,
      2,
      output.length - 1,
      2
    )
    .setNumberFormat("0%");

  outputSheet
    .getRange(
      2,
      5,
      output.length - 1,
      2
    )
    .setNumberFormat("0.0000");

  outputSheet
    .getRange(
      2,
      7,
      output.length - 1,
      2
    )
    .setNumberFormat("0.000%");

  outputSheet.autoResizeColumns(
    1,
    output[0].length
  );

  Logger.log(
    "MLB H+R+RBI chronological holdout complete."
  );

}

function validateMLBLambdaWeightsHoldout() {

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const logsSheet =
    ss.getSheetByName("MLB Player Game Logs");

  if (!logsSheet) {
    throw new Error(
      'Sheet "MLB Player Game Logs" not found.'
    );
  }

  const values =
    logsSheet.getDataRange().getValues();

  if (values.length < 12) {
    throw new Error(
      "Not enough MLB Player Game Logs to run holdout validation."
    );
  }

  const header = values[0];

  const playerIdCol =
    header.indexOf("Player ID");

  const gameDateCol =
    header.indexOf("Game Date");

  if (
    playerIdCol === -1 ||
    gameDateCol === -1
  ) {
    throw new Error(
      "Required Player ID or Game Date column not found."
    );
  }

  const marketConfigs = [
    {
      market: "Hits",
      columnName: "Hits",
      seasonWeight: 0.95,
      recentWeight: 0.05
    },
    {
      market: "Runs",
      columnName: "Runs",
      seasonWeight: 1.00,
      recentWeight: 0.00
    },
    {
      market: "RBIs",
      columnName: "RBIs",
      seasonWeight: 1.00,
      recentWeight: 0.00
    },
    {
      market: "Home Runs",
      columnName: "Home Runs",
      seasonWeight: 1.00,
      recentWeight: 0.00
    },
    {
      market: "Total Bases",
      columnName: "Total Bases",
      seasonWeight: 1.00,
      recentWeight: 0.00
    },
    {
      market: "Walks",
      columnName: "Walks",
      seasonWeight: 0.00,
      recentWeight: 1.00
    },
    {
      market: "Strikeouts",
      columnName: "Strikeouts",
      seasonWeight: 0.85,
      recentWeight: 0.15
    },
    {
      market: "Stolen Bases",
      columnName: "Stolen Bases",
      seasonWeight: 0.00,
      recentWeight: 1.00
    }
  ];

  const markets =
    marketConfigs
      .map(config => ({
        ...config,
        column:
          header.indexOf(config.columnName)
      }))
      .filter(config =>
        config.column !== -1
      );

  if (!markets.length) {
    throw new Error(
      "No supported MLB stat columns found."
    );
  }

  /*
   * Convert each valid row into a compact object.
   * This avoids repeatedly constructing Date objects
   * and reading the full spreadsheet row later.
   */
  const compactRows = [];

  const uniqueDateSet =
    new Set();

  for (let i = 1; i < values.length; i++) {

    const row = values[i];

    const playerId =
      String(row[playerIdCol] || "");

    if (!playerId) {
      continue;
    }

    const dateObject =
      new Date(row[gameDateCol]);

    if (
      Number.isNaN(
        dateObject.getTime()
      )
    ) {
      continue;
    }

    /*
     * YYYY-MM-DD sorts correctly as text,
     * so we don't need Utilities.formatDate()
     * inside our large prediction loops.
     */
    const dateKey =
      Utilities.formatDate(
        dateObject,
        Session.getScriptTimeZone(),
        "yyyy-MM-dd"
      );

    uniqueDateSet.add(dateKey);

    const stats = {};

    markets.forEach(config => {

      const rawValue =
        row[config.column];

      /*
       * Do not silently convert a genuinely
       * blank spreadsheet cell into zero.
       */
      if (
        rawValue === "" ||
        rawValue === null ||
        rawValue === undefined
      ) {
        stats[config.market] = null;
        return;
      }

      const numericValue =
        Number(rawValue);

      stats[config.market] =
        Number.isFinite(numericValue)
          ? numericValue
          : null;

    });

    compactRows.push({
      playerId,
      dateKey,
      stats
    });

  }

  const uniqueDates =
    [...uniqueDateSet].sort();

  if (uniqueDates.length < 5) {
    throw new Error(
      "Not enough unique dates for holdout validation."
    );
  }

  const holdoutStartIndex =
    Math.floor(
      uniqueDates.length * 0.80
    );

  const holdoutStartDate =
    uniqueDates[holdoutStartIndex];

  Logger.log(
    `MLB holdout begins ${holdoutStartDate}`
  );

  /*
   * Group compact observations by player.
   */
  const playerGames = {};

  compactRows.forEach(game => {

    if (
      !playerGames[game.playerId]
    ) {
      playerGames[
        game.playerId
      ] = [];
    }

    playerGames[
      game.playerId
    ].push(game);

  });

  /*
   * Sort each player's games exactly once.
   */
  Object.values(playerGames)
    .forEach(games => {

      games.sort(
        (a, b) =>
          a.dateKey.localeCompare(
            b.dateKey
          )
      );

    });

  /*
   * Create one accumulator per market.
   */
  const accumulators = {};

  markets.forEach(config => {

    accumulators[config.market] = {
      candidateAbsoluteError: 0,
      candidateSquaredError: 0,
      seasonAbsoluteError: 0,
      seasonSquaredError: 0,
      predictions: 0
    };

  });

  /*
   * Each player is now processed once.
   */
  Object.values(playerGames)
    .forEach(games => {

      const state = {};

      markets.forEach(config => {

        state[config.market] = {
          seasonSum: 0,
          seasonCount: 0,
          recentValues: [],
          recentSum: 0
        };

      });

      games.forEach(game => {

        markets.forEach(config => {

          const market =
            config.market;

          const actual =
            game.stats[market];

          const marketState =
            state[market];

          /*
           * Evaluate BEFORE adding the current
           * game's result. This prevents leakage.
           */
          if (
            game.dateKey >=
              holdoutStartDate &&
            actual !== null &&
            marketState.seasonCount > 0 &&
            marketState.recentValues.length >= 10
          ) {

            const seasonAvg =
              marketState.seasonSum /
              marketState.seasonCount;

            const recentAvg =
              marketState.recentSum /
              marketState.recentValues.length;

            const candidatePrediction =
              (
                seasonAvg *
                config.seasonWeight
              ) +
              (
                recentAvg *
                config.recentWeight
              );

            const seasonPrediction =
              seasonAvg;

            const candidateError =
              candidatePrediction -
              actual;

            const seasonError =
              seasonPrediction -
              actual;

            const accumulator =
              accumulators[market];

            accumulator
              .candidateAbsoluteError +=
                Math.abs(
                  candidateError
                );

            accumulator
              .candidateSquaredError +=
                candidateError *
                candidateError;

            accumulator
              .seasonAbsoluteError +=
                Math.abs(
                  seasonError
                );

            accumulator
              .seasonSquaredError +=
                seasonError *
                seasonError;

            accumulator.predictions++;

          }

          /*
           * Now update history with the
           * current result.
           */
          if (actual !== null) {

            marketState.seasonSum +=
              actual;

            marketState.seasonCount++;

            marketState
              .recentValues
              .push(actual);

            marketState.recentSum +=
              actual;

            if (
              marketState
                .recentValues
                .length > 10
            ) {

              marketState.recentSum -=
                marketState
                  .recentValues
                  .shift();

            }

          }

        });

      });

    });

  const results = [];

  markets.forEach(config => {

    const accumulator =
      accumulators[config.market];

    const predictions =
      accumulator.predictions;

    if (!predictions) {
      return;
    }

    const candidateMAE =
      accumulator
        .candidateAbsoluteError /
      predictions;

    const candidateRMSE =
      Math.sqrt(
        accumulator
          .candidateSquaredError /
        predictions
      );

    const seasonMAE =
      accumulator
        .seasonAbsoluteError /
      predictions;

    const seasonRMSE =
      Math.sqrt(
        accumulator
          .seasonSquaredError /
        predictions
      );

    const maeImprovement =
      seasonMAE > 0
        ? (
            seasonMAE -
            candidateMAE
          ) /
          seasonMAE
        : 0;

    const rmseImprovement =
      seasonRMSE > 0
        ? (
            seasonRMSE -
            candidateRMSE
          ) /
          seasonRMSE
        : 0;

    let resultLabel = "SAME";

    if (maeImprovement > 0) {
      resultLabel = "PASS";
    } else if (maeImprovement < 0) {
      resultLabel = "FAIL";
    }

    results.push([
      config.market,
      config.seasonWeight,
      config.recentWeight,
      predictions,
      seasonMAE,
      candidateMAE,
      maeImprovement,
      seasonRMSE,
      candidateRMSE,
      rmseImprovement,
      resultLabel
    ]);

  });

  if (!results.length) {
    throw new Error(
      "Holdout produced no valid predictions."
    );
  }

  const outputSheetName =
    "MLB Model Holdout";

  let outputSheet =
    ss.getSheetByName(
      outputSheetName
    );

  if (!outputSheet) {

    outputSheet =
      ss.insertSheet(
        outputSheetName
      );

  }

  outputSheet.clearContents();

  const output = [[
    "Market",
    "Season Weight",
    "Last 10 Weight",
    "Predictions",
    "Season MAE",
    "Candidate MAE",
    "MAE Improvement",
    "Season RMSE",
    "Candidate RMSE",
    "RMSE Improvement",
    "MAE Result"
  ], ...results];

  outputSheet
    .getRange(
      1,
      1,
      output.length,
      output[0].length
    )
    .setValues(output);

  outputSheet
    .getRange(
      2,
      2,
      results.length,
      2
    )
    .setNumberFormat("0%");

  outputSheet
    .getRange(
      2,
      5,
      results.length,
      2
    )
    .setNumberFormat("0.0000");

  outputSheet
    .getRange(
      2,
      7,
      results.length,
      1
    )
    .setNumberFormat("0.000%");

  outputSheet
    .getRange(
      2,
      8,
      results.length,
      2
    )
    .setNumberFormat("0.0000");

  outputSheet
    .getRange(
      2,
      10,
      results.length,
      1
    )
    .setNumberFormat("0.000%");

  outputSheet.autoResizeColumns(
    1,
    output[0].length
  );

  Logger.log(
    `MLB holdout validation complete. Holdout begins ${holdoutStartDate}.`
  );

}

function getMLBOpponentFromStat_(stat) {
  const game = stat.game || {};
  const team = stat.team || {};

  const teamId = String(team.id || "");
  const homeTeamId = String((game.home_team && game.home_team.id) || "");
  const awayTeamId = String(
    (game.away_team && game.away_team.id) ||
    (game.visitor_team && game.visitor_team.id) ||
    ""
  );

  if (teamId && teamId === homeTeamId) {
    return getMLBTeamName_(game.away_team || game.visitor_team || {});
  }

  if (teamId && teamId === awayTeamId) {
    return getMLBTeamName_(game.home_team || {});
  }

  return "";
}

function refreshMLBPlayerPropsSheet() {
  const sheetName =
    "Player Props";

  const scheduleSheetName =
    "Schedule";


  const ss =
    SpreadsheetApp.getActiveSpreadsheet();


  const sheet =
    ss.getSheetByName(
      sheetName
    );


  const scheduleSheet =
    ss.getSheetByName(
      scheduleSheetName
    );


  if (!sheet) {
    throw new Error(
      `Sheet "${sheetName}" not found.`
    );
  }


  if (!scheduleSheet) {
    throw new Error(
      `Sheet "${scheduleSheetName}" not found.`
    );
  }


  Logger.log(
    "Refreshing MLB player props using universal A:AJ production output..."
  );


  // --------------------------------------------------------------------------
  // UNIVERSAL A:AJ CONTRACT
  // --------------------------------------------------------------------------

  const universalColumnCount =
    MLB_UNIVERSAL_PLAYER_PROPS_HEADERS.length;


  if (
    universalColumnCount !== 36
  ) {
    throw new Error(
      `MLB universal Player Props header count must be 36; received ${universalColumnCount}.`
    );
  }


  const currentMaxColumns =
    sheet.getMaxColumns();


  if (
    currentMaxColumns <
    universalColumnCount
  ) {
    sheet.insertColumnsAfter(
      currentMaxColumns,
      universalColumnCount -
      currentMaxColumns
    );
  }


  // Row 1 becomes the authoritative universal contract.
  sheet
    .getRange(
      1,
      1,
      1,
      universalColumnCount
    )
    .setValues([
      MLB_UNIVERSAL_PLAYER_PROPS_HEADERS
    ]);


  // Remove all stale legacy rows/formulas.
  clearPlayerPropsData_(sheet);


  // --------------------------------------------------------------------------
  // SCHEDULE
  // --------------------------------------------------------------------------

  const games =
    getGamesFromScheduleSheet_(
      scheduleSheet
    );


  if (!games.length) {
    Logger.log(
      "No schedule rows found. MLB Player Props now contains universal A:AJ headers with no stale prop rows."
    );

    return;
  }


  const gameMap = {};


  games.forEach(game => {
    gameMap[
      String(game.id)
    ] = {
      game_date:
        game.game_date ?? "",

      away_team:
        game.away_team ?? "",

      home_team:
        game.home_team ?? ""
    };
  });


  // --------------------------------------------------------------------------
  // BUILD UNIVERSAL CONTEXT ONCE
  // --------------------------------------------------------------------------

  Logger.log(
    "Building MLB Player Props historical, trend, and identity indexes..."
  );


  const historyIndex =
    buildMLBPlayerPropHistoryIndex_();


  const trendIndex =
    buildMLBPlayerTrendIndex_();


  const playerIdentityIndex =
    buildMLBPlayerIdentityIndex_();


  Logger.log(
    "MLB Player Props context indexes built."
  );


  // --------------------------------------------------------------------------
  // FETCH + ASSEMBLE UNIVERSAL ROWS
  // --------------------------------------------------------------------------

  const allRows = [];


  const seenPropIds =
    new Set();


  games.forEach(
    (game, index) => {

      Logger.log(
        `Fetching MLB props for game ${index + 1}/${games.length} (ID: ${game.id})`
      );


      const props =
        fetchAllMLBPlayerPropsForGame_(
          game.id
        );


      const gameInfo =
        gameMap[
          String(game.id)
        ] || {};


      Logger.log(
        `Returned ${props.length} MLB props for game ID ${game.id}`
      );


      props.forEach(prop => {

        const propId =
          String(
            prop.id ?? ""
          );


        if (
          propId &&
          seenPropIds.has(
            propId
          )
        ) {
          return;
        }


        if (propId) {
          seenPropIds.add(
            propId
          );
        }


        const playerId =
          prop.player_id ??
          (
            prop.player
              ? prop.player.id
              : null
          ) ??
          "";


        const vendor =
          prop.vendor ??
          prop.sportsbook ??
          prop.bookmaker ??
          "";


        const propType =
          prop.prop_type ??
          (
            typeof prop.market === "string"
              ? prop.market
              : ""
          );


        const lineValue =
          prop.line ??
          prop.line_value ??
          "";


        const typeValue =
          (
            prop.market &&
            typeof prop.market === "object"
          )
            ? (
                prop.market.type ??
                ""
              )
            : "";


        const odds =
          (
            prop.market &&
            typeof prop.market === "object"
          )
            ? (
                prop.market.odds ??
                ""
              )
            : "";


        const updatedAt =
          prop.updated_at ??
          "";


        const overOdds =
          (
            prop.market &&
            typeof prop.market === "object"
          )
            ? (
                prop.market.over_odds ??
                ""
              )
            : "";


        const underOdds =
          (
            prop.market &&
            typeof prop.market === "object"
          )
            ? (
                prop.market.under_odds ??
                ""
              )
            : "";


        // --------------------------------------------------------------------
        // RAW PROVIDER A:N
        // --------------------------------------------------------------------

        const providerRow = {

          "Game Id":
            game.id ?? "",

          "Game Date":
            gameInfo.game_date ?? "",

          "Away Team":
            gameInfo.away_team ?? "",

          "Home Team":
            gameInfo.home_team ?? "",

          "Id":
            prop.id ?? "",

          "Player Id":
            playerId,

          "Vendor":
            vendor,

          "Prop Type":
            propType,

          "Line Value":
            lineValue,

          "Type":
            typeValue,

          "Odds":
            odds,

          "Updated At":
            updatedAt,

          "Over Odds":
            overOdds,

          "Under Odds":
            underOdds
        };


        // --------------------------------------------------------------------
        // D5 -> D6 PRODUCTION CUTOVER
        // --------------------------------------------------------------------

        const universalRow =
          buildMLBUniversalPropRowFromProvider_({
            providerRow,
            historyIndex,
            trendIndex,
            playerIdentityIndex
          });


        if (!universalRow) {
          return;
        }


        if (
          !Array.isArray(
            universalRow
          ) ||
          universalRow.length !==
          universalColumnCount
        ) {
          throw new Error(
