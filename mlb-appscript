    const hits = getMLBGameStatFlexible_(row, ["hits", "h", "batting_h"]);
    const runs = getMLBGameStatFlexible_(row, ["runs", "runs_scored", "batting_r"]);
    const homeRuns = getMLBGameStatFlexible_(row, ["home_runs", "hr", "batting_hr"]);
