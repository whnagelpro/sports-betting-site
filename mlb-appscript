function buildMLBTeamTrendNote_(teamName, metricLabel, seasonAvg, last5, hitRateLast5, trendScore) {
  const team = `The ${teamName || "team"}`;
  const metric = metricLabel || "this metric";

  const last5Text = Number(last5).toFixed(2);
  const seasonText = Number(seasonAvg).toFixed(2);
  const hitRateText = formatPercentMLB_(hitRateLast5);
  const trendText = formatSignedPercentMLB_(trendScore);

  if (trendScore >= 15) {
    return `${team} are trending up in ${metric}, averaging ${last5Text} over the last 5 games compared to ${seasonText} on the season (${trendText}), with a 1+ hit rate of ${hitRateText}.`;
  }

  if (trendScore <= -15) {
    return `${team} are trending down in ${metric}, averaging ${last5Text} over the last 5 games compared to ${seasonText} on the season (${trendText}), with a 1+ hit rate of ${hitRateText}.`;
  }

  return `${team} are holding steady in ${metric}, averaging ${last5Text} over the last 5 games compared to ${seasonText} on the season, with a 1+ hit rate of ${hitRateText}.`;
}

function trendStrengthMLB_(hitRate, aboveSeasonPct, trendScore) {
  const hr = Number(hitRate);
  const above = Number(aboveSeasonPct);
  const score = Number(trendScore);

  if (Number.isNaN(hr) || Number.isNaN(above) || Number.isNaN(score)) {
    return "Unknown";
  }

  if (hr >= 0.80 && above >= 20 && score >= 15) {
    return "Elite Trend";
  }

  if (hr >= 0.70 && above >= 10 && score >= 7.5) {
    return "Strong Trend";
  }

  if (hr >= 0.60 && score >= 0) {
    return "Moderate Trend";
  }

  if (score < -10 || above < -10) {
    return "Cold Trend";
  }

  return "Weak Trend";
}

function strengthRank_(strength) {
  const value = String(strength || "").toLowerCase();
  if (value.includes("elite")) return 100;
  if (value.includes("strong")) return 80;
  if (value.includes("moderate")) return 60;
  if (value.includes("weak")) return 35;
  if (value.includes("cold")) return 15;
  return 0;
}

function populateMLBTeamMetricRanks_(rows) {

  const metricGroups = {};

  rows.forEach(row => {

    const metric = row[1];

    if (!metricGroups[metric]) {

      metricGroups[metric] = [];

    }

    metricGroups[metric].push(row);

  });

  const higherIsBetter = {

    "Hits": true,

    "Home Runs": true,

    "Runs For": true,

    "Strikeouts": true,

    "Total Bases": true,

    "Runs Allowed": false

  };

  Object.keys(metricGroups).forEach(metric => {

    const group = metricGroups[metric];

    group.sort((a, b) => {

      const aValue = Number(a[2]) || 0;
      const bValue = Number(b[2]) || 0;

      return higherIsBetter[metric]
        ? bValue - aValue
        : aValue - bValue;

    });

    const totalTeams = group.length;

    group.forEach((row, index) => {

      const rank = index + 1;

      const rankScore =
        totalTeams <= 1
          ? 100
          : 100 - ((rank - 1) / (totalTeams - 1)) * 100;

      row[17] = rank;

      row[18] = Number(rankScore.toFixed(1));

    });

  });

}

function populateMLBTeamRatings_(rows) {

  const teams = {};

  rows.forEach(row => {

    const team = row[0];
    const metric = row[1];
    const rankScore = Number(row[18]) || 0;

    if (!teams[team]) {
      teams[team] = {};
    }

    teams[team][metric] = rankScore;

  });

  Object.keys(teams).forEach(team => {

    const t = teams[team];

    const offenseScores = [
      t["Hits"],
      t["Home Runs"],
      t["Runs For"],
      t["Total Bases"]
    ].filter(v => v !== undefined);

    const pitchingScores = [
      t["Runs Allowed"],
      t["Strikeouts"]
    ].filter(v => v !== undefined);

    t.offense =
      offenseScores.length
        ? offenseScores.reduce((a,b)=>a+b,0) /
          offenseScores.length
        : 0;

    t.pitching =
      pitchingScores.length
        ? pitchingScores.reduce((a,b)=>a+b,0) /
          pitchingScores.length
        : 0;

  });

  rows.forEach(row => {

    const t = teams[row[0]];

    row[19] = Number(t.offense.toFixed(1));

    row[20] = Number(t.pitching.toFixed(1));

  });

}

function populateOverallTeamRatings_(sheet) {

  const values = sheet.getDataRange().getValues();

  if (values.length < 2) return;

  const header = values[0];

  const teamCol =
    header.indexOf("Team");

  const offenseCol =
    header.indexOf("Offensive Rating");

  const pitchingCol =
    header.indexOf("Pitching Rating");

  const overallCol =
    header.indexOf("Overall Rating");

  const tierCol =
    header.indexOf("Rating Tier");

  const notesCol =
    header.indexOf("Rating Notes");

  const teamRatings = {};

  for (let i = 1; i < values.length; i++) {

    const row = values[i];

    const team = row[teamCol];

    if (!teamRatings[team]) {

      const offense =
        Number(row[offenseCol]) || 0;

      const pitching =
        Number(row[pitchingCol]) || 0;

      /*
       60% offense
       40% pitching
      */

      const overall =
        offense * 0.60 +
        pitching * 0.40;

      let tier = "";

      if (overall >= 90)
        tier = "Elite";

      else if (overall >= 75)
        tier = "Strong";

      else if (overall >= 55)
        tier = "Average";

      else if (overall >= 40)
        tier = "Below Average";

      else
        tier = "Weak";

      let note = "";

      if (offense > pitching + 20)
        note =
          "Offense carrying the team.";

      else if (pitching > offense + 20)
        note =
          "Pitching carrying the team.";

      else
        note =
          "Balanced team profile.";

      teamRatings[team] = {
        overall,
        tier,
        note
      };

    }

  }

  for (let i = 1; i < values.length; i++) {

    const row = values[i];

    const team =
      row[teamCol];

    const rating =
      teamRatings[team];

    row[overallCol] =
      Math.round(rating.overall * 10) / 10;

    row[tierCol] =
      rating.tier;

    row[notesCol] =
      rating.note;

  }

  sheet
    .getRange(
      2,
      1,
      values.length - 1,
      values[0].length
    )
    .setValues(values.slice(1));

}

function clampScore_(value, min, max) {
  return Math.max(min, Math.min(max, value));
}

function calculateTrendConfidence_(row) {
  const strengthScore = strengthRank_(row["Trend Strength"]);
  const hitRate = Number(row["Hit Rate Last 5"] || 0) * 100;
  const trendScore = clampScore_(Number(row["Trend Score"] || 0), -50, 50);
  const consistency = clampScore_(Number(row["Consistency"] || 0), 0, 100);
  const aboveSeason = clampScore_(Number(row["Above Season %"] || 0), -50, 50);
  const last5 = Number(row["Last 5 Avg"] || 0);
  const seasonAvg = Number(row["Season Avg"] || 0);

  const recentForm = seasonAvg > 0
    ? clampScore_((last5 / seasonAvg) * 50, 0, 100)
    : 0;

  return Math.round(clampScore_(
    strengthScore * 0.35 +
    hitRate * 0.25 +
    (trendScore + 50) * 0.15 +
    consistency * 0.10 +
    (aboveSeason + 50) * 0.10 +
    recentForm * 0.05,
    0,
    100
  ));
}

