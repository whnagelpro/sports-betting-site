      'D10AM: Production "Player Props" sheet was not found.'
    );
  }

  const expectedHeaders =
    MLB_UNIVERSAL_PLAYER_PROPS_HEADERS.slice();

  const expectedColumnCount =
    expectedHeaders.length;

  const results = [];

  function addResult(
    name,
    pass,
    details
  ) {

    const result =
      Object.assign(
        {
          name: name,
          pass: !!pass
        },
        details || {}
      );

    results.push(result);

    Logger.log(
      JSON.stringify(result)
    );
  }

  function isBlank_(value) {
    return (
      value === "" ||
      value === null ||
      typeof value === "undefined"
    );
  }

  function isFiniteNumber_(value) {

    if (isBlank_(value)) {
      return false;
    }

    const n =
      Number(value);

    return Number.isFinite(n);
  }

  function normalizedText_(value) {
    return String(
      isBlank_(value)
        ? ""
        : value
    ).trim();
  }

  // --------------------------------------------------------------------------
  // CONTRACT / SHEET SHAPE
  // --------------------------------------------------------------------------

  addResult(
    "D10AM universal MLB contract remains exactly 36 columns",
