  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("MLB Team Game Logs");

  const headers = [
    "Game Date",
    "Game ID",
    "Team",
    "Opponent",
    "Runs For",
    "Runs Allowed",
    "Hits",
    "Home Runs",
    "Total Bases",
    "Strikeouts"
  ];

  Logger.log(`Refreshing MLB Team Game Logs from ${startDate} to ${endDate}`);

  const selectedGames = getMLBCompletedGamesForDateRange_(startDate, endDate);

  if (!selectedGames.length) {
    Logger.log("No completed MLB games found for this team-log date range.");
    return;
  }

  const gameIds = selectedGames.map(g => g.id).filter(Boolean);
  const statRows = fetchAllMLBStatsForGameIds_(gameIds);
  const teamGameStatsMap = buildMLBTeamGameStatsMap_(statRows);

  const rows = [];

  selectedGames.forEach(game => {
    const gameId = String(game.id || "");
    const homeTeam = game.home_team || {};
    const awayTeam = game.away_team || game.visitor_team || {};

    addMLBTeamGameLogRow_(rows, game, gameId, homeTeam, awayTeam, teamGameStatsMap);
    addMLBTeamGameLogRow_(rows, game, gameId, awayTeam, homeTeam, teamGameStatsMap);
  });

  upsertRowsByKey_(sheet, headers, rows, [1, 2]);

  Logger.log(`Upserted ${rows.length} MLB team game-log rows for ${startDate} to ${endDate}.`);
}

function isMLBTrendEligibleGame_(game) {
  if (!game) return false;

  const gameId =
    String(game.id || "").trim();

  const gameDate =
    getMLBGameAZDate_(game);

  /*
   * Permanently exclude the 2026 MLB All-Star Game.
   */
  if (
    gameId === "8712499" ||
    gameDate === "2026-07-14"
  ) {
    Logger.log(
      `Excluded 2026 MLB All-Star Game: ` +
      `Game ID ${gameId}, date ${gameDate}`
    );

    return false;
  }

  const homeTeam =
    getMLBTeamName_(
      game.home_team || {}
    );

  const awayTeam =
    getMLBTeamName_(
      game.away_team ||
      game.visitor_team ||
      {}
    );

  const searchableText = [
    homeTeam,
    awayTeam,
    game.name,
    game.title,
    game.description,
    game.game_type,
    game.type,
    game.season_type,
    game.status
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();

  const excludedTerms = [
    "all-star",
    "all star",
    "all-stars",
    "all stars",
    "american league",
    "national league",
    "exhibition",
    "spring training"
  ];

  const isExcluded =
    excludedTerms.some(term =>
      searchableText.includes(term)
    );

  if (isExcluded) {
    Logger.log(
      `Excluded non-trend MLB game ${gameId}: ` +
      `${awayTeam} at ${homeTeam}`
    );

    return false;
  }

  return true;
}

function removeMLB2026AllStarGameFromLogs() {
  const excludedDate = "2026-07-14";
  const excludedGameId = "8712499";

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const sheetNames = [
    "MLB Player Game Logs",
    "MLB Team Game Logs"
  ];

  sheetNames.forEach(sheetName => {
    const sheet = ss.getSheetByName(sheetName);

    if (!sheet || sheet.getLastRow() < 2) {
      Logger.log(
        `${sheetName} does not exist or contains no data rows.`
      );
      return;
    }

    const values = sheet.getDataRange().getValues();
    const headers = values[0].map(header =>
      String(header || "").trim()
    );

    const gameDateIndex = headers.indexOf("Game Date");
    const gameIdIndex = headers.indexOf("Game ID");

    if (gameDateIndex === -1 || gameIdIndex === -1) {
      Logger.log(
        `${sheetName} is missing the Game Date or Game ID column.`
      );
      return;
    }

    const remainingRows = values
      .slice(1)
      .filter(row => {
        const rowDate =
          normalizeMLBLogDateForCleanup_(
            row[gameDateIndex]
          );

        const rowGameId =
          String(row[gameIdIndex] || "").trim();

        const matchesAllStarDate =
          rowDate === excludedDate;

        const matchesAllStarGameId =
          rowGameId === excludedGameId;

        /*
         * Remove a row if either:
         * 1. It belongs to the known All-Star Game ID, or
         * 2. It is dated July 14, 2026.
         */
        return !(
          matchesAllStarGameId ||
          matchesAllStarDate
        );
      });

    const removedCount =
      values.length - 1 - remainingRows.length;

    sheet.clearContents();

    sheet
      .getRange(
        1,
        1,
        1,
        headers.length
      )
      .setValues([headers]);

    if (remainingRows.length > 0) {
      sheet
        .getRange(
          2,
          1,
          remainingRows.length,
          headers.length
        )
        .setValues(remainingRows);
    }

    sheet.setFrozenRows(1);

    Logger.log(
      `Removed ${removedCount} rows from ${sheetName} ` +
      `for date ${excludedDate} or Game ID ${excludedGameId}.`
    );
  });
}

function normalizeMLBLogDateForCleanup_(value) {
  if (!value) return "";

  if (
    Object.prototype.toString.call(value) ===
    "[object Date]"
  ) {
    return Utilities.formatDate(
      value,
      SPORTACULAR_TIMEZONE,
      "yyyy-MM-dd"
    );
  }

  const raw = String(value).trim();

  if (/^\d{4}-\d{2}-\d{2}$/.test(raw)) {
    return raw;
  }

  const mmddyyyyMatch = raw.match(
    /^(\d{1,2})\/(\d{1,2})\/(\d{4})$/
  );

  if (mmddyyyyMatch) {
    const month =
      mmddyyyyMatch[1].padStart(2, "0");

    const day =
      mmddyyyyMatch[2].padStart(2, "0");

    const year =
      mmddyyyyMatch[3];

    return `${year}-${month}-${day}`;
  }

  const parsed = new Date(raw);

  if (!isNaN(parsed.getTime())) {
    return Utilities.formatDate(
      parsed,
      SPORTACULAR_TIMEZONE,
      "yyyy-MM-dd"
    );
  }

  return raw;
}

function getMLBCompletedGamesForDateRange_(startDate, endDate) {
  const selectedGamesMap = {};

  const fetchStartDate =
    addDaysToDateString_(startDate, -1);

  const fetchEndDate =
    addDaysToDateString_(endDate, 1);

  let current =
    new Date(fetchStartDate + "T00:00:00");

  const end =
    new Date(fetchEndDate + "T00:00:00");

  while (current <= end) {
    const apiDateString =
      Utilities.formatDate(
        current,
        SPORTACULAR_TIMEZONE,
        "yyyy-MM-dd"
      );

    Logger.log(
      `Checking MLB API games for ${apiDateString}`
    );

    const games =
      fetchAllMLBGamesForDate_(apiDateString)
        .filter(isCompletedMLBGame_)
        .filter(isMLBTrendEligibleGame_)
        .filter(game => {
          const azDate =
            getMLBGameAZDate_(game);

          return (
            azDate >= startDate &&
            azDate <= endDate
          );
        });

    games.forEach(game => {
      if (game.id) {
        selectedGamesMap[
          String(game.id)
        ] = game;
      }
    });

    current.setDate(
      current.getDate() + 1
    );

    Utilities.sleep(100);
  }

  return Object.values(
    selectedGamesMap
  );
}

function upsertRowsByKey_(sheet, headers, newRows, keyColumnIndexes) {
  const existingValues = sheet.getDataRange().getValues();

  const existingRows =
    existingValues.length > 1 ? existingValues.slice(1) : [];

  const rowMap = {};

  existingRows.forEach(row => {
    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  newRows.forEach(row => {
    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  const finalRows = Object.values(rowMap).sort((a, b) =>
    new Date(b[0]).getTime() - new Date(a[0]).getTime()
  );

  writeMLBOutputSheet_(sheet, headers, finalRows);
}

function upsertRowsByKeyForDateRange_(sheet, headers, newRows, keyColumnIndexes, startDate, endDate) {
  const existingValues = sheet.getDataRange().getValues();
  const existingRows = existingValues.length > 1 ? existingValues.slice(1) : [];
  const rowMap = {};

  existingRows.forEach(row => {
    const rowDate = String(row[0] || "");

    if (rowDate >= startDate && rowDate <= endDate) {
      return;
    }

    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  newRows.forEach(row => {
    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  const finalRows = Object.values(rowMap).sort((a, b) =>
    new Date(b[0]).getTime() - new Date(a[0]).getTime()
  );

  writeMLBOutputSheet_(sheet, headers, finalRows);
}

function addMLBTeamGameLogRow_(rows, game, gameId, team, opponent, statMap) {
  const teamName = getMLBTeamName_(team);
  const opponentName = getMLBTeamName_(opponent);

  const teamKey = normalizeMLBTeamName_(teamName);
  const opponentKey = normalizeMLBTeamName_(opponentName);

  const stat = statMap[`${gameId}_${teamKey}`] || {};
  const opp = statMap[`${gameId}_${opponentKey}`] || {};

  rows.push([
    getMLBGameAZDate_(game),
    gameId,
    teamName,
    opponentName,
    Number(stat.runs || 0),
    Number(opp.runs || 0),
    Number(stat.hits || 0),
    Number(stat.homeRuns || 0),
    Number(stat.totalBases || 0),
    Number(stat.strikeouts || 0)
  ]);
}

