function refreshMLBBaselinesSheet() {
  const sheetName = "MLB Baselines";
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    throw new Error(`Sheet "${sheetName}" not found.`);
  }

  Logger.log("Refreshing MLB Baselines from player season stats...");

  const headers = [
    "Player Id",
    "Player Name",
    "doubles",
    "first_home_run",
    "hits",
    "hits_runs_rbis",
    "home_runs",
    "pitcher_earned_runs",
    "pitcher_hits_allowed",
    "pitcher_strikeouts",
    "pitcher_outs",
    "pitcher_record_a_win",
    "pitcher_walks",
    "rbis",
    "runs_scored",
    "singles",
    "stolen_bases",
    "strikeouts",
    "total_bases",
    "triples",
    "walks",
    "games_used"
  ];

  const season = getCurrentMLBSeason_();
  const playerIds = getMLBPlayerIdsFromPlayerProps_();
  const playerLookup = getMLBPlayerLookupMap_();

  const rows = [];

  playerIds.forEach((playerId, index) => {
    Logger.log(`Fetching MLB season stats for player ${index + 1}/${playerIds.length} (ID: ${playerId})`);

    const statsArray = fetchMLBPlayerSeasonStats_(playerId, season);
    const stat = getMLBSeasonStatsObject_(statsArray);

    if (!stat) {
      Utilities.sleep(100);
      return;
    }

    const battingGp = Number(stat.batting_gp || 0);
    const pitchingGp = Number(stat.pitching_gp || 0);
    const gamesUsed = Math.max(battingGp, pitchingGp);

    if (!gamesUsed) {
      Utilities.sleep(100);
      return;
    }

    const playerInfo = playerLookup[String(playerId)] || {};

    const doublesPerGame = Number(stat.batting_2b || 0) / gamesUsed;
    const triplesPerGame = Number(stat.batting_3b || 0) / gamesUsed;
    const hitsPerGame = Number(stat.batting_h || 0) / gamesUsed;
    const homeRunsPerGame = Number(stat.batting_hr || 0) / gamesUsed;
    const rbisPerGame = Number(stat.batting_rbi || 0) / gamesUsed;
    const runsPerGame = Number(stat.batting_r || 0) / gamesUsed;
    const totalBasesPerGame = Number(stat.batting_tb || 0) / gamesUsed;
    const walksPerGame = Number(stat.batting_bb || 0) / gamesUsed;
    const batterKsPerGame = Number(stat.batting_so || 0) / gamesUsed;
    const stolenBasesPerGame = Number(stat.batting_sb || 0) / gamesUsed;

    const singlesPerGame = Math.max(
      0,
      (Number(stat.batting_h || 0) -
        Number(stat.batting_2b || 0) -
        Number(stat.batting_3b || 0) -
        Number(stat.batting_hr || 0)) / gamesUsed
    );

    const earnedRunsPerGame = Number(stat.pitching_er || 0) / gamesUsed;
    const hitsAllowedPerGame = Number(stat.pitching_h || 0) / gamesUsed;
    const pitcherKsPerGame = Number(stat.pitching_so || 0) / gamesUsed;
    const outsPerGame = Number(stat.pitching_outs || 0) / gamesUsed;
    const pitcherWalksPerGame = Number(stat.pitching_bb || 0) / gamesUsed;
    const pitcherWinsPerGame = Number(stat.pitching_wins || 0) / gamesUsed;

    const hrrPerGame = hitsPerGame + runsPerGame + rbisPerGame;

    rows.push([
      playerId,                     // A
      playerInfo.playerName || "",  // B
      doublesPerGame,               // C doubles
      homeRunsPerGame,              // D first_home_run (proxy)
      hitsPerGame,                  // E hits
      hrrPerGame,                   // F hits_runs_rbis
      homeRunsPerGame,              // G home_runs
      earnedRunsPerGame,            // H pitcher_earned_runs
      hitsAllowedPerGame,           // I pitcher_hits_allowed
      pitcherKsPerGame,             // J pitcher_strikeouts
      outsPerGame,                  // K pitcher_outs
      pitcherWinsPerGame,           // L pitcher_record_a_win
      pitcherWalksPerGame,          // M pitcher_walks
      rbisPerGame,                  // N rbis
      runsPerGame,                  // O runs_scored
      singlesPerGame,               // P singles
      stolenBasesPerGame,           // Q stolen_bases
      batterKsPerGame,              // R strikeouts
      totalBasesPerGame,            // S total_bases
      triplesPerGame,               // T triples
      walksPerGame,                 // U walks
      gamesUsed                     // V games_used
    ]);

    Utilities.sleep(100);
  });

  rows.sort((a, b) => {
    const nameA = (a[1] || "").toLowerCase();
    const nameB = (b[1] || "").toLowerCase();
    return nameA.localeCompare(nameB);
  });

  clearMLBBaselinesSheet_(sheet);

  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);

  if (rows.length > 0) {
    sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
  }

  Logger.log(`Wrote ${rows.length} MLB baseline rows to "${sheetName}" for season ${season}`);
}

