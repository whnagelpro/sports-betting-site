function refreshMLBTeamTrendsSheet() {
  const sheetName = "MLB Team Trends";
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    throw new Error(`Sheet "${sheetName}" not found.`);
  }

  Logger.log("Refreshing MLB Team Trends...");

  const headers = [
    "Team",
    "runs_scored_last5",
    "runs_allowed_last5",
    "hits_last5",
    "home_runs_last5",
    "total_bases_last5",
    "team_strikeouts_last5",
    "overs_last5",
    "unders_last5",
    "games_used_last5"
  ];

  const lookback = getRecentCompletedMLBGamesForTeamTrends_(5, 10);
  const teams = lookback.teams;
  const teamGamesMap = lookback.teamGamesMap;
  const selectedGames = lookback.selectedGames;

  if (!selectedGames.length) {
    clearMLBTeamTrendsSheet_(sheet);
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    Logger.log("No completed MLB games found for Team Trends.");
    return;
  }

  const gameIds = selectedGames.map(g => g.id).filter(Boolean);
  const statRows = fetchAllMLBStatsForGameIds_(gameIds);
  Logger.log(`Stat rows fetched: ${statRows.length}`);

  const teamGameStatsMap = buildMLBTeamGameStatsMap_(statRows);
  Logger.log(`TeamGameStatsMap keys: ${Object.keys(teamGameStatsMap).length}`);

  const rows = [];

  teams.forEach(team => {
    const teamId = String(team.id || "");
    const teamNameDisplay = getMLBTeamName_(team);
    const teamNameKey = normalizeMLBTeamName_(teamNameDisplay);

    const games = (teamGamesMap[teamId] || [])
      .slice()
      .sort((a, b) => getMLBGameDateTimestamp_(b) - getMLBGameDateTimestamp_(a))
      .slice(0, 5);

    const used = games.length;
    if (!used) return;

    let runsScored = 0;
    let runsAllowed = 0;
    let hits = 0;
    let homeRuns = 0;
    let totalBases = 0;
    let strikeouts = 0;

    // Leave totals blank for now until you add a historical totals source
    const overs = "";
    const unders = "";

    games.forEach(game => {
      const gameId = String(game.id || "");
      const homeTeamId = getMLBHomeTeamIdFromGame_(game);
      const awayTeamId = getMLBAwayTeamIdFromGame_(game);
      const isHome = teamId === homeTeamId;

      const opponentNameKey = normalizeMLBTeamName_(
        isHome ? getMLBAwayTeamNameFromGame_(game) : getMLBHomeTeamNameFromGame_(game)
      );

      const statKey = `${gameId}_${teamNameKey}`;
      const oppStatKey = `${gameId}_${opponentNameKey}`;

      const statBlock = teamGameStatsMap[statKey] || {
        runs: 0,
        hits: 0,
        home_runs: 0,
        total_bases: 0,
        strikeouts: 0
      };

      const oppStatBlock = teamGameStatsMap[oppStatKey] || {
        runs: 0
      };

      runsScored += statBlock.runs;
      runsAllowed += oppStatBlock.runs;
      hits += statBlock.hits;
      homeRuns += statBlock.home_runs;
      totalBases += statBlock.total_bases;
      strikeouts += statBlock.strikeouts;
    });

    rows.push([
      teamNameDisplay,
      runsScored / used,
      runsAllowed / used,
      hits / used,
      homeRuns / used,
      totalBases / used,
      strikeouts / used,
      overs,
      unders,
      used
    ]);
  });

  rows.sort((a, b) => String(a[0] || "").localeCompare(String(b[0] || "")));

  clearMLBTeamTrendsSheet_(sheet);
  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);

  if (rows.length > 0) {
    sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
  }

  Logger.log(`Wrote ${rows.length} MLB team trend rows to "${sheetName}"`);
}

function clearMLBTrendsSheet_(sheet) {
  const maxRows = sheet.getMaxRows();
  const maxCols = 22; // A:V

  if (maxRows > 0) {
    sheet.getRange(1, 1, maxRows, maxCols).clearContent();
  }
}

function refreshMLBTrendsSheet() {
  const sheetName = "MLB Trends";
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    throw new Error(`Sheet "${sheetName}" not found.`);
  }

  Logger.log("Refreshing MLB Trends from recent MLB stats...");

  const headers = [
    "Player Id",
    "Player Name",
    "doubles_last5",
    "first_home_run_last5",
    "hits_last5",
    "hits_runs_rbis_last5",
    "home_runs_last5",
    "pitcher_earned_runs_last5",
    "pitcher_hits_allowed_last5",
    "pitcher_strikeouts_last5",
    "pitcher_outs_last5",
    "pitcher_record_a_win_last5",
    "pitcher_walks_last5",
    "rbis_last5",
    "runs_scored_last5",
    "singles_last5",
    "stolen_bases_last5",
    "strikeouts_last5",
    "total_bases_last5",
    "triples_last5",
    "walks_last5",
    "games_used_last5"
  ];

  const season = getCurrentMLBSeason_();
  const playerIds = getMLBPlayerIdsFromPlayerProps_();
  const playerLookup = getMLBPlayerLookupMap_();

  const rows = [];

  playerIds.forEach((playerId, index) => {
    Logger.log(`Fetching MLB recent stats for player ${index + 1}/${playerIds.length} (ID: ${playerId})`);

    let stats = [];

    try {
      stats = fetchRecentMLBStatsForPlayer_(playerId, season);
    } catch (err) {
      const message = String(err && err.message ? err.message : err);

      if (message.includes('"season"') && message.includes('invalid value')) {
        stats = fetchRecentMLBStatsForPlayer_(playerId, Number(season) - 1);
      } else {
        throw err;
      }
    }

    const sorted = stats
      .slice()
      .sort((a, b) => {
        const aDate = new Date(
          (a.game && (a.game.date || a.game.game_date)) || a.date || 0
        ).getTime();
        const bDate = new Date(
          (b.game && (b.game.date || b.game.game_date)) || b.date || 0
        ).getTime();
        return bDate - aDate;
      })
      .slice(0, 5);

    const used = sorted.length;
    if (!used) {
      Utilities.sleep(100);
      return;
    }

    const avg = (keys) =>
      sorted.reduce((sum, row) => sum + getMLBGameStatFlexible_(row, keys), 0) / used;

    const playerInfo = playerLookup[String(playerId)] || {};

    const doublesLast5 = avg(["doubles", "2b", "batting_2b"]);
    const hitsLast5 = avg(["hits", "h", "batting_h"]);
    const homeRunsLast5 = avg(["home_runs", "hr", "batting_hr"]);
    const earnedRunsLast5 = avg(["earned_runs", "er", "pitching_er"]);
    const hitsAllowedLast5 = avg(["hits_allowed", "pitching_h"]);
    const pitcherKsLast5 = avg(["strikeouts_pitched", "pitcher_strikeouts", "pitching_so"]);
    const outsLast5 = avg(["outs_recorded", "pitcher_outs", "pitching_outs"]);
    const pitcherWalksLast5 = avg(["walks_allowed", "pitcher_walks", "pitching_bb"]);
    const rbisLast5 = avg(["rbis", "rbi", "batting_rbi"]);
    const runsLast5 = avg(["runs", "runs_scored", "batting_r"]);
    const singlesLast5 = Math.max(0, hitsLast5 - doublesLast5 - avg(["triples", "3b", "batting_3b"]) - homeRunsLast5);
    const stolenBasesLast5 = avg(["stolen_bases", "sb", "batting_sb"]);
    const batterKsLast5 = avg(["strikeouts", "batting_so"]);
    const totalBasesLast5 = avg(["total_bases", "tb", "batting_tb"]);
    const triplesLast5 = avg(["triples", "3b", "batting_3b"]);
    const walksLast5 = avg(["walks", "bb", "batting_bb"]);
    const hrrLast5 = hitsLast5 + runsLast5 + rbisLast5;

    rows.push([
      playerId,                    // A
      playerInfo.playerName || "", // B
      doublesLast5,                // C
      homeRunsLast5,               // D first_home_run_last5 (proxy)
      hitsLast5,                   // E
      hrrLast5,                    // F
      homeRunsLast5,               // G
      earnedRunsLast5,             // H
      hitsAllowedLast5,            // I
      pitcherKsLast5,              // J
      outsLast5,                   // K
      0.50,                        // L pitcher_record_a_win_last5 (proxy)
      pitcherWalksLast5,           // M
      rbisLast5,                   // N
      runsLast5,                   // O
      singlesLast5,                // P
      stolenBasesLast5,            // Q
      batterKsLast5,               // R
      totalBasesLast5,             // S
      triplesLast5,                // T
      walksLast5,                  // U
      used                         // V
    ]);

    Utilities.sleep(100);
  });

  rows.sort((a, b) => {
    const nameA = (a[1] || "").toLowerCase();
    const nameB = (b[1] || "").toLowerCase();
    return nameA.localeCompare(nameB);
  });

  clearMLBTrendsSheet_(sheet);

  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);

  if (rows.length > 0) {
    sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
  }

  Logger.log(`Wrote ${rows.length} MLB trend rows to "${sheetName}"`);
}

function refreshMLBPlayerPropsSheet() {
  const sheetName = "Player Props";
  const scheduleSheetName = "Schedule";

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);
  const scheduleSheet = ss.getSheetByName(scheduleSheetName);

  if (!sheet) {
    throw new Error(`Sheet "${sheetName}" not found.`);
  }

  if (!scheduleSheet) {
    throw new Error(`Sheet "${scheduleSheetName}" not found.`);
  }

  ensurePropFormulaTemplates_(sheet);
  ensureNameFormulaTemplates_(sheet);

  Logger.log("Refreshing MLB player props using Schedule tab game IDs...");

  const games = getGamesFromScheduleSheet_(scheduleSheet);

  if (!games.length) {
    clearPlayerPropsData_(sheet);
    Logger.log("No schedule rows found, so Player Props was cleared.");
    return;
  }

  const gameMap = {};
  games.forEach(game => {
    gameMap[String(game.id)] = {
      game_date: game.game_date || "",
      away_team: game.away_team || "",
      home_team: game.home_team || ""
    };
  });

  let allRows = [];

  games.forEach((game, index) => {
    Logger.log(`Fetching props for game ${index + 1}/${games.length} (ID: ${game.id})`);

    const props = fetchAllMLBPlayerPropsForGame_(game.id);
    const gameInfo = gameMap[String(game.id)] || {};

    props.forEach(prop => {
      const playerId =
        prop.player_id ||
        (prop.player && prop.player.id) ||
        "";

      const vendor =
        prop.vendor ||
        prop.sportsbook ||
        prop.bookmaker ||
        "";

      const propType =
        prop.prop_type ||
        prop.market ||
        "";

      const lineValue =
        prop.line ||
        prop.line_value ||
        "";

      const typeValue =
        (prop.market && prop.market.type) ||
        "";

      const odds =
        (prop.market && prop.market.odds) ||
        "";

      const updatedAt =
        prop.updated_at ||
        "";

      const overOdds =
        (prop.market && prop.market.over_odds) ||
        "";

      const underOdds =
        (prop.market && prop.market.under_odds) ||
        "";

      allRows.push([
        game.id,                  // A Game Id
        gameInfo.game_date,       // B Game Date
        gameInfo.away_team,       // C Away Team
        gameInfo.home_team,       // D Home Team
        prop.id || "",            // E Id
        playerId,                 // F Player Id
        vendor,                   // G Vendor
        propType,                 // H Prop Type
        lineValue,                // I Line Value
        typeValue,                // J Type
        odds,                     // K Odds
        updatedAt,                // L Updated At
        overOdds,                 // M Over Odds
        underOdds                 // N Under Odds
      ]);
    });

    Utilities.sleep(200);
  });

  clearPlayerPropsData_(sheet);

  if (!allRows.length) {
    Logger.log("No MLB player props were returned for the schedule slate.");
    return;
  }

  sheet.getRange(3, 1, allRows.length, 14).setValues(allRows);

  copyFormulaTemplatesDown_(sheet, allRows.length);

  Logger.log(`Wrote ${allRows.length} MLB player props rows to "${sheetName}"`);
}

