/**
 * BALLDONTLIE API - Google Sheets Integration
 *
 * This script provides custom functions to fetch sports data from the BALLDONTLIE API
 * directly in Google Sheets.
 *
 * SETUP:
 * 1. Open your Google Sheet
 * 2. Go to Extensions > Apps Script
 * 3. Copy this entire script into the editor
 * 4. Run the BDL_SET_API_KEY function once to set your API key
 * 5. Use the custom functions in your spreadsheet cells
 *
 * Get your API key at: https://app.balldontlie.io
 * Documentation: https://www.balldontlie.io/docs
 */

// ============================================================================
// CONFIGURATION
// ============================================================================

const BASE_URL = 'https://api.balldontlie.io';

/**
 * Sets your BALLDONTLIE API key. Run this once from the Apps Script editor.
 * @param {string} apiKey Your API key from app.balldontlie.io
 * @customfunction
 */
function BDL_SET_API_KEY(apiKey) {
  if (!apiKey || apiKey.trim() === '') {
    throw new Error('API key cannot be empty. Get your key at app.balldontlie.io');
  }
  PropertiesService.getUserProperties().setProperty('BDL_API_KEY', apiKey.trim());
  return 'API key saved successfully!';
}

/**
 * Gets the stored API key
 * @returns {string} The API key
 */
function getApiKey_() {
  const key = PropertiesService.getUserProperties().getProperty('BDL_API_KEY');
  if (!key) {
    throw new Error('API key not set. Run BDL_SET_API_KEY("your-api-key") first.');
  }
  return key;
}

// ============================================================================
// CORE API FUNCTIONS
// ============================================================================

/**
 * Makes a request to the BALLDONTLIE API
 * @param {string} endpoint The API endpoint
 * @param {Object} params Query parameters
 * @returns {Object} API response
 */
function fetchApi_(endpoint, params = {}) {
  const apiKey = getApiKey_();

  const queryParts = [];
  for (const [key, value] of Object.entries(params)) {
    if (value !== undefined && value !== null && value !== '') {
      if (Array.isArray(value)) {
        value.forEach(v => queryParts.push(`${encodeURIComponent(key)}=${encodeURIComponent(v)}`));
      } else {
        queryParts.push(`${encodeURIComponent(key)}=${encodeURIComponent(value)}`);
      }
    }
  }

  const queryString = queryParts.length > 0 ? '?' + queryParts.join('&') : '';
  const url = BASE_URL + endpoint + queryString;

  const options = {
    method: 'get',
    headers: {
      'Authorization': apiKey
    },
    muteHttpExceptions: true
  };

  const maxAttempts = 3;

  for (let attempt = 1; attempt <= maxAttempts; attempt++) {
    try {
      const response = UrlFetchApp.fetch(url, options);
      const statusCode = response.getResponseCode();

      if (statusCode === 401) {
        throw new Error('Invalid API key. Check your key at app.balldontlie.io');
      }

      if (statusCode === 429) {
        if (attempt < maxAttempts) {
          Utilities.sleep(1500 * attempt);
          continue;
        }
        throw new Error('Rate limit exceeded. Please wait and try again.');
      }

      if (statusCode !== 200) {
        throw new Error(`API error (${statusCode}): ${response.getContentText()}`);
      }

      return JSON.parse(response.getContentText());
    } catch (err) {
      const message = String(err && err.message ? err.message : err);

      if (
        attempt < maxAttempts &&
        (
          message.includes('Address unavailable') ||
          message.includes('Exception: Address unavailable') ||
          message.includes('timed out') ||
          message.includes('Service invoked too many times')
        )
      ) {
        Logger.log(`Retrying API call (${attempt}/${maxAttempts}) for ${url}`);
        Utilities.sleep(1500 * attempt);
        continue;
      }

      throw err;
    }
  }

  throw new Error(`Failed to fetch API after ${maxAttempts} attempts: ${url}`);
}

/**
 * Converts API response data to a 2D array for spreadsheet display
 * @param {Array} data Array of objects
 * @param {Array} columns Column names to extract (optional)
 * @returns {Array} 2D array with headers
 */
function toSheet_(data, columns = null) {
  if (!data || data.length === 0) {
    return [['No data found']];
  }

  // Flatten nested objects
  const flatData = data.map(item => flattenObject_(item));

  // Get all unique keys or use specified columns
  const keys = columns || [...new Set(flatData.flatMap(obj => Object.keys(obj)))];

  // Create header row
  const header = keys.map(k => formatHeader_(k));

  // Create data rows
  const rows = flatData.map(obj => keys.map(key => {
    const val = obj[key];
    if (val === null || val === undefined) return '';
    if (typeof val === 'object') return JSON.stringify(val);
    return val;
  }));

  return [header, ...rows];
}

/**
 * Flattens nested objects with dot notation
 * @param {Object} obj Object to flatten
 * @param {string} prefix Key prefix
 * @returns {Object} Flattened object
 */
function flattenObject_(obj, prefix = '') {
  const result = {};

  for (const [key, value] of Object.entries(obj)) {
    const newKey = prefix ? `${prefix}.${key}` : key;

    if (value && typeof value === 'object' && !Array.isArray(value)) {
      Object.assign(result, flattenObject_(value, newKey));
    } else {
      result[newKey] = value;
    }
  }

  return result;
}

function normalizeMLBTeamName_(name) {
  const raw = String(name || "").trim();

  const map = {
    "Oakland Athletics": "Athletics",
    "Athletics": "Athletics",
    "LA Angels": "Los Angeles Angels",
    "LA Dodgers": "Los Angeles Dodgers",
    "D-backs": "Arizona Diamondbacks"
  };

  return (map[raw] || raw)
    .toLowerCase()
    .replace(/\./g, "")
    .replace(/\s+/g, " ")
    .trim();
}

/**
 * Formats a key as a readable header
 * @param {string} key The key to format
 * @returns {string} Formatted header
 */
function formatHeader_(key) {
  return key.split('.').pop().replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
}

/**
 * Gets today's date in YYYY-MM-DD format using the spreadsheet timezone.
 * @returns {string}
 */
function getTodayString_() {
  const tz = SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone() || Session.getScriptTimeZone();
  return Utilities.formatDate(new Date(), tz, "yyyy-MM-dd");
}

/**
 * Fetches all MLB games for a specific date, handling pagination.
 * @param {string} dateString YYYY-MM-DD
 * @returns {Array<Object>}
 */
function fetchAllMLBGamesForDate_(dateString) {
  const allGames = [];
  let cursor = null;

  do {
    const params = {
      "dates[]": dateString,
      per_page: 100
    };

    if (cursor) {
      params.cursor = cursor;
    }

    const response = fetchApi_('/mlb/v1/games', params);
    const games = Array.isArray(response.data) ? response.data : [];
    allGames.push(...games);

    cursor = response.meta && response.meta.next_cursor ? response.meta.next_cursor : null;
  } while (cursor);

  return allGames;
}

