function fetchAllMLBActivePlayersByTeam_() {
  const teams = fetchAllMLBTeams_();
  const playerMap = {};
  const teamCounts = [];

  teams.forEach((team, index) => {
    Logger.log(`Fetching MLB active players for team ${index + 1}/${teams.length}: ${getMLBTeamName_(team)} (${team.id})`);

    const teamPlayers = fetchMLBActivePlayersForTeam_(team.id);

    teamCounts.push({
      teamId: team.id,
      teamName: getMLBTeamName_(team),
      count: teamPlayers.length
    });

    teamPlayers.forEach(player => {
      if (!player.id) return;

      if (!player.team) {
        player.team = team;
      }

      playerMap[String(player.id)] = player;
    });

    Utilities.sleep(200);
  });

  teamCounts.forEach(item => {
    Logger.log(`MLB team roster count -> ${item.teamName}: ${item.count}`);
  });

  return Object.values(playerMap).sort((a, b) => {
    const aName = `${a.last_name || ""} ${a.first_name || ""}`.trim();
    const bName = `${b.last_name || ""} ${b.first_name || ""}`.trim();
    return aName.localeCompare(bName);
  });
}

function refreshMLBRostersSheet() {
  const sheetName = "Rosters";
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    throw new Error(`Sheet "${sheetName}" not found.`);
  }

  Logger.log("Refreshing MLB rosters team-by-team...");

  const players = fetchAllMLBActivePlayersByTeam_();

  const headers = [
    "Id",
    "First Name",
    "Last Name",
    "Full Name",
    "Team Id",
    "Team Name",
    "Team Abbreviation",
    "League",
    "Division",
    "Position",
    "Height",
    "Weight",
    "Jersey Number",
    "Bats",
    "Throws",
    "Draft Year",
    "Draft Round",
    "Draft Number",
    "Status"
  ];

  const rows = players.map(player => {
    const firstName = player.first_name || "";
    const lastName = player.last_name || "";
    const fullName = `${firstName} ${lastName}`.trim();

    return [
      player.id || "",                                 // A Id
      firstName,                                       // B First Name
      lastName,                                        // C Last Name
      fullName,                                        // D Full Name
      (player.team && player.team.id) || "",          // E Team Id
      getMLBTeamName_(player.team) || "",             // F Team Name
      getMLBTeamAbbreviation_(player.team) || "",     // G Team Abbreviation
      (player.team && (player.team.league || player.team.conference)) || "", // H League
      (player.team && player.team.division) || "",    // I Division
      player.position || "",                          // J Position
      player.height || "",                            // K Height
      player.weight || "",                            // L Weight
      player.jersey_number || "",                     // M Jersey Number
      player.bats || "",                              // N Bats
      player.throws || "",                            // O Throws
      player.draft_year || "",                        // P Draft Year
      player.draft_round || "",                       // Q Draft Round
      player.draft_number || "",                      // R Draft Number
      "Active"                                        // S Status
    ];
  });

  clearMLBRostersSheet_(sheet);

  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);

  if (rows.length > 0) {
    sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
  }

  Logger.log(`Wrote ${rows.length} MLB players to "${sheetName}"`);
}

