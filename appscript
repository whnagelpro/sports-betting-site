  }
}

function copyFormulaTemplatesDown_(sheet, rowCount) {
  if (!rowCount || rowCount <= 0) return;

  // Copy formulas only for O:U
  sheet.getRange("O2:U2").copyTo(
    sheet.getRange(3, 15, rowCount, 7),
    SpreadsheetApp.CopyPasteType.PASTE_FORMULA,
    false
  );

  // Copy formulas only for V:X
  sheet.getRange("V2:W2").copyTo(
    sheet.getRange(3, 22, rowCount, 3),
    SpreadsheetApp.CopyPasteType.PASTE_FORMULA,
    false
  );
}

function getMLBGameMapFromGameOdds_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Game Odds");

  if (!sheet) {
    throw new Error('Sheet "Game Odds" not found.');
  }

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return {};

  const todayDisplay = getTodayDisplayString_();

  // Read B:Z
  const values = sheet.getRange(2, 2, lastRow - 1, 25).getDisplayValues();
  const gameMap = {};

  values.forEach(row => {
    const gameId = row[0];     // B
    const gameDate = row[22];  // X
    const awayTeam = row[23];  // Y
    const homeTeam = row[24];  // Z

    if (!gameId || !gameDate) return;

    if (gameDate === todayDisplay) {
      if (!gameMap[gameId]) {
        gameMap[gameId] = {
          game_id: gameId,
          game_date: gameDate,
          away_team: awayTeam || "",
          home_team: homeTeam || ""
        };
      }
    }
  });

  return gameMap;
}

function getMLBGameIdsFromGameOdds_() {
  return Object.keys(getMLBGameMapFromGameOdds_());
}

function getMLBGameInfoFromGameOdds_(gameId) {
  const gameMap = getMLBGameMapFromGameOdds_();
  return gameMap[String(gameId)] || {
    game_date: "",
    away_team: "",
    home_team: ""
  };
}

function refreshMLBScheduleSheet() {
  const sheetName = "Schedule";
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    throw new Error(`Sheet "${sheetName}" not found.`);
  }

  const today = getTodayString_();
  const tomorrow = getTomorrowString_();
  const todayDisplay = getTodayDisplayString_();

  Logger.log(`Refreshing MLB schedule for ${today} and ${tomorrow}, then filtering to ${todayDisplay}...`);

  const todayGames = fetchAllMLBGamesForDate_(today);
  const tomorrowGames = fetchAllMLBGamesForDate_(tomorrow);

  const combinedGames = [...todayGames, ...tomorrowGames];

  // Deduplicate by game ID
  const gameMap = {};
  combinedGames.forEach(game => {
    if (game && game.id) {
      gameMap[String(game.id)] = game;
    }
  });

  // Keep only games whose ACTUAL formatted date equals today's date
  const games = Object.values(gameMap).filter(game => {
    const formattedGameDate = formatMLBDate_(game.date || game.game_date || "");
    return formattedGameDate === todayDisplay;
  });

  const headers = [
    "Game Id",
    "Game Date",
    "Away Team",
    "Home Team",
    "Status",
    "Season",
    "Postseason",
    "Start Time",
    "Home Team Id",
    "Away Team Id"
  ];

  const rows = games.map(game => {
    return [
      game.id || "",                                                       // A Game Id
      formatMLBDate_(game.date || game.game_date || today),                // B Game Date
      getMLBAwayTeamNameFromGame_(game),                                   // C Away Team
      getMLBHomeTeamNameFromGame_(game),                                   // D Home Team
      game.status || game.game_state || "",                                // E Status
      game.season || "",                                                   // F Season
      game.postseason || "",                                               // G Postseason
      game.time || game.start_time || game.date || game.game_date || "",   // H Start Time
      (game.home_team && game.home_team.id) || "",                         // I Home Team Id
      ((game.away_team && game.away_team.id) ||
        (game.visitor_team && game.visitor_team.id) ||
        "")                                                                // J Away Team Id
    ];
  });

  clearScheduleSheet_(sheet, 10);

  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);

  if (rows.length > 0) {
    sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
  }

  Logger.log(`Wrote ${rows.length} MLB games for today's slate to "${sheetName}"`);
}

function clearScheduleSheet_(sheet, columnCount) {
  const maxRows = sheet.getMaxRows();

  if (maxRows > 0) {
    sheet.getRange(1, 1, maxRows, columnCount).clearContent();
  }
}

function fetchAllMLBOddsForGameIds_(gameIds) {
  const allOdds = [];

  gameIds.forEach((gameId, index) => {
    Logger.log(`Fetching MLB odds for game ${index + 1}/${gameIds.length} (ID: ${gameId})`);

    let cursor = null;

    do {
      const params = {
        "game_ids[]": gameId,
        per_page: 100
      };

      if (cursor) {
        params.cursor = cursor;
      }

      const response = fetchApi_('/mlb/v1/odds', params);
      const odds = Array.isArray(response.data) ? response.data : [];
      allOdds.push(...odds);

      cursor = response.meta && response.meta.next_cursor
        ? response.meta.next_cursor
        : null;

    } while (cursor);

    Utilities.sleep(200);
  });

  return allOdds;
}

function copyGameOddsFormulasDown_(sheetName, formulaStartCol, formulaEndCol) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    throw new Error(`Sheet "${sheetName}" not found.`);
  }

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;

  const numCols = formulaEndCol - formulaStartCol + 1;

  // Need at least row 2 to exist as the formula template row
  const sourceRange = sheet.getRange(2, formulaStartCol, 1, numCols);

  // Clear old formulas/values below row 2 in formula area only
  if (lastRow > 2) {
    sheet.getRange(3, formulaStartCol, lastRow - 2, numCols).clearContent();
  }

  // Copy row 2 formulas down
  if (lastRow >= 3) {
    sourceRange.copyTo(
      sheet.getRange(3, formulaStartCol, lastRow - 2, numCols),
      { contentsOnly: false }
    );
  }
}

function copyGameOddsFormulaTemplatesDown_(sheetName, startCol, endCol) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    throw new Error(`Sheet "${sheetName}" not found.`);
  }

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;

  const numCols = endCol - startCol + 1;

  // Row 2 should contain your template formulas
  const sourceRange = sheet.getRange(2, startCol, 1, numCols);

  // Clear old formulas below row 2 in the formula block
  if (lastRow > 2) {
    sheet.getRange(3, startCol, lastRow - 2, numCols).clearContent();
  }

  // Copy formulas from row 2 down through the last row
  if (lastRow >= 3) {
    sourceRange.copyTo(
      sheet.getRange(3, startCol, lastRow - 2, numCols),
      SpreadsheetApp.CopyPasteType.PASTE_FORMULA,
      false
    );
  }
}

function refreshMLBGameOddsSheet() {
  const sheetName = "Game Odds";
  const scheduleSheetName = "Schedule";

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);
  const scheduleSheet = ss.getSheetByName(scheduleSheetName);

  if (!sheet) {
    throw new Error(`Sheet "${sheetName}" not found.`);
  }

  if (!scheduleSheet) {
    throw new Error(`Sheet "${scheduleSheetName}" not found.`);
  }

  ensureGameOddsFormulaTemplates_(sheet);

  Logger.log("Refreshing MLB game odds using Schedule tab game IDs...");

  const games = getMLBGamesFromScheduleSheet_(scheduleSheet);

  if (!games.length) {
    clearMLBGameOddsSheet_(sheet);
    Logger.log("No schedule rows found, so MLB Game Odds was cleared.");
    return;
  }

  const gameMap = {};
  games.forEach(game => {
    gameMap[String(game.id)] = {
      game_date: game.game_date || "",
      away_team: game.away_team || "",
      home_team: game.home_team || ""
    };
  });

  // IMPORTANT: fetch by exact schedule game IDs, not by date
  const gameIds = games.map(game => game.id).filter(Boolean);
  const odds = fetchAllMLBOddsForGameIds_(gameIds);

  const rawHeaders = [
    "Odds Id",               // A
    "Game Id",               // B
    "Vendor",                // C
    "Spread Away Value",     // D
    "Spread Away Odds",      // E
    "Spread Home Value",     // F
    "Spread Home Odds",      // G
    "Moneyline Away Odds",   // H
    "Moneyline Home Odds",   // I
    "Total Value",           // J
    "Total Over Odds",       // K
    "Total Under Odds",      // L
    "Updated At"             // M
  ];

  const formulaHeaders = [
    "EV Total Over ($1 bet)",    // N
    "EV Total Under ($1 bet)",   // O
    "Poisson Prob Total Over",   // P
    "Poisson Prob Total Under",  // Q
    "EV Away ML ($1 bet)",       // R
    "EV Home ML ($1 bet)",       // S
    "EV Away Spread ($1 bet)",   // T
    "EV Home Spread ($1 bet)",   // U
    "Game Date",                 // V
    "Away Team",                 // W
    "Home Team",                 // X
    "Implied Prob Away ML",      // Y
    "Implied Prob Home ML",      // Z
    "Vig-Free Prob Away ML",     // AA
    "Vig-Free Prob Home ML",     // AB
    "Moneyline Edge Away",       // AC
    "Moneyline Edge Home",       // AD
    "Best ML Edge"               // AE
  ];

  const rawRows = [];
  const helperRows = [];
  const seenOddsIds = new Set();

  odds.forEach(item => {
    const gameId = String(item.game_id || "");
    const gameInfo = gameMap[gameId];
    const oddsId = String(item.id || "");

    if (!gameInfo) return;

    // Prevent duplicate odds rows if API repeats any entries
    if (oddsId && seenOddsIds.has(oddsId)) return;
    if (oddsId) seenOddsIds.add(oddsId);

    rawRows.push([
      item.id || "",
      item.game_id || "",
      item.vendor || "",
      item.spread_away_value || "",
      item.spread_away_odds || "",
      item.spread_home_value || "",
      item.spread_home_odds || "",
      item.moneyline_away_odds || "",
      item.moneyline_home_odds || "",
      item.total_value || "",
      item.total_over_odds || "",
      item.total_under_odds || "",
      item.updated_at || ""
