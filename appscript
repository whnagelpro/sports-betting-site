function buildMLBTeamGameStatsMap_(statRows) {
  const map = {};

  statRows.forEach(row => {
    const gameId = String(row.game_id || "").trim();
    const teamName = normalizeMLBTeamName_(row.team_name || "");

    if (!gameId || !teamName) return;

    const key = `${gameId}_${teamName}`;

    if (!map[key]) {
      map[key] = {
        runs: 0,
        hits: 0,
        home_runs: 0,
        total_bases: 0,
        strikeouts: 0,
        rowCount: 0
      };
    }

    map[key].runs += Number(row.runs || 0);
    map[key].hits += Number(row.hits || 0);
    map[key].home_runs += Number(row.hr || 0);
    map[key].total_bases += Number(row.total_bases || 0);
    map[key].strikeouts += Number(row.k || 0);
    map[key].rowCount += 1;
  });

  const sampleKeys = Object.keys(map).slice(0, 5);
  sampleKeys.forEach(k => {
    Logger.log(`MAP SAMPLE: ${k} -> ${JSON.stringify(map[k])}`);
  });

  return map;
