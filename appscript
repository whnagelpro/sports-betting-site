function buildMLBGameAverageTotalMap_(oddsRows) {
  const totals = {};

  oddsRows.forEach(row => {
    const gameId = String(row.game_id || "");
    const totalValue = Number(row.total_value);

    if (!gameId || Number.isNaN(totalValue)) return;

    if (!totals[gameId]) {
      totals[gameId] = [];
    }

    totals[gameId].push(totalValue);
  });

  const avgMap = {};

  Object.keys(totals).forEach(gameId => {
    const arr = totals[gameId];
    const avg = arr.reduce((sum, v) => sum + v, 0) / arr.length;
    avgMap[gameId] = avg;
  });

  return avgMap;
}

