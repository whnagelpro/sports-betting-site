      [
        "Low",
        "Medium",
        "High"
      ]
    )
  );


  // ==========================================================================
  // D1.5 — EVIDENCE TEMPLATE
  // ==========================================================================

  Logger.log(
    "------------------------------------------------------------"
  );

  Logger.log(
    "P19 D1.5 — STANDARDIZED LEAGUE EVIDENCE TEMPLATE"
  );


  SPORTACULAR_P19_REQUIRED_LEAGUES.forEach(
    league => {

      const evidence =
        buildSportacularP19LeagueEvidenceTemplate_(
          league
        );


      assertP19D1(
        `${league} evidence template identifies correct league`,
        evidence.league ===
          league
      );


      assertP19D1(
        `${league} evidence starts PENDING`,
        evidence.overallStatus ===
          "PENDING"
      );


      const evidenceDomainIds =
        Object.keys(
          evidence.domains
        );


      assertP19D1(
        `${league} evidence contains all nine QA domains`,
        JSON.stringify(
          evidenceDomainIds
        ) ===
        JSON.stringify(
          expectedDomainIds
        ),
        {
          domains:
            evidenceDomainIds
        }
      );


      assertP19D1(
        `${league} cannot accidentally start with a passing domain`,
        evidenceDomainIds.every(
          domainId =>
            evidence.domains[
              domainId
            ].status ===
              "PENDING"
        )
      );

    }
  );


  // ==========================================================================
  // D1.6 — FAIL-CLOSED RELEASE BEHAVIOR
  // ==========================================================================

  Logger.log(
    "------------------------------------------------------------"
  );

  Logger.log(
    "P19 D1.6 — FAIL-CLOSED RELEASE BEHAVIOR"
  );


  const templateEvidence =
    SPORTACULAR_P19_REQUIRED_LEAGUES.map(
      league =>
        buildSportacularP19LeagueEvidenceTemplate_(
          league
        )
    );


  const templateCanRelease =
    templateEvidence.every(
      evidence =>
        evidence.overallStatus ===
          "PASS" &&
        Object.values(
          evidence.domains
        ).every(
          domain =>
            domain.status ===
              "PASS"
        )
    );


  assertP19D1(
    "P19 cannot release while production evidence is still pending",
    templateCanRelease === false,
    {
      releaseAllowed:
        templateCanRelease
    }
  );


  // ==========================================================================
  // D1 CONSOLIDATED REPORT
  // ==========================================================================

  const failedAssertions =
    assertions.filter(
      assertion =>
        assertion.pass !== true
    );


  const passedAssertions =
    assertions.length -
    failedAssertions.length;


  const blockers =
    failedAssertions.length;


  const status =
    blockers === 0
      ? "PASS"
      : "BLOCKED";


  const finishedAt =
    new Date();


  const durationMs =
    finishedAt.getTime() -
    startedAt.getTime();


  Logger.log(
    ""
  );

  Logger.log(
    "============================================================"
  );

  Logger.log(
    "SPORTACULAR V1.0 — P19 D1 CONSOLIDATED REPORT"
  );

  Logger.log(
    "============================================================"
  );


  Logger.log(
    `Required leagues: ${SPORTACULAR_P19_REQUIRED_LEAGUES.length}`
  );

  Logger.log(
    `Production QA domains: ${SPORTACULAR_P19_QA_DOMAINS.length}`
  );

  Logger.log(
    `Universal columns: ${SPORTACULAR_P19_UNIVERSAL_HEADERS.length}`
  );

  Logger.log(
    `Assertions: ${assertions.length}`
  );

  Logger.log(
    `Assertions passed: ${passedAssertions}`
  );

  Logger.log(
    `Assertions failed: ${failedAssertions.length}`
  );

  Logger.log(
    `Release blockers: ${blockers}`
  );

  Logger.log(
    `Runtime: ${durationMs} ms`
  );


  Logger.log(
    "------------------------------------------------------------"
  );


  Logger.log(
    `P19 D1 STATUS: ${status}`
  );


  if (
    status === "PASS"
  ) {

    Logger.log(
      "P19 PRODUCTION QA FRAMEWORK: FROZEN"
    );

    Logger.log(
      "READY FOR P19 D2 — LEAGUE PRODUCTION EVIDENCE"
    );

  } else {

    Logger.log(
      "P19 PRODUCTION QA FRAMEWORK: NOT READY TO FREEZE"
    );

    Logger.log(
      "DO NOT ADVANCE TO P19 D2"
    );
  }


  Logger.log(
    "============================================================"
  );


  return {

    deployment:
      "P19-D1",

    suite:
      "Four-League Production QA Framework",

    status:
      status,

    requiredLeagues:
      SPORTACULAR_P19_REQUIRED_LEAGUES.length,

    productionQADomains:
      SPORTACULAR_P19_QA_DOMAINS.length,

    universalColumns:
      SPORTACULAR_P19_UNIVERSAL_HEADERS.length,

    assertions:
      assertions.length,

    assertionsPassed:
      passedAssertions,

    assertionsFailed:
      failedAssertions.length,

    blockers:
      blockers,

    durationMs:
      durationMs,

    failedAssertions:
      failedAssertions
  };
}