  // Copy formulas only for V:X
  sheet.getRange("V2:W2").copyTo(
    sheet.getRange(3, 22, rowCount, 3),
    SpreadsheetApp.CopyPasteType.PASTE_FORMULA,
    false
  );
}

function refreshNBAActiveRostersSheet() {
