function isCompletedNBAGame_(game) {
  const status = String(game.status || "").toLowerCase();

  return (
    status.includes("final") ||
    status.includes("finished")
  );
}

function buildNBATeamGameStatsMap_(statRows) {
  const map = {};

  statRows.forEach(row => {
    const gameId = String(
      (row.game && row.game.id) ||
      row.game_id ||
      ""
    ).trim();

    const rawTeamName =
      (row.team && row.team.full_name) ||
      row.team_name ||
      "";

    const teamName = normalizeNBATeamName_(rawTeamName);

    if (!gameId || !teamName) return;

    const key = `${gameId}_${teamName}`;

    if (!map[key]) {
      map[key] = {
        points: 0,
        rebounds: 0,
        assists: 0,
        threes: 0,
        turnovers: 0,
        rowCount: 0
      };
    }

    map[key].points += Number(row.pts || 0);
    map[key].rebounds += Number(row.reb || 0);
    map[key].assists += Number(row.ast || 0);
    map[key].threes += Number(row.fg3m || 0);
    map[key].turnovers += Number(row.turnover || row.turnovers || 0);
    map[key].rowCount += 1;
  });

  const sampleKeys = Object.keys(map).slice(0, 5);
  sampleKeys.forEach(k => {
    Logger.log(`NBA MAP SAMPLE: ${k} -> ${JSON.stringify(map[k])}`);
  });

  return map;
}

