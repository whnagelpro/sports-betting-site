        prop.player_id ||
        (prop.player && prop.player.id) ||
        "";

      const vendor =
        prop.vendor ||
        prop.sportsbook ||
        prop.bookmaker ||
        "";

      const propType =
        prop.prop_type ||
        prop.market ||
        "";

      const lineValue =
        prop.line ||
        prop.line_value ||
        "";

      const typeValue =
        (prop.market && prop.market.type) ||
        "";

      const odds =
        (prop.market && prop.market.odds) ||
        "";

      const updatedAt =
        prop.updated_at ||
        "";

      const overOdds =
        (prop.market && prop.market.over_odds) ||
        "";

      const underOdds =
        (prop.market && prop.market.under_odds) ||
        "";

      allRows.push([
        game.id,                  // A Game Id
        gameInfo.game_date,       // B Game Date
        gameInfo.away_team,       // C Away Team
        gameInfo.home_team,       // D Home Team
        prop.id || "",            // E Id
        playerId,                 // F Player Id
        vendor,                   // G Vendor
        propType,                 // H Prop Type
        lineValue,                // I Line Value
        typeValue,                // J Type
        odds,                     // K Odds
        updatedAt,                // L Updated At
        overOdds,                 // M Over Odds
        underOdds                 // N Under Odds
      ]);
    });

    Utilities.sleep(200);
  });

  clearPlayerPropsData_(sheet);

  if (!allRows.length) {
    Logger.log("No NBA player props were returned for the schedule slate.");
    return;
  }

  sheet.getRange(3, 1, allRows.length, 14).setValues(allRows);

  copyFormulaTemplatesDown_(sheet, allRows.length);

  Logger.log(`Wrote ${allRows.length} NBA player props rows to "${sheetName}"`);
}

