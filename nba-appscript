// ============================================================================
// NBA PLAYER PROP PROJECTION WEIGHT BACKTEST
// P4/18
//
// READ-ONLY with respect to production data.
// Reads:  NBA Player Game Logs
// Writes: NBA Projection Backtest
//
// Method:
// - Groups historical games by player.
// - Sorts each player's games chronologically.
// - Requires at least 10 PRIOR games before making a prediction.
// - Season average uses ALL prior games.
// - Recent average uses the previous 5 games.
// - Tests Season/Recent weights from 100/0 through 0/100 in 5% steps.
// - Evaluates MAE and RMSE independently for each supported NBA prop market.
// ============================================================================

function backtestNBAProjectionWeights() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const logSheet =
    ss.getSheetByName("NBA Player Game Logs");

  if (!logSheet) {
    throw new Error(
      'Missing required sheet: "NBA Player Game Logs".'
    );
  }

  const logs =
    getNBAObjectsFromSheet_(logSheet);

  if (!logs.length) {
    throw new Error(
      "NBA Player Game Logs contains no historical data."
    );
  }

  const markets = [
    {
      market: "Points",
      key: "points"
    },
    {
      market: "Rebounds",
      key: "rebounds"
    },
    {
      market: "Assists",
      key: "assists"
    },
    {
      market: "Threes",
      key: "threes"
    },
    {
      market: "Steals",
      key: "steals"
    },
    {
      market: "Blocks",
      key: "blocks"
    },
    {
      market: "Turnovers",
      key: "turnovers"
    },
    {
      market: "Points + Rebounds",
      key: "pointsRebounds"
    },
    {
      market: "Points + Assists",
      key: "pointsAssists"
    },
    {
      market: "Rebounds + Assists",
      key: "reboundsAssists"
    },
    {
      market: "PRA",
      key: "pra"
    },
    {
      market: "Blocks + Steals",
      key: "blocksSteals"
    }
  ];

  const MIN_PRIOR_GAMES = 10;
  const RECENT_GAMES = 5;

  // --------------------------------------------------------------------------
  // Build player histories
  // --------------------------------------------------------------------------

  const players = {};

  logs.forEach(row => {
    const playerId =
      String(row["Player ID"] || "").trim();

    if (!playerId) return;

    const date =
      new Date(row["Game Date"]);

    if (
      !date ||
      Number.isNaN(date.getTime())
    ) {
      return;
    }

    const points =
      Number(row["Points"] || 0);

    const rebounds =
      Number(row["Rebounds"] || 0);

    const assists =
      Number(row["Assists"] || 0);

    const steals =
      Number(row["Steals"] || 0);

    const blocks =
      Number(row["Blocks"] || 0);

    if (!players[playerId]) {
      players[playerId] = {
        playerId,
        playerName:
          row["Player Name"] || "",
        games: []
      };
    }

    players[playerId].games.push({
      date,

      points,
      rebounds,
      assists,

      threes:
        Number(row["Threes"] || 0),

      steals,
      blocks,

      turnovers:
        Number(row["Turnovers"] || 0),

      pointsRebounds:
        points + rebounds,

      pointsAssists:
        points + assists,

      reboundsAssists:
        rebounds + assists,

      pra:
        points + rebounds + assists,

      blocksSteals:
        blocks + steals
    });
  });

  // --------------------------------------------------------------------------
  // Sort each player's games OLDEST -> NEWEST
  // --------------------------------------------------------------------------

  Object.values(players).forEach(player => {
    player.games.sort(
      (a, b) =>
        a.date.getTime() -
        b.date.getTime()
    );
  });

  // --------------------------------------------------------------------------
  // Weight grid
  // --------------------------------------------------------------------------

  const weightPairs = [];

  for (
    let recentPct = 0;
    recentPct <= 100;
    recentPct += 5
  ) {
    weightPairs.push({
      seasonWeight:
        (100 - recentPct) / 100,

      recentWeight:
        recentPct / 100
    });
  }

  // --------------------------------------------------------------------------
  // Prepare result accumulators
  // --------------------------------------------------------------------------

  const results = {};

  markets.forEach(market => {
    results[market.key] = {};

    weightPairs.forEach(pair => {
      const key =
        `${pair.seasonWeight.toFixed(2)}|` +
        `${pair.recentWeight.toFixed(2)}`;

      results[market.key][key] = {
        market: market.market,
        seasonWeight:
          pair.seasonWeight,
        recentWeight:
          pair.recentWeight,
        count: 0,
        absoluteErrorSum: 0,
        squaredErrorSum: 0
      };
    });
  });

  // --------------------------------------------------------------------------
  // Chronological walk-forward backtest
  // --------------------------------------------------------------------------

  Object.values(players).forEach(player => {
    const games = player.games;

    if (
      games.length <= MIN_PRIOR_GAMES
    ) {
      return;
    }

    for (
      let targetIndex = MIN_PRIOR_GAMES;
      targetIndex < games.length;
      targetIndex++
    ) {
      const priorGames =
        games.slice(0, targetIndex);

      const recentGames =
        priorGames.slice(-RECENT_GAMES);

      const targetGame =
        games[targetIndex];

      markets.forEach(market => {
        const seasonValues =
          priorGames.map(
            game =>
              Number(game[market.key] || 0)
          );

        const recentValues =
          recentGames.map(
            game =>
              Number(game[market.key] || 0)
          );

        const actual =
          Number(
            targetGame[market.key] || 0
          );

        const seasonAverage =
          avgNBA_(seasonValues);

        const recentAverage =
          avgNBA_(recentValues);

        weightPairs.forEach(pair => {
          const projection =
            seasonAverage *
              pair.seasonWeight +
            recentAverage *
              pair.recentWeight;

          const error =
            projection - actual;

          const key =
            `${pair.seasonWeight.toFixed(2)}|` +
            `${pair.recentWeight.toFixed(2)}`;

          const result =
            results[market.key][key];

          result.count++;

          result.absoluteErrorSum +=
            Math.abs(error);

          result.squaredErrorSum +=
            error * error;
        });
      });
    }
  });

  // --------------------------------------------------------------------------
  // Calculate MAE / RMSE
  // --------------------------------------------------------------------------

  const detailRows = [];

  markets.forEach(market => {
    Object.values(
      results[market.key]
    ).forEach(result => {
      if (!result.count) return;

      const mae =
        result.absoluteErrorSum /
        result.count;

      const rmse =
        Math.sqrt(
          result.squaredErrorSum /
          result.count
        );

      detailRows.push({
        market:
          result.market,

        seasonWeight:
          result.seasonWeight,

        recentWeight:
          result.recentWeight,

        sampleSize:
          result.count,

        mae,
        rmse
      });
    });
  });

  if (!detailRows.length) {
    throw new Error(
      "NBA projection backtest produced no predictions."
    );
  }

  // --------------------------------------------------------------------------
  // Determine winners by market
  // --------------------------------------------------------------------------

  const summaryRows = [];

  markets.forEach(market => {
    const marketRows =
      detailRows.filter(
        row =>
          row.market === market.market
      );

    if (!marketRows.length) return;

    const bestMAE =
      marketRows
        .slice()
        .sort(
          (a, b) =>
            a.mae - b.mae ||
            a.recentWeight -
              b.recentWeight
        )[0];

    const bestRMSE =
      marketRows
        .slice()
        .sort(
          (a, b) =>
            a.rmse - b.rmse ||
            a.recentWeight -
              b.recentWeight
        )[0];

    const seasonOnly =
      marketRows.find(
        row =>
          row.recentWeight === 0
      );

    summaryRows.push([
      market.market,

      bestMAE.sampleSize,

      bestMAE.seasonWeight,
      bestMAE.recentWeight,
      bestMAE.mae,

      bestRMSE.seasonWeight,
      bestRMSE.recentWeight,
      bestRMSE.rmse,

      seasonOnly
        ? seasonOnly.mae
        : "",

      seasonOnly
        ? seasonOnly.rmse
        : "",

      seasonOnly
        ? (
            (
              seasonOnly.mae -
              bestMAE.mae
            ) /
            seasonOnly.mae
          )
        : "",

      seasonOnly
        ? (
            (
              seasonOnly.rmse -
              bestRMSE.rmse
            ) /
            seasonOnly.rmse
          )
        : ""
    ]);
  });

  // --------------------------------------------------------------------------
  // Create / refresh output sheet
  // --------------------------------------------------------------------------

  const SHEET_NAME =
    "NBA Projection Backtest";

  let outputSheet =
    ss.getSheetByName(SHEET_NAME);

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(SHEET_NAME);
  } else {
    outputSheet.clearContents();
  }

  const summaryHeaders = [
    "Market",
    "Predictions",
    "Best MAE Season Weight",
    "Best MAE Recent Weight",
    "Best MAE",
    "Best RMSE Season Weight",
    "Best RMSE Recent Weight",
    "Best RMSE",
    "Season-Only MAE",
    "Season-Only RMSE",
    "MAE Improvement vs Season",
    "RMSE Improvement vs Season"
  ];

  outputSheet
    .getRange(
      1,
      1,
      1,
      summaryHeaders.length
    )
    .setValues([summaryHeaders]);

  if (summaryRows.length) {
    outputSheet
      .getRange(
        2,
        1,
        summaryRows.length,
        summaryHeaders.length
      )
      .setValues(summaryRows);
  }

  // --------------------------------------------------------------------------
  // Detailed grid underneath summary
  // --------------------------------------------------------------------------

  const detailStartRow =
    summaryRows.length + 4;

  const detailHeaders = [
    "Market",
    "Season Weight",
    "Recent Weight",
    "Predictions",
    "MAE",
    "RMSE"
  ];

  outputSheet
    .getRange(
      detailStartRow,
      1,
      1,
      detailHeaders.length
    )
    .setValues([detailHeaders]);

  const detailValues =
    detailRows
      .sort((a, b) => {
        const marketCompare =
          a.market.localeCompare(
            b.market
          );

        if (marketCompare !== 0) {
          return marketCompare;
        }

        return (
          b.seasonWeight -
          a.seasonWeight
        );
      })
      .map(row => [
        row.market,
        row.seasonWeight,
        row.recentWeight,
        row.sampleSize,
        row.mae,
        row.rmse
      ]);

  outputSheet
    .getRange(
      detailStartRow + 1,
      1,
      detailValues.length,
      detailHeaders.length
    )
    .setValues(detailValues);

  // --------------------------------------------------------------------------
  // Formatting
  // --------------------------------------------------------------------------

  outputSheet
    .getRange(
      2,
      3,
      summaryRows.length,
      2
    )
    .setNumberFormat("0%");

  outputSheet
    .getRange(
      2,
      6,
      summaryRows.length,
      2
    )
    .setNumberFormat("0%");

  outputSheet
    .getRange(
      2,
      11,
      summaryRows.length,
      2
    )
    .setNumberFormat("0.00%");

  if (detailValues.length) {
    outputSheet
      .getRange(
        detailStartRow + 1,
        2,
        detailValues.length,
        2
      )
      .setNumberFormat("0%");
  }

  outputSheet.setFrozenRows(1);
  outputSheet.autoResizeColumns(
    1,
    summaryHeaders.length
  );

  Logger.log(
    `NBA projection backtest complete: ` +
    `${summaryRows.length} markets evaluated.`
  );
}

