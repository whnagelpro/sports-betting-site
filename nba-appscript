      };
    }

    players[playerId].games.push({
      date,

      points,
      rebounds,
      assists,

      threes:
        Number(
          row["Threes"] || 0
        ),

      steals,
      blocks,

      turnovers:
        Number(
          row["Turnovers"] || 0
        ),

      pointsRebounds:
        points + rebounds,

      pointsAssists:
        points + assists,

      reboundsAssists:
        rebounds + assists,

      pra:
        points +
        rebounds +
        assists,

      blocksSteals:
        blocks + steals
    });
  });

  // --------------------------------------------------------------------------
  // Sort oldest -> newest
  // --------------------------------------------------------------------------

  Object.values(players)
    .forEach(player => {
      player.games.sort(
        (a, b) =>
          a.date.getTime() -
          b.date.getTime()
      );
    });

  // --------------------------------------------------------------------------
  // Accumulators
  // --------------------------------------------------------------------------

  const results = {};

  markets.forEach(market => {
    results[market.key] = {
      season: createNBAHoldoutAccumulator_(),
      maeCandidate:
        createNBAHoldoutAccumulator_(),
      rmseCandidate:
        createNBAHoldoutAccumulator_()
    };
  });

  // --------------------------------------------------------------------------
  // Walk forward through untouched final 25%
  // --------------------------------------------------------------------------

  Object.values(players)
    .forEach(player => {
      const games = player.games;

      if (
        games.length <=
        MIN_PRIOR_GAMES
      ) {
        return;
      }

      const holdoutStart =
        Math.max(
          MIN_PRIOR_GAMES,
          Math.floor(
            games.length * 0.75
          )
        );

      for (
        let targetIndex =
          holdoutStart;

        targetIndex <
          games.length;

        targetIndex++
      ) {
        const priorGames =
          games.slice(
            0,
            targetIndex
          );

        if (
          priorGames.length <
          MIN_PRIOR_GAMES
        ) {
          continue;
        }

        const recentGames =
          priorGames.slice(
            -RECENT_GAMES
          );

        const targetGame =
          games[targetIndex];

        markets.forEach(
          market => {
            const seasonValues =
              priorGames.map(
                game =>
                  Number(
                    game[
                      market.key
                    ] || 0
                  )
              );

            const recentValues =
              recentGames.map(
                game =>
                  Number(
                    game[
                      market.key
                    ] || 0
                  )
              );

            const seasonAverage =
              avgNBA_(
                seasonValues
              );

            const recentAverage =
              avgNBA_(
                recentValues
              );

            const actual =
              Number(
                targetGame[
                  market.key
                ] || 0
              );

            // Season-only baseline
            addNBAHoldoutError_(
              results[
                market.key
              ].season,
              seasonAverage,
              actual
            );

            // Best-MAE candidate
            const maeProjection =
              seasonAverage *
                (
                  1 -
                  market.maeRecent
                ) +
              recentAverage *
                market.maeRecent;

            addNBAHoldoutError_(
              results[
                market.key
              ].maeCandidate,
              maeProjection,
              actual
            );

            // Best-RMSE candidate
            const rmseProjection =
              seasonAverage *
                (
                  1 -
                  market.rmseRecent
                ) +
              recentAverage *
                market.rmseRecent;

            addNBAHoldoutError_(
              results[
                market.key
              ].rmseCandidate,
              rmseProjection,
              actual
            );
          }
        );
      }
    });

  // --------------------------------------------------------------------------
  // Build output
  // --------------------------------------------------------------------------

  const outputRows = [];

  markets.forEach(market => {
    const marketResults =
      results[market.key];

    const season =
      finalizeNBAHoldoutAccumulator_(
        marketResults.season
      );

    const maeCandidate =
      finalizeNBAHoldoutAccumulator_(
        marketResults.maeCandidate
      );

    const rmseCandidate =
      finalizeNBAHoldoutAccumulator_(
        marketResults.rmseCandidate
      );

    const maeImprovement =
      season.mae > 0
        ? (
            season.mae -
            maeCandidate.mae
          ) / season.mae
        : "";

    const maeCandidateRMSEImprovement =
      season.rmse > 0
        ? (
            season.rmse -
            maeCandidate.rmse
          ) / season.rmse
        : "";

    const rmseCandidateMAEImprovement =
      season.mae > 0
        ? (
            season.mae -
            rmseCandidate.mae
          ) / season.mae
        : "";

    const rmseImprovement =
      season.rmse > 0
        ? (
            season.rmse -
            rmseCandidate.rmse
          ) / season.rmse
        : "";

    outputRows.push([
      market.market,

      season.count,

      season.mae,
      season.rmse,

      1 - market.maeRecent,
      market.maeRecent,
      maeCandidate.mae,
      maeCandidate.rmse,
      maeImprovement,
      maeCandidateRMSEImprovement,

      1 - market.rmseRecent,
      market.rmseRecent,
      rmseCandidate.mae,
      rmseCandidate.rmse,
      rmseCandidateMAEImprovement,
      rmseImprovement,

      (
        maeImprovement > 0 &&
        maeCandidateRMSEImprovement > 0
      )
        ? "PASS"
        : "FAIL",

      (
        rmseCandidateMAEImprovement > 0 &&
        rmseImprovement > 0
      )
        ? "PASS"
        : "FAIL"
    ]);
  });

  // --------------------------------------------------------------------------
  // Output sheet
  // --------------------------------------------------------------------------

  const SHEET_NAME =
    "NBA Projection Holdout";

  let outputSheet =
    ss.getSheetByName(
      SHEET_NAME
    );

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(
        SHEET_NAME
      );
  } else {
    outputSheet.clearContents();
  }

  const headers = [
    "Market",
    "Holdout Predictions",

    "Season-Only MAE",
    "Season-Only RMSE",

    "MAE Candidate Season Weight",
    "MAE Candidate Recent Weight",
    "MAE Candidate MAE",
    "MAE Candidate RMSE",
    "MAE Candidate MAE Improvement",
    "MAE Candidate RMSE Improvement",

    "RMSE Candidate Season Weight",
    "RMSE Candidate Recent Weight",
    "RMSE Candidate MAE",
    "RMSE Candidate RMSE",
    "RMSE Candidate MAE Improvement",
    "RMSE Candidate RMSE Improvement",

    "MAE Candidate Verdict",
    "RMSE Candidate Verdict"
  ];

  outputSheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([headers]);

  outputSheet
    .getRange(
      2,
      1,
      outputRows.length,
      headers.length
    )
    .setValues(outputRows);

  // Weight columns
  outputSheet
    .getRange(
      2,
      5,
      outputRows.length,
      2
    )
    .setNumberFormat("0%");

  outputSheet
    .getRange(
      2,
      11,
      outputRows.length,
      2
    )
    .setNumberFormat("0%");

  // Improvement columns
  outputSheet
    .getRange(
      2,
      9,
      outputRows.length,
      2
    )
    .setNumberFormat("0.00%");

  outputSheet
    .getRange(
      2,
      15,
      outputRows.length,
      2
    )
    .setNumberFormat("0.00%");

  outputSheet.setFrozenRows(1);

  outputSheet.autoResizeColumns(
    1,
    headers.length
  );

  Logger.log(
    "NBA projection holdout validation complete."
  );
}


// ============================================================================
// P4 HOLDOUT HELPERS
// ============================================================================

function createNBAHoldoutAccumulator_() {
  return {
    count: 0,
    absoluteErrorSum: 0,
    squaredErrorSum: 0
  };
}


function addNBAHoldoutError_(
  accumulator,
  projection,
  actual
) {
  const error =
    projection - actual;

  accumulator.count++;

  accumulator.absoluteErrorSum +=
    Math.abs(error);

  accumulator.squaredErrorSum +=
    error * error;
}


function finalizeNBAHoldoutAccumulator_(
  accumulator
) {
  if (!accumulator.count) {
    return {
      count: 0,
      mae: 0,
      rmse: 0
    };
  }

  return {
    count:
      accumulator.count,

    mae:
      accumulator.absoluteErrorSum /
      accumulator.count,

    rmse:
      Math.sqrt(
        accumulator.squaredErrorSum /
        accumulator.count
      )
  };
}

