function copyGameOddsFormulaBlockDown_(sheetName, startCol, endCol) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    throw new Error(`Sheet "${sheetName}" not found.`);
  }

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;

  const numCols = endCol - startCol + 1;
  const templateRange = sheet.getRange(2, startCol, 1, numCols);

  // Clear old formulas below row 2 in the formula block only
  if (lastRow > 2) {
    sheet.getRange(3, startCol, lastRow - 2, numCols).clearContent();
  }

  // Copy row 2 formulas down
  if (lastRow >= 3) {
    templateRange.copyTo(
      sheet.getRange(3, startCol, lastRow - 2, numCols),
      SpreadsheetApp.CopyPasteType.PASTE_FORMULA,
      false
    );
  }
}

function refreshNBAGameOddsSheet() {
  const sheetName = "Game Odds";
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    throw new Error(`Sheet "${sheetName}" not found.`);
  }

  ensureGameOddsFormulaTemplates_(sheet);

  const today = getTodayString_();
  Logger.log(`Refreshing NBA game odds for ${today}...`);

  const games = fetchAllNBAGamesForDate_(today);
  const odds = fetchAllNBAOddsForDate_(today);

  const gameMap = {};
  games.forEach(game => {
    gameMap[String(game.id)] = {
      game_date: game.date || today,
      away_team: (game.visitor_team && game.visitor_team.full_name) || "",
      home_team: (game.home_team && game.home_team.full_name) || ""
    };
  });

  const rawHeaders = [
    "Odds Id",               // A
    "Game Id",               // B
    "Vendor",                // C
    "Spread Away Value",     // D
    "Spread Away Odds",      // E
    "Spread Home Value",     // F
    "Spread Home Odds",      // G
    "Moneyline Away Odds",   // H
    "Moneyline Home Odds",   // I
    "Total Value",           // J
    "Total Over Odds",       // K
    "Total Under Odds",      // L
    "Updated At"             // M
  ];

  const formulaHeaders = [
    "EV Total Over ($1 bet)",    // N
    "EV Total Under ($1 bet)",   // O
    "Poisson Prob Total Over",   // P
    "Poisson Prob Total Under",  // Q
    "EV Away ML ($1 bet)",       // R
    "EV Home ML ($1 bet)",       // S
    "EV Away Spread ($1 bet)",   // T
    "EV Home Spread ($1 bet)",   // U
    "Game Date",                 // V
    "Away Team",                 // W
    "Home Team",                 // X
    "Implied Prob Away ML",      // Y
    "Implied Prob Home ML",      // Z
    "Vig-Free Prob Away ML",     // AA
    "Vig-Free Prob Home ML",     // AB
    "Moneyline Edge Away",       // AC
    "Moneyline Edge Home",       // AD
    "Best ML Edge"               // AE
  ];

  const rawRows = [];
  const helperRows = [];

  odds.forEach(item => {
    const gameId = String(item.game_id || "");
    const gameInfo = gameMap[gameId] || {
      game_date: today,
      away_team: "",
      home_team: ""
    };

    rawRows.push([
      item.id || "",
      item.game_id || "",
      item.vendor || "",
      item.spread_away_value || "",
      item.spread_away_odds || "",
      item.spread_home_value || "",
      item.spread_home_odds || "",
      item.moneyline_away_odds || "",
      item.moneyline_home_odds || "",
      item.total_value || "",
      item.total_over_odds || "",
      item.total_under_odds || "",
      item.updated_at || ""
    ]);

    helperRows.push([
      gameInfo.game_date || "",   // V
      gameInfo.away_team || "",   // W
      gameInfo.home_team || ""    // X
    ]);
  });

  clearNBAGameOddsSheet_(sheet);
  formatGameOddsModelColumns_(sheet);

  // A:M
  sheet.getRange(1, 1, 1, rawHeaders.length).setValues([rawHeaders]);

  // N:AE
  sheet.getRange(1, 14, 1, formulaHeaders.length).setValues([formulaHeaders]);

  if (!rawRows.length) {
    Logger.log(`No NBA odds rows returned for ${today}`);
    return;
  }

  // Raw data A:M from row 3 down
  sheet.getRange(3, 1, rawRows.length, 13).setValues(rawRows);

  // Helper values V:X from row 3 down
  sheet.getRange(3, 22, helperRows.length, 3).setValues(helperRows);

  // Copy formula block N:AE from row 2 down
  copyGameOddsFormulaBlockDown_("Game Odds", 14, 31);

  Logger.log(`Wrote ${rawRows.length} NBA game odds rows to "${sheetName}"`);
}

