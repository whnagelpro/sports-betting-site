function buildNBAPlayerPropsTrendIndex_() {

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();


  const sheet =
    ss.getSheetByName(
      "NBA Player Trends"
    );


  if (!sheet) {
    return {};
  }


  const rows =
    getNBAObjectsFromSheet_(
      sheet
    );


  const index = {};


  rows.forEach(row => {

    const playerId =
      String(
        row["Player ID"] ?? ""
      ).trim();


    const statType =
      String(
        row["Stat Type"] ?? ""
      ).trim();


    if (
      !playerId ||
      !statType
    ) {
      return;
    }


    Object.keys(
      NBA_PROP_TREND_LABELS
    ).forEach(marketKey => {

      if (
        NBA_PROP_TREND_LABELS[
          marketKey
        ] !==
        statType
      ) {
        return;
      }


      index[
        `${playerId}::${marketKey}`
      ] = {

        trendScore:
          parseNBANumberOrNull_(
            row["Trend Score"]
          ),

        trendStrength:
          row["Trend Strength"] ??
          null,

        modelConfidence:
          calculateTrendConfidence_(
            row
          )
      };
    });
  });


  return index;
}


/**
 * Attach validated NBA trend/confidence fields to one frozen Q:T context.
 */
function enrichNBAPlayerPropContextWithTrend_(
  context,
  playerId,
  marketKey,
  trendIndex
) {

  if (!context) {
    return null;
  }


  const trend =
    (
      trendIndex &&
      trendIndex[
        `${playerId}::${marketKey}`
      ]
    ) ||
    null;


  return Object.assign(
    {},
    context,
    {

      trendScore:
        trend
          ? trend.trendScore
          : null,

      trendStrength:
        trend
          ? trend.trendStrength
          : null,

      modelConfidence:
        trend
          ? trend.modelConfidence
          : null
    }
  );
}

/**
 * ============================================================================
 * P15 D7D — NBA UNIVERSAL PLAYER PROPS PRODUCTION REFRESH
 * ============================================================================
 *
 * Direct A:AJ output.
 *
 * Removes the old:
 *   - row-2 formula-template dependency
 *   - row-3 production start
 *   - A:N-only production write
 *
 * Production rows now begin at row 2.
 * ============================================================================
 */
function refreshNBAPlayerPropsSheet() {

  const sheetName =
    "Player Props";


  const scheduleSheetName =
    "Schedule";


  const ss =
    SpreadsheetApp.getActiveSpreadsheet();


  const sheet =
    ss.getSheetByName(
      sheetName
    );


  const scheduleSheet =
    ss.getSheetByName(
      scheduleSheetName
    );


  if (!sheet) {
    throw new Error(
      `Sheet "${sheetName}" not found.`
    );
  }


  if (!scheduleSheet) {
    throw new Error(
      `Sheet "${scheduleSheetName}" not found.`
    );
  }


  Logger.log(
    "Refreshing NBA player props using universal A:AJ production output..."
  );


  // ==========================================================================
  // ENSURE PHYSICAL A:AJ WIDTH
  // ==========================================================================

  const requiredColumns =
    NBA_UNIVERSAL_PROP_HEADERS.length;


  if (
    sheet.getMaxColumns() <
    requiredColumns
  ) {

    sheet.insertColumnsAfter(
      sheet.getMaxColumns(),
      requiredColumns -
      sheet.getMaxColumns()
    );
  }


  // ==========================================================================
  // WRITE EXACT UNIVERSAL HEADERS
  // ==========================================================================

  sheet
    .getRange(
      1,
      1,
      1,
      requiredColumns
    )
    .setValues([
      NBA_UNIVERSAL_PROP_HEADERS
    ]);


  // ==========================================================================
  // CLEAR OLD PRODUCTION + LEGACY ROW-2 FORMULAS
  // ==========================================================================

  const maxRows =
    sheet.getMaxRows();


  if (
    maxRows >= 2
  ) {

    sheet
      .getRange(
        2,
        1,
        maxRows - 1,
        requiredColumns
      )
      .clearContent();
  }


  // ==========================================================================
  // SCHEDULE
  // ==========================================================================

  const games =
    getGamesFromScheduleSheet_(
      scheduleSheet
    );


  if (!games.length) {

    Logger.log(
      "No schedule rows found. NBA Player Props now contains universal A:AJ headers with no stale prop rows."
    );

    return;
  }


  // ==========================================================================
  // BUILD FROZEN HISTORICAL + TREND CONTEXT ONCE
  // ==========================================================================

  Logger.log(
    "Building NBA Player Props historical and trend context indexes..."
  );


  const contextMap =
    buildNBAPlayerPropContextMap_();


  const trendIndex =
    buildNBAPlayerPropsTrendIndex_();


  Logger.log(
    "NBA Player Props universal context indexes built."
  );


  // ==========================================================================
  // FETCH + BUILD UNIVERSAL ROWS
  // ==========================================================================

  const allRows = [];


  games.forEach(
    (game, index) => {

      Logger.log(
        `Fetching NBA props for game ${index + 1}/${games.length} (ID: ${game.id})`
      );


      const props =
        fetchAllNBAPlayerPropsForGame_(
          game.id
        );


      props.forEach(prop => {

        const market =
          (
            prop.market &&
            typeof prop.market ===
              "object"
          )
            ? prop.market
            : {};


        const playerId =
          String(
            prop.player_id ??
            (
              prop.player &&
              prop.player.id
            ) ??
            ""
          ).trim();


        const propType =
          String(
            prop.prop_type ??
            (
              typeof prop.market ===
                "string"
                ? prop.market
                : ""
            ) ??
            ""
          ).trim();


        const marketKey =
          normalizeNBAPropMarket_(
            propType
          );


        const rawContext =
          (
            playerId &&
            marketKey &&
            contextMap[
              playerId
            ]
          )
            ? contextMap[
                playerId
              ][
                marketKey
              ] ||
              null
            : null;


        const context =
          enrichNBAPlayerPropContextWithTrend_(
            rawContext,
            playerId,
            marketKey,
            trendIndex
          );


        const rawProp = {

          gameId:
            game.id ?? "",

          gameDate:
            game.game_date ?? "",

          awayTeam:
            game.away_team ?? "",

          homeTeam:
            game.home_team ?? "",

          id:
            prop.id ?? "",

          playerId,

          vendor:
            prop.vendor ??
            prop.sportsbook ??
            prop.bookmaker ??
            "",

          propType,

          lineValue:
            prop.line ??
            prop.line_value ??
            "",

          type:
            market.type ??
            "",

          odds:
            market.odds ??
            "",

          updatedAt:
            prop.updated_at ??
            "",

          overOdds:
            market.over_odds ??
            "",

          underOdds:
            market.under_odds ??
            ""
        };


        const row =
          buildNBAUniversalPropRowFromProvider_(
            rawProp,
            context
          );


        if (
          !Array.isArray(row) ||
          row.length !==
            requiredColumns
        ) {

          throw new Error(
            `Invalid NBA universal Player Props row for player ${playerId || "UNKNOWN"}.`
          );
        }


        allRows.push(
          row
        );
      });


      Utilities.sleep(
        200
      );
    }
  );


  // ==========================================================================
  // NO PROVIDER PROPS
  // ==========================================================================

  if (
    !allRows.length
  ) {

    Logger.log(
      "No NBA player props were returned for the schedule slate. Universal A:AJ headers remain with no stale rows."
    );

    return;
  }


  // ==========================================================================
  // WRITE DIRECT A:AJ VALUES STARTING ROW 2
  // ==========================================================================

  sheet
    .getRange(
      2,
      1,
      allRows.length,
      requiredColumns
    )
    .setValues(
      allRows
    );


  Logger.log(
    `Wrote ${allRows.length} NBA universal Player Props rows to "${sheetName}" across A:AJ.`
  );
}

