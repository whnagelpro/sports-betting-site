function writeNBAOutputSheet_(sheet, headers, rows) {
  sheet.clearContents();

  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);

  if (rows.length > 0) {
    sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
  }

  sheet.autoResizeColumns(1, headers.length);
}

function getNBAObjectsFromSheet_(sheet) {
  const values = sheet.getDataRange().getValues();

  if (values.length < 2) return [];

  const headers = values[0];

  return values.slice(1).map(row => {
    const obj = {};

    headers.forEach((header, index) => {
      obj[header] = row[index];
    });

    return obj;
  });
}

function avgNBA_(values) {
  const nums = values
    .map(Number)
    .filter(value => !Number.isNaN(value));

  if (!nums.length) return 0;

  return nums.reduce((sum, value) => sum + value, 0) / nums.length;
}

function stdDevNBA_(values) {
  const nums = values
    .map(Number)
    .filter(value => !Number.isNaN(value));

  if (nums.length < 2) return 0;

  const mean = avgNBA_(nums);
  const variance = avgNBA_(nums.map(value => Math.pow(value - mean, 2)));

  return Math.sqrt(variance);
}

function consistencyScoreNBA_(values) {
  const mean = avgNBA_(values);

  if (!mean) return 0;

  const cv = stdDevNBA_(values) / mean;

  return Math.max(0, Math.min(100, 100 - cv * 100));
}

function trendScoreNBA_(recentAvg, seasonAvg) {
  if (!seasonAvg) return 0;

  return ((recentAvg - seasonAvg) / seasonAvg) * 100;
}

function trendDirectionNBA_(score) {
  if (score >= 7.5) return "Up";
  if (score <= -7.5) return "Down";

  return "Flat";
}

function riskTierNBA_(consistency, absTrendScore) {
  if (consistency >= 75 && absTrendScore <= 20) return "Low";
  if (consistency >= 55) return "Medium";

  return "High";
}

function parseNBAMinutes_(value) {
  if (value === null || value === undefined || value === "") return 0;

  const str = String(value);

  if (str.includes(":")) {
    const parts = str.split(":");
    const minutes = Number(parts[0] || 0);
    const seconds = Number(parts[1] || 0);

    return minutes + seconds / 60;
  }

  const num = Number(value);

  return Number.isNaN(num) ? 0 : num;
}

function getNBAOpponentFromStat_(stat) {
  const game = stat.game || {};
  const team = stat.team || {};

  const teamId = String(team.id || "");
  const homeTeamId = String((game.home_team && game.home_team.id) || "");
  const awayTeamId = String((game.visitor_team && game.visitor_team.id) || "");

  if (teamId && teamId === homeTeamId) {
    return (game.visitor_team && game.visitor_team.full_name) || "";
  }

  if (teamId && teamId === awayTeamId) {
    return (game.home_team && game.home_team.full_name) || "";
  }

  return "";
}

function getNBAPlayerIdsForTrendPipeline_() {
  const propIds = getNBAPlayerIdsFromPlayerProps_();

  if (propIds.length > 0) {
    return propIds;
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const rosterSheet = ss.getSheetByName("Rosters");

  if (!rosterSheet) return [];

  const lastRow = rosterSheet.getLastRow();
  if (lastRow < 2) return [];

  const values = rosterSheet.getRange(2, 1, lastRow - 1, 1).getValues();

  return values
    .map(row => row[0])
    .filter(id => id !== "" && id !== null && id !== undefined)
    .map(id => String(id));
}

