function populateNBATeamMetricRanks_(sheet) {

  const data = sheet.getDataRange().getValues();

  if (data.length < 2) return;

  const header = data[0];

  const teamCol = header.indexOf("Team");
  const metricCol = header.indexOf("Metric");
  const seasonAvgCol = header.indexOf("Season Avg");
  const leagueRankCol = header.indexOf("League Rank");
  const rankScoreCol = header.indexOf("Rank Score");

  if (
    teamCol === -1 ||
    metricCol === -1 ||
    seasonAvgCol === -1 ||
    leagueRankCol === -1 ||
    rankScoreCol === -1
  ) {
    return;
  }

  const lowerIsBetter = new Set([
    "Points Allowed",
    "Turnovers"
  ]);

  const grouped = {};

  for (let i = 1; i < data.length; i++) {

    const metric = String(
      data[i][metricCol] || ""
    ).trim();

    const value = Number(
      data[i][seasonAvgCol]
    );

    if (!metric || Number.isNaN(value)) {
      continue;
    }

    if (!grouped[metric]) {
      grouped[metric] = [];
    }

    grouped[metric].push({
      rowIndex: i,
      value
    });
  }

  Object.keys(grouped).forEach(metric => {

    const metricRows = grouped[metric];

    metricRows.sort((a, b) => {

      if (lowerIsBetter.has(metric)) {
        return a.value - b.value;
      }

      return b.value - a.value;
    });

    const teamCount = metricRows.length;

    metricRows.forEach((item, index) => {

      const rank = index + 1;

      let rankScore = 100;

      if (teamCount > 1) {
        rankScore =
          100 *
          (
            1 -
            (rank - 1) /
            (teamCount - 1)
          );
      }

      data[item.rowIndex][leagueRankCol] =
        rank;

      data[item.rowIndex][rankScoreCol] =
        Number(rankScore.toFixed(1));
    });
  });

  sheet
    .getRange(
      2,
      leagueRankCol + 1,
      data.length - 1,
      2
    )
    .setValues(
      data
        .slice(1)
        .map(row => [
          row[leagueRankCol],
          row[rankScoreCol]
        ])
    );
}

function populateNBATeamRatings_(sheet) {

  const data = sheet.getDataRange().getValues();

  if (data.length < 2) return;

  const header = data[0];

  const teamCol =
    header.indexOf("Team");

  const metricCol =
    header.indexOf("Metric");

  const rankScoreCol =
    header.indexOf("Rank Score");

  const offensiveCol =
    header.indexOf("Offensive Rating");

  const defensiveCol =
    header.indexOf("Defensive Rating");

  const overallCol =
    header.indexOf("Overall Rating");

  const tierCol =
    header.indexOf("Rating Tier");

  const notesCol =
    header.indexOf("Rating Notes");

  if (
    teamCol === -1 ||
    metricCol === -1 ||
    rankScoreCol === -1 ||
    offensiveCol === -1 ||
    defensiveCol === -1 ||
    overallCol === -1 ||
    tierCol === -1 ||
    notesCol === -1
  ) {
    return;
  }

  const teams = {};

  for (let i = 1; i < data.length; i++) {

    const team =
      String(data[i][teamCol] || "").trim();

    const metric =
      String(data[i][metricCol] || "").trim();

    const rankScore =
      Number(data[i][rankScoreCol]);

    if (
      !team ||
      !metric ||
      Number.isNaN(rankScore)
    ) {
      continue;
    }

    if (!teams[team]) {
      teams[team] = {};
    }

    teams[team][metric] = rankScore;
  }

  const ratings = {};

  Object.keys(teams).forEach(team => {

    const metrics = teams[team];

    const offenseValues = [
      metrics["Points For"],
      metrics["Assists"],
      metrics["Threes"]
    ].filter(value => Number.isFinite(value));

    const defenseValues = [
      metrics["Points Allowed"],
      metrics["Rebounds"],
      metrics["Turnovers"]
    ].filter(value => Number.isFinite(value));

    const offense =
      offenseValues.length
        ? offenseValues.reduce(
            (sum, value) => sum + value,
            0
          ) / offenseValues.length
        : 0;

    const defense =
      defenseValues.length
        ? defenseValues.reduce(
            (sum, value) => sum + value,
            0
          ) / defenseValues.length
        : 0;

    const overall =
      offense * 0.60 +
      defense * 0.40;

    let tier = "";

    if (overall >= 90) {
      tier = "Elite";
    } else if (overall >= 75) {
      tier = "Strong";
    } else if (overall >= 55) {
      tier = "Average";
    } else if (overall >= 40) {
      tier = "Below Average";
    } else {
      tier = "Weak";
    }

    let notes =
      "Balanced team profile.";

    if (offense > defense + 20) {
      notes =
        "Offense carrying the team.";
    } else if (defense > offense + 20) {
      notes =
        "Defense carrying the team.";
    }

    ratings[team] = {
      offense:
        Number(offense.toFixed(1)),

      defense:
        Number(defense.toFixed(1)),

      overall:
        Number(overall.toFixed(1)),

      tier,
      notes
    };
  });

  for (let i = 1; i < data.length; i++) {

    const team =
      String(data[i][teamCol] || "").trim();

    const rating = ratings[team];

    if (!rating) continue;

    data[i][offensiveCol] =
      rating.offense;

    data[i][defensiveCol] =
      rating.defense;

    data[i][overallCol] =
      rating.overall;

    data[i][tierCol] =
      rating.tier;

    data[i][notesCol] =
      rating.notes;
  }

  sheet
    .getRange(
      2,
      offensiveCol + 1,
      data.length - 1,
      5
    )
    .setValues(
      data
        .slice(1)
        .map(row => [
          row[offensiveCol],
          row[defensiveCol],
          row[overallCol],
          row[tierCol],
          row[notesCol]
        ])
    );
}

function hitRateNBA_(values, threshold) {
  const nums = values
    .map(Number)
    .filter(value => !Number.isNaN(value));

  if (!nums.length) return 0;

  const hits = nums.filter(value => value >= threshold).length;

  return hits / nums.length;
}

function aboveSeasonPctNBA_(recentAvg, seasonAvg) {
  if (!seasonAvg) return 0;

  return ((recentAvg - seasonAvg) / seasonAvg) * 100;
}

function formatPercentNBA_(value) {
  const num = Number(value);

  if (Number.isNaN(num)) return "0%";

  return `${Math.round(num * 100)}%`;
}

function formatSignedPercentNBA_(value) {
  const num = Number(value);

  if (Number.isNaN(num)) return "0%";

  return num >= 0 ? `+${num.toFixed(1)}%` : `${num.toFixed(1)}%`;
}

function trendStrengthNBA_(hitRate, aboveSeasonPct, trendScore) {
  const hr = Number(hitRate);
  const above = Number(aboveSeasonPct);
  const score = Number(trendScore);

  if (Number.isNaN(hr) || Number.isNaN(above) || Number.isNaN(score)) {
    return "Unknown";
  }

  if (hr >= 0.80 && above >= 20 && score >= 15) {
    return "Elite Trend";
  }

  if (hr >= 0.70 && above >= 10 && score >= 7.5) {
    return "Strong Trend";
  }

  if (hr >= 0.60 && score >= 0) {
    return "Moderate Trend";
  }

  if (score < -10 || above < -10) {
    return "Cold Trend";
  }

  return "Weak Trend";
}

function buildNBAPlayerTrendNote_(playerName, statLabel, seasonAvg, last5, hitRateLast5, trendScore) {
  const safeName = playerName || "This player";
  const safeStat = statLabel || "this stat";

  const last5Text = Number(last5).toFixed(2);
  const seasonText = Number(seasonAvg).toFixed(2);
  const hitRateText = formatPercentNBA_(hitRateLast5);
  const trendText = formatSignedPercentNBA_(trendScore);

  if (trendScore >= 15) {
    return `${safeName} is trending up in ${safeStat}, averaging ${last5Text} over the last 5 compared to ${seasonText} on the season (${trendText}), with a 1+ hit rate of ${hitRateText}.`;
  }

  if (trendScore <= -15) {
    return `${safeName} is trending down in ${safeStat}, averaging ${last5Text} over the last 5 compared to ${seasonText} on the season (${trendText}), with a 1+ hit rate of ${hitRateText}.`;
  }

  return `${safeName} is holding steady in ${safeStat}, averaging ${last5Text} over the last 5 compared to ${seasonText} on the season, with a 1+ hit rate of ${hitRateText}.`;
}

function buildNBATeamTrendNote_(teamName, metricLabel, seasonAvg, last5, hitRateLast5, trendScore) {
  const team = `The ${teamName || "team"}`;
  const metric = metricLabel || "this metric";

  const last5Text = Number(last5).toFixed(2);
  const seasonText = Number(seasonAvg).toFixed(2);
  const hitRateText = formatPercentNBA_(hitRateLast5);
  const trendText = formatSignedPercentNBA_(trendScore);

  if (trendScore >= 15) {
    return `${team} are trending up in ${metric}, averaging ${last5Text} over the last 5 games compared to ${seasonText} on the season (${trendText}), with a 1+ hit rate of ${hitRateText}.`;
  }

  if (trendScore <= -15) {
    return `${team} are trending down in ${metric}, averaging ${last5Text} over the last 5 games compared to ${seasonText} on the season (${trendText}), with a 1+ hit rate of ${hitRateText}.`;
  }

  return `${team} are holding steady in ${metric}, averaging ${last5Text} over the last 5 games compared to ${seasonText} on the season, with a 1+ hit rate of ${hitRateText}.`;
}

function strengthRank_(strength) {
  const value = String(strength || "").toLowerCase();
  if (value.includes("elite")) return 100;
  if (value.includes("strong")) return 80;
  if (value.includes("moderate")) return 60;
  if (value.includes("weak")) return 35;
  if (value.includes("cold")) return 15;
  return 0;
}

function clampScore_(value, min, max) {
  return Math.max(min, Math.min(max, value));
}

function calculateTrendConfidence_(row) {
  const strengthScore = strengthRank_(row["Trend Strength"]);
  const hitRate = Number(row["Hit Rate Last 5"] || 0) * 100;
  const trendScore = clampScore_(Number(row["Trend Score"] || 0), -50, 50);
  const consistency = clampScore_(Number(row["Consistency"] || 0), 0, 100);
  const aboveSeason = clampScore_(Number(row["Above Season %"] || 0), -50, 50);
  const last5 = Number(row["Last 5 Avg"] || 0);
  const seasonAvg = Number(row["Season Avg"] || 0);

  const recentForm = seasonAvg > 0
    ? clampScore_((last5 / seasonAvg) * 50, 0, 100)
    : 0;

  return Math.round(clampScore_(
    strengthScore * 0.35 +
    hitRate * 0.25 +
    (trendScore + 50) * 0.15 +
    consistency * 0.10 +
    (aboveSeason + 50) * 0.10 +
    recentForm * 0.05,
    0,
    100
  ));
}

