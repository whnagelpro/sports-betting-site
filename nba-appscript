  Logger.log(
    "NBA prop context audit complete: " +
    rows.length +
    " player-market rows."
  );
}

// ============================================================================
// NBA LIVE PLAYER PROP INTEGRATION AUDIT
// P7/18
//
// READ-ONLY with respect to production Player Props.
//
// Reads:
// - Player Props
// - NBA Player Game Logs through buildNBAPlayerPropContextMap_()
//
// Writes:
// - NBA Live Prop Audit
//
// Purpose:
// - Verify actual provider market names and Type values.
// - Join live props to historical player context.
// - Calculate raw + calibrated probabilities.
// - Calculate EV and price edge when usable prices exist.
// - Preserve unsupported / missing data as null.
// ============================================================================

function auditNBALivePropIntegration() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const propSheet =
    ss.getSheetByName(
      "Player Props"
    );

  if (!propSheet) {
    throw new Error(
      'Missing required sheet: "Player Props".'
    );
  }

  const lastRow =
    propSheet.getLastRow();

  if (lastRow < 2) {
    throw new Error(
      "Player Props contains no prop rows."
    );
  }

  const contextMap =
    buildNBAPlayerPropContextMap_();

  // Current production raw schema:
  //
  // A Game Id
  // B Game Date
  // C Away Team
  // D Home Team
  // E Id
  // F Player Id
  // G Vendor
  // H Prop Type
  // I Line Value
  // J Type
  // K Odds
  // L Updated At
  // M Over Odds
  // N Under Odds

  const propRows =
    propSheet
      .getRange(
        2,
        1,
        lastRow - 1,
        14
      )
      .getValues();

  const outputRows = [];

  propRows.forEach(row => {

    // Skip completely empty/non-prop rows.
    //
    // A valid production prop should have at least
    // a Game Id, Player Id, Prop Type, or Line Value.
    const hasPropData =
      row[0] !== "" ||
      row[5] !== "" ||
      row[7] !== "" ||
      row[8] !== "";

    if (!hasPropData) {
      return;
    }
    const gameId =
      row[0];

    const playerId =
      String(
        row[5] || ""
      ).trim();

    const vendor =
      row[6];

    const rawPropType =
      row[7];

    const lineRaw =
      row[8];

    const type =
      String(
        row[9] || ""
      )
        .trim()
        .toLowerCase();

    const generalOdds =
      parseNBAAmericanOdds_(
        row[10]
      );

    const overOdds =
      parseNBAAmericanOdds_(
        row[12]
      );

    const underOdds =
      parseNBAAmericanOdds_(
        row[13]
      );

    const marketKey =
      normalizeNBAPropMarket_(
        rawPropType
      );

    const line =
      parseNBANumberOrNull_(
        lineRaw
      );

    const playerContext =
      playerId &&
      contextMap[playerId]
        ? contextMap[playerId]
        : null;

    const context =
      playerContext &&
      marketKey
        ? playerContext[
            marketKey
          ] || null
        : null;

    let rawOverProbability =
      null;

    let rawUnderProbability =
      null;

    let calibratedOverProbability =
      null;

    let calibratedUnderProbability =
      null;

    let evOver =
      null;

    let evUnder =
      null;

    let overPriceEdge =
      null;

    let underPriceEdge =
      null;

    let status = "";

    // ------------------------------------------------------------------------
    // Determine whether this row is modelable.
    // ------------------------------------------------------------------------

    if (!marketKey) {
      status =
        "UNSUPPORTED MARKET";
    } else if (!playerId) {
      status =
        "MISSING PLAYER ID";
    } else if (!context) {
      status =
        "NO PLAYER CONTEXT";
    } else if (line === null) {
      status =
        "MISSING LINE";
    } else if (
      context.projection === null ||
      context.projection === undefined ||
      !Number.isFinite(
        Number(
          context.projection
        )
      )
    ) {
      status =
        "MISSING PROJECTION";
    } else {

      const probabilities =
        calculateNBAPropProbabilities_(
          marketKey,
          context.projection,
          context.statStdDev,
          line
        );

      rawOverProbability =
        probabilities.over;

      rawUnderProbability =
        probabilities.under;

      if (
        rawOverProbability !== null
      ) {
        calibratedOverProbability =
          applyNBAPropCalibration_(
            marketKey,
            rawOverProbability
          );
      }

      if (
        rawUnderProbability !== null
      ) {
        calibratedUnderProbability =
          applyNBAPropCalibration_(
            marketKey,
            rawUnderProbability
          );
      }

      // ----------------------------------------------------------------------
      // Price interpretation
      //
      // Conventional over_under:
      //   M = Over Odds
      //   N = Under Odds
      //
      // Milestone / one-sided:
      //   K = general Odds for the offered threshold.
      //
      // We are NOT forcing unknown Type values into either category.
      // ----------------------------------------------------------------------

      if (
        type === "over_under"
      ) {
        if (
          calibratedOverProbability !== null &&
          overOdds !== null
        ) {
          evOver =
            calculateNBAExpectedValue_(
              calibratedOverProbability,
              overOdds
            );

          overPriceEdge =
            calculateNBAPriceEdge_(
              calibratedOverProbability,
              overOdds
            );
        }

        if (
          calibratedUnderProbability !== null &&
          underOdds !== null
        ) {
          evUnder =
            calculateNBAExpectedValue_(
              calibratedUnderProbability,
              underOdds
            );

          underPriceEdge =
            calculateNBAPriceEdge_(
              calibratedUnderProbability,
              underOdds
            );
        }

        status =
          (
            overOdds !== null ||
            underOdds !== null
          )
            ? "MODELED OVER_UNDER"
            : "MODELED - MISSING SIDE ODDS";

      } else if (
        type === "milestone"
      ) {

        // IMPORTANT:
        // This is only an audit interpretation.
        //
        // We retain the calculated raw probability in the output,
        // but P7 does NOT yet declare ordinary Over probability to
        // be the correct milestone threshold probability.
        //
        // Actual milestone semantics will be frozen after inspecting
        // these live rows.

        if (
          calibratedOverProbability !== null &&
          generalOdds !== null
        ) {
          evOver =
            calculateNBAExpectedValue_(
              calibratedOverProbability,
              generalOdds
            );

          overPriceEdge =
            calculateNBAPriceEdge_(
              calibratedOverProbability,
              generalOdds
            );
        }

        status =
          "MILESTONE - REVIEW SEMANTICS";

      } else {
        status =
          type
            ? "UNKNOWN TYPE: " +
              type
            : "MISSING TYPE";
      }
    }

    outputRows.push([
      gameId,                         // A
      playerId,                       // B
      context
        ? context.playerName
        : "",                         // C
      context
        ? context.team
        : "",                         // D
      vendor,                         // E
      rawPropType,                    // F
      marketKey || "",                // G
      type,                           // H
      line === null
        ? ""
        : line,                       // I
      generalOdds === null
        ? ""
        : generalOdds,                // J
      overOdds === null
        ? ""
        : overOdds,                   // K
      underOdds === null
        ? ""
        : underOdds,                  // L
      context
        ? context.gamesPlayed
        : "",                         // M
      context
        ? context.baseline
        : "",                         // N
      context
        ? context.recentAverage
        : "",                         // O
      context
        ? context.trendAdjustment
        : "",                         // P
      context
        ? context.projection
        : "",                         // Q
      context
        ? context.statStdDev
        : "",                         // R
      rawOverProbability,             // S
      rawUnderProbability,            // T
      calibratedOverProbability,      // U
      calibratedUnderProbability,     // V
      evOver,                         // W
      evUnder,                        // X
      overPriceEdge,                  // Y
      underPriceEdge,                 // Z
      status                          // AA
    ]);
  });

  const sheetName =
    "NBA Live Prop Audit";

  let outputSheet =
    ss.getSheetByName(
      sheetName
    );

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(
        sheetName
      );
  } else {
    outputSheet.clearContents();
  }

  const headers = [
    "Game Id",
    "Player Id",
    "Player Name",
    "Team",
    "Vendor",
    "Raw Prop Type",
    "Normalized Market",
    "Type",
    "Line",
    "General Odds",
    "Over Odds",
    "Under Odds",
    "Games",
    "Player Baseline",
    "Recent 5 Average",
    "Trend Adjustment",
    "Projected Stat",
    "Stat Std Dev",
    "Raw Prob Over",
    "Raw Prob Under",
    "Calibrated Prob Over",
    "Calibrated Prob Under",
    "EV Over",
    "EV Under",
    "Price Edge Over",
    "Price Edge Under",
    "Status"
  ];

  outputSheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([
      headers
    ]);

  if (outputRows.length) {
    outputSheet
      .getRange(
        2,
        1,
        outputRows.length,
        headers.length
      )
      .setValues(
        outputRows
      );

    // Probability / price-edge columns.
    outputSheet
      .getRange(
        2,
        19,
        outputRows.length,
        4
      )
      .setNumberFormat(
        "0.0000%"
      );

    outputSheet
      .getRange(
        2,
        25,
        outputRows.length,
        2
      )
      .setNumberFormat(
