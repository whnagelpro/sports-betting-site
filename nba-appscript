/**
 * ============================================================================
 * P15 D7D — NBA UNIVERSAL PRODUCTION ROW FROM PROVIDER
 * ============================================================================
 *
 * Preserves the frozen P4-P7 NBA model.
 *
 * Q:T   historical/projection context
 * U:X   calibrated probability + EV
 * Z:AB  strongest-side decision fields
 *
 * P15 owns final:
 * Y     actionable Best Side
 * AE    Risk Score
 * AF    Risk Tier
 * AH    Sportacular Score
 * AI    Sportacular Edge
 * AJ    Confidence Tier
 *
 * AC:AD and AG remain unavailable here unless validated NBA trend/confidence
 * data is supplied. Missing stays missing.
 * ============================================================================
 */
function buildNBAUniversalPropRowFromProvider_(
  rawProp,
  context
) {

  const safeProp =
    rawProp || {};

  const safeContext =
    context || null;


  const marketKey =
    normalizeNBAPropMarket_(
      safeProp.propType
    );


  // --------------------------------------------------------------------------
  // Q:T — FROZEN NBA HISTORICAL / PROJECTION CONTEXT
  // --------------------------------------------------------------------------

  const playerBaseline =
    safeContext
      ? parseNBANumberOrNull_(
          safeContext.baseline
        )
      : null;


  const trendAdjustment =
    safeContext
      ? parseNBANumberOrNull_(
          safeContext.trendAdjustment
        )
      : null;


  const projectedStat =
    safeContext
      ? parseNBANumberOrNull_(
          safeContext.projection
        )
      : null;


  const statStdDev =
    safeContext
      ? parseNBANumberOrNull_(
          safeContext.statStdDev
        )
      : null;


  const lineValue =
    parseNBANumberOrNull_(
      safeProp.lineValue
    );


  const type =
    String(
      safeProp.type ?? ""
    )
      .trim()
      .toLowerCase();


  // --------------------------------------------------------------------------
  // U:V — FROZEN NBA PROBABILITY ENGINE
  //
  // P7 live acceptance for integer/push and milestone semantics remains
  // deferred. Therefore production probability pricing is limited here to
  // conventional over_under rows.
  // --------------------------------------------------------------------------

  let modelProbOver =
    null;

  let modelProbUnder =
    null;


  if (
    type === "over_under" &&
    marketKey &&
    projectedStat !== null &&
    lineValue !== null
  ) {

    const rawProbabilities =
      calculateNBAPropProbabilities_(
        marketKey,
        projectedStat,
        statStdDev,
        lineValue
      );


    if (
      rawProbabilities.over !== null &&
      rawProbabilities.under !== null
    ) {

      const shrink =
        NBA_PROP_CALIBRATION_SHRINK[
          marketKey
        ] ?? 0;


      modelProbOver =
        0.5 +
        (
          rawProbabilities.over -
          0.5
        ) *
        (
          1 -
          shrink
        );


      modelProbUnder =
        0.5 +
        (
          rawProbabilities.under -
          0.5
        ) *
        (
          1 -
          shrink
        );


      modelProbOver =
        clampNBAProbability_(
          modelProbOver
        );


      modelProbUnder =
        clampNBAProbability_(
          modelProbUnder
        );
    }
  }


  // --------------------------------------------------------------------------
  // W:X — EV
  // --------------------------------------------------------------------------

  const overOdds =
    parseNBAAmericanOdds_(
      safeProp.overOdds
    );


  const underOdds =
    parseNBAAmericanOdds_(
      safeProp.underOdds
    );


  const evOver =
    (
      modelProbOver !== null &&
      overOdds !== null
    )
      ? calculateNBAExpectedValue_(
          modelProbOver,
          overOdds
        )
      : null;


  const evUnder =
    (
      modelProbUnder !== null &&
      underOdds !== null
    )
      ? calculateNBAExpectedValue_(
          modelProbUnder,
          underOdds
        )
      : null;


  // --------------------------------------------------------------------------
  // PRE-P15 STRONGEST AVAILABLE SIDE
  // --------------------------------------------------------------------------

  let candidateSide =
    null;

  let bestEV =
    null;

  let bestModelProbability =
    null;

  let bestPriceEdge =
    null;


  if (
    evOver !== null ||
    evUnder !== null
  ) {

    if (
      evOver !== null &&
      (
        evUnder === null ||
        evOver > evUnder
      )
    ) {

      candidateSide =
        "Over";

      bestEV =
        evOver;

      bestModelProbability =
        modelProbOver;

      bestPriceEdge =
        calculateNBAPriceEdge_(
          modelProbOver,
          overOdds
        );

    } else if (
      evUnder !== null &&
      (
        evOver === null ||
        evUnder > evOver
      )
    ) {

      candidateSide =
        "Under";

      bestEV =
        evUnder;

      bestModelProbability =
        modelProbUnder;

      bestPriceEdge =
        calculateNBAPriceEdge_(
          modelProbUnder,
          underOdds
        );
    }
  }


  // --------------------------------------------------------------------------
  // NBA TREND / CONFIDENCE
  //
  // Do not manufacture unavailable fields.
  // --------------------------------------------------------------------------

  const trendScore =
    safeContext
      ? parseNBANumberOrNull_(
          safeContext.trendScore
        )
      : null;


  const trendStrength =
    safeContext &&
    safeContext.trendStrength !== null &&
    safeContext.trendStrength !== undefined &&
    safeContext.trendStrength !== ""
      ? safeContext.trendStrength
      : null;


  const modelConfidence =
    safeContext
      ? parseNBANumberOrNull_(
          safeContext.modelConfidence
        )
      : null;


  // --------------------------------------------------------------------------
  // P15 UNIVERSAL SCORING
  // --------------------------------------------------------------------------

  const sportacularScoring =
    buildUniversalSportacularScoring_({

      lineValue,

      projectedStat,

      statStdDev,

      evOver,

      evUnder,

      bestModelProbability,

      bestPriceEdge,

      trendScore,

      modelConfidence
    });


  // --------------------------------------------------------------------------
  // FINAL A:AJ CONTEXT
  // --------------------------------------------------------------------------

  const universalContext = {

    playerName:
      safeContext
        ? safeContext.playerName ?? ""
        : "",

    team:
      safeContext
        ? safeContext.team ?? ""
        : "",


    // Q:T
    baseline:
      playerBaseline,

    trendAdjustment,

    projection:
      projectedStat,

    statStdDev,


    // U:X
    modelProbOver,

    modelProbUnder,

    evOver,

    evUnder,


    // Y — P15 FINAL SIDE
    bestSide:
      sportacularScoring.finalBestSide,


    // Z:AD
    bestEV,

    bestModelProbability,

    bestPriceEdge,

    trendScore,

    trendStrength,


    // AE:AF — P15
    riskScore:
      sportacularScoring.riskScore,

    riskTier:
      sportacularScoring.riskTier,


    // AG
    modelConfidence,


    // AH:AJ — P15
    sportacularScore:
      sportacularScoring.sportacularScore,

    sportacularEdge:
      sportacularScoring.sportacularEdge,

    confidenceTier:
      sportacularScoring.confidenceTier
  };


  const row =
    buildNBAUniversalPropRow_(
      safeProp,
      universalContext
    );


  if (
    row.length !==
    NBA_UNIVERSAL_PROP_HEADERS.length
  ) {
    throw new Error(
      `Invalid NBA universal Player Props row width. Expected ${NBA_UNIVERSAL_PROP_HEADERS.length}, received ${row.length}.`
    );
  }


  return row;
}

