// ============================================================================
// NBA PROP PROBABILITY ENGINE
// P5/18
//
// Pure calculation helpers.
// No sheet writes.
// No production Player Props changes.
//
// Normal:
//   Points, Rebounds, Assists and combination markets.
//
// Poisson:
//   Threes, Steals, Blocks, Turnovers, Blocks + Steals.
// ============================================================================

const NBA_PROP_DISTRIBUTIONS = {
  points: "normal",
  rebounds: "normal",
  assists: "normal",

  threes: "poisson",
  steals: "poisson",
  blocks: "poisson",
  turnovers: "poisson",

  points_rebounds: "normal",
  points_assists: "normal",
  rebounds_assists: "normal",
  points_rebounds_assists: "normal",

  blocks_steals: "poisson"
};

const NBA_PROP_CALIBRATION_SHRINK = {
  points: 0.00,
  rebounds: 0.20,
  assists: 0.25,
  threes: 0.00,
  steals: 0.00,
  blocks: 0.00,
  turnovers: 0.15,
  points_rebounds: 0.00,
  points_assists: 0.00,
  rebounds_assists: 0.00,
  points_rebounds_assists: 0.00,
  blocks_steals: 0.00
};

// ============================================================================
// UNIVERSAL NBA PROBABILITY ENTRY POINT
// ============================================================================

function calculateNBAPropProbabilities_(
  marketKey,
  projection,
  statStdDev,
  line
) {
  const distribution =
    NBA_PROP_DISTRIBUTIONS[marketKey];

  const projectedValue =
    Number(projection);

  const lineValue =
    Number(line);

  if (
    !distribution ||
    !Number.isFinite(projectedValue) ||
    !Number.isFinite(lineValue) ||
    projectedValue < 0
  ) {
    return {
      over: null,
      under: null,
      distribution: null
    };
  }

  if (distribution === "normal") {
    const sd =
      Number(statStdDev);

    if (
      !Number.isFinite(sd) ||
      sd <= 0
    ) {
      return {
        over: null,
        under: null,
        distribution
      };
    }

    return calculateNBANormalProbabilities_(
      projectedValue,
      sd,
      lineValue
    );
  }

  if (distribution === "poisson") {
    return calculateNBAPoissonProbabilities_(
      projectedValue,
      lineValue
    );
  }

  return {
    over: null,
    under: null,
    distribution: null
  };
}


// ============================================================================
// NORMAL DISTRIBUTION
// ============================================================================

function calculateNBANormalProbabilities_(
  mean,
  stdDev,
  line
) {
  if (
    !Number.isFinite(mean) ||
    !Number.isFinite(stdDev) ||
    !Number.isFinite(line) ||
    stdDev <= 0
  ) {
    return {
      over: null,
      under: null,
      distribution: "normal"
    };
  }

  const z =
    (line - mean) / stdDev;

  const under =
    normalCDFNBA_(z);

  const over =
    1 - under;

  return {
    over:
      clampNBAProbability_(over),

    under:
      clampNBAProbability_(under),

    distribution: "normal"
  };
}


// ============================================================================
// NORMAL CDF
// Abramowitz-Stegun style approximation.
// ============================================================================

function normalCDFNBA_(z) {
  const sign =
    z < 0 ? -1 : 1;

  const x =
    Math.abs(z) /
    Math.sqrt(2);

  const t =
    1 /
    (
      1 +
      0.3275911 * x
    );

  const a1 =
    0.254829592;

  const a2 =
    -0.284496736;

  const a3 =
    1.421413741;

  const a4 =
    -1.453152027;

  const a5 =
    1.061405429;

  const erf =
    1 -
    (
      (
        (
          (
            (
              a5 * t +
              a4
            ) * t +
            a3
          ) * t +
          a2
        ) * t +
        a1
      ) *
      t *
      Math.exp(
        -x * x
      )
    );

  return (
    0.5 *
    (
      1 +
      sign * erf
    )
  );
}


// ============================================================================
// POISSON DISTRIBUTION
//
// Handles standard NBA half-point lines:
// 2.5 threes -> Over = P(X >= 3)
// 0.5 blocks -> Over = P(X >= 1)
// etc.
// ============================================================================

function calculateNBAPoissonProbabilities_(
  lambda,
  line
) {
  if (
    !Number.isFinite(lambda) ||
    !Number.isFinite(line) ||
    lambda < 0
  ) {
    return {
      over: null,
      under: null,
      distribution: "poisson"
    };
  }

  const threshold =
    Math.floor(line);

  const under =
    poissonCDFNBA_(
      threshold,
      lambda
    );

  const over =
    1 - under;

  return {
    over:
      clampNBAProbability_(over),

    under:
      clampNBAProbability_(under),

    distribution: "poisson"
  };
}


// ============================================================================
// POISSON CDF
// P(X <= k)
// ============================================================================

function poissonCDFNBA_(
  k,
  lambda
) {
  if (k < 0) {
    return 0;
  }

  if (lambda === 0) {
    return 1;
  }

  let probability =
    Math.exp(-lambda);

  let cumulative =
    probability;

  for (
    let i = 1;
    i <= k;
    i++
  ) {
    probability *=
      lambda / i;

    cumulative +=
      probability;
  }

  return Math.min(
    1,
    Math.max(
      0,
      cumulative
    )
  );
}


// ============================================================================
// PROBABILITY SAFETY
//
// IMPORTANT:
// This clamp is numerical protection only.
// It is NOT calibration.
// P6 handles actual probability calibration.
// ============================================================================

function clampNBAProbability_(
  probability
) {
  if (
    probability === null ||
    probability === undefined ||
    !Number.isFinite(
      Number(probability)
    )
  ) {
    return null;
  }

  return Math.min(
    0.999,
    Math.max(
      0.001,
      Number(probability)
    )
  );
}


// ============================================================================
// AMERICAN ODDS -> IMPLIED PROBABILITY
// ============================================================================

function americanOddsToNBAImpliedProbability_(
  odds
) {
  const value =
    Number(odds);

  if (
    !Number.isFinite(value) ||
    value === 0
  ) {
    return null;
  }

  if (value > 0) {
    return (
      100 /
      (value + 100)
    );
  }

  return (
    Math.abs(value) /
    (
      Math.abs(value) +
      100
    )
  );
}


// ============================================================================
// AMERICAN ODDS -> PROFIT PER $1
//
// +150 => 1.50 profit
// -120 => 0.833333 profit
// ============================================================================

function americanOddsToNBAProfitPerDollar_(
  odds
) {
  const value =
    Number(odds);

  if (
    !Number.isFinite(value) ||
    value === 0
  ) {
    return null;
  }

  if (value > 0) {
    return value / 100;
  }

  return (
    100 /
    Math.abs(value)
  );
}


// ============================================================================
// EXPECTED VALUE PER $1
//
// EV = P(win) * profit_if_win
//      - P(loss) * 1
//
// Equivalent to:
// EV = P * (profit + 1) - 1
// ============================================================================

function calculateNBAExpectedValue_(
  probability,
  americanOdds
) {
  const p =
    Number(probability);

  const profit =
    americanOddsToNBAProfitPerDollar_(
      americanOdds
    );

  if (
    !Number.isFinite(p) ||
    p < 0 ||
    p > 1 ||
    profit === null
  ) {
    return null;
  }

  return (
    p * profit -
    (1 - p)
  );
}


// ============================================================================
// PRICE EDGE
//
// Model probability minus sportsbook implied probability.
// Distinct from EV.
// ============================================================================

function calculateNBAPriceEdge_(
  probability,
  americanOdds
) {
  const p =
    Number(probability);

  const implied =
    americanOddsToNBAImpliedProbability_(
      americanOdds
    );

  if (
    !Number.isFinite(p) ||
    implied === null
  ) {
    return null;
  }

  return p - implied;
}

// ============================================================================
// NBA RAW PROBABILITY AUDIT
// P5/18
//
// READ-ONLY with respect to production data.
// Reads:  NBA Player Game Logs
// Writes: NBA Probability Audit
//
// Purpose:
// - Recreates the frozen P4 projection model chronologically.
// - Calculates historical stat SD using PRIOR games only.
// - Converts projection + line into raw probabilities using the P5 engine.
// - Tests probabilities against actual subsequent outcomes.
// - Produces probability buckets for calibration inspection.
//
// IMPORTANT:
// This is NOT production calibration.
// P6 will perform formal chronological calibration/validation.
// ============================================================================

function auditNBARawProbabilities() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const logSheet =
    ss.getSheetByName(
      "NBA Player Game Logs"
    );

  if (!logSheet) {
    throw new Error(
      'Missing required sheet: "NBA Player Game Logs".'
    );
  }

  const logs =
    getNBAObjectsFromSheet_(logSheet);

  if (!logs.length) {
    throw new Error(
      "NBA Player Game Logs contains no historical data."
    );
  }

  // --------------------------------------------------------------------------
  // Frozen P4 production projection weights
  // --------------------------------------------------------------------------

  const markets = [
    {
      market: "Points",
      key: "points",
      modelKey: "points",
      recentWeight: 0.40,
      distribution: "normal"
    },
    {
      market: "Rebounds",
      key: "rebounds",
      modelKey: "rebounds",
      recentWeight: 0.30,
      distribution: "normal"
    },
    {
      market: "Assists",
      key: "assists",
      modelKey: "assists",
      recentWeight: 0.35,
      distribution: "normal"
    },
    {
      market: "Threes",
      key: "threes",
      modelKey: "threes",
      recentWeight: 0.20,
      distribution: "poisson"
    },
    {
      market: "Steals",
      key: "steals",
      modelKey: "steals",
      recentWeight: 0.15,
      distribution: "poisson"
    },
    {
      market: "Blocks",
      key: "blocks",
      modelKey: "blocks",
      recentWeight: 0.10,
      distribution: "poisson"
    },
    {
      market: "Turnovers",
      key: "turnovers",
      modelKey: "turnovers",
      recentWeight: 0.20,
      distribution: "poisson"
    },
    {
      market: "Points + Rebounds",
      key: "pointsRebounds",
      modelKey: "points_rebounds",
      recentWeight: 0.45,
      distribution: "normal"
    },
    {
      market: "Points + Assists",
      key: "pointsAssists",
      modelKey: "points_assists",
      recentWeight: 0.45,
      distribution: "normal"
    },
    {
      market: "Rebounds + Assists",
      key: "reboundsAssists",
      modelKey: "rebounds_assists",
      recentWeight: 0.40,
      distribution: "normal"
    },
    {
      market: "PRA",
      key: "pra",
      modelKey: "points_rebounds_assists",
      recentWeight: 0.50,
      distribution: "normal"
    },
    {
      market: "Blocks + Steals",
      key: "blocksSteals",
      modelKey: "blocks_steals",
      recentWeight: 0.15,
      distribution: "poisson"
    }
  ];

  const MIN_PRIOR_GAMES = 10;
  const RECENT_GAMES = 5;

  // --------------------------------------------------------------------------
  // Build player histories
  // --------------------------------------------------------------------------

  const players = {};

  logs.forEach(row => {
    const playerId =
      String(
        row["Player ID"] || ""
      ).trim();

    if (!playerId) return;

    const date =
      new Date(
        row["Game Date"]
      );

    if (
      !date ||
      Number.isNaN(
        date.getTime()
      )
    ) {
      return;
    }

    const points =
      Number(
        row["Points"] || 0
      );

    const rebounds =
      Number(
        row["Rebounds"] || 0
      );

    const assists =
      Number(
        row["Assists"] || 0
      );

    const steals =
      Number(
        row["Steals"] || 0
      );

    const blocks =
      Number(
        row["Blocks"] || 0
      );

    if (!players[playerId]) {
      players[playerId] = {
        playerId,
        playerName:
          row["Player Name"] || "",
        games: []
      };
    }

    players[playerId].games.push({
      date,

      points,
      rebounds,
      assists,

      threes:
        Number(
          row["Threes"] || 0
        ),

      steals,
      blocks,

      turnovers:
        Number(
          row["Turnovers"] || 0
        ),

      pointsRebounds:
        points + rebounds,

      pointsAssists:
        points + assists,

      reboundsAssists:
        rebounds + assists,

      pra:
        points +
        rebounds +
        assists,

      blocksSteals:
        blocks + steals
    });
  });

  Object.values(players)
    .forEach(player => {
      player.games.sort(
        (a, b) =>
          a.date.getTime() -
          b.date.getTime()
      );
    });

  // --------------------------------------------------------------------------
  // Create probability buckets
  //
  // We audit model confidence from the selected side:
  //
  // 50-55%
  // 55-60%
  // ...
  // 90-95%
  // 95-100%
  // --------------------------------------------------------------------------

  const bucketStarts = [
    0.50,
    0.55,
    0.60,
    0.65,
    0.70,
    0.75,
    0.80,
    0.85,
    0.90,
    0.95
  ];

  const audit = {};

  markets.forEach(market => {
    audit[market.key] = {};

    bucketStarts.forEach(start => {
      audit[market.key][
        start.toFixed(2)
      ] = {
        count: 0,
        probabilitySum: 0,
        wins: 0
      };
    });
  });

  // --------------------------------------------------------------------------
  // Chronological probability audit
  // --------------------------------------------------------------------------

  Object.values(players)
    .forEach(player => {
      const games =
        player.games;

      if (
        games.length <=
        MIN_PRIOR_GAMES
      ) {
        return;
      }

      for (
        let targetIndex =
          MIN_PRIOR_GAMES;

        targetIndex <
          games.length;

        targetIndex++
      ) {
        const priorGames =
          games.slice(
            0,
            targetIndex
          );

        const recentGames =
          priorGames.slice(
            -RECENT_GAMES
          );

        const targetGame =
          games[targetIndex];

        markets.forEach(
          market => {
            const seasonValues =
              priorGames.map(
                game =>
                  Number(
                    game[
                      market.key
                    ] || 0
                  )
              );

            const recentValues =
              recentGames.map(
                game =>
                  Number(
                    game[
                      market.key
                    ] || 0
                  )
              );

            const seasonAverage =
              avgNBA_(
                seasonValues
              );

            const recentAverage =
              avgNBA_(
                recentValues
              );

            const projection =
              seasonAverage *
                (
                  1 -
                  market.recentWeight
                ) +
              recentAverage *
                market.recentWeight;

            const statStdDev =
              stdDevNBA_(
                seasonValues
              );

            // --------------------------------------------------------------
            // Historical synthetic test line:
            //
            // Nearest half-point to the projection.
            //
            // Example:
            // projection 24.2 -> line 24.5
            // projection 7.8  -> line 7.5
            //
            // This is for probability calibration research ONLY.
            // Production P5 will use actual sportsbook lines.
            // --------------------------------------------------------------

            const line =
              Math.floor(
                projection
              ) + 0.5;

            const probabilities =
              calculateNBAPropProbabilities_(
                market.modelKey,
                projection,
                statStdDev,
                line
              );

            if (
              probabilities.over === null ||
              probabilities.under === null
            ) {
              return;
            }

            // --------------------------------------------------------------
            // Audit whichever side model considers more likely.
            // --------------------------------------------------------------

            let selectedProbability;
            let won;

            const actual =
              Number(
                targetGame[
                  market.key
                ] || 0
              );

            if (
              probabilities.over >=
              probabilities.under
            ) {
              selectedProbability =
                probabilities.over;

              won =
                actual > line;
            } else {
              selectedProbability =
                probabilities.under;

              won =
                actual < line;
            }

            if (
              selectedProbability <
              0.50
            ) {
              return;
            }

            const bucketIndex =
              Math.min(
                9,
                Math.floor(
                  (
                    selectedProbability -
                    0.50
                  ) / 0.05
                )
              );

            if (
              bucketIndex < 0 ||
              bucketIndex >
              9
            ) {
              return;
            }

            const bucketStart =
              bucketStarts[
                bucketIndex
              ];

            const bucket =
              audit[
                market.key
              ][
                bucketStart.toFixed(2)
              ];

            bucket.count++;

            bucket.probabilitySum +=
              selectedProbability;

            if (won) {
              bucket.wins++;
            }
          }
        );
      }
    });

  // --------------------------------------------------------------------------
  // Output
  // --------------------------------------------------------------------------

  const outputRows = [];

  markets.forEach(market => {
    bucketStarts.forEach(start => {
      const bucket =
        audit[
          market.key
        ][
          start.toFixed(2)
        ];

      if (!bucket.count) {
        return;
      }

      const averageProbability =
        bucket.probabilitySum /
        bucket.count;

      const actualHitRate =
        bucket.wins /
        bucket.count;

      const calibrationError =
        actualHitRate -
        averageProbability;

      outputRows.push([
        market.market,

        market.distribution,

        start,

        start + 0.05,

        bucket.count,

        averageProbability,

        actualHitRate,

        calibrationError,

        Math.abs(
          calibrationError
        )
      ]);
    });
  });

  const SHEET_NAME =
    "NBA Probability Audit";

  let outputSheet =
    ss.getSheetByName(
      SHEET_NAME
    );

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(
        SHEET_NAME
      );
  } else {
    outputSheet.clearContents();
  }

  const headers = [
    "Market",
    "Distribution",
    "Bucket Start",
    "Bucket End",
    "Predictions",
    "Avg Model Probability",
    "Actual Hit Rate",
    "Calibration Error",
    "Absolute Calibration Error"
  ];

  outputSheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([
      headers
    ]);

  if (outputRows.length) {
    outputSheet
      .getRange(
        2,
        1,
        outputRows.length,
        headers.length
      )
      .setValues(
        outputRows
      );

    outputSheet
      .getRange(
        2,
        3,
        outputRows.length,
        2
      )
      .setNumberFormat(
        "0%"
      );

    outputSheet
      .getRange(
        2,
        6,
        outputRows.length,
        4
      )
      .setNumberFormat(
        "0.00%"
      );
  }

  outputSheet.setFrozenRows(1);

  outputSheet.autoResizeColumns(
    1,
    headers.length
  );

  Logger.log(
    "NBA raw probability audit complete: " +
    outputRows.length +
    " populated calibration buckets."
  );
}


// ============================================================================
// SAMPLE STANDARD DEVIATION
//
// Uses n - 1 denominator.
// Returns null when fewer than two observations exist.
// ============================================================================

function stdDevNBA_(values) {
  const clean =
    values
      .map(Number)
      .filter(
        value =>
          Number.isFinite(value)
      );

  if (clean.length < 2) {
    return null;
  }

  const mean =
    clean.reduce(
      (sum, value) =>
        sum + value,
      0
    ) /
    clean.length;

  const squaredDifferenceSum =
    clean.reduce(
      (sum, value) => {
        const difference =
          value - mean;

        return (
          sum +
          difference *
          difference
        );
      },
      0
    );

  return Math.sqrt(
    squaredDifferenceSum /
    (
      clean.length - 1
    )
  );
}

