// ============================================================================
// NBA PROP MARKET NORMALIZATION
//
// Converts provider Prop Type values into Sportacular's frozen
// 12-market production contract.
//
// Unknown/unsupported markets return null.
// ============================================================================

function normalizeNBAPropMarket_(propType) {
  const raw =
    String(
      propType || ""
    )
      .trim()
      .toLowerCase();

  if (!raw) {
    return null;
  }

  const normalized =
    raw
      .replace(/[\s-]+/g, "_")
      .replace(/\+/g, "_")
      .replace(/__+/g, "_")
      .replace(/^_+|_+$/g, "");

  const aliases = {
    // ----------------------------------------------------------
    // Direct markets
    // ----------------------------------------------------------

    points:
      "points",

    player_points:
      "points",

    rebounds:
      "rebounds",

    player_rebounds:
      "rebounds",

    assists:
      "assists",

    player_assists:
      "assists",

    threes:
      "threes",

    three_pointers:
      "threes",

    three_pointers_made:
      "threes",

    threes_made:
      "threes",

    player_threes:
      "threes",

    player_threes_made:
      "threes",

    steals:
      "steals",

    player_steals:
      "steals",

    blocks:
      "blocks",

    player_blocks:
      "blocks",

    turnovers:
      "turnovers",

    player_turnovers:
      "turnovers",

    // ----------------------------------------------------------
    // Combination markets
    // ----------------------------------------------------------

    points_rebounds:
      "points_rebounds",

    points_and_rebounds:
      "points_rebounds",

    player_points_rebounds:
      "points_rebounds",

    points_assists:
      "points_assists",

    points_and_assists:
      "points_assists",

    player_points_assists:
      "points_assists",

    rebounds_assists:
      "rebounds_assists",

    rebounds_and_assists:
      "rebounds_assists",

    player_rebounds_assists:
      "rebounds_assists",

    points_rebounds_assists:
      "points_rebounds_assists",

    points_rebounds_assists_pra:
      "points_rebounds_assists",

    pra:
      "points_rebounds_assists",

    player_points_rebounds_assists:
      "points_rebounds_assists",

    blocks_steals:
      "blocks_steals",

    blocks_and_steals:
      "blocks_steals",

    steals_blocks:
      "blocks_steals",

    player_blocks_steals:
      "blocks_steals"
  };

  return (
    aliases[normalized] ||
    null
  );
}

// ============================================================================
// NBA PRODUCTION PROJECTION
//
// Universal contract:
//
// Player Baseline
//      +
// Trend Adjustment
//      =
// Projected Stat
//
// Baseline = season average.
// Trend adjustment moves the baseline toward the recent-5 average
// according to the chronologically validated P4 market weight.
// ============================================================================

function calculateNBAPropProjection_(
  marketKey,
  seasonAverage,
  recentAverage
) {
  const weights =
    NBA_PROP_PROJECTION_WEIGHTS[
      marketKey
    ];

  if (!weights) {
    return {
      baseline: null,
      trendAdjustment: null,
      projection: null
    };
  }

  const season =
    Number(
      seasonAverage
    );

  const recent =
    Number(
      recentAverage
    );

  if (
    !Number.isFinite(season) ||
    !Number.isFinite(recent)
  ) {
    return {
      baseline: null,
      trendAdjustment: null,
      projection: null
    };
  }

  const baseline =
    season;

  const trendAdjustment =
    (
      recent -
      season
    ) *
    weights.recent;

  const projection =
    baseline +
    trendAdjustment;

  return {
    baseline,
    trendAdjustment,
    projection
  };
}

