function refreshNBAPlayerGameLogsForDateRange_(startDate, endDate) {
  ensureNBATrendTabs_();

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("NBA Player Game Logs");

  const headers = [
    "Game Date", "Game ID", "Player ID", "Player Name", "Team", "Opponent",
    "Minutes", "Points", "Rebounds", "Assists", "Threes", "Steals", "Blocks", "Turnovers"
  ];

  Logger.log(`Refreshing NBA Player Game Logs from ${startDate} to ${endDate}`);

  const selectedGames = getNBACompletedGamesForDateRange_(startDate, endDate);
  if (!selectedGames.length) return;

  const gameMap = {};
  const gameIds = selectedGames.map(game => {
    const gameId = String(game.id || "");
    gameMap[gameId] = {
      date: getNBAGameAZDate_(game),
      homeTeam: (game.home_team && game.home_team.full_name) || "",
      awayTeam: (game.visitor_team && game.visitor_team.full_name) || ""
    };
    return gameId;
  }).filter(Boolean);

  const statRows = fetchAllNBAStatsForGameIds_(gameIds);
  const rows = [];

  statRows.forEach(stat => {
    const gameId = String(stat.game_id || (stat.game && stat.game.id) || "");
    const gameInfo = gameMap[gameId] || {};
    const player = stat.player || {};
    const team = stat.team || {};

    const playerId = stat.player_id || player.id || "";
    const playerName = player.full_name || `${player.first_name || ""} ${player.last_name || ""}`.trim();

    const teamName = team.full_name || team.abbreviation || "";

    const opponent =
      teamName === gameInfo.homeTeam ? gameInfo.awayTeam :
      teamName === gameInfo.awayTeam ? gameInfo.homeTeam :
      getNBAOpponentFromStat_(stat);

    const minutesPlayed = parseNBAMinutes_(stat.min);
    const points = Number(stat.pts || 0);
    const rebounds = Number(stat.reb || 0);
    const assists = Number(stat.ast || 0);
    const threes = Number(stat.fg3m || 0);
    const steals = Number(stat.stl || 0);
    const blocks = Number(stat.blk || 0);
    const turnovers = Number(stat.turnover || stat.turnovers || 0);

    if (!playerId && !playerName) return;

    if (minutesPlayed <= 0) return;

    rows.push([
      gameInfo.date, gameId, playerId, playerName, teamName, opponent,
      minutesPlayed, points, rebounds, assists, threes, steals, blocks, turnovers
    ]);
  });

  upsertRowsByKeyForDateRange_(sheet, headers, rows, [1, 2], startDate, endDate);
  Logger.log(`Upserted ${rows.length} NBA player game-log rows for ${startDate} to ${endDate}.`);
}

