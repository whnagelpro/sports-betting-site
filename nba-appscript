    outputRows.length +
    " rows."
  );
}


// ============================================================================
// STRICT NBA NUMBER PARSER
//
// Empty / invalid stays null.
// Critically, blank does NOT become zero.
// ============================================================================

function parseNBANumberOrNull_(
  value
) {
  if (
    value === null ||
    value === undefined ||
    value === ""
  ) {
    return null;
  }

  const number =
    Number(value);

  return Number.isFinite(number)
    ? number
    : null;
}


// ============================================================================
// STRICT NBA AMERICAN ODDS PARSER
//
// Accepts:
//   -110
//   +120
//   "120"
//   "-105"
//
// Empty / invalid stays null.
// Zero is rejected because it is not a valid American price.
// ============================================================================

function parseNBAAmericanOdds_(
  value
) {
  const number =
    parseNBANumberOrNull_(
      value
    );

  if (
    number === null ||
    number === 0
  ) {
    return null;
  }

  return number;
}

