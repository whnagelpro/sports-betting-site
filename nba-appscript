}

function getPastDateString_(daysAgo) {
  const tz = SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone() || Session.getScriptTimeZone();
  const d = new Date();
  d.setDate(d.getDate() - daysAgo);
  return Utilities.formatDate(d, tz, "yyyy-MM-dd");
}

function getRecentCompletedNBAGamesForTeamTrends_(gamesNeededPerTeam, maxLookbackDays) {
  const teams = fetchAllNBATeams_();
  const teamNeedMap = {};
  const selectedGameMap = {};

  teams.forEach(team => {
    teamNeedMap[String(team.id)] = [];
  });

  for (let daysAgo = 1; daysAgo <= maxLookbackDays; daysAgo++) {
    const dateString = getPastDateString_(daysAgo);
    Logger.log(`Checking NBA completed games for ${dateString}...`);

    const games = fetchAllNBAGamesForDate_(dateString)
      .filter(isCompletedNBAGame_);

    games.sort((a, b) => {
      const aDate = new Date(a.date || 0).getTime();
      const bDate = new Date(b.date || 0).getTime();
      return bDate - aDate;
    });

    games.forEach(game => {
      const gameId = String(game.id || "");
      const homeTeamId = String((game.home_team && game.home_team.id) || "");
      const awayTeamId = String((game.visitor_team && game.visitor_team.id) || "");

      if (!gameId || !homeTeamId || !awayTeamId) return;

      if (teamNeedMap[homeTeamId] && teamNeedMap[homeTeamId].length < gamesNeededPerTeam) {
        if (!teamNeedMap[homeTeamId].some(g => String(g.id) === gameId)) {
          teamNeedMap[homeTeamId].push(game);
          selectedGameMap[gameId] = game;
        }
      }

      if (teamNeedMap[awayTeamId] && teamNeedMap[awayTeamId].length < gamesNeededPerTeam) {
        if (!teamNeedMap[awayTeamId].some(g => String(g.id) === gameId)) {
          teamNeedMap[awayTeamId].push(game);
          selectedGameMap[gameId] = game;
        }
      }
    });

    Utilities.sleep(150);

    const allSatisfied = Object.values(teamNeedMap).every(arr => arr.length >= gamesNeededPerTeam);
    if (allSatisfied) break;
  }

  return {
    teams,
    teamGamesMap: teamNeedMap,
    selectedGames: Object.values(selectedGameMap)
  };
}

const SPORTACULAR_TIMEZONE = "America/Phoenix";

function getNBAGameRawDate_(game) {
  return (
    game.datetime ||
    game.start_time ||
    game.scheduled ||
    game.game_time ||
    game.date ||
    game.game_date ||
    ""
  );
}

function getNBAGameAZDate_(game) {
  const rawDate = getNBAGameRawDate_(game);
  if (!rawDate) return "";

  return Utilities.formatDate(
    new Date(rawDate),
    SPORTACULAR_TIMEZONE,
    "yyyy-MM-dd"
  );
}

function addDaysToDateString_(dateString, days) {
  const d = new Date(dateString + "T00:00:00");
  d.setDate(d.getDate() + days);

  return Utilities.formatDate(
    d,
    SPORTACULAR_TIMEZONE,
    "yyyy-MM-dd"
  );
}

function getNBACompletedGamesForDateRange_(startDate, endDate) {
  const selectedGamesMap = {};

  const fetchStartDate = addDaysToDateString_(startDate, -1);
  const fetchEndDate = addDaysToDateString_(endDate, 1);

  let current = new Date(fetchStartDate + "T00:00:00");
  const end = new Date(fetchEndDate + "T00:00:00");

  while (current <= end) {
    const apiDateString = Utilities.formatDate(
      current,
      SPORTACULAR_TIMEZONE,
      "yyyy-MM-dd"
    );

    Logger.log(`Checking NBA API games for ${apiDateString}`);

    const games = fetchAllNBAGamesForDate_(apiDateString)
      .filter(isCompletedNBAGame_)
      .filter(game => {
        const azDate = getNBAGameAZDate_(game);
        return azDate >= startDate && azDate <= endDate;
      });

    games.forEach(game => {
      if (game.id) {
        selectedGamesMap[String(game.id)] = game;
      }
    });

    current.setDate(current.getDate() + 1);
    Utilities.sleep(100);
  }

  return Object.values(selectedGamesMap);
}

function upsertRowsByKey_(sheet, headers, newRows, keyColumnIndexes) {
  const existingValues = sheet.getDataRange().getValues();
  const existingRows = existingValues.length > 1 ? existingValues.slice(1) : [];
  const rowMap = {};

  existingRows.forEach(row => {
    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  newRows.forEach(row => {
    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  const finalRows = Object.values(rowMap).sort((a, b) =>
    new Date(b[0]).getTime() - new Date(a[0]).getTime()
  );

  writeNBAOutputSheet_(sheet, headers, finalRows);
}

function normalizeSheetDateForCompare_(value) {
  if (!value) return "";

  if (Object.prototype.toString.call(value) === "[object Date]") {
    return Utilities.formatDate(
      value,
      SPORTACULAR_TIMEZONE,
      "yyyy-MM-dd"
    );
  }

  const text = String(value).trim();

  if (/^\d{4}-\d{2}-\d{2}$/.test(text)) {
    return text;
  }

  const parsed = new Date(text);

  if (!isNaN(parsed.getTime())) {
    return Utilities.formatDate(
      parsed,
      SPORTACULAR_TIMEZONE,
      "yyyy-MM-dd"
    );
  }

  return text;
}

function upsertRowsByKeyForDateRange_(sheet, headers, newRows, keyColumnIndexes, startDate, endDate) {
  const existingValues = sheet.getDataRange().getValues();
  const existingRows = existingValues.length > 1 ? existingValues.slice(1) : [];
  const rowMap = {};

  existingRows.forEach(row => {
    const rowDate = normalizeSheetDateForCompare_(row[0]);

    // Remove old rows from the same refreshed month/date range.
    // They will be replaced only by valid new rows.
    if (rowDate >= startDate && rowDate <= endDate) {
      return;
    }

    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  newRows.forEach(row => {
    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  const finalRows = Object.values(rowMap).sort((a, b) =>
    new Date(b[0]).getTime() - new Date(a[0]).getTime()
  );

  writeNBAOutputSheet_(sheet, headers, finalRows);
}

