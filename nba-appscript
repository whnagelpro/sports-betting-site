      rebounds: Number(row["Rebounds"] || 0),
      assists: Number(row["Assists"] || 0),
      threes: Number(row["Threes"] || 0),
      pra:
        Number(row["Points"] || 0) +
        Number(row["Rebounds"] || 0) +
        Number(row["Assists"] || 0)
    });
  });

  const now = new Date();
  const rows = [];

  Object.values(grouped).forEach(player => {
    const games = player.games.sort((a, b) => new Date(b.date) - new Date(a.date));

    NBA_PLAYER_TREND_STATS.forEach(stat => {
      const values = games.map(g => Number(g[stat.key] || 0));

      const seasonAvg = avgNBA_(values);
      const last3 = avgNBA_(values.slice(0, 3));
      const last5 = avgNBA_(values.slice(0, 5));
      const last10 = avgNBA_(values.slice(0, 10));
      const consistency = consistencyScoreNBA_(values);
      const score = trendScoreNBA_(last5, seasonAvg);

      const hitRateLast3 = hitRateNBA_(values.slice(0, 3), 1);
      const hitRateLast5 = hitRateNBA_(values.slice(0, 5), 1);
      const hitRateLast10 = hitRateNBA_(values.slice(0, 10), 1);
      const aboveSeasonPct = aboveSeasonPctNBA_(last5, seasonAvg);
      const strength = trendStrengthNBA_(hitRateLast5, aboveSeasonPct, score);

      const note = buildNBAPlayerTrendNote_(
        player.playerName,
        stat.label,
        seasonAvg,
        last5,
        hitRateLast5,
        score
      );

      rows.push([
        player.playerId,
        player.playerName,
        player.team,
        stat.label,
        seasonAvg,
        last3,
        last5,
        last10,
        trendDirectionNBA_(score),
        score,
        consistency,
        riskTierNBA_(consistency, Math.abs(score)),
        hitRateLast3,
        hitRateLast5,
        hitRateLast10,
        aboveSeasonPct,
        strength,
        note,
        now
      ]);
    });
  });

  rows.sort((a, b) =>
    String(a[1] || "").localeCompare(String(b[1] || "")) ||
    String(a[3] || "").localeCompare(String(b[3] || ""))
  );

  writeNBAOutputSheet_(sheet, headers, rows);

  sheet.getRange("M:O").setNumberFormat("0%");
  sheet.getRange("P:P").setNumberFormat("0.0");

  Logger.log(`Wrote ${rows.length} rows to NBA Player Trends v2.`);
}

