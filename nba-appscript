// ============================================================================
// NBA PROBABILITY CALIBRATION STRENGTH RESEARCH
// P6/18
//
// READ-ONLY with respect to production data.
// Reads:  NBA Player Game Logs
// Writes: NBA Calibration Research
//
// Uses:
// - Frozen P4 projection weights
// - Frozen P5 distribution families
// - Chronological prior-game information only
//
// Research split:
// - First 75% of each player's eligible prediction sequence
//
// Tests:
// - 0% through 100% shrink toward 50%, in 5% increments
//
// Scores:
// - Brier Score
// - Log Loss
//
// IMPORTANT:
// Final 25% is intentionally NOT used here.
// It is reserved for P6 holdout validation.
// ============================================================================

function researchNBAProbabilityCalibration() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const logSheet =
    ss.getSheetByName(
      "NBA Player Game Logs"
    );

  if (!logSheet) {
    throw new Error(
      'Missing required sheet: "NBA Player Game Logs".'
    );
  }

  const logs =
    getNBAObjectsFromSheet_(logSheet);

  if (!logs.length) {
    throw new Error(
      "NBA Player Game Logs contains no historical data."
    );
  }

  const markets = [
    {
      market: "Points",
      key: "points",
      modelKey: "points",
      recentWeight: 0.40
    },
    {
      market: "Rebounds",
      key: "rebounds",
      modelKey: "rebounds",
      recentWeight: 0.30
    },
    {
      market: "Assists",
      key: "assists",
      modelKey: "assists",
      recentWeight: 0.35
    },
    {
      market: "Threes",
      key: "threes",
      modelKey: "threes",
      recentWeight: 0.20
    },
    {
      market: "Steals",
      key: "steals",
      modelKey: "steals",
      recentWeight: 0.15
    },
    {
      market: "Blocks",
      key: "blocks",
      modelKey: "blocks",
      recentWeight: 0.10
    },
    {
      market: "Turnovers",
      key: "turnovers",
      modelKey: "turnovers",
      recentWeight: 0.20
    },
    {
      market: "Points + Rebounds",
      key: "pointsRebounds",
      modelKey: "points_rebounds",
      recentWeight: 0.45
    },
    {
      market: "Points + Assists",
      key: "pointsAssists",
      modelKey: "points_assists",
      recentWeight: 0.45
    },
    {
      market: "Rebounds + Assists",
      key: "reboundsAssists",
      modelKey: "rebounds_assists",
      recentWeight: 0.40
    },
    {
      market: "PRA",
      key: "pra",
      modelKey: "points_rebounds_assists",
      recentWeight: 0.50
    },
    {
      market: "Blocks + Steals",
      key: "blocksSteals",
      modelKey: "blocks_steals",
      recentWeight: 0.15
    }
  ];

  const MIN_PRIOR_GAMES = 10;
  const RECENT_GAMES = 5;

  const players = {};

  // --------------------------------------------------------------------------
  // Build player histories
  // --------------------------------------------------------------------------

  logs.forEach(row => {
    const playerId =
      String(
        row["Player ID"] || ""
      ).trim();

    if (!playerId) return;

    const date =
      new Date(
        row["Game Date"]
      );

    if (
      Number.isNaN(
        date.getTime()
      )
    ) {
      return;
    }

    const points =
      Number(
        row["Points"] || 0
      );

    const rebounds =
      Number(
        row["Rebounds"] || 0
      );

    const assists =
      Number(
        row["Assists"] || 0
      );

    const steals =
      Number(
        row["Steals"] || 0
      );

    const blocks =
      Number(
        row["Blocks"] || 0
      );

    if (!players[playerId]) {
      players[playerId] = {
        games: []
      };
    }

    players[playerId].games.push({
      date,

      points,
      rebounds,
      assists,

      threes:
        Number(
          row["Threes"] || 0
        ),

      steals,
      blocks,

      turnovers:
        Number(
          row["Turnovers"] || 0
        ),

      pointsRebounds:
        points + rebounds,

      pointsAssists:
        points + assists,

      reboundsAssists:
        rebounds + assists,

      pra:
        points +
        rebounds +
        assists,

      blocksSteals:
        blocks + steals
    });
  });

  Object.values(players)
    .forEach(player => {
      player.games.sort(
        (a, b) =>
          a.date.getTime() -
          b.date.getTime()
      );
    });

  // --------------------------------------------------------------------------
  // Calibration candidates
  // --------------------------------------------------------------------------

  const shrinkValues = [];

  for (
    let shrinkPct = 0;
    shrinkPct <= 100;
    shrinkPct += 5
  ) {
    shrinkValues.push(
      shrinkPct / 100
    );
  }

  const results = {};

  markets.forEach(market => {
    results[market.key] = {};

    shrinkValues.forEach(shrink => {
      results[market.key][
        shrink.toFixed(2)
      ] = {
        count: 0,
        brierSum: 0,
        logLossSum: 0
      };
    });
  });

  // --------------------------------------------------------------------------
  // Chronological research sample
  // --------------------------------------------------------------------------

  Object.values(players)
    .forEach(player => {
      const games =
        player.games;

      if (
        games.length <=
        MIN_PRIOR_GAMES
      ) {
        return;
      }

      const eligibleCount =
        games.length -
        MIN_PRIOR_GAMES;

      if (eligibleCount <= 0) {
        return;
      }

      const researchCount =
        Math.floor(
          eligibleCount * 0.75
        );

      if (researchCount <= 0) {
        return;
      }

      const researchEnd =
        MIN_PRIOR_GAMES +
        researchCount;

      for (
        let targetIndex =
          MIN_PRIOR_GAMES;

        targetIndex <
          researchEnd;

        targetIndex++
      ) {
        const priorGames =
          games.slice(
            0,
            targetIndex
          );

        const recentGames =
          priorGames.slice(
            -RECENT_GAMES
          );

        const targetGame =
          games[targetIndex];

        markets.forEach(
          market => {
            const seasonValues =
              priorGames.map(
                game =>
                  Number(
                    game[
                      market.key
                    ] || 0
                  )
              );

            const recentValues =
              recentGames.map(
                game =>
                  Number(
                    game[
                      market.key
                    ] || 0
                  )
              );

            const seasonAverage =
              avgNBA_(
                seasonValues
              );

            const recentAverage =
              avgNBA_(
                recentValues
              );

            const projection =
              seasonAverage *
                (
                  1 -
                  market.recentWeight
                ) +
              recentAverage *
                market.recentWeight;

            const statStdDev =
              stdDevNBA_(
                seasonValues
              );

            // Same synthetic half-point line
            // used by the P5 probability audit.
            const line =
              Math.floor(
                projection
              ) + 0.5;

            const probabilities =
              calculateNBAPropProbabilities_(
                market.modelKey,
                projection,
                statStdDev,
                line
              );

            if (
              probabilities.over === null ||
              probabilities.under === null
            ) {
              return;
            }

            let rawProbability;
            let actualOutcome;

            const actual =
              Number(
                targetGame[
                  market.key
                ] || 0
              );

            // Score the side that the raw model
            // considers more likely.
            if (
              probabilities.over >=
              probabilities.under
            ) {
              rawProbability =
                probabilities.over;

              actualOutcome =
                actual > line
                  ? 1
                  : 0;
            } else {
              rawProbability =
                probabilities.under;

              actualOutcome =
                actual < line
                  ? 1
                  : 0;
            }

            shrinkValues.forEach(
              shrink => {
                const calibratedProbability =
                  calibrateNBAProbabilityShrink_(
                    rawProbability,
                    shrink
                  );

                const accumulator =
                  results[
                    market.key
                  ][
                    shrink.toFixed(2)
                  ];

                const error =
                  calibratedProbability -
                  actualOutcome;

                accumulator.count++;

                accumulator.brierSum +=
                  error * error;

                accumulator.logLossSum +=
                  nbaLogLoss_(
                    calibratedProbability,
                    actualOutcome
                  );
              }
            );
          }
        );
      }
    });

  // --------------------------------------------------------------------------
  // Calculate detail results
  // --------------------------------------------------------------------------

  const detailRows = [];

  markets.forEach(market => {
    shrinkValues.forEach(
      shrink => {
        const result =
          results[
            market.key
          ][
            shrink.toFixed(2)
          ];

        if (!result.count) {
          return;
        }

        detailRows.push({
          market:
            market.market,

          shrink,

          predictions:
            result.count,

          brier:
            result.brierSum /
            result.count,

          logLoss:
            result.logLossSum /
            result.count
        });
      }
    );
  });

  // --------------------------------------------------------------------------
  // Select development winners
  // --------------------------------------------------------------------------

  const summaryRows = [];

  markets.forEach(market => {
    const marketRows =
      detailRows.filter(
        row =>
          row.market ===
          market.market
      );

    if (!marketRows.length) {
      return;
    }

    const raw =
      marketRows.find(
        row =>
          row.shrink === 0
      );

    const bestBrier =
      marketRows
        .slice()
        .sort(
          (a, b) =>
            a.brier -
              b.brier ||
            a.shrink -
              b.shrink
        )[0];

    const bestLogLoss =
      marketRows
        .slice()
        .sort(
          (a, b) =>
            a.logLoss -
              b.logLoss ||
            a.shrink -
              b.shrink
        )[0];

    const brierImprovement =
      raw &&
      raw.brier > 0
        ? (
            raw.brier -
            bestBrier.brier
          ) /
          raw.brier
        : "";

    const logLossImprovement =
      raw &&
      raw.logLoss > 0
        ? (
            raw.logLoss -
            bestLogLoss.logLoss
          ) /
          raw.logLoss
        : "";

    summaryRows.push([
      market.market,

      bestBrier.predictions,

      raw
        ? raw.brier
        : "",

      raw
        ? raw.logLoss
        : "",

      bestBrier.shrink,
      bestBrier.brier,
      brierImprovement,

      bestLogLoss.shrink,
      bestLogLoss.logLoss,
      logLossImprovement
    ]);
  });

  // --------------------------------------------------------------------------
  // Write sheet
  // --------------------------------------------------------------------------

  const SHEET_NAME =
    "NBA Calibration Research";

  let sheet =
    ss.getSheetByName(
      SHEET_NAME
    );

  if (!sheet) {
    sheet =
      ss.insertSheet(
        SHEET_NAME
      );
  } else {
    sheet.clearContents();
  }

  const summaryHeaders = [
    "Market",
    "Research Predictions",
    "Raw Brier",
    "Raw Log Loss",
    "Best Brier Shrink",
    "Best Brier",
    "Brier Improvement",
    "Best Log Loss Shrink",
    "Best Log Loss",
    "Log Loss Improvement"
  ];

  sheet
    .getRange(
      1,
      1,
      1,
      summaryHeaders.length
    )
    .setValues([
      summaryHeaders
    ]);

  if (summaryRows.length) {
    sheet
      .getRange(
        2,
        1,
        summaryRows.length,
        summaryHeaders.length
      )
      .setValues(
        summaryRows
      );

    sheet
      .getRange(
        2,
        5,
        summaryRows.length,
        1
      )
      .setNumberFormat(
        "0%"
      );

    sheet
      .getRange(
        2,
        8,
        summaryRows.length,
        1
      )
      .setNumberFormat(
        "0%"
      );

    sheet
      .getRange(
        2,
        7,
        summaryRows.length,
        1
      )
      .setNumberFormat(
        "0.00%"
      );

    sheet
      .getRange(
        2,
        10,
        summaryRows.length,
        1
      )
      .setNumberFormat(
        "0.00%"
      );
  }

  const detailStartRow =
    summaryRows.length + 4;

  const detailHeaders = [
    "Market",
    "Shrink Toward 50%",
    "Predictions",
    "Brier Score",
    "Log Loss"
  ];

  sheet
    .getRange(
      detailStartRow,
      1,
      1,
      detailHeaders.length
    )
    .setValues([
      detailHeaders
    ]);

  const detailValues =
    detailRows.map(
      row => [
        row.market,
        row.shrink,
        row.predictions,
        row.brier,
        row.logLoss
      ]
    );

  if (detailValues.length) {
    sheet
      .getRange(
        detailStartRow + 1,
        1,
        detailValues.length,
        detailHeaders.length
      )
      .setValues(
        detailValues
      );

    sheet
      .getRange(
        detailStartRow + 1,
        2,
        detailValues.length,
        1
      )
      .setNumberFormat(
        "0%"
      );
  }

  sheet.setFrozenRows(1);

  sheet.autoResizeColumns(
    1,
    summaryHeaders.length
  );

  Logger.log(
    "NBA calibration research complete."
  );
}


// ============================================================================
// SHRINK RAW PROBABILITY TOWARD 50%
// ============================================================================

function calibrateNBAProbabilityShrink_(
  rawProbability,
  shrink
) {
  const p =
    Number(
      rawProbability
    );

  const s =
    Number(
      shrink
    );

  if (
    !Number.isFinite(p) ||
    !Number.isFinite(s)
  ) {
    return null;
  }

  const calibrated =
    0.50 +
    (
      p - 0.50
    ) *
    (
      1 - s
    );

  return Math.min(
    0.999,
    Math.max(
      0.001,
      calibrated
    )
  );
}


// ============================================================================
// BINARY LOG LOSS
// ============================================================================

function nbaLogLoss_(
  probability,
  actualOutcome
) {
  const epsilon =
    0.000001;

  const p =
    Math.min(
      1 - epsilon,
      Math.max(
        epsilon,
        Number(
          probability
        )
      )
    );

  const y =
    Number(
      actualOutcome
    );

  return -(
    y * Math.log(p) +
    (
      1 - y
    ) *
    Math.log(
      1 - p
    )
  );
}

