      assists: Number(row["Assists"] || 0),
      threes: Number(row["Threes"] || 0),
      turnovers: Number(row["Turnovers"] || 0)
    });
  });

  const now = new Date();

  const rows = Object.keys(grouped).map(team => {
    const games = grouped[team];

    return [
      team,
      games.length,
      avgNBA_(games.map(g => g.pointsFor)),
      avgNBA_(games.map(g => g.pointsAllowed)),
      avgNBA_(games.map(g => g.rebounds)),
      avgNBA_(games.map(g => g.assists)),
      avgNBA_(games.map(g => g.threes)),
      avgNBA_(games.map(g => g.turnovers)),
      now
    ];
  });

  rows.sort((a, b) => String(a[0] || "").localeCompare(String(b[0] || "")));

  writeNBAOutputSheet_(sheet, headers, rows);

  Logger.log(`Wrote ${rows.length} rows to NBA Team Season Stats.`);
}

