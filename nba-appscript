    "Last Updated"
  ];

  const logs = getNBAObjectsFromSheet_(logSheet);
  const grouped = {};

  logs.forEach(row => {
    const playerId = String(row["Player ID"] || "");
    if (!playerId) return;

    if (!grouped[playerId]) {
      grouped[playerId] = {
        playerId,
        playerName: row["Player Name"] || "",
