  Logger.log("Refreshing NBA active rosters...");

  const players = fetchAllNBAActivePlayers_();

  const headers = [
    "Id",
    "First Name",
    "Last Name",
    "Full Name",
    "Team Id",
    "Team Name",
    "Team Abbreviation",
    "Conference",
    "Division",
    "Position",
    "Height",
    "Weight",
    "Jersey Number",
    "College",
    "Country",
    "Draft Year",
    "Draft Round",
    "Draft Number",
    "Status"
  ];

  const rows = players.map(player => {
    const firstName = player.first_name || "";
    const lastName = player.last_name || "";
    const fullName = `${firstName} ${lastName}`.trim();

    return [
      player.id || "",                                // A Id
      firstName,                                      // B First Name
      lastName,                                       // C Last Name
      fullName,                                       // D Full Name
      (player.team && player.team.id) || "",          // E Team Id
      (player.team && player.team.full_name) || "",   // F Team Name
      (player.team && player.team.abbreviation) || "",// G Team Abbreviation
      (player.team && player.team.conference) || "",  // H Conference
      (player.team && player.team.division) || "",    // I Division
      player.position || "",                          // J Position
      player.height || "",                            // K Height
      player.weight || "",                            // L Weight
      player.jersey_number || "",                     // M Jersey Number
      player.college || "",                           // N College
      player.country || "",                           // O Country
      player.draft_year || "",                        // P Draft Year
      player.draft_round || "",                       // Q Draft Round
      player.draft_number || "",                      // R Draft Number
      "Active"                                        // S Status
