// ============================================================================
// BUILD COMPLETE NBA PLAYER PROP CONTEXT MAP
//
// Return structure:
//
// contextMap[playerId][marketKey] = {
//   playerId,
//   playerName,
//   team,
//   marketKey,
//   gamesPlayed,
//   seasonAverage,
//   recentAverage,
//   statStdDev,
//   baseline,
//   trendAdjustment,
//   projection
// }
// ============================================================================

function buildNBAPlayerPropContextMap_() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const logSheet =
    ss.getSheetByName(
      "NBA Player Game Logs"
    );

  if (!logSheet) {
    throw new Error(
      'Missing required sheet: "NBA Player Game Logs".'
    );
  }

  const rows =
    getNBAObjectsFromSheet_(
      logSheet
    );

  const players = {};

  rows.forEach(row => {
    const playerId =
      String(
        row["Player ID"] || ""
      ).trim();

    if (!playerId) {
      return;
    }

    if (!players[playerId]) {
      players[playerId] = {
        playerId,

        playerName:
          row["Player Name"] || "",

        team:
          row["Team"] || "",

        games: []
      };
    }

    // Keep the most recently encountered
    // nonblank identity information.
    if (row["Player Name"]) {
      players[playerId].playerName =
        row["Player Name"];
    }

    if (row["Team"]) {
      players[playerId].team =
        row["Team"];
    }

    players[playerId].games.push(
      buildNBAPropGameFromLogRow_(
        row
      )
    );
  });

  const contextMap = {};

  Object.values(players)
    .forEach(player => {

      // Oldest -> newest.
      //
      // This makes the last five entries
      // unambiguously the player's latest
      // five historical games.
      player.games.sort(
        (a, b) =>
          new Date(a.date) -
          new Date(b.date)
      );

      contextMap[
        player.playerId
      ] = {};

      Object.keys(
        NBA_PROP_GAME_LOG_KEYS
      ).forEach(marketKey => {

        const gameLogKey =
          NBA_PROP_GAME_LOG_KEYS[
            marketKey
          ];

        const values =
          player.games
            .map(game =>
              Number(
                game[
                  gameLogKey
                ]
              )
            )
            .filter(
              value =>
                Number.isFinite(
                  value
                )
            );

        if (!values.length) {
          return;
        }

        const recentValues =
          values.slice(-5);

        const seasonAverage =
          avgNBA_(
            values
          );

        const recentAverage =
          avgNBA_(
            recentValues
          );

        const statStdDev =
          stdDevNBA_(
            values
          );

        const projection =
          calculateNBAPropProjection_(
            marketKey,
            seasonAverage,
            recentAverage
          );

        contextMap[
          player.playerId
        ][
          marketKey
        ] = {
          playerId:
            player.playerId,

          playerName:
            player.playerName,

          team:
            player.team,

          marketKey,

          gamesPlayed:
            values.length,

          seasonAverage,

          recentAverage,

          statStdDev,

          baseline:
            projection.baseline,

          trendAdjustment:
            projection.trendAdjustment,

          projection:
            projection.projection
        };
      });
    });

  return contextMap;
}

function auditNBAPlayerPropContext() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const contextMap =
    buildNBAPlayerPropContextMap_();

  const rows = [];

  Object.keys(contextMap)
    .forEach(playerId => {

      const playerMarkets =
        contextMap[playerId];

      Object.keys(playerMarkets)
        .forEach(marketKey => {

          const context =
            playerMarkets[
              marketKey
            ];

          rows.push([
            context.playerId,
            context.playerName,
            context.team,
            context.marketKey,
            context.gamesPlayed,
            context.seasonAverage,
            context.recentAverage,
            context.statStdDev,
            context.baseline,
            context.trendAdjustment,
            context.projection
          ]);
        });
    });

  rows.sort(
    (a, b) => {
      const nameCompare =
        String(a[1] || "")
          .localeCompare(
