      );

    // Projection/context columns.
    outputSheet
      .getRange(
        2,
        14,
        outputRows.length,
        5
      )
      .setNumberFormat(
        "0.0000"
      );
  }

  outputSheet.setFrozenRows(1);

  outputSheet.autoResizeColumns(
    1,
