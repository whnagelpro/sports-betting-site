        games: []
      };
    }

    const points =
      Number(row["Points"] || 0);

    const rebounds =
      Number(row["Rebounds"] || 0);

    const assists =
      Number(row["Assists"] || 0);

    const steals =
      Number(row["Steals"] || 0);

