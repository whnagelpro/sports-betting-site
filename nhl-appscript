// ============================================================================
// NHL DAILY ANALYTICS MOTHER PIPELINE — FAILURE / RETRY SAFETY TEST
//
// TEST ONLY.
// Does NOT:
//   - call NHL APIs
//   - refresh any spreadsheet tabs
//   - modify the real NHL mother-pipeline Script Property
//   - create continuation triggers
//
// Purpose:
//   Proves that a failed step does not advance pipeline state,
//   and that a successful retry advances exactly once.
// ============================================================================

function testNHLDailyAnalyticsPipelineRetrySafety() {

  Logger.log(
    "============================================================"
  );

  Logger.log(
    "NHL MOTHER PIPELINE RETRY SAFETY TEST STARTING"
  );

  Logger.log(
    "============================================================"
  );


  // --------------------------------------------------------------------------
  // Small assertion helper
  // --------------------------------------------------------------------------

  function assertTest_(
    name,
    condition,
    expected,
    actual
  ) {

    const result = {
      name: name,
      pass: Boolean(condition),
      expected: expected,
      actual: actual
    };

    Logger.log(
      JSON.stringify(result)
    );

    if (!condition) {
      throw new Error(
        `TEST FAILED: ${name}`
      );
    }
  }


  // --------------------------------------------------------------------------
  // Create completely isolated in-memory test state.
  //
  // This intentionally mirrors the important production state fields,
  // but it is NEVER written to Script Properties.
  // --------------------------------------------------------------------------

  const state = {

    runDate:
      "TEST-ONLY",

    stage:
      "PLAYER_GAME_LOGS",

    playerMonthIndex:
      0,

    teamMonthIndex:
      0,

    completed:
      false,

    lastSuccessfulStep:
      null,

    lastError:
      null,

    updatedAt:
      "TEST-ONLY"
  };


  // --------------------------------------------------------------------------
  // Simulated monthly refresh function.
  //
  // First call fails.
  // Second call succeeds.
  // --------------------------------------------------------------------------

  let attemptCount = 0;

  function simulatedMonthlyRefresh_() {

    attemptCount += 1;

    Logger.log(
      `Simulated refresh attempt ${attemptCount}`
    );

    if (attemptCount === 1) {

      throw new Error(
        "SIMULATED NHL MONTHLY REFRESH FAILURE"
      );

    }

    return true;
  }


  // --------------------------------------------------------------------------
  // TEST 1
  //
  // Simulate the same ordering used by production:
  //
  //     month.fn();
  //     state.playerMonthIndex += 1;
  //
  // Because the refresh throws, the increment must never execute.
  // --------------------------------------------------------------------------

  Logger.log(
    "TEST 1 — Simulating failed monthly refresh..."
  );

  try {

    simulatedMonthlyRefresh_();

    // IMPORTANT:
    // This is deliberately AFTER the refresh call,
    // matching production behavior.
    state.playerMonthIndex += 1;

    state.lastSuccessfulStep =
      "PLAYER_GAME_LOGS:TEST";

    state.lastError =
      null;

  } catch (error) {

    state.lastError =
      String(
        error &&
        error.stack
          ? error.stack
          : error
      );

  }


  assertTest_(
    "Failed refresh keeps playerMonthIndex unchanged",
    state.playerMonthIndex === 0,
    0,
    state.playerMonthIndex
  );


  assertTest_(
    "Failed refresh keeps stage on PLAYER_GAME_LOGS",
    state.stage === "PLAYER_GAME_LOGS",
    "PLAYER_GAME_LOGS",
    state.stage
  );


  assertTest_(
    "Failed refresh does not create lastSuccessfulStep",
    state.lastSuccessfulStep === null,
    null,
    state.lastSuccessfulStep
  );


  assertTest_(
    "Failed refresh records an error",
    typeof state.lastError === "string" &&
      state.lastError.includes(
        "SIMULATED NHL MONTHLY REFRESH FAILURE"
      ),
    true,
    Boolean(state.lastError)
  );


  assertTest_(
    "Failed refresh does not mark pipeline complete",
    state.completed === false,
    false,
    state.completed
  );


  // --------------------------------------------------------------------------
  // TEST 2
  //
  // Retry the SAME step.
  //
  // This time the simulated refresh succeeds.
  // Only now may the month index advance.
  // --------------------------------------------------------------------------

  Logger.log(
    "TEST 2 — Retrying exact same monthly refresh..."
  );

  try {

    simulatedMonthlyRefresh_();

    state.playerMonthIndex += 1;

    state.lastSuccessfulStep =
      "PLAYER_GAME_LOGS:TEST";

    state.lastError =
      null;

  } catch (error) {

    state.lastError =
      String(
        error &&
        error.stack
          ? error.stack
          : error
      );

  }


  assertTest_(
    "Successful retry advances playerMonthIndex exactly once",
    state.playerMonthIndex === 1,
    1,
    state.playerMonthIndex
  );


  assertTest_(
    "Successful retry remains in current stage until month loop finishes",
    state.stage === "PLAYER_GAME_LOGS",
    "PLAYER_GAME_LOGS",
    state.stage
  );


  assertTest_(
    "Successful retry records exact successful step",
    state.lastSuccessfulStep ===
      "PLAYER_GAME_LOGS:TEST",
    "PLAYER_GAME_LOGS:TEST",
    state.lastSuccessfulStep
  );


  assertTest_(
    "Successful retry clears previous error",
    state.lastError === null,
    null,
    state.lastError
  );


  assertTest_(
    "Refresh function executed exactly twice",
    attemptCount === 2,
    2,
    attemptCount
  );


  // --------------------------------------------------------------------------
