function erfNHL_(x) {
  const sign =
    x < 0 ? -1 : 1;

  const absoluteX =
    Math.abs(x);

  const t =
    1 /
    (
      1 +
      0.3275911 *
      absoluteX
    );

  const a1 = 0.254829592;
  const a2 = -0.284496736;
  const a3 = 1.421413741;
  const a4 = -1.453152027;
  const a5 = 1.061405429;

  const y =
    1 -
    (
      (
        (
          (
            (
              a5 * t +
              a4
            ) * t +
            a3
          ) * t +
          a2
        ) * t +
        a1
      ) *
      t *
      Math.exp(
        -absoluteX *
        absoluteX
      )
    );

  return sign * y;
}

function normalCDFNHL_(
  value,
  mean,
  stdDev
) {
  const x =
    Number(value);

  const mu =
    Number(mean);

  const sigma =
    Number(stdDev);

  if (
    !Number.isFinite(x) ||
    !Number.isFinite(mu) ||
    !Number.isFinite(sigma) ||
    sigma <= 0
  ) {
    return null;
  }

  const z =
    (
      x -
      mu
    ) /
    (
      sigma *
      Math.sqrt(2)
    );

  const probability =
    0.5 *
    (
      1 +
      erfNHL_(z)
    );

  return Math.min(
    1,
    Math.max(
      0,
      probability
    )
  );
}

function normalOverProbabilityNHL_(
  mean,
  stdDev,
  line
) {
  const cdf =
    normalCDFNHL_(
      line,
      mean,
      stdDev
    );

  if (cdf === null) {
    return null;
  }

  return Math.min(
    1,
    Math.max(
      0,
      1 - cdf
    )
  );
}

