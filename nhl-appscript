    SpreadsheetApp.getActiveSpreadsheet();


  const sourceSheet =
    ss.getSheetByName(
      "NHL Player Game Logs"
    );


  if (!sourceSheet) {
    throw new Error(
      'Missing required sheet: "NHL Player Game Logs".'
    );
  }


  // ==========================================================================
  // FROZEN DEVELOPMENT DECISION
  // ==========================================================================

  const FROZEN_RESIDUAL_FLOOR =
    0.00;


  const candidates = [
    "Raw",
    "Reliability Calibrated"
  ];


  // ==========================================================================
  // SOURCE DATA
  // ==========================================================================

  const allRows =
    getNHLObjectsFromSheet_(
      sourceSheet
    )
      .filter(
        isNHLRegularSeasonResearchDate_
      );


  const output = [];


  const aggregate = {

    Raw: {
      predictions: 0,
      predictedTotal: 0,
      actualTotal: 0,
      brierTotal: 0
    },

    "Reliability Calibrated": {
      predictions: 0,
      predictedTotal: 0,
      actualTotal: 0,
      brierTotal: 0
    }

  };


  // ==========================================================================
  // MARKET LOOP
  // ==========================================================================

  Object.keys(
    NHL_CALIBRATION_AUDIT_MARKETS
  ).forEach(
    marketKey => {

      const config =
        NHL_CALIBRATION_AUDIT_MARKETS[
          marketKey
        ];


      const eligibleRows =
        allRows.filter(
          row =>
            isNHLEligiblePropGame_(
              row,
              config
            )
        );


      const playerGames = {};


      eligibleRows.forEach(
        row => {

          const playerId =
            String(
              row["Player ID"] || ""
            ).trim();


          if (!playerId) {
            return;
          }


          if (!playerGames[playerId]) {
            playerGames[playerId] = [];
          }


          playerGames[playerId].push(
            row
          );

        }
      );


      Object.keys(
        playerGames
      ).forEach(
        playerId => {

          playerGames[playerId].sort(
            (a, b) =>
              getNHLBacktestDateValue_(a) -
              getNHLBacktestDateValue_(b)
          );

        }
      );


      // ======================================================================
      // LINE LOOP
      // ======================================================================

      config.lines.forEach(
        line => {

          const lineResults = {

            Raw: {
              predictions: 0,
              predictedTotal: 0,
              actualTotal: 0,
              brierTotal: 0
            },

            "Reliability Calibrated": {
              predictions: 0,
              predictedTotal: 0,
              actualTotal: 0,
              brierTotal: 0
            }

          };


          // ==================================================================
          // PLAYER LOOP
          // ==================================================================

          Object.keys(
            playerGames
          ).forEach(
            playerId => {

              const games =
                playerGames[
                  playerId
                ];


              // Same eligibility requirement used by development.
              if (
                games.length <
                14
              ) {
                return;
              }


              const holdoutStart =
                Math.max(
                  10,
                  Math.floor(
                    games.length *
                    0.75
                  )
                );


              if (
                holdoutStart >=
                games.length
              ) {
                return;
              }


              // ==============================================================
              // UNTOUCHED FINAL 25%
              // ==============================================================

              for (
                let i =
                  holdoutStart;
                i <
                  games.length;
                i++
              ) {

                const priorGames =
                  games.slice(
                    0,
                    i
                  );


                const priorValues =
                  priorGames
                    .map(
                      row =>
                        getNHLBacktestStatValue_(
                          row,
                          config
                        )
                    )
                    .filter(
                      value =>
                        value !== null &&
                        Number.isFinite(
                          value
                        )
                    );


                if (
                  priorValues.length <
                  10
                ) {
                  continue;
                }


                const recentValues =
                  priorValues.slice(
                    -5
                  );


                if (
                  recentValues.length <
                  5
                ) {
                  continue;
                }


                const seasonAverage =
                  avgNHL_(
                    priorValues
                  );


                const recentAverage =
                  avgNHL_(
                    recentValues
                  );


                const projection =
                  calculateNHLPropProjection_(
                    marketKey,
                    seasonAverage,
                    recentAverage
                  );


                if (
                  !projection ||
                  !Number.isFinite(
                    projection
                      .projectedStat
                  )
                ) {
                  continue;
                }


                const probabilities =
                  calculateNHLProductionProbabilities_({

                    market:
                      marketKey,

                    projectedStat:
                      projection
                        .projectedStat,

                    line,

                    type:
                      "over_under",

                    priorValues:
                      marketKey ===
                      "saves"
                        ? priorValues
                        : null

                  });


                if (
                  !probabilities ||
                  probabilities
                    .modelProbOver ===
                    null ||
                  !Number.isFinite(
                    probabilities
                      .modelProbOver
                  )
                ) {
                  continue;
                }


                // ============================================================
                // ACTUAL HOLDOUT OUTCOME
                // ============================================================

                const actualValue =
                  getNHLBacktestStatValue_(
                    games[i],
                    config
                  );


                if (
                  actualValue ===
                    null ||
                  !Number.isFinite(
                    actualValue
                  )
                ) {
                  continue;
                }


                const outcome =
                  actualValue >
                  line
                    ? 1
                    : 0;


                // ============================================================
                // CANDIDATE 1 — RAW
                // ============================================================

                const rawProbability =
                  probabilities
                    .modelProbOver;


                // ============================================================
                // CANDIDATE 2 — RELIABILITY CALIBRATED
                //
                // Frozen residual floor = 0%.
                // No parameter search occurs here.
                // ============================================================

                const effectiveShrink =
                  calculateNHLResidualCalibrationShrink_(
                    priorValues.length,
                    FROZEN_RESIDUAL_FLOOR
                  );


                if (
                  effectiveShrink ===
                  null
                ) {
                  continue;
                }


                const calibratedProbability =
                  calibrateNHLProbabilityShrink_(
                    rawProbability,
                    effectiveShrink
                  );


                if (
                  calibratedProbability ===
                    null ||
                  !Number.isFinite(
                    calibratedProbability
                  )
                ) {
                  continue;
                }


                // ============================================================
                // SCORE BOTH CANDIDATES ON THE EXACT SAME OBSERVATION
                // ============================================================

                const probabilitiesToScore = {

                  Raw:
                    rawProbability,

                  "Reliability Calibrated":
                    calibratedProbability

                };


                candidates.forEach(
                  candidate => {

                    const probability =
                      probabilitiesToScore[
                        candidate
                      ];


                    const error =
                      probability -
                      outcome;


                    const lineResult =
                      lineResults[
                        candidate
                      ];


                    lineResult.predictions++;

                    lineResult.predictedTotal +=
                      probability;

                    lineResult.actualTotal +=
                      outcome;

                    lineResult.brierTotal +=
                      error *
                      error;


                    const aggregateResult =
                      aggregate[
                        candidate
                      ];


                    aggregateResult.predictions++;

                    aggregateResult.predictedTotal +=
                      probability;

                    aggregateResult.actualTotal +=
                      outcome;

                    aggregateResult.brierTotal +=
                      error *
                      error;

                  }
                );

              }

            }
          );


          // ==================================================================
          // LINE-LEVEL OUTPUT
          // ==================================================================

          candidates.forEach(
            candidate => {

              const result =
                lineResults[
                  candidate
                ];


              if (
                !result.predictions
              ) {

                output.push([
                  marketKey,
                  config.label,
                  line,
                  candidate,
                  FROZEN_RESIDUAL_FLOOR,
                  0,
                  "",
                  "",
                  "",
                  ""
                ]);

                return;
              }


              const averagePredicted =
                result.predictedTotal /
                result.predictions;


              const actualRate =
                result.actualTotal /
                result.predictions;


              const calibrationGap =
                averagePredicted -
                actualRate;


              const brier =
                result.brierTotal /
                result.predictions;


              output.push([
                marketKey,
                config.label,
                line,
                candidate,
                FROZEN_RESIDUAL_FLOOR,
                result.predictions,
                averagePredicted,
                actualRate,
                calibrationGap,
                brier
              ]);

            }
          );

        }
      );

    }
  );


  // ==========================================================================
  // AGGREGATE HOLDOUT RESULTS
  // ==========================================================================

  const aggregateResults =
    candidates.map(
      candidate => {

        const result =
          aggregate[
            candidate
          ];


        if (
          !result.predictions
        ) {

          return {
            candidate,
            predictions:
              0,
            averagePredicted:
              null,
            actualRate:
              null,
            calibrationGap:
              null,
            absoluteCalibrationGap:
              null,
            brier:
              null
          };

        }


        const averagePredicted =
          result.predictedTotal /
          result.predictions;


        const actualRate =
          result.actualTotal /
          result.predictions;


        const calibrationGap =
          averagePredicted -
          actualRate;


        const brier =
          result.brierTotal /
          result.predictions;


        return {
          candidate,

          predictions:
            result.predictions,

          averagePredicted,

          actualRate,

          calibrationGap,

          absoluteCalibrationGap:
            Math.abs(
              calibrationGap
            ),

          brier
        };

      }
    );


  const rawAggregate =
    aggregateResults.find(
      result =>
        result.candidate ===
        "Raw"
    );


  const calibratedAggregate =
    aggregateResults.find(
      result =>
        result.candidate ===
        "Reliability Calibrated"
    );


  // ==========================================================================
  // DIAGNOSTIC DIFFERENCES
  //
  // Negative Brier delta = calibrated version improved Brier.
  // Negative abs-gap delta = calibrated version improved calibration gap.
  // ==========================================================================

  const comparison = {

    brierDelta:
      calibratedAggregate &&
      rawAggregate
        ? calibratedAggregate.brier -
          rawAggregate.brier
        : null,

    absoluteCalibrationGapDelta:
      calibratedAggregate &&
      rawAggregate
        ? calibratedAggregate
            .absoluteCalibrationGap -
          rawAggregate
            .absoluteCalibrationGap
        : null,

    calibratedBrierImproved:
      calibratedAggregate &&
      rawAggregate
        ? calibratedAggregate.brier <
          rawAggregate.brier
        : false,

    calibratedAbsoluteGapImproved:
      calibratedAggregate &&
      rawAggregate
        ? calibratedAggregate
            .absoluteCalibrationGap <
          rawAggregate
            .absoluteCalibrationGap
        : false

  };


  // ==========================================================================
  // WRITE HOLDOUT DIAGNOSTIC SHEET
  // ==========================================================================

  const sheetName =
    "NHL Reliability Holdout";


  let outputSheet =
    ss.getSheetByName(
      sheetName
    );


  if (!outputSheet) {

    outputSheet =
      ss.insertSheet(
        sheetName
      );

  } else {

    outputSheet.clearContents();

  }


  const headers = [
    "Market Key",
    "Market",
    "Line",
    "Candidate",
    "Frozen Residual Floor",
    "Holdout Predictions",
    "Avg Predicted Probability",
    "Actual Over Rate",
    "Calibration Gap",
    "Brier Score"
  ];


  outputSheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([
      headers
    ]);


  if (
    output.length
  ) {

    outputSheet
      .getRange(
        2,
        1,
        output.length,
        headers.length
      )
      .setValues(
        output
      );


    outputSheet
      .getRange(
        2,
        5,
        output.length,
        1
      )
      .setNumberFormat(
        "0%"
      );


    outputSheet
      .getRange(
        2,
        7,
        output.length,
        3
      )
      .setNumberFormat(
        "0.00%"
      );


    outputSheet
      .getRange(
        2,
        10,
        output.length,
        1
      )
      .setNumberFormat(
        "0.000000"
      );

  }


  outputSheet.setFrozenRows(
    1
  );


  outputSheet.autoResizeColumns(
    1,
    headers.length
  );


  // ==========================================================================
  // STRUCTURAL VALIDATION
  //
  // IMPORTANT:
  // "pass" means the holdout experiment executed correctly.
  //
  // It does NOT require calibrated probabilities to beat raw probabilities.
  // The holdout result itself determines that.
  // ==========================================================================

  const totalLines =
    Object.values(
      NHL_CALIBRATION_AUDIT_MARKETS
    ).reduce(
      (sum, config) =>
        sum +
        config.lines.length,
      0
    );


  const expectedRows =
    totalLines *
    candidates.length;


  const equalCandidateSamples =
    rawAggregate &&
    calibratedAggregate &&
    rawAggregate.predictions ===
      calibratedAggregate.predictions;


  const pass =
    output.length ===
      expectedRows &&
    output.every(
      row =>
        row[5] > 0 &&
        Number.isFinite(
          Number(
            row[6]
          )
        ) &&
        Number.isFinite(
          Number(
            row[7]
          )
        ) &&
        Number.isFinite(
          Number(
            row[8]
          )
        ) &&
        Number.isFinite(
          Number(
            row[9]
          )
        )
    ) &&
    aggregateResults.every(
      result =>
        result.predictions > 0 &&
        Number.isFinite(
          result.brier
        ) &&
        Number.isFinite(
          result.calibrationGap
        )
    ) &&
    equalCandidateSamples;


  // ==========================================================================
  // LOG
  // ==========================================================================

  Logger.log(
    JSON.stringify(
      {
        test:
          "D10AB NHL FINAL RELIABILITY CALIBRATION HOLDOUT",

        frozenResidualFloor:
          FROZEN_RESIDUAL_FLOOR,

        holdoutFraction:
          0.25,

        candidates,

        expectedRows,

        actualRows:
          output.length,

        equalCandidateSamples,

        pass,

        aggregateResults,

        comparison

      },
      null,
      2
    )
  );


  if (
    !pass
  ) {
    throw new Error(
      "D10AB NHL final reliability-calibration holdout validation failed structurally."
    );
  }


  return {
    test:
      "D10AB NHL FINAL RELIABILITY CALIBRATION HOLDOUT",

    frozenResidualFloor:
      FROZEN_RESIDUAL_FLOOR,

    pass,

    aggregateResults,

    comparison
  };

}

/**
 * ============================================================================
 * D10AC — NHL PROBABILITY -> PRICE -> EV INTEGRATION AUDIT
 * ============================================================================
 *
 * Diagnostic only.
 *
 * Verifies that the existing NHL production helpers agree across:
 *
 *   Model Probability
 *        ↓
 *   American Odds
 *        ↓
 *   Sportsbook Implied Probability
 *        ↓
 *   Price Edge
 *        ↓
 *   Expected Value
 *        ↓
 *   Best Side
 *
 * DOES NOT:
 * - modify Player Props
 * - modify production probabilities
 * - modify Sportacular Score
 * - modify recommendation thresholds
 * ============================================================================
 */
function testNHLProbabilityPriceEVAudit_D10AC() {

  const EPSILON = 1e-10;

  const nearlyEqual = (
    actual,
    expected,
    tolerance = EPSILON
  ) => {
    return (
      Number.isFinite(actual) &&
      Number.isFinite(expected) &&
      Math.abs(actual - expected) <= tolerance
    );
  };


  const tests = [];


  const record = (
    name,
    pass,
    details = {}
  ) => {

    const result = {
      name,
      pass,
      ...details
    };

    tests.push(result);

    Logger.log(
      JSON.stringify(result)
    );
  };


  // ==========================================================================
  // CASE 1 — NEGATIVE AMERICAN ODDS
  // ==========================================================================

  const negativeOdds = -110;

  const negativeImplied =
    getNHLAmericanImpliedProbability_(
      negativeOdds
    );

  const expectedNegativeImplied =
    110 / 210;


  record(
    "-110 implied probability is correct",
    nearlyEqual(
      negativeImplied,
      expectedNegativeImplied
    ),
    {
      odds: negativeOdds,
      expected:
        expectedNegativeImplied,
      actual:
        negativeImplied
    }
  );


  // ==========================================================================
  // CASE 2 — POSITIVE AMERICAN ODDS
  // ==========================================================================

  const positiveOdds = 150;

  const positiveImplied =
    getNHLAmericanImpliedProbability_(
      positiveOdds
    );

  const expectedPositiveImplied =
    100 / 250;


  record(
    "+150 implied probability is correct",
    nearlyEqual(
      positiveImplied,
      expectedPositiveImplied
    ),
    {
      odds: positiveOdds,
      expected:
        expectedPositiveImplied,
      actual:
        positiveImplied
    }
  );


  // ==========================================================================
  // CASE 3 — BREAK-EVEN PROBABILITY SHOULD PRODUCE ZERO EV
  // ==========================================================================

  const breakEvenEV =
    calculateNHLEVFromAmericanOdds_(
      expectedNegativeImplied,
      -110
    );


  record(
    "Break-even probability produces zero EV",
    nearlyEqual(
      breakEvenEV,
      0
    ),
    {
      probability:
        expectedNegativeImplied,
      odds: -110,
      expectedEV: 0,
      actualEV:
        breakEvenEV
    }
  );


  // ==========================================================================
  // CASE 4 — POSITIVE PRICE EDGE SHOULD PRODUCE POSITIVE EV
  // ==========================================================================

  const positiveEdgeProbability =
    0.60;

  const positiveEdgeEV =
    calculateNHLEVFromAmericanOdds_(
      positiveEdgeProbability,
      -110
    );

  const expectedPositiveEdgeEV =
    (
      positiveEdgeProbability *
      (
        100 / 110
      )
    ) -
    (
      1 -
      positiveEdgeProbability
    );


  const positivePriceEdge =
    positiveEdgeProbability -
    expectedNegativeImplied;


  record(
    "Positive price edge produces positive EV",
    (
      positivePriceEdge > 0 &&
      positiveEdgeEV > 0 &&
      nearlyEqual(
        positiveEdgeEV,
        expectedPositiveEdgeEV
      )
    ),
    {
      probability:
        positiveEdgeProbability,
      odds: -110,
      impliedProbability:
        expectedNegativeImplied,
      priceEdge:
        positivePriceEdge,
      expectedEV:
        expectedPositiveEdgeEV,
      actualEV:
        positiveEdgeEV
    }
  );


  // ==========================================================================
  // CASE 5 — NEGATIVE PRICE EDGE SHOULD PRODUCE NEGATIVE EV
  // ==========================================================================

  const negativeEdgeProbability =
    0.48;

  const negativeEdgeEV =
    calculateNHLEVFromAmericanOdds_(
      negativeEdgeProbability,
      -110
    );

  const negativePriceEdge =
    negativeEdgeProbability -
    expectedNegativeImplied;


  record(
    "Negative price edge produces negative EV",
    (
      negativePriceEdge < 0 &&
      negativeEdgeEV < 0
    ),
    {
      probability:
        negativeEdgeProbability,
      odds: -110,
      impliedProbability:
        expectedNegativeImplied,
      priceEdge:
        negativePriceEdge,
      ev:
        negativeEdgeEV
    }
  );


  // ==========================================================================
  // CASE 6 — POSITIVE ODDS EV
  // ==========================================================================

  const plusMoneyProbability =
    0.45;

  const plusMoneyEV =
    calculateNHLEVFromAmericanOdds_(
      plusMoneyProbability,
      150
    );

  const expectedPlusMoneyEV =
    (
      plusMoneyProbability *
      1.5
    ) -
    (
      1 -
      plusMoneyProbability
    );


  record(
    "+150 EV calculation is correct",
    nearlyEqual(
      plusMoneyEV,
      expectedPlusMoneyEV
    ),
    {
      probability:
        plusMoneyProbability,
      odds: 150,
      impliedProbability:
        positiveImplied,
      expectedEV:
        expectedPlusMoneyEV,
      actualEV:
        plusMoneyEV
    }
  );


  // ==========================================================================
  // CASE 7 — OVER/UNDER SIDE SELECTION
  //
  // Over:
  //   P = 60%
  //   odds = -110
  //
  // Under:
  //   P = 40%
  //   odds = -110
  //
  // Over should clearly win.
  // ==========================================================================

  const overProbability =
    0.60;

  const underProbability =
    0.40;

  const overOdds =
    -110;

  const underOdds =
    -110;


  const overEV =
    calculateNHLEVFromAmericanOdds_(
      overProbability,
      overOdds
    );

  const underEV =
    calculateNHLEVFromAmericanOdds_(
      underProbability,
      underOdds
    );


  const decision =
    buildNHLUniversalDecisionFields_({
      type:
        "over_under",

      odds:
        null,

      overOdds,
      underOdds,

      modelProbOver:
        overProbability,

      modelProbUnder:
        underProbability,

      evOver:
        overEV,

      evUnder:
        underEV
    });


  record(
    "Best side follows greater EV",
    (
      decision.bestSide ===
        "Over" &&
      nearlyEqual(
        decision.bestEV,
        overEV
      )
    ),
    {
      overProbability,
      underProbability,
      overOdds,
      underOdds,
      overEV,
      underEV,
      selectedSide:
        decision.bestSide,
      selectedEV:
        decision.bestEV
    }
  );


  // ==========================================================================
  // CASE 8 — BEST MODEL PROBABILITY MUST FOLLOW SELECTED SIDE
  // ==========================================================================

  record(
    "Best Model Probability follows selected side",
    nearlyEqual(
      decision.bestModelProbability,
      overProbability
    ),
    {
      selectedSide:
        decision.bestSide,
      expectedProbability:
        overProbability,
      actualProbability:
        decision.bestModelProbability
    }
  );


  // ==========================================================================
  // CASE 9 — BEST PRICE EDGE MUST USE SELECTED SPORTSBOOK PRICE
  // ==========================================================================

  const expectedBestPriceEdge =
    overProbability -
    getNHLAmericanImpliedProbability_(
      overOdds
    );


  record(
    "Best Price Edge uses selected sportsbook implied probability",
    nearlyEqual(
      decision.bestPriceEdge,
      expectedBestPriceEdge
    ),
    {
      selectedSide:
        decision.bestSide,
      modelProbability:
        overProbability,
      sportsbookOdds:
        overOdds,
      sportsbookImpliedProbability:
        getNHLAmericanImpliedProbability_(
          overOdds
        ),
      expectedBestPriceEdge,
      actualBestPriceEdge:
        decision.bestPriceEdge
    }
  );


  // ==========================================================================
  // CASE 10 — EV AND PRICE EDGE MUST AGREE ON BREAK-EVEN DIRECTION
  // ==========================================================================

  const consistencyCases = [
    {
      probability: 0.40,
      odds: +150
    },
    {
      probability: 0.45,
      odds: +150
    },
    {
      probability: 110 / 210,
      odds: -110
    },
    {
      probability: 0.60,
      odds: -110
    },
    {
      probability: 0.48,
      odds: -110
    },
    {
      probability: 0.70,
      odds: -200
    }
  ];


  const consistencyResults =
    consistencyCases.map(
      testCase => {

        const implied =
          getNHLAmericanImpliedProbability_(
            testCase.odds
          );

        const edge =
          testCase.probability -
          implied;

        const ev =
          calculateNHLEVFromAmericanOdds_(
            testCase.probability,
            testCase.odds
          );


        let directionMatches;

        if (
          Math.abs(edge) <=
          EPSILON
        ) {
          directionMatches =
            Math.abs(ev) <=
            EPSILON;

        } else if (edge > 0) {
          directionMatches =
            ev > 0;

        } else {
          directionMatches =
            ev < 0;
        }


        return {
          probability:
            testCase.probability,

          odds:
            testCase.odds,

          impliedProbability:
            implied,

          priceEdge:
            edge,

          ev,

          directionMatches
        };
      }
    );


  record(
    "EV direction agrees with sportsbook price edge",
    consistencyResults.every(
      result =>
        result.directionMatches
    ),
    {
      cases:
        consistencyResults
    }
  );


  // ==========================================================================
  // CASE 11 — NULL INTEGRITY
  // ==========================================================================

  const nullEV =
    calculateNHLEVFromAmericanOdds_(
      null,
      -110
    );

  const nullOddsEV =
    calculateNHLEVFromAmericanOdds_(
      0.60,
      null
    );

  const nullImplied =
    getNHLAmericanImpliedProbability_(
      null
    );


  record(
    "Missing probability or odds remains null",
    (
      nullEV === null &&
      nullOddsEV === null &&
      nullImplied === null
    ),
    {
      missingProbabilityEV:
        nullEV,

      missingOddsEV:
        nullOddsEV,

      missingOddsImpliedProbability:
        nullImplied
    }
  );


  // ==========================================================================
  // FINAL RESULT
  // ==========================================================================

  const passed =
    tests.filter(
      test =>
        test.pass
    ).length;

  const allPassed =
    passed ===
    tests.length;


  const result = {
    test:
      "D10AC NHL PROBABILITY PRICE EV INTEGRATION AUDIT",

    tests:
      tests.length,

    passed,

    pass:
      allPassed,

    sampleDecision: {
      overProbability,
      underProbability,
      overOdds,
      underOdds,
      overEV,
      underEV,
      bestSide:
        decision.bestSide,
      bestEV:
        decision.bestEV,
      bestModelProbability:
        decision.bestModelProbability,
      bestPriceEdge:
        decision.bestPriceEdge
    },

    results:
      tests
  };


  Logger.log(
    JSON.stringify(
      result,
      null,
      2
    )
  );


  if (!allPassed) {
    throw new Error(
      "D10AC NHL probability-price-EV integration audit failed."
    );
  }


  return result;
}

/**
 * ============================================================================
 * D10AD — NHL ACTIONABILITY BOUNDARY AUDIT
 * ============================================================================
 *
 * Diagnostic only.
 *
 * Verifies the frozen production eligibility contract:
 *
 *   Best EV                 >= 0.05
 *   Best Model Probability  >= 0.52
 *   Best Price Edge         >= 0.03
 *   Model Confidence        >= 50
 *   Sportacular Score       >= 55
 *
 * Also verifies:
 * - exact threshold is actionable
 * - just below each threshold is No Play
