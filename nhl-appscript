function refreshNHLTeamTrendsOutputSheet() {
  ensureNHLTrendTabs_();

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const logSheet = ss.getSheetByName("NHL Team Game Logs");
  const sheet = ss.getSheetByName("NHL Team Trends");

  const headers = [
    "Team",
    "Metric",
    "Season Avg",
    "Last 3 Avg",
    "Last 5 Avg",
    "Last 10 Avg",
    "Trend Direction",
    "Trend Score",
    "Consistency",
    "Risk Tier",
    "Hit Rate Last 3",
    "Hit Rate Last 5",
    "Hit Rate Last 10",
    "Above Season %",
    "Trend Strength",
    "Trend Note",
    "Last Updated",
    "League Rank",
    "Rank Score",
    "Offensive Rating",
    "Defensive Rating",
    "Overall Rating",
    "Rating Tier",
    "Rating Notes"
  ];

  const logs = getNHLObjectsFromSheet_(logSheet);
  const grouped = {};

  logs.forEach(row => {
    const team = row["Team"];
    if (!team) return;

    if (!grouped[team]) grouped[team] = [];

    grouped[team].push({
      date: row["Game Date"],
      goalsFor: Number(row["Goals For"] || 0),
      goalsAllowed: Number(row["Goals Allowed"] || 0),
      shotsOnGoal: Number(row["Shots On Goal"] || 0),
      assists: Number(row["Assists"] || 0),
      points: Number(row["Points"] || 0),
      saves: Number(row["Saves"] || 0)
    });
  });

  const now = new Date();
  const rows = [];

  Object.keys(grouped).forEach(team => {
    const games = grouped[team].sort((a, b) => new Date(b.date) - new Date(a.date));

    NHL_TEAM_TREND_STATS.forEach(metric => {
      const values = games.map(g => Number(g[metric.key] || 0));

      const seasonAvg = avgNHL_(values);
      const last3 = avgNHL_(values.slice(0, 3));
      const last5 = avgNHL_(values.slice(0, 5));
      const last10 = avgNHL_(values.slice(0, 10));
      const consistency = consistencyScoreNHL_(values);
      const score = trendScoreNHL_(last5, seasonAvg);

      const hitRateLast3 = hitRateNHL_(values.slice(0, 3), 1);
      const hitRateLast5 = hitRateNHL_(values.slice(0, 5), 1);
      const hitRateLast10 = hitRateNHL_(values.slice(0, 10), 1);
      const aboveSeasonPct = aboveSeasonPctNHL_(last5, seasonAvg);
      const strength = trendStrengthNHL_(hitRateLast5, aboveSeasonPct, score);

      const note = buildNHLTeamTrendNote_(
        team,
        metric.label,
        seasonAvg,
        last5,
        hitRateLast5,
        score
      );

      rows.push([
        team,
        metric.label,
        seasonAvg,
        last3,
        last5,
        last10,
        trendDirectionNHL_(score),
        score,
        consistency,
        riskTierNHL_(consistency, Math.abs(score)),
        hitRateLast3,
        hitRateLast5,
        hitRateLast10,
        aboveSeasonPct,
        strength,
        note,
        now
      ]);
    });
  });

  // =====================================================
  // NHL TEAM METRIC RANKS + RATINGS
  // =====================================================

  populateNHLTeamRatings_(rows);

  rows.sort((a, b) =>
    String(a[0] || "").localeCompare(String(b[0] || "")) ||
    String(a[1] || "").localeCompare(String(b[1] || ""))
  );

  writeNHLOutputSheet_(sheet, headers, rows);

  sheet.getRange("K:M").setNumberFormat("0%");
  sheet.getRange("N:N").setNumberFormat("0.0");

  Logger.log(`Wrote ${rows.length} rows to NHL Team Trends v2.`);
}

function populateNHLTeamRatings_(rows) {

  if (!rows || !rows.length) return;

  // -----------------------------------------------------
  // BUILD METRIC MAP
  // -----------------------------------------------------

  const teamMetricMap = {};

  rows.forEach(row => {

    const team = String(row[0] || "").trim();
    const metric = String(row[1] || "").trim();
    const seasonAvg = Number(row[2]);

    if (
      !team ||
      !metric ||
      Number.isNaN(seasonAvg)
    ) {
      return;
    }

    if (!teamMetricMap[team]) {
      teamMetricMap[team] = {};
    }

    teamMetricMap[team][metric] = seasonAvg;

  });


  // -----------------------------------------------------
  // METRIC RANK SCORE HELPER
  // -----------------------------------------------------

  const getMetricRankScores = (
    metricName,
    lowerIsBetter = false
  ) => {

    const values = Object.keys(teamMetricMap)
      .map(team => ({
        team,
        value: Number(
          teamMetricMap[team][metricName]
        )
      }))
      .filter(item =>
        !Number.isNaN(item.value)
      );

    values.sort((a, b) =>
      lowerIsBetter
        ? a.value - b.value
        : b.value - a.value
    );

    const scores = {};

    values.forEach((item, index) => {

      const rank = index + 1;

      const score =
        values.length > 1
          ? 100 *
            (
              1 -
              (rank - 1) /
              (values.length - 1)
            )
          : 100;

      scores[item.team] = {
        rank,
        score
      };

    });

    return scores;

  };


  // -----------------------------------------------------
  // CALCULATE METRIC RANK SCORES
  // -----------------------------------------------------

  const goalsForScores =
    getMetricRankScores("Goals For");

  const goalsAllowedScores =
    getMetricRankScores(
      "Goals Allowed",
      true
    );

  const shotsScores =
    getMetricRankScores("Shots On Goal");

  const assistsScores =
    getMetricRankScores("Assists");

  const pointsScores =
    getMetricRankScores("Points");

  const savesScores =
    getMetricRankScores("Saves");


  // -----------------------------------------------------
  // CALCULATE TEAM RATINGS
  // -----------------------------------------------------

  const teamRatings = {};

  Object.keys(teamMetricMap).forEach(team => {

    const offensiveScores = [
      goalsForScores[team]?.score,
      shotsScores[team]?.score,
      assistsScores[team]?.score,
      pointsScores[team]?.score
    ].filter(value =>
      value !== undefined &&
      !Number.isNaN(Number(value))
    );

    const defensiveScores = [
      goalsAllowedScores[team]?.score,
      savesScores[team]?.score
    ].filter(value =>
      value !== undefined &&
      !Number.isNaN(Number(value))
    );

    const offensiveRating =
      offensiveScores.length
        ? offensiveScores.reduce(
            (sum, value) => sum + value,
            0
          ) / offensiveScores.length
        : 0;

    const defensiveRating =
      defensiveScores.length
        ? defensiveScores.reduce(
            (sum, value) => sum + value,
            0
          ) / defensiveScores.length
        : 0;

    const overallRating =
      offensiveRating * 0.60 +
      defensiveRating * 0.40;

    teamRatings[team] = {
      offensiveRating,
      defensiveRating,
      overallRating
    };

  });


  // -----------------------------------------------------
  // OVERALL NHL LEAGUE RANKINGS
  // -----------------------------------------------------

  const overallRankings =
    Object.entries(teamRatings)
      .map(([team, ratings]) => ({
        team,
        overallRating:
          ratings.overallRating
      }))
      .sort(
        (a, b) =>
          b.overallRating -
          a.overallRating
      );

  overallRankings.forEach(
    (item, index) => {

      const rank = index + 1;

      const rankScore =
        overallRankings.length > 1
          ? 100 *
            (
              1 -
              (rank - 1) /
              (overallRankings.length - 1)
            )
          : 100;

      teamRatings[item.team].leagueRank =
        rank;

      teamRatings[item.team].rankScore =
        rankScore;

    }
  );


  // -----------------------------------------------------
  // WRITE RATINGS INTO EVERY TEAM TREND ROW
  // -----------------------------------------------------

  rows.forEach(row => {

    const team =
      String(row[0] || "").trim();

    const ratings =
      teamRatings[team];

    if (!ratings) {

      row.push(
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      );

      return;

    }

    const offensiveRating =
      ratings.offensiveRating;

    const defensiveRating =
      ratings.defensiveRating;

    const overallRating =
      ratings.overallRating;


    // ---------------------------------------------------
    // RATING TIER
    // ---------------------------------------------------

    let ratingTier = "Weak";

    if (overallRating >= 90) {
      ratingTier = "Elite";
    } else if (overallRating >= 75) {
      ratingTier = "Strong";
    } else if (overallRating >= 55) {
      ratingTier = "Average";
    } else if (overallRating >= 40) {
      ratingTier = "Below Average";
    }


    // ---------------------------------------------------
    // RATING NOTES
    // ---------------------------------------------------

    let ratingNotes =
      "Balanced team profile.";

    if (
      offensiveRating >
      defensiveRating + 20
    ) {

      ratingNotes =
        "Offense carrying the team.";

    } else if (
      defensiveRating >
      offensiveRating + 20
    ) {

      ratingNotes =
        "Defense carrying the team.";

    }


    row.push(
      ratings.leagueRank,
      Number(
        ratings.rankScore.toFixed(1)
      ),
      Number(
        offensiveRating.toFixed(1)
      ),
      Number(
        defensiveRating.toFixed(1)
      ),
      Number(
        overallRating.toFixed(1)
      ),
      ratingTier,
      ratingNotes
    );

  });

}

