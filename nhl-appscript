function BDL_LOL_TOURNAMENTS(perPage) {
  const params = { per_page: perPage || 25 };
  const response = fetchApi_('/lol/v1/tournaments', params);
  return toSheet_(response.data);
}

/**
 * Get LoL matches
 * @param {number} tournamentId Filter by tournament ID
 * @param {number} teamId Filter by team ID
 * @param {number} perPage Results per page
 * @returns {Array} LoL matches data
 * @customfunction
 */
function BDL_LOL_MATCHES(tournamentId, teamId, perPage) {
  const params = { per_page: perPage || 25 };
  if (tournamentId) params.tournament_id = tournamentId;
  if (teamId) params['team_ids[]'] = teamId;
  const response = fetchApi_('/lol/v1/matches', params);
  return toSheet_(response.data);
}

