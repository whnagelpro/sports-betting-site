    );
  }

  const allRows =
    getNHLObjectsFromSheet_(
      sourceSheet
    ).filter(
      isNHLRegularSeasonResearchDate_
    );

  const output = [];

  Object.keys(
    NHL_CALIBRATION_AUDIT_MARKETS
  ).forEach(marketKey => {
    const config =
      NHL_CALIBRATION_AUDIT_MARKETS[
        marketKey
      ];

    const eligibleRows =
      allRows.filter(row =>
        isNHLEligiblePropGame_(
          row,
          config
        )
      );

    const playerGames = {};

    eligibleRows.forEach(row => {
      const playerId =
        String(
          row["Player ID"] || ""
        ).trim();

      if (!playerId) {
        return;
      }

      if (!playerGames[playerId]) {
        playerGames[playerId] = [];
      }

      playerGames[playerId].push(
        row
      );
    });

    Object.keys(
      playerGames
    ).forEach(playerId => {
      playerGames[playerId].sort(
        (a, b) =>
          getNHLBacktestDateValue_(a) -
          getNHLBacktestDateValue_(b)
      );
    });

    config.lines.forEach(line => {
      let predictions = 0;

      let predictedTotal = 0;
      let actualTotal = 0;
      let brierTotal = 0;

      Object.keys(
        playerGames
      ).forEach(playerId => {
        const games =
          playerGames[playerId];

        if (games.length < 11) {
          return;
        }

        for (
          let i = 10;
          i < games.length;
          i++
        ) {
          const priorGames =
            games.slice(
              0,
              i
            );

          const priorValues =
            priorGames
              .map(row =>
                getNHLBacktestStatValue_(
                  row,
                  config
                )
              )
              .filter(value =>
                value !== null &&
                Number.isFinite(value)
              );

          if (
            priorValues.length < 10
          ) {
            continue;
          }

          const recentValues =
            priorValues.slice(-5);

          if (
            recentValues.length < 5
          ) {
            continue;
          }

          const seasonAverage =
            avgNHL_(
              priorValues
            );

          const recentAverage =
            avgNHL_(
              recentValues
            );

          const projection =
            calculateNHLPropProjection_(
              marketKey,
              seasonAverage,
              recentAverage
            );

          if (
            !projection ||
            !Number.isFinite(
              projection.projectedStat
            )
          ) {
            continue;
          }

          const probabilities =
            calculateNHLProductionProbabilities_({
              market:
                marketKey,

              projectedStat:
                projection.projectedStat,

              line,

              type:
                "over_under",

              priorValues:
                marketKey === "saves"
                  ? priorValues
                  : null
            });

          if (
            !probabilities ||
            probabilities.modelProbOver ===
              null ||
            !Number.isFinite(
              probabilities.modelProbOver
            )
          ) {
            continue;
          }

          const actualValue =
            getNHLBacktestStatValue_(
              games[i],
              config
            );

          if (
            actualValue === null ||
            !Number.isFinite(
              actualValue
            )
          ) {
            continue;
          }

          const outcome =
            actualValue > line
              ? 1
              : 0;

          const probability =
            probabilities.modelProbOver;

          const error =
            probability -
            outcome;

          predictedTotal +=
            probability;

          actualTotal +=
            outcome;

          brierTotal +=
            error * error;

          predictions++;
        }
      });

      if (!predictions) {
        output.push([
          marketKey,
          config.label,
          line,
          0,
          "",
          "",
          "",
          ""
        ]);

        return;
      }

      const averagePredicted =
        predictedTotal /
        predictions;

      const actualRate =
        actualTotal /
        predictions;

      const calibrationGap =
        averagePredicted -
        actualRate;

      const brier =
        brierTotal /
        predictions;

      output.push([
        marketKey,
        config.label,
        line,
        predictions,
        averagePredicted,
        actualRate,
        calibrationGap,
        brier
      ]);
    });
  });

  const sheetName =
    "NHL Raw Calibration";

  let outputSheet =
    ss.getSheetByName(
      sheetName
    );

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(
        sheetName
      );
  } else {
    outputSheet.clearContents();
  }

  const headers = [
    "Market Key",
    "Market",
    "Line",
    "Predictions",
    "Avg Predicted Probability",
    "Actual Over Rate",
    "Calibration Gap",
    "Brier Score"
  ];

  outputSheet
