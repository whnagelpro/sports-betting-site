// ============================================================================
// P10/18 — NHL PRODUCTION PROBABILITY + EV ENGINE
//
// Frozen distribution families:
//
//   shots_on_goal → Poisson
//   points        → Poisson
//   assists       → Poisson
//   goals         → Poisson
//   anytime_goal  → Poisson goals model
//   saves         → Negative Binomial
//
// Null integrity:
//   unknown !== 0
//   unavailable !== 0%
//   missing probability !== 0%
//   missing EV !== -100%
//
// This engine does NOT yet modify the Player Props sheet.
// ============================================================================

function parseNHLAmericanOdds_(value) {
  if (
    value === null ||
    value === undefined ||
    value === ""
  ) {
    return null;
  }

  const odds =
    Number(value);

  if (
    !Number.isFinite(odds) ||
    odds === 0
  ) {
    return null;
  }

  return odds;
}


function calculateNHLEVFromAmericanOdds_(
  probability,
  americanOdds
) {
  if (
    probability === null ||
    probability === undefined ||
    probability === ""
  ) {
    return null;
  }

  const p =
    Number(probability);

  const odds =
    parseNHLAmericanOdds_(
      americanOdds
    );

  if (
    !Number.isFinite(p) ||
    p < 0 ||
    p > 1 ||
    odds === null
  ) {
    return null;
  }

  const profit =
    odds > 0
      ? odds / 100
      : 100 / Math.abs(odds);

  return (
    p * profit
  ) - (
    1 - p
  );
}


function poissonOverProbabilityNHLProduction_(
  mean,
  line
) {
  const mu =
    Number(mean);

  const threshold =
    Number(line);

  if (
    !Number.isFinite(mu) ||
    mu < 0 ||
    !Number.isFinite(threshold)
  ) {
    return null;
  }

  return poissonOverProbabilityNHL_(
    mu,
    threshold
  );
}


function calculateNHLProductionProbabilities_({
  market,
  projectedStat,
  line,
  type,
  priorValues
}) {
  const marketKey =
    String(
      market || ""
    )
      .trim()
      .toLowerCase();

  const config =
    NHL_PROVIDER_PROP_MARKETS[
      marketKey
    ];

  if (
    !config ||
    (
      config.status !== "SUPPORTED" &&
      config.status !== "SUPPORTED_MILESTONE"
    )
  ) {
    return null;
  }

  if (
    projectedStat === null ||
    projectedStat === undefined ||
    projectedStat === "" ||
    line === null ||
    line === undefined ||
    line === ""
  ) {
    return null;
  }

  const projection =
    Number(
      projectedStat
    );

  const threshold =
    Number(
      line
    );

  if (
    !Number.isFinite(projection) ||
    projection < 0 ||
    !Number.isFinite(threshold)
  ) {
    return null;
  }

  const normalizedType =
    String(
      type || ""
    )
      .trim()
      .toLowerCase();

  const isMilestone =
    config.status ===
      "SUPPORTED_MILESTONE" ||
    normalizedType ===
      "milestone";

  let overProbability = null;

  // --------------------------------------------------------------------------
  // SAVES → NEGATIVE BINOMIAL
  // --------------------------------------------------------------------------

  if (
    config.modelKey ===
    "saves"
  ) {
    if (
      !Array.isArray(
        priorValues
      ) ||
      priorValues.length < 2
    ) {
      return null;
    }

    const cleanValues =
      priorValues
        .map(value =>
          Number(value)
        )
        .filter(value =>
          Number.isFinite(value) &&
          value >= 0
        );

    if (
      cleanValues.length < 2
    ) {
      return null;
    }

    const alpha =
      estimateNHLNB2Alpha_(
        cleanValues
      );

    if (
      alpha === null ||
      !Number.isFinite(alpha) ||
      alpha < 0
    ) {
      return null;
    }

    overProbability =
      negativeBinomialOverProbabilityNHL_(
        projection,
        alpha,
        threshold
      );
  }

  // --------------------------------------------------------------------------
  // SKATER MARKETS → POISSON
  // --------------------------------------------------------------------------

  else {
    overProbability =
      poissonOverProbabilityNHLProduction_(
        projection,
        threshold
      );
  }

  if (
    overProbability === null ||
    !Number.isFinite(
      overProbability
    )
  ) {
    return null;
  }

  const boundedOver =
    Math.min(
      1,
      Math.max(
        0,
        overProbability
      )
    );

  if (isMilestone) {
    return {
      distribution:
        config.modelKey === "saves"
          ? "negative_binomial"
          : "poisson",

      modelProbOver:
        boundedOver,

      modelProbUnder:
        null,

      isMilestone:
        true
    };
  }

  const underProbability =
    1 -
    boundedOver;

  return {
    distribution:
      config.modelKey === "saves"
        ? "negative_binomial"
        : "poisson",

    modelProbOver:
      boundedOver,

    modelProbUnder:
      Math.min(
        1,
        Math.max(
          0,
          underProbability
        )
      ),

    isMilestone:
      false
  };
}


function calculateNHLProductionPropModel_({
  market,
  projectedStat,
  line,
  type,
  overOdds,
  underOdds,
  milestoneOdds,
  priorValues
}) {
  const probabilities =
    calculateNHLProductionProbabilities_({
      market,
      projectedStat,
      line,
      type,
      priorValues
    });

  if (!probabilities) {
    return {
      distribution: null,
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null
    };
  }

  const overPrice =
    probabilities.isMilestone
      ? milestoneOdds
      : overOdds;

  const evOver =
    calculateNHLEVFromAmericanOdds_(
      probabilities.modelProbOver,
      overPrice
    );

  const evUnder =
    probabilities.isMilestone
      ? null
      : calculateNHLEVFromAmericanOdds_(
          probabilities.modelProbUnder,
          underOdds
        );

  return {
    distribution:
      probabilities.distribution,

    modelProbOver:
      probabilities.modelProbOver,

    modelProbUnder:
      probabilities.modelProbUnder,

    evOver,

    evUnder
  };
}

