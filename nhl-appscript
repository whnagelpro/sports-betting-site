function scheduleNHLDailyAnalyticsRetry_() {

  const handler =
    NHL_DAILY_ANALYTICS_PIPELINE.retryFunction;

  // Prevent duplicate continuation triggers.
  ScriptApp
    .getProjectTriggers()
    .filter(
      trigger =>
        trigger.getHandlerFunction() === handler
    )
    .forEach(
      trigger =>
        ScriptApp.deleteTrigger(trigger)
    );

  ScriptApp
    .newTrigger(handler)
    .timeBased()
    .after(
      NHL_DAILY_ANALYTICS_PIPELINE.retryDelayMs
    )
    .create();

  Logger.log(
    "NHL mother pipeline continuation scheduled."
