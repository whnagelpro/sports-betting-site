function buildNHLPlayerIdentityIndex_() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName("NHL Players");

  if (!sheet) {
    throw new Error(
      'Missing required sheet: "NHL Players".'
    );
  }

  const rows =
    getNHLObjectsFromSheet_(sheet);

  const index = {};

  rows.forEach(row => {
    const playerId =
      String(
        row["Id"] || ""
      ).trim();

    if (!playerId) {
      return;
    }

    const playerName =
      String(
        row["Full Name"] || ""
      ).trim();

    const team =
      String(
        row["Team Abbreviation"] || ""
      ).trim();

    index[playerId] = {
      playerName:
        playerName || null,

      team:
        team || null
    };
  });

  return index;
}

