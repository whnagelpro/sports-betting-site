      providerRow["Line Value"],

    type,

    odds:
      providerRow["Odds"],

    updatedAt:
      providerRow["Updated At"],

    overOdds:
      providerRow["Over Odds"],

    underOdds:
      providerRow["Under Odds"],


    // O:P — IDENTITY
    playerName:
      identity.playerName,

    team:
      identity.team,


    // Q:T — FROZEN NHL PROJECTION
    playerBaseline:
      modelFields.playerBaseline,

    trendAdjustment:
      modelFields.trendAdjustment,

    projectedStat:
      modelFields.projectedStat,

    statStdDev:
      modelFields.statStdDev,


    // U:X — FROZEN NHL PROBABILITY / EV
    modelProbOver:
      modelFields.modelProbOver,

