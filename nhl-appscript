function refreshNHLPlayerPropsSheet() {
  const sheetName = "Player Props";
  const scheduleSheetName = "Schedule";

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName(sheetName);

  const scheduleSheet =
    ss.getSheetByName(scheduleSheetName);

  if (!sheet) {
    throw new Error(
      `Sheet "${sheetName}" not found.`
    );
  }

  if (!scheduleSheet) {
    throw new Error(
      `Sheet "${scheduleSheetName}" not found.`
    );
  }

  Logger.log(
    "Refreshing NHL player props using universal A:AJ production output..."
  );

  // --------------------------------------------------------------------------
  // UNIVERSAL A:AJ SHEET CONTRACT
  // --------------------------------------------------------------------------

  const universalColumnCount =
    NHL_UNIVERSAL_PLAYER_PROPS_HEADERS.length;

  if (universalColumnCount !== 36) {
    throw new Error(
      `NHL universal Player Props header count must be 36; received ${universalColumnCount}.`
    );
  }

  // Make sure the sheet physically has A:AJ available.
  const currentMaxColumns =
    sheet.getMaxColumns();

  if (currentMaxColumns < universalColumnCount) {
    sheet.insertColumnsAfter(
      currentMaxColumns,
      universalColumnCount - currentMaxColumns
    );
  }

  // Row 1 is now the authoritative universal header contract.
  sheet
    .getRange(
      1,
      1,
      1,
      universalColumnCount
    )
    .setValues([
      NHL_UNIVERSAL_PLAYER_PROPS_HEADERS
    ]);

  // Clear ALL stale production rows/formulas in A:AJ.
  // This intentionally clears the old row-2 formula templates.
  clearPlayerPropsData_(sheet);

  // --------------------------------------------------------------------------
  // SCHEDULE
  // --------------------------------------------------------------------------

  const games =
    getGamesFromScheduleSheet_(
      scheduleSheet
    );

  if (!games.length) {
    Logger.log(
      "No schedule rows found. NHL Player Props now contains universal A:AJ headers with no stale prop rows."
    );
    return;
  }

  const gameMap = {};

  games.forEach(game => {
    gameMap[String(game.id)] = {
      game_date:
        game.game_date ?? "",

      away_team:
        game.away_team ?? "",

      home_team:
        game.home_team ?? ""
    };
  });

  // --------------------------------------------------------------------------
  // BUILD P12 CONTEXT ONCE PER REFRESH
  // --------------------------------------------------------------------------

  Logger.log(
    "Building NHL Player Props historical, trend, and identity indexes..."
  );

  const historyIndex =
    buildNHLPlayerPropHistoryIndex_();

  const trendIndex =
    buildNHLPlayerTrendIndex_();

  const playerIdentityIndex =
    buildNHLPlayerIdentityIndex_();

  Logger.log(
    "NHL Player Props context indexes built."
  );

  // --------------------------------------------------------------------------
  // FETCH PROVIDER PROPS + BUILD UNIVERSAL ROWS
  // --------------------------------------------------------------------------

  const allRows = [];

  const seenPropIds =
    new Set();

  games.forEach((game, index) => {
    Logger.log(
      `Fetching NHL props for game ${index + 1}/${games.length} (ID: ${game.id})`
    );

    const props =
      fetchAllNHLPlayerPropsForGame_(
        game.id
      );

    const gameInfo =
      gameMap[String(game.id)] || {};

    Logger.log(
      `Returned ${props.length} NHL props for game ID ${game.id}`
    );

    props.forEach(prop => {
      const propId =
        String(
          prop.id ?? ""
        );

      if (
        propId &&
        seenPropIds.has(propId)
      ) {
        return;
      }

      if (propId) {
        seenPropIds.add(propId);
      }

      const playerId =
        prop.player_id ??
        (
          prop.player
            ? prop.player.id
            : null
        ) ??
        "";

      const vendor =
        prop.vendor ??
        prop.sportsbook ??
        prop.bookmaker ??
        "";

      const propType =
        prop.prop_type ??
        (
          typeof prop.market === "string"
            ? prop.market
            : ""
        );

      const lineValue =
        prop.line ??
        prop.line_value ??
        "";

      const typeValue =
        (
          prop.market &&
          typeof prop.market === "object"
        )
          ? (
              prop.market.type ??
              ""
            )
          : "";

      const odds =
        (
          prop.market &&
          typeof prop.market === "object"
        )
          ? (
              prop.market.odds ??
              ""
            )
          : "";

      const updatedAt =
        prop.updated_at ??
        "";

      const overOdds =
        (
          prop.market &&
          typeof prop.market === "object"
        )
          ? (
              prop.market.over_odds ??
              ""
            )
          : "";

      const underOdds =
        (
          prop.market &&
          typeof prop.market === "object"
        )
          ? (
              prop.market.under_odds ??
              ""
            )
          : "";

      // ----------------------------------------------------------------------
      // Provider/raw A:N object
      //
      // These exact keys are the input contract already consumed by
      // buildNHLUniversalPropRowFromProvider_().
      // ----------------------------------------------------------------------

      const providerRow = {
        "Game Id":
          game.id ?? "",

        "Game Date":
          gameInfo.game_date ?? "",

        "Away Team":
          gameInfo.away_team ?? "",

        "Home Team":
          gameInfo.home_team ?? "",

        "Id":
          prop.id ?? "",

        "Player Id":
          playerId,

        "Vendor":
          vendor,

        "Prop Type":
          propType,

        "Line Value":
          lineValue,

        "Type":
          typeValue,

        "Odds":
          odds,

        "Updated At":
          updatedAt,

        "Over Odds":
          overOdds,

        "Under Odds":
          underOdds
      };

      // ----------------------------------------------------------------------
      // P12 D5 -> D6 PRODUCTION CUTOVER
      // ----------------------------------------------------------------------

      const universalRow =
        buildNHLUniversalPropRowFromProvider_({
          providerRow,
          historyIndex,
          trendIndex,
          playerIdentityIndex
        });

      if (!universalRow) {
        return;
      }

      if (
        !Array.isArray(universalRow) ||
        universalRow.length !== universalColumnCount
      ) {
        throw new Error(
          `Invalid NHL universal Player Props row width for prop ID ${propId || "(missing ID)"}: expected ${universalColumnCount}, received ${
            Array.isArray(universalRow)
              ? universalRow.length
              : "non-array"
          }.`
        );
      }

      allRows.push(
        universalRow
      );
    });

    Utilities.sleep(200);
  });

  // --------------------------------------------------------------------------
  // WRITE UNIVERSAL VALUE ROWS
  // --------------------------------------------------------------------------

  if (!allRows.length) {
    Logger.log(
      "No NHL player props were returned for the schedule slate. Universal A:AJ headers remain and stale rows were cleared."
    );
    return;
  }

  sheet
    .getRange(
      2,
      1,
      allRows.length,
      universalColumnCount
    )
    .setValues(
      allRows
    );

  Logger.log(
    `Wrote ${allRows.length} NHL universal Player Props rows to "${sheetName}" across A:AJ.`
  );
}

