  }

  ensurePropFormulaTemplates_(sheet);
  ensureNameFormulaTemplates_(sheet);

  Logger.log("Refreshing NHL player props using Schedule tab game IDs...");

  const games = getGamesFromScheduleSheet_(scheduleSheet);

  if (!games.length) {
    clearPlayerPropsData_(sheet);
    Logger.log("No schedule rows found, so Player Props was cleared.");
    return;
  }

  const gameMap = {};
  games.forEach(game => {
    gameMap[String(game.id)] = {
      game_date: game.game_date || "",
      away_team: game.away_team || "",
      home_team: game.home_team || ""
    };
  });

  const allRows = [];
  const seenPropIds = new Set();

  games.forEach((game, index) => {
    Logger.log(`Fetching NHL props for game ${index + 1}/${games.length} (ID: ${game.id})`);

    const props = fetchAllNHLPlayerPropsForGame_(game.id);
    const gameInfo = gameMap[String(game.id)] || {};

    Logger.log(`Returned ${props.length} NHL props for game ID ${game.id}`);

    props.forEach(prop => {
      const propId = String(prop.id || "");
      if (propId && seenPropIds.has(propId)) return;
      if (propId) seenPropIds.add(propId);

      const playerId =
        prop.player_id ||
        (prop.player && prop.player.id) ||
        "";

      const vendor =
        prop.vendor ||
        prop.sportsbook ||
        prop.bookmaker ||
        "";

      const propType =
        prop.prop_type ||
        prop.market ||
        "";

      const lineValue =
        prop.line ||
        prop.line_value ||
        "";

      const typeValue =
        (prop.market && prop.market.type) ||
        "";

      const odds =
        (prop.market && prop.market.odds) ||
        "";

      const updatedAt =
        prop.updated_at ||
        "";

      const overOdds =
        (prop.market && prop.market.over_odds) ||
        "";

      const underOdds =
        (prop.market && prop.market.under_odds) ||
        "";

      allRows.push([
        game.id,                  // A Game Id
        gameInfo.game_date,       // B Game Date
        gameInfo.away_team,       // C Away Team
        gameInfo.home_team,       // D Home Team
        prop.id || "",            // E Id
        playerId,                 // F Player Id
        vendor,                   // G Vendor
        propType,                 // H Prop Type
        lineValue,                // I Line Value
        typeValue,                // J Type
        odds,                     // K Odds
        updatedAt,                // L Updated At
        overOdds,                 // M Over Odds
        underOdds                 // N Under Odds
      ]);
    });

    Utilities.sleep(200);
  });

  clearPlayerPropsData_(sheet);

  if (!allRows.length) {
    Logger.log("No NHL player props were returned for the schedule slate.");
    return;
  }

  sheet.getRange(3, 1, allRows.length, 14).setValues(allRows);
  copyFormulaTemplatesDown_(sheet, allRows.length);

  Logger.log(`Wrote ${allRows.length} NHL player props rows to "${sheetName}" using Schedule tab game IDs.`);
}

