//
// Uses the same frozen P9 projection model.
// Unsupported markets remain unavailable.
// ============================================================================

function standardDeviationNHL_(values) {
  if (!Array.isArray(values)) {
    return null;
  }

  const clean =
    values
      .map(value => Number(value))
      .filter(value =>
        Number.isFinite(value)
      );

  if (clean.length < 2) {
    return null;
  }

  const mean =
    clean.reduce(
      (sum, value) =>
        sum + value,
      0
    ) / clean.length;

  const variance =
    clean.reduce(
      (sum, value) => {
        const diff =
          value - mean;

        return (
          sum +
          diff * diff
        );
      },
      0
    ) /
    (
      clean.length - 1
    );

  return Math.sqrt(
    variance
  );
}


function buildNHLPlayerPropHistoryIndex_() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName(
      "NHL Player Game Logs"
    );

  if (!sheet) {
    throw new Error(
      'Missing required sheet: "NHL Player Game Logs".'
    );
  }

  const rows =
    getNHLObjectsFromSheet_(
      sheet
    );

  const index = {};

  rows.forEach(row => {
    const playerId =
      String(
        row["Player ID"] || ""
      ).trim();

    if (!playerId) {
      return;
    }

    if (!index[playerId]) {
      index[playerId] = [];
    }

    index[playerId].push(
      row
    );
  });

  Object.keys(
    index
  ).forEach(playerId => {
    index[playerId].sort(
      (a, b) =>
        getNHLBacktestDateValue_(a) -
        getNHLBacktestDateValue_(b)
    );
  });

  return index;
}


function getNHLUniversalPropHistoricalContext_({
  playerId,
  propType,
  historyIndex
}) {
  const id =
    String(
      playerId || ""
    ).trim();

  const rawMarket =
    String(
      propType || ""
    )
      .trim()
      .toLowerCase();

  if (
    !id ||
    !rawMarket ||
    !historyIndex
  ) {
    return null;
  }

  const marketConfig =
    NHL_PROVIDER_PROP_MARKETS[
      rawMarket
    ];

  if (
    !marketConfig ||
    (
      marketConfig.status !==
        "SUPPORTED" &&
      marketConfig.status !==
        "SUPPORTED_MILESTONE"
    )
  ) {
    return null;
  }

  const modelKey =
    marketConfig.modelKey;

  const statHeader =
    marketConfig.historicalStat;

  if (
    !modelKey ||
    !statHeader
  ) {
    return null;
  }

  const playerGames =
    historyIndex[id] || [];

  if (!playerGames.length) {
    return null;
  }

  // Role integrity:
  // goalie markets use Position G;
  // skater markets exclude Position G.
  const eligibleGames =
    playerGames.filter(row => {
      const position =
        String(
          row["Position"] || ""
        )
          .trim()
          .toUpperCase();

      if (!position) {
        return false;
      }

      if (
        marketConfig.role ===
        "goalie"
      ) {
        return position === "G";
      }

      if (
        marketConfig.role ===
        "skater"
      ) {
        return position !== "G";
      }

      return false;
    });

  if (!eligibleGames.length) {
    return null;
  }

  const values =
    eligibleGames
      .map(row => {
        const raw =
          row[statHeader];

        if (
          raw === "" ||
          raw === null ||
          raw === undefined
        ) {
          return null;
        }

        const value =
          Number(raw);

        return Number.isFinite(value)
          ? value
          : null;
      })
      .filter(value =>
        value !== null
      );

  if (!values.length) {
    return null;
  }

  const playerBaseline =
    avgNHL_(
      values
    );

  if (
    playerBaseline === null ||
    !Number.isFinite(
      playerBaseline
    )
  ) {
    return null;
  }

  const recentValues =
    values.slice(-5);

  const recent5Average =
    recentValues.length
      ? avgNHL_(
          recentValues
        )
      : playerBaseline;

  const projection =
    calculateNHLPropProjection_(
      rawMarket,
      playerBaseline,
      recent5Average
    );

  if (
    !projection ||
    projection.projectedStat ===
      null ||
    !Number.isFinite(
      projection.projectedStat
    )
  ) {
    return null;
  }

  let statStdDev = null;

  // ------------------------------------------------------------------------
  // POISSON MARKETS
  //
  // For the production probability model:
  // variance = mean
  // SD = sqrt(mean)
  //
  // T therefore represents the uncertainty implied by the frozen
  // production distribution, not an unrelated empirical SD.
  // ------------------------------------------------------------------------

  if (
    modelKey !== "saves"
  ) {
    statStdDev =
      Math.sqrt(
        Math.max(
          0,
          projection.projectedStat
        )
      );
  }

  // ------------------------------------------------------------------------
  // SAVES
  //
  // Saves uses the Negative Binomial model.
  // Preserve historical dispersion in T.
  // ------------------------------------------------------------------------

  else {
    statStdDev =
      standardDeviationNHL_(
        values
      );
  }

  return {
    playerId:
      id,

    market:
      modelKey,

    rawMarket,

    games:
      values.length,

    priorValues:
      values.slice(),

    recent5Average,

    playerBaseline:
      projection.playerBaseline,

    trendAdjustment:
      projection.trendAdjustment,

    projectedStat:
      projection.projectedStat,

    statStdDev
  };
}

// ============================================================================
// P12 D3 — NHL UNIVERSAL PROP MODEL OUTPUT
//
// Connects validated historical context (Q:T)
// to frozen P10 probability + EV engine (U:X).
//
// No calibration shrink is applied.
// P11 froze NHL production probabilities as RAW.
// ============================================================================

function getNHLUniversalPropModelOutput_({
  propType,
  lineValue,
  type,
  odds,
  overOdds,
  underOdds,
  historicalContext
}) {
  if (!historicalContext) {
    return {
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null
    };
  }

  const rawMarket =
    String(
      propType || ""
    )
      .trim()
      .toLowerCase();

  const marketConfig =
    NHL_PROVIDER_PROP_MARKETS[
      rawMarket
    ];

  if (
    !marketConfig ||
    (
      marketConfig.status !== "SUPPORTED" &&
      marketConfig.status !== "SUPPORTED_MILESTONE"
    )
  ) {
    return {
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null
    };
  }

  if (
    lineValue === null ||
    lineValue === undefined ||
    lineValue === ""
  ) {
    return {
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null
    };
  }

  const line =
    Number(lineValue);

  if (!Number.isFinite(line)) {
    return {
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null
    };
  }

  const normalizedType =
    String(
      type || ""
    )
      .trim()
      .toLowerCase();

  const isMilestone =
    normalizedType === "milestone" ||
    marketConfig.status ===
      "SUPPORTED_MILESTONE";

  const result =
    calculateNHLProductionPropModel_({
      market:
        rawMarket,

      projectedStat:
        historicalContext.projectedStat,

      line,

      type:
        isMilestone
          ? "milestone"
          : "over_under",

      overOdds:
        isMilestone
          ? null
          : overOdds,

      underOdds:
        isMilestone
          ? null
          : underOdds,

      milestoneOdds:
        isMilestone
          ? odds
          : null,

      priorValues:
        historicalContext.priorValues
    });

  if (!result) {
    return {
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null
    };
  }

  return {
    modelProbOver:
      result.modelProbOver,

    modelProbUnder:
      result.modelProbUnder,

    evOver:
      result.evOver,

    evUnder:
      result.evUnder
  };
}

function buildNHLUniversalPropModelFields_({
  playerId,
  propType,
  lineValue,
  type,
  odds,
  overOdds,
  underOdds,
  historyIndex
}) {
  const historicalContext =
    getNHLUniversalPropHistoricalContext_({
      playerId,
      propType,
      historyIndex
    });

  if (!historicalContext) {
    return {
      playerBaseline: null,
      trendAdjustment: null,
      projectedStat: null,
      statStdDev: null,
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null
    };
  }

  const modelOutput =
    getNHLUniversalPropModelOutput_({
      propType,
      lineValue,
      type,
      odds,
      overOdds,
      underOdds,
      historicalContext
    });

  return {
    playerBaseline:
      historicalContext.playerBaseline,

    trendAdjustment:
      historicalContext.trendAdjustment,

    projectedStat:
      historicalContext.projectedStat,

    statStdDev:
      historicalContext.statStdDev,

    modelProbOver:
      modelOutput.modelProbOver,

    modelProbUnder:
      modelOutput.modelProbUnder,

    evOver:
      modelOutput.evOver,

    evUnder:
      modelOutput.evUnder
  };
}

