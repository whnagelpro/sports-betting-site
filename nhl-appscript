function getNHLAmericanImpliedProbability_(value) {
  const odds =
    parseNHLAmericanOdds_(
      value
    );

  if (odds === null) {
    return null;
  }

  if (odds > 0) {
    return 100 / (odds + 100);
  }

  return (
    Math.abs(odds) /
    (
      Math.abs(odds) +
      100
    )
  );
}

function buildNHLUniversalDecisionFields_({
  type,
  odds,
  overOdds,
  underOdds,
  modelProbOver,
  modelProbUnder,
  evOver,
  evUnder
}) {
  const normalizedType =
    String(
      type || ""
    )
      .trim()
      .toLowerCase();

  const isMilestone =
    normalizedType ===
    "milestone";

  const validOverEV =
    evOver !== null &&
    evOver !== undefined &&
    evOver !== "" &&
    Number.isFinite(
      Number(evOver)
    );

  const validUnderEV =
    !isMilestone &&
    evUnder !== null &&
    evUnder !== undefined &&
    evUnder !== "" &&
    Number.isFinite(
      Number(evUnder)
    );

  // No price/model output means there is no usable decision.
  if (
    !validOverEV &&
    !validUnderEV
  ) {
    return {
      bestSide: "No Play",
      bestEV: null,
      bestModelProbability: null,
      bestPriceEdge: null
    };
  }

  let bestSide = null;
  let bestEV = null;
  let bestModelProbability = null;
  let selectedOdds = null;

  // Milestone markets only have the achievement side.
  if (isMilestone) {
    bestSide =
      "Over";

    bestEV =
      Number(evOver);

    bestModelProbability =
      modelProbOver !== null &&
      modelProbOver !== undefined &&
      modelProbOver !== "" &&
      Number.isFinite(
        Number(modelProbOver)
      )
        ? Number(modelProbOver)
        : null;

    selectedOdds =
      odds;
  }

  // Conventional markets select whichever available side has greater EV.
  else if (
    validOverEV &&
    validUnderEV
  ) {
    if (
      Number(evOver) >=
      Number(evUnder)
    ) {
      bestSide =
        "Over";

      bestEV =
        Number(evOver);

      bestModelProbability =
        Number(
          modelProbOver
        );

      selectedOdds =
        overOdds;
    } else {
      bestSide =
        "Under";

      bestEV =
        Number(evUnder);

      bestModelProbability =
        Number(
          modelProbUnder
        );

      selectedOdds =
        underOdds;
    }
  }

  else if (validOverEV) {
    bestSide =
      "Over";

    bestEV =
      Number(evOver);

    bestModelProbability =
      modelProbOver !== null &&
      modelProbOver !== undefined &&
      modelProbOver !== "" &&
      Number.isFinite(
        Number(modelProbOver)
      )
        ? Number(modelProbOver)
        : null;

    selectedOdds =
      overOdds;
  }

  else {
    bestSide =
      "Under";

    bestEV =
      Number(evUnder);

    bestModelProbability =
      modelProbUnder !== null &&
      modelProbUnder !== undefined &&
      modelProbUnder !== "" &&
      Number.isFinite(
        Number(modelProbUnder)
      )
        ? Number(modelProbUnder)
        : null;

    selectedOdds =
      underOdds;
  }


  const impliedProbability =
    getNHLAmericanImpliedProbability_(
      selectedOdds
    );


  const bestPriceEdge =
    bestModelProbability !== null &&
    impliedProbability !== null
      ? (
          bestModelProbability -
          impliedProbability
        )
      : null;


  return {
    bestSide,
    bestEV,
    bestModelProbability,
    bestPriceEdge
  };
}

function buildNHLPlayerTrendIndex_() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName(
      "NHL Player Trends"
    );

  if (!sheet) {
    throw new Error(
      'Missing required sheet: "NHL Player Trends".'
    );
  }

  const rows =
    getNHLObjectsFromSheet_(
      sheet
    );

  const index = {};

  rows.forEach(row => {
    const playerId =
      String(
        row["Player ID"] || ""
      ).trim();

    const statType =
      String(
        row["Stat Type"] || ""
      ).trim();

    if (
      !playerId ||
      !statType
    ) {
      return;
    }

    const key =
      `${playerId}::${statType}`;

    index[key] =
      row;
  });

  return index;
}

function getNHLUniversalTrendStatLabel_(
  propType
) {
  const rawMarket =
    String(
      propType || ""
    )
      .trim()
      .toLowerCase();

  const config =
    NHL_PROVIDER_PROP_MARKETS[
      rawMarket
    ];

  if (
    !config ||
    !config.modelKey
  ) {
    return null;
  }

  const labels = {
    shots_on_goal:
      "Shots On Goal",

    points:
      "Points",

    assists:
      "Assists",

    goals:
      "Goals",

    saves:
      "Saves"
  };

  return (
    labels[
      config.modelKey
    ] ||
    null
  );
}

function getNHLUniversalTrendFields_({
  playerId,
  propType,
  trendIndex
}) {
  const id =
    String(
      playerId || ""
    ).trim();

  const statLabel =
    getNHLUniversalTrendStatLabel_(
      propType
    );

  if (
    !id ||
    !statLabel ||
    !trendIndex
  ) {
    return {
      trendScore: null,
      trendStrength: null,
      riskScore: null,
      riskTier: null,
      modelConfidence: null
    };
  }

  const row =
    trendIndex[
      `${id}::${statLabel}`
    ];

  if (!row) {
    return {
      trendScore: null,
      trendStrength: null,
      riskScore: null,
      riskTier: null,
      modelConfidence: null
    };
  }


  const rawTrendScore =
    row["Trend Score"];

  const trendScore =
    rawTrendScore !== "" &&
    rawTrendScore !== null &&
    rawTrendScore !== undefined &&
    Number.isFinite(
      Number(rawTrendScore)
    )
      ? Number(rawTrendScore)
      : null;


  const trendStrength =
    String(
      row["Trend Strength"] || ""
    ).trim() ||
    null;


  const riskTier =
    String(
      row["Risk Tier"] || ""
    ).trim() ||
    null;


  // Reuse Sportacular's existing NHL trend-confidence calculation.
  const confidence =
    calculateTrendConfidence_(
      row
    );


  const modelConfidence =
    Number.isFinite(
      Number(confidence)
    )
      ? Number(confidence)
      : null;


  return {
    trendScore,

    trendStrength,

    // Deferred intentionally until P15.
    riskScore: null,

    riskTier,

    modelConfidence
  };
}

function buildNHLUniversalDecisionTrendFields_({
  playerId,
  propType,
  type,
  odds,
  overOdds,
  underOdds,
  modelProbOver,
  modelProbUnder,
  evOver,
