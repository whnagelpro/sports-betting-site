        0.9834363915913857
    },

    {
      market:
        "points",

      distribution:
        "poisson",

      rawUnder:
        0.9717
    },

    {
      market:
        "saves",

      distribution:
        "negative_binomial",

      rawUnder:
        0.9616
    }

  ];


  // ==========================================================================
  // 1. VERIFY EFFECTIVE SHRINK BEHAVIOR
  // ==========================================================================

  candidateFloors.forEach(
    floor => {

      const shrink0 =
        calculateNHLResidualCalibrationShrink_(
          0,
          floor
        );

      const shrink2 =
        calculateNHLResidualCalibrationShrink_(
          2,
          floor
        );

      const shrink5 =
        calculateNHLResidualCalibrationShrink_(
          5,
          floor
        );

      const shrink10 =
        calculateNHLResidualCalibrationShrink_(
          10,
          floor
        );

      const shrink18 =
        calculateNHLResidualCalibrationShrink_(
          18,
          floor
        );


      Logger.log(
        JSON.stringify(
          {
            case:
              "D10AB NHL residual-floor shrink schedule",

            residualFloor:
              floor,

            effectiveShrink: {
              games0:
                shrink0,

              games2:
                shrink2,

              games5:
                shrink5,

              games10:
                shrink10,

              games18:
                shrink18
            }
          },
          null,
          2
        )
      );


      addTest(
        `${Math.round(
          floor * 100
        )}% floor preserves strong early-sample shrink`,

        Math.abs(
          shrink0 -
          0.45
        ) < 1e-12 &&
        Math.abs(
          shrink2 -
          0.40
        ) < 1e-12 &&
        Math.abs(
          shrink5 -
          0.325
        ) < 1e-12,

        {
          floor,
          shrink0,
          shrink2,
          shrink5
        }
      );


      const expectedAt10 =
        Math.max(
          0.20,
          floor
        );


      addTest(
        `${Math.round(
          floor * 100
        )}% floor behaves correctly at 10 games`,

        Math.abs(
          shrink10 -
          expectedAt10
        ) < 1e-12,

        {
          floor,

          expected:
            expectedAt10,

          actual:
            shrink10
        }
      );


      addTest(
        `${Math.round(
          floor * 100
        )}% floor remains active at mature sample`,

        Math.abs(
          shrink18 -
          floor
        ) < 1e-12,

        {
          floor,

          matureShrink:
            shrink18
        }
      );
    }
  );


  // ==========================================================================
  // 2. INVALID FLOOR PROTECTION
  // ==========================================================================

  addTest(
    "Negative residual floor is rejected",

    calculateNHLResidualCalibrationShrink_(
      18,
      -0.10
    ) === null
  );


  addTest(
    "Residual floor above 1 is rejected",

    calculateNHLResidualCalibrationShrink_(
      18,
      1.10
    ) === null
  );


  // ==========================================================================
  // 3. COMPARE MATURE-SAMPLE CALIBRATION ACROSS MARKETS
  //
  // Use 18 games so sample reliability = 1.
  // Therefore the candidate residual floor becomes the ONLY shrink.
  // ==========================================================================

  const matureResults = [];


  markets.forEach(
    marketConfig => {

      const rawUnder =
        marketConfig.rawUnder;

      const rawOver =
        1 -
        rawUnder;


      candidateFloors.forEach(
        floor => {

          const effectiveShrink =
            calculateNHLResidualCalibrationShrink_(
              18,
              floor
            );


          const calibratedUnder =
            calibrateNHLProbabilityShrink_(
              rawUnder,
              effectiveShrink
            );


          const calibratedOver =
            calibrateNHLProbabilityShrink_(
              rawOver,
              effectiveShrink
            );


          const total =
            calibratedOver +
            calibratedUnder;


          const result = {

            market:
              marketConfig.market,

            distribution:
              marketConfig.distribution,

            games:
              18,

            residualFloor:
              floor,

            effectiveShrink,

            rawOver,
            rawUnder,

            calibratedOver,
            calibratedUnder,

            total
          };


          matureResults.push(
            result
          );


          Logger.log(
            JSON.stringify(
              {
                case:
                  "D10AB NHL mature-sample residual calibration",

                ...result
              },
              null,
              2
            )
          );


          // --------------------------------------------------------------
          // Probability validity
          // --------------------------------------------------------------

          addTest(
            `${marketConfig.market} ${Math.round(
              floor * 100
            )}% floor produces valid probabilities`,

            Number.isFinite(
              calibratedOver
            ) &&
            Number.isFinite(
              calibratedUnder
            ) &&
            calibratedOver >= 0 &&
            calibratedOver <= 1 &&
            calibratedUnder >= 0 &&
            calibratedUnder <= 1,

            result
          );


          // --------------------------------------------------------------
          // Complement integrity
          // --------------------------------------------------------------

          addTest(
            `${marketConfig.market} ${Math.round(
              floor * 100
            )}% floor preserves probability total`,

            Math.abs(
              total -
              1
            ) < 1e-12,

            {
              market:
                marketConfig.market,

              floor,

              total
            }
          );


          // --------------------------------------------------------------
          // Calibration must move BOTH sides toward 50%.
          // --------------------------------------------------------------

          addTest(
            `${marketConfig.market} ${Math.round(
              floor * 100
            )}% floor moves probabilities toward 50 percent`,

            calibratedUnder <
              rawUnder &&
            calibratedUnder >
              0.50 &&
            calibratedOver >
              rawOver &&
            calibratedOver <
              0.50,

            {
              market:
                marketConfig.market,

              floor,

              rawOver,
              rawUnder,

              calibratedOver,
              calibratedUnder
            }
          );


          // --------------------------------------------------------------
          // Stronger side must remain stronger.
          // --------------------------------------------------------------

          addTest(
            `${marketConfig.market} ${Math.round(
              floor * 100
            )}% floor preserves model direction`,

            calibratedUnder >
              calibratedOver,

            {
              market:
                marketConfig.market,

              floor,

              calibratedOver,
              calibratedUnder
            }
          );
        }
      );
    }
  );


  // ==========================================================================
  // 4. STRONGER FLOOR MUST PRODUCE STRONGER CALIBRATION
  // ==========================================================================

  markets.forEach(
    marketConfig => {

      const marketResults =
        matureResults
          .filter(
            result =>
              result.market ===
              marketConfig.market
          )
          .sort(
            (a, b) =>
              a.residualFloor -
              b.residualFloor
          );


      const under5 =
        marketResults[0]
          .calibratedUnder;

      const under10 =
        marketResults[1]
          .calibratedUnder;

      const under15 =
        marketResults[2]
          .calibratedUnder;

      const under20 =
        marketResults[3]
          .calibratedUnder;


      addTest(
        `${marketConfig.market} stronger floors progressively reduce extreme confidence`,

        under5 >
          under10 &&
        under10 >
          under15 &&
        under15 >
          under20,

        {
          under5,
          under10,
          under15,
          under20
        }
      );
    }
  );


  // ==========================================================================
  // 5. EARLY SAMPLE SHOULD STILL BE CONTROLLED BY SAMPLE RELIABILITY
  //
  // At two games:
  //
  // reliability = 0.60
  // sample shrink = 0.40
  //
  // All four candidate residual floors are below 0.40.
  // Therefore every candidate should produce the SAME effective shrink.
  // ==========================================================================

  const earlySampleShrinks =
    candidateFloors.map(
      floor =>
        calculateNHLResidualCalibrationShrink_(
          2,
          floor
        )
    );


  addTest(
    "Two-game sample remains controlled by reliability rather than residual floor",

    earlySampleShrinks.every(
      shrink =>
        Math.abs(
          shrink -
          0.40
        ) < 1e-12
    ),

    {
      candidateFloors,
      effectiveShrinks:
        earlySampleShrinks
    }
  );


  // ==========================================================================
  // 6. DIAGNOSTIC SUMMARY
  // ==========================================================================

  const diagnosticSummary =
    markets.map(
      marketConfig => {

        const rows =
          matureResults.filter(
            result =>
              result.market ===
              marketConfig.market
          );


        return {

          market:
            marketConfig.market,

          distribution:
            marketConfig.distribution,

          rawUnder:
            marketConfig.rawUnder,

          candidates:
            rows.map(
              row => ({
                floor:
                  row.residualFloor,

                calibratedUnder:
                  row.calibratedUnder
              })
            )
        };
      }
    );


  Logger.log(
    JSON.stringify(
      {
        case:
          "D10AB NHL RESIDUAL FLOOR COMPARISON",

        diagnosticSummary
      },
      null,
      2
    )
  );


  // ==========================================================================
  // FINAL
  // ==========================================================================

  const pass =
    tests.every(
      test =>
        test.pass === true
    );


  const output = {

    test:
      "D10AB NHL RESIDUAL CALIBRATION FLOOR VALIDATION",

    candidateFloors,

    tests:
      tests.length,

    passed:
      tests.filter(
        test =>
          test.pass === true
      ).length,

    pass,

    diagnosticSummary,

    results:
      tests
  };


  Logger.log(
    JSON.stringify(
      output,
      null,
      2
    )
  );


  return output;
}

// ============================================================================
// D10AB STEP 5 — NHL EMPIRICAL RESIDUAL-FLOOR DEVELOPMENT SEARCH
//
// Purpose:
//   Compare the candidate residual calibration floors on chronological
//   DEVELOPMENT data using the frozen NHL production probability engine.
//
// IMPORTANT:
//   - RESEARCH / TEST ONLY
//   - Does NOT change production probabilities
//   - Does NOT change EV
//   - Does NOT change Player Props output
//   - Uses only the first 75% of each player's chronological eligible games
//   - Final 25% remains untouched for later holdout validation
//
// Candidate residual floors:
//   0%, 5%, 10%, 15%, 20%
//
// Effective shrink:
//   max(
//     1 - sampleReliability,
//     residualFloor
//   )
//
// Primary metric:
//   Brier Score — lower is better
//
// Secondary diagnostic:
//   Absolute calibration gap — closer to zero is better
// ============================================================================

function testNHLEmpiricalResidualFloorDevelopment_D10AB() {

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sourceSheet =
    ss.getSheetByName(
      "NHL Player Game Logs"
    );

  if (!sourceSheet) {
    throw new Error(
      'Missing required sheet: "NHL Player Game Logs".'
    );
  }


  const candidateFloors = [
    0.00,
    0.05,
    0.10,
    0.15,
    0.20
  ];


  const allRows =
    getNHLObjectsFromSheet_(
      sourceSheet
    )
      .filter(
        isNHLRegularSeasonResearchDate_
      );


  const output = [];

  const aggregateByFloor = {};

  candidateFloors.forEach(
    floor => {

      aggregateByFloor[floor] = {
        predictions: 0,
        predictedTotal: 0,
        actualTotal: 0,
        brierTotal: 0
      };

    }
  );


  Object.keys(
    NHL_CALIBRATION_AUDIT_MARKETS
  ).forEach(
    marketKey => {

      const config =
        NHL_CALIBRATION_AUDIT_MARKETS[
          marketKey
        ];


      const eligibleRows =
        allRows.filter(
          row =>
            isNHLEligiblePropGame_(
              row,
              config
            )
        );


      const playerGames = {};


      eligibleRows.forEach(
        row => {

          const playerId =
            String(
              row["Player ID"] || ""
            ).trim();


          if (!playerId) {
            return;
          }


          if (!playerGames[playerId]) {
            playerGames[playerId] = [];
          }


          playerGames[playerId].push(
            row
          );

        }
      );


      Object.keys(
        playerGames
      ).forEach(
        playerId => {

          playerGames[playerId].sort(
            (a, b) =>
              getNHLBacktestDateValue_(a) -
              getNHLBacktestDateValue_(b)
          );

        }
      );


      config.lines.forEach(
        line => {

          candidateFloors.forEach(
            residualFloor => {

              let predictions = 0;

              let predictedTotal = 0;

              let actualTotal = 0;

              let brierTotal = 0;


              Object.keys(
                playerGames
              ).forEach(
                playerId => {

                  const games =
                    playerGames[playerId];


                  // Need enough history to create both:
                  //   1. usable development predictions
                  //   2. an untouched chronological holdout
                  if (games.length < 14) {
                    return;
                  }


                  const developmentEnd =
                    Math.max(
                      10,
                      Math.floor(
                        games.length *
                        0.75
                      )
                    );


                  if (
                    developmentEnd <= 10
                  ) {
                    return;
                  }


                  for (
                    let i = 10;
                    i < developmentEnd;
                    i++
                  ) {

                    const priorGames =
                      games.slice(
                        0,
                        i
                      );


                    const priorValues =
                      priorGames
                        .map(
                          row =>
                            getNHLBacktestStatValue_(
                              row,
                              config
                            )
                        )
                        .filter(
                          value =>
                            value !== null &&
                            Number.isFinite(
                              value
                            )
                        );


                    if (
                      priorValues.length <
                      10
                    ) {
                      continue;
                    }


                    const recentValues =
                      priorValues.slice(
                        -5
                      );


                    if (
                      recentValues.length <
                      5
                    ) {
                      continue;
                    }


                    const seasonAverage =
                      avgNHL_(
                        priorValues
                      );


                    const recentAverage =
                      avgNHL_(
                        recentValues
                      );


                    const projection =
                      calculateNHLPropProjection_(
                        marketKey,
                        seasonAverage,
                        recentAverage
                      );


                    if (
                      !projection ||
                      !Number.isFinite(
                        projection
                          .projectedStat
                      )
                    ) {
                      continue;
                    }


                    const probabilities =
                      calculateNHLProductionProbabilities_({

                        market:
                          marketKey,

                        projectedStat:
                          projection
                            .projectedStat,

                        line,

                        type:
                          "over_under",

                        priorValues:
                          marketKey ===
                          "saves"
                            ? priorValues
                            : null

                      });


                    if (
                      !probabilities ||
                      probabilities
                        .modelProbOver ===
                        null ||
                      !Number.isFinite(
                        probabilities
                          .modelProbOver
                      )
                    ) {
                      continue;
                    }


                    // ----------------------------------------------------------
                    // D10AB dynamic sample reliability + residual floor
                    // ----------------------------------------------------------

                    const effectiveShrink =
                      calculateNHLResidualCalibrationShrink_(
                        priorValues.length,
                        residualFloor
                      );


                    if (
                      effectiveShrink ===
                      null
                    ) {
                      continue;
                    }


                    const calibratedProbability =
                      calibrateNHLProbabilityShrink_(
                        probabilities
                          .modelProbOver,
                        effectiveShrink
                      );


                    if (
                      calibratedProbability ===
                      null ||
                      !Number.isFinite(
                        calibratedProbability
                      )
                    ) {
                      continue;
                    }


                    const actualValue =
                      getNHLBacktestStatValue_(
                        games[i],
                        config
                      );


                    if (
                      actualValue === null ||
                      !Number.isFinite(
                        actualValue
                      )
                    ) {
                      continue;
                    }


                    const outcome =
                      actualValue > line
                        ? 1
                        : 0;


                    const error =
                      calibratedProbability -
                      outcome;


                    predictedTotal +=
                      calibratedProbability;

                    actualTotal +=
                      outcome;

                    brierTotal +=
                      error * error;

                    predictions++;


                    const aggregate =
                      aggregateByFloor[
                        residualFloor
                      ];


                    aggregate.predictions++;

                    aggregate.predictedTotal +=
                      calibratedProbability;

                    aggregate.actualTotal +=
                      outcome;

                    aggregate.brierTotal +=
                      error * error;

                  }

                }
              );


              if (!predictions) {

                output.push([
                  marketKey,
                  config.label,
                  line,
                  residualFloor,
                  0,
                  "",
                  "",
                  "",
                  ""
                ]);

                return;
              }


              const averagePredicted =
                predictedTotal /
                predictions;


              const actualRate =
                actualTotal /
                predictions;


              const calibrationGap =
                averagePredicted -
                actualRate;


              const brier =
                brierTotal /
                predictions;


              output.push([
                marketKey,
                config.label,
                line,
                residualFloor,
                predictions,
                averagePredicted,
                actualRate,
                calibrationGap,
                brier
              ]);

            }
          );

        }
      );

    }
  );


  // ==========================================================================
  // AGGREGATE RESULTS
  // ==========================================================================

  const aggregateOutput =
    candidateFloors.map(
      floor => {

        const result =
          aggregateByFloor[
            floor
          ];


        if (
          !result ||
          !result.predictions
        ) {

          return {
            residualFloor:
              floor,

            predictions:
              0,

            averagePredicted:
              null,

            actualRate:
              null,

            calibrationGap:
              null,

            absoluteCalibrationGap:
              null,

            brier:
              null
          };

        }


        const averagePredicted =
          result.predictedTotal /
          result.predictions;


        const actualRate =
          result.actualTotal /
          result.predictions;


        const calibrationGap =
          averagePredicted -
          actualRate;


        const brier =
          result.brierTotal /
          result.predictions;


        return {
          residualFloor:
            floor,

          predictions:
            result.predictions,

          averagePredicted,

          actualRate,

          calibrationGap,

          absoluteCalibrationGap:
            Math.abs(
              calibrationGap
            ),

          brier
        };

      }
    );


  // ==========================================================================
  // RANK BY BRIER
  // ==========================================================================

  const ranked =
    aggregateOutput
      .filter(
        result =>
          result.predictions > 0 &&
          Number.isFinite(
            result.brier
          )
      )
      .slice()
      .sort(
        (a, b) => {

          if (
            Math.abs(
              a.brier -
              b.brier
            ) > 1e-12
          ) {
            return (
              a.brier -
              b.brier
            );
          }


          // Tie-breaker:
          // smaller absolute calibration gap
          if (
            Math.abs(
              a.absoluteCalibrationGap -
              b.absoluteCalibrationGap
            ) > 1e-12
          ) {
            return (
              a.absoluteCalibrationGap -
              b.absoluteCalibrationGap
            );
          }


          // Final conservative tie-breaker:
          // smaller residual floor
          return (
            a.residualFloor -
            b.residualFloor
          );

        }
      );


  const developmentWinner =
    ranked.length
      ? ranked[0]
      : null;


  // ==========================================================================
  // WRITE DIAGNOSTIC SHEET
  // ==========================================================================

  const sheetName =
    "NHL Residual Floor Dev";


  let outputSheet =
    ss.getSheetByName(
      sheetName
    );


  if (!outputSheet) {

    outputSheet =
      ss.insertSheet(
        sheetName
      );

  } else {

    outputSheet.clearContents();

  }


  const headers = [
    "Market Key",
    "Market",
    "Line",
    "Residual Floor",
    "Predictions",
    "Avg Calibrated Probability",
    "Actual Over Rate",
    "Calibration Gap",
    "Brier Score"
  ];


  outputSheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([
      headers
    ]);


  if (output.length) {

    outputSheet
      .getRange(
        2,
        1,
        output.length,
        headers.length
      )
      .setValues(
        output
      );


    outputSheet
      .getRange(
        2,
        4,
        output.length,
        1
      )
      .setNumberFormat(
        "0%"
      );


    outputSheet
      .getRange(
        2,
        6,
        output.length,
        3
      )
      .setNumberFormat(
        "0.00%"
      );


    outputSheet
      .getRange(
        2,
        9,
        output.length,
        1
      )
      .setNumberFormat(
        "0.000000"
      );

  }


  outputSheet.setFrozenRows(1);


  outputSheet.autoResizeColumns(
    1,
    headers.length
  );


  // ==========================================================================
  // VALIDATION
  // ==========================================================================

  const expectedRows =
    Object.values(
      NHL_CALIBRATION_AUDIT_MARKETS
    ).reduce(
      (sum, config) =>
        sum +
        (
          config.lines.length *
          candidateFloors.length
        ),
      0
    );


  const pass =
    output.length ===
      expectedRows &&
    output.every(
      row =>
        row[4] > 0 &&
        Number.isFinite(
          Number(row[5])
        ) &&
        Number.isFinite(
          Number(row[6])
        ) &&
        Number.isFinite(
          Number(row[7])
        ) &&
        Number.isFinite(
          Number(row[8])
        )
    ) &&
    aggregateOutput.every(
      result =>
        result.predictions > 0 &&
        Number.isFinite(
          result.brier
        ) &&
        Number.isFinite(
          result.calibrationGap
        )
    ) &&
    developmentWinner !==
      null;


  Logger.log(
    JSON.stringify(
      {
        test:
          "D10AB NHL EMPIRICAL RESIDUAL FLOOR DEVELOPMENT",

        candidateFloors,

        expectedRows,

        actualRows:
          output.length,

        pass,

        aggregateResults:
          aggregateOutput,

        rankedResults:
          ranked,

        developmentWinner
      },
      null,
      2
    )
  );


  if (!pass) {
    throw new Error(
      "D10AB NHL empirical residual-floor development test failed."
    );
  }


  return {
    test:
      "D10AB NHL EMPIRICAL RESIDUAL FLOOR DEVELOPMENT",

    pass,

    aggregateResults:
      aggregateOutput,

    rankedResults:
      ranked,

    developmentWinner
  };
}

// ============================================================================
// D10AB STEP 6 — NHL FINAL MULTI-MARKET HOLDOUT VALIDATION
//
// Purpose:
//   Validate the D10AB sample-size reliability calibration on the untouched
//   final 25% of chronological player appearances.
//
// IMPORTANT:
//   - HOLDOUT / TEST ONLY
//   - Does NOT change production probabilities
//   - Does NOT change EV
//   - Does NOT change Player Props output
//   - Does NOT select or tune any new parameter
//
// Development result already frozen:
//   residualFloor = 0.00
//
// Candidates compared:
//
//   1. RAW
//      Existing production model probability.
//
//   2. RELIABILITY CALIBRATED
//      Existing production probability calibrated using:
//
//        effectiveShrink = max(
//          1 - sampleReliability,
//          0.00
//        )
//
// Holdout:
//   Final 25% of each eligible player's chronological appearances.
//
// Every holdout prediction uses ONLY games before the target appearance.
//
// Primary metric:
//   Brier Score — lower is better.
//
// Secondary diagnostics:
//   Calibration gap and absolute calibration gap.
//
// This function MUST NOT be used to select a different residual floor.
// ============================================================================

function validateNHLReliabilityCalibrationHoldout_D10AB() {

