function isNHLRegularSeasonResearchDate_(row) {
  const raw = row["Game Date"];

  if (!raw) {
    return false;
  }

  let date;

  if (raw instanceof Date) {
    date = new Date(raw);
  } else {
    date = new Date(raw);
  }

  if (
    Number.isNaN(
      date.getTime()
    )
  ) {
    return false;
  }

  const time = date.getTime();

  const start =
    new Date(
      "2025-10-07T00:00:00"
    ).getTime();

  const end =
    new Date(
      "2026-04-16T23:59:59"
    ).getTime();

  return (
    time >= start &&
    time <= end
  );
}

function validateNHLProjectionHoldout() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sourceSheet =
    ss.getSheetByName(
      "NHL Player Game Logs"
    );

  if (!sourceSheet) {
