function strengthRank_(strength) {
  const value = String(strength || "").toLowerCase();
  if (value.includes("elite")) return 100;
  if (value.includes("strong")) return 80;
  if (value.includes("moderate")) return 60;
  if (value.includes("weak")) return 35;
  if (value.includes("cold")) return 15;
  return 0;
}

function clampScore_(value, min, max) {
  return Math.max(min, Math.min(max, value));
}

function calculateTrendConfidence_(row) {
  const strengthScore = strengthRank_(row["Trend Strength"]);
  const hitRate = Number(row["Hit Rate Last 5"] || 0) * 100;
  const trendScore = clampScore_(Number(row["Trend Score"] || 0), -50, 50);
  const consistency = clampScore_(Number(row["Consistency"] || 0), 0, 100);
  const aboveSeason = clampScore_(Number(row["Above Season %"] || 0), -50, 50);
  const last5 = Number(row["Last 5 Avg"] || 0);
  const seasonAvg = Number(row["Season Avg"] || 0);

  const recentForm = seasonAvg > 0
    ? clampScore_((last5 / seasonAvg) * 50, 0, 100)
    : 0;

  return Math.round(clampScore_(
    strengthScore * 0.35 +
    hitRate * 0.25 +
    (trendScore + 50) * 0.15 +
    consistency * 0.10 +
    (aboveSeason + 50) * 0.10 +
    recentForm * 0.05,
    0,
    100
  ));
}

function refreshNHLTopPlayerTrendsSheet() {
  ensureNHLTrendTabs_();

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sourceSheet = ss.getSheetByName("NHL Player Trends");
  let sheet = ss.getSheetByName("NHL Top Player Trends");
  if (!sheet) sheet = ss.insertSheet("NHL Top Player Trends");

  const rows = getNHLObjectsFromSheet_(sourceSheet);

  const headers = [
    "Rank", "Player ID", "Player Name", "Team", "Stat Type",
    "Confidence Score", "Trend Strength", "Hit Rate Last 5",
    "Above Season %", "Trend Score", "Last 5 Avg", "Season Avg",
    "Risk Tier", "Trend Note", "Last Updated"
  ];

  const ranked = rows
    .filter(row => row["Player Name"])
    .map(row => ({ row, confidence: calculateTrendConfidence_(row) }))
    .filter(item => Number(item.row["Hit Rate Last 5"] || 0) >= 0.5)
    .sort((a, b) => b.confidence - a.confidence)
    .slice(0, 25);

  const now = new Date();

  const outputRows = ranked.map((item, index) => {
    const row = item.row;
    return [
      index + 1,
      row["Player ID"] || "",
      row["Player Name"] || "",
      row["Team"] || "",
      row["Stat Type"] || "",
      item.confidence,
      row["Trend Strength"] || "",
      row["Hit Rate Last 5"] || 0,
      row["Above Season %"] || 0,
      row["Trend Score"] || 0,
      row["Last 5 Avg"] || 0,
      row["Season Avg"] || 0,
      row["Risk Tier"] || "",
      row["Trend Note"] || "",
      now
    ];
  });

  writeNHLOutputSheet_(sheet, headers, outputRows);
  sheet.getRange("H:H").setNumberFormat("0%");
  sheet.getRange("I:L").setNumberFormat("0.0");
}

