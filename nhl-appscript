        1
      )
      .setNumberFormat(
        "0.000000"
      );
  }

  outputSheet.setFrozenRows(1);

  outputSheet.autoResizeColumns(
    1,
    headers.length
  );

  const expectedRows =
    Object.values(
      NHL_CALIBRATION_AUDIT_MARKETS
    ).reduce(
      (sum, config) =>
        sum +
        config.lines.length,
      0
    );

  const pass =
    output.length ===
      expectedRows &&
    output.every(row =>
      row[3] > 0 &&
      Number.isFinite(
        Number(row[4])
      ) &&
      Number.isFinite(
        Number(row[5])
      ) &&
      Number.isFinite(
        Number(row[6])
      ) &&
      Number.isFinite(
        Number(row[7])
      )
    );

  Logger.log(
    JSON.stringify({
      test:
        "NHL RAW PROBABILITY CALIBRATION",

      rows:
        output.length,

      expectedRows,

