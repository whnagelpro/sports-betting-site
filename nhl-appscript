// ============================================================================
// P10/18 — NHL PARTICIPATION INTEGRITY
//
// Converts NHL time_on_ice values such as:
//   "16:01" -> 961 seconds
//   "0:45"  -> 45 seconds
//   "00:00" -> 0 seconds
//
// Missing / malformed TOI returns null.
// ============================================================================

function parseNHLTimeOnIceSeconds_(value) {
  if (
    value === null ||
    value === undefined
  ) {
    return null;
  }

  const text =
    String(value).trim();

  if (!text) {
    return null;
  }

  const parts =
    text.split(":");

  if (
    parts.length !== 2 &&
    parts.length !== 3
  ) {
    return null;
  }

  const numbers =
    parts.map(part =>
      Number(part)
    );

  if (
    numbers.some(
      number =>
        !Number.isFinite(number) ||
        number < 0
    )
  ) {
    return null;
  }

  let seconds;

  if (numbers.length === 2) {
    const minutes =
      numbers[0];

    const remainingSeconds =
      numbers[1];

    if (
      remainingSeconds >= 60
    ) {
      return null;
    }

    seconds =
      minutes * 60 +
      remainingSeconds;
  } else {
    const hours =
      numbers[0];

    const minutes =
      numbers[1];

    const remainingSeconds =
      numbers[2];

    if (
      minutes >= 60 ||
      remainingSeconds >= 60
    ) {
      return null;
    }

    seconds =
      hours * 3600 +
      minutes * 60 +
      remainingSeconds;
  }

  return seconds;
}

function testNHLTimeOnIceParser() {
  const tests = [
    {
      input: "16:01",
      expected: 961
    },
    {
      input: "0:45",
      expected: 45
    },
    {
      input: "00:00",
      expected: 0
    },
    {
      input: "0:00",
      expected: 0
    },
    {
      input: "",
      expected: null
    },
    {
      input: null,
      expected: null
    },
    {
      input: undefined,
      expected: null
    },
    {
      input: "bad",
      expected: null
    },
    {
      input: "12:75",
      expected: null
    }
  ];

  let allPassed = true;

  tests.forEach(test => {
    const actual =
      parseNHLTimeOnIceSeconds_(
        test.input
      );

    const pass =
      actual === test.expected;

    if (!pass) {
      allPassed = false;
    }

    Logger.log(
      JSON.stringify({
        test:
          "NHL TOI PARSER",

        input:
          test.input === undefined
            ? "undefined"
            : test.input,

        expected:
          test.expected,

        actual,

        pass
      })
    );
  });

  Logger.log(
    JSON.stringify({
      test:
        "NHL TOI PARSER COMPLETE",

      pass:
        allPassed
    })
  );

  if (!allPassed) {
    throw new Error(
      "NHL time-on-ice parser test failed."
    );
  }
}

function refreshNHLPlayerGameLogsForDateRange_(startDate, endDate) {
  ensureNHLTrendTabs_();

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("NHL Player Game Logs");

  const headers = [
    "Game Date", "Game ID", "Player ID", "Player Name", "Team", "Opponent",
    "Shots On Goal", "Points", "Assists", "Goals", "Power Play Points",
    "Saves", "Blocked Shots", "Hits", "Position"
  ];

  Logger.log(`Refreshing NHL Player Game Logs from ${startDate} to ${endDate}`);

  const selectedGames = getNHLCompletedGamesForDateRange_(startDate, endDate);
  if (!selectedGames.length) return;

  const gameMap = {};
  const gameIds = selectedGames.map(game => {
    const gameId = String(game.id || "");
    gameMap[gameId] = {
      date: getNHLGameAZDate_(game),
      homeTeam: getNHLTeamName_(game.home_team || {}),
      awayTeam: getNHLTeamName_(game.away_team || {})
    };
    return gameId;
  }).filter(Boolean);

  const boxScoreRows = fetchAllNHLBoxScoresForGameIds_(gameIds);
  const rows = [];

  boxScoreRows.forEach(row => {
    const gameId = String(row.game_id || (row.game && row.game.id) || "");
    const gameInfo = gameMap[gameId] || {};

    const playerId = row.player_id || (row.player && row.player.id) || "";
    const playerName = getNHLPlayerNameFromBoxScore_(row);

    const teamName = row.team_name || getNHLTeamName_(row.team || {}) || "";

    const opponent =
      teamName === gameInfo.homeTeam ? gameInfo.awayTeam :
      teamName === gameInfo.awayTeam ? gameInfo.homeTeam : "";

    const shotsOnGoal = getBoxScoreStatFlexible_(row, ["shots_on_goal", "shots", "sog"]);
    const points = getBoxScoreStatFlexible_(row, ["points"]);
    const assists = getBoxScoreStatFlexible_(row, ["assists", "ast"]);
    const goals = getBoxScoreStatFlexible_(row, ["goals"]);
    const powerPlayPoints = getBoxScoreStatFlexible_(row, ["power_play_points", "ppp"]);
    const saves = getBoxScoreStatFlexible_(row, ["saves"]);
    const blockedShots = getBoxScoreStatFlexible_(row, ["blocked_shots", "blocks"]);
    const hits = getBoxScoreStatFlexible_(row, ["hits"]);

    const position =
      String(
        row.position ||
        (row.player && row.player.position_code) ||
        ""
      )
        .trim()
        .toUpperCase();

    if (!playerId && !playerName) return;

    const timeOnIceSeconds =
      parseNHLTimeOnIceSeconds_(
        row.time_on_ice
      );

    const played =
      timeOnIceSeconds !== null &&
      timeOnIceSeconds > 0;

    if (!played) return;

    rows.push([
      gameInfo.date, gameId, playerId, playerName, teamName, opponent,
      shotsOnGoal, points, assists, goals, powerPlayPoints, saves, blockedShots, hits,
      position
    ]);
  });

  upsertRowsByKeyForDateRange_(sheet, headers, rows, [1, 2], startDate, endDate);
  Logger.log(`Upserted ${rows.length} NHL player game-log rows for ${startDate} to ${endDate}.`);
}

