    ),
    {}
  );


  // ==========================================================================
  // 6. MALFORMED ROW PROTECTION
  // ==========================================================================

  record(
    "Production refresh validates universal row is an array",
    source.includes(
      "!Array.isArray(universalRow)"
    ),
    {}
  );


  record(
    "Production refresh validates universal row width",
    source.includes(
      "universalRow.length !== universalColumnCount"
    ),
    {}
  );


  // ==========================================================================
  // 7. COMPLETED ROW IS STORED WITHOUT REBUILDING IT
  // ==========================================================================

  record(
    "Completed universal row is pushed directly into output rows",
    source.includes(
      "allRows.push"
    ) &&
    source.includes(
      "universalRow"
    ),
    {}
  );


  // ==========================================================================
  // 8. FINAL PRODUCTION WRITE
  // ==========================================================================

  record(
    "Production refresh performs final universal row write",
    source.includes(
      ".setValues"
    ) &&
    source.includes(
      "allRows"
    ),
    {}
  );


  record(
    "Production refresh writes starting at column A",
    source.includes(
      "2,\n      1,"
    ) ||
    source.includes(
      "2, 1,"
    ),
    {}
  );


  record(
    "Production refresh writes universal column count",
    source.includes(
      "allRows.length"
    ) &&
    source.includes(
      "universalColumnCount"
    ),
    {}
  );


  // ==========================================================================
  // 9. LEGACY FORMULA PROPAGATION MUST NOT EXIST IN REFRESH
  // ==========================================================================

  const legacyFormulaTokens = [
    "copyPlayerPropsFormula",
    "copyPlayerPropFormula",
    "PASTE_FORMULA"
  ];


  const foundLegacyFormulaTokens =
    legacyFormulaTokens.filter(
      token =>
        source.includes(token)
    );


  record(
    "Production refresh contains no legacy formula propagation",
    foundLegacyFormulaTokens.length === 0,
    {
      found:
        foundLegacyFormulaTokens
    }
  );


  // ==========================================================================
  // 10. NO SECOND MASTER-SCORING PASS IN REFRESH
  //
  // Scoring belongs inside buildNHLUniversalPropRowFromProvider_().
  // The orchestration function should not score the row again.
  // ==========================================================================

  const masterScoringMatches =
    source.match(
      /buildUniversalSportacularScoring_/g
    ) || [];


  record(
    "Production refresh does not independently rerun master scoring",
    masterScoringMatches.length === 0,
    {
      occurrences:
        masterScoringMatches.length
    }
  );


  // ==========================================================================
  // 11. NO DIRECT ACTIONABILITY PASS IN REFRESH
  // ==========================================================================

  const actionabilityMatches =
    source.match(
      /evaluateUniversalActionability_/g
    ) || [];


  record(
    "Production refresh does not independently rerun actionability",
    actionabilityMatches.length === 0,
    {
      occurrences:
        actionabilityMatches.length
    }
  );


  // ==========================================================================
  // 12. NO DIRECT COLUMN-SPECIFIC Y / AE:AJ REWRITE
  //
  // Refresh should write complete A:AJ rows, not patch scoring columns later.
  // ==========================================================================

  const suspiciousRanges = [
    '"Y:Y"',
    '"AE:AE"',
    '"AF:AF"',
    '"AG:AG"',
    '"AH:AH"',
    '"AI:AI"',
    '"AJ:AJ"',
    '"Y2:Y"',
    '"AE2:AE"',
    '"AF2:AF"',
    '"AG2:AG"',
    '"AH2:AH"',
    '"AI2:AI"',
    '"AJ2:AJ"'
  ];


  const foundSuspiciousRanges =
    suspiciousRanges.filter(
      token =>
        source.includes(token)
    );


  record(
    "Production refresh contains no direct Y or AE:AJ patch writes",
    foundSuspiciousRanges.length === 0,
    {
      found:
        foundSuspiciousRanges
    }
  );


  // ==========================================================================
  // 13. ORDERING AUDIT
  //
  // Universal row construction must occur before the final allRows write.
  // ==========================================================================

  const builderIndex =
    source.indexOf(
      "buildNHLUniversalPropRowFromProvider_"
    );


  const finalWriteIndex =
    source.lastIndexOf(
      ".setValues"
    );


  record(
    "Universal row construction occurs before final production write",
    builderIndex >= 0 &&
    finalWriteIndex > builderIndex,
    {
      builderIndex,
      finalWriteIndex
    }
  );


  // ==========================================================================
  // 14. CURRENT PRODUCTION SHEET REMAINS FORMULA-FREE IN A:AJ ROW 2
  //
  // READ ONLY.
  // ==========================================================================

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();


  const sheet =
    ss.getSheetByName(
      "Player Props"
    );


  if (!sheet) {
    record(
      'Production "Player Props" sheet exists',
      false,
      {}
    );

  } else {

    record(
      'Production "Player Props" sheet exists',
      true,
      {}
    );


    const formulas =
      sheet
        .getRange(
          2,
          1,
          1,
          36
        )
        .getFormulas()[0];


    const formulaColumns = [];


    formulas.forEach(
      (formula, index) => {

        if (
          String(
            formula || ""
          ).trim()
        ) {
          formulaColumns.push(
            index + 1
          );
        }

      }
    );


    record(
      "Production row 2 contains no A:AJ formulas",
      formulaColumns.length === 0,
      {
        formulaColumns
      }
    );
  }


  // ==========================================================================
  // FINAL RESULT
  // ==========================================================================

  const passed =
    tests.filter(
      test => test.pass
    ).length;


  const result = {

    test:
      "D10AF NHL PRODUCTION REFRESH ORCHESTRATION AUDIT",

    tests:
      tests.length,

    passed,

    failed:
      tests.length - passed,

    pass:
      passed === tests.length,

    productionPath: [
      "Schedule",
      "fetchAllNHLPlayerPropsForGame_",
      "providerRow A:N",
      "buildNHLUniversalPropRowFromProvider_",
      "universalRow A:AJ",
      "allRows",
      "setValues A:AJ"
    ],

    results:
      tests
  };


  Logger.log(
    JSON.stringify(
      result,
      null,
      2
    )
  );


  if (!result.pass) {
    throw new Error(
      "D10AF NHL production refresh orchestration audit failed."
    );
  }


  return result;
}

