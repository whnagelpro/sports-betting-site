function strengthRank_(strength) {
  const value = String(strength || "").toLowerCase();
  if (value.includes("elite")) return 100;
  if (value.includes("strong")) return 80;
  if (value.includes("moderate")) return 60;
  if (value.includes("weak")) return 35;
  if (value.includes("cold")) return 15;
  return 0;
}

function clampScore_(value, min, max) {
  return Math.max(min, Math.min(max, value));
}

function calculateTrendConfidence_(row) {
  const strengthScore = strengthRank_(row["Trend Strength"]);
  const hitRate = Number(row["Hit Rate Last 5"] || 0) * 100;
  const trendScore = clampScore_(Number(row["Trend Score"] || 0), -50, 50);
  const consistency = clampScore_(Number(row["Consistency"] || 0), 0, 100);
  const aboveSeason = clampScore_(Number(row["Above Season %"] || 0), -50, 50);
  const last5 = Number(row["Last 5 Avg"] || 0);
  const seasonAvg = Number(row["Season Avg"] || 0);

  const recentForm = seasonAvg > 0
    ? clampScore_((last5 / seasonAvg) * 50, 0, 100)
    : 0;

  return Math.round(clampScore_(
    strengthScore * 0.35 +
    hitRate * 0.25 +
    (trendScore + 50) * 0.15 +
    consistency * 0.10 +
    (aboveSeason + 50) * 0.10 +
    recentForm * 0.05,
    0,
    100
  ));
}

