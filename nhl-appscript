  if (!rows.length) {
    throw new Error(
      "NHL box-score endpoint returned no rows."
    );
  }

  // ------------------------------------------------------------
  // Discover available schema.
  // ------------------------------------------------------------

  const topLevelKeys =
    Array.from(
      new Set(
        rows.flatMap(
          row =>
            Object.keys(
              row || {}
            )
        )
      )
    ).sort();

  const playerKeys =
    Array.from(
      new Set(
        rows.flatMap(
          row =>
            row &&
            row.player &&
            typeof row.player === "object"
              ? Object.keys(
                  row.player
                )
              : []
        )
      )
    ).sort();

  const teamKeys =
    Array.from(
      new Set(
        rows.flatMap(
          row =>
            row &&
            row.team &&
            typeof row.team === "object"
              ? Object.keys(
                  row.team
                )
              : []
        )
      )
    ).sort();

  Logger.log(
    JSON.stringify({
      test:
        "NHL BOX SCORE TOP LEVEL KEYS",

      keys:
        topLevelKeys
    })
  );

  Logger.log(
    JSON.stringify({
      test:
        "NHL BOX SCORE PLAYER KEYS",

      keys:
        playerKeys
    })
  );

  Logger.log(
    JSON.stringify({
      test:
        "NHL BOX SCORE TEAM KEYS",

      keys:
        teamKeys
    })
  );

  // ------------------------------------------------------------
  // Identify rows that the CURRENT historical loader would reject.
  // ------------------------------------------------------------

  const rejectedRows = [];

  rows.forEach(row => {
    const shotsOnGoal =
      getBoxScoreStatFlexible_(
        row,
        [
          "shots_on_goal",
          "shots",
          "sog"
        ]
      );

    const points =
      getBoxScoreStatFlexible_(
        row,
        ["points"]
      );

    const assists =
      getBoxScoreStatFlexible_(
        row,
        [
          "assists",
          "ast"
        ]
      );

    const goals =
      getBoxScoreStatFlexible_(
        row,
        ["goals"]
      );

    const powerPlayPoints =
      getBoxScoreStatFlexible_(
        row,
        [
          "power_play_points",
          "ppp"
        ]
      );

    const saves =
      getBoxScoreStatFlexible_(
        row,
        ["saves"]
      );

    const blockedShots =
      getBoxScoreStatFlexible_(
        row,
        [
          "blocked_shots",
          "blocks"
        ]
      );

    const hits =
      getBoxScoreStatFlexible_(
        row,
        ["hits"]
      );

    const currentPlayed =
      shotsOnGoal > 0 ||
      points > 0 ||
      assists > 0 ||
      goals > 0 ||
      powerPlayPoints > 0 ||
      saves > 0 ||
      blockedShots > 0 ||
      hits > 0;

    if (currentPlayed) {
      return;
    }

    const playerId =
      row.player_id ||
      (
        row.player &&
        row.player.id
      ) ||
      "";

    const playerName =
      getNHLPlayerNameFromBoxScore_(
        row
      );

    rejectedRows.push({
      playerId,
      playerName,

      topLevel:
        row
    });
  });

  Logger.log(
    JSON.stringify({
      test:
        "NHL CURRENT FILTER REJECTIONS",

      totalRows:
        rows.length,

      rejectedRows:
        rejectedRows.length,

      rejectionRate:
        rows.length
          ? rejectedRows.length /
            rows.length
          : null
    })
  );

  // Log at most five complete rejected objects.
  // This is what we need to inspect for participation fields.
  rejectedRows
    .slice(0, 5)
    .forEach(
      (item, index) => {

        Logger.log(
          JSON.stringify({
            test:
              "NHL REJECTED RAW ROW",

            sample:
              index + 1,

            playerId:
              item.playerId,

            playerName:
              item.playerName,

            row:
              item.topLevel
          })
        );
      }
    );

  Logger.log(
    JSON.stringify({
      test:
        "NHL PARTICIPATION FIELD AUDIT",

      gameId,

      rows:
        rows.length,

      rejectedRows:
        rejectedRows.length,

      pass:
        rows.length > 0
    })
  );
}

