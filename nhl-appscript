    "EV Away Spread ($1 bet)",   // T
    "EV Home Spread ($1 bet)",   // U
    "Game Date",                 // V
    "Away Team",                 // W
    "Home Team",                 // X
    "Implied Prob Away ML",      // Y
    "Implied Prob Home ML",      // Z
    "Vig-Free Prob Away ML",     // AA
    "Vig-Free Prob Home ML",     // AB
    "Moneyline Edge Away",       // AC
    "Moneyline Edge Home",       // AD
    "Best ML Edge"               // AE
  ];

  const rawRows = [];
  const helperRows = [];
  const seenOddsIds = new Set();

  odds.forEach(item => {
    const gameId = String(item.game_id || "");
    const gameInfo = gameMap[gameId];
    const oddsId = String(item.id || "");

    if (!gameInfo) return;

    if (oddsId && seenOddsIds.has(oddsId)) return;
    if (oddsId) seenOddsIds.add(oddsId);

    rawRows.push([
      item.id || "",
      item.game_id || "",
      item.vendor || "",
      item.spread_away_value || "",
      item.spread_away_odds || "",
      item.spread_home_value || "",
      item.spread_home_odds || "",
      item.moneyline_away_odds || "",
      item.moneyline_home_odds || "",
      item.total_value || "",
      item.total_over_odds || "",
      item.total_under_odds || "",
      item.updated_at || ""
    ]);

    helperRows.push([
      gameInfo.game_date || "",
      gameInfo.away_team || "",
      gameInfo.home_team || ""
    ]);
  });

  clearNHLGameOddsSheet_(sheet);

  sheet.getRange(1, 1, 1, rawHeaders.length).setValues([rawHeaders]);
  sheet.getRange(1, 14, 1, formulaHeaders.length).setValues([formulaHeaders]);

  if (!rawRows.length) {
    Logger.log("No NHL game odds rows matched the Schedule tab game IDs.");
    return;
  }

  sheet.getRange(3, 1, rawRows.length, 13).setValues(rawRows);
  sheet.getRange(3, 22, helperRows.length, 3).setValues(helperRows);

  SpreadsheetApp.flush();

  copyGameOddsFormulaBlockDown_("Game Odds", 14, 31);
  formatGameOddsModelColumns_(sheet);

  Logger.log(`Wrote ${rawRows.length} NHL game odds rows to "${sheetName}" using Schedule tab game IDs.`);
}

function fetchAllNHLOddsForDate_(dateString) {
  const allOdds = [];
  let cursor = null;

  do {
    const params = {
      "dates[]": dateString,
      per_page: 100
    };

    if (cursor) {
      params.cursor = cursor;
    }

    const response = fetchApi_('/nhl/v1/odds', params);
    const odds = Array.isArray(response.data) ? response.data : [];
    allOdds.push(...odds);

    cursor = response.meta && response.meta.next_cursor
      ? response.meta.next_cursor
      : null;

  } while (cursor);

  return allOdds;
}

function clearGameOddsSheet_(sheet) {
  const maxRows = sheet.getMaxRows();

  if (maxRows > 2) {
    // Clear raw imported data A:M from row 3 down
    sheet.getRange(3, 1, maxRows - 2, 13).clearContent();

    // Clear helper columns V:X from row 3 down
    sheet.getRange(3, 22, maxRows - 2, 3).clearContent();
  }
}

function ensureGameOddsFormulaTemplates_(sheet) {
  const formulas = sheet.getRange("N2:AE2").getFormulas()[0];
  const missing = formulas.some(formula => !formula);

  if (missing) {
    throw new Error('Missing Game Odds formula template in N2:AE2. Restore those formulas before refreshing.');
  }
}

function copyGameOddsFormulaBlockDown_(sheetName, startCol, endCol) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    throw new Error(`Sheet "${sheetName}" not found.`);
  }

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;

  const numCols = endCol - startCol + 1;
  const templateRange = sheet.getRange(2, startCol, 1, numCols);

  if (lastRow > 2) {
    sheet.getRange(3, startCol, lastRow - 2, numCols).clearContent();
  }

  if (lastRow >= 3) {
    templateRange.copyTo(
      sheet.getRange(3, startCol, lastRow - 2, numCols),
      SpreadsheetApp.CopyPasteType.PASTE_FORMULA,
      false
    );
  }
}

function formatGameOddsModelColumns_(sheet) {
  // Y:AB = probabilities
  sheet.getRange("Y:AB").setNumberFormat("0.000000");

  // AC:AE = edges
  sheet.getRange("AC:AE").setNumberFormat("0.00%");
}

function getGamesFromScheduleSheet_(scheduleSheet) {
  const lastRow = scheduleSheet.getLastRow();

  if (lastRow < 2) {
    return [];
  }

  const values = scheduleSheet.getRange(2, 1, lastRow - 1, 10).getValues();

  return values
    .filter(row => row[0]) // require Game Id in column A
    .map(row => ({
      id: row[0],          // A Game Id
      game_date: row[1],   // B Game Date
      away_team: row[2],   // C Away Team
      home_team: row[3]    // D Home Team
    }));
}

function refreshNHLPlayerPropsSheet() {
  const sheetName = "Player Props";
  const scheduleSheetName = "Schedule";

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName(sheetName);

  const scheduleSheet =
    ss.getSheetByName(scheduleSheetName);

  if (!sheet) {
    throw new Error(
      `Sheet "${sheetName}" not found.`
    );
  }

  if (!scheduleSheet) {
    throw new Error(
      `Sheet "${scheduleSheetName}" not found.`
    );
  }

  Logger.log(
    "Refreshing NHL player props using universal A:AJ production output..."
  );

  // --------------------------------------------------------------------------
  // UNIVERSAL A:AJ SHEET CONTRACT
  // --------------------------------------------------------------------------

  const universalColumnCount =
    NHL_UNIVERSAL_PLAYER_PROPS_HEADERS.length;

  if (universalColumnCount !== 36) {
    throw new Error(
      `NHL universal Player Props header count must be 36; received ${universalColumnCount}.`
    );
  }

  // Make sure the sheet physically has A:AJ available.
  const currentMaxColumns =
    sheet.getMaxColumns();

  if (currentMaxColumns < universalColumnCount) {
    sheet.insertColumnsAfter(
      currentMaxColumns,
      universalColumnCount - currentMaxColumns
    );
  }

  // Row 1 is now the authoritative universal header contract.
  sheet
    .getRange(
      1,
      1,
      1,
      universalColumnCount
    )
    .setValues([
      NHL_UNIVERSAL_PLAYER_PROPS_HEADERS
    ]);

  // Clear ALL stale production rows/formulas in A:AJ.
  // This intentionally clears the old row-2 formula templates.
  clearPlayerPropsData_(sheet);

  // --------------------------------------------------------------------------
  // SCHEDULE
  // --------------------------------------------------------------------------

  const games =
    getGamesFromScheduleSheet_(
      scheduleSheet
    );

  if (!games.length) {
    Logger.log(
      "No schedule rows found. NHL Player Props now contains universal A:AJ headers with no stale prop rows."
    );
    return;
  }

  const gameMap = {};

  games.forEach(game => {
    gameMap[String(game.id)] = {
      game_date:
        game.game_date ?? "",

      away_team:
        game.away_team ?? "",

      home_team:
        game.home_team ?? ""
    };
  });

  // --------------------------------------------------------------------------
  // BUILD P12 CONTEXT ONCE PER REFRESH
  // --------------------------------------------------------------------------

  Logger.log(
    "Building NHL Player Props historical, trend, and identity indexes..."
  );

  const historyIndex =
    buildNHLPlayerPropHistoryIndex_();

  const trendIndex =
    buildNHLPlayerTrendIndex_();

  const playerIdentityIndex =
    buildNHLPlayerIdentityIndex_();

  Logger.log(
    "NHL Player Props context indexes built."
  );

  // --------------------------------------------------------------------------
  // FETCH PROVIDER PROPS + BUILD UNIVERSAL ROWS
  // --------------------------------------------------------------------------

  const allRows = [];

  const seenPropIds =
    new Set();

  games.forEach((game, index) => {
    Logger.log(
      `Fetching NHL props for game ${index + 1}/${games.length} (ID: ${game.id})`
    );

    const props =
      fetchAllNHLPlayerPropsForGame_(
        game.id
      );

    const gameInfo =
      gameMap[String(game.id)] || {};

    Logger.log(
      `Returned ${props.length} NHL props for game ID ${game.id}`
    );

    props.forEach(prop => {
      const propId =
        String(
          prop.id ?? ""
        );

      if (
        propId &&
        seenPropIds.has(propId)
      ) {
        return;
      }

      if (propId) {
        seenPropIds.add(propId);
      }

      const playerId =
        prop.player_id ??
        (
          prop.player
            ? prop.player.id
            : null
        ) ??
        "";

      const vendor =
        prop.vendor ??
        prop.sportsbook ??
        prop.bookmaker ??
        "";

      const propType =
        prop.prop_type ??
        (
          typeof prop.market === "string"
            ? prop.market
            : ""
        );

      const lineValue =
        prop.line ??
        prop.line_value ??
        "";

      const typeValue =
        (
          prop.market &&
          typeof prop.market === "object"
        )
          ? (
              prop.market.type ??
              ""
            )
          : "";

      const odds =
        (
          prop.market &&
          typeof prop.market === "object"
        )
          ? (
              prop.market.odds ??
              ""
            )
          : "";

      const updatedAt =
        prop.updated_at ??
        "";

      const overOdds =
        (
          prop.market &&
          typeof prop.market === "object"
        )
          ? (
              prop.market.over_odds ??
              ""
            )
          : "";

      const underOdds =
        (
          prop.market &&
          typeof prop.market === "object"
        )
          ? (
              prop.market.under_odds ??
              ""
            )
          : "";

      // ----------------------------------------------------------------------
      // Provider/raw A:N object
      //
      // These exact keys are the input contract already consumed by
      // buildNHLUniversalPropRowFromProvider_().
      // ----------------------------------------------------------------------

      const providerRow = {
        "Game Id":
          game.id ?? "",

        "Game Date":
          gameInfo.game_date ?? "",

        "Away Team":
          gameInfo.away_team ?? "",

        "Home Team":
          gameInfo.home_team ?? "",

        "Id":
          prop.id ?? "",

        "Player Id":
          playerId,

        "Vendor":
          vendor,

        "Prop Type":
          propType,

        "Line Value":
          lineValue,

        "Type":
          typeValue,

        "Odds":
          odds,

        "Updated At":
          updatedAt,

        "Over Odds":
          overOdds,

        "Under Odds":
          underOdds
      };

      // ----------------------------------------------------------------------
      // P12 D5 -> D6 PRODUCTION CUTOVER
      // ----------------------------------------------------------------------

      const universalRow =
        buildNHLUniversalPropRowFromProvider_({
          providerRow,
          historyIndex,
          trendIndex,
          playerIdentityIndex
        });

      if (!universalRow) {
        return;
      }

      if (
        !Array.isArray(universalRow) ||
        universalRow.length !== universalColumnCount
      ) {
        throw new Error(
          `Invalid NHL universal Player Props row width for prop ID ${propId || "(missing ID)"}: expected ${universalColumnCount}, received ${
            Array.isArray(universalRow)
              ? universalRow.length
              : "non-array"
          }.`
        );
      }

      allRows.push(
        universalRow
      );
    });

    Utilities.sleep(200);
  });

  // --------------------------------------------------------------------------
  // WRITE UNIVERSAL VALUE ROWS
  // --------------------------------------------------------------------------

  if (!allRows.length) {
    Logger.log(
      "No NHL player props were returned for the schedule slate. Universal A:AJ headers remain and stale rows were cleared."
    );
    return;
  }

  sheet
    .getRange(
      2,
      1,
      allRows.length,
      universalColumnCount
    )
    .setValues(
      allRows
    );

  Logger.log(
    `Wrote ${allRows.length} NHL universal Player Props rows to "${sheetName}" across A:AJ.`
  );
}

