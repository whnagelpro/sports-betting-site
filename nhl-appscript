      (a, b) =>
        getNHLBacktestDateValue_(a) -
        getNHLBacktestDateValue_(b)
    );
  });

  const output = [];

  Object.keys(
    NHL_PROBABILITY_BACKTEST_MARKETS
  ).forEach(marketKey => {

    const config =
      NHL_PROBABILITY_BACKTEST_MARKETS[
        marketKey
      ];

    const lines =
      NHL_PROBABILITY_TEST_LINES[
        marketKey
      ] || [];

    lines.forEach(line => {

      let predictions = 0;

      let brierTotal = 0;

      let predictedTotal = 0;

      let actualTotal = 0;

      Object.keys(
        playerGames
      ).forEach(playerId => {

        const eligibleGames =
          playerGames[playerId]
            .filter(row =>
              isNHLEligiblePropGame_(
                row,
                config
              )
            );

        if (
          eligibleGames.length < 11
        ) {
          return;
        }

        for (
          let i = 10;
          i < eligibleGames.length;
          i++
        ) {
          const priorGames =
            eligibleGames.slice(
              0,
              i
            );

          const priorValues =
            priorGames
              .map(row =>
                getNHLBacktestStatValue_(
                  row,
                  config
                )
              )
              .filter(value =>
                value !== null
              );

          if (
            priorValues.length < 10
          ) {
            continue;
          }

          const recentValues =
            priorValues.slice(-5);

          if (
            recentValues.length < 5
          ) {
            continue;
          }

          const seasonAverage =
            avgNHL_(
              priorValues
            );

          const recentAverage =
            avgNHL_(
              recentValues
            );

          const projection =
            calculateNHLPropProjection_(
              marketKey,
              seasonAverage,
              recentAverage
            );

          if (
            !projection ||
            !Number.isFinite(
              projection.projectedStat
            )
          ) {
            continue;
          }

          const probability =
            poissonOverProbabilityNHL_(
              projection.projectedStat,
              line
            );

          if (
            probability === null ||
            !Number.isFinite(
              probability
            )
          ) {
            continue;
          }

          const actualValue =
            getNHLBacktestStatValue_(
              eligibleGames[i],
              config
            );

          if (
            actualValue === null
          ) {
            continue;
          }

          const outcome =
            actualValue > line
              ? 1
              : 0;

          const error =
            probability -
            outcome;

          brierTotal +=
            error * error;

          predictedTotal +=
            probability;

          actualTotal +=
            outcome;

          predictions++;
        }
      });

      if (!predictions) {
        output.push([
          marketKey,
          config.label,
          line,
          "Poisson",
          0,
          "",
          "",
          "",
          ""
        ]);

        return;
      }

      const brierScore =
        brierTotal /
        predictions;

      const averagePredicted =
        predictedTotal /
        predictions;

      const actualHitRate =
        actualTotal /
        predictions;

      const calibrationGap =
        averagePredicted -
        actualHitRate;

      output.push([
        marketKey,
        config.label,
        line,
        "Poisson",
        predictions,
        brierScore,
        averagePredicted,
        actualHitRate,
        calibrationGap
      ]);
    });
  });

  const sheetName =
    "NHL Probability Backtest";

  let outputSheet =
    ss.getSheetByName(
      sheetName
    );

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(
        sheetName
      );
  } else {
    outputSheet.clearContents();
  }

  const headers = [
    "Market",
    "Stat",
    "Line",
    "Distribution",
    "Predictions",
    "Brier Score",
    "Avg Predicted Over",
    "Actual Over Rate",
    "Calibration Gap"
  ];

  outputSheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([
      headers
    ]);

  if (output.length) {
    outputSheet
      .getRange(
        2,
        1,
        output.length,
        headers.length
      )
      .setValues(
        output
      );

    outputSheet
      .getRange(
        2,
        6,
        output.length,
        1
      )
      .setNumberFormat(
        "0.000000"
      );

    outputSheet
      .getRange(
        2,
        7,
        output.length,
        3
      )
      .setNumberFormat(
        "0.00%"
      );
  }

  outputSheet.setFrozenRows(1);

  outputSheet.autoResizeColumns(
    1,
    headers.length
  );

  const expectedRows =
    Object.values(
      NHL_PROBABILITY_TEST_LINES
    ).reduce(
      (sum, lines) =>
        sum + lines.length,
      0
    );

  const pass =
    output.length ===
      expectedRows &&
    output.every(
      row =>
        row[4] > 0 &&
        Number.isFinite(
          Number(row[5])
        )
    );

  Logger.log(
    JSON.stringify({
      test:
        "NHL POISSON PROBABILITY BACKTEST",

      rows:
        output.length,

      expectedRows,

      pass
    })
  );
}

function auditNHLHistoricalPositionIntegrity() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName(
      "NHL Player Game Logs"
    );

  if (!sheet) {
    throw new Error(
      'Missing required sheet: "NHL Player Game Logs".'
    );
  }

  const rows =
    getNHLObjectsFromSheet_(
      sheet
    ).filter(
      isNHLRegularSeasonResearchDate_
    );

  let totalRows = 0;
  let positionPresent = 0;
  let positionMissing = 0;

  let goalieRows = 0;
  let goaliePositiveSaves = 0;
  let goalieZeroSaves = 0;

  let skaterRows = 0;
  let skaterPositiveSaves = 0;

  const goalieZeroExamples = [];
  const skaterSaveExamples = [];

  rows.forEach(row => {
    totalRows++;

    const position =
      String(
        row["Position"] || ""
      )
        .trim()
        .toUpperCase();

    const rawSaves =
      row["Saves"];

    const saves =
      rawSaves === "" ||
      rawSaves === null ||
      rawSaves === undefined
        ? null
        : Number(rawSaves);

    if (!position) {
      positionMissing++;
      return;
    }

    positionPresent++;

    if (position === "G") {
      goalieRows++;

      if (
        Number.isFinite(saves) &&
        saves > 0
      ) {
        goaliePositiveSaves++;
      } else if (
        Number.isFinite(saves) &&
        saves === 0
      ) {
        goalieZeroSaves++;

        if (
          goalieZeroExamples.length < 10
        ) {
          goalieZeroExamples.push([
            row["Game Date"],
            row["Game ID"],
            row["Player ID"],
            row["Player Name"],
            position,
            saves
          ]);
        }
      }

      return;
    }

    skaterRows++;

    if (
      Number.isFinite(saves) &&
      saves > 0
    ) {
      skaterPositiveSaves++;

      if (
        skaterSaveExamples.length < 10
      ) {
        skaterSaveExamples.push([
          row["Game Date"],
          row["Game ID"],
          row["Player ID"],
          row["Player Name"],
          position,
          saves
        ]);
      }
    }
  });

  const output = [
    ["Metric", "Value"],
    ["Total Regular-Season Rows", totalRows],
    ["Rows With Position", positionPresent],
    ["Rows Missing Position", positionMissing],
    ["Goalie Rows (Position = G)", goalieRows],
    ["Goalie Rows With Saves > 0", goaliePositiveSaves],
    ["Goalie Rows With Saves = 0", goalieZeroSaves],
    ["Skater Rows", skaterRows],
    ["Skater Rows With Saves > 0", skaterPositiveSaves]
  ];

  const sheetName =
    "NHL Historical Position Audit";

  let outputSheet =
    ss.getSheetByName(
      sheetName
    );

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(
        sheetName
      );
  } else {
    outputSheet.clearContents();
  }

  outputSheet
    .getRange(
      1,
      1,
      output.length,
      2
    )
    .setValues(
      output
    );

  let nextRow =
    output.length + 2;

  function writeExamples_(
    title,
    examples
  ) {
    outputSheet
      .getRange(
        nextRow,
        1
      )
      .setValue(title);

    nextRow++;

    outputSheet
      .getRange(
        nextRow,
        1,
        1,
        6
      )
      .setValues([[
        "Game Date",
        "Game ID",
        "Player ID",
        "Player Name",
        "Position",
        "Saves"
      ]]);

    nextRow++;

    if (examples.length) {
      outputSheet
        .getRange(
          nextRow,
          1,
          examples.length,
          6
        )
        .setValues(
          examples
        );

      nextRow +=
        examples.length;
    }

    nextRow += 2;
  }

  writeExamples_(
    "Goalies With 0 Saves",
    goalieZeroExamples
  );

  writeExamples_(
    "Skaters With Saves > 0",
    skaterSaveExamples
  );

  outputSheet.setFrozenRows(1);

  outputSheet.autoResizeColumns(
    1,
    6
  );

  const pass =
    totalRows > 0 &&
    positionMissing === 0 &&
    goalieRows > 0 &&
    skaterPositiveSaves === 0;

  Logger.log(
    JSON.stringify({
      test:
        "NHL HISTORICAL POSITION INTEGRITY",

      totalRows,

      positionPresent,

      positionMissing,

      goalieRows,

      goaliePositiveSaves,

      goalieZeroSaves,

      skaterPositiveSaves,

      pass
    })
  );
}

