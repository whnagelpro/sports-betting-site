function refreshNHLTeamGameLogsForDateRange_(startDate, endDate) {
  ensureNHLTrendTabs_();

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("NHL Team Game Logs");

  const headers = [
    "Game Date",
    "Game ID",
    "Team",
    "Opponent",
    "Goals For",
    "Goals Allowed",
    "Shots On Goal",
    "Assists",
    "Points",
    "Saves"
  ];

  Logger.log(`Refreshing NHL Team Game Logs from ${startDate} to ${endDate}`);

  const selectedGames = getNHLCompletedGamesForDateRange_(startDate, endDate);

  if (!selectedGames.length) {
    Logger.log("No completed NHL games found for this team-log date range.");
    return;
  }

  const gameIds = selectedGames.map(g => g.id).filter(Boolean);
  const boxScoreRows = fetchAllNHLBoxScoresForGameIds_(gameIds);
  const teamGameStatsMap = buildNHLTeamGameStatsMap_(boxScoreRows);

  const rows = [];

  selectedGames.forEach(game => {
    const gameId = String(game.id || "");
    const homeTeam = game.home_team || {};
    const awayTeam = game.away_team || {};

    addNHLTeamGameLogRow_(rows, game, gameId, homeTeam, awayTeam, teamGameStatsMap);
    addNHLTeamGameLogRow_(rows, game, gameId, awayTeam, homeTeam, teamGameStatsMap);
  });

  upsertRowsByKey_(sheet, headers, rows, [1, 2]);

  Logger.log(`Upserted ${rows.length} NHL team game-log rows for ${startDate} to ${endDate}.`);
}

function addNHLTeamGameLogRow_(rows, game, gameId, team, opponent, statMap) {
  const teamName = getNHLTeamName_(team);
