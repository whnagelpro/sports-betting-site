/**
 * ============================================================================
 * NHL CURRENT ROSTER SOURCE DIAGNOSTIC
 * ============================================================================
 *
 * Diagnostic only.
 *
 * Does NOT modify:
 * - NHL Players
 * - Player Props
 * - Player Trends
 * - Player Profiles
 * - Daily analytics pipeline
 *
 * Tests the NHL public current-roster endpoint and compares returned players
 * with BALLDONTLIE NHL player records.
 * ============================================================================
 */
function testNHLCurrentRosterSourceAndIdentityMatch() {

  Logger.log("==================================================");
  Logger.log("NHL CURRENT ROSTER SOURCE + IDENTITY DIAGNOSTIC");
  Logger.log("==================================================");

  /*
   * Use a few teams so we can prove the endpoint works consistently
   * without querying the entire NHL yet.
   */
  const testTeams = [
    "TOR",
    "MIN",
    "VGK"
  ];

  /*
   * ------------------------------------------------------------
   * STEP 1
   * Fetch BALLDONTLIE NHL players once.
   * ------------------------------------------------------------
   */

  Logger.log("");
  Logger.log("Fetching BALLDONTLIE NHL player database...");

  const bdlPlayers = [];

  let cursor = null;

  do {

    const params = {
      per_page: 100
    };

    if (cursor) {
      params.cursor = cursor;
    }

    const response =
      fetchApi_(
        "/nhl/v1/players",
        params
      );

    const pagePlayers =
      Array.isArray(response.data)
        ? response.data
        : [];

    bdlPlayers.push(...pagePlayers);

    cursor =
      response.meta &&
      response.meta.next_cursor
        ? response.meta.next_cursor
        : null;

  } while (cursor);


  Logger.log(
    `BALLDONTLIE players loaded: ${bdlPlayers.length}`
  );


  /*
   * ------------------------------------------------------------
   * STEP 2
   * Build normalized-name index.
   * ------------------------------------------------------------
   */

  const normalizeName_ = value =>
    String(value || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]/g, "");


  const bdlByName = {};

  bdlPlayers.forEach(player => {

    const fullName =
      `${player.first_name || ""} ${player.last_name || ""}`
        .trim();

    const key =
      normalizeName_(fullName);

    if (!key) {
      return;
    }

    if (!bdlByName[key]) {
      bdlByName[key] = [];
    }

    bdlByName[key].push(player);
  });


  /*
   * ------------------------------------------------------------
   * STEP 3
   * Test official NHL current-roster endpoint.
   * ------------------------------------------------------------
   */

  let totalOfficialPlayers = 0;
  let totalMatched = 0;
  let totalUnmatched = 0;
  let totalAmbiguous = 0;


  testTeams.forEach(teamCode => {

    Logger.log("");
    Logger.log("--------------------------------------------------");
    Logger.log(`TESTING CURRENT NHL ROSTER: ${teamCode}`);
    Logger.log("--------------------------------------------------");


    const url =
      `https://api-web.nhle.com/v1/roster/${teamCode}/current`;


    let response;

    try {

      response =
        UrlFetchApp.fetch(
          url,
          {
            muteHttpExceptions: true
          }
        );

    } catch (error) {

      Logger.log(
        `ERROR fetching ${teamCode}: ${error.message}`
      );

      return;
    }


    const statusCode =
      response.getResponseCode();

    Logger.log(
      `HTTP status: ${statusCode}`
    );


    if (statusCode !== 200) {

      Logger.log(
        `FAILED roster request for ${teamCode}`
      );

      return;
    }


    let payload;

    try {

      payload =
        JSON.parse(
          response.getContentText()
        );

    } catch (error) {

      Logger.log(
        `ERROR parsing ${teamCode} roster JSON: ${error.message}`
      );

      return;
    }


    const forwards =
      Array.isArray(payload.forwards)
        ? payload.forwards
        : [];

    const defensemen =
      Array.isArray(payload.defensemen)
        ? payload.defensemen
        : [];

    const goalies =
      Array.isArray(payload.goalies)
        ? payload.goalies
        : [];


    const roster = [
      ...forwards,
      ...defensemen,
      ...goalies
    ];


    Logger.log(
      `${teamCode} roster players returned: ${roster.length}`
    );

    Logger.log(
      `Forwards: ${forwards.length}`
    );

    Logger.log(
      `Defensemen: ${defensemen.length}`
    );

    Logger.log(
      `Goalies: ${goalies.length}`
    );


    totalOfficialPlayers +=
      roster.length;


    /*
     * ----------------------------------------------------------
     * STEP 4
     * Compare official NHL players to BALLDONTLIE players.
     * ----------------------------------------------------------
     */

    let teamMatched = 0;
    let teamUnmatched = 0;
    let teamAmbiguous = 0;


    roster.forEach(player => {

      const firstName =
        player.firstName &&
        typeof player.firstName === "object"
          ? (
              player.firstName.default ||
              player.firstName.en ||
              ""
            )
          : (
              player.firstName ||
              ""
            );


      const lastName =
        player.lastName &&
        typeof player.lastName === "object"
          ? (
              player.lastName.default ||
              player.lastName.en ||
              ""
            )
          : (
              player.lastName ||
              ""
            );


      const fullName =
        `${firstName} ${lastName}`
          .trim();


      const key =
        normalizeName_(fullName);


      const matches =
        key && bdlByName[key]
          ? bdlByName[key]
          : [];


      if (matches.length === 1) {

        teamMatched++;
        totalMatched++;

        const bdlPlayer =
          matches[0];

        Logger.log(
          `MATCH | ${teamCode} | ` +
          `${fullName} | ` +
          `NHL ID ${player.id || ""} | ` +
          `BDL ID ${bdlPlayer.id || ""} | ` +
          `Position ${player.positionCode || ""}`
        );

      } else if (matches.length > 1) {

        teamAmbiguous++;
        totalAmbiguous++;

        Logger.log(
          `AMBIGUOUS | ${teamCode} | ` +
          `${fullName} | ` +
          `${matches.length} BALLDONTLIE matches`
        );

      } else {

        teamUnmatched++;
        totalUnmatched++;

        Logger.log(
          `UNMATCHED | ${teamCode} | ` +
          `${fullName} | ` +
          `NHL ID ${player.id || ""} | ` +
          `Position ${player.positionCode || ""}`
        );
      }

    });


    Logger.log("");
    Logger.log(`${teamCode} SUMMARY`);
    Logger.log(`Matched: ${teamMatched}`);
    Logger.log(`Ambiguous: ${teamAmbiguous}`);
    Logger.log(`Unmatched: ${teamUnmatched}`);

  });


  /*
   * ------------------------------------------------------------
   * FINAL SUMMARY
   * ------------------------------------------------------------
   */

  Logger.log("");
  Logger.log("==================================================");
  Logger.log("NHL CURRENT ROSTER DIAGNOSTIC SUMMARY");
  Logger.log("==================================================");

  Logger.log(
    `Official roster players tested: ${totalOfficialPlayers}`
  );

  Logger.log(
    `Unique BALLDONTLIE matches: ${totalMatched}`
  );

  Logger.log(
    `Ambiguous matches: ${totalAmbiguous}`
  );

  Logger.log(
    `Unmatched players: ${totalUnmatched}`
  );


  const matchRate =
    totalOfficialPlayers > 0
      ? (
          totalMatched /
          totalOfficialPlayers *
          100
        )
      : 0;


  Logger.log(
    `Unique match rate: ${matchRate.toFixed(2)}%`
  );


  if (totalOfficialPlayers === 0) {

    throw new Error(
      "FAIL: Official NHL current-roster endpoint returned no players."
    );
  }


  Logger.log("==================================================");
  Logger.log("NHL CURRENT ROSTER DIAGNOSTIC COMPLETE");
  Logger.log("==================================================");
}

