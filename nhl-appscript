    ).filter(
      isNHLRegularSeasonResearchDate_
    );

  const playerGames = {};

  rows.forEach(row => {
    const playerId =
      String(
        row["Player ID"] || ""
      ).trim();

    if (!playerId) {
      return;
    }

    if (!playerGames[playerId]) {
      playerGames[playerId] = [];
    }

    playerGames[playerId].push(row);
  });

  Object.keys(playerGames)
    .forEach(playerId => {
      playerGames[playerId].sort(
        (a, b) =>
          getNHLBacktestDateValue_(a) -
          getNHLBacktestDateValue_(b)
      );
    });

  const output = [];

  Object.keys(
    NHL_PROJECTION_HOLDOUT_CANDIDATES
  ).forEach(marketKey => {

    const config =
      NHL_PROJECTION_BACKTEST_MARKETS[
        marketKey
      ];

    const candidate =
      NHL_PROJECTION_HOLDOUT_CANDIDATES[
        marketKey
      ];

    let seasonAbsoluteError = 0;
    let seasonSquaredError = 0;

    let candidateAbsoluteError = 0;
    let candidateSquaredError = 0;

    let predictions = 0;

    Object.keys(playerGames)
      .forEach(playerId => {

        const eligibleGames =
          playerGames[playerId]
            .filter(row =>
              isNHLEligiblePropGame_(
                row,
                config
              )
            );

        if (eligibleGames.length < 11) {
          return;
        }

        const holdoutStart =
          Math.max(
            10,
            Math.floor(
              eligibleGames.length *
              0.75
            )
          );

        if (
          holdoutStart >=
          eligibleGames.length
        ) {
          return;
        }

        for (
          let i = holdoutStart;
          i < eligibleGames.length;
          i++
        ) {
          const priorGames =
            eligibleGames.slice(
              0,
              i
            );

          const actual =
            getNHLBacktestStatValue_(
              eligibleGames[i],
              config
            );

          if (actual === null) {
            continue;
          }

          const priorValues =
            priorGames
              .map(row =>
                getNHLBacktestStatValue_(
                  row,
                  config
                )
              )
              .filter(value =>
                value !== null
              );

          if (priorValues.length < 10) {
            continue;
          }

          const recentValues =
            priorValues.slice(-5);

          if (
            recentValues.length < 5
          ) {
            continue;
          }

          const seasonAverage =
            avgNHL_(
              priorValues
            );

          const recentAverage =
            avgNHL_(
              recentValues
            );

          const seasonProjection =
            seasonAverage;

          const candidateProjection =
            seasonAverage *
              candidate.season +
            recentAverage *
              candidate.recent;

          const seasonError =
            seasonProjection -
            actual;

          const candidateError =
            candidateProjection -
            actual;

          seasonAbsoluteError +=
            Math.abs(
              seasonError
            );

          seasonSquaredError +=
            seasonError *
            seasonError;

          candidateAbsoluteError +=
            Math.abs(
              candidateError
            );

          candidateSquaredError +=
            candidateError *
            candidateError;

          predictions++;
        }
      });

    if (!predictions) {
      output.push([
        marketKey,
        config.label,
        config.role,
        0,
        candidate.season,
        candidate.recent,
        "",
        "",
        "",
        "",
        "",
        "",
        false,
        false
      ]);

      return;
    }

    const seasonMAE =
      seasonAbsoluteError /
      predictions;

    const candidateMAE =
      candidateAbsoluteError /
      predictions;

    const seasonRMSE =
      Math.sqrt(
        seasonSquaredError /
        predictions
      );

    const candidateRMSE =
      Math.sqrt(
        candidateSquaredError /
        predictions
      );

    const maeImprovement =
      seasonMAE === 0
        ? 0
        : (
            seasonMAE -
            candidateMAE
          ) /
          seasonMAE;

    const rmseImprovement =
      seasonRMSE === 0
        ? 0
        : (
            seasonRMSE -
            candidateRMSE
          ) /
          seasonRMSE;

    const maePass =
      candidateMAE <=
      seasonMAE;

    const rmsePass =
      candidateRMSE <=
      seasonRMSE;

    output.push([
      marketKey,
      config.label,
      config.role,
      predictions,
      candidate.season,
      candidate.recent,
      seasonMAE,
      candidateMAE,
      maeImprovement,
      seasonRMSE,
      candidateRMSE,
      rmseImprovement,
      maePass,
      rmsePass
    ]);
  });

  const sheetName =
    "NHL Projection Holdout";

  let outputSheet =
    ss.getSheetByName(
      sheetName
    );

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(
