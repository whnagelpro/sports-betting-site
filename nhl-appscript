function refreshNHLGameOddsSheet() {
  const sheetName = "Game Odds";
  const scheduleSheetName = "Schedule";

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);
  const scheduleSheet = ss.getSheetByName(scheduleSheetName);

  if (!sheet) {
    throw new Error(`Sheet "${sheetName}" not found.`);
  }

  if (!scheduleSheet) {
    throw new Error(`Sheet "${scheduleSheetName}" not found.`);
  }

  ensureGameOddsFormulaTemplates_(sheet);

  Logger.log("Refreshing NHL game odds using Schedule tab game IDs...");

  SpreadsheetApp.flush();

  let games = getGamesFromScheduleSheet_(scheduleSheet);
  Logger.log(`Initial NHL Schedule rows found for Game Odds refresh: ${games.length}`);

  if (!games.length) {
    Utilities.sleep(5000);
    SpreadsheetApp.flush();
    games = getGamesFromScheduleSheet_(scheduleSheet);
    Logger.log(`Retry NHL Schedule rows found for Game Odds refresh: ${games.length}`);
  }

  if (!games.length) {
    clearNHLGameOddsSheet_(sheet);
    Logger.log("No schedule rows found after retry, so NHL Game Odds was cleared.");
    return;
  }

  const gameMap = {};
  games.forEach(game => {
    gameMap[String(game.id)] = {
      game_date: game.game_date || "",
      away_team: game.away_team || "",
      home_team: game.home_team || ""
    };
  });

  const gameIds = games.map(game => game.id).filter(Boolean);
  Logger.log(`NHL Game Odds will fetch for ${gameIds.length} schedule game IDs.`);

  const odds = fetchAllNHLOddsForGameIds_(gameIds);
  Logger.log(`NHL odds rows returned from API: ${odds.length}`);

  const rawHeaders = [
    "Odds Id",               // A
    "Game Id",               // B
    "Vendor",                // C
    "Spread Away Value",     // D
    "Spread Away Odds",      // E
    "Spread Home Value",     // F
    "Spread Home Odds",      // G
    "Moneyline Away Odds",   // H
    "Moneyline Home Odds",   // I
    "Total Value",           // J
    "Total Over Odds",       // K
    "Total Under Odds",      // L
    "Updated At"             // M
  ];

  const formulaHeaders = [
    "EV Total Over ($1 bet)",    // N
    "EV Total Under ($1 bet)",   // O
    "Poisson Prob Total Over",   // P
    "Poisson Prob Total Under",  // Q
    "EV Away ML ($1 bet)",       // R
    "EV Home ML ($1 bet)",       // S
    "EV Away Spread ($1 bet)",   // T
    "EV Home Spread ($1 bet)",   // U
    "Game Date",                 // V
    "Away Team",                 // W
    "Home Team",                 // X
    "Implied Prob Away ML",      // Y
    "Implied Prob Home ML",      // Z
    "Vig-Free Prob Away ML",     // AA
    "Vig-Free Prob Home ML",     // AB
    "Moneyline Edge Away",       // AC
    "Moneyline Edge Home",       // AD
    "Best ML Edge"               // AE
  ];

  const rawRows = [];
  const helperRows = [];
  const seenOddsIds = new Set();

  odds.forEach(item => {
    const gameId = String(item.game_id || "");
    const gameInfo = gameMap[gameId];
    const oddsId = String(item.id || "");

    if (!gameInfo) return;

    if (oddsId && seenOddsIds.has(oddsId)) return;
    if (oddsId) seenOddsIds.add(oddsId);

    rawRows.push([
      item.id || "",
      item.game_id || "",
      item.vendor || "",
      item.spread_away_value || "",
      item.spread_away_odds || "",
      item.spread_home_value || "",
      item.spread_home_odds || "",
      item.moneyline_away_odds || "",
      item.moneyline_home_odds || "",
      item.total_value || "",
      item.total_over_odds || "",
      item.total_under_odds || "",
      item.updated_at || ""
    ]);

    helperRows.push([
      gameInfo.game_date || "",
      gameInfo.away_team || "",
      gameInfo.home_team || ""
    ]);
  });

  clearNHLGameOddsSheet_(sheet);

  sheet.getRange(1, 1, 1, rawHeaders.length).setValues([rawHeaders]);
  sheet.getRange(1, 14, 1, formulaHeaders.length).setValues([formulaHeaders]);

  if (!rawRows.length) {
    Logger.log("No NHL game odds rows matched the Schedule tab game IDs.");
    return;
  }

  sheet.getRange(3, 1, rawRows.length, 13).setValues(rawRows);
  sheet.getRange(3, 22, helperRows.length, 3).setValues(helperRows);

  SpreadsheetApp.flush();

  copyGameOddsFormulaBlockDown_("Game Odds", 14, 31);
  formatGameOddsModelColumns_(sheet);

  Logger.log(`Wrote ${rawRows.length} NHL game odds rows to "${sheetName}" using Schedule tab game IDs.`);
}

