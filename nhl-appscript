// ============================================================================
// P11/18 — NHL SAVES CALIBRATION DEVELOPMENT SEARCH
//
// Uses ONLY the first 75% of each goalie's chronological appearances.
// Final 25% remains untouched for validation.
//
// Shrink formula:
// calibratedP = 0.5 + (rawP - 0.5) * (1 - shrink)
//
// Research only. No production changes.
// ============================================================================

function calibrateNHLProbabilityShrink_(probability, shrink) {
  if (
    probability === null ||
    probability === undefined ||
    probability === ""
  ) {
    return null;
  }

  const p = Number(probability);
  const s = Number(shrink);

  if (
    !Number.isFinite(p) ||
    p < 0 ||
    p > 1 ||
    !Number.isFinite(s) ||
    s < 0 ||
    s > 1
  ) {
    return null;
  }

  return Math.min(
    1,
    Math.max(
      0,
      0.5 + (p - 0.5) * (1 - s)
    )
  );
}


