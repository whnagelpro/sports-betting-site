/**
 * Temporary continuation-trigger entry point.
 *
 * Permanent nightly trigger:
 *   runNHLDailyAnalyticsPipeline
 *
 * Temporary continuation trigger:
 *   continueNHLDailyAnalyticsPipeline
 *
 * Keeping these handlers separate prevents continuation cleanup
 * from deleting the permanent nightly Run trigger.
 */
function continueNHLDailyAnalyticsPipeline() {

  Logger.log(
    "NHL temporary continuation trigger fired."
  );

  runNHLDailyAnalyticsPipeline();
}

function runNHLDailyAnalyticsPipeline() {

  const lock =
    LockService.getScriptLock();

  if (!lock.tryLock(5000)) {

    Logger.log(
      "NHL mother pipeline is already running. Exiting duplicate execution."
    );

    return;
  }

  try {

    clearNHLDailyAnalyticsContinuationTriggers_();

    const today =
      getNHLDailyAnalyticsDateKey_();

    let state =
      getNHLDailyAnalyticsState_();

    /*
      Start a fresh pipeline when:
      - no state exists,
      - yesterday's pipeline completed,
      - or the stored state belongs to another date.
    */
    if (
      !state ||
      state.completed ||
      state.runDate !== today
    ) {

      state =
        createNHLDailyAnalyticsState_();

      saveNHLDailyAnalyticsState_(state);
    }

    Logger.log(
      `NHL mother pipeline starting/resuming. Stage: ${state.stage}`
    );

    const playerMonths =
      getNHLEligiblePipelineMonths_(
        NHL_DAILY_ANALYTICS_PIPELINE.playerMonths
      );

    const teamMonths =
      getNHLEligiblePipelineMonths_(
        NHL_DAILY_ANALYTICS_PIPELINE.teamMonths
      );


    // ------------------------------------------------------------------------
    // STAGE 1 — PLAYER GAME LOG MONTHS
    // ------------------------------------------------------------------------

    if (state.stage === "PLAYER_GAME_LOGS") {

      if (
        state.playerMonthIndex <
        playerMonths.length
      ) {

        const month =
          playerMonths[
            state.playerMonthIndex
          ];

        Logger.log(
          `NHL mother pipeline: refreshing Player Game Logs ${month.key}`
        );

        month.fn();

        state.playerMonthIndex += 1;

        state.lastSuccessfulStep =
          `PLAYER_GAME_LOGS:${month.key}`;

        state.lastError = null;
        state.updatedAt =
          new Date().toISOString();

        saveNHLDailyAnalyticsState_(state);

        scheduleNHLDailyAnalyticsRetry_();

        return;
      }

      state.stage =
        "TEAM_GAME_LOGS";

      state.updatedAt =
        new Date().toISOString();

      saveNHLDailyAnalyticsState_(state);
    }


    // ------------------------------------------------------------------------
    // STAGE 2 — TEAM GAME LOG MONTHS
    // ------------------------------------------------------------------------

    if (state.stage === "TEAM_GAME_LOGS") {

      if (
        state.teamMonthIndex <
        teamMonths.length
      ) {

        const month =
          teamMonths[
            state.teamMonthIndex
          ];

        Logger.log(
          `NHL mother pipeline: refreshing Team Game Logs ${month.key}`
        );

        month.fn();

        state.teamMonthIndex += 1;

        state.lastSuccessfulStep =
          `TEAM_GAME_LOGS:${month.key}`;

        state.lastError = null;
        state.updatedAt =
          new Date().toISOString();

        saveNHLDailyAnalyticsState_(state);

        scheduleNHLDailyAnalyticsRetry_();

        return;
      }

      state.stage =
        "PLAYER_SEASON_STATS";

      state.updatedAt =
        new Date().toISOString();

      saveNHLDailyAnalyticsState_(state);
    }


    // ------------------------------------------------------------------------
    // STAGE 3 — PLAYER SEASON STATS
    // ------------------------------------------------------------------------

    if (state.stage === "PLAYER_SEASON_STATS") {

      Logger.log(
        "NHL mother pipeline: refreshing Player Season Stats"
      );

      refreshNHLPlayerSeasonStatsSheet();

      state.stage =
        "TEAM_SEASON_STATS";

      state.lastSuccessfulStep =
        "PLAYER_SEASON_STATS";

      state.lastError = null;
      state.updatedAt =
        new Date().toISOString();

      saveNHLDailyAnalyticsState_(state);
    }


    // ------------------------------------------------------------------------
    // STAGE 4 — TEAM SEASON STATS
    // ------------------------------------------------------------------------

    if (state.stage === "TEAM_SEASON_STATS") {

      Logger.log(
        "NHL mother pipeline: refreshing Team Season Stats"
      );

      refreshNHLTeamSeasonStatsSheet();

      state.stage =
        "PLAYER_TRENDS";

      state.lastSuccessfulStep =
        "TEAM_SEASON_STATS";

      state.lastError = null;
      state.updatedAt =
        new Date().toISOString();

      saveNHLDailyAnalyticsState_(state);
    }


    // ------------------------------------------------------------------------
    // STAGE 5 — PLAYER TRENDS
    // ------------------------------------------------------------------------

    if (state.stage === "PLAYER_TRENDS") {

      Logger.log(
        "NHL mother pipeline: refreshing Player Trends"
      );

      refreshNHLPlayerTrendsSheet();

      state.stage =
        "TEAM_TRENDS";

      state.lastSuccessfulStep =
        "PLAYER_TRENDS";

      state.lastError = null;
      state.updatedAt =
        new Date().toISOString();

      saveNHLDailyAnalyticsState_(state);
    }


    // ------------------------------------------------------------------------
    // STAGE 6 — TEAM TRENDS
    // ------------------------------------------------------------------------

    if (state.stage === "TEAM_TRENDS") {

      Logger.log(
        "NHL mother pipeline: refreshing Team Trends"
      );

      refreshNHLTeamTrendsOutputSheet();

      state.stage =
        "TOP_PLAYER_TRENDS";

      state.lastSuccessfulStep =
        "TEAM_TRENDS";

      state.lastError = null;
      state.updatedAt =
        new Date().toISOString();

      saveNHLDailyAnalyticsState_(state);
    }


    // ------------------------------------------------------------------------
    // STAGE 7 — TOP PLAYER TRENDS
    // ------------------------------------------------------------------------

    if (state.stage === "TOP_PLAYER_TRENDS") {

      Logger.log(
        "NHL mother pipeline: refreshing Top Player Trends"
      );

      refreshNHLTopPlayerTrendsSheet();

      state.stage =
        "TOP_TEAM_TRENDS";

      state.lastSuccessfulStep =
        "TOP_PLAYER_TRENDS";

      state.lastError = null;
      state.updatedAt =
        new Date().toISOString();

      saveNHLDailyAnalyticsState_(state);
    }


    // ------------------------------------------------------------------------
    // STAGE 8 — TOP TEAM TRENDS
    // ------------------------------------------------------------------------

    if (state.stage === "TOP_TEAM_TRENDS") {

      Logger.log(
        "NHL mother pipeline: refreshing Top Team Trends"
      );

      refreshNHLTopTeamTrendsSheet();

      state.stage =
        "COMPLETE";

      state.completed =
        true;

      state.lastSuccessfulStep =
        "TOP_TEAM_TRENDS";

      state.lastError = null;
      state.updatedAt =
        new Date().toISOString();

      saveNHLDailyAnalyticsState_(state);

      clearNHLDailyAnalyticsContinuationTriggers_();

      Logger.log(
        "NHL DAILY ANALYTICS MOTHER PIPELINE COMPLETE."
      );

      return;
    }

  } catch (error) {

    const state =
      getNHLDailyAnalyticsState_() ||
      createNHLDailyAnalyticsState_();

    state.lastError =
      String(
        error &&
        error.stack
          ? error.stack
          : error
      );

    state.updatedAt =
      new Date().toISOString();

    saveNHLDailyAnalyticsState_(state);

    Logger.log(
      `NHL mother pipeline failed at ${state.stage}.`
    );

    Logger.log(
      state.lastError
    );

    /*
      The state has NOT advanced, so the next execution retries
      the exact failed step.
    */
    scheduleNHLDailyAnalyticsRetry_();

  } finally {

    lock.releaseLock();

  }
}


