  Logger.log(`Refreshing NHL Player Game Logs from ${startDate} to ${endDate}`);

  const selectedGames = getNHLCompletedGamesForDateRange_(startDate, endDate);
  if (!selectedGames.length) return;

  const gameMap = {};
  const gameIds = selectedGames.map(game => {
    const gameId = String(game.id || "");
    gameMap[gameId] = {
      date: getNHLGameAZDate_(game),
      homeTeam: getNHLTeamName_(game.home_team || {}),
      awayTeam: getNHLTeamName_(game.away_team || {})
    };
    return gameId;
  }).filter(Boolean);

  const boxScoreRows = fetchAllNHLBoxScoresForGameIds_(gameIds);
  const rows = [];

  boxScoreRows.forEach(row => {
    const gameId = String(row.game_id || (row.game && row.game.id) || "");
    const gameInfo = gameMap[gameId] || {};

    const playerId = row.player_id || (row.player && row.player.id) || "";
    const playerName = getNHLPlayerNameFromBoxScore_(row);

    const teamName = row.team_name || getNHLTeamName_(row.team || {}) || "";

    const opponent =
      teamName === gameInfo.homeTeam ? gameInfo.awayTeam :
      teamName === gameInfo.awayTeam ? gameInfo.homeTeam : "";

    const shotsOnGoal = getBoxScoreStatFlexible_(row, ["shots_on_goal", "shots", "sog"]);
    const points = getBoxScoreStatFlexible_(row, ["points"]);
    const assists = getBoxScoreStatFlexible_(row, ["assists", "ast"]);
    const goals = getBoxScoreStatFlexible_(row, ["goals"]);
    const powerPlayPoints = getBoxScoreStatFlexible_(row, ["power_play_points", "ppp"]);
    const saves = getBoxScoreStatFlexible_(row, ["saves"]);
    const blockedShots = getBoxScoreStatFlexible_(row, ["blocked_shots", "blocks"]);
    const hits = getBoxScoreStatFlexible_(row, ["hits"]);

    if (!playerId && !playerName) return;

    const played =
      shotsOnGoal > 0 || points > 0 || assists > 0 || goals > 0 ||
      powerPlayPoints > 0 || saves > 0 || blockedShots > 0 || hits > 0;

    if (!played) return;

    rows.push([
      gameInfo.date, gameId, playerId, playerName, teamName, opponent,
      shotsOnGoal, points, assists, goals, powerPlayPoints, saves, blockedShots, hits
    ]);
  });

