  // Z   Best EV
  // AA  Best Model Probability
  // AB  Best Price Edge
  // AC  Trend Score
  // AD  Trend Strength
  // AG  Model Confidence
  //
  // Existing NHL trend risk may still be calculated internally, but P15 now
  // owns final AE/AF.
  // ==========================================================================

  const decisionTrendFields =
    buildNHLUniversalDecisionTrendFields_({
      playerId,

      propType,

      type,

      odds:
        providerRow["Odds"],

      overOdds:
        providerRow["Over Odds"],

      underOdds:
        providerRow["Under Odds"],

      modelProbOver:
        modelFields.modelProbOver,

      modelProbUnder:
        modelFields.modelProbUnder,

      evOver:
        modelFields.evOver,

      evUnder:
        modelFields.evUnder,

      trendIndex
    });


  // ==========================================================================
  // P15 UNIVERSAL SPORTACULAR SCORING
  // ==========================================================================

  const sportacularScoring =
    buildUniversalSportacularScoring_({

      // I
      lineValue:
        providerRow["Line Value"],

      // S
      projectedStat:
        modelFields.projectedStat,

      // T
      statStdDev:
        modelFields.statStdDev,

      // W
      evOver:
        modelFields.evOver,

      // X
      evUnder:
        modelFields.evUnder,

      // AA
      bestModelProbability:
        decisionTrendFields.bestModelProbability,

      // AB
      bestPriceEdge:
        decisionTrendFields.bestPriceEdge,

      // AC
      trendScore:
        decisionTrendFields.trendScore,

      // AG
      modelConfidence:
        decisionTrendFields.modelConfidence
    });


  // ==========================================================================
  // FINAL UNIVERSAL A:AJ ROW
  // ==========================================================================

  return buildNHLUniversalPlayerPropRow_({

    // A:N — PROVIDER
    gameId:
      providerRow["Game Id"],

    gameDate:
      providerRow["Game Date"],

    awayTeam:
      providerRow["Away Team"],

    homeTeam:
      providerRow["Home Team"],

    id:
      providerRow["Id"],

    playerId,

    vendor:
      providerRow["Vendor"],

    propType,

