 * Y     final actionable Best Side
 * AE    universal Risk Score
 * AF    universal Risk Tier
 * AH    Sportacular Score
 * AI    Sportacular Edge
 * AJ    Confidence Tier
 *
 * NHL market/distribution semantics remain unchanged.
 * ============================================================================
 */
function buildNHLUniversalPropRowFromProvider_({
  providerRow,
  historyIndex,
  trendIndex,
  playerIdentityIndex
}) {

  if (!providerRow) {
    return null;
  }


  const playerId =
    String(
      providerRow["Player Id"] ??
      providerRow["Player ID"] ??
      ""
    ).trim();


  const propType =
    String(
      providerRow["Prop Type"] ??
      ""
    ).trim();


  const type =
    String(
      providerRow["Type"] ??
      ""
    ).trim();


  const identity =
    playerIdentityIndex &&
    playerIdentityIndex[playerId]
      ? playerIdentityIndex[playerId]
      : {
          playerName: null,
          team: null
        };


  // ==========================================================================
  // Q:X — FROZEN NHL MODEL
  //
  // This preserves all P8-P12 NHL behavior, including:
  //
  // shots_on_goal  -> Poisson
  // points         -> Poisson
  // assists        -> Poisson
  // goals          -> Poisson
  // anytime_goal   -> Poisson
  // saves          -> Negative Binomial
  //
  // Unsupported markets remain unavailable.
  // ==========================================================================

  const modelFields =
    buildNHLUniversalPropModelFields_({
      playerId,

      propType,

      lineValue:
        providerRow["Line Value"],

      type,

      odds:
        providerRow["Odds"],

      overOdds:
        providerRow["Over Odds"],

      underOdds:
        providerRow["Under Odds"],

      historyIndex
    });


  // ==========================================================================
