function getNHLAmericanImpliedProbability_(value) {
  const odds =
    parseNHLAmericanOdds_(
      value
    );

  if (odds === null) {
    return null;
  }

  if (odds > 0) {
    return 100 / (odds + 100);
  }

  return (
    Math.abs(odds) /
    (
      Math.abs(odds) +
      100
    )
  );
}

function buildNHLUniversalDecisionFields_({
  type,
  odds,
  overOdds,
  underOdds,
  modelProbOver,
  modelProbUnder,
  evOver,
  evUnder
}) {
  const normalizedType =
    String(
      type || ""
    )
      .trim()
      .toLowerCase();

  const isMilestone =
    normalizedType ===
    "milestone";

  const validOverEV =
    evOver !== null &&
    evOver !== undefined &&
    evOver !== "" &&
    Number.isFinite(
      Number(evOver)
    );

  const validUnderEV =
    !isMilestone &&
    evUnder !== null &&
    evUnder !== undefined &&
    evUnder !== "" &&
    Number.isFinite(
      Number(evUnder)
    );

  // No price/model output means there is no usable decision.
  if (
    !validOverEV &&
    !validUnderEV
  ) {
    return {
      bestSide: "No Play",
      bestEV: null,
      bestModelProbability: null,
      bestPriceEdge: null
    };
  }

  let bestSide = null;
  let bestEV = null;
  let bestModelProbability = null;
  let selectedOdds = null;

  // Milestone markets only have the achievement side.
  if (isMilestone) {
    bestSide =
      "Over";

    bestEV =
      Number(evOver);

    bestModelProbability =
      modelProbOver !== null &&
      modelProbOver !== undefined &&
      modelProbOver !== "" &&
      Number.isFinite(
        Number(modelProbOver)
      )
        ? Number(modelProbOver)
        : null;

    selectedOdds =
      odds;
  }

  // Conventional markets select whichever available side has greater EV.
  else if (
    validOverEV &&
    validUnderEV
  ) {
    if (
      Number(evOver) >=
      Number(evUnder)
    ) {
      bestSide =
        "Over";

      bestEV =
        Number(evOver);

      bestModelProbability =
        Number(
          modelProbOver
        );

      selectedOdds =
        overOdds;
    } else {
      bestSide =
        "Under";

      bestEV =
        Number(evUnder);

      bestModelProbability =
        Number(
          modelProbUnder
        );

      selectedOdds =
        underOdds;
    }
  }

  else if (validOverEV) {
    bestSide =
      "Over";

    bestEV =
      Number(evOver);

    bestModelProbability =
      modelProbOver !== null &&
      modelProbOver !== undefined &&
      modelProbOver !== "" &&
      Number.isFinite(
        Number(modelProbOver)
      )
        ? Number(modelProbOver)
        : null;

    selectedOdds =
      overOdds;
  }

  else {
    bestSide =
      "Under";

    bestEV =
      Number(evUnder);

    bestModelProbability =
      modelProbUnder !== null &&
      modelProbUnder !== undefined &&
      modelProbUnder !== "" &&
      Number.isFinite(
        Number(modelProbUnder)
      )
        ? Number(modelProbUnder)
        : null;

    selectedOdds =
      underOdds;
  }


  const impliedProbability =
    getNHLAmericanImpliedProbability_(
      selectedOdds
    );


  const bestPriceEdge =
    bestModelProbability !== null &&
    impliedProbability !== null
      ? (
          bestModelProbability -
          impliedProbability
        )
      : null;


  return {
    bestSide,
    bestEV,
    bestModelProbability,
    bestPriceEdge
  };
}

