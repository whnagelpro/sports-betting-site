// ============================================================================
// D10AB STEP 4 — NHL RESIDUAL CALIBRATION FLOOR VALIDATION
//
// Purpose:
//   Determine whether mature NHL samples should retain a minimum amount of
//   probability shrink instead of returning all the way to raw model
//   probabilities.
//
// IMPORTANT:
//   - TEST ONLY
//   - Does NOT change production probabilities
//   - Does NOT change EV
//   - Does NOT change Player Props output
//
// Candidate residual shrink floors:
//   5%, 10%, 15%, 20%
//
// Effective shrink:
//   max(
//     1 - sampleReliability,
//     residualFloor
//   )
//
// Example:
//   reliability = 1.00
//   residual floor = 0.10
//   effective shrink = 0.10
//
// This means mature samples still receive 10% regression toward 50%.
// ============================================================================


function calculateNHLResidualCalibrationShrink_(
  currentGames,
  residualFloor
) {

  const reliability =
    calculateNHLProbabilityReliability_(
      currentGames
    );

  const floor =
    Number(residualFloor);


  if (
    !Number.isFinite(floor) ||
    floor < 0 ||
    floor > 1
  ) {
    return null;
  }


  const sampleShrink =
    1 -
    reliability;


  return Math.max(
    sampleShrink,
    floor
  );
}


