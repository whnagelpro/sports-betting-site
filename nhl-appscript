  const teamKey = normalizeNHLTeamName_(teamName);
  const opponentKey = normalizeNHLTeamName_(opponentName);

  const stat = statMap[`${gameId}_${teamKey}`] || {};
  const opp = statMap[`${gameId}_${opponentKey}`] || {};

  rows.push([
    getNHLGameAZDate_(game),
