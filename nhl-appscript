// ============================================================================
// P9/18 — NHL PRODUCTION PROP PROJECTION ENGINE
//
// Production weights selected through:
//   1. Historical development backtest
//   2. Chronological 25% holdout validation
//
// Universal contract:
//
// Player Baseline
//   = season-to-date average
//
// Trend Adjustment
//   = recentWeight × (Recent 5 Average - Player Baseline)
//
// Projected Stat
//   = Player Baseline + Trend Adjustment
//
// Unsupported markets return null.
// ============================================================================

const NHL_PROP_PROJECTION_WEIGHTS = {
  shots_on_goal: {
    season: 0.90,
    recent: 0.10
  },

  points: {
    season: 1.00,
    recent: 0.00
  },

  assists: {
    season: 1.00,
    recent: 0.00
  },

  goals: {
    season: 1.00,
    recent: 0.00
  },

  saves: {
    season: 1.00,
    recent: 0.00
  }
};

function calculateNHLPropProjection_(
  marketKey,
  seasonAverage,
  recent5Average
) {
  const normalizedMarket =
    normalizeNHLPropMarket_(
      marketKey
    ) || String(
      marketKey || ""
    ).trim().toLowerCase();

  const weights =
    NHL_PROP_PROJECTION_WEIGHTS[
      normalizedMarket
    ];

  if (!weights) {
    return null;
  }

  if (
    seasonAverage === null ||
    seasonAverage === undefined ||
    seasonAverage === ""
  ) {
    return null;
  }

  const baseline =
    Number(
      seasonAverage
    );

  if (!Number.isFinite(baseline)) {
    return null;
  }

  let recent;

  if (
    recent5Average === null ||
    recent5Average === undefined ||
    recent5Average === ""
  ) {
    recent = baseline;
  } else {
    recent =
      Number(
        recent5Average
      );

    if (!Number.isFinite(recent)) {
      recent = baseline;
    }
  }

  const trendAdjustment =
    weights.recent *
    (
      recent -
      baseline
    );

  const projectedStat =
    baseline +
    trendAdjustment;

  return {
    market:
      normalizedMarket,

    playerBaseline:
      baseline,

    recent5Average:
      recent,

    seasonWeight:
      weights.season,

    recentWeight:
      weights.recent,

    trendAdjustment,

    projectedStat
  };
}

