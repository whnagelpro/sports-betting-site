const SPORTACULAR_TIMEZONE = "America/Phoenix";

function getNHLGameRawDate_(game) {
  return (
    game.datetime ||
    game.start_time ||
    game.scheduled ||
    game.game_time ||
    game.date ||
    game.game_date ||
    ""
  );
}

function getNHLGameAZDate_(game) {
  const rawDate = getNHLGameRawDate_(game);
  if (!rawDate) return "";

  const rawString = String(rawDate);

  // If the API already gives yyyy-MM-dd, keep it exactly.
  // Do NOT timezone-convert date-only values.
  if (/^\d{4}-\d{2}-\d{2}$/.test(rawString)) {
    return rawString;
  }

  return Utilities.formatDate(
    new Date(rawDate),
    SPORTACULAR_TIMEZONE,
    "yyyy-MM-dd"
  );
}

function addDaysToDateString_(dateString, days) {
  const d = new Date(dateString + "T00:00:00");
  d.setDate(d.getDate() + days);

  return Utilities.formatDate(d, SPORTACULAR_TIMEZONE, "yyyy-MM-dd");
}

function getNHLCompletedGamesForDateRange_(startDate, endDate) {
  const selectedGamesMap = {};

  const fetchStartDate = addDaysToDateString_(startDate, -1);
  const fetchEndDate = addDaysToDateString_(endDate, 1);

  let current = new Date(fetchStartDate + "T00:00:00");
  const end = new Date(fetchEndDate + "T00:00:00");

  while (current <= end) {
    const apiDateString = Utilities.formatDate(
      current,
      SPORTACULAR_TIMEZONE,
      "yyyy-MM-dd"
    );

    Logger.log(`Checking NHL API games for ${apiDateString}`);

    const games = fetchAllNHLGamesForDate_(apiDateString)
      .filter(isCompletedNHLGame_)
      .filter(game => {
        const azDate = getNHLGameAZDate_(game);
        return azDate >= startDate && azDate <= endDate;
      });

    games.forEach(game => {
      if (game.id) selectedGamesMap[String(game.id)] = game;
    });

    current.setDate(current.getDate() + 1);
    Utilities.sleep(100);
  }

  return Object.values(selectedGamesMap);
}

function upsertRowsByKey_(sheet, headers, newRows, keyColumnIndexes) {
  const existingValues = sheet.getDataRange().getValues();
  const existingRows = existingValues.length > 1 ? existingValues.slice(1) : [];
  const rowMap = {};

  existingRows.forEach(row => {
    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  newRows.forEach(row => {
    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  const finalRows = Object.values(rowMap).sort((a, b) =>
    new Date(b[0]).getTime() - new Date(a[0]).getTime()
  );

  writeNHLOutputSheet_(sheet, headers, finalRows);
}

function upsertRowsByKeyForDateRange_(sheet, headers, newRows, keyColumnIndexes, startDate, endDate) {
  const existingValues = sheet.getDataRange().getValues();

  const existingRows =
    existingValues.length > 1
      ? existingValues
          .slice(1)
          .map(row => {
            const normalizedRow =
              row.slice(
                0,
                headers.length
              );

            while (
              normalizedRow.length <
              headers.length
            ) {
              normalizedRow.push("");
            }

            return normalizedRow;
          })
      : [];

  const rowMap = {};

  existingRows.forEach(row => {
    const rowDate = String(row[0] || "");

    if (rowDate >= startDate && rowDate <= endDate) {
      return;
    }

    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  newRows.forEach(row => {
    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  const finalRows = Object.values(rowMap).sort((a, b) =>
    new Date(b[0]).getTime() - new Date(a[0]).getTime()
  );

  writeNHLOutputSheet_(sheet, headers, finalRows);
}

