  if (!teams.length) {
    Logger.log("STOP: No NHL teams were returned.");
    return;
  }

  // Keep the diagnostic small and readable.
  // Three teams are enough to determine how team_id behaves.
  const testTeams = teams.slice(0, 3);

  const playerAppearances = {};

  testTeams.forEach((team, teamIndex) => {
    Logger.log("----------------------------------------------");
    Logger.log(
      `TEST TEAM ${teamIndex + 1}/${testTeams.length}: ` +
      `${team.full_name || "Unknown"} ` +
      `(ID ${team.id}, ${team.abbreviation || "N/A"})`
    );

    const players = fetchNHLRosterForTeam_(team.id);

    Logger.log(
      `Players returned for requested team ${team.id}: ${players.length}`
    );

    players.slice(0, 15).forEach((player, playerIndex) => {
      const embeddedTeam = player.team || null;

      const diagnostic = {
        row: playerIndex + 1,
        playerId: player.id ?? null,
        firstName: player.first_name ?? null,
        lastName: player.last_name ?? null,
        position: player.position ?? null,

        requestedTeamId: team.id ?? null,
        requestedTeamName: team.full_name ?? null,
        requestedTeamAbbreviation: team.abbreviation ?? null,

        embeddedTeamId:
          embeddedTeam && embeddedTeam.id != null
            ? embeddedTeam.id
            : null,

        embeddedTeamName:
          embeddedTeam
            ? embeddedTeam.full_name ?? null
            : null,

        embeddedTeamAbbreviation:
          embeddedTeam
            ? embeddedTeam.abbreviation ?? null
            : null,

        teamMatchesRequest:
          embeddedTeam && embeddedTeam.id != null
            ? String(embeddedTeam.id) === String(team.id)
            : null
      };

      Logger.log(JSON.stringify(diagnostic));
    });

    players.forEach(player => {
      if (player.id == null) return;

      const key = String(player.id);

      if (!playerAppearances[key]) {
        playerAppearances[key] = {
          playerId: player.id,
          playerName:
            `${player.first_name || ""} ${player.last_name || ""}`.trim(),
          requestedTeams: [],
          embeddedTeams: []
        };
      }

      playerAppearances[key].requestedTeams.push({
        id: team.id ?? null,
        name: team.full_name ?? null,
        abbreviation: team.abbreviation ?? null
      });

      if (player.team) {
        playerAppearances[key].embeddedTeams.push({
          id: player.team.id ?? null,
          name: player.team.full_name ?? null,
          abbreviation: player.team.abbreviation ?? null
        });
      }
    });
  });

  Logger.log("==============================================");
  Logger.log("PLAYERS RETURNED FOR MULTIPLE TEST TEAMS");
  Logger.log("==============================================");

  const duplicates = Object.values(playerAppearances)
    .filter(entry => {
      const uniqueRequestedTeamIds = [
        ...new Set(
          entry.requestedTeams
            .map(team => team.id)
            .filter(id => id != null)
            .map(String)
        )
      ];

      return uniqueRequestedTeamIds.length > 1;
    });

  if (!duplicates.length) {
    Logger.log(
      "No players were returned for multiple teams in this 3-team sample."
