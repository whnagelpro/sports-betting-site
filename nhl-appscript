/**
 * Get NHL teams
 * @param {string} conference Filter by conference
 * @param {string} division Filter by division
 * @returns {Array} NHL teams data
 * @customfunction
 */
function BDL_NHL_TEAMS(conference, division) {
  const params = {};
  if (conference) params.conference = conference;
  if (division) params.division = division;
  const response = fetchApi_('/nhl/v1/teams', params);
  return toSheet_(response.data);
}

/**
 * Get NHL players
 * @param {string} search Search by player name
 * @param {number} teamId Filter by team ID
 * @param {number} perPage Results per page
 * @returns {Array} NHL players data
 * @customfunction
 */
function BDL_NHL_PLAYERS(search, teamId, perPage) {
  const params = { per_page: perPage || 25 };
  if (search) params.search = search;
  if (teamId) params['team_ids[]'] = teamId;
  const response = fetchApi_('/nhl/v1/players', params);
  return toSheet_(response.data);
}

