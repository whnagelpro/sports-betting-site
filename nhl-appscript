function getNHLUniversalTrendFields_({
  playerId,
  propType,
  trendIndex
}) {
  const id =
    String(
      playerId || ""
    ).trim();

  const statLabel =
    getNHLUniversalTrendStatLabel_(
      propType
    );

  if (
    !id ||
    !statLabel ||
    !trendIndex
  ) {
    return {
      trendScore: null,
      trendStrength: null,
      riskScore: null,
      riskTier: null,
      modelConfidence: null
    };
  }

  const row =
    trendIndex[
      `${id}::${statLabel}`
    ];

  if (!row) {
    return {
      trendScore: null,
      trendStrength: null,
      riskScore: null,
      riskTier: null,
      modelConfidence: null
    };
  }


  const rawTrendScore =
    row["Trend Score"];

  const trendScore =
    rawTrendScore !== "" &&
    rawTrendScore !== null &&
    rawTrendScore !== undefined &&
    Number.isFinite(
      Number(rawTrendScore)
    )
      ? Number(rawTrendScore)
      : null;


  const trendStrength =
    String(
      row["Trend Strength"] || ""
    ).trim() ||
    null;


  const riskTier =
    String(
      row["Risk Tier"] || ""
    ).trim() ||
    null;


  // Reuse Sportacular's existing NHL trend-confidence calculation.
  const confidence =
    calculateTrendConfidence_(
      row
    );


  const modelConfidence =
    Number.isFinite(
      Number(confidence)
    )
      ? Number(confidence)
      : null;


  return {
    trendScore,

    trendStrength,

    // Deferred intentionally until P15.
    riskScore: null,

    riskTier,

    modelConfidence
  };
}

