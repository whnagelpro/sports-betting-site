/**
 * Fetches all NHL player props for one game, handling pagination if needed.
 * @param {number|string} gameId
 * @returns {Array<Object>}
 */
function fetchAllNHLPlayerPropsForGame_(gameId) {
  const allProps = [];
  let cursor = null;

  do {
    const params = {
      game_id: gameId,
      per_page: 100
    };

    if (cursor) {
      params.cursor = cursor;
    }

    const response = fetchApi_('/nhl/v1/odds/player_props', params);
    const props = Array.isArray(response.data) ? response.data : [];
    allProps.push(...props);

    cursor = response.meta && response.meta.next_cursor ? response.meta.next_cursor : null;
  } while (cursor);

  return allProps;
}

