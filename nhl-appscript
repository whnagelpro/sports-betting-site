// ============================================================================
// P9/18 — NHL PROJECTION WEIGHT BACKTEST
//
// Research only.
// Tests season-to-date baseline vs previous-5-game recent form.
//
// Candidate weights:
// 100/0, 95/5, ... 5/95, 0/100
//
// Eligibility:
// - Saves: goalie appearances only (Saves > 0)
// - Skater markets: exclude goalie-appearance rows (Saves > 0)
// ============================================================================

const NHL_PROJECTION_BACKTEST_MARKETS = {
  shots_on_goal: {
    label: "Shots On Goal",
    header: "Shots On Goal",
    role: "skater"
  },

  points: {
    label: "Points",
    header: "Points",
    role: "skater"
  },

  assists: {
    label: "Assists",
    header: "Assists",
    role: "skater"
  },

  goals: {
    label: "Goals",
    header: "Goals",
    role: "skater"
  },

  saves: {
    label: "Saves",
    header: "Saves",
    role: "goalie"
  }
};

function isNHLEligiblePropGame_(row, marketConfig) {
  const position =
    String(
      row["Position"] || ""
    )
      .trim()
      .toUpperCase();

  if (!position) {
    return false;
  }

  if (marketConfig.role === "goalie") {
    return position === "G";
  }

  if (marketConfig.role === "skater") {
    return position !== "G";
  }

  return false;
}

function getNHLBacktestStatValue_(row, marketConfig) {
  const raw = row[marketConfig.header];

  if (
    raw === "" ||
    raw === null ||
    raw === undefined
  ) {
    return null;
  }

  const value = Number(raw);

  return Number.isFinite(value)
    ? value
    : null;
}

function getNHLBacktestDateValue_(row) {
  const raw = row["Game Date"];

  if (raw instanceof Date) {
    return raw.getTime();
  }

  const time = new Date(raw).getTime();

  return Number.isFinite(time)
    ? time
    : 0;
}

function backtestNHLProjectionWeights() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sourceSheet =
    ss.getSheetByName(
      "NHL Player Game Logs"
    );

  if (!sourceSheet) {
    throw new Error(
      'Missing required sheet: "NHL Player Game Logs".'
    );
  }

  const rows =
    getNHLObjectsFromSheet_(
      sourceSheet
    );

  const playerGames = {};

  rows.forEach(row => {
    const playerId =
      String(
        row["Player ID"] || ""
      ).trim();

    if (!playerId) {
      return;
    }

    if (!playerGames[playerId]) {
      playerGames[playerId] = [];
    }

    playerGames[playerId].push(row);
  });

  Object.keys(playerGames)
    .forEach(playerId => {
      playerGames[playerId].sort(
        (a, b) =>
          getNHLBacktestDateValue_(a) -
          getNHLBacktestDateValue_(b)
      );
    });

  const output = [];

  Object.keys(
    NHL_PROJECTION_BACKTEST_MARKETS
  ).forEach(marketKey => {

    const config =
      NHL_PROJECTION_BACKTEST_MARKETS[
        marketKey
      ];

    const candidates = [];

    for (
      let recentWeight = 0;
      recentWeight <= 1.000001;
      recentWeight += 0.05
    ) {
      candidates.push({
        seasonWeight:
          Number(
            (1 - recentWeight)
              .toFixed(2)
          ),

        recentWeight:
          Number(
            recentWeight
              .toFixed(2)
          ),

        absoluteError: 0,
        squaredError: 0,
        predictions: 0
      });
    }

    Object.keys(playerGames)
      .forEach(playerId => {

        const eligibleGames =
          playerGames[playerId]
            .filter(row =>
              isNHLEligiblePropGame_(
                row,
                config
              )
            );

        if (eligibleGames.length < 11) {
          return;
        }

        for (
          let i = 10;
          i < eligibleGames.length;
          i++
        ) {
          const priorGames =
            eligibleGames.slice(
              0,
              i
            );

          const actual =
            getNHLBacktestStatValue_(
              eligibleGames[i],
              config
            );

          if (actual === null) {
            continue;
          }

          const priorValues =
            priorGames
              .map(row =>
                getNHLBacktestStatValue_(
                  row,
                  config
                )
              )
              .filter(value =>
                value !== null
              );

          if (priorValues.length < 10) {
            continue;
          }

          const recentValues =
            priorValues.slice(-5);

          if (recentValues.length < 5) {
            continue;
          }

          const seasonAverage =
            avgNHL_(
              priorValues
            );

          const recentAverage =
            avgNHL_(
              recentValues
            );

          candidates.forEach(
            candidate => {

              const projection =
                seasonAverage *
                  candidate.seasonWeight +
                recentAverage *
                  candidate.recentWeight;

              const error =
                projection - actual;

              candidate.absoluteError +=
                Math.abs(error);

              candidate.squaredError +=
                error * error;

              candidate.predictions++;
            }
          );
        }
      });

    candidates.forEach(
      candidate => {

        if (
          !candidate.predictions
        ) {
          return;
        }

        const mae =
          candidate.absoluteError /
          candidate.predictions;

        const rmse =
          Math.sqrt(
            candidate.squaredError /
            candidate.predictions
          );

        output.push([
          marketKey,
          config.label,
          config.role,
          candidate.seasonWeight,
          candidate.recentWeight,
          candidate.predictions,
          mae,
          rmse
        ]);
      }
    );
  });

  const sheetName =
    "NHL Projection Backtest";

  let outputSheet =
    ss.getSheetByName(
      sheetName
    );

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(
        sheetName
      );
  } else {
    outputSheet.clearContents();
  }

  const headers = [
    "Market",
    "Stat",
    "Role",
    "Season Weight",
    "Recent 5 Weight",
    "Predictions",
    "MAE",
    "RMSE"
  ];

  outputSheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([
      headers
    ]);

  if (output.length) {
    outputSheet
      .getRange(
        2,
        1,
        output.length,
        headers.length
      )
      .setValues(
        output
      );

    outputSheet
      .getRange(
        2,
        4,
        output.length,
        2
      )
      .setNumberFormat(
        "0%"
      );

    outputSheet
      .getRange(
        2,
        7,
        output.length,
        2
      )
      .setNumberFormat(
        "0.0000"
      );
  }

  outputSheet.setFrozenRows(1);

  outputSheet.autoResizeColumns(
    1,
    headers.length
  );

  Logger.log(
    JSON.stringify({
      test:
        "NHL PROJECTION BACKTEST",
      markets:
        Object.keys(
          NHL_PROJECTION_BACKTEST_MARKETS
        ).length,
      outputRows:
        output.length,
      pass:
        output.length > 0
    })
  );
}

