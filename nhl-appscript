    VGK: { conference: "Western", division: "Pacific" },
    WPG: { conference: "Western", division: "Central" },
    WSH: { conference: "Eastern", division: "Metropolitan" }
  };


  const allTeams =
    fetchAllNHLTeams_();


  Logger.log(
    `BALLDONTLIE NHL team records loaded for metadata: ${allTeams.length}`
  );


  const index = {};


  allTeams.forEach(team => {

    const abbreviation =
      String(
        team.abbreviation ||
        team.tricode ||
        ""
      )
        .trim()
        .toUpperCase();


    if (
      !abbreviation ||
      !allowedCodes.has(abbreviation)
    ) {
      return;
    }


    /*
     * BALLDONTLIE can contain historical team records sharing
     * a current abbreviation.
     *
     * Prefer the greatest numeric ID and log the collision.
     */
    if (index[abbreviation]) {

      Logger.log(
        `DUPLICATE CURRENT TEAM METADATA | ` +
        `${abbreviation} | ` +
        `existing ID ${index[abbreviation].id || ""} | ` +
        `candidate ID ${team.id || ""}`
      );


      const existingId =
        Number(index[abbreviation].id);

      const candidateId =
        Number(team.id);


      if (
        Number.isFinite(candidateId) &&
        (
          !Number.isFinite(existingId) ||
          candidateId > existingId
        )
      ) {
        index[abbreviation] = team;
      }

      return;
    }


    index[abbreviation] =
      team;
  });


  /*
   * Attach verified NHL league-structure metadata.
   */
  Object.keys(index).forEach(code => {

    const alignment =
      leagueAlignment[code];


    if (!alignment) {
      return;
    }


    index[code] =
      Object.assign(
        {},
        index[code],
        {
          conference:
            alignment.conference,

          division:
            alignment.division
        }
      );
  });


  const missingTeams =
    Array.from(allowedCodes)
      .filter(code =>
        !index[code]
      );


  const missingAlignment =
    Array.from(allowedCodes)
      .filter(code =>
        !leagueAlignment[code]
      );


  Logger.log(
    `Verified current NHL team metadata records: ${Object.keys(index).length}`
  );


  if (missingTeams.length > 0) {

    Logger.log(
      `Missing BALLDONTLIE current-team records: ${missingTeams.join(", ")}`
    );

    throw new Error(
      "Could not resolve BALLDONTLIE metadata for every current NHL team."
    );
  }


  if (missingAlignment.length > 0) {

    Logger.log(
      `Missing NHL alignment metadata: ${missingAlignment.join(", ")}`
    );

    throw new Error(
      "Could not resolve conference/division for every current NHL team."
    );
  }


  return index;
}

function fetchAllNHLActivePlayersFromTeamRosters_() {

  Logger.log(
    "Building NHL active-player roster from official NHL current rosters..."
  );

  /*
   * Current NHL franchises.
   *
   * We intentionally do NOT use BALLDONTLIE /teams here because
   * that endpoint includes historical/defunct NHL franchises.
   */
  const teamCodes = [
    "ANA",
    "BOS",
    "BUF",
    "CAR",
    "CBJ",
    "CGY",
    "CHI",
    "COL",
    "DAL",
    "DET",
    "EDM",
    "FLA",
    "LAK",
    "MIN",
    "MTL",
    "NJD",
    "NSH",
    "NYI",
    "NYR",
    "OTT",
    "PHI",
    "PIT",
    "SEA",
    "SJS",
    "STL",
    "TBL",
    "TOR",
    "UTA",
    "VAN",
    "VGK",
    "WPG",
    "WSH"
  ];

  /*
   * Resolve metadata only for the 32 verified current franchises.
   * Historical/defunct BALLDONTLIE teams are ignored.
   */
  const currentTeamMetadata =
    buildNHLCurrentTeamMetadataIndex_(
      teamCodes
    );

  /*
   * BALLDONTLIE remains the Sportacular identity source.
   *
   * We preserve its player IDs because those IDs are already used
   * throughout Player Props, Trends, Profiles, and historical data.
   */
  const bdlPlayers =
    fetchAllNHLPlayersForRosterIdentity_();


  Logger.log(
    `BALLDONTLIE identity players loaded: ${bdlPlayers.length}`
  );


  const normalizeName = value =>
    String(value || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]/g, "");


  const bdlByName = {};

  bdlPlayers.forEach(player => {

    const fullName =
      `${player.first_name || ""} ${player.last_name || ""}`
        .trim();

    const key =
      normalizeName(fullName);

    if (!key) {
      return;
    }

    if (!bdlByName[key]) {
      bdlByName[key] = [];
    }

    bdlByName[key].push(player);
  });


  const playerMap = {};

  let officialPlayerCount = 0;
  let matchedCount = 0;
  let ambiguousCount = 0;
  let unmatchedCount = 0;


  teamCodes.forEach((teamCode, index) => {

    Logger.log(
      `Fetching official NHL roster ${index + 1}/${teamCodes.length}: ${teamCode}`
    );


    const roster =
      fetchOfficialNHLCurrentRoster_(teamCode);


    Logger.log(
      `${teamCode}: ${roster.length} current roster players`
    );


    officialPlayerCount +=
      roster.length;


    roster.forEach(officialPlayer => {

      const firstName =
        getOfficialNHLNameValue_(
          officialPlayer.firstName
        );

      const lastName =
        getOfficialNHLNameValue_(
          officialPlayer.lastName
        );

      const fullName =
        `${firstName} ${lastName}`
          .trim();

      const key =
        normalizeName(fullName);

      const matches =
        key && bdlByName[key]
          ? bdlByName[key]
          : [];


      if (matches.length === 0) {

        unmatchedCount++;

        Logger.log(
          `UNMATCHED CURRENT PLAYER | ` +
          `${teamCode} | ${fullName} | ` +
          `NHL ID ${officialPlayer.id || ""}`
        );

        return;
      }


      let bdlPlayer = null;


      if (matches.length === 1) {

        bdlPlayer =
          matches[0];

      } else {

        /*
         * Duplicate-name resolver.
         *
         * BALLDONTLIE can contain multiple NHL players with the
         * exact same first + last name.
         *
         * Use official current team + position together with the
         * BALLDONTLIE team-history records to resolve the identity.
         */
        bdlPlayer =
          resolveNHLCurrentRosterIdentity_(
            matches,
            teamCode,
            officialPlayer.positionCode || "",
            fullName
          );


        if (!bdlPlayer) {

          ambiguousCount++;

          Logger.log(
            `AMBIGUOUS CURRENT PLAYER | ` +
            `${teamCode} | ${fullName} | ` +
            `${matches.length} BALLDONTLIE matches | ` +
            `could not resolve automatically`
          );

          return;
        }


        Logger.log(
          `RESOLVED DUPLICATE NAME | ` +
          `${teamCode} | ${fullName} | ` +
          `BDL ID ${bdlPlayer.id || ""} | ` +
          `Position ${officialPlayer.positionCode || ""}`
        );
      }


      /*
       * Preserve the BALLDONTLIE player object and player ID,
       * but make the official current NHL roster authoritative
       * for current team + position.
       */
      const resolvedPlayer =
        Object.assign(
          {},
          bdlPlayer,
          {
            team: {
              id:
                (
                  currentTeamMetadata[teamCode] &&
                  currentTeamMetadata[teamCode].id
                ) || "",

              full_name:
                (
                  currentTeamMetadata[teamCode] &&
                  (
                    currentTeamMetadata[teamCode].full_name ||
                    currentTeamMetadata[teamCode].name
                  )
                ) ||
                getOfficialNHLTeamName_(officialPlayer) ||
                teamCode,

              abbreviation:
                teamCode,

              conference:
                (
                  currentTeamMetadata[teamCode] &&
                  currentTeamMetadata[teamCode].conference
                ) || "",

              division:
                (
                  currentTeamMetadata[teamCode] &&
                  currentTeamMetadata[teamCode].division
                ) || ""
            },

            position:
              officialPlayer.positionCode ||
              bdlPlayer.position_code ||
              bdlPlayer.position ||
              ""
          }
        );


      playerMap[bdlPlayer.id] =
        resolvedPlayer;

      matchedCount++;
    });


    Utilities.sleep(100);
  });


  const players =
    Object.values(playerMap)
      .sort((a, b) => {

        const aName =
          `${a.last_name || ""} ${a.first_name || ""}`
            .trim();

        const bName =
          `${b.last_name || ""} ${b.first_name || ""}`
            .trim();

        return aName.localeCompare(bName);
      });


  Logger.log("==============================================");
  Logger.log("NHL CURRENT ROSTER BUILD SUMMARY");
  Logger.log("==============================================");

  Logger.log(
    `Official roster entries: ${officialPlayerCount}`
  );

  Logger.log(
    `Matched roster entries: ${matchedCount}`
  );

  Logger.log(
    `Ambiguous roster entries: ${ambiguousCount}`
  );

  Logger.log(
    `Unmatched roster entries: ${unmatchedCount}`
  );

  Logger.log(
    `Unique active BALLDONTLIE players built: ${players.length}`
  );

  Logger.log("==============================================");


  /*
   * Do not silently produce a partial current-roster sheet.
   *
   * If identity reconciliation fails, stop before production
   * refresh can overwrite NHL Players with incomplete data.
   */
  if (
    officialPlayerCount === 0 ||
    ambiguousCount > 0 ||
    unmatchedCount > 0 ||
    players.length !== officialPlayerCount
  ) {

    throw new Error(
      "NHL current-roster reconciliation failed. " +
      `Official=${officialPlayerCount}, ` +
      `Matched=${matchedCount}, ` +
      `Ambiguous=${ambiguousCount}, ` +
      `Unmatched=${unmatchedCount}, ` +
      `Unique=${players.length}.`
    );
  }


  return players;
}

function resolveNHLCurrentRosterIdentity_(
  matches,
  currentTeamCode,
  officialPosition,
  playerName
) {

  if (
    !Array.isArray(matches) ||
    matches.length === 0
  ) {
    return null;
  }


  const normalizeCode = value =>
    String(value || "")
      .trim()
      .toUpperCase();


  const normalizePosition = value =>
    String(value || "")
      .trim()
      .toUpperCase();


  const wantedTeam =
    normalizeCode(currentTeamCode);

  const wantedPosition =
    normalizePosition(officialPosition);


  /*
   * Score each duplicate-name candidate.
   *
   * Strongest evidence:
   *   Recent BALLDONTLIE team history matches the official
   *   NHL current roster team.
   *
   * Supporting evidence:
   *   Position matches.
   */
  const scored =
    matches.map(player => {

      let score = 0;

      const candidatePosition =
        normalizePosition(
          player.position_code ||
          player.position ||
          ""
        );


      if (
        wantedPosition &&
        candidatePosition === wantedPosition
      ) {
        score += 100;
      }


      const teams =
        Array.isArray(player.teams)
          ? player.teams
          : [];


      let newestMatchingSeason = null;
      let newestAnySeason = null;


      teams.forEach(teamEntry => {

        const season =
          Number(teamEntry.season);

        if (Number.isFinite(season)) {

          if (
            newestAnySeason === null ||
            season > newestAnySeason
          ) {
            newestAnySeason = season;
          }
        }


        const historyTeamCode =
          normalizeCode(
            teamEntry.abbreviation ||
            teamEntry.tricode ||
            (
              teamEntry.team &&
              (
                teamEntry.team.abbreviation ||
                teamEntry.team.tricode
              )
            ) ||
            ""
          );


        if (
          historyTeamCode === wantedTeam &&
          Number.isFinite(season)
        ) {

          if (
            newestMatchingSeason === null ||
            season > newestMatchingSeason
          ) {
            newestMatchingSeason = season;
          }
        }
      });


      /*
       * A matching recent team assignment is the strongest
       * identity signal.
       */
      if (newestMatchingSeason !== null) {

        score += 1000;

        /*
         * Prefer the candidate whose matching team history is
         * the most recent.
         */
        score +=
          Math.max(
            0,
            newestMatchingSeason - 1900
          );
      }


      return {
        player,
        score,
        newestMatchingSeason,
        newestAnySeason,
        candidatePosition
      };
    });


  scored.sort(
    (a, b) =>
      b.score - a.score
  );


  Logger.log(
    `Duplicate-name resolution candidates | ` +
    `${currentTeamCode} | ${playerName}`
  );


  scored.forEach(candidate => {

    Logger.log(
      `  BDL ID ${candidate.player.id || ""} | ` +
      `score=${candidate.score} | ` +
      `position=${candidate.candidatePosition || ""} | ` +
      `matchingTeamSeason=${candidate.newestMatchingSeason ?? ""} | ` +
      `newestAnySeason=${candidate.newestAnySeason ?? ""}`
    );
  });


  if (scored.length === 1) {
    return scored[0].player;
  }


  const best =
    scored[0];

  const second =
    scored[1];


  /*
   * Require a genuine winner.
   *
   * Never guess if two duplicate-name candidates receive the
   * same score.
   */
  if (
    best.score <= 0 ||
    best.score === second.score
  ) {

    return null;
  }


  return best.player;
}

function fetchAllNHLPlayersForRosterIdentity_() {

  const players = [];

  let cursor = null;

  do {

    const params = {
      per_page: 100
    };

    if (cursor) {
      params.cursor = cursor;
    }

    const response =
      fetchApi_(
        "/nhl/v1/players",
        params
      );

    const pagePlayers =
      Array.isArray(response.data)
        ? response.data
        : [];

    players.push(...pagePlayers);

    cursor =
      response.meta &&
      response.meta.next_cursor
        ? response.meta.next_cursor
        : null;

  } while (cursor);


  return players;
}


function fetchOfficialNHLCurrentRoster_(teamCode) {

  const url =
    `https://api-web.nhle.com/v1/roster/${teamCode}/current`;


  const response =
    UrlFetchApp.fetch(
      url,
      {
        muteHttpExceptions: true
      }
    );


  const statusCode =
    response.getResponseCode();


  if (statusCode !== 200) {

    throw new Error(
      `Official NHL roster request failed for ${teamCode}. ` +
      `HTTP ${statusCode}.`
    );
  }


  const payload =
    JSON.parse(
      response.getContentText()
    );


  return [
    ...(
      Array.isArray(payload.forwards)
        ? payload.forwards
        : []
    ),

    ...(
      Array.isArray(payload.defensemen)
        ? payload.defensemen
        : []
    ),

    ...(
      Array.isArray(payload.goalies)
        ? payload.goalies
        : []
    )
  ];
}


function getOfficialNHLNameValue_(value) {

  if (
    value === null ||
    value === undefined
  ) {
    return "";
  }


  if (
    typeof value === "object"
  ) {

    return String(
      value.default ||
      value.en ||
      ""
    ).trim();
  }


  return String(value).trim();
}


function getOfficialNHLTeamName_(player) {

  if (
    !player ||
    !player.currentTeam
  ) {
    return "";
  }


  const currentTeam =
    player.currentTeam;


  if (
    typeof currentTeam === "string"
  ) {
    return currentTeam.trim();
  }


  if (
    typeof currentTeam === "object"
  ) {

    return String(
      currentTeam.name ||
      currentTeam.fullName ||
      currentTeam.default ||
      currentTeam.en ||
      ""
    ).trim();
  }


  return "";
}

