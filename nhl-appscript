      now
    ];
  });

  rows.sort((a, b) => String(a[0] || "").localeCompare(String(b[0] || "")));

  writeNHLOutputSheet_(sheet, headers, rows);

  Logger.log(`Wrote ${rows.length} rows to NHL Team Season Stats.`);
}

