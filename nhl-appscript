function auditNHLGoalieIdentity() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const gameLogSheet =
    ss.getSheetByName(
      "NHL Player Game Logs"
    );

  if (!gameLogSheet) {
    throw new Error(
      'Missing required sheet: "NHL Player Game Logs".'
    );
  }

  const positionMap =
    getNHLPlayerPositionMap_();

  const rows =
    getNHLObjectsFromSheet_(
      gameLogSheet
    ).filter(
      isNHLRegularSeasonResearchDate_
    );

  let totalRows = 0;

  let positionKnown = 0;
  let positionUnknown = 0;

  let positionGoalieRows = 0;
  let positionSkaterRows = 0;

  let savesPositiveRows = 0;
  let savesZeroRows = 0;

  let goalieWithPositiveSaves = 0;
  let goalieWithZeroSaves = 0;

  let skaterWithPositiveSaves = 0;
  let skaterWithZeroSaves = 0;

  const goalieZeroExamples = [];
  const skaterPositiveExamples = [];
  const unknownExamples = [];

  rows.forEach(row => {
    totalRows++;

    const playerId =
      String(
        row["Player ID"] || ""
      ).trim();

    const playerName =
      String(
        row["Player Name"] || ""
      ).trim();

    const positionCode =
      positionMap[playerId] || "";

    const rawSaves =
      row["Saves"];

    if (
      rawSaves === "" ||
      rawSaves === null ||
      rawSaves === undefined
    ) {
      return;
    }

    const saves =
      Number(rawSaves);

    if (
      !Number.isFinite(saves)
    ) {
      return;
    }

    const hasPositiveSaves =
      saves > 0;

    if (hasPositiveSaves) {
      savesPositiveRows++;
    } else {
      savesZeroRows++;
    }

    if (!positionCode) {
      positionUnknown++;

      if (
        unknownExamples.length < 10
      ) {
        unknownExamples.push([
          row["Game Date"],
          row["Game ID"],
          playerId,
          playerName,
          positionCode,
          saves
        ]);
      }

      return;
    }

    positionKnown++;

    if (positionCode === "G") {
      positionGoalieRows++;

      if (hasPositiveSaves) {
        goalieWithPositiveSaves++;
      } else {
        goalieWithZeroSaves++;

        if (
          goalieZeroExamples.length < 10
        ) {
          goalieZeroExamples.push([
            row["Game Date"],
            row["Game ID"],
            playerId,
            playerName,
            positionCode,
            saves
          ]);
        }
      }

      return;
    }

    positionSkaterRows++;

    if (hasPositiveSaves) {
      skaterWithPositiveSaves++;

      if (
        skaterPositiveExamples.length < 10
      ) {
        skaterPositiveExamples.push([
          row["Game Date"],
          row["Game ID"],
          playerId,
          playerName,
          positionCode,
          saves
        ]);
      }
    } else {
      skaterWithZeroSaves++;
    }
  });

  const summary = [
    [
      "Metric",
      "Value"
    ],

    [
      "Total Regular-Season Rows",
      totalRows
    ],

    [
      "Rows With Known Position",
      positionKnown
    ],

    [
      "Rows With Unknown Position",
      positionUnknown
    ],

    [
      "Position-Code Goalie Rows",
      positionGoalieRows
    ],

    [
      "Position-Code Skater Rows",
      positionSkaterRows
    ],

    [
      "Rows With Saves > 0",
      savesPositiveRows
    ],

    [
      "Rows With Saves = 0",
      savesZeroRows
    ],

    [
      "Goalie Rows With Saves > 0",
      goalieWithPositiveSaves
    ],

    [
      "Goalie Rows With Saves = 0",
      goalieWithZeroSaves
    ],

    [
      "Skater Rows With Saves > 0",
      skaterWithPositiveSaves
    ],

    [
      "Skater Rows With Saves = 0",
      skaterWithZeroSaves
    ]
  ];

  const sheetName =
    "NHL Goalie Identity Audit";

  let outputSheet =
    ss.getSheetByName(
      sheetName
    );

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(
        sheetName
      );
  } else {
    outputSheet.clearContents();
  }

  outputSheet
    .getRange(
      1,
      1,
      summary.length,
      2
    )
    .setValues(
      summary
    );

  let nextRow =
    summary.length + 2;

  function writeExamples_(
    title,
    examples
  ) {
    outputSheet
      .getRange(
        nextRow,
        1
      )
      .setValue(
        title
      );

    nextRow++;

    outputSheet
      .getRange(
        nextRow,
        1,
        1,
        6
      )
      .setValues([[
        "Game Date",
        "Game ID",
        "Player ID",
        "Player Name",
        "Position Code",
        "Saves"
      ]]);

    nextRow++;

    if (examples.length) {
      outputSheet
        .getRange(
          nextRow,
          1,
          examples.length,
          6
        )
        .setValues(
          examples
        );

      nextRow +=
        examples.length;
    }

    nextRow += 2;
  }

  writeExamples_(
    "Goalies With 0 Saves",
    goalieZeroExamples
  );

  writeExamples_(
    "Non-Goalies With Saves > 0",
    skaterPositiveExamples
  );

  writeExamples_(
    "Rows With Unknown Position",
    unknownExamples
  );

  outputSheet.setFrozenRows(1);

  outputSheet.autoResizeColumns(
    1,
    6
  );

  const pass =
    totalRows > 0 &&
    positionKnown > 0;

  Logger.log(
    JSON.stringify({
      test:
        "NHL GOALIE IDENTITY AUDIT",

      totalRows,

      positionKnown,

      positionUnknown,

      positionGoalieRows,

      goalieWithPositiveSaves,

      goalieWithZeroSaves,

      skaterWithPositiveSaves,

      pass
    })
  );
}

