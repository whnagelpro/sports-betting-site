/**
 * Returns the player's current NHL team from the NHL Players
 * "Teams" field.
 *
 * Supports:
 * - plain team names
 * - comma-separated team history
 * - JSON arrays / objects stored as text
 *
 * When multiple teams are present, the final team is treated
 * as the current team.
 */
function getNHLCurrentTeam_(teamsValue) {

  if (
    teamsValue === null ||
    teamsValue === undefined ||
    teamsValue === ""
  ) {
    return null;
  }

  // Already an array.
  if (Array.isArray(teamsValue)) {

    if (!teamsValue.length) {
      return null;
    }

    const lastTeam =
      teamsValue[teamsValue.length - 1];

    if (
      lastTeam &&
      typeof lastTeam === "object"
    ) {
      return String(
        lastTeam.full_name ||
        lastTeam.name ||
        lastTeam.abbreviation ||
        ""
      ).trim() || null;
    }

    return String(lastTeam).trim() || null;
  }

  // Already an object.
  if (
    typeof teamsValue === "object"
  ) {
    return String(
      teamsValue.full_name ||
      teamsValue.name ||
      teamsValue.abbreviation ||
      ""
    ).trim() || null;
  }

  const raw =
    String(teamsValue).trim();

  if (!raw) {
    return null;
  }

  // Handle JSON stored in the sheet.
  if (
    raw.startsWith("[") ||
    raw.startsWith("{")
  ) {

    try {

      const parsed =
        JSON.parse(raw);

      return getNHLCurrentTeam_(parsed);

    } catch (error) {

      // Fall through to normal text handling.

    }

  }

  // If Teams contains multiple historical teams,
  // use the final/current entry.
  const teams =
    raw
      .split(",")
      .map(team => team.trim())
      .filter(Boolean);

  return teams.length
