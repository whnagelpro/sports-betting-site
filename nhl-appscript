function factorialNHL_(n) {
  if (
    !Number.isInteger(n) ||
    n < 0
  ) {
    return null;
  }

  let result = 1;

  for (
    let i = 2;
    i <= n;
    i++
  ) {
    result *= i;
  }

  return result;
}

function poissonPMFNHL_(k, lambda) {
  const count =
    Number(k);

  const mean =
    Number(lambda);

  if (
    !Number.isInteger(count) ||
    count < 0 ||
    !Number.isFinite(mean) ||
    mean < 0
  ) {
    return null;
  }

  if (mean === 0) {
    return count === 0
      ? 1
      : 0;
  }

  const factorial =
    factorialNHL_(
      count
    );

  if (
    factorial === null
  ) {
    return null;
  }

  return (
    Math.exp(-mean) *
    Math.pow(
      mean,
      count
    ) /
    factorial
  );
}

function poissonCDFNHL_(k, lambda) {
  const maxCount =
    Math.floor(
      Number(k)
    );

  const mean =
    Number(lambda);

  if (
    !Number.isFinite(maxCount) ||
    maxCount < 0 ||
    !Number.isFinite(mean) ||
    mean < 0
  ) {
    return null;
  }

  let total = 0;

  for (
    let i = 0;
    i <= maxCount;
    i++
  ) {
    const probability =
      poissonPMFNHL_(
        i,
        mean
      );

    if (
      probability === null
    ) {
      return null;
    }

    total +=
      probability;
  }

  return Math.min(
    1,
    Math.max(
      0,
      total
    )
  );
}

function poissonOverProbabilityNHL_(
  lambda,
  line
) {
  const mean =
    Number(lambda);

  const threshold =
    Number(line);

  if (
    !Number.isFinite(mean) ||
    mean < 0 ||
    !Number.isFinite(threshold)
  ) {
    return null;
  }

  // Example:
  // line 2.5
  // Over wins when X >= 3.
  //
  // Therefore:
  // P(Over 2.5) = 1 - P(X <= 2)

  const maxUnderCount =
    Math.floor(
      threshold
    );

  const underOrEqual =
    poissonCDFNHL_(
      maxUnderCount,
      mean
    );

  if (
    underOrEqual === null
  ) {
    return null;
  }

  return Math.min(
    1,
    Math.max(
      0,
      1 -
      underOrEqual
    )
  );
}

// ============================================================================
// P10/18 — NHL NEGATIVE BINOMIAL PROBABILITY HELPERS
//
// NB2 parameterization:
//
//   Mean     = mu
//   Variance = mu + alpha * mu^2
//
// alpha = 0 approaches Poisson.
//
// Research only.
// ============================================================================

function logGammaNHL_(z) {
  const coefficients = [
    676.5203681218851,
    -1259.1392167224028,
    771.32342877765313,
    -176.61502916214059,
    12.507343278686905,
    -0.13857109526572012,
    0.000009984369578019572,
    0.00000015056327351493116
  ];

  if (z < 0.5) {
    return (
      Math.log(Math.PI) -
      Math.log(
        Math.sin(
          Math.PI * z
        )
      ) -
      logGammaNHL_(
        1 - z
      )
    );
  }

  let x =
    0.99999999999980993;

  const adjusted =
    z - 1;

  for (
    let i = 0;
    i < coefficients.length;
    i++
  ) {
    x +=
      coefficients[i] /
      (
        adjusted +
        i +
        1
      );
  }

  const t =
    adjusted +
    coefficients.length -
    0.5;

  return (
    0.5 *
      Math.log(
        2 * Math.PI
      ) +
    (
      adjusted +
      0.5
    ) *
      Math.log(t) -
    t +
    Math.log(x)
  );
}

function estimateNHLNB2Alpha_(
  values
) {
  const clean =
    values.filter(value =>
      Number.isFinite(value) &&
      value >= 0
    );

  if (clean.length < 2) {
    return null;
  }

  const mean =
    avgNHL_(
      clean
    );

  if (
    !Number.isFinite(mean) ||
    mean <= 0
  ) {
    return null;
  }

  const variance =
    clean.reduce(
      (sum, value) => {
        const difference =
          value - mean;

        return (
          sum +
          difference *
            difference
        );
      },
      0
    ) /
    clean.length;

  // NB2:
  //
  // variance =
  // mean + alpha * mean^2
  //
  // therefore:
  //
  // alpha =
  // (variance - mean) / mean^2

  const alpha =
    (
      variance -
      mean
    ) /
    (
      mean *
      mean
    );

  if (
    !Number.isFinite(alpha)
  ) {
    return null;
  }

  // If historical variance does not exceed the mean,
  // there is no positive NB2 overdispersion to estimate.
  return Math.max(
    0,
    alpha
  );
}

function negativeBinomialPMFNHL_(
  k,
  mu,
  alpha
) {
  const count =
    Number(k);

  const mean =
    Number(mu);

  const dispersion =
    Number(alpha);

  if (
    !Number.isInteger(count) ||
    count < 0 ||
    !Number.isFinite(mean) ||
    mean < 0 ||
    !Number.isFinite(dispersion) ||
    dispersion < 0
  ) {
    return null;
  }

  if (mean === 0) {
    return count === 0
      ? 1
      : 0;
  }

  // alpha -> 0 is the Poisson limit.
  if (
    dispersion < 0.000000001
  ) {
    return poissonPMFNHL_(
      count,
      mean
    );
  }

  const r =
    1 /
    dispersion;

  const p =
    r /
    (
      r +
      mean
    );

  const logProbability =
    logGammaNHL_(
      count + r
    ) -
    logGammaNHL_(
      r
    ) -
    logGammaNHL_(
      count + 1
    ) +
    r *
      Math.log(p) +
    count *
      Math.log(
        1 - p
      );

  const probability =
    Math.exp(
      logProbability
    );

  if (
    !Number.isFinite(
      probability
    )
  ) {
    return null;
  }

  return probability;
}

function negativeBinomialCDFNHL_(
  k,
  mu,
  alpha
) {
  const maxCount =
    Math.floor(
      Number(k)
    );

  if (
    !Number.isFinite(maxCount) ||
    maxCount < 0
  ) {
    return null;
  }

  let total = 0;

  for (
    let i = 0;
    i <= maxCount;
    i++
  ) {
    const probability =
      negativeBinomialPMFNHL_(
        i,
        mu,
        alpha
      );

    if (
      probability === null
    ) {
      return null;
    }

    total +=
      probability;
  }

  return Math.min(
    1,
    Math.max(
      0,
      total
    )
  );
}

function negativeBinomialOverProbabilityNHL_(
  mu,
  alpha,
  line
) {
  const mean =
    Number(mu);

  const dispersion =
    Number(alpha);

  const threshold =
    Number(line);

  if (
    !Number.isFinite(mean) ||
    mean < 0 ||
    !Number.isFinite(dispersion) ||
    dispersion < 0 ||
    !Number.isFinite(threshold)
  ) {
    return null;
  }

  const maxUnderCount =
    Math.floor(
      threshold
    );

  const cdf =
    negativeBinomialCDFNHL_(
      maxUnderCount,
      mean,
      dispersion
    );

  if (cdf === null) {
    return null;
  }

  return Math.min(
    1,
    Math.max(
      0,
      1 - cdf
    )
  );
}

function compareNHLProbabilityDistributions() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sourceSheet =
    ss.getSheetByName(
      "NHL Player Game Logs"
    );

  if (!sourceSheet) {
    throw new Error(
      'Missing required sheet: "NHL Player Game Logs".'
    );
  }

  const rows =
    getNHLObjectsFromSheet_(
      sourceSheet
    ).filter(
      isNHLRegularSeasonResearchDate_
    );

  const playerGames = {};

  rows.forEach(row => {
    const playerId =
      String(
        row["Player ID"] || ""
      ).trim();

    if (!playerId) {
      return;
    }

    if (!playerGames[playerId]) {
      playerGames[playerId] = [];
    }

    playerGames[playerId].push(
      row
    );
  });

  Object.keys(
    playerGames
  ).forEach(playerId => {
    playerGames[playerId].sort(
      (a, b) =>
        getNHLBacktestDateValue_(a) -
        getNHLBacktestDateValue_(b)
    );
  });

  const output = [];

  Object.keys(
    NHL_PROBABILITY_BACKTEST_MARKETS
  ).forEach(marketKey => {

    const config =
      NHL_PROBABILITY_BACKTEST_MARKETS[
        marketKey
      ];

    const lines =
      NHL_PROBABILITY_TEST_LINES[
        marketKey
      ] || [];

    lines.forEach(line => {

      let predictions = 0;

      let poissonBrierTotal = 0;
      let nbBrierTotal = 0;

      let poissonPredictedTotal = 0;
      let nbPredictedTotal = 0;

      let actualTotal = 0;

      let alphaTotal = 0;
      let alphaCount = 0;

      Object.keys(
        playerGames
      ).forEach(playerId => {

        const eligibleGames =
          playerGames[playerId]
            .filter(row =>
              isNHLEligiblePropGame_(
                row,
                config
              )
            );

        if (
          eligibleGames.length < 11
        ) {
          return;
        }

        for (
          let i = 10;
          i < eligibleGames.length;
          i++
        ) {
          const priorGames =
            eligibleGames.slice(
              0,
              i
            );

          const priorValues =
            priorGames
              .map(row =>
                getNHLBacktestStatValue_(
                  row,
                  config
                )
              )
              .filter(value =>
                value !== null
              );

          if (
            priorValues.length < 10
          ) {
            continue;
          }

          const recentValues =
            priorValues.slice(-5);

          if (
            recentValues.length < 5
          ) {
            continue;
          }

          const seasonAverage =
            avgNHL_(
              priorValues
            );

          const recentAverage =
            avgNHL_(
              recentValues
            );

          const projection =
            calculateNHLPropProjection_(
              marketKey,
              seasonAverage,
              recentAverage
            );

          if (
            !projection ||
            !Number.isFinite(
              projection.projectedStat
            )
          ) {
            continue;
          }

          // IMPORTANT:
          // Dispersion is estimated using PRIOR games only.
          // No target-game information enters alpha.
          const alpha =
            estimateNHLNB2Alpha_(
              priorValues
            );

          if (
            alpha === null
          ) {
            continue;
          }

          const poissonProbability =
            poissonOverProbabilityNHL_(
              projection.projectedStat,
              line
            );

          const nbProbability =
            negativeBinomialOverProbabilityNHL_(
              projection.projectedStat,
              alpha,
              line
            );

          if (
            poissonProbability === null ||
            nbProbability === null ||
            !Number.isFinite(
              poissonProbability
            ) ||
            !Number.isFinite(
              nbProbability
            )
          ) {
            continue;
          }

          const actualValue =
            getNHLBacktestStatValue_(
              eligibleGames[i],
              config
            );

          if (
            actualValue === null
          ) {
            continue;
          }

          const outcome =
            actualValue > line
              ? 1
              : 0;

          const poissonError =
            poissonProbability -
            outcome;

          const nbError =
            nbProbability -
            outcome;

          poissonBrierTotal +=
            poissonError *
            poissonError;

          nbBrierTotal +=
            nbError *
            nbError;

          poissonPredictedTotal +=
            poissonProbability;

          nbPredictedTotal +=
            nbProbability;

          actualTotal +=
            outcome;

          alphaTotal +=
            alpha;

          alphaCount++;

          predictions++;
        }
      });

      if (!predictions) {
        output.push([
          marketKey,
          config.label,
          line,
          0,
          "",
          "",
          "",
          "",
          "",
          "",
          "",
          "",
          "",
          ""
        ]);

        return;
      }

      const poissonBrier =
        poissonBrierTotal /
        predictions;

      const nbBrier =
        nbBrierTotal /
        predictions;

      const poissonAverage =
        poissonPredictedTotal /
        predictions;

      const nbAverage =
        nbPredictedTotal /
        predictions;

      const actualRate =
        actualTotal /
        predictions;

      const poissonGap =
        poissonAverage -
        actualRate;

      const nbGap =
        nbAverage -
        actualRate;

      const brierImprovement =
        poissonBrier === 0
          ? 0
          : (
              poissonBrier -
              nbBrier
            ) /
            poissonBrier;

      const averageAlpha =
        alphaCount
          ? alphaTotal /
            alphaCount
          : null;

      let winner =
        "Poisson";

      if (
        nbBrier < poissonBrier &&
        Math.abs(nbGap) <=
          Math.abs(poissonGap)
      ) {
        winner =
          "Negative Binomial";
      } else if (
        nbBrier === poissonBrier &&
        Math.abs(nbGap) ===
          Math.abs(poissonGap)
      ) {
        winner =
          "Tie";
      }

      output.push([
        marketKey,
        config.label,
        line,
        predictions,
        averageAlpha,
        poissonBrier,
        nbBrier,
        brierImprovement,
        poissonAverage,
        nbAverage,
        actualRate,
        poissonGap,
        nbGap,
        winner
      ]);
    });
  });

  const sheetName =
    "NHL Distribution Comparison";

  let outputSheet =
    ss.getSheetByName(
      sheetName
    );

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(
        sheetName
      );
  } else {
    outputSheet.clearContents();
  }

  const headers = [
    "Market",
    "Stat",
    "Line",
    "Predictions",
    "Avg NB Alpha",
    "Poisson Brier",
    "NB Brier",
    "NB Brier Improvement",
    "Poisson Avg Predicted",
    "NB Avg Predicted",
    "Actual Over Rate",
    "Poisson Calibration Gap",
    "NB Calibration Gap",
    "Winner"
  ];

  outputSheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([
      headers
    ]);

  if (output.length) {
    outputSheet
      .getRange(
        2,
        1,
        output.length,
        headers.length
      )
      .setValues(
        output
      );

    outputSheet
      .getRange(
        2,
        5,
        output.length,
        3
      )
      .setNumberFormat(
        "0.000000"
      );

    outputSheet
      .getRange(
        2,
        8,
        output.length,
        1
      )
      .setNumberFormat(
        "0.00%"
      );

    outputSheet
      .getRange(
        2,
        9,
        output.length,
        5
      )
      .setNumberFormat(
        "0.00%"
      );
  }

  outputSheet.setFrozenRows(1);

  outputSheet.autoResizeColumns(
    1,
    headers.length
  );

  const expectedRows =
    Object.values(
      NHL_PROBABILITY_TEST_LINES
    ).reduce(
      (sum, lines) =>
        sum + lines.length,
      0
    );

  const pass =
    output.length ===
      expectedRows &&
    output.every(
      row =>
        row[3] > 0 &&
        Number.isFinite(
          Number(row[5])
        ) &&
        Number.isFinite(
          Number(row[6])
        )
    );

  Logger.log(
    JSON.stringify({
      test:
        "NHL POISSON VS NEGATIVE BINOMIAL",

      rows:
        output.length,

      expectedRows,

      pass
    })
  );
}

