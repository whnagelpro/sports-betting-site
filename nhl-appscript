// ============================================================================
// D10AB STEP 3 — NHL SAMPLE-SIZE RELIABILITY
//
// Purpose:
//   Introduce and validate a bounded reliability function based on the number
//   of usable historical games available to the NHL prop model.
//
// IMPORTANT:
//   - TEST / INFRASTRUCTURE ONLY
//   - Does NOT change production probabilities
//   - Does NOT change EV
//   - Does NOT change Player Props output
//   - Does NOT yet call calibrateNHLProbabilityShrink_() in production
//
// Reliability schedule:
//
//   0 games  -> 0.55
//   1 game   -> 0.575
//   2 games  -> 0.60
//   5 games  -> 0.675
//   10 games -> 0.80
//   18 games -> 1.00
//
// Linear between those endpoints.
// Reliability is capped at 1.00.
// ============================================================================


function calculateNHLProbabilityReliability_(currentGames) {

  const games =
    Math.max(
      0,
      Number(currentGames) || 0
    );

  const reliability =
    0.55 +
    Math.min(
      games,
      18
    ) *
    (
      (1.00 - 0.55) /
      18
    );

  return Math.min(
    1,
    Math.max(
      0.55,
      reliability
    )
  );
}


