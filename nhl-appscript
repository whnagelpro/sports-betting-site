// ============================================================================
// P10/18 — NHL RAW BOX-SCORE PARTICIPATION DIAGNOSTIC
//
// READ ONLY.
// Does not modify NHL Player Game Logs or Player Props.
//
// Fetches one completed regular-season game and logs:
//   1. Top-level keys returned by the NHL box-score endpoint
//   2. Nested player keys
//   3. Nested team keys
//   4. Representative zero-stat rows
//
// Goal:
// Find a reliable indicator of genuine player participation before changing
// historical game-log ingestion.
// ============================================================================

function auditNHLBoxScoreParticipationFields() {
  const startDate = "2026-04-15";
  const endDate = "2026-04-15";

  const games =
    getNHLCompletedGamesForDateRange_(
      startDate,
      endDate
    );

  if (!games.length) {
    throw new Error(
      "No completed NHL game found for participation diagnostic."
    );
  }

  const game =
    games[0];

  const gameId =
    String(
      game.id || ""
    );

  if (!gameId) {
    throw new Error(
      "Diagnostic game is missing Game ID."
    );
  }

  Logger.log(
    JSON.stringify({
      test:
        "NHL PARTICIPATION DIAGNOSTIC GAME",

      gameId,

      date:
        getNHLGameAZDate_(game),

      away:
        getNHLTeamName_(
          game.away_team || {}
        ),

      home:
        getNHLTeamName_(
          game.home_team || {}
        )
    })
  );

  const rows =
    fetchAllNHLBoxScoresForGameIds_(
      [gameId]
    );

  Logger.log(
    JSON.stringify({
      test:
        "NHL PARTICIPATION ROW COUNT",

      gameId,

      rows:
        rows.length,

      pass:
        rows.length > 0
    })
  );

  if (!rows.length) {
    throw new Error(
      "NHL box-score endpoint returned no rows."
    );
  }

  // ------------------------------------------------------------
  // Discover available schema.
  // ------------------------------------------------------------

  const topLevelKeys =
    Array.from(
      new Set(
        rows.flatMap(
          row =>
            Object.keys(
              row || {}
            )
        )
      )
    ).sort();

  const playerKeys =
    Array.from(
      new Set(
        rows.flatMap(
          row =>
            row &&
            row.player &&
            typeof row.player === "object"
              ? Object.keys(
                  row.player
                )
              : []
        )
      )
    ).sort();

  const teamKeys =
    Array.from(
      new Set(
        rows.flatMap(
          row =>
            row &&
            row.team &&
            typeof row.team === "object"
              ? Object.keys(
                  row.team
                )
              : []
        )
      )
    ).sort();

  Logger.log(
    JSON.stringify({
      test:
        "NHL BOX SCORE TOP LEVEL KEYS",

      keys:
        topLevelKeys
    })
  );

  Logger.log(
    JSON.stringify({
      test:
        "NHL BOX SCORE PLAYER KEYS",

      keys:
        playerKeys
    })
  );

  Logger.log(
    JSON.stringify({
      test:
        "NHL BOX SCORE TEAM KEYS",

      keys:
        teamKeys
    })
  );

  // ------------------------------------------------------------
  // Identify rows that the CURRENT historical loader would reject.
  // ------------------------------------------------------------

  const rejectedRows = [];

  rows.forEach(row => {
    const shotsOnGoal =
      getBoxScoreStatFlexible_(
        row,
        [
          "shots_on_goal",
          "shots",
          "sog"
        ]
      );

    const points =
      getBoxScoreStatFlexible_(
        row,
        ["points"]
      );

    const assists =
      getBoxScoreStatFlexible_(
        row,
        [
          "assists",
          "ast"
        ]
      );

    const goals =
      getBoxScoreStatFlexible_(
        row,
        ["goals"]
      );

    const powerPlayPoints =
      getBoxScoreStatFlexible_(
        row,
        [
          "power_play_points",
          "ppp"
        ]
      );

    const saves =
      getBoxScoreStatFlexible_(
        row,
        ["saves"]
      );

    const blockedShots =
      getBoxScoreStatFlexible_(
        row,
        [
          "blocked_shots",
          "blocks"
        ]
      );

    const hits =
      getBoxScoreStatFlexible_(
        row,
        ["hits"]
      );

    const currentPlayed =
      shotsOnGoal > 0 ||
      points > 0 ||
      assists > 0 ||
      goals > 0 ||
      powerPlayPoints > 0 ||
      saves > 0 ||
      blockedShots > 0 ||
      hits > 0;

    if (currentPlayed) {
      return;
    }

    const playerId =
      row.player_id ||
      (
        row.player &&
        row.player.id
      ) ||
      "";

    const playerName =
      getNHLPlayerNameFromBoxScore_(
        row
      );

    rejectedRows.push({
      playerId,
      playerName,

      topLevel:
        row
    });
  });

  Logger.log(
    JSON.stringify({
      test:
        "NHL CURRENT FILTER REJECTIONS",

      totalRows:
        rows.length,

      rejectedRows:
        rejectedRows.length,

      rejectionRate:
        rows.length
          ? rejectedRows.length /
            rows.length
          : null
    })
  );

  // Log at most five complete rejected objects.
  // This is what we need to inspect for participation fields.
  rejectedRows
    .slice(0, 5)
    .forEach(
      (item, index) => {

        Logger.log(
          JSON.stringify({
            test:
              "NHL REJECTED RAW ROW",

            sample:
              index + 1,

            playerId:
              item.playerId,

            playerName:
              item.playerName,

            row:
              item.topLevel
          })
        );
      }
    );

  Logger.log(
    JSON.stringify({
      test:
        "NHL PARTICIPATION FIELD AUDIT",

      gameId,

      rows:
        rows.length,

      rejectedRows:
        rejectedRows.length,

      pass:
        rows.length > 0
    })
  );
}

