function buildNHLTeamGameStatsMap_(boxScoreRows) {
  const map = {};

  boxScoreRows.forEach(row => {
    const gameId = String(
      row.game_id ||
      (row.game && row.game.id) ||
      ""
    ).trim();

    const rawTeamName =
      row.team_name ||
      getNHLTeamName_(row.team || {});

    const teamName = normalizeNHLTeamName_(rawTeamName);

    if (!gameId || !teamName) return;

    const key = `${gameId}_${teamName}`;

    if (!map[key]) {
      map[key] = {
        goals: 0,
        shotsOnGoal: 0,
        assists: 0,
        points: 0,
        saves: 0,
        rowCount: 0
      };
    }

    map[key].goals += getBoxScoreStatFlexible_(row, ["goals"]);
    map[key].shotsOnGoal += getBoxScoreStatFlexible_(row, ["shots_on_goal", "shots", "sog"]);
    map[key].assists += getBoxScoreStatFlexible_(row, ["assists", "ast"]);
    map[key].points += getBoxScoreStatFlexible_(row, ["points"]);
    map[key].saves += getBoxScoreStatFlexible_(row, ["saves"]);
    map[key].rowCount += 1;
  });

  return map;
}

function writeNHLOutputSheet_(sheet, headers, rows) {
  sheet.clearContents();

  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);

  if (rows.length > 0) {
    sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
  }

  sheet.autoResizeColumns(1, headers.length);
}

function getNHLObjectsFromSheet_(sheet) {
  const values = sheet.getDataRange().getValues();

  if (values.length < 2) return [];

  const headers = values[0];

  return values.slice(1).map(row => {
    const obj = {};

    headers.forEach((header, index) => {
      obj[header] = row[index];
    });

    return obj;
  });
}

function avgNHL_(values) {
  const nums = values
    .map(Number)
    .filter(value => !Number.isNaN(value));

  if (!nums.length) return 0;

  return nums.reduce((sum, value) => sum + value, 0) / nums.length;
}

function stdDevNHL_(values) {
  const nums = values
    .map(Number)
    .filter(value => !Number.isNaN(value));

  if (nums.length < 2) return 0;

  const mean = avgNHL_(nums);
  const variance = avgNHL_(nums.map(value => Math.pow(value - mean, 2)));

  return Math.sqrt(variance);
}

function consistencyScoreNHL_(values) {
  const mean = avgNHL_(values);

  if (!mean) return 0;

  const cv = stdDevNHL_(values) / mean;

  return Math.max(0, Math.min(100, 100 - cv * 100));
}

function trendScoreNHL_(recentAvg, seasonAvg) {
  if (!seasonAvg) return 0;

  return ((recentAvg - seasonAvg) / seasonAvg) * 100;
}

function trendDirectionNHL_(score) {
  if (score >= 7.5) return "Up";
  if (score <= -7.5) return "Down";

  return "Flat";
}

function riskTierNHL_(consistency, absTrendScore) {
  if (consistency >= 75 && absTrendScore <= 20) return "Low";
  if (consistency >= 55) return "Medium";

  return "High";
}

function hitRateNHL_(values, threshold) {
  const nums = values
    .map(Number)
    .filter(value => !Number.isNaN(value));

  if (!nums.length) return 0;

  const hits = nums.filter(value => value >= threshold).length;

  return hits / nums.length;
}

function aboveSeasonPctNHL_(recentAvg, seasonAvg) {
  if (!seasonAvg) return 0;

  return ((recentAvg - seasonAvg) / seasonAvg) * 100;
}

function formatPercentNHL_(value) {
  const num = Number(value);

  if (Number.isNaN(num)) return "0%";

  return `${Math.round(num * 100)}%`;
}

function formatSignedPercentNHL_(value) {
  const num = Number(value);

  if (Number.isNaN(num)) return "0%";

  return num >= 0 ? `+${num.toFixed(1)}%` : `${num.toFixed(1)}%`;
}

function trendStrengthNHL_(hitRate, aboveSeasonPct, trendScore) {
  const hr = Number(hitRate);
  const above = Number(aboveSeasonPct);
  const score = Number(trendScore);

  if (Number.isNaN(hr) || Number.isNaN(above) || Number.isNaN(score)) {
    return "Unknown";
  }

  if (hr >= 0.80 && above >= 20 && score >= 15) {
    return "Elite Trend";
  }

  if (hr >= 0.70 && above >= 10 && score >= 7.5) {
    return "Strong Trend";
  }

  if (hr >= 0.60 && score >= 0) {
    return "Moderate Trend";
  }

  if (score < -10 || above < -10) {
    return "Cold Trend";
  }

  return "Weak Trend";
}

function buildNHLPlayerTrendNote_(playerName, statLabel, seasonAvg, last5, hitRateLast5, trendScore) {
  const safeName = playerName || "This player";
  const safeStat = statLabel || "this stat";

  const last5Text = Number(last5).toFixed(2);
  const seasonText = Number(seasonAvg).toFixed(2);
  const hitRateText = formatPercentNHL_(hitRateLast5);
  const trendText = formatSignedPercentNHL_(trendScore);

  if (trendScore >= 15) {
    return `${safeName} is trending up in ${safeStat}, averaging ${last5Text} over the last 5 compared to ${seasonText} on the season (${trendText}), with a 1+ hit rate of ${hitRateText}.`;
  }

  if (trendScore <= -15) {
    return `${safeName} is trending down in ${safeStat}, averaging ${last5Text} over the last 5 compared to ${seasonText} on the season (${trendText}), with a 1+ hit rate of ${hitRateText}.`;
  }

  return `${safeName} is holding steady in ${safeStat}, averaging ${last5Text} over the last 5 compared to ${seasonText} on the season, with a 1+ hit rate of ${hitRateText}.`;
}

function buildNHLTeamTrendNote_(teamName, metricLabel, seasonAvg, last5, hitRateLast5, trendScore) {
  const team = `The ${teamName || "team"}`;
  const metric = metricLabel || "this metric";

  const last5Text = Number(last5).toFixed(2);
  const seasonText = Number(seasonAvg).toFixed(2);
  const hitRateText = formatPercentNHL_(hitRateLast5);
  const trendText = formatSignedPercentNHL_(trendScore);

  if (trendScore >= 15) {
    return `${team} are trending up in ${metric}, averaging ${last5Text} over the last 5 games compared to ${seasonText} on the season (${trendText}), with a 1+ hit rate of ${hitRateText}.`;
  }

  if (trendScore <= -15) {
    return `${team} are trending down in ${metric}, averaging ${last5Text} over the last 5 games compared to ${seasonText} on the season (${trendText}), with a 1+ hit rate of ${hitRateText}.`;
  }

  return `${team} are holding steady in ${metric}, averaging ${last5Text} over the last 5 games compared to ${seasonText} on the season, with a 1+ hit rate of ${hitRateText}.`;
}

