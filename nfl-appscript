function runNFLDailyAnalyticsPipeline() {

  const lock =
    LockService.getScriptLock();

  if (!lock.tryLock(5000)) {

    Logger.log(
      "NFL mother pipeline is already running. Exiting duplicate execution."
    );

    return;

  }

  try {

    const state =
      getNFLDailyAnalyticsState_();

    if (state.completed) {

      Logger.log(
        "NFL daily analytics mother pipeline is already complete."
      );

      clearNFLDailyAnalyticsContinuationTriggers_();

      return;

    }

    Logger.log(
      `NFL mother pipeline starting/resuming. Stage: ${state.stage}`
    );

    // ------------------------------------------------------------------------
    // PLAYER GAME LOGS
    // ------------------------------------------------------------------------

    if (state.stage === "PLAYER_GAME_LOGS") {

      if (
        state.playerMonthIndex <
        NFL_DAILY_ANALYTICS_PLAYER_MONTHS.length
      ) {

        const month =
          NFL_DAILY_ANALYTICS_PLAYER_MONTHS[
            state.playerMonthIndex
          ];

        const success =
          executeNFLDailyAnalyticsFunction_(
            month.fn,
            `Player Game Logs ${month.label}`,
            state
          );

        if (success) {

          state.playerMonthIndex += 1;

          if (
            state.playerMonthIndex >=
            NFL_DAILY_ANALYTICS_PLAYER_MONTHS.length
          ) {

            state.stage =
              "TEAM_GAME_LOGS";

          }

          saveNFLDailyAnalyticsState_(state);

        }

        scheduleNFLDailyAnalyticsContinuation_();

        return;

      }

      state.stage =
        "TEAM_GAME_LOGS";

      saveNFLDailyAnalyticsState_(state);

    }

    // ------------------------------------------------------------------------
    // TEAM GAME LOGS
    // ------------------------------------------------------------------------

    if (state.stage === "TEAM_GAME_LOGS") {

      if (
        state.teamMonthIndex <
        NFL_DAILY_ANALYTICS_TEAM_MONTHS.length
      ) {

        const month =
          NFL_DAILY_ANALYTICS_TEAM_MONTHS[
            state.teamMonthIndex
          ];

        const success =
          executeNFLDailyAnalyticsFunction_(
            month.fn,
            `Team Game Logs ${month.label}`,
            state
          );

        if (success) {

          state.teamMonthIndex += 1;

          if (
            state.teamMonthIndex >=
            NFL_DAILY_ANALYTICS_TEAM_MONTHS.length
          ) {

            state.stage =
              "PLAYER_SEASON_STATS";

          }

          saveNFLDailyAnalyticsState_(state);

        }

        scheduleNFLDailyAnalyticsContinuation_();

        return;

      }

      state.stage =
        "PLAYER_SEASON_STATS";

      saveNFLDailyAnalyticsState_(state);

    }

    // ------------------------------------------------------------------------
    // PLAYER SEASON STATS
    // ------------------------------------------------------------------------

    if (state.stage === "PLAYER_SEASON_STATS") {

      const success =
        executeNFLDailyAnalyticsFunction_(
          "refreshNFLPlayerSeasonStatsSheet",
          "Player Season Stats",
          state
        );

      if (!success) {

        scheduleNFLDailyAnalyticsContinuation_();

        return;

      }

      state.stage =
        "TEAM_SEASON_STATS";

      saveNFLDailyAnalyticsState_(state);

    }

    // ------------------------------------------------------------------------
    // TEAM SEASON STATS
    // ------------------------------------------------------------------------

    if (state.stage === "TEAM_SEASON_STATS") {

      const success =
        executeNFLDailyAnalyticsFunction_(
          "refreshNFLTeamSeasonStatsSheet",
          "Team Season Stats",
          state
        );

      if (!success) {

        scheduleNFLDailyAnalyticsContinuation_();

        return;

      }

      state.stage =
        "PLAYER_TRENDS";

      saveNFLDailyAnalyticsState_(state);

    }

    // ------------------------------------------------------------------------
    // PLAYER TRENDS
    // ------------------------------------------------------------------------

    if (state.stage === "PLAYER_TRENDS") {

      const success =
        executeNFLDailyAnalyticsFunction_(
          "refreshNFLPlayerTrendsSheet",
          "Player Trends",
          state
        );

      if (!success) {

        scheduleNFLDailyAnalyticsContinuation_();

        return;

      }

      state.stage =
        "TEAM_TRENDS";

      saveNFLDailyAnalyticsState_(state);

    }

    // ------------------------------------------------------------------------
    // TEAM TRENDS
    // ------------------------------------------------------------------------

    if (state.stage === "TEAM_TRENDS") {

      const success =
        executeNFLDailyAnalyticsFunction_(
          "refreshNFLTeamTrendsOutputSheet",
          "Team Trends",
          state
        );

      if (!success) {

        scheduleNFLDailyAnalyticsContinuation_();

        return;

      }

      state.stage =
        "TOP_PLAYER_TRENDS";

      saveNFLDailyAnalyticsState_(state);

    }

    // ------------------------------------------------------------------------
    // TOP PLAYER TRENDS
    // ------------------------------------------------------------------------

    if (state.stage === "TOP_PLAYER_TRENDS") {

      const success =
        executeNFLDailyAnalyticsFunction_(
          "refreshNFLTopPlayerTrendsSheet",
          "Top Player Trends",
          state
        );

      if (!success) {

        scheduleNFLDailyAnalyticsContinuation_();

        return;

      }

      state.stage =
        "TOP_TEAM_TRENDS";

      saveNFLDailyAnalyticsState_(state);

    }

    // ------------------------------------------------------------------------
    // TOP TEAM TRENDS
    // ------------------------------------------------------------------------

    if (state.stage === "TOP_TEAM_TRENDS") {

      const success =
        executeNFLDailyAnalyticsFunction_(
          "refreshNFLTopTeamTrendsSheet",
          "Top Team Trends",
          state
        );

      if (!success) {

        scheduleNFLDailyAnalyticsContinuation_();

        return;

      }

      state.stage =
        "COMPLETE";

      state.completed =
        true;

      saveNFLDailyAnalyticsState_(state);

      clearNFLDailyAnalyticsContinuationTriggers_();

      Logger.log(
        "NFL DAILY ANALYTICS MOTHER PIPELINE COMPLETE."
      );

    }

  } finally {

    lock.releaseLock();

  }

}

