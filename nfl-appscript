    "Rushing Attempts",
    "Rushing TDs",
    "Receptions",
    "Receiving Yards",
    "Receiving TDs",
    "Season",
    "Last Updated"
  ];

  function fetchSeasonStats_(season) {
    const allRows = [];
    let cursor = null;

    do {
      const params = {
        season: season,
        season_type: 2,
        per_page: 100
      };

      if (cursor) {
        params.cursor = cursor;
      }

      const response = fetchApi_("/nfl/v1/season_stats", params);

      const data = Array.isArray(response.data)
        ? response.data
        : [];

      allRows.push(...data);

      cursor =
        response.meta && response.meta.next_cursor
          ? response.meta.next_cursor
          : null;

    } while (cursor);

    return allRows;
  }

  // Primary prior = 2025.
  // Fallback prior = 2024 only when the player has no valid 2025 sample.
  const rows2025 = fetchSeasonStats_(2025);
  const rows2024 = fetchSeasonStats_(2024);

  const valid2025PlayerIds = new Set();

  rows2025.forEach(row => {
    const player = row.player || {};

    const playerId =
      row.player_id ||
      player.id ||
      "";

    const gamesPlayed = getNFLStatNumber_(row, [
      "games",
      "games_played"
    ]);

    if (playerId && gamesPlayed > 0) {
      valid2025PlayerIds.add(String(playerId));
    }
  });

  const selectedRows = [];

  // Always prefer a valid 2025 sample.
  rows2025.forEach(row => {
    const gamesPlayed = getNFLStatNumber_(row, [
      "games",
      "games_played"
    ]);

    if (gamesPlayed > 0) {
      selectedRows.push({
        row: row,
        season: 2025
      });
    }
  });

  // Add 2024 only for players without a valid 2025 sample.
  rows2024.forEach(row => {
