  );
}

function formatNFLGameOddsSheet_(sheet) {
  sheet.setFrozenRows(1);

  sheet.getRange("1:1").setFontWeight("bold");
  sheet.getRange("A1:AE1").setHorizontalAlignment("center");

  sheet.getRange("Y:AB").setNumberFormat("0.000000");
  sheet.getRange("AC:AE").setNumberFormat("0.00%");

