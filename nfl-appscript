function refreshNFLGameOddsSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Game Odds");
  const scheduleSheet = ss.getSheetByName("Schedule");

  if (!sheet) throw new Error('Sheet "Game Odds" not found.');
  if (!scheduleSheet) throw new Error('Sheet "Schedule" not found.');

  ensureNFLGameOddsHeadersAndFormulas_(sheet);

  const games = getNFLGamesFromScheduleSheet_(scheduleSheet);

  if (!games.length) {
    clearNFLGameOddsSheet_(sheet);
    Logger.log("No NFL Schedule rows found. Game Odds cleared.");
    return;
  }

  const gameIds = games.map(game => game.id).filter(Boolean);
  const odds = fetchAllNFLOddsForGameIds_(gameIds);

  const seen = new Set();
  const rows = [];

  odds.forEach(item => {
    const oddsId = String(item.id || "");
    if (oddsId && seen.has(oddsId)) return;
    if (oddsId) seen.add(oddsId);

    rows.push([
      item.id || "",
      item.game_id || "",
      item.vendor || "",
      item.spread_away_value || "",
      item.spread_away_odds || "",
      item.spread_home_value || "",
