function ensureNFLPlayerPropsHeadersAndFormulas_(sheet) {
  const rawHeaders = [
    "Game Id", "Game Date", "Away Team", "Home Team", "Id", "Player Id",
    "Vendor", "Prop Type", "Line Value", "Type", "Odds", "Updated At",
    "Over Odds", "Under Odds"
  ];

  const formulaHeaders = [
    "EV Over", "EV Under", "Implied Prob Over", "Implied Prob Under",
    "Best Price Edge", "Risk Tier", "Model Confidence", "Player Name", "Team"
  ];

  sheet.getRange(1, 1, 1, rawHeaders.length).setValues([rawHeaders]);
  sheet.getRange(1, 15, 1, formulaHeaders.length).setValues([formulaHeaders]);

  sheet.getRange("O2").setFormula(`=IF(M2>0,1+M2/100,IF(M2<0,1+100/ABS(M2),""))`);
  sheet.getRange("P2").setFormula(`=IF(N2>0,1+N2/100,IF(N2<0,1+100/ABS(N2),""))`);
  sheet.getRange("Q2").setFormula(`=IF(M2<0,ABS(M2)/(ABS(M2)+100),IF(M2>0,100/(M2+100),""))`);
  sheet.getRange("R2").setFormula(`=IF(N2<0,ABS(N2)/(ABS(N2)+100),IF(N2>0,100/(N2+100),""))`);
  sheet.getRange("S2").setFormula(`=IFERROR(MAX(O2,P2)-1,"")`);
  sheet.getRange("T2").setFormula(`=IF(S2>=0.25,"Low",IF(S2>=0.1,"Medium","High"))`);
  sheet.getRange("U2").setFormula(`=IFERROR(S2*100,"")`);
  sheet.getRange("V2").setFormula(`=IFERROR(INDEX(Rosters!D:D,MATCH(F2,Rosters!A:A,0)),"")`);
  sheet.getRange("W2").setFormula(`=IFERROR(INDEX(Rosters!F:F,MATCH(F2,Rosters!A:A,0)),"")`);

  sheet.setFrozenRows(1);
  sheet.getRange("1:1").setFontWeight("bold");
  sheet.getRange("A1:W1").setHorizontalAlignment("center");

  if (!sheet.getFilter()) {
    sheet.getRange("A1:W1").createFilter();
  }

  sheet.autoResizeColumns(1, 23);
}

function clearNFLPlayerPropsSheet_(sheet) {
