/**
 * Converts American odds to raw implied probability.
 */
function americanOddsToImpliedProbabilityNFL_(
  americanOdds
) {
  if (
    americanOdds === "" ||
    americanOdds === null ||
    americanOdds === undefined
  ) {
    return null;
  }


  const odds =
    Number(
      americanOdds
    );


  if (
    !Number.isFinite(odds) ||
    odds === 0
  ) {
    return null;
  }


  if (odds > 0) {
    return (
      100 /
      (
        odds + 100
      )
    );
  }


  return (
    Math.abs(odds) /
    (
      Math.abs(odds) + 100
    )
  );
}


/**
 * Preserves the existing NFL Player Props S-column behavior:
 *
 *   impliedOver  -> raw sportsbook implied probability
 *   impliedUnder -> raw sportsbook implied probability
 *
 *   vigFreeOver  = impliedOver / totalImplied
 *   vigFreeUnder = impliedUnder / totalImplied
 *
 *   overEdge  = modelProbOver  - vigFreeOver
 *   underEdge = modelProbUnder - vigFreeUnder
 *
 * Best Price Edge follows the SELECTED Best Side.
 */
function getNFLVigFreePriceEdges_({
  modelProbOver,
  modelProbUnder,
  overOdds,
  underOdds
}) {
  if (
    modelProbOver === null ||
    modelProbOver === undefined ||
    modelProbUnder === null ||
    modelProbUnder === undefined
  ) {
    return {
      overEdge: null,
      underEdge: null,
      vigFreeOver: null,
      vigFreeUnder: null
    };
  }


  const overProbability =
    Number(
      modelProbOver
    );


  const underProbability =
    Number(
      modelProbUnder
    );


  if (
    !Number.isFinite(
      overProbability
    ) ||
    !Number.isFinite(
      underProbability
    )
  ) {
    return {
      overEdge: null,
      underEdge: null,
      vigFreeOver: null,
      vigFreeUnder: null
    };
  }


  const impliedOver =
    americanOddsToImpliedProbabilityNFL_(
      overOdds
    );


  const impliedUnder =
    americanOddsToImpliedProbabilityNFL_(
      underOdds
    );


  if (
    impliedOver === null ||
    impliedUnder === null
  ) {
    return {
      overEdge: null,
      underEdge: null,
      vigFreeOver: null,
      vigFreeUnder: null
    };
  }


  const totalImplied =
    impliedOver +
    impliedUnder;


  if (
    !Number.isFinite(
      totalImplied
    ) ||
    totalImplied <= 0
  ) {
    return {
      overEdge: null,
      underEdge: null,
      vigFreeOver: null,
      vigFreeUnder: null
    };
  }


  const vigFreeOver =
    impliedOver /
    totalImplied;


  const vigFreeUnder =
    impliedUnder /
    totalImplied;


  return {
    overEdge:
      overProbability -
      vigFreeOver,

    underEdge:
      underProbability -
      vigFreeUnder,

    vigFreeOver,

    vigFreeUnder
  };
}


function buildNFLUniversalDecisionTrendFields_({
  playerId,
  propType,
  modelProbOver,
  modelProbUnder,
  evOver,
  evUnder,
  overOdds,
  underOdds,
  trendIndex
}) {

  // --------------------------------------------------------------------------
  // TREND
  // --------------------------------------------------------------------------

  const trendRow =
    getNFLTrendRowForProp_(
      playerId,
      propType,
      trendIndex
    );


  const trendScore =
    getNullableNFLNumericField_(
      trendRow,
      "Trend Score"
    );


  const trendStrength =
    getNullableNFLTextField_(
      trendRow,
      "Trend Strength"
    );


  // --------------------------------------------------------------------------
  // BEST SIDE / EV / MODEL PROBABILITY
  //
  // This remains the mathematical CANDIDATE side at this stage.
  // P15 later converts it to actionable Over / Under / No Play.
  // --------------------------------------------------------------------------

  const overAvailable =
    evOver !== null &&
    evOver !== undefined &&
    Number.isFinite(
      Number(evOver)
    ) &&
    modelProbOver !== null &&
    modelProbOver !== undefined &&
    Number.isFinite(
      Number(modelProbOver)
    );


  const underAvailable =
    evUnder !== null &&
    evUnder !== undefined &&
    Number.isFinite(
      Number(evUnder)
    ) &&
    modelProbUnder !== null &&
    modelProbUnder !== undefined &&
    Number.isFinite(
      Number(modelProbUnder)
    );


  let bestSide =
    "No Play";


  let bestEV =
    null;


  let bestModelProbability =
    null;


  if (
    overAvailable &&
    underAvailable
  ) {

    if (
      Number(evOver) >=
      Number(evUnder)
    ) {

      bestSide =
        "Over";

      bestEV =
        Number(evOver);

      bestModelProbability =
        Number(modelProbOver);

    } else {

      bestSide =
        "Under";

      bestEV =
        Number(evUnder);

      bestModelProbability =
        Number(modelProbUnder);
    }

  } else if (
    overAvailable
  ) {

    bestSide =
      "Over";

    bestEV =
      Number(evOver);

    bestModelProbability =
      Number(modelProbOver);

  } else if (
    underAvailable
  ) {

    bestSide =
      "Under";

    bestEV =
      Number(evUnder);

    bestModelProbability =
      Number(modelProbUnder);
  }


  // --------------------------------------------------------------------------
  // BEST PRICE EDGE — PRESERVE VALIDATED NFL VIG-FREE CONTRACT
  // --------------------------------------------------------------------------

  const priceEdges =
    getNFLVigFreePriceEdges_({
      modelProbOver,
      modelProbUnder,
      overOdds,
      underOdds
    });


  let bestPriceEdge =
    null;


  if (
    bestSide === "Over"
  ) {

    bestPriceEdge =
      priceEdges.overEdge;

  } else if (
    bestSide === "Under"
  ) {

    bestPriceEdge =
      priceEdges.underEdge;
  }


  // --------------------------------------------------------------------------
  // MODEL CONFIDENCE — PRESERVE LEGACY NFL PLAYER PROPS CONTRACT
  //
  // Old production formula:
  //
  // MIN(
  //   100,
  //   MAX(Model Prob Over, Model Prob Under) * 100
  //   + Best Price Edge * 25
  // )
  // --------------------------------------------------------------------------

  let modelConfidence =
    null;


  const overProbability =
    getUniversalNullableNumber_(
      modelProbOver
    );


  const underProbability =
    getUniversalNullableNumber_(
      modelProbUnder
    );


  const selectedPriceEdge =
    getUniversalNullableNumber_(
      bestPriceEdge
    );


  if (
    overProbability !== null &&
    underProbability !== null &&
    selectedPriceEdge !== null
  ) {

    modelConfidence =
      Math.min(
        100,
        (
          Math.max(
            overProbability,
            underProbability
          ) *
          100
        ) +
        (
          selectedPriceEdge *
          25
        )
      );
  }


  // AE / AF now belong to P15 universal scoring.
  // They are intentionally not generated here.
  const riskScore =
    null;


  const riskTier =
    null;


  return {
    bestSide,
    bestEV,
    bestModelProbability,
    bestPriceEdge,
    trendScore,
    trendStrength,
    riskScore,
    riskTier,
    modelConfidence
  };
}

