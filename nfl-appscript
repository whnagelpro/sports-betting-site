function getNFLObjectsFromSheet_(sheet) {
  if (!sheet) return [];

  const values = sheet.getDataRange().getValues();
  if (values.length < 2) return [];

  const headers = values[0].map(h => String(h || "").trim());

  return values.slice(1).map(row => {
    const obj = {};
    headers.forEach((header, index) => {
      obj[header] = row[index];
    });
    return obj;
  });
}

function avgNFL_(values) {
  const nums = values.map(Number).filter(v => !isNaN(v));
  if (!nums.length) return 0;
  return nums.reduce((sum, v) => sum + v, 0) / nums.length;
}

function consistencyScoreNFL_(values) {
  const nums = values.map(Number).filter(v => !isNaN(v));
  if (nums.length < 2) return 0;

  const avg = avgNFL_(nums);
  if (avg === 0) return 0;

  const variance =
    nums.reduce((sum, v) => sum + Math.pow(v - avg, 2), 0) / nums.length;

  const stdDev = Math.sqrt(variance);
  return Math.max(0, 100 - (stdDev / avg) * 100);
}

function trendScoreNFL_(last5, seasonAvg) {
  if (!seasonAvg) return 0;
  return ((last5 - seasonAvg) / seasonAvg) * 100;
}

function trendDirectionNFL_(score) {
  if (score >= 15) return "Heating Up";
  if (score >= 5) return "Slightly Up";
  if (score <= -15) return "Cooling Off";
  if (score <= -5) return "Slightly Down";
  return "Stable";
}

function riskTierNFL_(consistency, absScore) {
  if (consistency >= 70 && absScore >= 15) return "Low";
  if (consistency >= 45 && absScore >= 7) return "Medium";
  return "High";
}

function hitRateNFL_(values, threshold) {
  const nums = values.map(Number).filter(v => !isNaN(v));
  if (!nums.length) return 0;
  return nums.filter(v => v >= threshold).length / nums.length;
}

function aboveSeasonPctNFL_(last5, seasonAvg) {
  if (!seasonAvg) return 0;
  return ((last5 - seasonAvg) / seasonAvg) * 100;
}

function trendStrengthNFL_(hitRateLast5, aboveSeasonPct, score) {
  if (hitRateLast5 >= 0.8 && aboveSeasonPct >= 20 && score >= 15) return "Elite";
  if (hitRateLast5 >= 0.6 && aboveSeasonPct >= 10 && score >= 7) return "Strong";
  if (hitRateLast5 >= 0.5 && score >= 0) return "Moderate";
  if (score < -10) return "Cold";
  return "Weak";
}

function buildNFLTrendNote_(name, statType, seasonAvg, last5, hitRateLast5, score) {
  const hitRateText = `${Math.round(hitRateLast5 * 100)}%`;
  const direction = trendDirectionNFL_(score).toLowerCase();

  return `${name} is ${direction} in ${statType}, averaging ${last5.toFixed(1)} over the last 5 games compared to a season average of ${seasonAvg.toFixed(1)} with a ${hitRateText} 1+ hit rate.`;
}

function buildNFLTeamTrendNote_(team, metric, seasonAvg, last5, hitRateLast5, score) {
  const hitRateText = `${Math.round(hitRateLast5 * 100)}%`;
  const direction = trendDirectionNFL_(score).toLowerCase();

  return `The ${team} are ${direction} in ${metric}, averaging ${last5.toFixed(1)} over the last 5 games compared to a season average of ${seasonAvg.toFixed(1)} with a ${hitRateText} 1+ hit rate.`;
}

