 * NFL-specific preservation:
 * - Best Price Edge preserves existing VIG-FREE sportsbook comparison.
 * - Existing NFL Trend Score / Trend Strength / Risk Tier are reused.
 * - Existing calculateTrendConfidence_() is reused for Model Confidence.
 * - NFL does NOT currently have a validated numeric Risk Score.
 *   Therefore AE remains null until P15.
 * - No P15 actionable EV threshold is introduced here.
 * ============================================================================
 */


function buildNFLPlayerTrendIndex_() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();


  const sheet =
    ss.getSheetByName(
      "NFL Player Trends"
    );


  if (!sheet) {
    throw new Error(
      'Sheet "NFL Player Trends" not found.'
    );
  }


  const rows =
    getNFLObjectsFromSheet_(
      sheet
    );


  const index = {};


  rows.forEach(row => {

    const playerId =
      String(
        row["Player ID"] ?? ""
      ).trim();


    const statType =
      String(
        row["Stat Type"] ?? ""
      ).trim();


    if (
      !playerId ||
      !statType
    ) {
      return;
    }


    index[
      `${playerId}::${statType}`
    ] = row;
  });


  return index;
}


function getNFLTrendStatNameForProp_(
