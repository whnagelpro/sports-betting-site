/**
 * Get NBA games
 * @param {string} date Filter by date (YYYY-MM-DD)
 * @param {number} season Filter by season year
 * @param {number} teamId Filter by team ID
 * @param {number} perPage Results per page (max 100)
 * @returns {Array} NBA games data
 * @customfunction
 */
function BDL_NBA_GAMES(date, season, teamId, perPage) {
  const params = { per_page: perPage || 25 };
