function populateNFLTeamRatings_(rows) {

  if (!rows || !rows.length) return;

  const teamMetricMap = {};

  // -----------------------------------------------------
  // BUILD TEAM -> METRIC -> SEASON AVG MAP
  // -----------------------------------------------------

  rows.forEach(row => {

    const team =
      String(row[0] || "").trim();

    const metric =
      String(row[1] || "").trim();

    const seasonAvg =
      Number(row[2]);

    if (
      !team ||
      !metric ||
      Number.isNaN(seasonAvg)
    ) {
      return;
    }

    if (!teamMetricMap[team]) {
      teamMetricMap[team] = {};
    }

    teamMetricMap[team][metric] =
      seasonAvg;

  });

  const teams =
    Object.keys(teamMetricMap);

  if (!teams.length) return;


  // -----------------------------------------------------
  // CALCULATE METRIC RANK SCORES
  // -----------------------------------------------------

  function getMetricRankScores_(
    metric,
    lowerIsBetter = false
  ) {

    const values = teams
      .map(team => ({
        team,
        value:
          Number(
            teamMetricMap[team][metric]
          )
      }))
      .filter(
        item =>
          !Number.isNaN(item.value)
      );

    values.sort((a, b) => {

      if (lowerIsBetter) {
        return a.value - b.value;
      }

      return b.value - a.value;

    });

    const scores = {};

    values.forEach((item, index) => {

      const rank =
        index + 1;

      let rankScore = 100;

      if (values.length > 1) {

        rankScore =
          100 *
          (
            1 -
            (rank - 1) /
            (values.length - 1)
          );

      }

      scores[item.team] = {
        rank,
        rankScore
      };

    });

    return scores;

  }


  // -----------------------------------------------------
  // NFL METRIC RANKINGS
  // -----------------------------------------------------

  const pointsFor =
    getMetricRankScores_(
      "Points For"
    );

  const pointsAllowed =
    getMetricRankScores_(
      "Points Allowed",
      true
    );

  const passingYards =
    getMetricRankScores_(
      "Passing Yards"
    );

  const rushingYards =
    getMetricRankScores_(
      "Rushing Yards"
    );

  const turnovers =
    getMetricRankScores_(
      "Turnovers",
      true
    );

  const sacks =
    getMetricRankScores_(
      "Sacks"
    );


  // -----------------------------------------------------
  // HELPER: AVERAGE AVAILABLE SCORES
  // -----------------------------------------------------

  function averageScores_(scores) {

    const valid =
      scores.filter(
        value =>
          value !== null &&
          value !== undefined &&
          !Number.isNaN(value)
      );

    if (!valid.length) return 0;

    return (
      valid.reduce(
        (sum, value) => sum + value,
        0
      ) / valid.length
    );

  }


  // -----------------------------------------------------
  // BUILD TEAM RATINGS
  // -----------------------------------------------------

  const teamRatings = {};

  teams.forEach(team => {

    const offensiveRating =
      averageScores_([
        pointsFor[team]?.rankScore,
        passingYards[team]?.rankScore,
        rushingYards[team]?.rankScore,
        turnovers[team]?.rankScore
      ]);

    const defensiveRating =
      averageScores_([
        pointsAllowed[team]?.rankScore,
        sacks[team]?.rankScore
      ]);

    const overallRating =
      (
        offensiveRating * 0.60
      ) +
      (
        defensiveRating * 0.40
      );

    teamRatings[team] = {
      offensiveRating,
      defensiveRating,
      overallRating
    };

  });


  // -----------------------------------------------------
  // OVERALL NFL RANKINGS
  // -----------------------------------------------------

  const overallRankings =
    Object.entries(teamRatings)
      .map(
        ([team, ratings]) => ({
          team,
          overallRating:
            ratings.overallRating
        })
      )
      .sort(
        (a, b) =>
          b.overallRating -
          a.overallRating
      );

  overallRankings.forEach(
    (item, index) => {

      const rank =
        index + 1;

      let rankScore = 100;

      if (overallRankings.length > 1) {

        rankScore =
          100 *
          (
            1 -
            (rank - 1) /
            (overallRankings.length - 1)
          );

      }

      teamRatings[item.team].leagueRank =
        rank;

      teamRatings[item.team].rankScore =
        rankScore;

    }
  );


  // -----------------------------------------------------
  // ADD RATINGS TO EACH TREND ROW
  // -----------------------------------------------------

  rows.forEach(row => {

    const team =
      String(row[0] || "").trim();

    const ratings =
      teamRatings[team];

    if (!ratings) {

      row.push(
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      );

      return;

    }

    const offense =
      ratings.offensiveRating;

    const defense =
      ratings.defensiveRating;

    const overall =
      ratings.overallRating;


    // ---------------------------------------------------
    // RATING TIER
    // ---------------------------------------------------

    let ratingTier = "Weak";

    if (overall >= 90) {
      ratingTier = "Elite";
    } else if (overall >= 75) {
      ratingTier = "Strong";
    } else if (overall >= 55) {
      ratingTier = "Average";
    } else if (overall >= 40) {
      ratingTier = "Below Average";
    }


    // ---------------------------------------------------
    // RATING NOTES
    // ---------------------------------------------------

    let ratingNotes =
      "Balanced team profile.";

    if (offense > defense + 20) {

      ratingNotes =
        "Offense carrying the team.";

    } else if (
      defense > offense + 20
    ) {

      ratingNotes =
        "Defense carrying the team.";

    }


    row.push(
      ratings.leagueRank,
      Number(
        ratings.rankScore.toFixed(1)
      ),
      Number(
        offense.toFixed(1)
      ),
      Number(
        defense.toFixed(1)
      ),
      Number(
        overall.toFixed(1)
      ),
      ratingTier,
      ratingNotes
    );

  });

}

