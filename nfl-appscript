    "============================================================"
  );


  const expectedHeaders =
    NFL_UNIVERSAL_PLAYER_PROPS_HEADERS;


  const columnCount =
    expectedHeaders.length;


  const results =
    [];


  function addResult_(
    name,
    pass,
    details
  ) {

    const result = {
      name:
        name,

      pass:
        Boolean(pass),

      details:
        details === undefined
          ? null
          : details
    };


    results.push(
      result
    );


    Logger.log(
      JSON.stringify(
        result
      )
    );


    return result.pass;
  }


  function hasValue_(
    value
  ) {

    return (
      value !== "" &&
      value !== null &&
      value !== undefined
    );
  }


  function finiteIfPopulated_(
    value
  ) {

    if (
      !hasValue_(value)
    ) {
      return true;
    }


    return Number.isFinite(
      Number(value)
    );
  }


  function nearlyEqual_(
    a,
    b,
    tolerance
  ) {

    if (
      !Number.isFinite(
        Number(a)
      ) ||
      !Number.isFinite(
        Number(b)
      )
    ) {
      return false;
    }


    return (
      Math.abs(
        Number(a) -
        Number(b)
      ) <=
      (
        tolerance === undefined
          ? 1e-8
          : tolerance
      )
    );
  }


