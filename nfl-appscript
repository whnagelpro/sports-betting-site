function ensureNFLGameOddsHeadersAndFormulas_(sheet) {
  const rawHeaders = [
    "Odds Id",               // A
    "Game Id",               // B
    "Vendor",                // C
    "Spread Away Value",     // D
    "Spread Away Odds",      // E
    "Spread Home Value",     // F
    "Spread Home Odds",      // G
    "Moneyline Away Odds",   // H
    "Moneyline Home Odds",   // I
    "Total Value",           // J
    "Total Over Odds",       // K
    "Total Under Odds",      // L
    "Updated At"             // M
  ];

  const formulaHeaders = [
    "EV Total Over ($1 bet)",    // N
    "EV Total Under ($1 bet)",   // O
    "Poisson Prob Total Over",   // P
    "Poisson Prob Total Under",  // Q
    "EV Away ML ($1 bet)",       // R
    "EV Home ML ($1 bet)",       // S
    "EV Away Spread ($1 bet)",   // T
    "EV Home Spread ($1 bet)",   // U
    "Game Date",                 // V
    "Away Team",                 // W
    "Home Team",                 // X
    "Implied Prob Away ML",      // Y
    "Implied Prob Home ML",      // Z
    "Vig-Free Prob Away ML",     // AA
    "Vig-Free Prob Home ML",     // AB
    "Moneyline Edge Away",       // AC
    "Moneyline Edge Home",       // AD
    "Best ML Edge"               // AE
  ];

  sheet.getRange(1, 1, 1, rawHeaders.length).setValues([rawHeaders]);
  sheet.getRange(1, 14, 1, formulaHeaders.length).setValues([formulaHeaders]);

  // Row 2 formula templates
  sheet.getRange("N2").setFormula(`=IF(K2>0,1+K2/100,1+100/ABS(K2))`);
  sheet.getRange("O2").setFormula(`=IF(L2>0,1+L2/100,1+100/ABS(L2))`);
  sheet.getRange("P2").setFormula(`=IF(K2<0,ABS(K2)/(ABS(K2)+100),100/(K2+100))`);
  sheet.getRange("Q2").setFormula(`=IF(L2<0,ABS(L2)/(ABS(L2)+100),100/(L2+100))`);
  sheet.getRange("R2").setFormula(`=IF(H2>0,1+H2/100,1+100/ABS(H2))`);
  sheet.getRange("S2").setFormula(`=IF(I2>0,1+I2/100,1+100/ABS(I2))`);
  sheet.getRange("T2").setFormula(`=IF(E2>0,1+E2/100,1+100/ABS(E2))`);
  sheet.getRange("U2").setFormula(`=IF(G2>0,1+G2/100,1+100/ABS(G2))`);
  sheet.getRange("V2").setFormula(`=IFERROR(INDEX(Schedule!J:J,MATCH(B2,Schedule!A:A,0)),"")`);
  sheet.getRange("W2").setFormula(`=IFERROR(INDEX(Schedule!C:C,MATCH(B2,Schedule!A:A,0)),"")`);
  sheet.getRange("X2").setFormula(`=IFERROR(INDEX(Schedule!D:D,MATCH(B2,Schedule!A:A,0)),"")`);
  sheet.getRange("Y2").setFormula(`=IF(H2<0,ABS(H2)/(ABS(H2)+100),100/(H2+100))`);
  sheet.getRange("Z2").setFormula(`=IF(I2<0,ABS(I2)/(ABS(I2)+100),100/(I2+100))`);
  sheet.getRange("AA2").setFormula(`=IFERROR(Y2/(Y2+Z2),"")`);
  sheet.getRange("AB2").setFormula(`=IFERROR(Z2/(Y2+Z2),"")`);
  sheet.getRange("AC2").setFormula(`=IFERROR(AA2-Y2,"")`);
  sheet.getRange("AD2").setFormula(`=IFERROR(AB2-Z2,"")`);
  sheet.getRange("AE2").setFormula(`=MAX(AC2,AD2)`);
}

function clearNFLGameOddsSheet_(sheet) {
  const maxRows = sheet.getMaxRows();

  if (maxRows > 2) {
    sheet.getRange(3, 1, maxRows - 2, 13).clearContent();   // A:M
