  );
  Logger.log(
    `Triggers before cleanup: ${triggers.length}`
  );
  Logger.log(
    "=================================================="
  );

  let deletedCount = 0;
  let keptCount = 0;

  triggers.forEach(trigger => {

    const handler =
      trigger.getHandlerFunction();

    if (KEEP_HANDLERS.has(handler)) {

      keptCount++;

      Logger.log(
        `KEEPING: ${handler}`
      );

      return;
    }

    const isLegacyAnalyticsTrigger =
      handler.startsWith("refreshNFLPlayerGameLogs") ||
      handler.startsWith("refreshNFLTeamGameLogs") ||
      handler === "refreshNFLPlayerTrendPipeline" ||
      handler === "refreshNFLTeamTrendPipeline" ||
      handler === "refreshNFLTopPlayerTrendPipeline" ||
      handler === "refreshNFLTopTeamTrendPipeline" ||
      handler === "runNFLDailyAnalyticsPipeline";

    if (isLegacyAnalyticsTrigger) {

      Logger.log(
        `DELETING LEGACY ANALYTICS TRIGGER: ${handler}`
      );

      ScriptApp.deleteTrigger(trigger);

      deletedCount++;
    } else {

      Logger.log(
        `NOT TOUCHED: ${handler}`
      );
    }

  });

  const remaining =
    ScriptApp.getProjectTriggers();

  Logger.log(
    "=================================================="
  );

  Logger.log(
    `Deleted legacy analytics triggers: ${deletedCount}`
  );

  Logger.log(
    `Explicitly kept operational triggers: ${keptCount}`
  );

  Logger.log(
    `Triggers remaining: ${remaining.length}`
  );

  Logger.log(
    "Remaining handlers:"
  );

  remaining.forEach((trigger, index) => {

    Logger.log(
      `${index + 1}. ${trigger.getHandlerFunction()}`
    );

  });

  Logger.log(
    "=================================================="
  );

  Logger.log(
    "NFL LEGACY ANALYTICS TRIGGER CLEANUP COMPLETE"
  );
}

