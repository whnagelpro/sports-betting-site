function fetchAllNFLGamesForSeason_(season) {
  const allGames = [];
  let cursor = null;

  do {
    const params = {
      "seasons[]": season,

      // 2 = NFL regular season.
      // Fetch regular-season games directly instead of
      // mixing preseason / regular season / postseason
      // and trying to infer the season type afterward.
      season_type: 2,

      per_page: 100
    };

    if (cursor) {
      params.cursor = cursor;
    }

    const response =
      fetchApi_(
        "/nfl/v1/games",
        params
      );

    const games =
      Array.isArray(response.data)
        ? response.data
        : [];

    allGames.push(...games);

    cursor =
      response.meta &&
      response.meta.next_cursor
        ? response.meta.next_cursor
        : null;

  } while (cursor);

  Logger.log(
    `Fetched ${allGames.length} NFL regular-season games for season ${season}.`
  );

  return allGames;
}

