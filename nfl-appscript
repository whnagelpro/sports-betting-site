function getDefaultNFLDailyAnalyticsState_() {

  return {
    stage: "PLAYER_GAME_LOGS",
    playerMonthIndex: 0,
    teamMonthIndex: 0,
    completed: false,
    lastSuccessfulStep: null,
    lastError: null,
    updatedAt: new Date().toISOString()
  };

}

function getNFLDailyAnalyticsState_() {

  const properties =
    PropertiesService.getScriptProperties();

  const raw =
    properties.getProperty(
      NFL_DAILY_ANALYTICS_STATE_KEY
    );

  if (!raw) {
    return getDefaultNFLDailyAnalyticsState_();
  }

  try {

    const parsed = JSON.parse(raw);

    return {
      ...getDefaultNFLDailyAnalyticsState_(),
      ...parsed
    };

  } catch (error) {

    Logger.log(
      "NFL mother pipeline state could not be parsed. Resetting state."
    );

    return getDefaultNFLDailyAnalyticsState_();
  }

}

function saveNFLDailyAnalyticsState_(state) {

  state.updatedAt =
    new Date().toISOString();

  PropertiesService
    .getScriptProperties()
    .setProperty(
      NFL_DAILY_ANALYTICS_STATE_KEY,
      JSON.stringify(state)
    );

}

function clearNFLDailyAnalyticsContinuationTriggers_() {

  ScriptApp
    .getProjectTriggers()
    .forEach(trigger => {

      if (
        trigger.getHandlerFunction() ===
        NFL_DAILY_ANALYTICS_CONTINUATION_HANDLER
      ) {

        ScriptApp.deleteTrigger(trigger);

      }

    });

}

function scheduleNFLDailyAnalyticsContinuation_() {

  clearNFLDailyAnalyticsContinuationTriggers_();

  ScriptApp
    .newTrigger(
      NFL_DAILY_ANALYTICS_CONTINUATION_HANDLER
    )
    .timeBased()
    .after(60 * 1000)
    .create();

  Logger.log(
    "NFL mother pipeline continuation scheduled."
  );

}

function executeNFLDailyAnalyticsFunction_(
  functionName,
  stepLabel,
  state
) {

  try {

    const fn =
      globalThis[functionName];

    if (typeof fn !== "function") {

      throw new Error(
        `NFL mother pipeline function not found: ${functionName}`
      );

    }

    Logger.log(
      `NFL mother pipeline: refreshing ${stepLabel}`
    );

    fn();

    state.lastSuccessfulStep =
      stepLabel;

    state.lastError =
      null;

    saveNFLDailyAnalyticsState_(state);

    return true;

  } catch (error) {

    state.lastError =
      `${stepLabel}: ${error.message || error}`;

    saveNFLDailyAnalyticsState_(state);

    Logger.log(
      `NFL mother pipeline step failed: ${state.lastError}`
    );

    return false;

  }

}

