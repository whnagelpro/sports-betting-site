/**
 * ============================================================================
 * D10X — NFL PROBABILITY CALIBRATION PARITY REGRESSION
 * ============================================================================
 *
 * Protects the production probability-calibration contract:
 *
 * rawOver =
 *   1 - NormalCDF((line - projectedStat) / statStdDev)
 *
 * reliability =
 *   MIN(1, 0.60 + 0.05 * currentGames)
 *
 * calibratedOver =
 *   0.5 + (rawOver - 0.5) * reliability
 *
 * finalOver =
 *   clamp(calibratedOver, 0.025, 0.975)
 *
 * finalUnder =
 *   1 - finalOver
 *
 * This regression verifies that the universal NFL probability builder
 * continues to match the same mathematical contract used by the
 * production Player Props sheet formulas.
 * ============================================================================
 */
function testNFLPlayerPropProbabilityCalibrationParity_D10X() {

  const cases = [
    {
      name: "2-game receiving yards",
      propType: "receiving_yards",
      projectedStat: 80,
      statStdDev: 20,
      lineValue: 60,
      currentGames: 2
    },
    {
