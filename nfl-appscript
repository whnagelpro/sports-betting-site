function addDaysToDateString_(dateString, days) {

  const date = new Date(dateString + "T00:00:00");

  date.setDate(date.getDate() + days);

  return Utilities.formatDate(
    date,
    SPORTACULAR_TIMEZONE,
    "yyyy-MM-dd"
  );
}

function getNFLGameAZDate_(game) {
  const rawDate = getNFLGameRawDate_(game);
  if (!rawDate) return "";

  const rawString = String(rawDate);

  if (/^\d{4}-\d{2}-\d{2}$/.test(rawString)) {
    return rawString;
  }

  return Utilities.formatDate(
    new Date(rawDate),
    SPORTACULAR_TIMEZONE,
    "yyyy-MM-dd"
  );
}

function isNFLRegularSeasonGame_(game) {
  if (!game || typeof game !== "object") {
    return false;
  }

  // BALLDONTLIE NFL game objects identify playoff games
  // with the postseason boolean.
  //
  // postseason === false -> regular season
  // postseason === true  -> postseason/playoffs
  if (typeof game.postseason === "boolean") {
    return game.postseason === false;
  }

  // Fallback support in case another response supplies
  // an explicit season-type field.
  const seasonType = String(
    game.season_type ??
    game.seasonType ??
    game.season_type_id ??
    ""
  )
    .trim()
    .toLowerCase();

  if (
    seasonType === "regular" ||
    seasonType === "regular season" ||
    seasonType === "reg"
  ) {
    return true;
  }

  return false;
}

function isCompletedNFLGame_(game) {

  const statusState =
    String(
      game.status_state ||
      ""
    ).toLowerCase();

  const status =
    String(
      game.status ||
      game.game_state ||
      ""
    ).toLowerCase();

  return (
    statusState === "final" ||
    status.includes("final") ||
    status.includes("completed") ||
    status === "post" ||
    status === "ft"
  );
}

function getNFLCompletedGamesForDateRange_(
  startDate,
  endDate
) {

  const startYear =
    Number(
      String(startDate).slice(0, 4)
    );

  const endYear =
    Number(
      String(endDate).slice(0, 4)
    );

  const seasons = [];

  for (
    let season = startYear;
    season <= endYear;
    season++
  ) {
    seasons.push(season);
  }

  const allGames = [];

  seasons.forEach(season => {

    Logger.log(
      `Fetching NFL regular-season games for season ${season}`
    );

    const seasonGames =
      fetchAllNFLGamesForSeason_(
        season
      );

    Logger.log(
      `NFL regular-season games returned for ${season}: ${seasonGames.length}`
    );

    allGames.push(
      ...seasonGames
    );

  });

  const selectedGamesMap = {};

  allGames.forEach(game => {

    const gameDate =
      getNFLGameAZDate_(game);

    if (!gameDate) {
      return;
    }

    if (
      gameDate < startDate ||
      gameDate > endDate
    ) {
      return;
    }

    if (
      !isCompletedNFLGame_(game)
    ) {
      return;
    }

    const gameId =
      String(
        game.id || ""
      );

    if (!gameId) {
      return;
    }

    selectedGamesMap[
      gameId
    ] = game;

  });

  const selectedGames =
    Object.values(
      selectedGamesMap
    );

  selectedGames.sort(
    (a, b) =>
      getNFLGameAZDate_(a)
        .localeCompare(
          getNFLGameAZDate_(b)
        )
  );

  Logger.log(
    `Completed NFL regular-season games from ${startDate} to ${endDate}: ${selectedGames.length}`
  );

  if (selectedGames.length > 0) {

    Logger.log(
      "First selected NFL game: " +
      JSON.stringify(
        selectedGames[0]
      )
    );

  }

  return selectedGames;
}

