function fetchAllNFLTeamStatsForGameIds_(gameIds) {

  const allStats = [];

  gameIds.forEach((gameId, index) => {

    Logger.log(
      `Fetching NFL team stats for game ${index + 1}/${gameIds.length}: ${gameId}`
    );

    let cursor = null;

    do {

      const params = {
        "game_ids[]": gameId,
        per_page: 100
      };

      if (cursor) {
        params.cursor = cursor;
      }

      const response = fetchApi_("/nfl/v1/team_stats", params);

      const stats = Array.isArray(response.data)
        ? response.data
        : [];

      allStats.push(...stats);

      cursor =
        response.meta &&
        response.meta.next_cursor
          ? response.meta.next_cursor
          : null;

    } while (cursor);

    Utilities.sleep(150);

  });

  return allStats;

}

