function getNFLGamesFromScheduleSheet_(scheduleSheet) {

  const lastRow = scheduleSheet.getLastRow();
  if (lastRow < 2) return [];

  const values = scheduleSheet
    .getRange(2, 1, lastRow - 1, 12)
    .getValues();

  return values
    .filter(row => row[0])
    .map(row => ({

      id: row[0],

      week: row[1],

      away_team: row[2],

      home_team: row[3],

      status: row[4],

      home_team_score: row[5],

      visitor_team_score: row[6],

      season: row[7],

      postseason: row[8],

      game_date: row[9],

      home_team_id: row[10],

      away_team_id: row[11]

  }));
}

function fetchAllNFLOddsForGameIds_(gameIds) {
  const allOdds = [];

  gameIds.forEach((gameId, index) => {
    Logger.log(`Fetching NFL odds for game ${index + 1}/${gameIds.length} ID ${gameId}`);

    let cursor = null;

    do {
      const params = {
        "game_ids[]": gameId,
        per_page: 100
      };

      if (cursor) params.cursor = cursor;

      const response = fetchApi_("/nfl/v1/odds", params);
      const odds = Array.isArray(response.data) ? response.data : [];

      allOdds.push(...odds);

      cursor = response.meta && response.meta.next_cursor
        ? response.meta.next_cursor
        : null;

    } while (cursor);

    Utilities.sleep(150);
  });

  return allOdds;
}

function copyNFLGameOddsFormulasDown_(sheet, rowCount) {
  if (!rowCount || rowCount <= 0) return;

  sheet.getRange("N2:AE2").copyTo(
    sheet.getRange(3, 14, rowCount, 18),
    SpreadsheetApp.CopyPasteType.PASTE_FORMULA,
    false
  );
}

function formatNFLGameOddsSheet_(sheet) {
  sheet.setFrozenRows(1);

  sheet.getRange("1:1").setFontWeight("bold");
  sheet.getRange("A1:AE1").setHorizontalAlignment("center");

  sheet.getRange("Y:AB").setNumberFormat("0.000000");
  sheet.getRange("AC:AE").setNumberFormat("0.00%");

  sheet.getRange("A:AE").setVerticalAlignment("middle");

  if (!sheet.getFilter()) {
    sheet.getRange("A1:AE1").createFilter();
  }

  sheet.autoResizeColumns(1, 31);
}

function refreshNFLGameOddsSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Game Odds");
  const scheduleSheet = ss.getSheetByName("Schedule");

  if (!sheet) throw new Error('Sheet "Game Odds" not found.');
  if (!scheduleSheet) throw new Error('Sheet "Schedule" not found.');

  ensureNFLGameOddsHeadersAndFormulas_(sheet);

  const games = getNFLGamesFromScheduleSheet_(scheduleSheet);

  if (!games.length) {
    clearNFLGameOddsSheet_(sheet);
    Logger.log("No NFL Schedule rows found. Game Odds cleared.");
    return;
  }

  const gameIds = games.map(game => game.id).filter(Boolean);
  const odds = fetchAllNFLOddsForGameIds_(gameIds);

  const seen = new Set();
  const rows = [];

  odds.forEach(item => {
    const oddsId = String(item.id || "");
    if (oddsId && seen.has(oddsId)) return;
    if (oddsId) seen.add(oddsId);

    rows.push([
      item.id || "",
      item.game_id || "",
      item.vendor || "",
      item.spread_away_value || "",
      item.spread_away_odds || "",
      item.spread_home_value || "",
      item.spread_home_odds || "",
      item.moneyline_away_odds || "",
      item.moneyline_home_odds || "",
      item.total_value || "",
      item.total_over_odds || "",
      item.total_under_odds || "",
      item.updated_at || ""
    ]);
  });

  clearNFLGameOddsSheet_(sheet);

  if (rows.length > 0) {
    sheet.getRange(3, 1, rows.length, 13).setValues(rows);
    copyNFLGameOddsFormulasDown_(sheet, rows.length);
    formatNFLGameOddsSheet_(sheet);
  }

  Logger.log(`Wrote ${rows.length} NFL game odds rows.`);
}

