function getNullableNFLNumericField_(
  row,
  fieldName
) {
  if (!row) {
    return null;
  }


  const rawValue =
    row[fieldName];


  if (
    rawValue === "" ||
    rawValue === null ||
    rawValue === undefined
  ) {
