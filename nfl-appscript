 * @param {string} search Search by team name
 * @param {number} perPage Results per page
 * @returns {Array} Dota 2 teams data
 * @customfunction
 */
function BDL_DOTA_TEAMS(search, perPage) {
  const params = { per_page: perPage || 25 };
  if (search) params.search = search;
  const response = fetchApi_('/dota/v1/teams', params);
  return toSheet_(response.data);
}

