function normalizeNFLUniversalPropType_(propType) {
  if (
    propType === null ||
    propType === undefined
  ) {
    return "";
  }


  return String(
    propType
  )
    .trim()
    .toLowerCase();
}


function sampleStandardDeviationNFL_(values) {
  const numericValues =
    (values || [])
      .map(value =>
        Number(value)
      )
      .filter(value =>
        Number.isFinite(value)
      );


  if (
    numericValues.length < 2
  ) {
    return null;
  }


  const mean =
    numericValues.reduce(
      (sum, value) =>
        sum + value,
      0
    ) /
    numericValues.length;


  const squaredDeviationSum =
    numericValues.reduce(
      (sum, value) =>
        sum +
        Math.pow(
          value - mean,
          2
        ),
      0
    );


  return Math.sqrt(
    squaredDeviationSum /
    (
      numericValues.length - 1
    )
  );
}


function buildNFLUniversalPropHistoricalContext_({
  propType,
  currentGames,
  currentAvg,
  priorGames,
  priorTotal,
  last5,
  currentValues,
  historicalValues
}) {
  const normalizedPropType =
    normalizeNFLUniversalPropType_(
      propType
    );


  const statConfig =
    NFL_UNIVERSAL_PROP_STAT_MAP[
      normalizedPropType
    ];


  // Unsupported market.
  if (!statConfig) {
    return {
      playerBaseline: null,
      trendAdjustment: null,
      projectedStat: null,
      statStdDev: null
    };
  }


  const parsedCurrentGames =
    Number(
      currentGames
    );


  const parsedPriorGames =
    Number(
      priorGames
    );


  const hasCurrentGames =
    Number.isFinite(
      parsedCurrentGames
    ) &&
    parsedCurrentGames > 0;


  const hasPriorGames =
    Number.isFinite(
      parsedPriorGames
    ) &&
    parsedPriorGames > 0;


  const hasCurrentAvg =
    currentAvg !== "" &&
    currentAvg !== null &&
    currentAvg !== undefined &&
    Number.isFinite(
      Number(currentAvg)
    );


  const hasPriorTotal =
    priorTotal !== "" &&
    priorTotal !== null &&
    priorTotal !== undefined &&
    Number.isFinite(
      Number(priorTotal)
    );


  const parsedCurrentAvg =
    hasCurrentAvg
      ? Number(currentAvg)
      : null;


  const priorAvg =
    (
      hasPriorGames &&
      hasPriorTotal
    )
      ? (
          Number(priorTotal) /
          parsedPriorGames
        )
      : null;


  // --------------------------------------------------------------------------
  // Q — PLAYER BASELINE
  //
  // Exact translation of current X2 production formula.
  // --------------------------------------------------------------------------

  let playerBaseline =
    null;


  if (
    hasCurrentGames &&
    parsedCurrentAvg !== null &&
    priorAvg !== null
  ) {
    playerBaseline =
      (
        (
          4 * priorAvg
        ) +
        (
          parsedCurrentGames *
          parsedCurrentAvg
        )
      ) /
      (
        4 +
        parsedCurrentGames
      );

  } else if (
    hasCurrentGames &&
    parsedCurrentAvg !== null
  ) {
    playerBaseline =
      parsedCurrentAvg;

  } else if (
    priorAvg !== null
  ) {
    playerBaseline =
      priorAvg;
  }


  // --------------------------------------------------------------------------
  // R — TREND ADJUSTMENT
  //
  // Exact translation of current Y2 production formula:
  // 0.30 * (Last5 - baseline)
  //
  // Existing behavior returns 0 when Last5/currentGames are unavailable.
  // --------------------------------------------------------------------------

  let trendAdjustment =
    null;


  if (
    playerBaseline !== null
  ) {
    const hasLast5 =
      last5 !== "" &&
      last5 !== null &&
      last5 !== undefined &&
      Number.isFinite(
        Number(last5)
      );


    if (
      !hasLast5 ||
      !hasCurrentGames
    ) {
      trendAdjustment =
        0;

    } else {

      trendAdjustment =
        0.30 *
        (
          Number(last5) -
          playerBaseline
        );
    }
  }


  // --------------------------------------------------------------------------
  // S — PROJECTED STAT
  // --------------------------------------------------------------------------

  const projectedStat =
    (
      playerBaseline !== null &&
      trendAdjustment !== null
    )
      ? (
          playerBaseline +
          trendAdjustment
        )
      : null;


  // --------------------------------------------------------------------------
  // T — STAT STD DEV
  //
  // Exact translation of current AA2 production formula.
  // --------------------------------------------------------------------------

  const cleanCurrentValues =
    (currentValues || [])
      .map(value =>
        Number(value)
      )
      .filter(value =>
        Number.isFinite(value)
      );


  const cleanHistoricalValues =
    (historicalValues || [])
      .map(value =>
        Number(value)
      )
      .filter(value =>
        Number.isFinite(value)
      );


  const currentN =
    cleanCurrentValues.length;


  const historicalN =
    cleanHistoricalValues.length;


  const currentSD =
    currentN >= 2
      ? sampleStandardDeviationNFL_(
          cleanCurrentValues
        )
      : null;


  const historicalSD =
    historicalN >= 2
      ? sampleStandardDeviationNFL_(
          cleanHistoricalValues
        )
      : null;


  let statStdDev =
    null;


  if (
    currentSD !== null &&
    historicalSD !== null
  ) {
    statStdDev =
      Math.sqrt(
        (
          (
            4 *
            Math.pow(
              historicalSD,
              2
            )
          ) +
          (
            (currentN - 1) *
            Math.pow(
              currentSD,
              2
            )
          )
        ) /
        (
          4 +
          (
            currentN - 1
          )
        )
      );

  } else if (
    currentSD !== null
  ) {
    statStdDev =
      currentSD;

  } else if (
    historicalSD !== null
  ) {
    statStdDev =
      historicalSD;
  }


  return {
    playerBaseline,
    trendAdjustment,
    projectedStat,
    statStdDev
  };
}

