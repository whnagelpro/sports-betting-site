function fetchAllNFLGamesForDate_(dateString) {
  const allGames = [];
  let cursor = null;

  do {
    const params = {
      "dates[]": dateString,

      // Include ALL NFL season types:
      // 1 = preseason
      // 2 = regular season
      // 3 = postseason
      "season_type[]": [1, 2, 3],

      per_page: 100
    };

    if (cursor) {
      params.cursor = cursor;
    }

    const response = fetchApi_("/nfl/v1/games", params);

    const games =
      Array.isArray(response.data)
        ? response.data
        : [];

    Logger.log(
      `Games returned for ${dateString}: ${games.length}`
    );

    if (games.length) {
      Logger.log(
        "First game returned: " +
        JSON.stringify(games[0])
      );
    }

    allGames.push(...games);

    cursor =
      response.meta &&
      response.meta.next_cursor
        ? response.meta.next_cursor
        : null;

  } while (cursor);

  return allGames;
}

