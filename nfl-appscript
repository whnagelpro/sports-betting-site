          row[31],

        sportacularScore:
          row[33],

        sportacularEdge:
          row[34],

        confidenceTier:
          row[35]
      },

      rebuilt:
        rebuiltScoring
    }
  );


  // ==========================================================================
  // FINAL
  // ==========================================================================

  const passed =
    tests.every(
      test =>
        test.pass
    );


  Logger.log(
    JSON.stringify({
      test:
        "P15 D7A NFL UNIVERSAL PRODUCTION ROW",

      totalTests:
        tests.length,

      passedTests:
        tests.filter(
          test =>
            test.pass
        ).length,

      failedTests:
        tests.filter(
          test =>
            !test.pass
        ).length,

      passed
    })
  );


  if (!passed) {

    throw new Error(
      "P15 D7A FAIL — NFL universal production row regression failed."
    );
  }


  Logger.log(
    "============================================================"
  );

  Logger.log(
    "P15 D7A TEST PASS — NFL UNIVERSAL SPORTACULAR ROW COMPLETE"
  );

  Logger.log(
    "NFL IS READY FOR P15 LIVE PRODUCTION REFRESH."
  );

  Logger.log(
    "============================================================"
  );


  return true;
}

function ensureNFLPlayerPropsHeadersAndFormulas_(sheet) {
  const rawHeaders = [
    "Game Id", "Game Date", "Away Team", "Home Team", "Id", "Player Id",
    "Vendor", "Prop Type", "Line Value", "Type", "Odds", "Updated At",
    "Over Odds", "Under Odds"
  ];

  const formulaHeaders = [
    "EV Over", "EV Under", "Model Prob Over", "Model Prob Under",
    "Best Price Edge", "Risk Tier", "Model Confidence", "Player Name", "Team",
    "Player Baseline", "Trend Adjustment", "Projected Stat", "Stat Std Dev",
    "Best Side", "Best EV", "Best Model Probability"
  ];

  sheet.getRange(1, 1, 1, rawHeaders.length).setValues([rawHeaders]);
  sheet.getRange(1, 15, 1, formulaHeaders.length).setValues([formulaHeaders]);

  sheet.getRange("O2").setFormula(
    `=IF(
      OR(
        Q2="",
        M2=""
      ),
      "",
      Q2*IF(M2>0,M2/100,100/ABS(M2))-(1-Q2)
    )`
  );
  sheet.getRange("P2").setFormula(
    `=IF(
      OR(
        R2="",
        N2=""
      ),
      "",
      R2*IF(N2>0,N2/100,100/ABS(N2))-(1-R2)
    )`
  );
  sheet.getRange("Q2").setFormula(
    `=IF(
      OR(
        J2<>"over_under",
        Z2="",
        AA2="",
        AA2<=0,
        NOT(
          OR(
            H2="passing_yards",
            H2="passing_completions",
            H2="passing_attempts",
            H2="rushing_yards",
            H2="rushing_attempts",
            H2="receptions",
            H2="receiving_yards"
          )
        )
      ),
      "",
      LET(
        currentGames,
          IFERROR(
            INDEX(
              'NFL Player Season Stats'!D:D,
              MATCH(
                F2,
                'NFL Player Season Stats'!A:A,
                0
              )
            ),
            0
          ),

        reliability,
          MIN(
            1,
            0.60 + 0.05*currentGames
          ),

        rawOver,
          1-NORM.S.DIST(
            (I2-Z2)/AA2,
            TRUE
          ),

        calibratedOver,
          0.5 +
          (rawOver-0.5)*reliability,

        MIN(
          0.975,
          MAX(
            0.025,
            calibratedOver
          )
        )
      )
    )`
  );
  sheet.getRange("R2").setFormula(
    `=IF(
      OR(
        J2<>"over_under",
        Z2="",
        AA2="",
        AA2<=0,
        NOT(
          OR(
            H2="passing_yards",
            H2="passing_completions",
            H2="passing_attempts",
            H2="rushing_yards",
            H2="rushing_attempts",
            H2="receptions",
            H2="receiving_yards"
          )
        )
      ),
      "",
      1-Q2
    )`
  );
  sheet.getRange("S2").setFormula(
    `=IF(
      OR(
        Q2="",
        R2="",
        M2="",
        N2=""
      ),
      "",
      LET(
        impliedOver,
          IF(
            M2>0,
            100/(M2+100),
            ABS(M2)/(ABS(M2)+100)
          ),

        impliedUnder,
          IF(
            N2>0,
            100/(N2+100),
            ABS(N2)/(ABS(N2)+100)
          ),

        totalImplied,
          impliedOver+impliedUnder,

        vigFreeOver,
          impliedOver/totalImplied,

        vigFreeUnder,
          impliedUnder/totalImplied,

        overEdge,
          Q2-vigFreeOver,

        underEdge,
          R2-vigFreeUnder,

        MAX(overEdge,underEdge)
      )
    )`
  );
  sheet.getRange("T2").setFormula(
    `=IF(
      OR(
        Z2="",
        AA2="",
        AA2<=0,
        S2=""
      ),
      "",
      LET(
        currentGames,
          IFERROR(
            INDEX(
              'NFL Player Season Stats'!D:D,
              MATCH(
                F2,
                'NFL Player Season Stats'!A:A,
                0
              )
            ),
            0
          ),

        relativeUncertainty,
          IF(
            ABS(Z2)>0,
            AA2/ABS(Z2),
            999
          ),

        sampleRisk,
          IF(
            currentGames=0,
            2,
            IF(
              currentGames<4,
              1,
              0
            )
          ),

        uncertaintyRisk,
          IF(
            relativeUncertainty>=0.50,
            2,
            IF(
              relativeUncertainty>=0.25,
              1,
              0
            )
          ),

        disagreementRisk,
          IF(
            S2>=0.20,
            2,
            IF(
              S2>=0.12,
              1,
              0
            )
          ),

        riskPoints,
          sampleRisk +
          uncertaintyRisk +
          disagreementRisk,

        IF(
          riskPoints>=4,
          "High",
          IF(
            riskPoints>=2,
            "Medium",
            "Low"
          )
        )
      )
    )`
  );
  sheet.getRange("U2").setFormula(
    `=IF(
      OR(
        Q2="",
        R2="",
        S2=""
      ),
      "",
      MIN(
        100,
        MAX(Q2,R2)*100 + S2*25
      )
    )`
  );
  sheet.getRange("V2").setFormula(`=IFERROR(INDEX(Rosters!D:D,MATCH(F2,Rosters!A:A,0)),"")`);
  sheet.getRange("W2").setFormula(`=IFERROR(INDEX(Rosters!F:F,MATCH(F2,Rosters!A:A,0)),"")`);
  sheet.getRange("X2").setFormula(
    `=IFERROR(
      LET(
        statName,
          SWITCH(
            H2,
            "passing_yards","Passing Yards",
            "passing_tds","Passing TDs",
            "interceptions","Interceptions",
            "passing_completions","Completions",
            "passing_attempts","Pass Attempts",
            "rushing_yards","Rushing Yards",
            "rushing_attempts","Rushing Attempts",
            "rushing_tds","Rushing TDs",
            "receptions","Receptions",
            "receiving_yards","Receiving Yards",
            "receiving_tds","Receiving TDs",
            ""
          ),

        currentGames,
          IFERROR(
            INDEX(
              'NFL Player Season Stats'!D:D,
              MATCH(F2,'NFL Player Season Stats'!A:A,0)
            ),
            0
          ),

        currentAvg,
          IFERROR(
            INDEX(
              'NFL Player Trends'!E:E,
              MATCH(
                1,
                (F2='NFL Player Trends'!A:A)*
                (statName='NFL Player Trends'!D:D),
                0
              )
            ),
            ""
          ),

        priorGames,
          IFERROR(
            INDEX(
              'NFL Player Baselines'!D:D,
              MATCH(F2,'NFL Player Baselines'!A:A,0)
            ),
            0
          ),

        priorTotal,
          IFERROR(
            SWITCH(
              H2,
              "passing_yards",
                INDEX('NFL Player Baselines'!E:E,MATCH(F2,'NFL Player Baselines'!A:A,0)),
              "passing_tds",
                INDEX('NFL Player Baselines'!F:F,MATCH(F2,'NFL Player Baselines'!A:A,0)),
              "interceptions",
                INDEX('NFL Player Baselines'!G:G,MATCH(F2,'NFL Player Baselines'!A:A,0)),
              "passing_completions",
                INDEX('NFL Player Baselines'!H:H,MATCH(F2,'NFL Player Baselines'!A:A,0)),
              "passing_attempts",
                INDEX('NFL Player Baselines'!I:I,MATCH(F2,'NFL Player Baselines'!A:A,0)),
              "rushing_yards",
                INDEX('NFL Player Baselines'!J:J,MATCH(F2,'NFL Player Baselines'!A:A,0)),
              "rushing_attempts",
                INDEX('NFL Player Baselines'!K:K,MATCH(F2,'NFL Player Baselines'!A:A,0)),
              "rushing_tds",
                INDEX('NFL Player Baselines'!L:L,MATCH(F2,'NFL Player Baselines'!A:A,0)),
              "receptions",
                INDEX('NFL Player Baselines'!M:M,MATCH(F2,'NFL Player Baselines'!A:A,0)),
              "receiving_yards",
                INDEX('NFL Player Baselines'!N:N,MATCH(F2,'NFL Player Baselines'!A:A,0)),
              "receiving_tds",
                INDEX('NFL Player Baselines'!O:O,MATCH(F2,'NFL Player Baselines'!A:A,0)),
              ""
            ),
            ""
          ),

        priorAvg,
          IF(
            AND(priorGames>0,priorTotal<>""),
            priorTotal/priorGames,
            ""
          ),

        IF(
          statName="",
          "",
          IF(
            AND(currentGames>0,currentAvg<>"",priorAvg<>""),
            ((4*priorAvg)+(currentGames*currentAvg))/(4+currentGames),
            IF(
              AND(currentGames>0,currentAvg<>""),
              currentAvg,
              priorAvg
            )
          )
        )
      ),
      ""
    )`
  );

  sheet.getRange("Y2").setFormula(
    `=IFERROR(
      LET(
        statName,
          SWITCH(
            H2,
            "passing_yards","Passing Yards",
            "passing_tds","Passing TDs",
            "interceptions","Interceptions",
            "passing_completions","Completions",
            "passing_attempts","Pass Attempts",
            "rushing_yards","Rushing Yards",
            "rushing_attempts","Rushing Attempts",
            "rushing_tds","Rushing TDs",
            "receptions","Receptions",
            "receiving_yards","Receiving Yards",
            "receiving_tds","Receiving TDs",
            ""
          ),

        last5,
          IFERROR(
            INDEX(
              'NFL Player Trends'!G:G,
              MATCH(
                1,
                (F2='NFL Player Trends'!A:A)*
                (statName='NFL Player Trends'!D:D),
                0
              )
            ),
            ""
          ),

        currentGames,
          IFERROR(
            INDEX(
              'NFL Player Season Stats'!D:D,
              MATCH(F2,'NFL Player Season Stats'!A:A,0)
            ),
            0
          ),

        IF(
          OR(
            X2="",
            last5="",
            currentGames=0
          ),
          0,
          0.30*(last5-X2)
        )
      ),
      0
    )`
  );

  sheet.getRange("Z2").setFormula(
    `=IF(OR(X2="",Y2=""),"",X2+Y2)`
  );

  sheet.getRange("AA2").setFormula(
    `=IFERROR(
      LET(
        statCol,
          SWITCH(
            H2,
            "passing_yards",7,
            "passing_tds",8,
            "interceptions",9,
            "passing_completions",10,
            "passing_attempts",11,
            "rushing_yards",12,
            "rushing_attempts",13,
            "rushing_tds",14,
            "receptions",15,
            "receiving_yards",16,
            "receiving_tds",17,
            0
          ),

        currentValues,
          IF(
            statCol=0,
            "",
            FILTER(
              INDEX('NFL Player Game Logs'!A:Q,0,statCol),
              'NFL Player Game Logs'!C:C=F2
            )
          ),

        historicalValues,
          IF(
            statCol=0,
            "",
            FILTER(
              INDEX('NFL Player Historical Logs'!A:Q,0,statCol),
              'NFL Player Historical Logs'!C:C=F2
            )
          ),

        currentN,
          IFERROR(COUNT(currentValues),0),

        historicalN,
          IFERROR(COUNT(historicalValues),0),

        currentSD,
          IF(
            currentN>=2,
            STDEV.S(currentValues),
            ""
          ),

        historicalSD,
          IF(
            historicalN>=2,
            STDEV.S(historicalValues),
            ""
          ),

        IF(
          statCol=0,
          "",
          IF(
            AND(currentN>=2,historicalN>=2),
            SQRT(
              (
                4*POWER(historicalSD,2) +
                (currentN-1)*POWER(currentSD,2)
              ) /
              (
                4 +
                (currentN-1)
              )
            ),
            IF(
              currentN>=2,
              currentSD,
              IF(
                historicalN>=2,
                historicalSD,
                ""
              )
            )
          )
        )
      ),
      ""
    )`
  );

  sheet.getRange("AB2").setFormula(
    `=IF(
      OR(
        O2="",
        P2="",
        Q2="",
        R2=""
      ),
      "",
      IF(
        MAX(O2,P2)<=0,
        "No Play",
        IF(
          O2>P2,
          "Over",
          IF(
            P2>O2,
            "Under",
            "No Play"
          )
        )
      )
    )`
  );

  sheet.getRange("AC2").setFormula(
    `=IF(
      AB2="",
      "",
      IF(
        AB2="No Play",
        MAX(O2,P2),
        IF(
          AB2="Over",
          O2,
          P2
        )
      )
    )`
  );

  sheet.getRange("AD2").setFormula(
    `=IF(
      AB2="",
      "",
      IF(
        AB2="Over",
        Q2,
        IF(
          AB2="Under",
          R2,
          ""
        )
      )
    )`
  );

  sheet.setFrozenRows(1);
  sheet.getRange("1:1").setFontWeight("bold");
  sheet.getRange("A1:AD1").setHorizontalAlignment("center");

  const existingFilter = sheet.getFilter();

  if (existingFilter) {
    existingFilter.remove();
  }

  sheet.getRange("A1:AD1").createFilter();

  sheet.autoResizeColumns(1, 30);
}

function clearNFLPlayerPropsSheet_(sheet) {
  const universalColumnCount =
    NFL_UNIVERSAL_PLAYER_PROPS_HEADERS.length; // 36 = A:AJ

  const currentMaxColumns =
    sheet.getMaxColumns();


  if (
    currentMaxColumns <
    universalColumnCount
  ) {
    sheet.insertColumnsAfter(
      currentMaxColumns,
      universalColumnCount -
      currentMaxColumns
    );
  }


  const maxRows =
    sheet.getMaxRows();


  // Universal production begins at row 2.
  // This intentionally removes the old O2:AD2 formula template.
  if (maxRows > 1) {
    sheet
      .getRange(
        2,
        1,
        maxRows - 1,
        universalColumnCount
      )
      .clearContent();
  }
}

function fetchAllNFLPlayerPropsForGame_(gameId) {

  const response = fetchApi_("/nfl/v1/odds/player_props", {
    game_id: gameId
  });

  Logger.log("Props response for game " + gameId);
  Logger.log(JSON.stringify(response, null, 2));

  return Array.isArray(response.data)
    ? response.data
    : [];

}

function copyNFLPlayerPropsFormulasDown_(sheet, rowCount) {
  if (!rowCount || rowCount <= 0) return;

  sheet.getRange("O2:AD2").copyTo(
    sheet.getRange(3, 15, rowCount, 16),
    SpreadsheetApp.CopyPasteType.PASTE_FORMULA,
    false
  );
}

function refreshNFLPlayerPropsSheet() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();


  const sheet =
    ss.getSheetByName(
      "Player Props"
    );


  const scheduleSheet =
    ss.getSheetByName(
      "Schedule"
    );


  if (!sheet) {
    throw new Error(
      'Sheet "Player Props" not found.'
    );
  }


  if (!scheduleSheet) {
    throw new Error(
      'Sheet "Schedule" not found.'
    );
  }


  Logger.log(
    "Refreshing NFL player props using universal A:AJ production output..."
  );


  // --------------------------------------------------------------------------
  // UNIVERSAL CONTRACT
  // --------------------------------------------------------------------------

  validateNFLUniversalPlayerPropsHeaders_();


  const universalColumnCount =
    NFL_UNIVERSAL_PLAYER_PROPS_HEADERS.length;


  if (
    universalColumnCount !== 36
  ) {
    throw new Error(
      `NFL universal Player Props contract expected 36 columns; received ${universalColumnCount}.`
    );
  }


  // Ensure the physical sheet reaches AJ.
  const currentMaxColumns =
    sheet.getMaxColumns();


  if (
    currentMaxColumns <
    universalColumnCount
  ) {
    sheet.insertColumnsAfter(
      currentMaxColumns,
      universalColumnCount -
      currentMaxColumns
    );
  }


  // Write the frozen universal row-1 contract.
  sheet
    .getRange(
      1,
      1,
      1,
      universalColumnCount
    )
    .setValues([
      NFL_UNIVERSAL_PLAYER_PROPS_HEADERS
    ]);


  // Remove all previous production rows AND the old row-2 formula template.
  clearNFLPlayerPropsSheet_(
    sheet
  );


  // --------------------------------------------------------------------------
  // SCHEDULE
  // --------------------------------------------------------------------------

  const games =
    getNFLGamesFromScheduleSheet_(
      scheduleSheet
    );


  if (!games.length) {
    Logger.log(
      'No NFL Schedule rows found. Universal Player Props A:AJ left in valid empty state.'
    );

    return;
  }


  const gameMap = {};


  games.forEach(game => {

    gameMap[
      String(game.id)
    ] = {
      game_date:
        game.game_date ?? "",

      away_team:
        game.away_team ?? "",

      home_team:
        game.home_team ?? ""
    };
  });


  // --------------------------------------------------------------------------
  // BUILD UNIVERSAL CONTEXT INDEXES ONCE
  // --------------------------------------------------------------------------

  Logger.log(
    "Building NFL Player Props historical, trend, season, baseline, and identity indexes..."
  );


  const playerIdentityIndex =
    buildNFLPlayerIdentityIndex_();


  const seasonStatIndex =
    buildNFLPlayerSeasonStatIndex_();


  const baselineIndex =
    buildNFLPlayerBaselineIndex_();


  const trendIndex =
    buildNFLPlayerTrendIndex_();


  const currentLogIndex =
    buildNFLPlayerGameLogIndexFromSheet_(
      "NFL Player Game Logs"
    );


  const historicalLogIndex =
    buildNFLPlayerGameLogIndexFromSheet_(
      "NFL Player Historical Logs"
    );


  Logger.log(
    "NFL Player Props universal context indexes built."
  );


  // --------------------------------------------------------------------------
  // FETCH + ASSEMBLE UNIVERSAL ROWS
  // --------------------------------------------------------------------------

  const rows = [];

  const seen =
    new Set();


  games.forEach(
    (game, index) => {

      Logger.log(
        `Fetching NFL props for game ${index + 1}/${games.length} ID ${game.id}`
      );


      const props =
        fetchAllNFLPlayerPropsForGame_(
          game.id
        );


      const gameInfo =
        gameMap[
          String(game.id)
        ] || {};


      props.forEach(prop => {

        const propId =
          String(
            prop.id ?? ""
          );


        if (
          propId &&
          seen.has(propId)
        ) {
          return;
        }


        if (propId) {
          seen.add(propId);
        }


        // --------------------------------------------------------------
        // A:N PROVIDER CONTRACT
        //
        // Explicit nullish handling preserves legitimate zero values.
        // --------------------------------------------------------------

        const playerId =
          prop.player_id ??
          (
            prop.player
              ? prop.player.id
              : null
          ) ??
          "";


        const vendor =
          prop.vendor ??
          prop.sportsbook ??
          prop.bookmaker ??
          "";


        const propType =
          prop.prop_type ??
          (
            typeof prop.market === "string"
              ? prop.market
              : null
          ) ??
          "";


        const lineValue =
          prop.line ??
          prop.line_value ??
          (
            prop.market &&
            typeof prop.market === "object"
              ? (
                  prop.market.line ??
                  prop.market.line_value
                )
              : null
          ) ??
          "";


        const marketType =
          (
            prop.market &&
            typeof prop.market === "object"
          )
            ? (
                prop.market.type ??
                ""
              )
            : (
                prop.type ??
                ""
              );


        const odds =
          (
            prop.market &&
            typeof prop.market === "object"
          )
            ? (
                prop.market.odds ??
                prop.odds ??
                ""
              )
            : (
                prop.odds ??
                ""
              );


        const overOdds =
          (
            prop.market &&
            typeof prop.market === "object"
          )
            ? (
                prop.market.over_odds ??
                prop.over_odds ??
                ""
              )
            : (
                prop.over_odds ??
                ""
              );


        const underOdds =
          (
            prop.market &&
            typeof prop.market === "object"
          )
            ? (
                prop.market.under_odds ??
                prop.under_odds ??
                ""
              )
            : (
                prop.under_odds ??
                ""
              );


        const providerRow = {
          gameId:
            game.id ?? "",

          gameDate:
            gameInfo.game_date ?? "",

          awayTeam:
            gameInfo.away_team ?? "",

          homeTeam:
            gameInfo.home_team ?? "",

          id:
            prop.id ?? "",

          playerId,

          vendor,

          propType,

          lineValue,

          type:
            marketType,

          odds,

          updatedAt:
            prop.updated_at ?? "",

          overOdds,

          underOdds
        };


        const universalRow =
          buildNFLUniversalPropRowFromProvider_({
            providerRow,
            playerIdentityIndex,
            seasonStatIndex,
            baselineIndex,
            trendIndex,
            currentLogIndex,
            historicalLogIndex
          });


        if (
          universalRow.length !==
          universalColumnCount
        ) {
          throw new Error(
            `NFL universal row width mismatch for prop ${providerRow.id}. Expected ${universalColumnCount}, received ${universalRow.length}.`
          );
        }


        rows.push(
          universalRow
        );
      });


      Utilities.sleep(
        150
      );
    }
  );


  // --------------------------------------------------------------------------
  // WRITE DIRECT VALUES TO ROW 2+
  //
  // No formulas. No template row. No copy-down.
  // --------------------------------------------------------------------------

  if (rows.length > 0) {
    sheet
      .getRange(
        2,
        1,
        rows.length,
        universalColumnCount
      )
      .setValues(
        rows
      );
  }


  Logger.log(
    `Wrote ${rows.length} NFL universal Player Props rows to "Player Props" across A:AJ.`
  );
}

