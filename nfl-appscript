      noTrend.modelConfidence -
      62.5
    ) < 1e-9
  );


  // --------------------------------------------------------------------------
  // VIG-FREE EDGE IS NOT RAW IMPLIED EDGE
  //
  // Unequal prices ensure we're genuinely testing the existing NFL S-column
  // normalization rather than accidentally reproducing raw implied edge.
  // --------------------------------------------------------------------------

  const unequalPriceEdges =
    getNFLVigFreePriceEdges_({
      modelProbOver:
        0.60,

      modelProbUnder:
        0.40,

      overOdds:
        -120,

      underOdds:
        100
    });


  const rawImpliedOver =
    120 / 220;


  const rawImpliedUnder =
    100 / 200;


  const totalImplied =
    rawImpliedOver +
    rawImpliedUnder;


  const expectedVigFreeOver =
    rawImpliedOver /
    totalImplied;


  assertTest(
    "NFL unequal-price Over edge uses vig-free probability",
    Math.abs(
      unequalPriceEdges.overEdge -
      (
        0.60 -
