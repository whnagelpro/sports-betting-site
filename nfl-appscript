/**
 * Assemble exactly one universal NFL Player Props A:AJ row.
 *
 * P15 production ownership:
 *
 * Y  = final actionable Best Side
 * AE = universal Risk Score
 * AF = universal Risk Tier
 * AH = Sportacular Score
 * AI = Sportacular Edge
 * AJ = Confidence Tier
 */
function buildNFLUniversalPlayerPropRow_({
  providerRow,
  identity,
  historicalContext,
  probabilityEV,
  decisionTrend,
  sportacularScoring
}) {

  const scoring =
    sportacularScoring || {};


  const row = [

    // ------------------------------------------------------------------------
    // A:N — PROVIDER
    // ------------------------------------------------------------------------

    providerRow.gameId ?? "",        // A
    providerRow.gameDate ?? "",      // B
    providerRow.awayTeam ?? "",      // C
    providerRow.homeTeam ?? "",      // D
    providerRow.id ?? "",            // E
    providerRow.playerId ?? "",      // F
    providerRow.vendor ?? "",        // G
    providerRow.propType ?? "",      // H
    providerRow.lineValue ?? "",     // I
    providerRow.type ?? "",          // J
    providerRow.odds ?? "",          // K
    providerRow.updatedAt ?? "",     // L
    providerRow.overOdds ?? "",      // M
    providerRow.underOdds ?? "",     // N


    // ------------------------------------------------------------------------
    // O:P — IDENTITY
    // ------------------------------------------------------------------------

    identity
      ? identity.playerName ?? ""
      : "",                          // O

    identity
      ? identity.team ?? ""
      : "",                          // P


    // ------------------------------------------------------------------------
    // Q:T — HISTORICAL / PROJECTION
    // ------------------------------------------------------------------------

    historicalContext.playerBaseline ??
      "",                            // Q

    historicalContext.trendAdjustment ??
      "",                            // R

    historicalContext.projectedStat ??
      "",                            // S

    historicalContext.statStdDev ??
      "",                            // T


    // ------------------------------------------------------------------------
    // U:X — PROBABILITY / EV
    // ------------------------------------------------------------------------

    probabilityEV.modelProbOver ??
      "",                            // U

    probabilityEV.modelProbUnder ??
      "",                            // V

    probabilityEV.evOver ??
      "",                            // W

    probabilityEV.evUnder ??
      "",                            // X


    // ------------------------------------------------------------------------
    // Y:AD — FINAL DECISION + EXISTING MODEL/TRND SIGNALS
    // ------------------------------------------------------------------------

    scoring.finalBestSide ??
      "No Play",                     // Y

    decisionTrend.bestEV ??
      "",                            // Z

    decisionTrend.bestModelProbability ??
      "",                            // AA

    decisionTrend.bestPriceEdge ??
      "",                            // AB

    decisionTrend.trendScore ??
      "",                            // AC

    decisionTrend.trendStrength ??
      "",                            // AD


    // ------------------------------------------------------------------------
    // AE:AF — P15 UNIVERSAL RISK
    // ------------------------------------------------------------------------

    scoring.riskScore ??
      "",                            // AE

    scoring.riskTier ??
      "",                            // AF


    // ------------------------------------------------------------------------
    // AG — NFL VALIDATED MODEL CONFIDENCE
    // ------------------------------------------------------------------------

    decisionTrend.modelConfidence ??
      "",                            // AG


    // ------------------------------------------------------------------------
    // AH:AJ — P15 SPORTACULAR SCORING
    // ------------------------------------------------------------------------

    scoring.sportacularScore ??
      "",                            // AH

    scoring.sportacularEdge ??
      "",                            // AI

    scoring.confidenceTier ??
      ""                             // AJ
  ];


  if (
    row.length !==
    NFL_UNIVERSAL_PLAYER_PROPS_HEADERS.length
  ) {

    throw new Error(
      `NFL universal Player Props row width mismatch. Expected ${NFL_UNIVERSAL_PLAYER_PROPS_HEADERS.length}, received ${row.length}.`
    );
  }


  return row;
}

/**
 * Full one-provider-row NFL universal production pipeline.
 *
 * P15 order:
 *
 * provider
 *   ↓
 * projection Q:T
 *   ↓
 * probability / EV U:X
 *   ↓
 * candidate decision Z:AD + AG
 *   ↓
 * universal Sportacular scoring
 *   ↓
 * final actionable Y + AE:AF + AH:AJ
 */
function buildNFLUniversalPropRowFromProvider_({
  providerRow,
  playerIdentityIndex,
  seasonStatIndex,
  baselineIndex,
  trendIndex,
  currentLogIndex,
  historicalLogIndex
}) {

  const playerId =
    String(
      providerRow.playerId ?? ""
    ).trim();


  const identity =
    playerIdentityIndex[
      playerId
    ] || {
      playerName:
        "",

      team:
        ""
    };

  // --------------------------------------------------------------------------
  // UNSUPPORTED MARKET SHORT-CIRCUIT
  //
  // P15 currently models conventional over_under markets only.
  // Milestone markets such as first_td / anytime_td remain valid provider
  // rows, but they must not enter the projection / probability / scoring
  // pipeline until a dedicated milestone model exists.
  // --------------------------------------------------------------------------

  const normalizedMarketType =
    String(
      providerRow.type ?? ""
    )
      .trim()
      .toLowerCase();


  if (
    normalizedMarketType !==
    "over_under"
  ) {

    const unsupportedHistoricalContext = {
      playerBaseline: null,
      trendAdjustment: null,
      projectedStat: null,
      statStdDev: null
    };


    const unsupportedProbabilityEV = {
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null,
      reliability: null,
      rawProbOver: null
    };


    const unsupportedDecisionTrend = {
      bestSide: "No Play",
      bestEV: null,
      bestModelProbability: null,
      bestPriceEdge: null,
      trendScore: null,
      trendStrength: null,
      modelConfidence: null
    };


    const unsupportedSportacularScoring = {
      finalBestSide: "No Play",
      riskScore: null,
      riskTier: null,
      sportacularScore: null,
      sportacularEdge: null,
      confidenceTier: null
    };


    return buildNFLUniversalPlayerPropRow_({
      providerRow,
      identity,
      historicalContext:
        unsupportedHistoricalContext,
      probabilityEV:
        unsupportedProbabilityEV,
      decisionTrend:
        unsupportedDecisionTrend,
      sportacularScoring:
        unsupportedSportacularScoring
    });
  }


  // --------------------------------------------------------------------------
  // Q:T — HISTORICAL / PROJECTION
  // --------------------------------------------------------------------------

  const historicalContext =
    buildNFLUniversalHistoricalContextFromIndexes_({
      playerId,

      propType:
        providerRow.propType,

      seasonStatIndex,
      baselineIndex,
      trendIndex,
      currentLogIndex,
      historicalLogIndex
    });


  const currentGames =
    getNullableNFLNumericField_(
      seasonStatIndex[
        playerId
      ] || null,
      "Games Played"
    );


  // --------------------------------------------------------------------------
  // U:X — PROBABILITY / EV
  // --------------------------------------------------------------------------

  const probabilityEV =
    buildNFLUniversalPropProbabilityEV_({
      propType:
        providerRow.propType,

      marketType:
        providerRow.type,

      projectedStat:
        historicalContext.projectedStat,

      statStdDev:
        historicalContext.statStdDev,

      lineValue:
        providerRow.lineValue,

      currentGames,

      overOdds:
        providerRow.overOdds,

      underOdds:
        providerRow.underOdds
    });


  // --------------------------------------------------------------------------
  // PRE-P15 DECISION DATA
  //
  // Gives us:
  //   candidate best side
  //   Z Best EV
  //   AA Best Model Probability
  //   AB NFL vig-free Best Price Edge
  //   AC Trend Score
  //   AD Trend Strength
  //   AG Model Confidence
  // --------------------------------------------------------------------------

  const decisionTrend =
    buildNFLUniversalDecisionTrendFields_({
      playerId,

      propType:
        providerRow.propType,

      modelProbOver:
        probabilityEV.modelProbOver,

      modelProbUnder:
        probabilityEV.modelProbUnder,

      evOver:
        probabilityEV.evOver,

      evUnder:
        probabilityEV.evUnder,

      overOdds:
        providerRow.overOdds,

      underOdds:
        providerRow.underOdds,

      trendIndex
    });


  // --------------------------------------------------------------------------
  // P15 UNIVERSAL SPORTACULAR SCORING
  // --------------------------------------------------------------------------

  const sportacularScoring =
    buildUniversalSportacularScoring_({

      // I
      lineValue:
        providerRow.lineValue,

      // S
      projectedStat:
        historicalContext.projectedStat,

      // T
      statStdDev:
        historicalContext.statStdDev,

      // W
      evOver:
        probabilityEV.evOver,

      // X
      evUnder:
        probabilityEV.evUnder,

      // AA
      bestModelProbability:
        decisionTrend.bestModelProbability,

      // AB
      bestPriceEdge:
        decisionTrend.bestPriceEdge,

      // AC
      trendScore:
        decisionTrend.trendScore,

      // AG
      modelConfidence:
        decisionTrend.modelConfidence
    });


  // --------------------------------------------------------------------------
  // FINAL A:AJ
  // --------------------------------------------------------------------------

  return buildNFLUniversalPlayerPropRow_({
    providerRow,
    identity,
    historicalContext,
    probabilityEV,
    decisionTrend,
    sportacularScoring
  });
}

