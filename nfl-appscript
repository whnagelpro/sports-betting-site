/**
 * ============================================================================
 * D10AB — NFL PRODUCTION-STYLE PROBABILITY CALIBRATION
 * ============================================================================
 *
 * Regression test for an extreme but realistic NFL player-prop scenario.
 *
 * Goal:
 *   - raw probability may become extremely confident
 *   - early-sample reliability must pull that probability toward 50%
 *   - calibrated probabilities must remain complementary
 *   - EV must use the calibrated probabilities
 *
 * This test does NOT change production behavior.
 * ============================================================================
 */
function testNFLProductionStyleProbabilityCalibration_D10AB() {

  const input = {
    propType: "receiving_yards",
    marketType: "over_under",

    // Intentionally extreme production-style example.
    projectedStat: 32,
    statStdDev: 12,
    lineValue: 59.5,

    // Early-season NFL sample.
    currentGames: 2,

    overOdds: -110,
    underOdds: -110
  };


  const result =
    buildNFLUniversalPropProbabilityEV_(input);


  const tests = [];


  function addTest(
    name,
    pass,
    diagnostics
  ) {
    const test = {
      name,
      pass: pass === true
    };

    if (
      diagnostics &&
      typeof diagnostics === "object"
    ) {
      Object.assign(
        test,
        diagnostics
      );
    }

    tests.push(test);

    Logger.log(
      JSON.stringify(test)
    );
  }


  // --------------------------------------------------------------------------
  // 1. Production builder returned calibrated probabilities.
  // --------------------------------------------------------------------------

  addTest(
    "Calibrated probabilities exist",
    result.modelProbOver !== null &&
    result.modelProbUnder !== null,
    {
      modelProbOver:
        result.modelProbOver,
      modelProbUnder:
        result.modelProbUnder
    }
  );


  // --------------------------------------------------------------------------
  // 2. Reliability exists and remains bounded.
  // --------------------------------------------------------------------------

  addTest(
    "Probability reliability exists and is bounded",
    result.reliability !== null &&
    Number.isFinite(
      Number(result.reliability)
    ) &&
    result.reliability >= 0 &&
    result.reliability <= 1,
    {
      reliability:
        result.reliability
    }
  );


  // --------------------------------------------------------------------------
  // 3. Raw probability is intentionally extreme.
  // --------------------------------------------------------------------------

  const rawUnder =
    result.rawProbOver === null
      ? null
      : 1 -
        result.rawProbOver;


  addTest(
    "Raw Under probability is extreme",
    rawUnder !== null &&
    rawUnder > 0.95,
    {
      rawProbOver:
        result.rawProbOver,
      rawProbUnder:
        rawUnder
    }
  );


  // --------------------------------------------------------------------------
  // 4. Calibration must reduce that extreme certainty.
  // --------------------------------------------------------------------------

  addTest(
    "Calibration reduces extreme Under probability",
    rawUnder !== null &&
    result.modelProbUnder !== null &&
    result.modelProbUnder <
      rawUnder &&
    result.modelProbUnder >
      0.5,
    {
      rawUnder,
      calibratedUnder:
        result.modelProbUnder
    }
  );


  // --------------------------------------------------------------------------
  // 5. Probabilities remain complementary.
  // --------------------------------------------------------------------------

  const probabilityTotal =
    (
      result.modelProbOver !== null &&
      result.modelProbUnder !== null
    )
      ? result.modelProbOver +
        result.modelProbUnder
      : null;


  addTest(
    "Calibrated probabilities still sum to 1",
    probabilityTotal !== null &&
    Math.abs(
      probabilityTotal - 1
    ) <= 1e-10,
    {
      modelProbOver:
        result.modelProbOver,
      modelProbUnder:
        result.modelProbUnder,
      total:
        probabilityTotal
    }
  );


  // --------------------------------------------------------------------------
  // 6. EV exists and therefore uses the calibrated probability path.
  // --------------------------------------------------------------------------

  addTest(
    "Calibrated EV values exist",
    result.evOver !== null &&
    result.evUnder !== null &&
    Number.isFinite(
      Number(result.evOver)
    ) &&
    Number.isFinite(
      Number(result.evUnder)
    ),
    {
      evOver:
        result.evOver,
      evUnder:
        result.evUnder
    }
  );


  // --------------------------------------------------------------------------
  // 7. Verify the expected two-game reliability contract.
  //
  // reliability =
  //   MIN(1, 0.60 + 0.05 * 2)
  //   = 0.70
  // --------------------------------------------------------------------------

  addTest(
    "Two-game reliability remains 0.70",
    result.reliability !== null &&
    Math.abs(
      result.reliability -
      0.70
    ) <= 1e-10,
    {
      expectedReliability:
        0.70,
      actualReliability:
        result.reliability
    }
  );


  const pass =
    tests.every(
      test =>
        test.pass === true
    );


  const output = {
    test:
      "D10AB NFL PRODUCTION-STYLE PROBABILITY CALIBRATION",

    input,

    raw: {
      overProbability:
        result.rawProbOver,

      underProbability:
        rawUnder
    },

    calibrated: {
      modelProbOver:
        result.modelProbOver,

      modelProbUnder:
        result.modelProbUnder,

      evOver:
        result.evOver,

      evUnder:
        result.evUnder,

      reliability:
        result.reliability
    },

    tests:
      tests.length,

    passed:
      tests.filter(
        test =>
          test.pass === true
      ).length,

    pass,

    results:
      tests
  };


  Logger.log(
    JSON.stringify(
      output,
      null,
      2
    )
  );


  if (!pass) {
    throw new Error(
      "D10AB NFL production-style probability calibration regression failed."
    );
  }


  return true;
}

