 * @param {string} conference Filter by conference (East/West)
 * @param {string} division Filter by division
 * @returns {Array} NBA teams data
 * @customfunction
 */
function BDL_NBA_TEAMS(conference, division) {
  const params = {};
  if (conference) params.conference = conference;
  if (division) params.division = division;
  const response = fetchApi_('/nba/v1/teams', params);
  return toSheet_(response.data);
}

/**
 * Get a specific NBA team by ID
 * @param {number} teamId The team ID
 * @returns {Array} Team data
 * @customfunction
 */
function BDL_NBA_TEAM(teamId) {
  if (!teamId) throw new Error('Team ID is required');
  const response = fetchApi_(`/nba/v1/teams/${teamId}`);
  return toSheet_([response.data]);
}

