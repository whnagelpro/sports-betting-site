function refreshNFLTeamGameLogsForDateRange_(startDate, endDate) {
  ensureNFLTrendTabs_();

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("NFL Team Game Logs");

  const headers = [
    "Game Date",
    "Game ID",
    "Team",
    "Opponent",
    "Points For",
    "Points Allowed",
    "Passing Yards",
    "Rushing Yards",
    "Turnovers",
    "Sacks"
  ];

  Logger.log(
    `Refreshing NFL Team Game Logs from ${startDate} to ${endDate}`
  );

  const games =
    getNFLCompletedGamesForDateRange_(
      startDate,
      endDate
    );

  Logger.log(
    `Completed NFL games found: ${games.length}`
  );

  if (games.length > 0) {
    Logger.log(
      JSON.stringify(
        games[0],
        null,
        2
      )
    );
  }

  if (!games.length) {

    Logger.log(
      `No completed NFL regular-season games found from ${startDate} to ${endDate}`
    );

    // Remove only rows belonging to this requested date range.
    // Preserve successful game-log data from every other month.
    upsertNFLRowsByKeyForDateRange_(
      sheet,
      headers,
      [],
      [1, 2],
      startDate,
      endDate
    );

    return;
  }

  const gameIds = games.map(game => String(game.id));

  const statRows = fetchAllNFLStatsForGameIds_(gameIds);
  Logger.log(`Team stat rows: ${statRows.length}`);

  if (statRows.length) {
    Logger.log(JSON.stringify(statRows[0], null, 2));
  }
  const rows = [];

  games.forEach(game => {
    const gameStats = statRows.filter(stat =>
      String(stat.game_id || (stat.game && stat.game.id) || "") === String(game.id)
    );

    const buildTeamRow = (teamName, opponentName) => {

      const teamStats = gameStats.filter(s => {
        const statTeam =
          getNFLTeamName_(s.team || {}) ||
          s.team_name ||
          "";

        return statTeam === teamName;
      });

      const sum = keys =>
        teamStats.reduce((total, stat) => {
          return total + getNFLStatNumber_(stat, keys);
        }, 0);

      const isHome =
        teamName ===
        getNFLHomeTeamNameFromGame_(game);

      const pointsFor = isHome
        ? Number(game.home_team_score || game.home_score || 0)
        : Number(game.visitor_team_score || game.away_team_score || 0);

      const pointsAllowed = isHome
        ? Number(game.visitor_team_score || game.away_team_score || 0)
        : Number(game.home_team_score || game.home_score || 0);

      return [

        getNFLGameAZDate_(game),

        game.id,

        teamName,

        opponentName,

        pointsFor,

        pointsAllowed,

        sum([
          "passing_yards",
          "pass_yards",
          "passing.yds",
          "passing.yards"
        ]),

        sum([
          "rushing_yards",
          "rush_yards",
          "rushing.yds",
          "rushing.yards"
        ]),

        sum([
          "turnovers",
          "fumbles_lost",
          "interceptions"
        ]),

        sum([
          "sacks",
          "defensive_sacks"
        ])

      ];

    };

    const homeTeam =
      getNFLHomeTeamNameFromGame_(game);

    const awayTeam =
      getNFLAwayTeamNameFromGame_(game);

    rows.push(
      buildTeamRow(
        awayTeam,
        homeTeam
      )
    );

    rows.push(
      buildTeamRow(
        homeTeam,
        awayTeam
      )
    );
  });

  upsertNFLRowsByKeyForDateRange_(sheet, headers, rows, [1, 2], startDate, endDate);

  Logger.log(`Upserted ${rows.length} NFL team game-log rows.`);
}

