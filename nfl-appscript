function removeLegacyNFLAnalyticsTriggers() {

  const KEEP_HANDLERS = new Set([
    "refreshNFLScheduleSheet",
    "refreshNFLRostersSheet",
    "refreshNFLGameOddsSheet",
    "refreshNFLPlayerPropsSheet"
  ]);

  const triggers = ScriptApp.getProjectTriggers();

