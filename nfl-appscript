function fetchAllNFLStatsForGameIds_(gameIds) {
  const allStats = [];

  gameIds.forEach((gameId, index) => {
    Logger.log(`Fetching NFL stats for game ${index + 1}/${gameIds.length}: ${gameId}`);

    let cursor = null;

    do {
      const params = {
        "game_ids[]": gameId,
        "seasons[]": 2026,
        season_type: 1,
        per_page: 100
      };
      if (cursor) params.cursor = cursor;

      const response = fetchApi_("/nfl/v1/stats", params);
      Logger.log("Stats response for game " + gameId);
      Logger.log(JSON.stringify(response, null, 2));
      const stats = Array.isArray(response.data) ? response.data : [];

      allStats.push(...stats);

      cursor = response.meta && response.meta.next_cursor
        ? response.meta.next_cursor
        : null;

    } while (cursor);

    Utilities.sleep(150);
  });

  return allStats;
}

function getNFLStatNumber_(row, keys) {
  const flat = flattenObject_(row);

  for (let i = 0; i < keys.length; i++) {
    const key = keys[i];

    if (row[key] !== undefined && row[key] !== null && row[key] !== "") {
      const num = Number(row[key]);
      if (!isNaN(num)) return num;
    }

    if (flat[key] !== undefined && flat[key] !== null && flat[key] !== "") {
      const num = Number(flat[key]);
      if (!isNaN(num)) return num;
    }
  }

  return 0;
}

function getNFLPlayerNameFromStat_(stat) {
  const player = stat.player || {};

  return (
    player.full_name ||
    `${player.first_name || ""} ${player.last_name || ""}`.trim() ||
    stat.player_name ||
    ""
  );
}

function upsertNFLRowsByKeyForDateRange_(sheet, headers, newRows, keyColumnIndexes, startDate, endDate) {
  const existingValues = sheet.getDataRange().getValues();
  const existingRows = existingValues.length > 1 ? existingValues.slice(1) : [];
  const rowMap = {};

  existingRows.forEach(row => {
    const rowDate = normalizeNFLSheetDateForCompare_(row[0]);

    if (rowDate >= startDate && rowDate <= endDate) return;

    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  newRows.forEach(row => {
    const key = keyColumnIndexes.map(index => String(row[index] || "")).join("|");
    if (key.trim()) rowMap[key] = row;
  });

  const finalRows = Object.values(rowMap).sort((a, b) =>
    new Date(b[0]).getTime() - new Date(a[0]).getTime()
  );

  writeNFLOutputSheet_(sheet, headers, finalRows);
}

function normalizeNFLSheetDateForCompare_(value) {
  if (!value) return "";

  if (Object.prototype.toString.call(value) === "[object Date]") {
    return Utilities.formatDate(value, SPORTACULAR_TIMEZONE, "yyyy-MM-dd");
  }

  const text = String(value).trim();

  if (/^\d{4}-\d{2}-\d{2}$/.test(text)) return text;

  const parsed = new Date(text);

  if (!isNaN(parsed.getTime())) {
    return Utilities.formatDate(parsed, SPORTACULAR_TIMEZONE, "yyyy-MM-dd");
  }

  return text;
}

function refreshNFLPlayerGameLogsForDateRange_(startDate, endDate) {
  ensureNFLTrendTabs_();

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName(
      "NFL Player Game Logs"
    );

  const headers = [
    "Game Date",
    "Game ID",
    "Player ID",
    "Player Name",
    "Team",
    "Opponent",
    "Passing Yards",
    "Passing TDs",
    "Interceptions",
    "Completions",
    "Pass Attempts",
    "Rushing Yards",
    "Rushing Attempts",
    "Rushing TDs",
    "Receptions",
    "Receiving Yards",
    "Receiving TDs"
  ];

  Logger.log(
    `Refreshing NFL Player Game Logs from ${startDate} to ${endDate}`
  );

  const games =
    getNFLCompletedGamesForDateRange_(
      startDate,
      endDate
    );

  Logger.log(
    `Completed NFL games found: ${games.length}`
  );

  if (games.length > 0) {

    Logger.log(
      JSON.stringify(
        games[0],
        null,
        2
      )
    );

  }

  if (!games.length) {

    Logger.log(
      `No completed NFL games found from ${startDate} to ${endDate}`
    );

    return;
  }

  const gameMap = {};

  const gameIds =
    games
      .map(game => {

        const gameId =
          String(
            game.id || ""
          );

        gameMap[gameId] = {

          date:
            getNFLGameAZDate_(game),

          homeTeam:
            getNFLHomeTeamNameFromGame_(
              game
            ),

          awayTeam:
            getNFLAwayTeamNameFromGame_(
              game
            )

        };

        return gameId;

      })
      .filter(Boolean);

  const statRows = fetchAllNFLStatsForGameIds_(gameIds);
  const rows = [];

  statRows.forEach(stat => {
    const gameId = String(stat.game_id || (stat.game && stat.game.id) || "");
    const gameInfo = gameMap[gameId] || {};

    const playerId = stat.player_id || (stat.player && stat.player.id) || "";
    const playerName = getNFLPlayerNameFromStat_(stat);

    const team = stat.team || {};
    const teamName = getNFLTeamName_(team) || stat.team_name || "";

    const opponent =
      teamName === gameInfo.homeTeam
        ? gameInfo.awayTeam
        : teamName === gameInfo.awayTeam
          ? gameInfo.homeTeam
          : "";

    const passingYards = getNFLStatNumber_(stat, ["passing_yards", "pass_yards", "passing.yds", "passing.yards"]);
    const passingTDs = getNFLStatNumber_(stat, ["passing_touchdowns", "passing_tds", "pass_tds", "passing.td"]);
    const interceptions = getNFLStatNumber_(stat, ["interceptions", "passing_interceptions", "passing.int"]);
    const completions = getNFLStatNumber_(stat, ["completions", "passing_completions", "passing.cmp"]);
    const passAttempts = getNFLStatNumber_(stat, ["pass_attempts", "passing_attempts", "passing.att"]);

    const rushingYards = getNFLStatNumber_(stat, ["rushing_yards", "rush_yards", "rushing.yds", "rushing.yards"]);
    const rushingAttempts = getNFLStatNumber_(stat, ["rushing_attempts", "rush_attempts", "rushing.att"]);
    const rushingTDs = getNFLStatNumber_(stat, ["rushing_touchdowns", "rushing_tds", "rush_tds", "rushing.td"]);

    const receptions = getNFLStatNumber_(stat, ["receptions", "receiving_receptions", "receiving.rec"]);
    const receivingYards = getNFLStatNumber_(stat, ["receiving_yards", "rec_yards", "receiving.yds", "receiving.yards"]);
    const receivingTDs = getNFLStatNumber_(stat, ["receiving_touchdowns", "receiving_tds", "rec_tds", "receiving.td"]);

    if (!playerId && !playerName) return;

    const played =
      passingYards > 0 || passingTDs > 0 || interceptions > 0 || completions > 0 || passAttempts > 0 ||
      rushingYards > 0 || rushingAttempts > 0 || rushingTDs > 0 ||
      receptions > 0 || receivingYards > 0 || receivingTDs > 0;

    if (!played) return;

    rows.push([
      gameInfo.date,
      gameId,
      playerId,
      playerName,
      teamName,
      opponent,
      passingYards,
      passingTDs,
      interceptions,
      completions,
      passAttempts,
      rushingYards,
      rushingAttempts,
      rushingTDs,
      receptions,
      receivingYards,
      receivingTDs
    ]);
  });

  upsertNFLRowsByKeyForDateRange_(sheet, headers, rows, [1, 2], startDate, endDate);

  Logger.log(`Upserted ${rows.length} NFL player game-log rows.`);
}

function refreshNFLTeamGameLogsForDateRange_(startDate, endDate) {
  ensureNFLTrendTabs_();

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("NFL Team Game Logs");
  const scheduleSheet = ss.getSheetByName("Schedule");

  const headers = [
    "Game Date",
    "Game ID",
    "Team",
    "Opponent",
    "Points For",
    "Points Allowed",
    "Passing Yards",
    "Rushing Yards",
    "Turnovers",
    "Sacks"
  ];

  const allGames = getNFLGamesFromScheduleSheet_(scheduleSheet);

  Logger.log("Schedule games found: " + allGames.length);

  if (allGames.length > 0) {
    Logger.log(JSON.stringify(allGames[0], null, 2));
  }

  const games = allGames.filter(game => {
    const gameDate = game.game_date;

    Logger.log(
      `Comparing "${gameDate}" against ${startDate} -> ${endDate}`
    );

    return String(gameDate) >= startDate &&
          String(gameDate) <= endDate;
  });

  if (!games.length) {
    Logger.log(`No NFL Schedule games found from ${startDate} to ${endDate}`);
    return;
  }

  const gameIds = games.map(game => game.id);

  const statRows = fetchAllNFLStatsForGameIds_(gameIds);
  Logger.log(`Team stat rows: ${statRows.length}`);

  if (statRows.length) {
    Logger.log(JSON.stringify(statRows[0], null, 2));
  }
  const rows = [];

  games.forEach(game => {
    const gameStats = statRows.filter(stat =>
      String(stat.game_id || (stat.game && stat.game.id) || "") === String(game.id)
    );

    const buildTeamRow = (teamName, opponentName) => {

      const teamStats = gameStats.filter(s => {
        const statTeam =
          getNFLTeamName_(s.team || {}) ||
          s.team_name ||
          "";

        return statTeam === teamName;
      });

      const sum = keys =>
        teamStats.reduce((total, stat) => {
          return total + getNFLStatNumber_(stat, keys);
        }, 0);

      const isHome =
        teamName === game.home_team;

      const pointsFor = isHome
        ? Number(game.home_team_score || game.home_score || 0)
        : Number(game.visitor_team_score || game.away_team_score || 0);

      const pointsAllowed = isHome
        ? Number(game.visitor_team_score || game.away_team_score || 0)
        : Number(game.home_team_score || game.home_score || 0);

      return [

        game.game_date,

        game.id,

        teamName,

        opponentName,

        pointsFor,

        pointsAllowed,

        sum([
          "passing_yards",
          "pass_yards",
          "passing.yds",
          "passing.yards"
        ]),

        sum([
          "rushing_yards",
          "rush_yards",
          "rushing.yds",
          "rushing.yards"
        ]),

        sum([
          "turnovers",
          "fumbles_lost",
          "interceptions"
        ]),

        sum([
          "sacks",
          "defensive_sacks"
        ])

      ];

    };

    rows.push(buildTeamRow(game.away_team, game.home_team));
    rows.push(buildTeamRow(game.home_team, game.away_team));
  });

  upsertNFLRowsByKeyForDateRange_(sheet, headers, rows, [1, 2], startDate, endDate);

  Logger.log(`Upserted ${rows.length} NFL team game-log rows.`);
}

