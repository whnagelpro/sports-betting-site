      projectedStat: 72,
      statStdDev: 18,
      lineValue: 69.5,
      currentGames: 8
    },
    {
      name: "0-game passing yards",
      propType: "passing_yards",
      projectedStat: 245,
      statStdDev: 45,
      lineValue: 229.5,
      currentGames: 0
    }
  ];

  const results = cases.map(testCase => {

    const actual =
      buildNFLUniversalPropProbabilityEV_({
        propType: testCase.propType,
        marketType: "over_under",
        projectedStat: testCase.projectedStat,
        statStdDev: testCase.statStdDev,
        lineValue: testCase.lineValue,
        currentGames: testCase.currentGames,
        overOdds: -110,
        underOdds: -110
      });

    const z =
      (
        testCase.lineValue -
        testCase.projectedStat
      ) /
      testCase.statStdDev;

    const rawOver =
      1 - normalCDF_D10X_(z);

    const reliability =
      Math.min(
        1,
        0.60 +
        0.05 * testCase.currentGames
      );

    const calibratedOver =
      0.5 +
      (rawOver - 0.5) *
      reliability;

    const expectedOver =
      Math.min(
        0.975,
        Math.max(
          0.025,
          calibratedOver
        )
      );

    const expectedUnder =
      1 - expectedOver;

    const overPass =
      actual.modelProbOver !== null &&
      Math.abs(
        actual.modelProbOver -
        expectedOver
      ) <= 1e-10;

    const underPass =
      actual.modelProbUnder !== null &&
      Math.abs(
        actual.modelProbUnder -
        expectedUnder
      ) <= 1e-10;

    const complementPass =
      actual.modelProbOver !== null &&
      actual.modelProbUnder !== null &&
      Math.abs(
        (
          actual.modelProbOver +
          actual.modelProbUnder
        ) -
        1
      ) <= 1e-10;

    return {
      name: testCase.name,
      currentGames:
        testCase.currentGames,
      reliability,
      expectedOver,
      actualOver:
        actual.modelProbOver,
      expectedUnder,
      actualUnder:
        actual.modelProbUnder,
      overPass,
      underPass,
      complementPass,
      pass:
        overPass &&
        underPass &&
        complementPass
    };
  });

  const pass =
    results.every(
      result =>
        result.pass === true
    );

  Logger.log(
    JSON.stringify(
      {
        test:
          "D10X NFL PROBABILITY CALIBRATION PARITY",
        pass,
        results
      },
      null,
      2
    )
  );

  if (!pass) {
    throw new Error(
      "D10X NFL probability calibration parity regression failed."
    );
  }

  return true;
}


/**
 * Standard normal cumulative distribution function.
 *
 * Test-only helper for D10X.
 * Kept independent from the production probability builder so the
 * regression does not merely call the same production implementation
 * twice.
 */
function normalCDF_D10X_(x) {

  const sign =
    x < 0
      ? -1
      : 1;

  const absX =
    Math.abs(x) /
    Math.sqrt(2);

  const t =
    1 /
    (
      1 +
      0.3275911 * absX
    );

  const a1 = 0.254829592;
  const a2 = -0.284496736;
  const a3 = 1.421413741;
  const a4 = -1.453152027;
  const a5 = 1.061405429;

  const erf =
    sign *
    (
      1 -
      (
        (
          (
            (
              a5 * t +
              a4
            ) * t +
            a3
          ) * t +
          a2
        ) * t +
        a1
      ) *
      t *
      Math.exp(
        -absX * absX
      )
    );

  return (
    1 + erf
  ) / 2;
}

