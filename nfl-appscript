 *   V Model Prob Under
 *   W EV Over
 *   X EV Under
 *
 * Exact reconciliation of the existing NFL production formulas.
 *
 * Probability model:
 *   - Normal distribution
 *   - Sample-size reliability calibration
 *   - 2.5% / 97.5% probability caps
 *
 * Only the already-supported conventional over_under markets are modeled.
 * ============================================================================
 */


const NFL_UNIVERSAL_PROBABILITY_MARKETS = new Set([
  "passing_yards",
  "passing_completions",
  "passing_attempts",
  "rushing_yards",
  "rushing_attempts",
  "receptions",
  "receiving_yards"
]);


/**
 * Standard normal CDF approximation.
 *
 * Replaces Google Sheets NORM.S.DIST(z, TRUE).
 */
function standardNormalCDFNFL_(z) {
  const value =
    Number(z);

  if (!Number.isFinite(value)) {
    return null;
  }


  // Abramowitz-Stegun approximation.
  const sign =
    value < 0
      ? -1
      : 1;

  const x =
    Math.abs(value) /
    Math.sqrt(2);


  const t =
    1 /
    (
      1 +
      0.3275911 * x
    );


  const a1 =
    0.254829592;

  const a2 =
    -0.284496736;

  const a3 =
    1.421413741;

  const a4 =
    -1.453152027;

  const a5 =
    1.061405429;


  const erf =
    sign *
    (
      1 -
      (
        (
          (
            (
              (
                a5 * t +
                a4
              ) * t +
              a3
            ) * t +
            a2
          ) * t +
          a1
        ) *
        t *
        Math.exp(
          -x * x
        )
      )
    );


  return (
    1 + erf
  ) / 2;
}


function americanOddsToDecimalNFL_(
  americanOdds
) {
  if (
    americanOdds === "" ||
    americanOdds === null ||
    americanOdds === undefined
  ) {
    return null;
  }


  const odds =
    Number(
      americanOdds
    );


  if (
    !Number.isFinite(odds) ||
    odds === 0
  ) {
    return null;
  }


  if (odds > 0) {
    return (
      1 +
      odds / 100
    );
  }


  return (
    1 +
    100 / Math.abs(odds)
  );
}


function calculateNFLExpectedValue_(
  winProbability,
  americanOdds
) {
  if (
    winProbability === "" ||
    winProbability === null ||
    winProbability === undefined
  ) {
    return null;
  }


  const probability =
    Number(
      winProbability
    );


  if (
    !Number.isFinite(probability) ||
    probability < 0 ||
    probability > 1
  ) {
    return null;
  }


  const decimalOdds =
    americanOddsToDecimalNFL_(
      americanOdds
    );


  if (decimalOdds === null) {
    return null;
  }


  // Exact equivalent of existing O/P formulas:
  //
  // probability * potential profit
  //   - probability of losing
  return (
    probability *
    (
      decimalOdds - 1
    )
  ) -
  (
    1 - probability
  );
}


function buildNFLUniversalPropProbabilityEV_({
  propType,
  marketType,
  projectedStat,
  statStdDev,
  lineValue,
  currentGames,
  overOdds,
  underOdds
}) {
  const normalizedPropType =
    normalizeNFLUniversalPropType_(
      propType
    );


  const normalizedMarketType =
    String(
      marketType ?? ""
    )
      .trim()
      .toLowerCase();


  // --------------------------------------------------------------------------
  // EXISTING SUPPORT CONTRACT
  // --------------------------------------------------------------------------

  if (
    normalizedMarketType !==
      "over_under" ||
    !NFL_UNIVERSAL_PROBABILITY_MARKETS.has(
      normalizedPropType
    )
  ) {
    return {
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null,
      reliability: null,
      rawProbOver: null
    };
  }


  // --------------------------------------------------------------------------
  // REQUIRED MODEL INPUTS
  // --------------------------------------------------------------------------

  if (
    projectedStat === "" ||
    projectedStat === null ||
    projectedStat === undefined ||
    statStdDev === "" ||
    statStdDev === null ||
    statStdDev === undefined ||
    lineValue === "" ||
    lineValue === null ||
    lineValue === undefined
  ) {
    return {
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null,
      reliability: null,
      rawProbOver: null
    };
  }


  const projection =
    Number(
      projectedStat
    );


  const standardDeviation =
    Number(
      statStdDev
    );


  const line =
    Number(
      lineValue
    );


  if (
    !Number.isFinite(projection) ||
    !Number.isFinite(standardDeviation) ||
    standardDeviation <= 0 ||
    !Number.isFinite(line)
  ) {
    return {
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null,
      reliability: null,
      rawProbOver: null
    };
  }


  // --------------------------------------------------------------------------
  // EXACT TRANSLATION OF EXISTING Q2 FORMULA
  //
  // rawOver =
  //   1 - NORM.S.DIST(
  //         (Line - Projected Stat) / Std Dev,
  //         TRUE
  //       )
  // --------------------------------------------------------------------------

  const zScore =
    (
      line -
      projection
    ) /
    standardDeviation;


  const cdf =
    standardNormalCDFNFL_(
      zScore
    );


  if (cdf === null) {
    return {
      modelProbOver: null,
      modelProbUnder: null,
      evOver: null,
      evUnder: null,
      reliability: null,
      rawProbOver: null
    };
  }


  const rawProbOver =
    1 - cdf;


  // --------------------------------------------------------------------------
  // EXISTING SAMPLE-SIZE RELIABILITY
  //
  // MIN(1, 0.60 + 0.05 * currentGames)
  // --------------------------------------------------------------------------

  const parsedCurrentGames =
    (
      currentGames === "" ||
      currentGames === null ||
      currentGames === undefined ||
      !Number.isFinite(
        Number(currentGames)
      )
    )
      ? 0
      : Math.max(
          0,
          Number(currentGames)
        );


  const reliability =
    Math.min(
      1,
      0.60 +
      0.05 *
      parsedCurrentGames
    );


  // --------------------------------------------------------------------------
  // CALIBRATION TOWARD 50%
  // --------------------------------------------------------------------------

  const calibratedOver =
    0.5 +
    (
      rawProbOver -
      0.5
    ) *
    reliability;


  // Existing production floor/ceiling.
  const modelProbOver =
    Math.min(
      0.975,
      Math.max(
        0.025,
        calibratedOver
      )
    );


  const modelProbUnder =
    1 -
    modelProbOver;


  // --------------------------------------------------------------------------
  // EV
  //
  // Probabilities are model outputs and survive missing prices.
  // EV requires the sportsbook price.
  // --------------------------------------------------------------------------

  const evOver =
    calculateNFLExpectedValue_(
      modelProbOver,
      overOdds
    );


  const evUnder =
    calculateNFLExpectedValue_(
      modelProbUnder,
      underOdds
    );


  return {
    modelProbOver,
    modelProbUnder,
    evOver,
    evUnder,

    // Internal diagnostics only.
    // These are NOT universal schema columns.
    reliability,
    rawProbOver
  };
}

