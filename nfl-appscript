function addDaysToDateString_(dateString, days) {

  const date = new Date(dateString + "T00:00:00");

  date.setDate(date.getDate() + days);

  return Utilities.formatDate(
    date,
    SPORTACULAR_TIMEZONE,
    "yyyy-MM-dd"
  );
}

function getNFLGameAZDate_(game) {
  const rawDate = getNFLGameRawDate_(game);
  if (!rawDate) return "";

  const rawString = String(rawDate);

  if (/^\d{4}-\d{2}-\d{2}$/.test(rawString)) {
    return rawString;
  }

  return Utilities.formatDate(
    new Date(rawDate),
    SPORTACULAR_TIMEZONE,
    "yyyy-MM-dd"
  );
}

function isCompletedNFLGame_(game) {

  const statusState =
    String(
      game.status_state ||
      ""
    ).toLowerCase();

  const status =
    String(
      game.status ||
      game.game_state ||
      ""
    ).toLowerCase();

  return (
    statusState === "final" ||
    status.includes("final") ||
    status.includes("completed") ||
    status === "post" ||
    status === "ft"
  );
}

function getNFLCompletedGamesForDateRange_(
  startDate,
  endDate
) {

  const selectedGamesMap = {};

  const fetchStartDate =
    addDaysToDateString_(
      startDate,
      -1
    );

  const fetchEndDate =
    addDaysToDateString_(
      endDate,
      1
    );

  let current =
    new Date(
      fetchStartDate + "T00:00:00"
    );

  const end =
    new Date(
      fetchEndDate + "T00:00:00"
    );

  while (current <= end) {

    const apiDateString =
      Utilities.formatDate(
        current,
        SPORTACULAR_TIMEZONE,
        "yyyy-MM-dd"
      );

    Logger.log(
      `Checking NFL API games for ${apiDateString}`
    );

    const allGames =
      fetchAllNFLGamesForDate_(apiDateString);

    Logger.log(`Total games before filter: ${allGames.length}`);

    const completedGames =
      allGames.filter(isCompletedNFLGame_);

    Logger.log(`Completed games: ${completedGames.length}`);

    const games =
      completedGames.filter(game => {

          const azDate =
            getNFLGameAZDate_(game);

          return (
            azDate >= startDate &&
            azDate <= endDate
          );

        });

    games.forEach(game => {

      if (game.id) {

        selectedGamesMap[
          String(game.id)
        ] = game;

      }

    });

    current.setDate(
      current.getDate() + 1
    );

    Utilities.sleep(100);
  }

  return Object.values(
    selectedGamesMap
  );
}

