      "games",
      "games_played"
    ]);

    if (
      playerId &&
      gamesPlayed > 0 &&
      !valid2025PlayerIds.has(String(playerId))
    ) {
      selectedRows.push({
        row: row,
        season: 2024
      });
    }
  });

  const now = new Date();

  const rows = selectedRows.map(item => {
    const row = item.row;
    const season = item.season;

    const player = row.player || {};
    const team = row.team || {};

    const playerId =
      row.player_id ||
      player.id ||
      "";

    const playerName =
      player.full_name ||
      `${player.first_name || ""} ${player.last_name || ""}`.trim() ||
      row.player_name ||
      "";

    const teamName =
      getNFLTeamName_(team) ||
      row.team_name ||
      "";

    return [
      playerId,
      playerName,
      teamName,

      getNFLStatNumber_(row, [
        "games",
        "games_played"
      ]),

      getNFLStatNumber_(row, [
        "passing_yards"
      ]),

      getNFLStatNumber_(row, [
        "passing_touchdowns",
        "passing_tds"
      ]),

      getNFLStatNumber_(row, [
        "interceptions"
      ]),

      getNFLStatNumber_(row, [
        "completions",
        "passing_completions"
      ]),

      getNFLStatNumber_(row, [
        "attempts",
        "passing_attempts"
      ]),

      getNFLStatNumber_(row, [
        "rushing_yards"
      ]),

      getNFLStatNumber_(row, [
        "rushing_attempts"
      ]),

      getNFLStatNumber_(row, [
        "rushing_touchdowns",
        "rushing_tds"
      ]),

      getNFLStatNumber_(row, [
        "receptions"
