function refreshNFLPlayerPropsSheet() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName("Player Props");
  const scheduleSheet = ss.getSheetByName("Schedule");

  if (!sheet) throw new Error('Sheet "Player Props" not found.');
  if (!scheduleSheet) throw new Error('Sheet "Schedule" not found.');

  ensureNFLPlayerPropsHeadersAndFormulas_(sheet);

  const games = getNFLGamesFromScheduleSheet_(scheduleSheet);

  if (!games.length) {
    clearNFLPlayerPropsSheet_(sheet);
    Logger.log("No NFL Schedule rows found. Player Props cleared.");
    return;
  }

  const gameMap = {};
  games.forEach(game => {
    gameMap[String(game.id)] = {
      game_date: game.game_date || "",
      away_team: game.away_team || "",
      home_team: game.home_team || ""
    };
  });

  const rows = [];
  const seen = new Set();

  games.forEach((game, index) => {
    Logger.log(`Fetching NFL props for game ${index + 1}/${games.length} ID ${game.id}`);

    const props = fetchAllNFLPlayerPropsForGame_(game.id);
    const gameInfo = gameMap[String(game.id)] || {};

    props.forEach(prop => {
      const propId = String(prop.id || "");
      if (propId && seen.has(propId)) return;
      if (propId) seen.add(propId);

      rows.push([
        game.id,
        gameInfo.game_date,
        gameInfo.away_team,
        gameInfo.home_team,
        prop.id || "",
        prop.player_id || (prop.player && prop.player.id) || "",
        prop.vendor || prop.sportsbook || prop.bookmaker || "",
        prop.prop_type || prop.market || "",
        prop.line || prop.line_value || "",
        (prop.market && prop.market.type) || "",
        (prop.market && prop.market.odds) || "",
        prop.updated_at || "",
        (prop.market && prop.market.over_odds) || prop.over_odds || "",
        (prop.market && prop.market.under_odds) || prop.under_odds || ""
      ]);
    });

    Utilities.sleep(150);
  });

  clearNFLPlayerPropsSheet_(sheet);

  if (rows.length > 0) {
    sheet.getRange(3, 1, rows.length, 14).setValues(rows);
    copyNFLPlayerPropsFormulasDown_(sheet, rows.length);
  }

  Logger.log(`Wrote ${rows.length} NFL player props rows.`);
}

