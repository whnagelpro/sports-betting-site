/**
 * ============================================================================
 * P14 D2 — NFL UNIVERSAL PLAYER PROP HISTORICAL / PROJECTION CONTEXT
 * ============================================================================
 *
 * Builds universal Q:T:
 *
 *   Q Player Baseline
 *   R Trend Adjustment
 *   S Projected Stat
 *   T Stat Std Dev
 *
 * This preserves the EXISTING NFL production model:
 *
 * Baseline:
 *   - Current + prior available:
 *       ((4 * priorAvg) + (currentGames * currentAvg))
 *       / (4 + currentGames)
 *
 *   - Current only:
 *       currentAvg
 *
 *   - Prior only:
 *       priorAvg
 *
 * Trend Adjustment:
 *   - 0.30 * (Last5 - Player Baseline)
 *   - Existing production behavior returns 0 when Last5/current season
 *     context is unavailable.
 *
 * Projected Stat:
 *   - Player Baseline + Trend Adjustment
 *
 * Stat Std Dev:
 *   - Current + historical:
 *       pooled variance using historical pseudo-weight 4
 *   - Current only:
 *       current sample SD
 *   - Historical only:
 *       historical sample SD
 *
 * This is reconciliation only. It does NOT introduce new NFL model math.
 * ============================================================================
 */


const NFL_UNIVERSAL_PROP_STAT_MAP = {
  passing_yards: {
    trendName: "Passing Yards",
    baselineTotalHeader: "Passing Yards",
    gameLogHeader: "Passing Yards"
  },

  passing_tds: {
