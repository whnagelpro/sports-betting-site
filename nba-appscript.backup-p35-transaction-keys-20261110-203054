      modelKey: "steals",
      recentWeight: 0.15,
      brierShrink: 0.15,
      logLossShrink: 0.20
    },
    {
      market: "Blocks",
      key: "blocks",
      modelKey: "blocks",
      recentWeight: 0.10,
      brierShrink: 0.10,
      logLossShrink: 0.10
    },
    {
      market: "Turnovers",
      key: "turnovers",
      modelKey: "turnovers",
      recentWeight: 0.20,
      brierShrink: 0.15,
      logLossShrink: 0.20
    },
    {
      market: "Points + Rebounds",
      key: "pointsRebounds",
      modelKey: "points_rebounds",
      recentWeight: 0.45,
      brierShrink: 0.50,
      logLossShrink: 0.50
    },
    {
      market: "Points + Assists",
      key: "pointsAssists",
      modelKey: "points_assists",
      recentWeight: 0.45,
      brierShrink: 0.05,
      logLossShrink: 0.05
    },
    {
      market: "Rebounds + Assists",
      key: "reboundsAssists",
      modelKey: "rebounds_assists",
      recentWeight: 0.40,
      brierShrink: 0.05,
      logLossShrink: 0.10
    },
    {
      market: "PRA",
      key: "pra",
      modelKey: "points_rebounds_assists",
      recentWeight: 0.50,
      brierShrink: 0.40,
      logLossShrink: 0.40
    },
    {
      market: "Blocks + Steals",
      key: "blocksSteals",
      modelKey: "blocks_steals",
      recentWeight: 0.15,
      brierShrink: 0.15,
      logLossShrink: 0.20
    }
  ];

  const MIN_PRIOR_GAMES = 10;
  const RECENT_GAMES = 5;

  const players = {};

  // --------------------------------------------------------------------------
  // Build histories
  // --------------------------------------------------------------------------

  logs.forEach(row => {
    const playerId =
      String(
        row["Player ID"] || ""
      ).trim();

    if (!playerId) return;

    const date =
      new Date(
        row["Game Date"]
      );

    if (
      Number.isNaN(
        date.getTime()
      )
    ) {
      return;
    }

    const points =
      Number(row["Points"] || 0);

    const rebounds =
      Number(row["Rebounds"] || 0);

    const assists =
      Number(row["Assists"] || 0);

    const steals =
      Number(row["Steals"] || 0);

    const blocks =
      Number(row["Blocks"] || 0);

    if (!players[playerId]) {
      players[playerId] = {
        games: []
      };
    }

    players[playerId].games.push({
      date,

      points,
      rebounds,
      assists,

      threes:
        Number(row["Threes"] || 0),

      steals,
      blocks,

      turnovers:
        Number(row["Turnovers"] || 0),

      pointsRebounds:
        points + rebounds,

      pointsAssists:
        points + assists,

      reboundsAssists:
        rebounds + assists,

      pra:
        points +
        rebounds +
        assists,

      blocksSteals:
        blocks + steals
    });
  });

  Object.values(players)
    .forEach(player => {
      player.games.sort(
        (a, b) =>
          a.date.getTime() -
          b.date.getTime()
      );
    });

  // --------------------------------------------------------------------------
  // Accumulators
  // --------------------------------------------------------------------------

  const results = {};

  markets.forEach(market => {
    results[market.key] = {
      raw:
        createNBACalibrationAccumulator_(),

      brier:
        createNBACalibrationAccumulator_(),

      logLoss:
        createNBACalibrationAccumulator_()
    };
  });

  // --------------------------------------------------------------------------
  // Final 25% holdout
  // --------------------------------------------------------------------------

  Object.values(players)
    .forEach(player => {
      const games =
        player.games;

      if (
        games.length <=
        MIN_PRIOR_GAMES
      ) {
        return;
      }

      const eligibleCount =
        games.length -
        MIN_PRIOR_GAMES;

      const researchCount =
        Math.floor(
          eligibleCount * 0.75
        );

      const holdoutStart =
        MIN_PRIOR_GAMES +
        researchCount;

      if (
        holdoutStart >=
        games.length
      ) {
        return;
      }

      for (
        let targetIndex =
          holdoutStart;

        targetIndex <
          games.length;

        targetIndex++
      ) {
        const priorGames =
          games.slice(
            0,
            targetIndex
          );

        const recentGames =
          priorGames.slice(
            -RECENT_GAMES
          );

        const targetGame =
          games[targetIndex];

        markets.forEach(
          market => {
            const seasonValues =
              priorGames.map(
                game =>
                  Number(
                    game[
                      market.key
                    ] || 0
                  )
              );

            const recentValues =
              recentGames.map(
                game =>
                  Number(
                    game[
                      market.key
                    ] || 0
                  )
              );

            const seasonAverage =
              avgNBA_(
                seasonValues
              );

            const recentAverage =
              avgNBA_(
                recentValues
              );

            const projection =
              seasonAverage *
                (
                  1 -
                  market.recentWeight
                ) +
              recentAverage *
                market.recentWeight;

            const statStdDev =
              stdDevNBA_(
                seasonValues
              );

            const line =
              Math.floor(
                projection
              ) + 0.5;

            const probabilities =
              calculateNBAPropProbabilities_(
                market.modelKey,
                projection,
                statStdDev,
                line
              );

            if (
              probabilities.over === null ||
              probabilities.under === null
            ) {
              return;
            }

            let rawProbability;
            let actualOutcome;

            const actual =
              Number(
                targetGame[
                  market.key
                ] || 0
              );

            if (
              probabilities.over >=
              probabilities.under
            ) {
              rawProbability =
                probabilities.over;

              actualOutcome =
                actual > line
                  ? 1
                  : 0;
            } else {
              rawProbability =
                probabilities.under;

              actualOutcome =
                actual < line
                  ? 1
                  : 0;
            }

            const brierProbability =
              calibrateNBAProbabilityShrink_(
                rawProbability,
                market.brierShrink
              );

            const logLossProbability =
              calibrateNBAProbabilityShrink_(
                rawProbability,
                market.logLossShrink
              );

            addNBACalibrationObservation_(
              results[
                market.key
              ].raw,
              rawProbability,
              actualOutcome
            );

            addNBACalibrationObservation_(
              results[
                market.key
              ].brier,
              brierProbability,
              actualOutcome
            );

            addNBACalibrationObservation_(
              results[
                market.key
              ].logLoss,
              logLossProbability,
              actualOutcome
            );
          }
        );
      }
    });

  // --------------------------------------------------------------------------
  // Build output
  // --------------------------------------------------------------------------

  const rows = [];

  markets.forEach(market => {
    const raw =
      finalizeNBACalibrationAccumulator_(
        results[
          market.key
        ].raw
      );

    const brier =
      finalizeNBACalibrationAccumulator_(
        results[
          market.key
        ].brier
      );

    const logLoss =
      finalizeNBACalibrationAccumulator_(
        results[
          market.key
        ].logLoss
      );

    const brierBrierImprovement =
      raw.brier > 0
        ? (
            raw.brier -
            brier.brier
          ) /
          raw.brier
        : "";

    const brierLogImprovement =
      raw.logLoss > 0
        ? (
            raw.logLoss -
            brier.logLoss
          ) /
          raw.logLoss
        : "";

    const logBrierImprovement =
      raw.brier > 0
        ? (
            raw.brier -
            logLoss.brier
          ) /
          raw.brier
        : "";

    const logLogImprovement =
      raw.logLoss > 0
        ? (
            raw.logLoss -
            logLoss.logLoss
          ) /
          raw.logLoss
        : "";

    rows.push([
      market.market,

      raw.count,

      raw.brier,
      raw.logLoss,

      market.brierShrink,
      brier.brier,
      brier.logLoss,
      brierBrierImprovement,
      brierLogImprovement,

      market.logLossShrink,
      logLoss.brier,
      logLoss.logLoss,
      logBrierImprovement,
      logLogImprovement,

      (
        brier.brier <= raw.brier &&
        brier.logLoss <= raw.logLoss
      )
        ? "PASS"
        : "FAIL",

      (
        logLoss.brier <= raw.brier &&
        logLoss.logLoss <= raw.logLoss
      )
        ? "PASS"
        : "FAIL"
    ]);
  });

  // --------------------------------------------------------------------------
  // Write output
  // --------------------------------------------------------------------------

  const SHEET_NAME =
    "NBA Calibration Holdout";

  let sheet =
    ss.getSheetByName(
      SHEET_NAME
    );

  if (!sheet) {
    sheet =
      ss.insertSheet(
        SHEET_NAME
      );
  } else {
    sheet.clearContents();
  }

  const headers = [
    "Market",
    "Holdout Predictions",

    "Raw Brier",
    "Raw Log Loss",

    "Brier Candidate Shrink",
    "Brier Candidate Brier",
    "Brier Candidate Log Loss",
    "Brier Candidate Brier Improvement",
    "Brier Candidate Log Loss Improvement",

    "Log Loss Candidate Shrink",
    "Log Loss Candidate Brier",
    "Log Loss Candidate Log Loss",
    "Log Loss Candidate Brier Improvement",
    "Log Loss Candidate Log Loss Improvement",

    "Brier Candidate Verdict",
    "Log Loss Candidate Verdict"
  ];

  sheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([headers]);

  sheet
    .getRange(
      2,
      1,
      rows.length,
      headers.length
    )
    .setValues(rows);

  // Shrink columns
  sheet
    .getRange(
      2,
      5,
      rows.length,
      1
    )
    .setNumberFormat("0%");

  sheet
    .getRange(
      2,
      10,
      rows.length,
      1
    )
    .setNumberFormat("0%");

  // Improvement columns
  sheet
    .getRange(
      2,
      8,
      rows.length,
      2
    )
    .setNumberFormat("0.00%");

  sheet
    .getRange(
      2,
      13,
      rows.length,
      2
    )
    .setNumberFormat("0.00%");

  sheet.setFrozenRows(1);

  sheet.autoResizeColumns(
    1,
    headers.length
  );

  Logger.log(
    "NBA calibration holdout validation complete."
  );
}


// ============================================================================
// P6 HOLDOUT HELPERS
// ============================================================================

function createNBACalibrationAccumulator_() {
  return {
    count: 0,
    brierSum: 0,
    logLossSum: 0
  };
}


function addNBACalibrationObservation_(
  accumulator,
  probability,
  actualOutcome
) {
  if (
    probability === null ||
    probability === undefined ||
    !Number.isFinite(
      Number(probability)
    )
  ) {
    return;
  }

  const p =
    Number(probability);

  const y =
    Number(actualOutcome);

  const error =
    p - y;

  accumulator.count++;

  accumulator.brierSum +=
    error * error;

  accumulator.logLossSum +=
    nbaLogLoss_(
      p,
      y
    );
}


function finalizeNBACalibrationAccumulator_(
  accumulator
) {
  if (!accumulator.count) {
    return {
      count: 0,
      brier: null,
      logLoss: null
    };
  }

  return {
    count:
      accumulator.count,

    brier:
      accumulator.brierSum /
      accumulator.count,

    logLoss:
      accumulator.logLossSum /
      accumulator.count
  };
}

function applyNBAPropCalibration_(
  marketKey,
  rawProbability
) {
  if (
    rawProbability === null ||
    rawProbability === undefined ||
    rawProbability === ""
  ) {
    return null;
  }

  const probability =
    Number(rawProbability);

  if (
    !Number.isFinite(probability)
  ) {
    return null;
  }

  const shrink =
    NBA_PROP_CALIBRATION_SHRINK[
      marketKey
    ];

  if (
    shrink === undefined ||
    shrink === null
  ) {
    return null;
  }

  return calibrateNBAProbabilityShrink_(
    probability,
    shrink
  );
}

/**
 * ============================================================================
 * P15 D6 — UNIVERSAL SPORTACULAR PLAYER PROPS SCORING ENGINE
 * ============================================================================
 *
 * Implements the frozen P15 D1-D5 contract.
 *
 * IMPORTANT:
 * - This is currently an isolated/tested helper layer.
 * - It does NOT modify the production Player Props refresh yet.
 * - D7 will connect this contract to NBA/NHL/MLB/NFL production.
 *
 * Universal output ownership:
 *
 * AE = Risk Score
 * AF = Risk Tier
 * AH = Sportacular Score
 * AI = Sportacular Edge
 * AJ = Confidence Tier
 *
 * Y  = final actionable Best Side after eligibility gate
 * ============================================================================
 */


const SPORTACULAR_PLAYER_PROP_SCORING = Object.freeze({

  // --------------------------------------------------------------------------
  // D2 — RISK
  // --------------------------------------------------------------------------

  riskTierLowMax:
    25,

  riskTierMediumMax:
    50,

  riskTierHighMax:
    75,


  // --------------------------------------------------------------------------
  // D3 — SPORTACULAR EDGE
  // --------------------------------------------------------------------------

  priceEdgeNormalizationCeiling:
    0.15,

  evNormalizationCeiling:
    0.25,

  priceEdgeWeight:
    0.75,

  evWeight:
    0.25,


  // --------------------------------------------------------------------------
  // D4 — SPORTACULAR SCORE
  // --------------------------------------------------------------------------

  sportacularEdgeWeight:
    0.55,

  modelConfidenceWeight:
    0.25,

  riskQualityWeight:
    0.15,

  trendWeight:
    0.05,

  trendMultiplier:
    2,


  // --------------------------------------------------------------------------
  // D5 — ACTIONABLE ELIGIBILITY
  // --------------------------------------------------------------------------

  minimumBestEV:
    0.05,

  minimumBestModelProbability:
    0.52,

  minimumBestPriceEdge:
    0.03,

  minimumModelConfidence:
    50,

  minimumSportacularScore:
    55,

  evTieTolerance:
    1e-12
});


/**
 * ---------------------------------------------------------------------------
 * UNIVERSAL NULLABLE NUMBER
 * ---------------------------------------------------------------------------
 *
 * Preserves the frozen null-integrity rule:
 *
 *   missing != 0
 *
 * Legitimate zero remains zero.
 */
function getUniversalNullableNumber_(value) {

  if (
    value === "" ||
    value === null ||
    value === undefined
  ) {
    return null;
  }


  const number =
    Number(value);


  return Number.isFinite(number)
    ? number
    : null;
}


/**
 * ---------------------------------------------------------------------------
 * UNIVERSAL CLAMP
 * ---------------------------------------------------------------------------
 */
function clampUniversalScore_(
  value,
  minimum,
  maximum
) {

  return Math.min(
    maximum,
    Math.max(
      minimum,
      value
    )
  );
}


/**
 * ============================================================================
 * D2 — UNIVERSAL RISK SCORE
 * ============================================================================
 *
 * Risk Score =
 *
 *   100 * Std Dev
 *   ------------------------------
 *   MAX(|Projection|, |Line|, 1)
 *
 * Higher = riskier.
 */
function calculateUniversalRisk_({
  projectedStat,
  lineValue,
  statStdDev
}) {

  const sd =
    getUniversalNullableNumber_(
      statStdDev
    );


  if (
    sd === null ||
    sd < 0
  ) {
    return {
      riskScore: null,
      riskTier: null
    };
  }


  const projection =
    getUniversalNullableNumber_(
      projectedStat
    );


  const line =
    getUniversalNullableNumber_(
      lineValue
    );


  const magnitudes =
    [1];


  if (
    projection !== null
  ) {
    magnitudes.push(
      Math.abs(
        projection
      )
    );
  }


  if (
    line !== null
  ) {
    magnitudes.push(
      Math.abs(
        line
      )
    );
  }


  const scale =
    Math.max(
      ...magnitudes
    );


  const riskScore =
    clampUniversalScore_(
      (
        sd /
        scale
      ) *
      100,
      0,
      100
    );


  let riskTier;


  if (
    riskScore <
    SPORTACULAR_PLAYER_PROP_SCORING
      .riskTierLowMax
  ) {

    riskTier =
      "Low";

  } else if (
    riskScore <
    SPORTACULAR_PLAYER_PROP_SCORING
      .riskTierMediumMax
  ) {

    riskTier =
      "Medium";

  } else if (
    riskScore <
    SPORTACULAR_PLAYER_PROP_SCORING
      .riskTierHighMax
  ) {

    riskTier =
      "High";

  } else {

    riskTier =
      "Very High";
  }


  return {
    riskScore,
    riskTier
  };
}


/**
 * ============================================================================
 * D3 — UNIVERSAL SPORTACULAR EDGE
 * ============================================================================
 *
 * Price Edge Score =
 *   CLAMP(AB / 0.15 * 100)
 *
 * EV Score =
 *   CLAMP(Z / 0.25 * 100)
 *
 * Sportacular Edge =
 *   75% Price Edge Score
 *   25% EV Score
 */
function calculateUniversalSportacularEdge_({
  bestEV,
  bestPriceEdge
}) {

  const ev =
    getUniversalNullableNumber_(
      bestEV
    );


  const priceEdge =
    getUniversalNullableNumber_(
      bestPriceEdge
    );


  if (
    ev === null ||
    priceEdge === null
  ) {
    return null;
  }


  const priceEdgeScore =
    clampUniversalScore_(
      (
        priceEdge /
        SPORTACULAR_PLAYER_PROP_SCORING
          .priceEdgeNormalizationCeiling
      ) *
      100,
      0,
      100
    );


  const evScore =
    clampUniversalScore_(
      (
        ev /
        SPORTACULAR_PLAYER_PROP_SCORING
          .evNormalizationCeiling
      ) *
      100,
      0,
      100
    );


  return clampUniversalScore_(
    (
      SPORTACULAR_PLAYER_PROP_SCORING
        .priceEdgeWeight *
      priceEdgeScore
    ) +
    (
      SPORTACULAR_PLAYER_PROP_SCORING
        .evWeight *
      evScore
    ),
    0,
    100
  );
}


/**
 * ============================================================================
 * D4 — SIDE-ALIGNED TREND SUPPORT
 * ============================================================================
 */
function calculateUniversalTrendSupport_({
  candidateSide,
  trendScore
}) {

  if (
    candidateSide !== "Over" &&
    candidateSide !== "Under"
  ) {
    return null;
  }


  const trend =
    getUniversalNullableNumber_(
      trendScore
    );


  if (
    trend === null
  ) {
    return null;
  }


  const alignedTrend =
    candidateSide === "Over"
      ? trend
      : -trend;


  return clampUniversalScore_(
    50 +
    (
      SPORTACULAR_PLAYER_PROP_SCORING
        .trendMultiplier *
      alignedTrend
    ),
    0,
    100
  );
}


/**
 * ============================================================================
 * D4 — UNIVERSAL SPORTACULAR SCORE
 * ============================================================================
 *
 * Mandatory:
 *   Sportacular Edge
 *   Model Confidence
 *   Risk Score
 *
 * Optional:
 *   Trend Score
 *
 * If trend is missing, its 5% weight is removed and the remaining
 * 95% is renormalized.
 */
function calculateUniversalSportacularScore_({
  candidateSide,
  sportacularEdge,
  modelConfidence,
  riskScore,
  trendScore
}) {

  if (
    candidateSide !== "Over" &&
    candidateSide !== "Under"
  ) {
    return null;
  }


  const edge =
    getUniversalNullableNumber_(
      sportacularEdge
    );


  const confidence =
    getUniversalNullableNumber_(
      modelConfidence
    );


  const risk =
    getUniversalNullableNumber_(
      riskScore
    );


  if (
    edge === null ||
    confidence === null ||
    risk === null
  ) {
    return null;
  }


  const boundedEdge =
    clampUniversalScore_(
      edge,
      0,
      100
    );


  const boundedConfidence =
    clampUniversalScore_(
      confidence,
      0,
      100
    );


  const boundedRisk =
    clampUniversalScore_(
      risk,
      0,
      100
    );


  const riskQuality =
    100 -
    boundedRisk;


  let weightedTotal =
    (
      SPORTACULAR_PLAYER_PROP_SCORING
        .sportacularEdgeWeight *
      boundedEdge
    ) +
    (
      SPORTACULAR_PLAYER_PROP_SCORING
        .modelConfidenceWeight *
      boundedConfidence
    ) +
    (
      SPORTACULAR_PLAYER_PROP_SCORING
        .riskQualityWeight *
      riskQuality
    );


  let totalWeight =
    (
      SPORTACULAR_PLAYER_PROP_SCORING
        .sportacularEdgeWeight +
      SPORTACULAR_PLAYER_PROP_SCORING
        .modelConfidenceWeight +
      SPORTACULAR_PLAYER_PROP_SCORING
        .riskQualityWeight
    );


  const trendSupport =
    calculateUniversalTrendSupport_({
      candidateSide,
      trendScore
    });


  if (
    trendSupport !== null
  ) {

    weightedTotal +=
      SPORTACULAR_PLAYER_PROP_SCORING
        .trendWeight *
      trendSupport;


    totalWeight +=
      SPORTACULAR_PLAYER_PROP_SCORING
        .trendWeight;
  }


  if (
    totalWeight <= 0
  ) {
    return null;
  }


  return clampUniversalScore_(
    weightedTotal /
    totalWeight,
    0,
    100
  );
}


/**
 * ============================================================================
 * D5 — CANDIDATE SIDE
 * ============================================================================
 *
 * Candidate side is intentionally separate from final Y Best Side.
 *
 * This lets AH be calculated before the final eligibility gate without
 * creating a circular dependency.
 */
function selectUniversalCandidateSide_({
  evOver,
  evUnder
}) {

  const over =
    getUniversalNullableNumber_(
      evOver
    );


  const under =
    getUniversalNullableNumber_(
      evUnder
    );


  if (
    over === null &&
    under === null
  ) {
    return null;
  }


  if (
    over !== null &&
    under !== null
  ) {

    if (
      Math.abs(
        over -
        under
      ) <=
      SPORTACULAR_PLAYER_PROP_SCORING
        .evTieTolerance
    ) {
      return null;
    }


    return over > under
      ? "Over"
      : "Under";
  }


  return over !== null
    ? "Over"
    : "Under";
}


/**
 * ============================================================================
 * D5 — CONFIDENCE TIER
 * ============================================================================
 *
 * This helper is called only after the mandatory data gate can be evaluated.
 */
function getUniversalConfidenceTier_(
  sportacularScore
) {

  const score =
    getUniversalNullableNumber_(
      sportacularScore
    );


  if (
    score === null
  ) {
    return null;
  }


  if (score >= 85) {
    return "Elite";
  }


  if (score >= 75) {
    return "Strong";
  }


  if (score >= 65) {
    return "Solid";
  }


  if (score >= 55) {
    return "Lean";
  }


  return "No Play";
}


/**
 * ============================================================================
 * D5 — FINAL ACTIONABLE ELIGIBILITY
 * ============================================================================
 */
function evaluateUniversalActionability_({
  candidateSide,
  bestEV,
  bestModelProbability,
  bestPriceEdge,
  riskScore,
  modelConfidence,
  sportacularEdge,
  sportacularScore
}) {

  const ev =
    getUniversalNullableNumber_(
      bestEV
    );


  const probability =
    getUniversalNullableNumber_(
      bestModelProbability
    );


  const priceEdge =
    getUniversalNullableNumber_(
      bestPriceEdge
    );


  const risk =
    getUniversalNullableNumber_(
      riskScore
    );


  const confidence =
    getUniversalNullableNumber_(
      modelConfidence
    );


  const edge =
    getUniversalNullableNumber_(
      sportacularEdge
    );


  const score =
    getUniversalNullableNumber_(
      sportacularScore
    );


  const mandatoryDataAvailable =
    (
      candidateSide === "Over" ||
      candidateSide === "Under"
    ) &&
    ev !== null &&
    probability !== null &&
    priceEdge !== null &&
    risk !== null &&
    confidence !== null &&
    edge !== null &&
    score !== null;


  if (
    !mandatoryDataAvailable
  ) {
    return {
      finalBestSide:
        "No Play",

      confidenceTier:
        null,

      actionable:
        false,

      evaluable:
        false
    };
  }


  const passesBettingGate =
    ev >=
      SPORTACULAR_PLAYER_PROP_SCORING
        .minimumBestEV &&
    probability >=
      SPORTACULAR_PLAYER_PROP_SCORING
        .minimumBestModelProbability &&
    priceEdge >=
      SPORTACULAR_PLAYER_PROP_SCORING
        .minimumBestPriceEdge &&
    confidence >=
      SPORTACULAR_PLAYER_PROP_SCORING
        .minimumModelConfidence;


  const passesScoreGate =
    score >=
      SPORTACULAR_PLAYER_PROP_SCORING
        .minimumSportacularScore;


  const actionable =
    passesBettingGate &&
    passesScoreGate;


  return {
    finalBestSide:
      actionable
        ? candidateSide
        : "No Play",

    confidenceTier:
      actionable
        ? getUniversalConfidenceTier_(
            score
          )
        : "No Play",

    actionable,

    evaluable:
      true
  };
}


/**
 * ============================================================================
 * MASTER UNIVERSAL SCORING HELPER
 * ============================================================================
 *
 * Input:
 *   I   Line Value
 *   S   Projected Stat
 *   T   Stat Std Dev
 *   W   EV Over
 *   X   EV Under
 *   AA  Best Model Probability
 *   AB  Best Price Edge
 *   AC  Trend Score
 *   AG  Model Confidence
 *
 * Output:
 *   Y   final actionable Best Side
 *   AE  Risk Score
 *   AF  Risk Tier
 *   AH  Sportacular Score
 *   AI  Sportacular Edge
 *   AJ  Confidence Tier
 *
 * Also returns candidateSide for internal/debugging use.
 */
function buildUniversalSportacularScoring_({
  lineValue,
  projectedStat,
  statStdDev,
  evOver,
  evUnder,
  bestModelProbability,
  bestPriceEdge,
  trendScore,
  modelConfidence
}) {

  const candidateSide =
    selectUniversalCandidateSide_({
      evOver,
      evUnder
    });


  let bestEV =
    null;


  if (
    candidateSide === "Over"
  ) {
    bestEV =
      getUniversalNullableNumber_(
        evOver
      );

  } else if (
    candidateSide === "Under"
  ) {
    bestEV =
      getUniversalNullableNumber_(
        evUnder
      );
  }


  const risk =
    calculateUniversalRisk_({
      projectedStat,
      lineValue,
      statStdDev
    });


  const sportacularEdge =
    calculateUniversalSportacularEdge_({
      bestEV,
      bestPriceEdge
    });


  const sportacularScore =
    calculateUniversalSportacularScore_({
      candidateSide,
      sportacularEdge,
      modelConfidence,
      riskScore:
        risk.riskScore,
      trendScore
    });


  const actionability =
    evaluateUniversalActionability_({
      candidateSide,
      bestEV,
      bestModelProbability,
      bestPriceEdge,
      riskScore:
        risk.riskScore,
      modelConfidence,
      sportacularEdge,
      sportacularScore
    });


  return {
    candidateSide,

    finalBestSide:
      actionability.finalBestSide,

    bestEV,

    riskScore:
      risk.riskScore,

    riskTier:
      risk.riskTier,

    sportacularScore,

    sportacularEdge,

    confidenceTier:
      actionability.confidenceTier,

    actionable:
      actionability.actionable,

    evaluable:
      actionability.evaluable
  };
}


