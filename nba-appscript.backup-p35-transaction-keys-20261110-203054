      pra:
        Number(row["Points"] || 0) +
        Number(row["Rebounds"] || 0) +
        Number(row["Assists"] || 0)
    });
  });

  const now = new Date();

  const rows = Object.values(grouped).map(player => {
    const games = player.games;
    const praValues = games.map(g => g.pra);

    return [
      player.playerId,
      player.playerName,
      player.team,
      games.length,
      avgNBA_(games.map(g => g.minutes)),
      avgNBA_(games.map(g => g.points)),
      avgNBA_(games.map(g => g.rebounds)),
      avgNBA_(games.map(g => g.assists)),
      avgNBA_(games.map(g => g.threes)),
      avgNBA_(games.map(g => g.steals)),
      avgNBA_(games.map(g => g.blocks)),
      avgNBA_(games.map(g => g.turnovers)),
      avgNBA_(praValues),
      consistencyScoreNBA_(praValues),
      now
    ];
  });

  rows.sort((a, b) => String(a[1] || "").localeCompare(String(b[1] || "")));

  writeNBAOutputSheet_(sheet, headers, rows);

  // Keep Player Season Stats numeric columns from inheriting stale
  // spreadsheet formats (for example, Avg Turnovers displaying as a date).
  sheet.getRange("D:D").setNumberFormat("0");
  sheet.getRange("E:M").setNumberFormat("0.00");
  sheet.getRange("N:N").setNumberFormat("0.00");
  sheet.getRange("O:O").setNumberFormat("m/d/yyyy");

  Logger.log(`Wrote ${rows.length} rows to NBA Player Season Stats.`);
}

