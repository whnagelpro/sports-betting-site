function getNBADailyAnalyticsDateKey_() {

  const timeZone =
    SpreadsheetApp
      .getActiveSpreadsheet()
      .getSpreadsheetTimeZone();

  return Utilities.formatDate(
    new Date(),
    timeZone,
    "yyyy-MM-dd"
  );
}


function getNBADailyAnalyticsState_() {

  const properties =
    PropertiesService.getScriptProperties();

  const raw =
    properties.getProperty(
      NBA_DAILY_ANALYTICS_PIPELINE.stateKey
    );

  if (!raw) {
    return null;
  }

  try {
    return JSON.parse(raw);
  } catch (error) {
    return null;
  }
}


function saveNBADailyAnalyticsState_(state) {

  PropertiesService
    .getScriptProperties()
    .setProperty(
      NBA_DAILY_ANALYTICS_PIPELINE.stateKey,
      JSON.stringify(state)
    );
}


function clearNBADailyAnalyticsState_() {

  PropertiesService
    .getScriptProperties()
    .deleteProperty(
      NBA_DAILY_ANALYTICS_PIPELINE.stateKey
    );
}


function getNBAEligiblePipelineMonths_(months) {

  const today =
    getNBADailyAnalyticsDateKey_();

  return months.filter(
    month =>
      month.start <= today
  );
}


function createNBADailyAnalyticsState_() {

  /*
   * P35 NBA D4B
   *
   * Every newly created pipeline state receives
   * a unique run identifier.
   *
   * This identifier will later be used to tie
   * team completion evidence to the correct
   * Player Game Logs staging run.
   */

  return {
    runDate:
      getNBADailyAnalyticsDateKey_(),

    playerGameLogsRunId:
      Utilities.getUuid(),

    playerGameLogsCompletedTeamIds:
      [],

    /*
     * P35 NBA D4B — STEP 3L
     *
     * Store the expected number of staged
     * player-game records for each NBA team.
     *
     * Populated only after successful staging
     * in a later controlled step.
     */
    playerGameLogsExpectedRowsByTeamId:
      {},

    /*
     * P35 NBA D4B — STEP 3Q
     *
     * Store a SHA-256 fingerprint for each
     * team's successfully staged player-game rows.
     *
     * The fingerprint ledger belongs to the
     * current pipeline run.
     *
     * Fingerprints will be populated in a
     * subsequent controlled step.
     */
    playerGameLogsExpectedFingerprintsByTeamId:
      {},

    playerGameLogsStagingInitialized:
