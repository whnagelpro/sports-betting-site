  };
}


// ============================================================================
// BUILD COMPLETE NBA PLAYER PROP CONTEXT MAP
//
// Return structure:
//
// contextMap[playerId][marketKey] = {
//   playerId,
//   playerName,
//   team,
//   marketKey,
//   gamesPlayed,
//   seasonAverage,
//   recentAverage,
//   statStdDev,
//   baseline,
//   trendAdjustment,
//   projection
// }
// ============================================================================

function buildNBAPlayerPropContextMap_() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const logSheet =
    ss.getSheetByName(
      "NBA Player Game Logs"
    );

  if (!logSheet) {
    throw new Error(
      'Missing required sheet: "NBA Player Game Logs".'
    );
  }

  const rows =
    getNBAObjectsFromSheet_(
      logSheet
    );

  const players = {};

  rows.forEach(row => {
    const playerId =
      String(
        row["Player ID"] || ""
      ).trim();

    if (!playerId) {
      return;
    }

    if (!players[playerId]) {
      players[playerId] = {
        playerId,

        playerName:
          row["Player Name"] || "",

        team:
          row["Team"] || "",

        games: []
      };
    }

    // Keep the most recently encountered
    // nonblank identity information.
    if (row["Player Name"]) {
      players[playerId].playerName =
        row["Player Name"];
    }

    if (row["Team"]) {
      players[playerId].team =
        row["Team"];
    }

    players[playerId].games.push(
      buildNBAPropGameFromLogRow_(
        row
      )
    );
  });

  const contextMap = {};

  Object.values(players)
    .forEach(player => {

      // Oldest -> newest.
      //
      // This makes the last five entries
      // unambiguously the player's latest
      // five historical games.
      player.games.sort(
        (a, b) =>
          new Date(a.date) -
          new Date(b.date)
      );

      contextMap[
        player.playerId
      ] = {};

      Object.keys(
        NBA_PROP_GAME_LOG_KEYS
      ).forEach(marketKey => {

        const gameLogKey =
          NBA_PROP_GAME_LOG_KEYS[
            marketKey
          ];

        const values =
          player.games
            .map(game =>
              Number(
                game[
                  gameLogKey
                ]
              )
            )
            .filter(
              value =>
                Number.isFinite(
                  value
                )
            );

        if (!values.length) {
          return;
        }

        const recentValues =
          values.slice(-5);

        const seasonAverage =
          avgNBA_(
            values
          );

        const recentAverage =
          avgNBA_(
            recentValues
          );

        const statStdDev =
          stdDevNBA_(
            values
          );

        const projection =
          calculateNBAPropProjection_(
            marketKey,
            seasonAverage,
            recentAverage
          );

        contextMap[
          player.playerId
        ][
          marketKey
        ] = {
          playerId:
            player.playerId,

          playerName:
            player.playerName,

          team:
            player.team,

          marketKey,

          gamesPlayed:
            values.length,

          seasonAverage,

          recentAverage,

          statStdDev,

          baseline:
            projection.baseline,

          trendAdjustment:
            projection.trendAdjustment,

          projection:
            projection.projection
        };
      });
    });

  return contextMap;
}

function auditNBAPlayerPropContext() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const contextMap =
    buildNBAPlayerPropContextMap_();

  const rows = [];

  Object.keys(contextMap)
    .forEach(playerId => {

      const playerMarkets =
        contextMap[playerId];

      Object.keys(playerMarkets)
        .forEach(marketKey => {

          const context =
            playerMarkets[
              marketKey
            ];

          rows.push([
            context.playerId,
            context.playerName,
            context.team,
            context.marketKey,
            context.gamesPlayed,
            context.seasonAverage,
            context.recentAverage,
            context.statStdDev,
            context.baseline,
            context.trendAdjustment,
            context.projection
          ]);
        });
    });

  rows.sort(
    (a, b) => {
      const nameCompare =
        String(a[1] || "")
          .localeCompare(
            String(b[1] || "")
          );

      if (nameCompare !== 0) {
        return nameCompare;
      }

      return String(
        a[3] || ""
      ).localeCompare(
        String(
          b[3] || ""
        )
      );
    }
  );

  const sheetName =
    "NBA Prop Context Audit";

  let sheet =
    ss.getSheetByName(
      sheetName
    );

  if (!sheet) {
    sheet =
      ss.insertSheet(
        sheetName
      );
  } else {
    sheet.clearContents();
  }

  const headers = [
    "Player ID",
    "Player Name",
    "Team",
    "Market",
    "Games Played",
    "Season Average",
    "Recent 5 Average",
    "Stat Std Dev",
    "Player Baseline",
    "Trend Adjustment",
    "Projected Stat"
  ];

  sheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([
      headers
    ]);

  if (rows.length) {
    sheet
      .getRange(
        2,
        1,
        rows.length,
        headers.length
      )
      .setValues(
        rows
      );

    sheet
      .getRange(
        2,
        6,
        rows.length,
        6
      )
      .setNumberFormat(
        "0.0000"
      );
  }

  sheet.setFrozenRows(1);

  sheet.autoResizeColumns(
    1,
    headers.length
  );

  Logger.log(
    "NBA prop context audit complete: " +
    rows.length +
    " player-market rows."
  );
}

// ============================================================================
// NBA LIVE PLAYER PROP INTEGRATION AUDIT
// P7/18
//
// READ-ONLY with respect to production Player Props.
//
// Reads:
// - Player Props
// - NBA Player Game Logs through buildNBAPlayerPropContextMap_()
//
// Writes:
// - NBA Live Prop Audit
//
// Purpose:
// - Verify actual provider market names and Type values.
// - Join live props to historical player context.
// - Calculate raw + calibrated probabilities.
// - Calculate EV and price edge when usable prices exist.
// - Preserve unsupported / missing data as null.
// ============================================================================

function auditNBALivePropIntegration() {
  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const propSheet =
    ss.getSheetByName(
      "Player Props"
    );

  if (!propSheet) {
    throw new Error(
      'Missing required sheet: "Player Props".'
    );
  }

  const lastRow =
    propSheet.getLastRow();

  if (lastRow < 2) {
    throw new Error(
      "Player Props contains no prop rows."
    );
  }

  const contextMap =
    buildNBAPlayerPropContextMap_();

  // Current production raw schema:
  //
  // A Game Id
  // B Game Date
  // C Away Team
  // D Home Team
  // E Id
  // F Player Id
  // G Vendor
  // H Prop Type
  // I Line Value
  // J Type
  // K Odds
  // L Updated At
  // M Over Odds
  // N Under Odds

  const propRows =
    propSheet
      .getRange(
        2,
        1,
        lastRow - 1,
        14
      )
      .getValues();

  const outputRows = [];

  propRows.forEach(row => {

    // Skip completely empty/non-prop rows.
    //
    // A valid production prop should have at least
    // a Game Id, Player Id, Prop Type, or Line Value.
    const hasPropData =
      row[0] !== "" ||
      row[5] !== "" ||
      row[7] !== "" ||
      row[8] !== "";

    if (!hasPropData) {
      return;
    }
    const gameId =
      row[0];

    const playerId =
      String(
        row[5] || ""
      ).trim();

    const vendor =
      row[6];

    const rawPropType =
      row[7];

    const lineRaw =
      row[8];

    const type =
      String(
        row[9] || ""
      )
        .trim()
        .toLowerCase();

    const generalOdds =
      parseNBAAmericanOdds_(
        row[10]
      );

    const overOdds =
      parseNBAAmericanOdds_(
        row[12]
      );

    const underOdds =
      parseNBAAmericanOdds_(
        row[13]
      );

    const marketKey =
      normalizeNBAPropMarket_(
        rawPropType
      );

    const line =
      parseNBANumberOrNull_(
        lineRaw
      );

    const playerContext =
      playerId &&
      contextMap[playerId]
        ? contextMap[playerId]
        : null;

    const context =
      playerContext &&
      marketKey
        ? playerContext[
            marketKey
          ] || null
        : null;

    let rawOverProbability =
      null;

    let rawUnderProbability =
      null;

    let calibratedOverProbability =
      null;

    let calibratedUnderProbability =
      null;

    let evOver =
      null;

    let evUnder =
      null;

    let overPriceEdge =
      null;

    let underPriceEdge =
      null;

    let status = "";

    // ------------------------------------------------------------------------
    // Determine whether this row is modelable.
    // ------------------------------------------------------------------------

    if (!marketKey) {
      status =
        "UNSUPPORTED MARKET";
    } else if (!playerId) {
      status =
        "MISSING PLAYER ID";
    } else if (!context) {
      status =
        "NO PLAYER CONTEXT";
    } else if (line === null) {
      status =
        "MISSING LINE";
    } else if (
      context.projection === null ||
      context.projection === undefined ||
      !Number.isFinite(
        Number(
          context.projection
        )
      )
    ) {
      status =
        "MISSING PROJECTION";
    } else {

      const probabilities =
        calculateNBAPropProbabilities_(
          marketKey,
          context.projection,
          context.statStdDev,
          line
        );

      rawOverProbability =
        probabilities.over;

      rawUnderProbability =
        probabilities.under;

      if (
        rawOverProbability !== null
      ) {
        calibratedOverProbability =
          applyNBAPropCalibration_(
            marketKey,
            rawOverProbability
          );
      }

      if (
        rawUnderProbability !== null
      ) {
        calibratedUnderProbability =
          applyNBAPropCalibration_(
            marketKey,
            rawUnderProbability
          );
      }

      // ----------------------------------------------------------------------
      // Price interpretation
      //
      // Conventional over_under:
      //   M = Over Odds
      //   N = Under Odds
      //
      // Milestone / one-sided:
      //   K = general Odds for the offered threshold.
      //
      // We are NOT forcing unknown Type values into either category.
      // ----------------------------------------------------------------------

      if (
        type === "over_under"
      ) {
        if (
          calibratedOverProbability !== null &&
          overOdds !== null
        ) {
          evOver =
            calculateNBAExpectedValue_(
              calibratedOverProbability,
              overOdds
            );

          overPriceEdge =
            calculateNBAPriceEdge_(
              calibratedOverProbability,
              overOdds
            );
        }

        if (
          calibratedUnderProbability !== null &&
          underOdds !== null
        ) {
          evUnder =
            calculateNBAExpectedValue_(
              calibratedUnderProbability,
              underOdds
            );

          underPriceEdge =
            calculateNBAPriceEdge_(
              calibratedUnderProbability,
              underOdds
            );
        }

        status =
          (
            overOdds !== null ||
            underOdds !== null
          )
            ? "MODELED OVER_UNDER"
            : "MODELED - MISSING SIDE ODDS";

      } else if (
        type === "milestone"
      ) {

        // IMPORTANT:
        // This is only an audit interpretation.
        //
        // We retain the calculated raw probability in the output,
        // but P7 does NOT yet declare ordinary Over probability to
        // be the correct milestone threshold probability.
        //
        // Actual milestone semantics will be frozen after inspecting
        // these live rows.

        if (
          calibratedOverProbability !== null &&
          generalOdds !== null
        ) {
          evOver =
            calculateNBAExpectedValue_(
              calibratedOverProbability,
              generalOdds
            );

          overPriceEdge =
            calculateNBAPriceEdge_(
              calibratedOverProbability,
              generalOdds
            );
        }

        status =
          "MILESTONE - REVIEW SEMANTICS";

      } else {
        status =
          type
            ? "UNKNOWN TYPE: " +
              type
            : "MISSING TYPE";
      }
    }

    outputRows.push([
      gameId,                         // A
      playerId,                       // B
      context
        ? context.playerName
        : "",                         // C
      context
        ? context.team
        : "",                         // D
      vendor,                         // E
      rawPropType,                    // F
      marketKey || "",                // G
      type,                           // H
      line === null
        ? ""
        : line,                       // I
      generalOdds === null
        ? ""
        : generalOdds,                // J
      overOdds === null
        ? ""
        : overOdds,                   // K
      underOdds === null
        ? ""
        : underOdds,                  // L
      context
        ? context.gamesPlayed
        : "",                         // M
      context
        ? context.baseline
        : "",                         // N
      context
        ? context.recentAverage
        : "",                         // O
      context
        ? context.trendAdjustment
        : "",                         // P
      context
        ? context.projection
        : "",                         // Q
      context
        ? context.statStdDev
        : "",                         // R
      rawOverProbability,             // S
      rawUnderProbability,            // T
      calibratedOverProbability,      // U
      calibratedUnderProbability,     // V
      evOver,                         // W
      evUnder,                        // X
      overPriceEdge,                  // Y
      underPriceEdge,                 // Z
      status                          // AA
    ]);
  });

  const sheetName =
    "NBA Live Prop Audit";

  let outputSheet =
    ss.getSheetByName(
      sheetName
    );

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(
        sheetName
      );
  } else {
    outputSheet.clearContents();
  }

  const headers = [
    "Game Id",
    "Player Id",
    "Player Name",
    "Team",
    "Vendor",
    "Raw Prop Type",
    "Normalized Market",
    "Type",
    "Line",
    "General Odds",
    "Over Odds",
    "Under Odds",
    "Games",
    "Player Baseline",
    "Recent 5 Average",
    "Trend Adjustment",
    "Projected Stat",
    "Stat Std Dev",
    "Raw Prob Over",
    "Raw Prob Under",
    "Calibrated Prob Over",
    "Calibrated Prob Under",
    "EV Over",
    "EV Under",
    "Price Edge Over",
    "Price Edge Under",
    "Status"
  ];

  outputSheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([
      headers
    ]);

  if (outputRows.length) {
    outputSheet
      .getRange(
        2,
        1,
        outputRows.length,
        headers.length
      )
      .setValues(
        outputRows
      );

    // Probability / price-edge columns.
    outputSheet
      .getRange(
        2,
        19,
        outputRows.length,
        4
      )
      .setNumberFormat(
        "0.0000%"
      );

    outputSheet
      .getRange(
        2,
        25,
        outputRows.length,
        2
      )
      .setNumberFormat(
        "0.0000%"
      );

    // EV columns.
    outputSheet
      .getRange(
        2,
        23,
        outputRows.length,
        2
      )
      .setNumberFormat(
        "0.000000"
      );

    // Projection/context columns.
    outputSheet
      .getRange(
        2,
        14,
        outputRows.length,
        5
      )
      .setNumberFormat(
        "0.0000"
      );
  }

  outputSheet.setFrozenRows(1);

  outputSheet.autoResizeColumns(
    1,
    headers.length
  );

  Logger.log(
    "NBA live prop integration audit complete: " +
    outputRows.length +
    " rows."
  );
}


// ============================================================================
// STRICT NBA NUMBER PARSER
//
// Empty / invalid stays null.
// Critically, blank does NOT become zero.
// ============================================================================

function parseNBANumberOrNull_(
  value
) {
  if (
    value === null ||
    value === undefined ||
    value === ""
  ) {
    return null;
  }

  const number =
    Number(value);

  return Number.isFinite(number)
    ? number
    : null;
}


// ============================================================================
// STRICT NBA AMERICAN ODDS PARSER
//
// Accepts:
//   -110
//   +120
//   "120"
//   "-105"
//
// Empty / invalid stays null.
// Zero is rejected because it is not a valid American price.
// ============================================================================

function parseNBAAmericanOdds_(
  value
) {
  const number =
    parseNBANumberOrNull_(
      value
    );

  if (
    number === null ||
    number === 0
  ) {
    return null;
  }

  return number;
}

