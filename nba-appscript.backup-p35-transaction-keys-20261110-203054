  const lastRow = sheet.getLastRow();
  if (lastRow < 3) return [];

  const values = sheet.getRange(3, 1, lastRow - 2, 14).getValues();
  const ids = {};

  values.forEach(row => {
    const playerId = row[5]; // F = Player Id
    if (playerId !== "" && playerId !== null && playerId !== undefined) {
      ids[String(playerId)] = true;
    }
  });

  return Object.keys(ids);
