// ============================================================================
// NBA PROP PROBABILITY ENGINE
// P5/18
//
// Pure calculation helpers.
// No sheet writes.
// No production Player Props changes.
//
// Normal:
//   Points, Rebounds, Assists and combination markets.
//
// Poisson:
//   Threes, Steals, Blocks, Turnovers, Blocks + Steals.
// ============================================================================

const NBA_PROP_DISTRIBUTIONS = {
  points: "normal",
  rebounds: "normal",
  assists: "normal",

  threes: "poisson",
  steals: "poisson",
  blocks: "poisson",
  turnovers: "poisson",

  points_rebounds: "normal",
  points_assists: "normal",
  rebounds_assists: "normal",
  points_rebounds_assists: "normal",

  blocks_steals: "poisson"
};

const NBA_PROP_CALIBRATION_SHRINK = {
  points: 0.00,
  rebounds: 0.20,
  assists: 0.25,
  threes: 0.00,
  steals: 0.00,
  blocks: 0.00,
  turnovers: 0.15,
  points_rebounds: 0.00,
  points_assists: 0.00,
  rebounds_assists: 0.00,
  points_rebounds_assists: 0.00,
  blocks_steals: 0.00
};

// ============================================================================
// UNIVERSAL NBA PROBABILITY ENTRY POINT
// ============================================================================

function calculateNBAPropProbabilities_(
  marketKey,
  projection,
  statStdDev,
  line
) {
  const distribution =
    NBA_PROP_DISTRIBUTIONS[marketKey];

  const projectedValue =
    Number(projection);

  const lineValue =
    Number(line);

  if (
    !distribution ||
    !Number.isFinite(projectedValue) ||
    !Number.isFinite(lineValue) ||
    projectedValue < 0
  ) {
    return {
      over: null,
      under: null,
      distribution: null
    };
  }

  if (distribution === "normal") {
    const sd =
      Number(statStdDev);

    if (
      !Number.isFinite(sd) ||
      sd <= 0
    ) {
      return {
        over: null,
        under: null,
        distribution
      };
    }

    return calculateNBANormalProbabilities_(
      projectedValue,
      sd,
      lineValue
    );
  }

  if (distribution === "poisson") {
    return calculateNBAPoissonProbabilities_(
      projectedValue,
      lineValue
    );
  }

  return {
    over: null,
    under: null,
    distribution: null
  };
}


// ============================================================================
// NORMAL DISTRIBUTION
// ============================================================================

function calculateNBANormalProbabilities_(
  mean,
  stdDev,
  line
) {
  if (
    !Number.isFinite(mean) ||
    !Number.isFinite(stdDev) ||
    !Number.isFinite(line) ||
    stdDev <= 0
  ) {
    return {
      over: null,
      under: null,
      distribution: "normal"
    };
  }

  const z =
    (line - mean) / stdDev;

  const under =
    normalCDFNBA_(z);

  const over =
    1 - under;

  return {
    over:
      clampNBAProbability_(over),

    under:
      clampNBAProbability_(under),

    distribution: "normal"
  };
}


// ============================================================================
// NORMAL CDF
// Abramowitz-Stegun style approximation.
// ============================================================================

function normalCDFNBA_(z) {
  const sign =
    z < 0 ? -1 : 1;

  const x =
    Math.abs(z) /
    Math.sqrt(2);

  const t =
    1 /
    (
      1 +
      0.3275911 * x
    );

  const a1 =
    0.254829592;

  const a2 =
    -0.284496736;

  const a3 =
    1.421413741;

  const a4 =
    -1.453152027;

  const a5 =
    1.061405429;

  const erf =
    1 -
    (
      (
        (
          (
            (
              a5 * t +
              a4
            ) * t +
            a3
          ) * t +
          a2
        ) * t +
        a1
      ) *
      t *
      Math.exp(
        -x * x
      )
    );

  return (
    0.5 *
    (
      1 +
      sign * erf
    )
  );
}


// ============================================================================
// POISSON DISTRIBUTION
//
// Handles standard NBA half-point lines:
// 2.5 threes -> Over = P(X >= 3)
// 0.5 blocks -> Over = P(X >= 1)
// etc.
// ============================================================================

function calculateNBAPoissonProbabilities_(
  lambda,
  line
) {
  if (
    !Number.isFinite(lambda) ||
    !Number.isFinite(line) ||
    lambda < 0
  ) {
    return {
      over: null,
      under: null,
      distribution: "poisson"
    };
  }

  const threshold =
    Math.floor(line);

  const under =
    poissonCDFNBA_(
      threshold,
      lambda
    );

  const over =
    1 - under;

  return {
    over:
      clampNBAProbability_(over),

    under:
      clampNBAProbability_(under),

    distribution: "poisson"
  };
}


// ============================================================================
// POISSON CDF
// P(X <= k)
// ============================================================================

function poissonCDFNBA_(
  k,
  lambda
) {
  if (k < 0) {
    return 0;
  }

  if (lambda === 0) {
    return 1;
  }

  let probability =
    Math.exp(-lambda);

  let cumulative =
    probability;

  for (
    let i = 1;
    i <= k;
    i++
  ) {
    probability *=
      lambda / i;

    cumulative +=
      probability;
  }

  return Math.min(
    1,
    Math.max(
      0,
      cumulative
    )
  );
}


// ============================================================================
// PROBABILITY SAFETY
//
// IMPORTANT:
// This clamp is numerical protection only.
// It is NOT calibration.
// P6 handles actual probability calibration.
// ============================================================================

function clampNBAProbability_(
  probability
) {
  if (
    probability === null ||
    probability === undefined ||
    !Number.isFinite(
      Number(probability)
    )
  ) {
    return null;
  }

  return Math.min(
    0.999,
    Math.max(
      0.001,
      Number(probability)
    )
  );
}


// ============================================================================
// AMERICAN ODDS -> IMPLIED PROBABILITY
// ============================================================================

function americanOddsToNBAImpliedProbability_(
  odds
) {
  const value =
    Number(odds);

  if (
    !Number.isFinite(value) ||
    value === 0
  ) {
    return null;
  }

  if (value > 0) {
    return (
      100 /
      (value + 100)
    );
  }

  return (
    Math.abs(value) /
    (
      Math.abs(value) +
      100
    )
  );
}


// ============================================================================
// AMERICAN ODDS -> PROFIT PER $1
//
// +150 => 1.50 profit
// -120 => 0.833333 profit
// ============================================================================

function americanOddsToNBAProfitPerDollar_(
  odds
) {
  const value =
    Number(odds);

  if (
    !Number.isFinite(value) ||
    value === 0
  ) {
    return null;
  }

  if (value > 0) {
    return value / 100;
  }

  return (
    100 /
    Math.abs(value)
  );
}


// ============================================================================
// EXPECTED VALUE PER $1
//
// EV = P(win) * profit_if_win
//      - P(loss) * 1
//
// Equivalent to:
// EV = P * (profit + 1) - 1
// ============================================================================

function calculateNBAExpectedValue_(
  probability,
  americanOdds
) {
  const p =
    Number(probability);

  const profit =
    americanOddsToNBAProfitPerDollar_(
      americanOdds
    );

  if (
    !Number.isFinite(p) ||
    p < 0 ||
    p > 1 ||
    profit === null
  ) {
    return null;
  }

  return (
    p * profit -
    (1 - p)
  );
}


// ============================================================================
// PRICE EDGE
//
// Model probability minus sportsbook implied probability.
// Distinct from EV.
// ============================================================================

function calculateNBAPriceEdge_(
  probability,
  americanOdds
) {
  const p =
    Number(probability);

  const implied =
    americanOddsToNBAImpliedProbability_(
      americanOdds
    );

  if (
    !Number.isFinite(p) ||
    implied === null
  ) {
    return null;
  }

  return p - implied;
}

