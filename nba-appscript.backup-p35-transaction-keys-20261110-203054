/**
 * P35 NBA D4B — STEP 3S
 *
 * Verify the SHA-256 fingerprints of all
 * 30 NBA teams against staging.
 *
 * READ ONLY:
 * - No staging writes.
 * - No production writes.
 * - No pipeline state changes.
 *
 * Must pass normalization testing before
 * being connected to the mother pipeline.
 */
function validateP35NBAPlayerGameLogsFingerprints_(
  state,
  playerTeams
) {
  if (
    !state ||
    !Array.isArray(playerTeams) ||
    playerTeams.length !== 30
  ) {
    throw new Error(
      "P35 NBA D4B: Invalid state or NBA team queue."
    );
  }

  const expectedFingerprints =
    state.playerGameLogsExpectedFingerprintsByTeamId;

  if (
    !expectedFingerprints ||
    typeof expectedFingerprints !== "object" ||
    Array.isArray(expectedFingerprints)
  ) {
    throw new Error(
      "P35 NBA D4B: Expected fingerprint ledger is missing."
    );
  }

  const teamNameToId = new Map();
  const expectedIds = new Set();

  playerTeams.forEach(team => {
    const teamId = Number(team.id);

    const teamName = String(
      team.fullName || ""
    )
      .trim()
      .toLowerCase()
      .replace(/\s+/g, " ");

    if (
      !Number.isSafeInteger(teamId) ||
      teamId <= 0 ||
      !teamName ||
      expectedIds.has(String(teamId)) ||
      teamNameToId.has(teamName)
    ) {
      throw new Error(
        "P35 NBA D4B: Invalid or duplicate NBA team identity."
      );
    }

    expectedIds.add(String(teamId));
    teamNameToId.set(teamName, teamId);
  });

  const recordedIds =
    Object.keys(expectedFingerprints);

  if (
    recordedIds.length !== 30 ||
    recordedIds.some(
      id => !expectedIds.has(id)
    )
  ) {
    throw new Error(
      "P35 NBA D4B: Fingerprint ledger must contain " +
      "exactly the 30 expected NBA team IDs."
    );
  }

  const sheet = SpreadsheetApp
    .getActiveSpreadsheet()
    .getSheetByName(
      "NBA Player Game Logs Staging"
    );

  if (!sheet) {
    throw new Error(
      "P35 NBA D4B: Player Game Logs staging sheet is missing."
    );
  }

  const lastRow = sheet.getLastRow();

  if (lastRow <= 1) {
    throw new Error(
      "P35 NBA D4B: Staging contains no player game logs."
    );
  }

  const stagingRows = sheet
    .getRange(
      2,
      1,
      lastRow - 1,
      14
    )
    .getValues();

  const rowsByTeamId = new Map();

  playerTeams.forEach(team => {
    rowsByTeamId.set(
      Number(team.id),
      []
    );
  });

  stagingRows.forEach((row, index) => {
    const teamName = String(
      row[4] == null ? "" : row[4]
    )
      .trim()
      .toLowerCase()
      .replace(/\s+/g, " ");

    const teamId =
      teamNameToId.get(teamName);

    if (teamId === undefined) {
      throw new Error(
        "P35 NBA D4B: Unknown team in staging at row " +
        (index + 2)
      );
    }

    rowsByTeamId.get(teamId).push(row);
  });

  let verifiedTeams = 0;
  let verifiedRows = 0;

  playerTeams.forEach(team => {
    const teamId = Number(team.id);

    const expectedFingerprint =
      expectedFingerprints[String(teamId)];

    if (
      typeof expectedFingerprint !== "string" ||
      !/^[a-f0-9]{64}$/.test(expectedFingerprint)
    ) {
      throw new Error(
        "P35 NBA D4B: Invalid expected fingerprint for " +
        "team ID " + teamId
      );
    }

    const teamRows =
      rowsByTeamId.get(teamId);

    if (
      !Array.isArray(teamRows) ||
      teamRows.length === 0
    ) {
      throw new Error(
        "P35 NBA D4B: No staged records for team ID " +
        teamId
      );
    }

    const actualFingerprint =
      calculateP35NBAPlayerGameLogsFingerprint_(
        teamRows
      );

    if (
      actualFingerprint !== expectedFingerprint
    ) {
      throw new Error(
        "P35 NBA D4B: Fingerprint mismatch. " +
        "TeamID=" + teamId +
        "; Expected=" + expectedFingerprint +
        "; Actual=" + actualFingerprint
      );
    }

    verifiedTeams++;
    verifiedRows += teamRows.length;
  });

  return {
    valid: true,
    teamCount: verifiedTeams,
    rowCount: verifiedRows,
    runId: String(
      state.playerGameLogsRunId || ""
    )
  };
}

/**
 * P35 NBA D4B — Step 3N
 *
 * Verify actual staging row counts against
 * the expected per-team counts recorded by
 * the mother pipeline.
 *
 * READ ONLY:
 * - No staging modifications.
 * - No production modifications.
 * - No pipeline state changes.
 */
function validateP35NBAPlayerGameLogsRowCounts_(
  state,
  playerTeams
) {
  if (
    !state ||
    !Array.isArray(playerTeams) ||
    playerTeams.length !== 30
  ) {
    throw new Error(
      "P35 NBA D4B: Invalid state or NBA team queue."
    );
  }

  const expectedCounts =
    state.playerGameLogsExpectedRowsByTeamId;

  if (
    !expectedCounts ||
    typeof expectedCounts !== "object" ||
    Array.isArray(expectedCounts)
  ) {
    throw new Error(
      "P35 NBA D4B: Expected row-count ledger is missing."
    );
  }

  const expectedIds = playerTeams.map(
    team => Number(team.id)
  );

  if (
    expectedIds.some(
      id => !Number.isSafeInteger(id) || id <= 0
    ) ||
    new Set(expectedIds).size !== 30
  ) {
    throw new Error(
      "P35 NBA D4B: Expected NBA team IDs are invalid."
    );
  }

  const expectedKeys = expectedIds.map(String);
  const recordedKeys = Object.keys(expectedCounts);

  if (
    recordedKeys.length !== 30 ||
    recordedKeys.some(
      key => !expectedKeys.includes(key)
    )
  ) {
    throw new Error(
      "P35 NBA D4B: Row-count ledger must contain " +
      "exactly the 30 expected NBA team IDs."
    );
  }

  const normalize = value =>
    String(value == null ? "" : value)
      .trim()
      .toLowerCase()
      .replace(/\s+/g, " ");

  const teamNameToId = new Map();

  playerTeams.forEach(team => {
    const name = normalize(team.fullName);
    const id = Number(team.id);

    if (!name || teamNameToId.has(name)) {
      throw new Error(
        "P35 NBA D4B: Invalid or duplicate NBA team name."
      );
    }

    teamNameToId.set(name, id);
  });

  const sheet = SpreadsheetApp
    .getActiveSpreadsheet()
    .getSheetByName("NBA Player Game Logs Staging");

  if (!sheet) {
    throw new Error(
      "P35 NBA D4B: Player Game Logs staging sheet is missing."
    );
  }

  const lastRow = sheet.getLastRow();

  if (lastRow <= 1) {
    throw new Error(
      "P35 NBA D4B: Staging contains no player game logs."
    );
  }

  // Column E is the existing Team column.
  const stagedTeamNames = sheet
    .getRange(2, 5, lastRow - 1, 1)
    .getValues();

  const actualCounts = new Map(
    expectedIds.map(id => [id, 0])
  );

  stagedTeamNames.forEach((row, index) => {
    const teamName = normalize(row[0]);
    const teamId = teamNameToId.get(teamName);

    if (teamId === undefined) {
      throw new Error(
        "P35 NBA D4B: Unknown team at staging row " +
        (index + 2) + ": " + String(row[0])
      );
    }

    actualCounts.set(
      teamId,
      actualCounts.get(teamId) + 1
    );
  });

  let totalExpected = 0;
  let totalActual = 0;

  expectedIds.forEach(teamId => {
    const expected = expectedCounts[String(teamId)];
    const actual = actualCounts.get(teamId);

    if (
      !Number.isSafeInteger(expected) ||
      expected <= 0
    ) {
      throw new Error(
        "P35 NBA D4B: Invalid expected row count for " +
        "team ID " + teamId
      );
    }

    if (actual !== expected) {
      throw new Error(
        "P35 NBA D4B: Staging row-count mismatch. " +
        "TeamID=" + teamId +
        "; Expected=" + expected +
        "; Actual=" + actual
      );
    }

    totalExpected += expected;
    totalActual += actual;
  });

  if (
    totalExpected !== totalActual ||
    totalActual !== lastRow - 1
  ) {
    throw new Error(
      "P35 NBA D4B: Total staging row-count mismatch."
    );
  }

  return {
    valid: true,
    teamCount: 30,
    expectedRows: totalExpected,
    actualRows: totalActual,
    runId: String(state.playerGameLogsRunId || "")
  };
}

/**
 * P35 NBA D4B — Step 3J
 *
 * Validate actual NBA Player Game Logs staging data.
 *
 * READ ONLY:
 * - Does not clear staging.
 * - Does not modify production.
 * - Does not change pipeline state.
 */
function validateP35NBAPlayerGameLogsStaging_(
  playerTeams
) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();

  const sheet = ss.getSheetByName(
    "NBA Player Game Logs Staging"
  );

  if (!sheet) {
    throw new Error(
      "P35 NBA D4B: Player Game Logs staging sheet is missing."
    );
  }

  if (
    !Array.isArray(playerTeams) ||
    playerTeams.length !== 30
  ) {
    throw new Error(
      "P35 NBA D4B: Expected exactly 30 NBA teams."
    );
  }

  const expectedHeaders = [
    "Game Date",
    "Game ID",
    "Player ID",
    "Player Name",
    "Team",
    "Opponent",
    "Minutes",
    "Points",
    "Rebounds",
    "Assists",
    "Threes",
    "Steals",
    "Blocks",
    "Turnovers"
  ];

  const actualHeaders = sheet
    .getRange(1, 1, 1, 14)
    .getDisplayValues()[0];

  for (let i = 0; i < 14; i++) {
    if (
      String(actualHeaders[i] || "").trim() !==
      expectedHeaders[i]
    ) {
      throw new Error(
        "P35 NBA D4B: Staging header mismatch at column " +
        (i + 1)
      );
    }
  }

  const lastRow = sheet.getLastRow();

  if (lastRow <= 1) {
    throw new Error(
      "P35 NBA D4B: Staging contains no player game logs."
    );
  }

  const rows = sheet
    .getRange(2, 1, lastRow - 1, 14)
    .getValues();

  const normalize = value =>
    String(value || "")
      .trim()
      .toLowerCase()
      .replace(/\s+/g, " ");

  const expectedTeamNames = new Set(
    playerTeams.map(team => normalize(team.fullName))
  );

  if (
    expectedTeamNames.size !== 30 ||
    expectedTeamNames.has("")
  ) {
    throw new Error(
      "P35 NBA D4B: Invalid authoritative NBA team names."
    );
  }

  const foundTeams = new Set();
  const playerGameKeys = new Set();

  rows.forEach((row, index) => {
    const sheetRow = index + 2;

    const gameId = String(row[1] || "").trim();
    const playerId = String(row[2] || "").trim();
    const teamName = normalize(row[4]);

    if (!gameId || !playerId || !teamName) {
      throw new Error(
        "P35 NBA D4B: Missing game, player, or team identity " +
        "at staging row " + sheetRow
      );
    }

    if (!expectedTeamNames.has(teamName)) {
      throw new Error(
        "P35 NBA D4B: Unknown NBA team at staging row " +
        sheetRow + ": " + String(row[4])
      );
    }

    const key = gameId + "|" + playerId;

    if (playerGameKeys.has(key)) {
      throw new Error(
        "P35 NBA D4B: Duplicate player-game record at " +
        "staging row " + sheetRow
      );
    }

    playerGameKeys.add(key);
    foundTeams.add(teamName);
  });

  const missingTeams = [...expectedTeamNames]
    .filter(team => !foundTeams.has(team));

  if (missingTeams.length > 0) {
    throw new Error(
      "P35 NBA D4B: Staging is missing NBA teams: " +
      missingTeams.join(", ")
    );
  }

  return {
    valid: true,
    teamCount: foundTeams.size,
    rowCount: rows.length,
    uniquePlayerGames: playerGameKeys.size
  };
}

function finalizeNBAPlayerGameLogsFromStaging_(
  authorizedByPipeline
) {

  /*
   * P35 NBA D4B — PRODUCTION SAFETY GATE
   *
   * Prevent direct diagnostic calls from
   * reaching the production write boundary.
   *
   * This is the first layer of protection.
   * Full staging-completion validation
   * will be added separately.
   */

  if (authorizedByPipeline !== true) {
    throw new Error(
      "NBA Player Game Logs finalizer rejected incomplete staging: " +
      "production finalization was not authorized by the pipeline."
    );
  }

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const stagingSheet =
    ss.getSheetByName(
      "NBA Player Game Logs Staging"
    );

  const productionSheet =
    ss.getSheetByName(
      "NBA Player Game Logs"
    );

  if (!stagingSheet) {
    throw new Error(
      'NBA Player Game Logs finalizer requires "NBA Player Game Logs Staging".'
    );
  }

  if (!productionSheet) {
    throw new Error(
      'NBA Player Game Logs finalizer requires "NBA Player Game Logs".'
    );
  }

  const expectedHeaders = [
    "Game Date",
    "Game ID",
    "Player ID",
    "Player Name",
    "Team",
    "Opponent",
    "Minutes",
    "Points",
    "Rebounds",
    "Assists",
    "Threes",
    "Steals",
    "Blocks",
    "Turnovers"
  ];

  /*
   * Validate staging headers first.
   */
  const stagingHeaders =
    stagingSheet
      .getRange(
        1,
        1,
        1,
        expectedHeaders.length
      )
      .getDisplayValues()[0];

  expectedHeaders.forEach(
    (expectedHeader, index) => {
      const actualHeader =
        String(stagingHeaders[index] || "")
          .trim();

      if (actualHeader !== expectedHeader) {
        throw new Error(
          `NBA Player Game Logs finalizer staging header mismatch at ` +
          `column ${index + 1}. Expected "${expectedHeader}", ` +
          `found "${actualHeader}".`
        );
      }
    }
  );

  /*
   * Validate production headers too.
   *
   * We do not want a valid staging dataset written into a production
   * sheet whose schema has unexpectedly changed.
   */
  const productionHeaders =
    productionSheet
      .getRange(
        1,
        1,
        1,
        expectedHeaders.length
      )
      .getDisplayValues()[0];

  expectedHeaders.forEach(
    (expectedHeader, index) => {
      const actualHeader =
        String(productionHeaders[index] || "")
          .trim();

      if (actualHeader !== expectedHeader) {
        throw new Error(
          `NBA Player Game Logs finalizer production header mismatch at ` +
          `column ${index + 1}. Expected "${expectedHeader}", ` +
          `found "${actualHeader}".`
        );
      }
    }
  );

  const stagingLastRow =
    stagingSheet.getLastRow();

  if (stagingLastRow <= 1) {
    throw new Error(
      "NBA Player Game Logs finalizer rejected staging: no data rows exist."
    );
  }

  const rows =
    stagingSheet
      .getRange(
        2,
        1,
        stagingLastRow - 1,
        expectedHeaders.length
      )
      .getValues();

  /*
   * Build the authoritative 30-team set.
   */
  const currentTeams =
    getNBADailyPlayerGameLogTeams_();

  if (currentTeams.length !== 30) {
    throw new Error(
      `NBA Player Game Logs finalizer expected 30 current NBA teams, ` +
      `found ${currentTeams.length}.`
    );
  }

  const teamNameToTeam =
    new Map();

  currentTeams.forEach(team => {
    const normalizedName =
      String(team.fullName || "")
        .trim()
        .toLowerCase();

    if (!normalizedName) {
      throw new Error(
        `NBA Player Game Logs finalizer found blank authoritative ` +
        `team name for API team ID ${team.id}.`
      );
    }

    if (teamNameToTeam.has(normalizedName)) {
      throw new Error(
        `NBA Player Game Logs finalizer authoritative team-name ` +
        `collision for "${team.fullName}".`
      );
    }

    teamNameToTeam.set(
      normalizedName,
      team
    );
  });

  const representedTeams =
    new Set();

  const globalKeys =
    new Set();

  rows.forEach(
    (row, index) => {
      const sheetRow =
        index + 2;

      if (
        !Array.isArray(row) ||
        row.length !== 14
      ) {
        throw new Error(
          `NBA Player Game Logs finalizer row ${sheetRow} ` +
          `does not contain exactly 14 columns.`
        );
      }

      const gameDate =
        row[0];

      const gameId =
        String(row[1] || "").trim();

      const playerId =
        String(row[2] || "").trim();

      const playerName =
        String(row[3] || "").trim();

      const teamName =
        String(row[4] || "").trim();

      const opponent =
        String(row[5] || "").trim();

      if (
        gameDate === "" ||
        gameDate === null ||
        gameDate === undefined
      ) {
        throw new Error(
          `NBA Player Game Logs finalizer row ${sheetRow} ` +
          `is missing Game Date.`
        );
      }

      if (
        !gameId ||
        !playerId ||
        !playerName ||
        !teamName ||
        !opponent
      ) {
        throw new Error(
          `NBA Player Game Logs finalizer row ${sheetRow} ` +
          `is missing required identity data.`
        );
      }

      const normalizedTeamName =
        teamName.toLowerCase();

      if (
        !teamNameToTeam.has(
          normalizedTeamName
        )
      ) {
        throw new Error(
          `NBA Player Game Logs finalizer row ${sheetRow} contains ` +
          `unexpected team "${teamName}".`
        );
      }

      representedTeams.add(
        normalizedTeamName
      );

      /*
       * Validate every numeric field.
       *
       * Zero is valid. Blank/NaN/non-finite values are not.
       */
      for (
        let columnIndex = 6;
        columnIndex <= 13;
        columnIndex++
      ) {
        const value =
          row[columnIndex];

        if (
          value === "" ||
          value === null ||
          value === undefined ||
          !Number.isFinite(Number(value))
        ) {
          throw new Error(
            `NBA Player Game Logs finalizer row ${sheetRow} has invalid ` +
            `${expectedHeaders[columnIndex]} value "${value}".`
          );
        }
      }

      const key =
        `${gameId}|${playerId}`;

      if (globalKeys.has(key)) {
        throw new Error(
          `NBA Player Game Logs finalizer rejected duplicate ` +
          `Game ID|Player ID key ${key}.`
        );
      }

      globalKeys.add(key);
    }
  );

  /*
   * CRITICAL ALL-TEAM COMPLETENESS GATE.
   *
   * No production write occurs before this gate passes.
   */
  const missingTeams =
    currentTeams
      .filter(team => {
        return !representedTeams.has(
          String(team.fullName)
            .trim()
            .toLowerCase()
        );
      })
      .map(team => team.fullName);

  if (
    representedTeams.size !== 30 ||
    missingTeams.length
  ) {
    throw new Error(
      `NBA Player Game Logs finalizer rejected incomplete staging. ` +
      `Expected 30 current teams, represented=${representedTeams.size}, ` +
      `missing=${missingTeams.length}. ` +
      `Missing teams: ${missingTeams.join(", ")}`
    );
  }

  /*
   * Only after every validation gate has passed do we prepare the
   * production replacement.
   */
  rows.sort(
    (a, b) => {
      const dateA =
        a[0] instanceof Date
          ? a[0].getTime()
          : new Date(a[0]).getTime();

      const dateB =
        b[0] instanceof Date
          ? b[0].getTime()
          : new Date(b[0]).getTime();

      if (
        Number.isFinite(dateA) &&
        Number.isFinite(dateB) &&
        dateA !== dateB
      ) {
        return dateB - dateA;
      }

      const gameCompare =
        String(a[1] || "")
          .localeCompare(
            String(b[1] || "")
          );

      if (gameCompare !== 0) {
        return gameCompare;
      }

      return String(a[3] || "")
        .localeCompare(
          String(b[3] || "")
        );
    }
  );

  /*
   * PRODUCTION WRITE BOUNDARY.
   *
   * Nothing above this point changes production.
   */
  const oldProductionDataRows =
    Math.max(
      0,
      productionSheet.getLastRow() - 1
    );

  if (oldProductionDataRows > 0) {
    productionSheet
      .getRange(
        2,
        1,
        oldProductionDataRows,
        expectedHeaders.length
      )
      .clearContent();
  }

  productionSheet
    .getRange(
      2,
      1,
      rows.length,
      expectedHeaders.length
    )
    .setValues(rows);

  productionSheet
    .getRange("A:A")
    .setNumberFormat("yyyy-mm-dd");

  /*
   * If the new validated dataset is shorter than the previous
   * production dataset, ensure no stale rows remain.
   */
  if (
    rows.length <
    oldProductionDataRows
  ) {
    productionSheet
      .getRange(
        2 + rows.length,
        1,
        oldProductionDataRows -
          rows.length,
        expectedHeaders.length
      )
      .clearContent();
  }

  Logger.log(
