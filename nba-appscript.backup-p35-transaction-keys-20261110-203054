function resetNBAPlayerGameLogsStaging() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheetName = "NBA Player Game Logs Staging";

  const headers = [
    "Game Date",
    "Game ID",
    "Player ID",
    "Player Name",
    "Team",
    "Opponent",
    "Minutes",
    "Points",
    "Rebounds",
    "Assists",
    "Threes",
    "Steals",
    "Blocks",
    "Turnovers"
  ];

  let sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    sheet = ss.insertSheet(sheetName);
  }

  sheet.clearContents();

  sheet
    .getRange(1, 1, 1, headers.length)
    .setValues([headers]);

  sheet
    .getRange("A:A")
    .setNumberFormat("yyyy-mm-dd");

  Logger.log(
    "NBA Player Game Logs Staging reset complete."
  );
}

function stageNBAPlayerGameLogRowsForTeam_(targetTeamId, rows) {
  const teamId = Number(targetTeamId);

  if (!Number.isFinite(teamId)) {
    throw new Error(
      `NBA Player Game Logs staging requires a valid team ID. Received: ${targetTeamId}`
    );
  }

  if (!Array.isArray(rows) || !rows.length) {
    throw new Error(
      `NBA Player Game Logs staging received no rows for team ID ${teamId}.`
    );
  }

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName(
      "NBA Player Game Logs Staging"
    );

  if (!sheet) {
    throw new Error(
      `NBA Player Game Logs Staging does not exist. ` +
      `Run resetNBAPlayerGameLogsStaging() first.`
    );
  }

  const expectedHeaders = [
    "Game Date",
    "Game ID",
    "Player ID",
    "Player Name",
    "Team",
    "Opponent",
    "Minutes",
    "Points",
    "Rebounds",
    "Assists",
    "Threes",
    "Steals",
    "Blocks",
    "Turnovers"
  ];

  const actualHeaders =
    sheet
      .getRange(
        1,
        1,
        1,
        expectedHeaders.length
      )
      .getDisplayValues()[0];

  expectedHeaders.forEach(
    (expectedHeader, index) => {
      if (
        String(actualHeaders[index] || "").trim() !==
        expectedHeader
      ) {
        throw new Error(
          `NBA Player Game Logs Staging header mismatch at column ` +
          `${index + 1}. Expected "${expectedHeader}", found ` +
          `"${actualHeaders[index]}".`
        );
      }
    }
  );

  /*
   * Resolve the authoritative team identity from the API rather
   * than trusting a caller-provided team name.
   */
  const teams =
    fetchAllNBATeams_();

  const targetTeam =
    teams.find(
      team =>
        Number(team && team.id) === teamId
    );

  if (!targetTeam) {
    throw new Error(
      `NBA Player Game Logs staging could not resolve team ID ${teamId}.`
    );
  }

  const targetTeamNames =
    new Set(
      [
        targetTeam.full_name,
        targetTeam.fullName,
        targetTeam.name,
        targetTeam.abbreviation
      ]
        .map(value =>
          String(value || "")
            .trim()
            .toLowerCase()
        )
        .filter(Boolean)
    );

  const cityName =
    `${targetTeam.city || ""} ${targetTeam.name || ""}`
      .trim()
      .toLowerCase();

  if (cityName) {
    targetTeamNames.add(cityName);
  }

  const incomingKeys =
    new Set();

  rows.forEach((row, index) => {
    if (!Array.isArray(row)) {
      throw new Error(
        `NBA Player Game Logs staging row ${index + 1} is not an array.`
      );
    }

    if (row.length !== 14) {
      throw new Error(
        `NBA Player Game Logs staging row ${index + 1} has ` +
        `${row.length} columns instead of 14.`
      );
    }

    const gameDate = row[0];

    const gameId =
      String(row[1] || "").trim();

    const playerId =
      String(row[2] || "").trim();

    const playerName =
      String(row[3] || "").trim();

    const teamName =
      String(row[4] || "").trim();

    const opponent =
      String(row[5] || "").trim();

    if (
      gameDate === "" ||
      gameDate === null ||
      gameDate === undefined
    ) {
      throw new Error(
        `NBA Player Game Logs staging row ${index + 1} is missing Game Date.`
      );
    }

    if (
      !gameId ||
      !playerId ||
      !playerName ||
      !teamName ||
      !opponent
    ) {
      throw new Error(
        `NBA Player Game Logs staging row ${index + 1} is missing ` +
        `required identity data.`
      );
    }

    const normalizedTeamName =
      teamName.toLowerCase();

    if (
      !targetTeamNames.has(
        normalizedTeamName
      )
    ) {
      throw new Error(
        `NBA Player Game Logs staging row ${index + 1} has team ` +
        `"${teamName}", which does not match target team ID ${teamId}.`
      );
    }

    const key =
      `${gameId}|${playerId}`;

    if (incomingKeys.has(key)) {
      throw new Error(
        `NBA Player Game Logs staging received duplicate incoming key ${key}.`
      );
    }

    incomingKeys.add(key);

    /*
     * Minutes through Turnovers must all be populated finite
     * numeric values. Legitimate zero remains valid.
     */
    for (
      let columnIndex = 6;
      columnIndex <= 13;
      columnIndex++
    ) {
      const value =
        row[columnIndex];

      if (
        value === "" ||
        value === null ||
        value === undefined ||
        !Number.isFinite(Number(value))
      ) {
        throw new Error(
          `NBA Player Game Logs staging row ${index + 1} has invalid ` +
          `${expectedHeaders[columnIndex]} value "${value}".`
        );
      }
    }
  });

  const lastRow =
    sheet.getLastRow();

  /*
   * First-time team path:
   * if staging contains only its header, append immediately.
   */
  if (lastRow <= 1) {
    sheet
      .getRange(
        2,
        1,
        rows.length,
        14
      )
      .setValues(rows);

    sheet
      .getRange("A:A")
      .setNumberFormat("yyyy-mm-dd");

    Logger.log(
      `NBA Player Game Logs staging appended first team: ` +
      `teamId=${teamId}, rows=${rows.length}`
    );

    return;
  }

  /*
   * Determine whether this team already exists in staging.
   * Column E is Team.
   */
  const existingRows =
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        14
      )
      .getValues();

  const existingTargetIndexes = [];

  existingRows.forEach(
    (row, index) => {
      const existingTeamName =
        String(row[4] || "")
          .trim()
          .toLowerCase();

      if (
        targetTeamNames.has(
          existingTeamName
        )
      ) {
        existingTargetIndexes.push(index);
      }
    }
  );

  /*
   * New team:
   * append without rewriting the already validated staging data.
   */
  if (!existingTargetIndexes.length) {
    sheet
      .getRange(
        lastRow + 1,
        1,
        rows.length,
        14
      )
      .setValues(rows);

    sheet
      .getRange("A:A")
      .setNumberFormat("yyyy-mm-dd");

    Logger.log(
      `NBA Player Game Logs staging appended team: ` +
      `teamId=${teamId}, rows=${rows.length}`
    );

    return;
  }

  /*
   * Retry path:
   * replace only this team's prior staging rows.
   *
   * We rewrite staging here because the team's existing rows may
   * occupy multiple positions and the replacement row count can
   * differ. This path should occur only on a retry.
   */
  const retainedRows =
    existingRows.filter(row => {
      const existingTeamName =
        String(row[4] || "")
          .trim()
          .toLowerCase();

      return !targetTeamNames.has(
        existingTeamName
      );
    });

  const replacementRows =
    retainedRows.concat(rows);

  if (lastRow > 1) {
    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        14
      )
      .clearContent();
  }

  if (replacementRows.length) {
    sheet
      .getRange(
        2,
        1,
        replacementRows.length,
        14
      )
      .setValues(replacementRows);
  }

  /*
   * If the replacement made staging shorter, make sure no stale
   * rows survive beneath the new dataset.
   */
  const oldDataRowCount =
    lastRow - 1;

  if (
    replacementRows.length <
    oldDataRowCount
  ) {
    sheet
      .getRange(
        2 + replacementRows.length,
        1,
        oldDataRowCount -
          replacementRows.length,
        14
      )
      .clearContent();
  }

  sheet
    .getRange("A:A")
    .setNumberFormat("yyyy-mm-dd");

  Logger.log(
    `NBA Player Game Logs staging replaced existing team: ` +
    `teamId=${teamId}, rows=${rows.length}`
  );
}

