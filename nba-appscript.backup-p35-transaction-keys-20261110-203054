  if (!Number.isFinite(bostonTeamId)) {
    throw new Error(
      "D3D FAILED: Boston Celtics do not have a valid API team ID."
    );
  }

  Logger.log(
    `Resolved Boston Celtics API team ID: ${bostonTeamId}`
