function testP35NBAPlayerGameLogsFinalizerRejectsIncompleteStaging() {
  Logger.log(
    "============================================================"
  );
  Logger.log(
    "P35 NBA D4A — PLAYER GAME LOGS FINALIZER INCOMPLETE-STAGING GATE"
  );
  Logger.log(
    "============================================================"
  );

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const productionSheet =
    ss.getSheetByName(
      "NBA Player Game Logs"
    );

  const stagingSheet =
    ss.getSheetByName(
      "NBA Player Game Logs Staging"
    );

  if (!productionSheet) {
    throw new Error(
      'D4A FAILED: "NBA Player Game Logs" production sheet does not exist.'
    );
  }

  if (!stagingSheet) {
    throw new Error(
      'D4A FAILED: "NBA Player Game Logs Staging" does not exist.'
    );
  }

  const productionLastRowBefore =
    productionSheet.getLastRow();

  const stagingDataRows =
    Math.max(
      0,
      stagingSheet.getLastRow() - 1
    );

  Logger.log(
    `Production last row BEFORE finalizer test: ${productionLastRowBefore}`
  );

  Logger.log(
    `Staging data rows BEFORE finalizer test: ${stagingDataRows}`
  );

  if (stagingDataRows <= 0) {
    throw new Error(
      "D4A FAILED: staging is empty. D3D evidence must exist before this test."
    );
  }

  /*
   * Verify our authoritative current-team queue before testing
   * the finalizer.
   */
  const currentTeams =
    getNBADailyPlayerGameLogTeams_();

  Logger.log(
    `Authoritative current NBA teams resolved: ${currentTeams.length}`
  );

  if (currentTeams.length !== 30) {
    throw new Error(
      `D4A FAILED: expected exactly 30 current NBA teams, ` +
      `resolved ${currentTeams.length}.`
    );
  }

  Logger.log(
    `Current NBA team queue: ${currentTeams
      .map(team => `${team.fullName} [${team.id}]`)
      .join(" | ")}`
  );

  let rejectionObserved =
    false;

  let rejectionMessage =
    "";

  try {
    finalizeNBAPlayerGameLogsFromStaging_();

    /*
     * Reaching here would be dangerous because two-team staging
     * must never be considered production-ready.
     */
    throw new Error(
      "D4A FAILED: finalizer accepted incomplete two-team staging."
    );

  } catch (error) {
    const message =
      String(
        error && error.message
          ? error.message
          : error
      );

    /*
     * Do not accidentally count our own FAILED assertion as the
     * expected finalizer rejection.
     */
    if (
      message ===
      "D4A FAILED: finalizer accepted incomplete two-team staging."
    ) {
      throw error;
    }

    if (
      !message.includes(
        "finalizer rejected incomplete staging"
      )
    ) {
      throw new Error(
        `D4A FAILED: finalizer threw an unexpected error instead of ` +
        `the incomplete-staging safety gate. Error: ${message}`
      );
    }

    rejectionObserved =
      true;

    rejectionMessage =
      message;
  }

  if (!rejectionObserved) {
    throw new Error(
      "D4A FAILED: expected incomplete-staging rejection was not observed."
    );
  }

  Logger.log(
    `Expected finalizer rejection observed: ${rejectionMessage}`
  );

  /*
   * Production must be unchanged.
   */
  const productionLastRowAfter =
    productionSheet.getLastRow();

  Logger.log(
    `Production last row AFTER finalizer test: ${productionLastRowAfter}`
  );

  if (
    productionLastRowAfter !==
    productionLastRowBefore
  ) {
    throw new Error(
      `D4A FAILED: production changed from last row ` +
      `${productionLastRowBefore} to ${productionLastRowAfter}.`
    );
  }

  /*
   * Staging should also remain intact.
   */
  const stagingDataRowsAfter =
    Math.max(
      0,
      stagingSheet.getLastRow() - 1
    );

  Logger.log(
    `Staging data rows AFTER finalizer test: ${stagingDataRowsAfter}`
  );

  if (
    stagingDataRowsAfter !==
    stagingDataRows
  ) {
    throw new Error(
      `D4A FAILED: staging changed from ${stagingDataRows} rows ` +
      `to ${stagingDataRowsAfter} rows during rejection test.`
    );
  }

  Logger.log(
    "PASS: strict finalizer rejected incomplete staging before the " +
    "production write boundary, and both production and staging remained unchanged."
  );

  Logger.log(
    "============================================================"
  );
  Logger.log(
    "P35 NBA D4A — PASS"
  );
  Logger.log(
    "============================================================"
  );
}

