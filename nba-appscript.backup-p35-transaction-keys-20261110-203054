/**
 * P35 NBA D4B — STEP 3P
 *
 * Calculate a deterministic SHA-256 fingerprint
 * for a collection of NBA Player Game Log rows.
 *
 * Each row must contain exactly 14 columns.
 *
 * Row order does not affect the fingerprint.
 *
 * READ ONLY:
 * - No spreadsheet modifications.
 * - No pipeline state modifications.
 * - No production modifications.
 */
function calculateP35NBAPlayerGameLogsFingerprint_(
  rows
) {
  if (
    !Array.isArray(rows) ||
    rows.length === 0
  ) {
    throw new Error(
      "P35 NBA D4B: Cannot fingerprint empty or invalid rows."
    );
  }

  const normalizeValue = value => {
    if (value instanceof Date) {
      if (isNaN(value.getTime())) {
        throw new Error(
          "P35 NBA D4B: Invalid date in fingerprint input."
        );
      }

      return Utilities.formatDate(
        value,
        "America/Phoenix",
        "yyyy-MM-dd"
      );
    }

    if (
      value === null ||
      value === undefined
    ) {
      return "";
    }

    if (typeof value === "number") {
      if (!Number.isFinite(value)) {
        throw new Error(
          "P35 NBA D4B: Non-finite number in fingerprint input."
        );
      }

      return String(value);
    }

    return String(value).trim();
  };

  const serializedRows = rows.map(
    (row, index) => {
      if (
        !Array.isArray(row) ||
        row.length !== 14
      ) {
        throw new Error(
          "P35 NBA D4B: Invalid fingerprint row " +
          (index + 1) +
          ". Expected exactly 14 columns."
        );
      }

      return JSON.stringify(
        row.map(normalizeValue)
      );
    }
  );

  /*
   * Sort serialized rows so that spreadsheet
   * row ordering does not affect the result.
   */
  serializedRows.sort();

  const serializedData =
    JSON.stringify(serializedRows);

  const digest = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    serializedData,
    Utilities.Charset.UTF_8
  );

  return digest
    .map(byte => {
      const unsignedByte = byte & 0xff;

      return unsignedByte
        .toString(16)
        .padStart(2, "0");
    })
    .join("");
}

