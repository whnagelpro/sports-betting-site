            index + 1,

          expected:
            expected,

          actual:
            actual
        });
      }
    }
  );


  addResult_(
    "NBA live A:AJ headers exactly match frozen universal contract",
    headerMismatches.length === 0,
    {
      mismatchCount:
        headerMismatches.length,

      samples:
        headerMismatches.slice(0, 10)
    }
  );


  // ==========================================================================
  // FORMULA INDEPENDENCE
  // ==========================================================================

  let formulaCellCount = 0;
  const formulaSamples = [];


  if (lastRow >= 2) {

    const formulas =
      sheet
        .getRange(
          2,
          1,
          lastRow - 1,
          36
        )
        .getFormulas();


    formulas.forEach(
      (row, rowIndex) => {

        row.forEach(
          (formula, columnIndex) => {

            if (
              String(formula ?? "").trim()
            ) {

              formulaCellCount++;

              if (formulaSamples.length < 10) {

                formulaSamples.push({
                  row:
                    rowIndex + 2,

                  column:
                    columnIndex + 1,

                  formula:
                    formula
                });
              }
            }
          }
        );
      }
    );
  }


  addResult_(
    "NBA live A:AJ production output contains no formulas",
    formulaCellCount === 0,
    {
      formulaCellCount:
        formulaCellCount,

      samples:
        formulaSamples
    }
  );


  // ==========================================================================
  // READ PRODUCTION
  // ==========================================================================

  const rows =
    lastRow >= 2
      ? sheet
          .getRange(
            2,
            1,
            lastRow - 1,
            36
          )
          .getValues()
      : [];


  const populatedRows =
    rows.filter(
      row =>
        row.some(
          value =>
            hasValue_(value)
        )
    );


  const hasLiveProduction =
    populatedRows.length > 0;


  /*
   * NBA may legitimately have no provider props for the current slate.
   *
   * Unlike NFL, zero rows are therefore NOT automatically a production
   * contract failure. The empty-state contract is:
   *
   *   exact A:AJ headers
   *   no formulas
   *   no stale rows
   *
   * If rows exist, the complete live audit below is performed.
   */

  addResult_(
    "NBA production state is structurally valid",
    true,
    {
      lastRow:
        lastRow,

      productionRows:
        populatedRows.length,

      state:
        hasLiveProduction
          ? "LIVE_ROWS"
          : "NO_CURRENT_PROVIDER_ROWS"
    }
  );


  // ==========================================================================
  // COUNTERS
  // ==========================================================================

  let blankRows = 0;

  let missingGameIdRows = 0;
  let missingProviderIdRows = 0;
  let missingPlayerIdRows = 0;
  let missingVendorRows = 0;
  let missingPropTypeRows = 0;

  let duplicateProviderIds = 0;
  let exactUniversalDuplicates = 0;

  let numericViolations = 0;

  let conventionalRows = 0;
  let conventionalModeledRows = 0;
  let conventionalUnmodeledRows = 0;

  let probabilityRows = 0;
  let probabilityBoundViolations = 0;
  let probabilityComplementViolations = 0;

  let unsupportedAnalyticsViolations = 0;

  let milestoneRows = 0;
  let milestoneRowsWithAnalytics = 0;

  let integerOverUnderRows = 0;
  let integerModeledRows = 0;

  let integerPoissonRows = 0;
  let integerPoissonModeledRows = 0;

  let halfPointPoissonRows = 0;

  let bestSideVocabularyViolations = 0;
  let confidenceTierVocabularyViolations = 0;
  let riskTierVocabularyViolations = 0;

  let riskViolations = 0;
  let scoringViolations = 0;
  let scorerParityViolations = 0;
  let actionabilityViolations = 0;

  let candidateRows = 0;
  let actionableRows = 0;
  let noPlayRows = 0;
  let scoringRows = 0;

  let bestEVViolations = 0;
  let bestProbabilityViolations = 0;


  const providerIds =
    new Set();


  const universalRows =
    new Set();


  const validBestSides =
    new Set([
      "Over",
      "Under",
      "No Play"
    ]);


  const validConfidenceTiers =
    new Set([
      "Elite",
      "Strong",
      "Solid",
      "Lean",
      "No Play"
    ]);


  const validRiskTiers =
    new Set([
      "Low",
      "Medium",
      "High",
      "Very High"
    ]);


  const numericColumns = [
    8,   // I
    10,  // K
    12,  // M
    13,  // N
    16,  // Q
    17,  // R
    18,  // S
    19,  // T
    20,  // U
    21,  // V
    22,  // W
    23,  // X
    25,  // Z
    26,  // AA
    27,  // AB
    28,  // AC
    30,  // AE
    32,  // AG
    33,  // AH
    34   // AI
  ];


  const samples = {
    identity: [],
    numeric: [],
    probability: [],
    unsupported: [],
    milestone: [],
    integer: [],
    scorer: [],
    actionability: []
  };


  // ==========================================================================
  // COMPLETE LIVE ROW SCAN
  // ==========================================================================

  rows.forEach(
    (row, rowIndex) => {

      const sheetRow =
        rowIndex + 2;


      const rowHasData =
        row.some(
          value =>
            hasValue_(value)
        );


      if (!rowHasData) {

        /*
         * Only count a blank row as an interstitial violation if there is
         * live production. With a true header-only state, rows[] is empty.
         */

        blankRows++;
        return;
      }


      // ----------------------------------------------------------------------
      // Identity
      // ----------------------------------------------------------------------

      if (!hasValue_(row[0])) {
        missingGameIdRows++;
      }


      if (!hasValue_(row[4])) {

        missingProviderIdRows++;

      } else {

        const providerId =
          String(row[4]);


        if (providerIds.has(providerId)) {
          duplicateProviderIds++;
        } else {
          providerIds.add(providerId);
        }
      }


      if (!hasValue_(row[5])) {
        missingPlayerIdRows++;
      }


      if (!hasValue_(row[6])) {
        missingVendorRows++;
      }


      if (!hasValue_(row[7])) {
        missingPropTypeRows++;
      }


      // ----------------------------------------------------------------------
      // Exact A:AJ duplicates
      // ----------------------------------------------------------------------

      const universalKey =
        JSON.stringify(row);


      if (universalRows.has(universalKey)) {
        exactUniversalDuplicates++;
      } else {
        universalRows.add(universalKey);
      }


      // ----------------------------------------------------------------------
      // Numeric integrity
      // ----------------------------------------------------------------------

      numericColumns.forEach(
        columnIndex => {

          if (
            !finiteIfPopulated_(
              row[columnIndex]
            )
          ) {

            numericViolations++;

            if (samples.numeric.length < 10) {

              samples.numeric.push({
                row:
                  sheetRow,

                column:
                  columnIndex + 1,

                value:
                  row[columnIndex]
              });
            }
          }
        }
      );


      // ----------------------------------------------------------------------
      // Universal values
      // ----------------------------------------------------------------------

      const propType =
        String(row[7] ?? "")
          .trim();


      const marketKey =
        normalizeNBAPropMarket_(
          propType
        );


      const type =
        normalizeType_(
          row[9]
        );


      const lineValue =
        row[8];


      const modelProbOver =
        row[20];


      const modelProbUnder =
        row[21];


      const evOver =
        row[22];


      const evUnder =
        row[23];


      const bestSide =
        String(row[24] ?? "")
          .trim();


      const bestEV =
        row[25];


      const bestModelProbability =
        row[26];


      const bestPriceEdge =
        row[27];


      const trendScore =
        row[28];


      const riskScore =
        row[30];


      const riskTier =
        String(row[31] ?? "")
          .trim();


      const modelConfidence =
        row[32];


      const sportacularScore =
        row[33];


      const sportacularEdge =
        row[34];


      const confidenceTier =
        String(row[35] ?? "")
          .trim();


      const projectedStat =
        row[18];


      const statStdDev =
        row[19];


      const hasProbability =
        hasValue_(modelProbOver) ||
        hasValue_(modelProbUnder);


      const hasEV =
        hasValue_(evOver) ||
        hasValue_(evUnder);


      const hasDecisionAnalytics =
        hasValue_(bestEV) ||
        hasValue_(bestModelProbability) ||
        hasValue_(bestPriceEdge);


      const distribution =
        marketKey
          ? NBA_PROP_DISTRIBUTIONS[
              marketKey
            ] || null
          : null;


      // ----------------------------------------------------------------------
      // Market inventory
      // ----------------------------------------------------------------------

      if (type === "over_under") {

        conventionalRows++;


        if (
          hasProbability ||
          hasEV
        ) {
          conventionalModeledRows++;
        } else {
          conventionalUnmodeledRows++;
        }


        if (
          isIntegerLine_(lineValue)
        ) {

          integerOverUnderRows++;


          if (
            hasProbability ||
            hasEV
          ) {
            integerModeledRows++;
          }


          if (
            distribution === "poisson"
          ) {

            integerPoissonRows++;


            if (
              hasProbability ||
              hasEV
            ) {
              integerPoissonModeledRows++;
            }
          }


          if (
            samples.integer.length < 10
          ) {

            samples.integer.push({
              row:
                sheetRow,

              propType:
                propType,

              marketKey:
                marketKey,

              distribution:
                distribution,

              line:
                lineValue,

              modeled:
                hasProbability ||
                hasEV
            });
          }

        } else if (
          distribution === "poisson" &&
          hasValue_(lineValue)
        ) {

          const n =
            Number(lineValue);


          if (
            Number.isFinite(n) &&
            Math.abs(
              Math.abs(n - Math.floor(n)) -
              0.5
            ) < 1e-9
          ) {
            halfPointPoissonRows++;
          }
        }

      } else if (
        type === "milestone"
      ) {

        milestoneRows++;


        if (
          hasProbability ||
          hasEV ||
          hasDecisionAnalytics
        ) {

          milestoneRowsWithAnalytics++;


          if (
            samples.milestone.length < 10
          ) {

            samples.milestone.push({
              row:
                sheetRow,

              propType:
                propType,

              line:
                lineValue,

              modelProbOver:
                modelProbOver,

              modelProbUnder:
                modelProbUnder,

              evOver:
                evOver,

              evUnder:
                evUnder,

              bestEV:
                bestEV
            });
          }
        }
      }


      // ----------------------------------------------------------------------
      // Production contract:
      //
      // Current NBA builder only owns probability/EV for over_under.
      // Any non-over_under production analytics are therefore a violation.
      // ----------------------------------------------------------------------

      if (
        type !== "over_under" &&
        (
          hasProbability ||
          hasEV ||
          hasDecisionAnalytics
        )
      ) {

        unsupportedAnalyticsViolations++;


        if (
          samples.unsupported.length < 10
        ) {

          samples.unsupported.push({
            row:
              sheetRow,

            type:
              type,

            propType:
              propType,

            line:
              lineValue,

            U:
              modelProbOver,

            V:
              modelProbUnder,

            W:
              evOver,

            X:
              evUnder,

            Z:
              bestEV,

            AA:
              bestModelProbability,

            AB:
              bestPriceEdge
          });
        }
      }


      // ----------------------------------------------------------------------
      // Probability integrity
      // ----------------------------------------------------------------------

      const hasOverProbability =
        hasValue_(modelProbOver);


      const hasUnderProbability =
        hasValue_(modelProbUnder);


      if (
        hasOverProbability ||
        hasUnderProbability
      ) {

        probabilityRows++;


        if (
          !hasOverProbability ||
          !hasUnderProbability
        ) {

          probabilityComplementViolations++;


          if (
            samples.probability.length < 10
          ) {

            samples.probability.push({
              row:
                sheetRow,

              issue:
                "one-sided probability",

              over:
                modelProbOver,

              under:
                modelProbUnder
            });
          }

        } else {

          const over =
            Number(modelProbOver);


          const under =
            Number(modelProbUnder);


          if (
            !Number.isFinite(over) ||
            !Number.isFinite(under) ||
            over < 0 ||
            over > 1 ||
            under < 0 ||
            under > 1
          ) {

            probabilityBoundViolations++;


            if (
              samples.probability.length < 10
            ) {

              samples.probability.push({
                row:
                  sheetRow,

                issue:
                  "bounds",

                over:
                  modelProbOver,

                under:
                  modelProbUnder
              });
            }
          }


          /*
           * IMPORTANT:
           *
           * We only enforce complementary probability on NON-INTEGER
           * conventional lines.
           *
           * Integer-line push semantics are precisely what P19 is
           * inventorying for final acceptance.
           */

          if (
            type === "over_under" &&
            !isIntegerLine_(lineValue) &&
            !nearlyEqual_(
              over + under,
              1,
              1e-8
            )
          ) {

            probabilityComplementViolations++;


            if (
              samples.probability.length < 10
            ) {

              samples.probability.push({
                row:
                  sheetRow,

                issue:
                  "non-integer complement",

                line:
                  lineValue,

                over:
                  over,

                under:
                  under,

                sum:
                  over + under
              });
            }
          }
        }
      }


      // ----------------------------------------------------------------------
      // Frozen vocabularies
      // ----------------------------------------------------------------------

      if (
        bestSide &&
        !validBestSides.has(bestSide)
      ) {
        bestSideVocabularyViolations++;
      }


      if (
        confidenceTier &&
        !validConfidenceTiers.has(
          confidenceTier
        )
      ) {
        confidenceTierVocabularyViolations++;
      }


      if (
        riskTier &&
        !validRiskTiers.has(
          riskTier
        )
      ) {
        riskTierVocabularyViolations++;
      }


      // ----------------------------------------------------------------------
      // Risk semantics
      // ----------------------------------------------------------------------

      const hasRiskScore =
        hasValue_(riskScore);


      const hasRiskTier =
        Boolean(riskTier);


      if (hasRiskScore) {

        const numericRisk =
          Number(riskScore);


        if (
          !Number.isFinite(numericRisk) ||
          numericRisk < 0 ||
          numericRisk > 100
        ) {
          riskViolations++;
        }
      }


      if (
        hasRiskScore !== hasRiskTier
      ) {
        riskViolations++;
      }


      // ----------------------------------------------------------------------
      // Scoring bounds
      // ----------------------------------------------------------------------

      const hasScore =
        hasValue_(sportacularScore);


      const hasEdge =
        hasValue_(sportacularEdge);


      if (hasScore || hasEdge) {
        scoringRows++;
      }


      if (hasScore) {

        const score =
          Number(sportacularScore);


        if (
          !Number.isFinite(score) ||
          score < 0 ||
          score > 100
        ) {
          scoringViolations++;
        }
      }


      if (hasEdge) {

        const edge =
          Number(sportacularEdge);


        if (
          !Number.isFinite(edge) ||
          edge < 0 ||
          edge > 100
        ) {
          scoringViolations++;
        }
      }


      if (hasScore !== hasEdge) {
        scoringViolations++;
      }


      // ----------------------------------------------------------------------
      // Candidate parity
      // ----------------------------------------------------------------------

      const candidateSide =
        selectUniversalCandidateSide_({
          evOver:
            evOver,

          evUnder:
            evUnder
        });


      if (
        candidateSide === "Over" ||
        candidateSide === "Under"
      ) {

        candidateRows++;


        const expectedBestEV =
          candidateSide === "Over"
            ? Number(evOver)
            : Number(evUnder);


        const expectedBestProbability =
          candidateSide === "Over"
            ? Number(modelProbOver)
            : Number(modelProbUnder);


        if (
          !hasValue_(bestEV) ||
          !nearlyEqual_(
            bestEV,
            expectedBestEV,
            1e-8
          )
        ) {
          bestEVViolations++;
        }


        if (
          !hasValue_(
            bestModelProbability
          ) ||
          !nearlyEqual_(
            bestModelProbability,
            expectedBestProbability,
            1e-8
          )
        ) {
          bestProbabilityViolations++;
        }
      }


      // ----------------------------------------------------------------------
      // P15 master scorer parity
      // ----------------------------------------------------------------------

      const rebuilt =
        buildUniversalSportacularScoring_({

          lineValue:
            lineValue,

          projectedStat:
            projectedStat,

          statStdDev:
            statStdDev,

          evOver:
            evOver,

          evUnder:
            evUnder,

          bestModelProbability:
            bestModelProbability,

          bestPriceEdge:
            bestPriceEdge,

          trendScore:
            trendScore,

          modelConfidence:
            modelConfidence
        });


      const riskScoreMatches =
        (
          rebuilt.riskScore === null &&
          !hasValue_(riskScore)
        ) ||
        (
          rebuilt.riskScore !== null &&
          hasValue_(riskScore) &&
          nearlyEqual_(
            rebuilt.riskScore,
            riskScore,
            1e-8
          )
        );


      const riskTierMatches =
        (
          rebuilt.riskTier === null &&
          !riskTier
        ) ||
        rebuilt.riskTier === riskTier;


      const scoreMatches =
        (
          rebuilt.sportacularScore === null &&
          !hasValue_(sportacularScore)
        ) ||
        (
          rebuilt.sportacularScore !== null &&
          hasValue_(sportacularScore) &&
          nearlyEqual_(
            rebuilt.sportacularScore,
            sportacularScore,
            1e-8
          )
        );


      const edgeMatches =
        (
          rebuilt.sportacularEdge === null &&
          !hasValue_(sportacularEdge)
        ) ||
        (
          rebuilt.sportacularEdge !== null &&
          hasValue_(sportacularEdge) &&
          nearlyEqual_(
            rebuilt.sportacularEdge,
            sportacularEdge,
            1e-8
          )
        );


      const confidenceMatches =
        (
          rebuilt.confidenceTier === null &&
          !confidenceTier
        ) ||
        rebuilt.confidenceTier ===
          confidenceTier;


      const sideMatches =
        rebuilt.finalBestSide ===
          bestSide;


      if (
        !riskScoreMatches ||
        !riskTierMatches ||
        !scoreMatches ||
        !edgeMatches ||
        !confidenceMatches ||
        !sideMatches
      ) {

        scorerParityViolations++;


        if (samples.scorer.length < 10) {

          samples.scorer.push({
            row:
              sheetRow,

            production: {
              bestSide:
                bestSide,

              riskScore:
                riskScore,

              riskTier:
                riskTier,

              sportacularScore:
                sportacularScore,

              sportacularEdge:
                sportacularEdge,

              confidenceTier:
                confidenceTier
            },

            rebuilt:
              rebuilt
          });
        }
      }


      // ----------------------------------------------------------------------
      // Actionability
      // ----------------------------------------------------------------------

      if (
        bestSide === "Over" ||
        bestSide === "Under"
      ) {

        actionableRows++;


        if (
          !confidenceTier ||
          confidenceTier === "No Play" ||
          rebuilt.actionable !== true
        ) {

          actionabilityViolations++;


          if (
            samples.actionability.length < 10
          ) {

            samples.actionability.push({
              row:
                sheetRow,

              bestSide:
                bestSide,

              confidenceTier:
                confidenceTier,

              rebuilt:
                rebuilt
            });
          }
        }

      } else if (
        bestSide === "No Play"
      ) {

        noPlayRows++;


        if (
          rebuilt.finalBestSide !==
          "No Play"
        ) {

          actionabilityViolations++;
        }
      }
    }
  );


  // ==========================================================================
  // STALE-BOUNDARY CHECK
  // ==========================================================================

  const rowsBelowToInspect = 25;


  const availableRowsBelow =
    Math.max(
      0,
      sheet.getMaxRows() - lastRow
    );


  const inspectCount =
    Math.min(
      rowsBelowToInspect,
      availableRowsBelow
    );


  let staleBoundaryCells = 0;
  const staleBoundarySamples = [];


  if (inspectCount > 0) {

    const belowValues =
      sheet
        .getRange(
          lastRow + 1,
          1,
          inspectCount,
          36
        )
        .getValues();


    belowValues.forEach(
      (row, rowIndex) => {

        row.forEach(
          (value, columnIndex) => {

            if (hasValue_(value)) {

              staleBoundaryCells++;

              if (
                staleBoundarySamples.length < 10
              ) {

                staleBoundarySamples.push({
                  row:
                    lastRow + 1 + rowIndex,

                  column:
                    columnIndex + 1,

                  value:
                    value
                });
              }
            }
          }
        );
      }
    );
  }


  // ==========================================================================
  // BLOCKING ASSERTIONS
  // ==========================================================================

  addResult_(
    "NBA live production range contains no blank/interstitial rows",
    blankRows === 0,
    {
      violations:
        blankRows
    }
  );


  addResult_(
    "Every live NBA production row has a Game Id",
    missingGameIdRows === 0,
    {
      violations:
        missingGameIdRows
    }
  );


  addResult_(
    "Every live NBA production row has a provider Id",
    missingProviderIdRows === 0,
    {
      violations:
        missingProviderIdRows
    }
  );


  addResult_(
    "Every live NBA production row has a Player Id",
    missingPlayerIdRows === 0,
    {
      violations:
        missingPlayerIdRows
    }
  );


  addResult_(
    "Every live NBA production row has a Vendor",
    missingVendorRows === 0,
    {
      violations:
        missingVendorRows
    }
  );


  addResult_(
    "Every live NBA production row has a Prop Type",
    missingPropTypeRows === 0,
    {
      violations:
        missingPropTypeRows
    }
  );


  addResult_(
    "Live NBA provider IDs are unique",
    duplicateProviderIds === 0,
    {
      uniqueProviderIds:
        providerIds.size,

      duplicateOccurrences:
        duplicateProviderIds
    }
  );


  addResult_(
    "Live NBA output contains no exact duplicate A:AJ rows",
    exactUniversalDuplicates === 0,
    {
      violations:
        exactUniversalDuplicates
    }
  );


  addResult_(
    "All populated NBA production numeric values are finite",
    numericViolations === 0,
    {
      violations:
        numericViolations,

      samples:
        samples.numeric
    }
  );


  addResult_(
    "All populated NBA probabilities remain inside 0-1 bounds",
    probabilityBoundViolations === 0,
    {
      probabilityRows:
        probabilityRows,

      violations:
        probabilityBoundViolations,

      samples:
        samples.probability
    }
  );


  addResult_(
    "All non-integer conventional NBA probability pairs remain complementary",
    probabilityComplementViolations === 0,
    {
      probabilityRows:
        probabilityRows,

      violations:
        probabilityComplementViolations,

      samples:
        samples.probability
    }
  );


  addResult_(
    "Non-over_under NBA rows do not fabricate production probability/EV/decision analytics",
    unsupportedAnalyticsViolations === 0,
    {
      violations:
        unsupportedAnalyticsViolations,

      samples:
        samples.unsupported
    }
  );


  addResult_(
    "NBA milestone rows remain deferred rather than silently scored",
    milestoneRowsWithAnalytics === 0,
    {
      milestoneRows:
        milestoneRows,

      milestoneRowsWithAnalytics:
        milestoneRowsWithAnalytics,

      samples:
        samples.milestone
    }
  );


  addResult_(
    "All live NBA Best Side values use frozen vocabulary",
    bestSideVocabularyViolations === 0,
    {
      violations:
        bestSideVocabularyViolations
    }
  );


  addResult_(
    "All populated NBA Confidence Tier values use frozen P15 vocabulary",
    confidenceTierVocabularyViolations === 0,
    {
      violations:
        confidenceTierVocabularyViolations
    }
  );


  addResult_(
    "All populated NBA Risk Tier values use frozen universal vocabulary",
    riskTierVocabularyViolations === 0,
    {
      violations:
        riskTierVocabularyViolations
    }
  );


  addResult_(
    "All populated NBA universal Risk Scores preserve AE:AF semantics",
    riskViolations === 0,
    {
      violations:
        riskViolations
    }
  );


  addResult_(
    "All populated NBA Sportacular scoring values preserve frozen bounds and pairing",
    scoringViolations === 0,
    {
      scoringRows:
        scoringRows,

      violations:
        scoringViolations
    }
  );


  addResult_(
    "All live NBA Best EV values agree with internal EV candidate",
    bestEVViolations === 0,
    {
      candidateRows:
        candidateRows,

      violations:
        bestEVViolations
    }
  );


  addResult_(
    "All live NBA Best Model Probability values agree with internal EV candidate",
    bestProbabilityViolations === 0,
    {
      candidateRows:
        candidateRows,

      violations:
        bestProbabilityViolations
    }
  );


