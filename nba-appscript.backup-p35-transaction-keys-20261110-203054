/*
 * P35 NBA D4B — STEP 5G
 *
 * Staging-versus-state consistency validator.
 *
 * PURE VALIDATION:
 * - No spreadsheet access
 * - No API requests
 * - No Script Properties access
 * - No state modifications
 * - No production writes
 *
 * The caller supplies staging rows.
 *
 * Strict policy:
 * - Completed teams must match saved evidence.
 * - Unexpected team rows are rejected.
 * - No automatic staging recovery.
 *
 * Not connected to the mother pipeline.
 */

function validateP35NBAPlayerGameLogsStagingState_(
  state,
  playerTeams,
  stagingRows
) {

  function reject(message) {
    throw new Error(
      "P35 NBA D4B: Staging-state mismatch. " +
      message
    );
  }

  /*
   * First validate saved-state consistency.
   */

  const resumeValidation =
    validateP35NBAPlayerGameLogsResumeState_(
      state,
      playerTeams
    );

  if (
    !resumeValidation ||
    resumeValidation.valid !== true
  ) {
    reject("Saved resume state is invalid.");
  }

  if (!Array.isArray(stagingRows)) {
    reject("Staging rows must be an array.");
  }

  /*
   * Build authoritative team-name mapping.
   */

  /*
   * P35 NBA D4B — STEP 5L
   *
   * Build a strict, authoritative team-alias map.
   *
   * Recognized identities:
   * - full_name
   * - fullName
   * - name
   * - abbreviation
   * - city + name
   *
   * Ambiguous aliases are rejected.
   *
   * No API calls or spreadsheet access.
   */

  const teamNameToId = new Map();

  const normalizeTeamName = value =>
    String(value == null ? "" : value)
      .trim()
      .toLowerCase()
      .replace(/\s+/g, " ");

  playerTeams.forEach(team => {

    const teamId =
      String(team.id);

    const fullName =
      normalizeTeamName(
        team.fullName || team.full_name
      );

    if (!fullName) {
      reject(
        "Missing authoritative team name for ID " +
        teamId
      );
    }

    const aliases = new Set(
      [
        team.full_name,
        team.fullName,
        team.name,
        team.abbreviation,
        `${team.city || ""} ${team.name || ""}`
      ]
        .map(normalizeTeamName)
        .filter(Boolean)
    );

    aliases.forEach(alias => {

      if (teamNameToId.has(alias)) {

        const existingTeamId =
          teamNameToId.get(alias);

        if (existingTeamId !== teamId) {
          reject(
            "Ambiguous team alias '" +
            alias +
            "' maps to both team " +
            existingTeamId +
            " and team " +
            teamId
          );
        }

        return;
      }

      teamNameToId.set(
        alias,
        teamId
      );

    });

  });

  /*
   * Group staging rows by team.
   */

  const rowsByTeamId = new Map();

  stagingRows.forEach((row, index) => {

    if (
      !Array.isArray(row) ||
      row.length !== 14
    ) {
      reject(
        "Invalid 14-column staging row at index " +
        index
      );
    }

    const teamName =
      String(row[4] == null ? "" : row[4])
        .trim()
        .toLowerCase()
        .replace(/\s+/g, " ");

    const teamId =
      teamNameToId.get(teamName);

    if (!teamId) {
      reject(
        "Unknown team in staging at row index " +
        index
      );
    }

    if (!rowsByTeamId.has(teamId)) {
      rowsByTeamId.set(
        teamId,
        []
      );
    }

    rowsByTeamId.get(teamId).push(row);

  });

  /*
   * Verify completed teams against saved ledgers.
   */

  const completedIds =
    state.playerGameLogsCompletedTeamIds
      .map(id => String(id));

  const completedSet =
    new Set(completedIds);

  const expectedRows =
    state.playerGameLogsExpectedRowsByTeamId;

  const expectedFingerprints =
    state.playerGameLogsExpectedFingerprintsByTeamId;

  let verifiedRows = 0;

  completedIds.forEach(teamId => {

    const rows =
      rowsByTeamId.get(teamId) || [];

    const expectedCount =
      expectedRows[teamId];

    if (rows.length !== expectedCount) {
      reject(
        "Row-count mismatch for team " +
        teamId +
        ". Expected " +
        expectedCount +
        ", found " +
        rows.length
      );
    }

    const actualFingerprint =
      calculateP35NBAPlayerGameLogsFingerprint_(
        rows
      );

    const expectedFingerprint =
      expectedFingerprints[teamId];

    if (
      actualFingerprint !==
      expectedFingerprint
    ) {
      reject(
        "Fingerprint mismatch for team " +
        teamId
      );
    }

    verifiedRows += rows.length;

  });

  /*
   * Reject rows belonging to teams
   * not recorded as completed.
   */

  for (
    const [teamId, rows]
    of rowsByTeamId.entries()
  ) {

    if (
      !completedSet.has(teamId) &&
      rows.length > 0
    ) {
      reject(
        "Unexpected staging rows for " +
        "incomplete team " +
        teamId
      );
    }

  }

  /*
   * Verify total staging row count.
   */

  if (
    stagingRows.length !==
    verifiedRows
  ) {
    reject(
      "Total staging row count mismatch."
    );
  }

  return {
    valid: true,

    runId:
      resumeValidation.runId,

    completedTeams:
      completedIds.length,

    verifiedRows:
      verifiedRows,

    stagingRows:
      stagingRows.length,

    unexpectedTeams:
      0
  };

}

/*
 * P35 NBA D4B — STEP 4Z
 *
 * Pre-resume state-consistency validator.
 *
 * PURE VALIDATION:
 * - No spreadsheet access
 * - No API requests
 * - No Script Properties access
 * - No state modifications
 * - No production writes
 *
 * Not connected to the mother pipeline.
 */

function validateP35NBAPlayerGameLogsResumeState_(
  state,
  playerTeams
) {

  function reject(message) {
    throw new Error(
      "P35 NBA D4B: Resume state invalid. " +
      message
    );
  }

  if (
    !state ||
    typeof state !== "object" ||
    Array.isArray(state)
  ) {
    reject("Missing or invalid state.");
  }

  if (
    !Array.isArray(playerTeams) ||
    playerTeams.length !== 30
  ) {
    reject("Expected exactly 30 NBA teams.");
  }

  const runId =
    String(state.playerGameLogsRunId || "").trim();

  if (!runId) {
    reject("Missing run ID.");
  }

  const completed =
    state.playerGameLogsCompletedTeamIds;

  if (!Array.isArray(completed)) {
    reject("Missing completed-team ledger.");
  }

  const rowLedger =
    state.playerGameLogsExpectedRowsByTeamId;

  const fingerprintLedger =
    state.playerGameLogsExpectedFingerprintsByTeamId;

  if (
    !rowLedger ||
    typeof rowLedger !== "object" ||
    Array.isArray(rowLedger)
  ) {
    reject("Invalid row-count ledger.");
  }

  if (
    !fingerprintLedger ||
    typeof fingerprintLedger !== "object" ||
    Array.isArray(fingerprintLedger)
  ) {
    reject("Invalid fingerprint ledger.");
  }

  const teamIndex =
    Number(state.playerTeamIndex);

  if (
    !Number.isInteger(teamIndex) ||
    teamIndex < 0 ||
    teamIndex > 30
  ) {
    reject("Invalid team index.");
  }

  if (completed.length !== teamIndex) {
    reject(
      "Team index and completion count disagree."
    );
  }

  const teamIds =
    playerTeams.map(team => String(team.id));

  if (
    new Set(teamIds).size !== 30
  ) {
    reject("Duplicate team IDs in team list.");
  }

  const expectedCompletedIds =
    teamIds.slice(0, teamIndex);

  const completedIds =
    completed.map(id => String(id));

  if (
    new Set(completedIds).size !==
    completedIds.length
  ) {
    reject("Duplicate completed-team IDs.");
  }

  for (
    let i = 0;
    i < expectedCompletedIds.length;
    i++
  ) {
    if (
      completedIds[i] !==
      expectedCompletedIds[i]
    ) {
      reject(
        "Completed-team order does not match team queue."
      );
    }
  }

  const expectedIdSet =
    new Set(expectedCompletedIds);

  const rowKeys =
    Object.keys(rowLedger);

  const fingerprintKeys =
    Object.keys(fingerprintLedger);

  if (
    rowKeys.length !== teamIndex ||
    fingerprintKeys.length !== teamIndex
  ) {
    reject(
      "Evidence-ledger sizes disagree with progress."
    );
  }

  for (const key of rowKeys) {
    if (!expectedIdSet.has(key)) {
      reject(
        "Unexpected team in row-count ledger."
      );
    }

    if (
      !Number.isInteger(rowLedger[key]) ||
      rowLedger[key] <= 0
    ) {
      reject(
        "Invalid expected row count."
      );
    }
  }

  for (const key of fingerprintKeys) {
    if (!expectedIdSet.has(key)) {
      reject(
        "Unexpected team in fingerprint ledger."
      );
    }

    if (
      typeof fingerprintLedger[key] !== "string" ||
      !/^[a-f0-9]{64}$/.test(
        fingerprintLedger[key]
      )
    ) {
      reject(
        "Invalid SHA-256 fingerprint."
      );
    }
  }

  return {
    valid: true,
    runId: runId,
    teamIndex: teamIndex,
    completedTeams: completed.length,
    rowLedgerEntries: rowKeys.length,
    fingerprintLedgerEntries:
      fingerprintKeys.length
  };
}

/*
 * P35 NBA D4B — STEP 4W
 *
 * Synthetic fingerprint validation-gate test.
 *
 * No spreadsheet access.
 * No API calls.
 * No Script Properties access.
 * No staging or production writes.
 */

function testP35NBAFingerprintValidationGate() {

  Logger.log(
    "=== P35 NBA D4B STEP 4W ==="
  );

  let assertions = 0;
  let passed = 0;

  function assertTest(label, condition) {

    assertions++;

    if (condition === true) {
      passed++;
      Logger.log("PASS | " + label);
    } else {
      Logger.log("FAIL | " + label);
    }
  }

  /*
   * Mirror the Step 4U validation condition.
   */
  function passesFingerprintGate(
    playerLogsFingerprintValidation,
    playerLogsRowCountValidation,
    state
  ) {

    if (
      !playerLogsFingerprintValidation ||
      playerLogsFingerprintValidation.valid !== true ||
      playerLogsFingerprintValidation.teamCount !== 30 ||
      playerLogsFingerprintValidation.rowCount !==
        playerLogsRowCountValidation.actualRows ||
      playerLogsFingerprintValidation.runId !==
        String(state.playerGameLogsRunId || "")
    ) {
      return false;
    }

    return true;
  }

  const state = {
    playerGameLogsRunId: "P35-SYNTHETIC-RUN"
  };

  const rowCountValidation = {
    actualRows: 2981
  };

  const validFingerprint = {
    valid: true,
    teamCount: 30,
    rowCount: 2981,
    runId: "P35-SYNTHETIC-RUN"
  };

  assertTest(
    "Valid fingerprint result accepted",
    passesFingerprintGate(
      validFingerprint,
      rowCountValidation,
      state
    ) === true
  );

  assertTest(
    "Missing fingerprint result rejected",
    passesFingerprintGate(
      null,
      rowCountValidation,
      state
    ) === false
  );

  assertTest(
    "Invalid validation status rejected",
    passesFingerprintGate(
      {
        ...validFingerprint,
        valid: false
      },
      rowCountValidation,
      state
    ) === false
  );

  assertTest(
    "Incorrect team count rejected",
    passesFingerprintGate(
      {
        ...validFingerprint,
        teamCount: 29
      },
      rowCountValidation,
      state
    ) === false
  );

  assertTest(
    "Mismatched row count rejected",
    passesFingerprintGate(
      {
        ...validFingerprint,
        rowCount: 2980
      },
      rowCountValidation,
      state
    ) === false
  );

  assertTest(
    "Mismatched run ID rejected",
    passesFingerprintGate(
      {
        ...validFingerprint,
        runId: "DIFFERENT-RUN"
      },
      rowCountValidation,
      state
    ) === false
  );

  Logger.log(
    "Assertions: " + assertions
  );

  Logger.log(
    "Passed: " + passed
  );

  Logger.log(
    "Failed: " + (assertions - passed)
  );

  Logger.log(
    "STATUS: " +
    (
      assertions === passed
        ? "PASS"
        : "FAIL"
    )
  );

  Logger.log(
    "SYNTHETIC VALIDATION-GATE TEST COMPLETE"
  );

  if (assertions !== passed) {
    throw new Error(
      "P35 NBA D4B Step 4W synthetic validation-gate test failed."
    );
  }
}

