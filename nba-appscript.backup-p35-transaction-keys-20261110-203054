      modelKey: "threes",
      recentWeight: 0.20,
      distribution: "poisson"
    },
    {
      market: "Steals",
      key: "steals",
      modelKey: "steals",
      recentWeight: 0.15,
      distribution: "poisson"
    },
    {
      market: "Blocks",
      key: "blocks",
