function scheduleNBADailyAnalyticsRetry_() {

  const handler =
    NBA_DAILY_ANALYTICS_PIPELINE.retryFunction;

  // Prevent duplicate continuation triggers.
  ScriptApp
    .getProjectTriggers()
    .filter(
      trigger =>
        trigger.getHandlerFunction() === handler
    )
    .forEach(
      trigger =>
        ScriptApp.deleteTrigger(trigger)
    );

  ScriptApp
    .newTrigger(handler)
    .timeBased()
    .after(
      NBA_DAILY_ANALYTICS_PIPELINE.retryDelayMs
    )
    .create();

  Logger.log(
    "NBA mother pipeline continuation scheduled."
  );
}


function clearNBADailyAnalyticsContinuationTriggers_() {

  const handler =
    NBA_DAILY_ANALYTICS_PIPELINE.retryFunction;

  ScriptApp
    .getProjectTriggers()
    .filter(
      trigger =>
        trigger.getHandlerFunction() === handler
    )
    .forEach(
      trigger =>
        ScriptApp.deleteTrigger(trigger)
    );
}

/**
 * Temporary continuation-trigger entry point.
 *
 * IMPORTANT:
 * Permanent nightly triggers should call:
 *   runNBADailyAnalyticsPipeline
 *
 * Temporary pipeline continuation triggers call:
 *   continueNBADailyAnalyticsPipeline
 *
 * Keeping these handler names separate prevents continuation cleanup
 * from deleting the permanent nightly Run trigger.
 */
function continueNBADailyAnalyticsPipeline() {

  Logger.log(
    "NBA temporary continuation trigger fired."
  );

  runNBADailyAnalyticsPipeline();
}

function runNBADailyAnalyticsPipeline() {

  const lock =
    LockService.getScriptLock();

  if (!lock.tryLock(5000)) {

    Logger.log(
      "NBA mother pipeline is already running. Exiting duplicate execution."
    );

    return;
  }

  try {

    clearNBADailyAnalyticsContinuationTriggers_();

    const today =
      getNBADailyAnalyticsDateKey_();

    let state =
      getNBADailyAnalyticsState_();

    /*
      Start a fresh pipeline when:
      - no state exists,
      - yesterday's pipeline completed,
      - or the stored state belongs to another date.
    */
    if (
      !state ||
      state.completed ||
      state.runDate !== today
    ) {

      state =
        createNBADailyAnalyticsState_();

      saveNBADailyAnalyticsState_(state);
    }

    Logger.log(
      `NBA mother pipeline starting/resuming. Stage: ${state.stage}`
    );

    const playerTeams =
      getNBADailyPlayerGameLogTeams_();

    const teamMonths =
      getNBAEligiblePipelineMonths_(
        NBA_DAILY_ANALYTICS_PIPELINE.teamMonths
      );

    // ------------------------------------------------------------------------
    // STAGE 1 — PLAYER GAME LOG TEAMS
    // ------------------------------------------------------------------------

    if (state.stage === "PLAYER_GAME_LOGS") {

      /*
       * P35 NBA D4B — STAGING INITIALIZATION GATE
       *
       * Initialize staging once per pipeline run.
       * Never reset staging during an ordinary resume.
       */

      if (
        state.playerGameLogsStagingInitialized !== true
      ) {

        if (
          !state.playerGameLogsRunId ||
          !Array.isArray(
            state.playerGameLogsCompletedTeamIds
          ) ||
          Number(state.playerTeamIndex) !== 0 ||
          state.playerGameLogsCompletedTeamIds.length !== 0
        ) {
          throw new Error(
            "P35 NBA D4B: Cannot initialize staging " +
            "because the pipeline state is inconsistent."
          );
        }

        /*
         * P35 NBA D4B — STAGING RUN IDENTITY
         *
         * Record the pipeline run that initialized
         * the staging dataset.
         *
         * The metadata is written only after the
         * staging reset succeeds.
         */

        resetNBAPlayerGameLogsStaging();

        SpreadsheetApp.flush();

        PropertiesService
          .getScriptProperties()
          .setProperty(
            "P35_NBA_PLAYER_LOGS_STAGING_RUN_ID",
            String(state.playerGameLogsRunId)
          );

        state.playerGameLogsStagingInitialized = true;

        state.updatedAt =
          new Date().toISOString();

        saveNBADailyAnalyticsState_(state);

        Logger.log(
          "P35 NBA D4B: Player Game Logs staging initialized " +
          `for run ${state.playerGameLogsRunId}.`
        );
      }

      /*
       * P35 NBA D4B — STAGING RUN ID VALIDATION
       *
       * Reject staging when its recorded run identity
       * does not match the active pipeline state.
       *
       * This check must pass before processing teams
       * or attempting production finalization.
       */

      const activePlayerLogsRunId =
        String(
          state.playerGameLogsRunId || ""
        ).trim();

      const recordedStagingRunId =
        PropertiesService
          .getScriptProperties()
          .getProperty(
            "P35_NBA_PLAYER_LOGS_STAGING_RUN_ID"
          );

      if (
        state.playerGameLogsStagingInitialized !== true ||
        !activePlayerLogsRunId ||
        !recordedStagingRunId ||
        recordedStagingRunId !== activePlayerLogsRunId
      ) {
        throw new Error(
          "P35 NBA D4B: Staging run identity mismatch. " +
          "Player Game Logs processing blocked. " +
          "Active run: " +
          (activePlayerLogsRunId || "MISSING") +
          "; staging run: " +
          (recordedStagingRunId || "MISSING")
        );
      }

      Logger.log(
        "P35 NBA D4B: Staging run identity verified: " +
        activePlayerLogsRunId
      );

      /*
      * P35 NBA D4B — STEP 5D
      *
      * Validate saved Player Game Logs progress
      * before fetching or staging another team.
      *
      * Read-only state validation.
      *
      * Reject inconsistent completion,
      * row-count, or fingerprint ledgers.
      */

      const playerLogsResumeValidation =
        validateP35NBAPlayerGameLogsResumeState_(
          state,
          playerTeams
        );

      if (
        !playerLogsResumeValidation ||
        playerLogsResumeValidation.valid !== true ||
        playerLogsResumeValidation.runId !==
          activePlayerLogsRunId ||
        playerLogsResumeValidation.teamIndex !==
          Number(state.playerTeamIndex)
      ) {
        throw new Error(
          "P35 NBA D4B: Player Game Logs " +
          "resume-state validation failed."
        );
      }

      Logger.log(
        "P35 NBA D4B: Resume-state validation verified. " +
        `Teams=${playerLogsResumeValidation.completedTeams}; ` +
        `Index=${playerLogsResumeValidation.teamIndex}; ` +
        `Run=${playerLogsResumeValidation.runId}.`
      );

      /*
      * Backward-compatible migration for any stored pre-P35 state.
      *
      * We deliberately restart the new team queue at team 0 rather
      * than attempting to translate a monthly index into a team index.
      */
      if (
        state.playerTeamIndex === undefined ||
        state.playerTeamIndex === null ||
        !Number.isFinite(
          Number(state.playerTeamIndex)
        )
      ) {

        state.playerTeamIndex = 0;

        delete state.playerMonthIndex;

        state.updatedAt =
          new Date().toISOString();

        saveNBADailyAnalyticsState_(state);

        Logger.log(
          "NBA mother pipeline migrated Player Game Logs state to team queue at index 0."
        );
      }

      const playerTeamIndex =
        Number(state.playerTeamIndex);

      if (
        playerTeamIndex <
        playerTeams.length
      ) {

        const team =
          playerTeams[playerTeamIndex];

        Logger.log(
          `NBA mother pipeline: refreshing Player Game Logs ` +
          `${team.fullName} [${team.id}] ` +
          `(${playerTeamIndex + 1}/${playerTeams.length})`
        );

        /*
         * P35 NBA D4B — RUN-SPECIFIC TEAM COMPLETION
         *
         * Require a valid run identity and completion
         * ledger before processing another team.
         *
         * Existing saved states without these fields
         * must not silently acquire completion credit.
         */

        if (
          !state.playerGameLogsRunId ||
          !Array.isArray(
            state.playerGameLogsCompletedTeamIds
          )
        ) {
          throw new Error(
            "P35 NBA D4B: Missing run-specific completion " +
            "tracking. A controlled pipeline restart is required."
          );
        }

        const completedTeamIds =
          state.playerGameLogsCompletedTeamIds;

        const currentTeamId =
          Number(team.id);

        if (
          completedTeamIds.some(
            id => Number(id) === currentTeamId
          )
        ) {
          throw new Error(
            `P35 NBA D4B: Team ${currentTeamId} ` +
            `already marked complete in run ` +
            `${state.playerGameLogsRunId}.`
          );
        }

        const rows =
          refreshNBAPlayerGameLogsForTeam_(
            team.id,
            "2026-10-20",
            "2027-06-30"
          );

        stageNBAPlayerGameLogRowsForTeam_(
          team.id,
          rows
        );

        /*
         * P35 NBA D4B — STEP 3M
         *
         * Record the expected number of player-game
         * rows for this team after staging succeeds.
         *
         * This evidence belongs to the current
         * pipeline run.
         */

        if (
          !state.playerGameLogsExpectedRowsByTeamId ||
          typeof state.playerGameLogsExpectedRowsByTeamId !== "object" ||
          Array.isArray(
            state.playerGameLogsExpectedRowsByTeamId
          )
        ) {
          throw new Error(
            "P35 NBA D4B: Expected row-count ledger is missing."
          );
        }

        if (
          !Array.isArray(rows) ||
          !Number.isSafeInteger(rows.length) ||
          rows.length <= 0
        ) {
          throw new Error(
            `P35 NBA D4B: Invalid staged row count for team ${currentTeamId}.`
          );
        }

        const expectedRowCountKey =
          String(currentTeamId);

        if (
          Object.prototype.hasOwnProperty.call(
            state.playerGameLogsExpectedRowsByTeamId,
            expectedRowCountKey
          )
        ) {
          throw new Error(
            `P35 NBA D4B: Expected row count already recorded for team ${currentTeamId}.`
          );
        }

        state.playerGameLogsExpectedRowsByTeamId[
          expectedRowCountKey
        ] = rows.length;

        Logger.log(
          `P35 NBA D4B: Recorded expected staging rows. ` +
          `Team=${team.fullName}; ` +
          `TeamID=${currentTeamId}; ` +
          `ExpectedRows=${rows.length}; ` +
          `Run=${state.playerGameLogsRunId}.`
        );

        /*
         * P35 NBA D4B — STEP 3R
         *
         * Calculate and record the expected
         * SHA-256 fingerprint for this team's
         * fetched Player Game Logs.
         *
         * Fingerprints are calculated from the
         * source rows, not the staging sheet.
         */

        const expectedFingerprints =
          state.playerGameLogsExpectedFingerprintsByTeamId;

        if (
          !expectedFingerprints ||
          typeof expectedFingerprints !== "object" ||
          Array.isArray(expectedFingerprints)
        ) {
          throw new Error(
            "P35 NBA D4B: Expected fingerprint ledger is missing."
          );
        }

        const fingerprintTeamKey =
          String(currentTeamId);

        if (
          Object.prototype.hasOwnProperty.call(
            expectedFingerprints,
            fingerprintTeamKey
          )
        ) {
          throw new Error(
            `P35 NBA D4B: Fingerprint already recorded for team ${currentTeamId}.`
          );
        }

        const expectedFingerprint =
          calculateP35NBAPlayerGameLogsFingerprint_(
            rows
          );

        if (
          typeof expectedFingerprint !== "string" ||
          !/^[a-f0-9]{64}$/.test(expectedFingerprint)
        ) {
          throw new Error(
            `P35 NBA D4B: Invalid SHA-256 fingerprint for team ${currentTeamId}.`
          );
        }

        expectedFingerprints[
          fingerprintTeamKey
        ] = expectedFingerprint;

        Logger.log(
          `P35 NBA D4B: Expected fingerprint recorded. ` +
          `Team=${team.fullName}; ` +
          `TeamID=${currentTeamId}; ` +
          `Rows=${rows.length}; ` +
          `Run=${state.playerGameLogsRunId}.`
        );

        /*
         * Only record completion after staging succeeds.
         */

        completedTeamIds.push(
          currentTeamId
        );

        state.playerTeamIndex += 1;

        state.lastSuccessfulStep =
          `PLAYER_GAME_LOGS:${team.fullName}`;

        state.lastError = null;

        state.updatedAt =
          new Date().toISOString();

        saveNBADailyAnalyticsState_(state);

        scheduleNBADailyAnalyticsRetry_();

        return;
      }

      /*
      * All 30 team work units have succeeded.
      *
      * The strict finalizer is the production-write gate. If staging
      * is incomplete/corrupt, it throws and state remains at index 30.
      */
      /*
       * P35 NBA D4B — STEP 3I
       *
       * Require a complete, valid 30-team completion
       * ledger before attempting production finalization.
       *
       * This validation is read-only.
       */

      const playerLogsLedgerValidation =
        validateP35NBAPlayerGameLogsCompletionLedger_(
          state,
          playerTeams
        );

      if (
        !playerLogsLedgerValidation ||
        playerLogsLedgerValidation.valid !== true
      ) {
        throw new Error(
          "P35 NBA D4B: Player Game Logs completion " +
          "ledger validation failed."
        );
      }

      Logger.log(
        "P35 NBA D4B: Completion ledger verified. " +
        `Teams=${playerLogsLedgerValidation.completedTeamCount}; ` +
        `Run=${playerLogsLedgerValidation.runId}.`
      );

      /*
       * P35 NBA D4B — STEP 3K
       *
       * Require strict staging-data validation
       * before attempting production finalization.
       *
       * This validation is read-only.
       */

      const playerLogsStagingValidation =
        validateP35NBAPlayerGameLogsStaging_(
          playerTeams
        );

      if (
        !playerLogsStagingValidation ||
        playerLogsStagingValidation.valid !== true ||
        playerLogsStagingValidation.teamCount !== 30
      ) {
        throw new Error(
          "P35 NBA D4B: Player Game Logs staging " +
          "validation failed."
        );
      }

      Logger.log(
        "P35 NBA D4B: Staging validation verified. " +
        `Teams=${playerLogsStagingValidation.teamCount}; ` +
        `Rows=${playerLogsStagingValidation.rowCount}; ` +
        `Unique player-games=${playerLogsStagingValidation.uniquePlayerGames}.`
      );

      /*
       * P35 NBA D4B — STEP 3O
       *
       * Validate actual staging row counts against
       * the expected counts recorded for all 30 teams.
       *
       * This operation is read-only.
       */

      const playerLogsRowCountValidation =
        validateP35NBAPlayerGameLogsRowCounts_(
          state,
          playerTeams
        );

      if (
        !playerLogsRowCountValidation ||
        playerLogsRowCountValidation.valid !== true ||
        playerLogsRowCountValidation.teamCount !== 30 ||
        playerLogsRowCountValidation.expectedRows !==
          playerLogsRowCountValidation.actualRows ||
        playerLogsRowCountValidation.actualRows !==
          playerLogsStagingValidation.rowCount
      ) {
        throw new Error(
          "P35 NBA D4B: Player Game Logs row-count " +
          "validation failed."
        );
      }

      Logger.log(
        "P35 NBA D4B: Per-team row counts verified. " +
        `Teams=${playerLogsRowCountValidation.teamCount}; ` +
        `ExpectedRows=${playerLogsRowCountValidation.expectedRows}; ` +
        `ActualRows=${playerLogsRowCountValidation.actualRows}; ` +
        `Run=${playerLogsRowCountValidation.runId}.`
      );

      /*
       * P35 NBA D4B — STEP 4S
       *
       * Require source-to-staging SHA-256
       * fingerprint parity for all 30 NBA teams
       * before reaching the production finalizer.
       *
       * READ ONLY:
       * This validator reads staging data
       * and compares stored fingerprints.
       *
       * Any mismatch throws an error.
       */

      const playerLogsFingerprintValidation =
        validateP35NBAPlayerGameLogsFingerprints_(
          state,
          playerTeams
        );

      if (
        !playerLogsFingerprintValidation ||
        playerLogsFingerprintValidation.valid !== true ||
        playerLogsFingerprintValidation.teamCount !== 30 ||
        playerLogsFingerprintValidation.rowCount !==
          playerLogsRowCountValidation.actualRows ||
        playerLogsFingerprintValidation.runId !==
          String(state.playerGameLogsRunId || "")
      ) {
        throw new Error(
          "P35 NBA D4B: Player Game Logs " +
          "fingerprint validation failed."
        );
      }

      Logger.log(
        "P35 NBA D4B: Source-to-staging " +
        "fingerprints verified for all 30 NBA teams."
      );

      Logger.log(
        "NBA mother pipeline: all Player Game Log teams staged; validating finalizer."
      );

      /*
       * PRODUCTION SAFETY LOCK
       *
       * Do not authorize production writes yet.
       */
      finalizeNBAPlayerGameLogsFromStaging_();

      state.stage =
        "TEAM_GAME_LOGS";

      state.lastSuccessfulStep =
        "PLAYER_GAME_LOGS:FINALIZED";

      state.lastError = null;

      state.updatedAt =
        new Date().toISOString();

      saveNBADailyAnalyticsState_(state);
    }

    // ------------------------------------------------------------------------
    // STAGE 2 — TEAM GAME LOG MONTHS
    // ------------------------------------------------------------------------

    if (state.stage === "TEAM_GAME_LOGS") {

      if (
        state.teamMonthIndex <
        teamMonths.length
      ) {

        const month =
          teamMonths[
            state.teamMonthIndex
          ];

        Logger.log(
          `NBA mother pipeline: refreshing Team Game Logs ${month.key}`
        );

        month.fn();

        state.teamMonthIndex += 1;

        state.lastSuccessfulStep =
          `TEAM_GAME_LOGS:${month.key}`;

        state.lastError = null;
        state.updatedAt =
          new Date().toISOString();

        saveNBADailyAnalyticsState_(state);

        scheduleNBADailyAnalyticsRetry_();

        return;
      }

      state.stage =
        "PLAYER_SEASON_STATS";

      state.updatedAt =
        new Date().toISOString();

      saveNBADailyAnalyticsState_(state);
    }


    // ------------------------------------------------------------------------
    // STAGE 3 — PLAYER SEASON STATS
    // ------------------------------------------------------------------------

    if (state.stage === "PLAYER_SEASON_STATS") {

      Logger.log(
        "NBA mother pipeline: refreshing Player Season Stats"
      );

      refreshNBAPlayerSeasonStatsSheet();

      state.stage =
        "TEAM_SEASON_STATS";

      state.lastSuccessfulStep =
        "PLAYER_SEASON_STATS";

      state.lastError = null;
      state.updatedAt =
        new Date().toISOString();

      saveNBADailyAnalyticsState_(state);
    }


    // ------------------------------------------------------------------------
    // STAGE 4 — TEAM SEASON STATS
    // ------------------------------------------------------------------------

    if (state.stage === "TEAM_SEASON_STATS") {

      Logger.log(
        "NBA mother pipeline: refreshing Team Season Stats"
      );

      refreshNBATeamSeasonStatsSheet();

      state.stage =
        "PLAYER_TRENDS";

      state.lastSuccessfulStep =
        "TEAM_SEASON_STATS";

      state.lastError = null;
      state.updatedAt =
        new Date().toISOString();

      saveNBADailyAnalyticsState_(state);
    }


    // ------------------------------------------------------------------------
    // STAGE 5 — PLAYER TRENDS
    // ------------------------------------------------------------------------

    if (state.stage === "PLAYER_TRENDS") {

      Logger.log(
        "NBA mother pipeline: refreshing Player Trends"
      );

      refreshNBAPlayerTrendsSheet();

      state.stage =
        "TEAM_TRENDS";

      state.lastSuccessfulStep =
        "PLAYER_TRENDS";

      state.lastError = null;
      state.updatedAt =
        new Date().toISOString();

      saveNBADailyAnalyticsState_(state);
    }


    // ------------------------------------------------------------------------
    // STAGE 6 — TEAM TRENDS
    // ------------------------------------------------------------------------

    if (state.stage === "TEAM_TRENDS") {

      Logger.log(
        "NBA mother pipeline: refreshing Team Trends"
      );

      refreshNBATeamTrendsOutputSheet();

      state.stage =
        "TOP_PLAYER_TRENDS";

      state.lastSuccessfulStep =
        "TEAM_TRENDS";

      state.lastError = null;
      state.updatedAt =
        new Date().toISOString();

      saveNBADailyAnalyticsState_(state);
    }


    // ------------------------------------------------------------------------
    // STAGE 7 — TOP PLAYER TRENDS
    // ------------------------------------------------------------------------

    if (state.stage === "TOP_PLAYER_TRENDS") {

      Logger.log(
        "NBA mother pipeline: refreshing Top Player Trends"
      );

      refreshNBATopPlayerTrendsSheet();

      state.stage =
        "TOP_TEAM_TRENDS";

      state.lastSuccessfulStep =
        "TOP_PLAYER_TRENDS";

      state.lastError = null;
      state.updatedAt =
        new Date().toISOString();

      saveNBADailyAnalyticsState_(state);
    }


    // ------------------------------------------------------------------------
    // STAGE 8 — TOP TEAM TRENDS
    // ------------------------------------------------------------------------

    if (state.stage === "TOP_TEAM_TRENDS") {

      Logger.log(
        "NBA mother pipeline: refreshing Top Team Trends"
      );

      refreshNBATopTeamTrendsSheet();

      state.stage =
        "COMPLETE";

      state.completed =
        true;

      state.lastSuccessfulStep =
        "TOP_TEAM_TRENDS";

      state.lastError = null;
      state.updatedAt =
        new Date().toISOString();

      saveNBADailyAnalyticsState_(state);

      clearNBADailyAnalyticsContinuationTriggers_();

      Logger.log(
        "NBA DAILY ANALYTICS MOTHER PIPELINE COMPLETE."
      );

      return;
    }

  } catch (error) {

    const state =
      getNBADailyAnalyticsState_() ||
      createNBADailyAnalyticsState_();

    state.lastError =
      String(
        error &&
        error.stack
          ? error.stack
          : error
      );

    state.updatedAt =
      new Date().toISOString();

    saveNBADailyAnalyticsState_(state);

    Logger.log(
      `NBA mother pipeline failed at ${state.stage}.`
    );

    Logger.log(
      state.lastError
    );

    /*
      The state has NOT advanced, so the next execution retries
      the exact failed step.
    */
    scheduleNBADailyAnalyticsRetry_();

  } finally {

    lock.releaseLock();

  }
}

function resetNBADailyAnalyticsPipeline() {

  Logger.log(
    "NBA mother pipeline reset starting..."
  );

  // Reset the stored pipeline state first.
  clearNBADailyAnalyticsState_();

  Logger.log(
    "NBA mother pipeline stored state cleared."
  );

  // Trigger cleanup is deliberately isolated so that a temporary
  // Apps Script trigger-service problem cannot prevent the state reset.
  try {

    clearNBADailyAnalyticsContinuationTriggers_();

    Logger.log(
      "NBA mother pipeline continuation triggers cleared."
    );

  } catch (error) {

    Logger.log(
      "NBA mother pipeline trigger cleanup could not complete."
    );

    Logger.log(
      String(
        error && error.stack
          ? error.stack
          : error
      )
    );

  }

  Logger.log(
    "NBA daily analytics mother pipeline state reset."
  );
}

function logNBADailyAnalyticsPipelineState() {

  const state =
    getNBADailyAnalyticsState_();

  Logger.log(
    JSON.stringify(
      state,
      null,
      2
    )
  );
}

