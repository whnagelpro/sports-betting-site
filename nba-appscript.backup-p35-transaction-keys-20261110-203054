      `season=${numericSeason}, page=${pageNumber}, games=${games.length}`
    );

    games.forEach(game => {
      const gameId =
        game &&
        game.id !== undefined &&
        game.id !== null
          ? String(game.id).trim()
          : "";

      if (!gameId) {
        throw new Error(
          `NBA team-season discovery returned a game without an ID ` +
          `for team ${numericTeamId}.`
        );
      }

      if (!seenGameIds.has(gameId)) {
        seenGameIds.add(gameId);
        allGames.push(game);
      }
    });

    cursor =
      response &&
      response.meta &&
      response.meta.next_cursor
        ? response.meta.next_cursor
        : null;

  } while (cursor);

  Logger.log(
    `NBA team-season discovery complete: ` +
    `teamId=${numericTeamId}, ` +
    `season=${numericSeason}, ` +
    `uniqueGames=${allGames.length}`
  );

  return allGames;
}

function getNBACompletedGamesForTeam_(teamId, startDate, endDate) {
  const numericTeamId = Number(teamId);

  if (!Number.isFinite(numericTeamId)) {
    throw new Error(
      `NBA completed-game discovery requires a valid team ID. Received: ${teamId}`
    );
  }

  const start = new Date(startDate);
  const end = new Date(endDate);

  if (
    Number.isNaN(start.getTime()) ||
    Number.isNaN(end.getTime())
  ) {
    throw new Error(
      `NBA completed-game discovery received an invalid date range: ` +
      `${startDate} through ${endDate}`
    );
  }

  if (start.getTime() > end.getTime()) {
    throw new Error(
      `NBA completed-game discovery start date is after end date: ` +
      `${startDate} through ${endDate}`
    );
  }

  /*
   * The 2026-27 NBA season is identified by its starting year.
   * Derive that year from the requested range rather than hardcoding
   * it into the team-season fetcher.
   */
  const season =
    start.getMonth() >= 6
      ? start.getFullYear()
      : start.getFullYear() - 1;

  const allGames =
    fetchAllNBAGamesForTeamSeason_(
      numericTeamId,
      season
    );

  const completedGames = [];
  const seenGameIds = new Set();

  allGames.forEach(game => {
    if (!game) return;

    const gameId =
      game.id !== undefined &&
      game.id !== null
        ? String(game.id).trim()
        : "";

    if (!gameId) {
      throw new Error(
        `NBA completed-game discovery encountered a game without an ID ` +
        `for team ${numericTeamId}.`
      );
    }

    const homeTeamId =
      game.home_team &&
      game.home_team.id !== undefined &&
      game.home_team.id !== null
        ? Number(game.home_team.id)
        : NaN;

    const visitorTeamId =
      game.visitor_team &&
      game.visitor_team.id !== undefined &&
      game.visitor_team.id !== null
        ? Number(game.visitor_team.id)
        : NaN;

    if (
      homeTeamId !== numericTeamId &&
      visitorTeamId !== numericTeamId
    ) {
      return;
    }

    /*
     * Reuse the NBA script's existing game-date value.
     * BDL game objects use game.date for the calendar date.
     */
    const gameDateRaw =
      game.date !== undefined &&
      game.date !== null
        ? String(game.date).trim()
        : "";

    if (!gameDateRaw) {
      throw new Error(
        `NBA completed-game discovery found Game ID ${gameId} without a date.`
      );
    }

    const gameDate =
      new Date(`${gameDateRaw.slice(0, 10)}T12:00:00`);

    if (Number.isNaN(gameDate.getTime())) {
      throw new Error(
        `NBA completed-game discovery found invalid date "${gameDateRaw}" ` +
        `for Game ID ${gameId}.`
      );
    }

    /*
     * Normalize all three values to calendar dates so time-of-day does
     * not accidentally exclude a boundary game.
     */
    const gameDay =
      new Date(
        gameDate.getFullYear(),
        gameDate.getMonth(),
        gameDate.getDate()
      ).getTime();

    const startDay =
      new Date(
        start.getFullYear(),
        start.getMonth(),
        start.getDate()
      ).getTime();

    const endDay =
      new Date(
        end.getFullYear(),
        end.getMonth(),
        end.getDate()
      ).getTime();

    if (
      gameDay < startDay ||
      gameDay > endDay
    ) {
      return;
    }

    /*
     * Existing NBA/BallDontLie completed games expose a final status.
     * Do not infer completion merely because scores happen to exist.
     */
    const status =
      String(game.status || "")
        .trim()
        .toLowerCase();

    const isCompleted =
      status === "final" ||
      status.startsWith("final/");

    if (!isCompleted) {
      return;
    }

    if (seenGameIds.has(gameId)) {
      throw new Error(
        `NBA completed-game discovery produced duplicate Game ID ${gameId} ` +
        `for team ${numericTeamId}.`
      );
    }

    seenGameIds.add(gameId);
    completedGames.push(game);
  });

  completedGames.sort((a, b) => {
    const aDate =
      String(a.date || "").slice(0, 10);

    const bDate =
      String(b.date || "").slice(0, 10);

    return aDate.localeCompare(bDate);
  });

  Logger.log(
    `NBA completed-game discovery complete: ` +
    `teamId=${numericTeamId}, ` +
    `season=${season}, ` +
    `range=${startDate}..${endDate}, ` +
    `seasonGames=${allGames.length}, ` +
    `completedGames=${completedGames.length}`
  );

  return completedGames;
}

function refreshNBAPlayerGameLogsForTeam_(targetTeamId, startDate, endDate) {
  const teamId = Number(targetTeamId);

  if (!Number.isFinite(teamId)) {
    throw new Error(
      `NBA Player Game Logs team worker requires a valid team ID. Received: ${targetTeamId}`
    );
  }

  const completedGames =
    getNBACompletedGamesForTeam_(
      teamId,
      startDate,
      endDate
    );

  if (!completedGames.length) {
    throw new Error(
      `NBA Player Game Logs team worker found zero completed games ` +
      `for team ID ${teamId} from ${startDate} through ${endDate}.`
    );
  }

  const expectedGameIds = new Set();
  const gameMap = {};

  completedGames.forEach(game => {
    const gameId =
      game && game.id !== undefined && game.id !== null
        ? String(game.id).trim()
        : "";

    if (!gameId) {
      throw new Error(
        `NBA Player Game Logs team worker encountered an expected game without an ID.`
      );
    }

    if (expectedGameIds.has(gameId)) {
      throw new Error(
        `NBA Player Game Logs team worker encountered duplicate expected Game ID ${gameId}.`
      );
    }

    const homeTeam = game.home_team || {};
    const awayTeam = game.visitor_team || {};

    const homeTeamId = Number(homeTeam.id);
    const awayTeamId = Number(awayTeam.id);

    if (
      homeTeamId !== teamId &&
      awayTeamId !== teamId
    ) {
      throw new Error(
        `Expected Game ID ${gameId} does not contain target team ID ${teamId}.`
      );
    }

    const gameDate = getNBAGameAZDate_(game);

    if (!gameDate) {
      throw new Error(
        `Expected Game ID ${gameId} has no usable Arizona game date.`
      );
    }

    expectedGameIds.add(gameId);

    gameMap[gameId] = {
      date: gameDate,
      homeTeamId: homeTeamId,
      awayTeamId: awayTeamId,
      homeTeam:
        String(homeTeam.full_name || "").trim(),
      awayTeam:
        String(awayTeam.full_name || "").trim()
    };
  });

  const gameIds =
    Array.from(expectedGameIds);

  Logger.log(
    `NBA Player Game Logs team worker: ` +
    `teamId=${teamId}, expectedGames=${gameIds.length}`
  );

  const statRows =
    fetchAllNBAStatsForGameIds_(gameIds);

  if (!Array.isArray(statRows) || !statRows.length) {
    throw new Error(
      `NBA Player Game Logs team worker received no player stats ` +
      `for team ID ${teamId}.`
    );
  }

  /*
   * First completeness gate:
   * every expected completed game must appear somewhere in the
   * raw stats response.
   */
  const rawGameIds = new Set();

  statRows.forEach(stat => {
    const gameId =
      String(
        stat &&
        (
          stat.game_id ||
          (stat.game && stat.game.id) ||
          ""
        )
      ).trim();

    if (gameId) {
      rawGameIds.add(gameId);
    }
  });

  const missingRawGames =
    gameIds.filter(
      gameId => !rawGameIds.has(gameId)
    );

  if (missingRawGames.length) {
    throw new Error(
      `NBA Player Game Logs team worker is missing raw stats for ` +
      `${missingRawGames.length} expected game(s): ` +
      missingRawGames.join(", ")
    );
  }

  const rows = [];
  const generatedGameIds = new Set();
  const generatedKeys = new Set();

  statRows.forEach(stat => {
    if (!stat) return;

    const gameId =
      String(
        stat.game_id ||
        (stat.game && stat.game.id) ||
        ""
      ).trim();

    /*
     * Ignore any unexpected API spillover rather than allowing it
     * into this team's work unit.
     */
    if (!expectedGameIds.has(gameId)) {
      return;
    }

    const statTeam =
      stat.team || {};

    const statTeamId =
      Number(
        stat.team_id !== undefined &&
        stat.team_id !== null
          ? stat.team_id
          : statTeam.id
      );

    /*
     * We fetched stats for the entire game, so keep only the target
     * team's player rows.
     */
    if (statTeamId !== teamId) {
      return;
    }

    const gameInfo =
      gameMap[gameId];

    if (!gameInfo) {
      throw new Error(
        `NBA Player Game Logs team worker cannot resolve Game ID ${gameId}.`
      );
    }

    const player =
      stat.player || {};

    const playerId =
      String(
        stat.player_id ||
        player.id ||
        ""
      ).trim();

    const playerName =
      String(
        player.full_name ||
        `${player.first_name || ""} ${player.last_name || ""}`.trim()
      ).trim();

    /*
     * Existing production behavior excludes players who did not play.
     */
    const minutesPlayed =
      parseNBAMinutes_(stat.min);

    if (minutesPlayed <= 0) {
      return;
    }

    if (!playerId) {
      throw new Error(
        `NBA Player Game Logs team worker found a played row without ` +
        `Player ID in Game ID ${gameId}.`
      );
    }

    if (!playerName) {
      throw new Error(
        `NBA Player Game Logs team worker found Player ID ${playerId} ` +
        `without a Player Name in Game ID ${gameId}.`
      );
    }

    const teamName =
      String(
        statTeam.full_name ||
        statTeam.abbreviation ||
        ""
      ).trim();

    if (!teamName) {
      throw new Error(
        `NBA Player Game Logs team worker found Player ID ${playerId} ` +
        `without a Team in Game ID ${gameId}.`
      );
    }

    const opponent =
      statTeamId === gameInfo.homeTeamId
        ? gameInfo.awayTeam
        : statTeamId === gameInfo.awayTeamId
          ? gameInfo.homeTeam
          : getNBAOpponentFromStat_(stat);

    if (!opponent) {
      throw new Error(
        `NBA Player Game Logs team worker could not resolve opponent ` +
        `for Player ID ${playerId} in Game ID ${gameId}.`
      );
    }

    /*
     * Strict numeric parser:
     * legitimate zero is valid;
     * blank/null/undefined/NaN is not silently converted to zero.
     */
    const requireNumericStat = (value, fieldName) => {
      if (
        value === "" ||
        value === null ||
        value === undefined
      ) {
        throw new Error(
          `NBA Player Game Logs team worker found missing ${fieldName} ` +
          `for Player ID ${playerId} in Game ID ${gameId}.`
        );
      }

      const numericValue =
        Number(value);

      if (!Number.isFinite(numericValue)) {
        throw new Error(
          `NBA Player Game Logs team worker found invalid ${fieldName} ` +
          `"${value}" for Player ID ${playerId} in Game ID ${gameId}.`
        );
      }

      return numericValue;
    };

    const points =
      requireNumericStat(stat.pts, "Points");

    const rebounds =
      requireNumericStat(stat.reb, "Rebounds");

    const assists =
      requireNumericStat(stat.ast, "Assists");

    const threes =
      requireNumericStat(stat.fg3m, "Threes");

    const steals =
      requireNumericStat(stat.stl, "Steals");

    const blocks =
      requireNumericStat(stat.blk, "Blocks");

    const turnoverRaw =
      stat.turnover !== undefined &&
      stat.turnover !== null &&
      stat.turnover !== ""
        ? stat.turnover
        : stat.turnovers;

    const turnovers =
      requireNumericStat(
        turnoverRaw,
        "Turnovers"
      );

    const key =
      `${gameId}|${playerId}`;

    if (generatedKeys.has(key)) {
      throw new Error(
        `NBA Player Game Logs team worker generated duplicate key ${key}.`
      );
    }

    generatedKeys.add(key);
    generatedGameIds.add(gameId);

    const row = [
      gameInfo.date,
      gameId,
      playerId,
      playerName,
      teamName,
      opponent,
      minutesPlayed,
      points,
      rebounds,
      assists,
      threes,
      steals,
      blocks,
      turnovers
    ];

    if (row.length !== 14) {
      throw new Error(
        `NBA Player Game Logs team worker generated ${row.length} columns ` +
        `instead of the required 14 for key ${key}.`
      );
    }

    rows.push(row);
  });

  /*
   * Second completeness gate:
   * every expected completed game must produce at least one eligible
   * target-team Player Game Log row.
   */
  const missingGeneratedGames =
    gameIds.filter(
      gameId => !generatedGameIds.has(gameId)
    );

  if (missingGeneratedGames.length) {
    throw new Error(
      `NBA Player Game Logs team worker generated no eligible target-team ` +
      `rows for ${missingGeneratedGames.length} expected game(s): ` +
      missingGeneratedGames.join(", ")
    );
  }

  if (!rows.length) {
    throw new Error(
      `NBA Player Game Logs team worker generated zero eligible rows ` +
      `for team ID ${teamId}.`
    );
  }

  Logger.log(
    `NBA Player Game Logs team worker validated: ` +
    `teamId=${teamId}, ` +
    `expectedGames=${gameIds.length}, ` +
    `rawStatRows=${statRows.length}, ` +
    `generatedRows=${rows.length}, ` +
    `generatedGames=${generatedGameIds.size}`
  );

  /*
   * D3A intentionally returns validated rows only.
   * No spreadsheet write occurs here yet.
   */
  return rows;
}

