      recentWeight: 0.10,
      distribution: "poisson"
    },
    {
      market: "Turnovers",
      key: "turnovers",
      modelKey: "turnovers",
      recentWeight: 0.20,
      distribution: "poisson"
    },
    {
      market: "Points + Rebounds",
      key: "pointsRebounds",
      modelKey: "points_rebounds",
      recentWeight: 0.45,
      distribution: "normal"
    },
    {
      market: "Points + Assists",
      key: "pointsAssists",
      modelKey: "points_assists",
      recentWeight: 0.45,
      distribution: "normal"
    },
    {
      market: "Rebounds + Assists",
      key: "reboundsAssists",
      modelKey: "rebounds_assists",
      recentWeight: 0.40,
      distribution: "normal"
    },
    {
      market: "PRA",
      key: "pra",
      modelKey: "points_rebounds_assists",
      recentWeight: 0.50,
      distribution: "normal"
    },
    {
      market: "Blocks + Steals",
      key: "blocksSteals",
      modelKey: "blocks_steals",
      recentWeight: 0.15,
      distribution: "poisson"
    }
  ];

  const MIN_PRIOR_GAMES = 10;
  const RECENT_GAMES = 5;

  // --------------------------------------------------------------------------
  // Build player histories
  // --------------------------------------------------------------------------

  const players = {};

  logs.forEach(row => {
    const playerId =
      String(
        row["Player ID"] || ""
      ).trim();

    if (!playerId) return;

    const date =
      new Date(
        row["Game Date"]
      );

    if (
      !date ||
      Number.isNaN(
        date.getTime()
      )
    ) {
      return;
    }

    const points =
      Number(
        row["Points"] || 0
      );

    const rebounds =
      Number(
        row["Rebounds"] || 0
      );

    const assists =
      Number(
        row["Assists"] || 0
      );

    const steals =
      Number(
        row["Steals"] || 0
      );

    const blocks =
      Number(
        row["Blocks"] || 0
      );

    if (!players[playerId]) {
      players[playerId] = {
        playerId,
        playerName:
          row["Player Name"] || "",
        games: []
      };
    }

    players[playerId].games.push({
      date,

      points,
      rebounds,
      assists,

      threes:
        Number(
          row["Threes"] || 0
        ),

      steals,
      blocks,

      turnovers:
        Number(
          row["Turnovers"] || 0
        ),

      pointsRebounds:
        points + rebounds,

      pointsAssists:
        points + assists,

      reboundsAssists:
        rebounds + assists,

      pra:
        points +
        rebounds +
        assists,

      blocksSteals:
        blocks + steals
    });
  });

  Object.values(players)
    .forEach(player => {
      player.games.sort(
        (a, b) =>
          a.date.getTime() -
          b.date.getTime()
      );
    });

  // --------------------------------------------------------------------------
  // Create probability buckets
  //
  // We audit model confidence from the selected side:
  //
  // 50-55%
  // 55-60%
  // ...
  // 90-95%
  // 95-100%
  // --------------------------------------------------------------------------

  const bucketStarts = [
    0.50,
    0.55,
    0.60,
    0.65,
    0.70,
    0.75,
    0.80,
    0.85,
    0.90,
    0.95
  ];

  const audit = {};

  markets.forEach(market => {
    audit[market.key] = {};

    bucketStarts.forEach(start => {
      audit[market.key][
        start.toFixed(2)
      ] = {
        count: 0,
        probabilitySum: 0,
        wins: 0
      };
    });
  });

  // --------------------------------------------------------------------------
  // Chronological probability audit
  // --------------------------------------------------------------------------

  Object.values(players)
    .forEach(player => {
      const games =
        player.games;

      if (
        games.length <=
        MIN_PRIOR_GAMES
      ) {
        return;
      }

      for (
        let targetIndex =
          MIN_PRIOR_GAMES;

        targetIndex <
          games.length;

        targetIndex++
      ) {
        const priorGames =
          games.slice(
            0,
            targetIndex
          );

        const recentGames =
          priorGames.slice(
            -RECENT_GAMES
          );

        const targetGame =
          games[targetIndex];

        markets.forEach(
          market => {
            const seasonValues =
              priorGames.map(
                game =>
                  Number(
                    game[
                      market.key
                    ] || 0
                  )
              );

            const recentValues =
              recentGames.map(
                game =>
                  Number(
                    game[
                      market.key
                    ] || 0
                  )
              );

            const seasonAverage =
              avgNBA_(
                seasonValues
              );

            const recentAverage =
              avgNBA_(
                recentValues
              );

            const projection =
              seasonAverage *
                (
                  1 -
                  market.recentWeight
                ) +
              recentAverage *
                market.recentWeight;

            const statStdDev =
              stdDevNBA_(
                seasonValues
              );

            // --------------------------------------------------------------
            // Historical synthetic test line:
            //
            // Nearest half-point to the projection.
            //
            // Example:
            // projection 24.2 -> line 24.5
            // projection 7.8  -> line 7.5
            //
            // This is for probability calibration research ONLY.
            // Production P5 will use actual sportsbook lines.
            // --------------------------------------------------------------

            const line =
              Math.floor(
                projection
              ) + 0.5;

            const probabilities =
              calculateNBAPropProbabilities_(
                market.modelKey,
                projection,
                statStdDev,
                line
              );

            if (
              probabilities.over === null ||
              probabilities.under === null
            ) {
              return;
            }

            // --------------------------------------------------------------
            // Audit whichever side model considers more likely.
            // --------------------------------------------------------------

            let selectedProbability;
            let won;

            const actual =
              Number(
                targetGame[
                  market.key
                ] || 0
              );

            if (
              probabilities.over >=
              probabilities.under
            ) {
              selectedProbability =
                probabilities.over;

              won =
                actual > line;
            } else {
              selectedProbability =
                probabilities.under;

              won =
                actual < line;
            }

            if (
              selectedProbability <
              0.50
            ) {
              return;
            }

            const bucketIndex =
              Math.min(
                9,
                Math.floor(
                  (
                    selectedProbability -
                    0.50
                  ) / 0.05
                )
              );

            if (
              bucketIndex < 0 ||
              bucketIndex >
              9
            ) {
              return;
            }

            const bucketStart =
              bucketStarts[
                bucketIndex
              ];

            const bucket =
              audit[
                market.key
              ][
                bucketStart.toFixed(2)
              ];

            bucket.count++;

            bucket.probabilitySum +=
              selectedProbability;

            if (won) {
              bucket.wins++;
            }
          }
        );
      }
    });

  // --------------------------------------------------------------------------
  // Output
  // --------------------------------------------------------------------------

  const outputRows = [];

  markets.forEach(market => {
    bucketStarts.forEach(start => {
      const bucket =
        audit[
          market.key
        ][
          start.toFixed(2)
        ];

      if (!bucket.count) {
        return;
      }

      const averageProbability =
        bucket.probabilitySum /
        bucket.count;

      const actualHitRate =
        bucket.wins /
        bucket.count;

      const calibrationError =
        actualHitRate -
        averageProbability;

      outputRows.push([
        market.market,

        market.distribution,

        start,

        start + 0.05,

        bucket.count,

        averageProbability,

        actualHitRate,

        calibrationError,

        Math.abs(
          calibrationError
        )
      ]);
    });
  });

  const SHEET_NAME =
    "NBA Probability Audit";

  let outputSheet =
    ss.getSheetByName(
      SHEET_NAME
    );

  if (!outputSheet) {
    outputSheet =
      ss.insertSheet(
        SHEET_NAME
      );
  } else {
    outputSheet.clearContents();
  }

  const headers = [
    "Market",
    "Distribution",
    "Bucket Start",
    "Bucket End",
    "Predictions",
    "Avg Model Probability",
    "Actual Hit Rate",
    "Calibration Error",
    "Absolute Calibration Error"
  ];

  outputSheet
    .getRange(
      1,
      1,
      1,
      headers.length
    )
    .setValues([
      headers
    ]);

  if (outputRows.length) {
    outputSheet
      .getRange(
        2,
        1,
        outputRows.length,
        headers.length
      )
      .setValues(
        outputRows
      );

    outputSheet
      .getRange(
        2,
        3,
        outputRows.length,
        2
      )
      .setNumberFormat(
        "0%"
      );

    outputSheet
      .getRange(
        2,
        6,
        outputRows.length,
        4
      )
      .setNumberFormat(
        "0.00%"
      );
  }

  outputSheet.setFrozenRows(1);

  outputSheet.autoResizeColumns(
    1,
    headers.length
  );

  Logger.log(
    "NBA raw probability audit complete: " +
    outputRows.length +
    " populated calibration buckets."
  );
}


// ============================================================================
// SAMPLE STANDARD DEVIATION
//
// Uses n - 1 denominator.
// Returns null when fewer than two observations exist.
// ============================================================================

function stdDevNBA_(values) {
  const clean =
    values
      .map(Number)
      .filter(
        value =>
          Number.isFinite(value)
      );

  if (clean.length < 2) {
    return null;
  }

  const mean =
    clean.reduce(
      (sum, value) =>
        sum + value,
      0
    ) /
    clean.length;

  const squaredDifferenceSum =
    clean.reduce(
      (sum, value) => {
        const difference =
          value - mean;

        return (
          sum +
          difference *
          difference
        );
      },
      0
    );

  return Math.sqrt(
    squaredDifferenceSum /
    (
      clean.length - 1
    )
  );
}

