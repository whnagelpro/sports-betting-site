  );

  Logger.log(
    `Missing Boston keys from staging: ${missingBostonKeys.length}`
  );

  Logger.log(
    `Unexpected Boston keys in staging: ${unexpectedBostonKeys.length}`
  );

  Logger.log(
    "PASS: Boston was appended as a second team, Atlanta remained " +
    "unchanged, global keys remained unique, and production was untouched."
  );

  Logger.log(
    "============================================================"
  );
  Logger.log(
    "P35 NBA D3D — PASS"
  );
  Logger.log(
    "============================================================"
  );
}

function getNBADailyPlayerGameLogTeams_() {
  const teams = fetchAllNBATeams_();

  if (!Array.isArray(teams) || !teams.length) {
    throw new Error(
      "NBA daily Player Game Logs team queue could not load NBA teams."
    );
  }

  /*
   * The general NBA teams endpoint contains historical/inactive
   * franchises, including more than one record that can share a
   * current abbreviation.
   *
   * Therefore current franchises are identified by their exact
   * current city + team-name identity, not abbreviation alone.
   */
  const currentFranchises = [
    ["Atlanta", "Hawks"],
    ["Boston", "Celtics"],
    ["Brooklyn", "Nets"],
    ["Charlotte", "Hornets"],
    ["Chicago", "Bulls"],
    ["Cleveland", "Cavaliers"],
    ["Dallas", "Mavericks"],
    ["Denver", "Nuggets"],
    ["Detroit", "Pistons"],
    ["Golden State", "Warriors"],
    ["Houston", "Rockets"],
    ["Indiana", "Pacers"],
    ["LA", "Clippers"],
    ["Los Angeles", "Lakers"],
    ["Memphis", "Grizzlies"],
    ["Miami", "Heat"],
    ["Milwaukee", "Bucks"],
    ["Minnesota", "Timberwolves"],
    ["New Orleans", "Pelicans"],
    ["New York", "Knicks"],
    ["Oklahoma City", "Thunder"],
    ["Orlando", "Magic"],
    ["Philadelphia", "76ers"],
    ["Phoenix", "Suns"],
    ["Portland", "Trail Blazers"],
    ["Sacramento", "Kings"],
    ["San Antonio", "Spurs"],
    ["Toronto", "Raptors"],
    ["Utah", "Jazz"],
    ["Washington", "Wizards"]
  ];

  const normalize = value =>
    String(value || "")
      .trim()
      .toLowerCase();

  const currentTeams =
    currentFranchises.map(
      ([expectedCity, expectedName]) => {
        const matches =
          teams.filter(team => {
            return (
              normalize(team && team.city) ===
                normalize(expectedCity) &&
              normalize(team && team.name) ===
                normalize(expectedName)
            );
          });

        if (matches.length !== 1) {
          throw new Error(
            `NBA current-team queue could not uniquely resolve ` +
            `${expectedCity} ${expectedName}. Matches=${matches.length}.`
          );
        }

        const team =
          matches[0];

        const id =
          Number(team.id);

        const abbreviation =
          String(team.abbreviation || "")
            .trim()
            .toUpperCase();

        const fullName =
          String(
            team.full_name ||
            team.fullName ||
            `${team.city || ""} ${team.name || ""}`
          ).trim();

        if (!Number.isFinite(id)) {
          throw new Error(
            `Current NBA team ${expectedCity} ${expectedName} ` +
            `has invalid API ID "${team.id}".`
          );
        }

        if (!fullName) {
          throw new Error(
            `Current NBA team ${expectedCity} ${expectedName} ` +
            `has no usable team name.`
          );
        }

        return {
          id: id,
          abbreviation: abbreviation,
          fullName: fullName,
          city: String(team.city || "").trim(),
          name: String(team.name || "").trim()
        };
      }
    );

  if (currentTeams.length !== 30) {
    throw new Error(
      `NBA current-team queue validation failed. ` +
      `Expected 30 teams, found ${currentTeams.length}.`
    );
  }

  const idSet =
    new Set();

  const fullNameSet =
    new Set();

  currentTeams.forEach(team => {
    if (idSet.has(team.id)) {
      throw new Error(
        `NBA current-team queue contains duplicate API team ID ${team.id}.`
      );
    }

    idSet.add(team.id);

    const normalizedFullName =
      normalize(team.fullName);

    if (fullNameSet.has(normalizedFullName)) {
      throw new Error(
        `NBA current-team queue contains duplicate team name ` +
        `"${team.fullName}".`
      );
    }

    fullNameSet.add(
      normalizedFullName
    );
  });

  currentTeams.sort(
    (a, b) =>
      a.fullName.localeCompare(
        b.fullName
      )
  );

  return currentTeams;
}

/**
 * P35 NBA D4B — Step 3H
 *
 * Validate that the Player Game Logs completion ledger
 * contains exactly the expected NBA team IDs.
 *
 * This function is read-only.
 * It does not modify staging, production, or state.
 */
function validateP35NBAPlayerGameLogsCompletionLedger_(
  state,
  playerTeams
) {
  if (
    !state ||
    !Array.isArray(playerTeams) ||
    playerTeams.length !== 30
  ) {
    throw new Error(
      "P35 NBA D4B: Invalid pipeline state or NBA team queue."
    );
  }

  if (
    !Array.isArray(
      state.playerGameLogsCompletedTeamIds
    )
  ) {
    throw new Error(
      "P35 NBA D4B: Completion ledger is missing."
    );
  }

  const expectedIds = playerTeams.map(
    team => Number(team.id)
  );

  const completedIds =
    state.playerGameLogsCompletedTeamIds.map(
      id => Number(id)
    );

  if (
    expectedIds.some(
      id => !Number.isSafeInteger(id) || id <= 0
    ) ||
    new Set(expectedIds).size !== 30
  ) {
    throw new Error(
      "P35 NBA D4B: Expected NBA team IDs are invalid or duplicated."
    );
  }

  if (
    completedIds.length !== 30 ||
    completedIds.some(
      id => !Number.isSafeInteger(id) || id <= 0
    ) ||
    new Set(completedIds).size !== 30
  ) {
    throw new Error(
      "P35 NBA D4B: Completion ledger does not contain 30 unique valid team IDs."
    );
  }

  const expectedSet =
    new Set(expectedIds);

  const missingIds =
    expectedIds.filter(
      id => !completedIds.includes(id)
    );

  const unexpectedIds =
    completedIds.filter(
      id => !expectedSet.has(id)
    );

  if (
    missingIds.length ||
    unexpectedIds.length
  ) {
    throw new Error(
      "P35 NBA D4B: Completion ledger team mismatch. " +
      `Missing=${missingIds.join(",") || "none"}; ` +
      `Unexpected=${unexpectedIds.join(",") || "none"}.`
    );
  }

  if (
    Number(state.playerTeamIndex) !== 30
  ) {
    throw new Error(
      "P35 NBA D4B: Pipeline team index is not 30."
    );
  }

  return {
    valid: true,
    expectedTeamCount: 30,
    completedTeamCount: 30,
    runId: String(
      state.playerGameLogsRunId || ""
    )
  };
}

/**
 * P35 NBA D4B — STEP 4E
 *
 * Inspect minutes precision across all existing
 * NBA Player Game Logs staging records.
 *
 * READ ONLY:
 * - No spreadsheet writes.
 * - No API requests.
 * - No pipeline state changes.
 * - No production finalization.
 */
function testP35NBAPlayerGameLogsStoredMinutes() {

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  const sheet =
    ss.getSheetByName(
      "NBA Player Game Logs Staging"
    );

  if (!sheet) {
    throw new Error(
      "P35 NBA D4B: Staging sheet is missing."
    );
  }

  const lastRow = sheet.getLastRow();

  if (lastRow <= 1) {
    throw new Error(
      "P35 NBA D4B: Staging has no data rows."
    );
  }

  const rowCount = lastRow - 1;

  const minutesValues =
    sheet.getRange(
      2,
      7,
      rowCount,
      1
    ).getValues();

  let exactMatches = 0;
  let precisionDifferences = 0;
  let invalidValues = 0;

  const differenceSamples = [];

  minutesValues.forEach((row, index) => {

    const value = row[0];

    if (
      typeof value !== "number" ||
      !Number.isFinite(value) ||
      value < 0
    ) {
      invalidValues++;
      return;
    }

    /*
     * Reconstruct the nearest whole-second
     * minutes representation.
     */
    const totalSeconds =
      Math.round(value * 60);

    const minutes =
      Math.floor(totalSeconds / 60);

    const seconds =
      totalSeconds % 60;

    const reconstructed =
      parseNBAMinutes_(
        `${minutes}:${String(seconds).padStart(2, "0")}`
      );

    if (Object.is(value, reconstructed)) {

      exactMatches++;

    } else {

      precisionDifferences++;

      if (differenceSamples.length < 10) {

        differenceSamples.push({
          row: index + 2,
          stored: value,
          reconstructed: reconstructed,
          difference: value - reconstructed
        });

      }
    }
  });

  Logger.log(
    "=== P35 NBA D4B STEP 4E ==="
  );

  Logger.log(
    `Total records: ${rowCount}`
  );

  Logger.log(
    `Exact minutes matches: ${exactMatches}`
  );

  Logger.log(
    `Precision differences: ${precisionDifferences}`
  );

  Logger.log(
    `Invalid minutes values: ${invalidValues}`
  );

  differenceSamples.forEach(sample => {

    Logger.log(
      `Row ${sample.row} | ` +
      `Stored=${sample.stored} | ` +
      `Reconstructed=${sample.reconstructed} | ` +
      `Difference=${sample.difference}`
    );

  });

  const passed =
    exactMatches === rowCount &&
    precisionDifferences === 0 &&
    invalidValues === 0;

  Logger.log(
    `STATUS: ${passed ? "PASS" : "REVIEW REQUIRED"}`
  );

  return {
    valid: passed,
    totalRows: rowCount,
    exactMatches: exactMatches,
    precisionDifferences: precisionDifferences,
    invalidValues: invalidValues
  };
}

