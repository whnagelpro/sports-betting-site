    expectedTotalRows
  ) {
    throw new Error(
      `D3D FAILED: expected ${expectedTotalRows} staged rows after ` +
      `adding Boston, found ${stagingRowsAfter}.`
    );
  }

  const afterRows =
    stagingSheet
      .getRange(
        2,
        1,
        stagingRowsAfter,
        14
      )
      .getValues();

  const globalKeys =
    new Set();

  const atlantaKeysAfter =
    new Set();

  const bostonKeysAfter =
    new Set();

  let atlantaRowCount = 0;
  let bostonRowCount = 0;

  afterRows.forEach(
    (row, index) => {
      if (
        !Array.isArray(row) ||
        row.length !== 14
      ) {
        throw new Error(
          `D3D FAILED: staged row ${index + 1} does not have 14 columns.`
        );
      }

      const gameId =
        String(row[1] || "").trim();

      const playerId =
        String(row[2] || "").trim();

      const teamName =
        String(row[4] || "")
          .trim()
          .toLowerCase();

      if (!gameId || !playerId) {
        throw new Error(
          `D3D FAILED: staged row ${index + 1} is missing Game ID or Player ID.`
        );
      }

      const key =
        `${gameId}|${playerId}`;

      if (globalKeys.has(key)) {
        throw new Error(
          `D3D FAILED: global duplicate Game ID|Player ID key ${key}.`
        );
      }

      globalKeys.add(key);

      if (
        teamName ===
        "atlanta hawks"
