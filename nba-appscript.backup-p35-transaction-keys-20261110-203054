  /*
   * Atlanta must survive the Boston append with exact key parity.
   */
  const missingAtlantaKeys =
    Array.from(atlantaKeysBefore).filter(
      key => !atlantaKeysAfter.has(key)
    );

  const unexpectedAtlantaKeys =
    Array.from(atlantaKeysAfter).filter(
      key => !atlantaKeysBefore.has(key)
    );

  if (
    missingAtlantaKeys.length ||
    unexpectedAtlantaKeys.length
  ) {
    throw new Error(
      `D3D FAILED: Atlanta changed while Boston was appended. ` +
      `Missing Atlanta keys=${missingAtlantaKeys.length}, ` +
