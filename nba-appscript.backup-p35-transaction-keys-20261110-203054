/**
 * Installs the two PERMANENT NBA Daily Analytics triggers.
 *
 * Permanent schedule:
 *   Reset: 12 AM – 1 AM
 *   Run:   1 AM – 2 AM
 *
 * This function ONLY replaces triggers belonging to these two
 * permanent handlers. It does not touch Schedule, Rosters,
 * Game Odds, Player Props, or temporary continuation triggers.
 */
function installNBADailyAnalyticsPermanentTriggers() {

  Logger.log("==============================================");
  Logger.log("INSTALLING NBA DAILY ANALYTICS PERMANENT TRIGGERS");
  Logger.log("==============================================");

  const resetHandler =
    "resetNBADailyAnalyticsPipeline";

  const runHandler =
    "runNBADailyAnalyticsPipeline";

  const triggers =
    ScriptApp.getProjectTriggers();

  let deletedReset = 0;
  let deletedRun = 0;

  triggers.forEach(trigger => {

    const handler =
      trigger.getHandlerFunction();

    if (handler === resetHandler) {

      ScriptApp.deleteTrigger(trigger);
      deletedReset++;

    } else if (handler === runHandler) {

      ScriptApp.deleteTrigger(trigger);
      deletedRun++;

    }

  });

  Logger.log(
    `Removed existing permanent Reset triggers: ${deletedReset}`
  );

  Logger.log(
    `Removed existing permanent Run triggers: ${deletedRun}`
  );

  // Permanent daily RESET:
  // Apps Script executes this sometime during the midnight–1 AM window.
  ScriptApp
    .newTrigger(resetHandler)
    .timeBased()
    .everyDays(1)
    .atHour(0)
    .create();

  Logger.log(
    "Created permanent Reset trigger: 12 AM – 1 AM daily."
  );

  // Permanent daily RUN:
  // Apps Script executes this sometime during the 1–2 AM window.
  ScriptApp
    .newTrigger(runHandler)
    .timeBased()
    .everyDays(1)
    .atHour(1)
    .create();

  Logger.log(
    "Created permanent Run trigger: 1 AM – 2 AM daily."
  );

  const finalTriggers =
    ScriptApp.getProjectTriggers();

  const resetCount =
    finalTriggers.filter(
      trigger =>
        trigger.getHandlerFunction() === resetHandler
    ).length;

  const runCount =
    finalTriggers.filter(
      trigger =>
        trigger.getHandlerFunction() === runHandler
    ).length;

  const continuationCount =
    finalTriggers.filter(
      trigger =>
        trigger.getHandlerFunction() ===
        "continueNBADailyAnalyticsPipeline"
    ).length;

  Logger.log("----------------------------------------------");

  Logger.log(
    `Permanent Reset triggers now installed: ${resetCount}`
  );

  Logger.log(
    `Permanent Run triggers now installed: ${runCount}`
  );

  Logger.log(
    `Temporary continuation triggers currently installed: ${continuationCount}`
  );

  if (
    resetCount !== 1 ||
    runCount !== 1
  ) {

    throw new Error(
      "NBA permanent trigger installation failed. Expected exactly 1 Reset and 1 Run trigger."
    );

  }

  Logger.log("----------------------------------------------");
  Logger.log(
    "PASS: NBA has exactly one permanent Reset trigger and one permanent Run trigger."
  );

  Logger.log("==============================================");
  Logger.log("NBA PERMANENT TRIGGER INSTALLATION COMPLETE");
  Logger.log("==============================================");
}

