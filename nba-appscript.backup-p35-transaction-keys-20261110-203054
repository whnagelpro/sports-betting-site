function writeNBAOutputSheet_(sheet, headers, rows) {
  sheet.clearContents();

  sheet.getRange(1, 1, 1, headers.length).setValues([headers]);

  if (rows.length > 0) {
    sheet.getRange(2, 1, rows.length, headers.length).setValues(rows);
  }

  sheet.autoResizeColumns(1, headers.length);
}

function getNBAObjectsFromSheet_(sheet) {
  const values = sheet.getDataRange().getValues();

  if (values.length < 2) return [];

  const headers = values[0];

  return values.slice(1).map(row => {
    const obj = {};

    headers.forEach((header, index) => {
      obj[header] = row[index];
    });

    return obj;
  });
}

function avgNBA_(values) {
  const nums = values
    .map(Number)
    .filter(value => !Number.isNaN(value));

  if (!nums.length) return 0;

  return nums.reduce((sum, value) => sum + value, 0) / nums.length;
}

function stdDevNBA_(values) {
  const nums = values
    .map(Number)
    .filter(value => !Number.isNaN(value));

  if (nums.length < 2) return 0;

  const mean = avgNBA_(nums);
  const variance = avgNBA_(nums.map(value => Math.pow(value - mean, 2)));

  return Math.sqrt(variance);
}

function consistencyScoreNBA_(values) {
  const mean = avgNBA_(values);

  if (!mean) return 0;

  const cv = stdDevNBA_(values) / mean;

  return Math.max(0, Math.min(100, 100 - cv * 100));
}

function trendScoreNBA_(recentAvg, seasonAvg) {
  if (!seasonAvg) return 0;

  return ((recentAvg - seasonAvg) / seasonAvg) * 100;
}

function trendDirectionNBA_(score) {
  if (score >= 7.5) return "Up";
  if (score <= -7.5) return "Down";

  return "Flat";
}

function riskTierNBA_(consistency, absTrendScore) {
  if (consistency >= 75 && absTrendScore <= 20) return "Low";
  if (consistency >= 55) return "Medium";

  return "High";
}

function parseNBAMinutes_(value) {
  if (value === null || value === undefined || value === "") return 0;

  const str = String(value);

  if (str.includes(":")) {
    const parts = str.split(":");
    const minutes = Number(parts[0] || 0);
    const seconds = Number(parts[1] || 0);

    return minutes + seconds / 60;
  }

  const num = Number(value);

  return Number.isNaN(num) ? 0 : num;
}

function getNBAOpponentFromStat_(stat) {
  const game = stat.game || {};
  const team = stat.team || {};

  const teamId = String(team.id || "");
  const homeTeamId = String((game.home_team && game.home_team.id) || "");
  const awayTeamId = String((game.visitor_team && game.visitor_team.id) || "");

  if (teamId && teamId === homeTeamId) {
    return (game.visitor_team && game.visitor_team.full_name) || "";
  }

  if (teamId && teamId === awayTeamId) {
    return (game.home_team && game.home_team.full_name) || "";
  }

  return "";
}

function getNBAPlayerIdsForTrendPipeline_() {
  const propIds = getNBAPlayerIdsFromPlayerProps_();

  if (propIds.length > 0) {
    return propIds;
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const rosterSheet = ss.getSheetByName("Rosters");

  if (!rosterSheet) return [];

  const lastRow = rosterSheet.getLastRow();
  if (lastRow < 2) return [];

  const values = rosterSheet.getRange(2, 1, lastRow - 1, 1).getValues();

  return values
    .map(row => row[0])
    .filter(id => id !== "" && id !== null && id !== undefined)
    .map(id => String(id));
}

/**
 * ============================================================================
 * P15 D7D — NBA PLAYER PROPS TREND INDEX
 * ============================================================================
 *
 * Reuses the existing validated NBA Player Trends output.
 *
 * Provides:
 *   AC Trend Score
 *   AD Trend Strength
 *   AG Model Confidence
 *
 * Key:
 *   Player ID :: normalized Player Props market
 * ============================================================================
 */

const NBA_PROP_TREND_LABELS = Object.freeze({
  points:
    "Points",

  rebounds:
    "Rebounds",

  assists:
    "Assists",

  threes:
    "Threes",

  steals:
    "Steals",

  blocks:
    "Blocks",

  turnovers:
    "Turnovers",

  points_rebounds:
    "Points + Rebounds",

  points_assists:
    "Points + Assists",

  rebounds_assists:
    "Rebounds + Assists",

  points_rebounds_assists:
    "PRA",

  blocks_steals:
    "Blocks + Steals"
});


function buildNBAPlayerPropsTrendIndex_() {

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();


  const sheet =
    ss.getSheetByName(
      "NBA Player Trends"
    );


  if (!sheet) {
    return {};
  }


  const rows =
    getNBAObjectsFromSheet_(
      sheet
    );


  const index = {};


  rows.forEach(row => {

    const playerId =
      String(
        row["Player ID"] ?? ""
      ).trim();


    const statType =
      String(
        row["Stat Type"] ?? ""
      ).trim();


    if (
      !playerId ||
      !statType
    ) {
      return;
    }


    Object.keys(
      NBA_PROP_TREND_LABELS
    ).forEach(marketKey => {

      if (
        NBA_PROP_TREND_LABELS[
          marketKey
        ] !==
        statType
      ) {
        return;
      }


      index[
        `${playerId}::${marketKey}`
      ] = {

        trendScore:
          parseNBANumberOrNull_(
            row["Trend Score"]
          ),

        trendStrength:
          row["Trend Strength"] ??
          null,

        modelConfidence:
          calculateTrendConfidence_(
            row
          )
      };
    });
  });


  return index;
}


/**
 * Attach validated NBA trend/confidence fields to one frozen Q:T context.
 */
function enrichNBAPlayerPropContextWithTrend_(
  context,
  playerId,
  marketKey,
  trendIndex
) {

  if (!context) {
    return null;
  }


  const trend =
    (
      trendIndex &&
      trendIndex[
        `${playerId}::${marketKey}`
      ]
    ) ||
    null;


  return Object.assign(
    {},
    context,
    {

      trendScore:
        trend
          ? trend.trendScore
          : null,

      trendStrength:
        trend
          ? trend.trendStrength
          : null,

      modelConfidence:
        trend
          ? trend.modelConfidence
          : null
    }
  );
}

/**
 * ============================================================================
 * P15 D7D — NBA UNIVERSAL PLAYER PROPS PRODUCTION REFRESH
 * ============================================================================
 *
 * Direct A:AJ output.
 *
 * Removes the old:
 *   - row-2 formula-template dependency
 *   - row-3 production start
 *   - A:N-only production write
 *
 * Production rows now begin at row 2.
 * ============================================================================
 */
function refreshNBAPlayerPropsSheet() {

  const sheetName =
    "Player Props";


  const scheduleSheetName =
    "Schedule";


  const ss =
    SpreadsheetApp.getActiveSpreadsheet();


  const sheet =
    ss.getSheetByName(
      sheetName
    );


  const scheduleSheet =
    ss.getSheetByName(
      scheduleSheetName
    );


  if (!sheet) {
    throw new Error(
      `Sheet "${sheetName}" not found.`
    );
  }


  if (!scheduleSheet) {
    throw new Error(
      `Sheet "${scheduleSheetName}" not found.`
    );
  }


  Logger.log(
    "Refreshing NBA player props using universal A:AJ production output..."
  );


  // ==========================================================================
  // ENSURE PHYSICAL A:AJ WIDTH
  // ==========================================================================

  const requiredColumns =
    NBA_UNIVERSAL_PROP_HEADERS.length;


  if (
    sheet.getMaxColumns() <
    requiredColumns
  ) {

    sheet.insertColumnsAfter(
      sheet.getMaxColumns(),
      requiredColumns -
      sheet.getMaxColumns()
    );
  }


  // ==========================================================================
  // WRITE EXACT UNIVERSAL HEADERS
  // ==========================================================================

  sheet
    .getRange(
      1,
      1,
      1,
      requiredColumns
    )
    .setValues([
      NBA_UNIVERSAL_PROP_HEADERS
    ]);


  // ==========================================================================
  // CLEAR OLD PRODUCTION + LEGACY ROW-2 FORMULAS
  // ==========================================================================

  const maxRows =
    sheet.getMaxRows();


  if (
    maxRows >= 2
  ) {

    sheet
      .getRange(
        2,
        1,
        maxRows - 1,
        requiredColumns
      )
      .clearContent();
  }


  // ==========================================================================
  // SCHEDULE
  // ==========================================================================

  const games =
    getGamesFromScheduleSheet_(
      scheduleSheet
    );


  if (!games.length) {

    Logger.log(
      "No schedule rows found. NBA Player Props now contains universal A:AJ headers with no stale prop rows."
    );

    return;
  }


  // ==========================================================================
  // BUILD FROZEN HISTORICAL + TREND CONTEXT ONCE
  // ==========================================================================

  Logger.log(
    "Building NBA Player Props historical and trend context indexes..."
  );


  const contextMap =
    buildNBAPlayerPropContextMap_();


  const trendIndex =
    buildNBAPlayerPropsTrendIndex_();


  const playerLookupMap =
    getNBAPlayerLookupMap_();


  Logger.log(
    "NBA Player Props universal context indexes built."
  );


  // ==========================================================================
  // FETCH + BUILD UNIVERSAL ROWS
  // ==========================================================================

  const allRows = [];


  games.forEach(
    (game, index) => {

      Logger.log(
        `Fetching NBA props for game ${index + 1}/${games.length} (ID: ${game.id})`
      );


      const props =
        fetchAllNBAPlayerPropsForGame_(
          game.id
        );


      props.forEach(prop => {

        const market =
          (
            prop.market &&
            typeof prop.market ===
              "object"
          )
            ? prop.market
            : {};


        const playerId =
          String(
            prop.player_id ??
            (
              prop.player &&
              prop.player.id
            ) ??
            ""
          ).trim();


        const propType =
          String(
            prop.prop_type ??
            (
              typeof prop.market ===
                "string"
                ? prop.market
                : ""
            ) ??
            ""
          ).trim();


        const marketKey =
          normalizeNBAPropMarket_(
            propType
          );


        const rawContext =
          (
            playerId &&
            marketKey &&
            contextMap[
              playerId
            ]
          )
            ? contextMap[
                playerId
              ][
                marketKey
              ] ||
              null
            : null;


        const modeledContext =
          enrichNBAPlayerPropContextWithTrend_(
            rawContext,
            playerId,
            marketKey,
            trendIndex
          );


        const rosterIdentity =
          (
            playerId &&
            playerLookupMap[
              playerId
            ]
          )
            ? playerLookupMap[
                playerId
              ]
            : null;


        const context =
          modeledContext
            ? Object.assign(
                {},
                modeledContext,
                {
                  playerName:
                    modeledContext.playerName ||
                    (
                      rosterIdentity
                        ? rosterIdentity.playerName
                        : ""
                    ),

                  team:
                    modeledContext.team ||
                    (
                      rosterIdentity
                        ? rosterIdentity.team
                        : ""
                    )
                }
              )
            : (
                rosterIdentity
                  ? {
                      playerName:
                        rosterIdentity.playerName ||
                        "",

                      team:
                        rosterIdentity.team ||
                        ""
                    }
                  : null
              );


        const rawProp = {

          gameId:
            game.id ?? "",

          gameDate:
            game.game_date ?? "",

          awayTeam:
            game.away_team ?? "",

          homeTeam:
            game.home_team ?? "",

          id:
            prop.id ?? "",

          playerId,

          vendor:
            prop.vendor ??
            prop.sportsbook ??
            prop.bookmaker ??
            "",

          propType,

          lineValue:
            prop.line ??
            prop.line_value ??
            "",

          type:
            market.type ??
            "",

          odds:
            market.odds ??
            "",

          updatedAt:
            prop.updated_at ??
            "",

          overOdds:
            market.over_odds ??
            "",

          underOdds:
            market.under_odds ??
            ""
        };


        const row =
          buildNBAUniversalPropRowFromProvider_(
            rawProp,
            context
          );


        if (
          !Array.isArray(row) ||
          row.length !==
            requiredColumns
        ) {

          throw new Error(
            `Invalid NBA universal Player Props row for player ${playerId || "UNKNOWN"}.`
          );
        }


        allRows.push(
          row
        );
      });


      Utilities.sleep(
        200
      );
    }
  );


  // ==========================================================================
  // NO PROVIDER PROPS
  // ==========================================================================

  if (
    !allRows.length
  ) {

    Logger.log(
      "No NBA player props were returned for the schedule slate. Universal A:AJ headers remain with no stale rows."
    );

    return;
  }


  // ==========================================================================
  // WRITE DIRECT A:AJ VALUES STARTING ROW 2
  // ==========================================================================

  sheet
    .getRange(
      2,
      1,
      allRows.length,
      requiredColumns
    )
    .setValues(
      allRows
    );


  Logger.log(
    `Wrote ${allRows.length} NBA universal Player Props rows to "${sheetName}" across A:AJ.`
  );
}

