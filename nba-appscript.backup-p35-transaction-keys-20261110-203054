/**
 * P35 NBA D4B — STEP 5Y
 *
 * READ-ONLY staging data integrity audit.
 *
 * No spreadsheet writes.
 * No API requests.
 * No PropertiesService modifications.
 * No production finalization.
 *
 * Reports aggregate findings only.
 */
function testP35NBAPlayerGameLogsDataIntegrityReadOnly() {

  Logger.log("=== P35 NBA D4B STEP 5Y ===");

  const ss = SpreadsheetApp.getActiveSpreadsheet();

  if (!ss) {
    throw new Error("No active spreadsheet.");
  }

  const sheet = ss.getSheetByName(
    "NBA Player Game Logs Staging"
  );

  if (!sheet) {
    Logger.log("STATUS: STAGING SHEET MISSING");
    return;
  }

  const expectedHeaders = [
    "Game Date",
    "Game ID",
    "Player ID",
    "Player Name",
    "Team",
    "Opponent",
    "Minutes",
    "Points",
    "Rebounds",
    "Assists",
    "Threes",
    "Steals",
    "Blocks",
    "Turnovers"
  ];

  if (sheet.getLastColumn() !== 14) {
    Logger.log("STATUS: COLUMN COUNT MISMATCH");
    return;
  }

  const headers = sheet.getRange(
    1, 1, 1, 14
  ).getDisplayValues()[0];

  if (
    headers.some(
      (header, index) =>
        String(header).trim() !==
        expectedHeaders[index]
    )
  ) {
    Logger.log("STATUS: HEADER MISMATCH");
    return;
  }

  const rowCount = Math.max(
    0,
    sheet.getLastRow() - 1
  );

  Logger.log("Staging rows: " + rowCount);

  if (rowCount === 0) {
    Logger.log("STATUS: EMPTY STAGING");
    return;
  }

  /*
   * Read the existing 14-column staging rows.
   * Do not log individual player records.
   */

  const rows = sheet.getRange(
    2, 1, rowCount, 14
  ).getValues();

  const teams = new Set();
  const seenKeys = new Set();

  let missingRequired = 0;
  let duplicateRows = 0;
  let invalidStats = 0;
  let missingStats = 0;

  rows.forEach(row => {

    const required = row.slice(0, 6);

    if (
      required.some(
        value =>
          value === "" ||
          value === null ||
          value === undefined
      )
    ) {
      missingRequired++;
    }

    const gameId = String(row[1] || "").trim();
    const playerId = String(row[2] || "").trim();

    if (gameId && playerId) {

      const key = gameId + "|" + playerId;

      if (seenKeys.has(key)) {
        duplicateRows++;
      } else {
        seenKeys.add(key);
      }

    }

    const teamName = String(
      row[4] || ""
    )
      .trim()
      .toLowerCase()
      .replace(/\s+/g, " ");

    if (teamName) {
      teams.add(teamName);
    }

    /*
     * Minutes and statistics occupy G:N.
     */

    row.slice(6, 14).forEach(value => {

      if (
        value === "" ||
        value === null ||
        value === undefined
      ) {
        missingStats++;
        return;
      }

      const numericValue = Number(value);

      if (
        !Number.isFinite(numericValue) ||
        numericValue < 0
      ) {
        invalidStats++;
      }

    });

  });

  Logger.log(
    "Distinct staging teams: " +
    teams.size
  );

  Logger.log(
    "Rows missing required fields: " +
    missingRequired
  );

  Logger.log(
    "Duplicate game/player rows: " +
    duplicateRows
  );

  Logger.log(
    "Missing statistic cells: " +
    missingStats
  );

  Logger.log(
    "Invalid statistic cells: " +
    invalidStats
  );

  Logger.log(
    "STATUS: READ-ONLY AUDIT COMPLETE"
  );

}

