  if (
    !state ||
    typeof state !== "object" ||
    Array.isArray(state)
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Invalid version state."
    );
  }

  const allowedStatuses = [
    "PREPARED",
    "VERIFIED",
    "COMMITTED"
  ];

  if (
    !allowedStatuses.includes(state.status)
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Invalid transaction status."
    );
  }

  function validIdentifier(value) {
    return (
      typeof value === "string" &&
      value.length > 0 &&
      value.length <= 200 &&
      value === value.trim() &&
      /^[A-Za-z0-9_-]+$/.test(value)
    );
  }

  if (!validIdentifier(state.runId)) {
    throw new Error(
      "P35 NBA Team Game Logs: Invalid transaction run ID."
    );
  }

  if (!validIdentifier(state.versionId)) {
    throw new Error(
      "P35 NBA Team Game Logs: Invalid transaction version ID."
    );
  }

  if (
    typeof state.sheetName !== "string" ||
    state.sheetName.length === 0 ||
    state.sheetName.length > 100 ||
    state.sheetName !== state.sheetName.trim() ||
    !/^[A-Za-z0-9 _-]+$/.test(state.sheetName)
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Invalid staging sheet name."
    );
  }

  if (
    !Number.isSafeInteger(state.expectedRowCount) ||
    state.expectedRowCount <= 0
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Invalid expected row count."
    );
  }

  if (
    typeof state.expectedFingerprint !== "string" ||
    !/^[a-f0-9]{64}$/.test(
      state.expectedFingerprint
    )
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Invalid expected fingerprint."
    );
  }

  return {
    valid: true,
    status: state.status,
    runId: state.runId,
    versionId: state.versionId,
    sheetName: state.sheetName,
    expectedRowCount: state.expectedRowCount,
    expectedFingerprint: state.expectedFingerprint
  };
}


// ============================================================================
// P35 NBA — DETERMINISTIC TEAM GAME LOGS SHA-256 FINGERPRINT
// ============================================================================

function calculateP35NBATeamGameLogsFingerprint_(
  rows
) {
  /*
   * Read-only deterministic fingerprint.
   *
   * - Requires exactly 10 columns per row.
   * - Validates each team's game logs.
   * - Normalizes dates using America/Phoenix.
   * - Canonicalizes numeric values.
   * - Ignores row ordering.
   * - Does not access spreadsheets or pipeline state.
   */

  if (
    !Array.isArray(rows) ||
    rows.length === 0
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Cannot fingerprint empty rows."
    );
  }

  const normalizedRows = rows.map(
    normalizeP35NBATeamGameLogStagingRow_
  );

  function teamKey(value) {
    return String(value)
      .toLowerCase()
      .replace(/\./g, "")
      .replace(/\s+/g, " ")
      .trim();
  }

  const teams = new Map();

  normalizedRows.forEach(row => {
    const key = teamKey(row[2]);

    if (!key) {
      throw new Error(
        "P35 NBA Team Game Logs: Missing team in fingerprint input."
      );
    }

    if (!teams.has(key)) {
      teams.set(key, {
        name: row[2],
        rows: []
      });
    }

    teams.get(key).rows.push(row);
  });

  teams.forEach(group => {
    validateP35NBATeamGameLogStagingRows_(
      group.name,
      group.rows
    );
  });

  const serializedRows = normalizedRows.map(row => {
    const canonical = row.map((value, index) => {
      if (
        index === 1 ||
        index >= 4
      ) {
        return String(Number(value));
      }

      if (index === 2 || index === 3) {
        return teamKey(value);
      }

      return String(value).trim();
    });

    return JSON.stringify(canonical);
  });

  serializedRows.sort();

  const serializedData =
    JSON.stringify(serializedRows);

  const digest = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    serializedData,
    Utilities.Charset.UTF_8
  );

  return digest
    .map(byte => {
      const unsignedByte = byte & 0xff;

      return unsignedByte
        .toString(16)
        .padStart(2, "0");
    })
    .join("");
}


// ============================================================================
// P35 NBA — TEAM GAME LOGS CANDIDATE SHEET IDENTITY VALIDATOR
// ============================================================================

function validateP35NBATeamGameLogCandidateIdentity_(
  state
) {
  /*
   * Pure candidate-sheet identity validation.
   *
   * No spreadsheet access.
   * No Script Properties access.
   * No API requests.
   * No pipeline state mutations.
   *
   * Validates deterministic candidate naming.
   * Does not establish ownership of an existing sheet.
   */

  const validated =
    validateP35NBATeamGameLogVersionState_(state);

  const expectedSheetName =
    "P35 NBA TGL CAND " +
    validated.runId +
    " " +
    validated.versionId;

  if (expectedSheetName.length > 100) {
    throw new Error(
      "P35 NBA Team Game Logs: Candidate sheet name exceeds 100 characters."
    );
  }

  const protectedNames = [
    "NBA Team Game Logs",
    "NBA Team Game Logs Staging",
    "NBA Player Game Logs",
    "NBA Player Game Logs Staging"
  ];

  if (
    protectedNames.some(
      name =>
        name.toLowerCase() ===
        validated.sheetName.toLowerCase()
    )
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Protected sheet name cannot be used as candidate."
    );
  }

  if (
    validated.sheetName !== expectedSheetName
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Candidate sheet identity mismatch."
    );
  }

  return {
    valid: true,
    runId: validated.runId,
    versionId: validated.versionId,
    sheetName: validated.sheetName,
    status: validated.status,
    expectedRowCount: validated.expectedRowCount,
    expectedFingerprint: validated.expectedFingerprint
  };
}
