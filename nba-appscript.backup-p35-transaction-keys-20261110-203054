/**
 * Call any BALLDONTLIE API endpoint directly
 * @param {string} endpoint The API endpoint (e.g., "/nba/v1/teams")
 * @param {string} paramsJson Optional JSON string of query parameters
 * @returns {Array} API response data
 * @customfunction
 */
function BDL_API(endpoint, paramsJson) {
  if (!endpoint) throw new Error('Endpoint is required');
  let params = {};
  if (paramsJson) {
    try {
      params = JSON.parse(paramsJson);
    } catch (e) {
      throw new Error('Invalid JSON parameters: ' + e.message);
    }
  }
  const response = fetchApi_(endpoint, params);
  return toSheet_(response.data);
}


/**
 * P35 NBA — Team Game Logs raw statistics validation.
 *
 * Pure validation helper:
 * - No SpreadsheetApp calls
 * - No PropertiesService calls
 * - No API calls
 * - No production writes
 *
 * Returns validated team totals for one completed game.
 */
function validateP35NBATeamGameLogStatCoverage_(
  game,
  statRows
) {
  if (!game || !Array.isArray(statRows)) {
    throw new Error(
      "P35 NBA Team Game Logs: Invalid game or statistics input."
    );
  }

  const gameId = String(game.id || "").trim();

  const homeTeam = game.home_team || {};
  const awayTeam = game.visitor_team || {};

  const homeTeamId = Number(homeTeam.id);
  const awayTeamId = Number(awayTeam.id);

  if (
    !gameId ||
    !Number.isInteger(homeTeamId) ||
    !Number.isInteger(awayTeamId) ||
    homeTeamId <= 0 ||
    awayTeamId <= 0 ||
    homeTeamId === awayTeamId
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Invalid game/team identity."
    );
  }

  if (
    game.home_team_score === null ||
    game.home_team_score === undefined ||
    game.home_team_score === "" ||
    game.visitor_team_score === null ||
    game.visitor_team_score === undefined ||
    game.visitor_team_score === ""
  ) {
    throw new Error(
      `P35 NBA Team Game Logs: Missing final score for ${gameId}.`
    );
  }

  const homeScore = Number(game.home_team_score);
  const awayScore = Number(game.visitor_team_score);

  if (
    !Number.isFinite(homeScore) ||
    !Number.isFinite(awayScore) ||
    homeScore < 0 ||
    awayScore < 0
  ) {
    throw new Error(
      `P35 NBA Team Game Logs: Invalid final score for ${gameId}.`
    );
  }

  const createTotals = () => ({
    points: 0,
    rebounds: 0,
    assists: 0,
    threes: 0,
    turnovers: 0,
    participatingPlayers: 0
  });

  const totals = {
    [homeTeamId]: createTotals(),
    [awayTeamId]: createTotals()
  };

  const seenPlayerKeys = new Set();

  statRows.forEach(stat => {
    if (!stat) return;

    const statGameId = String(
      stat.game_id ||
      (stat.game && stat.game.id) ||
      ""
    ).trim();

    if (statGameId !== gameId) {
      return;
    }

    const teamId = Number(
      stat.team_id !== undefined &&
      stat.team_id !== null
        ? stat.team_id
        : stat.team && stat.team.id
    );

    if (
      teamId !== homeTeamId &&
      teamId !== awayTeamId
    ) {
      throw new Error(
        `P35 NBA Team Game Logs: Unexpected team ${teamId} in game ${gameId}.`
      );
    }

    const minutesRaw = stat.min;

    if (
      minutesRaw === null ||
      minutesRaw === undefined ||
      String(minutesRaw).trim() === ""
    ) {
      return;
    }

    const minutesText = String(minutesRaw).trim();

    const validMinutes =
      /^(?:\d+|\d+:\d{1,2})$/.test(minutesText);

    if (!validMinutes) {
      throw new Error(
        `P35 NBA Team Game Logs: Invalid minutes "${minutesText}" in game ${gameId}.`
      );
    }

    let minutesPlayed;

    if (minutesText.includes(":")) {
      const parts = minutesText.split(":");
      const wholeMinutes = Number(parts[0]);
      const seconds = Number(parts[1]);

      if (seconds >= 60) {
        throw new Error(
          `P35 NBA Team Game Logs: Invalid seconds in "${minutesText}".`
        );
      }

      minutesPlayed = wholeMinutes + seconds / 60;
    } else {
      minutesPlayed = Number(minutesText);
    }

    if (
      !Number.isFinite(minutesPlayed) ||
      minutesPlayed < 0
    ) {
      throw new Error(
        `P35 NBA Team Game Logs: Invalid minutes for game ${gameId}.`
      );
    }

    if (minutesPlayed === 0) {
      return;
    }

    const playerId = String(
      stat.player_id ||
      (stat.player && stat.player.id) ||
      ""
    ).trim();

    if (!playerId) {
      throw new Error(
        `P35 NBA Team Game Logs: Missing player ID in game ${gameId}.`
      );
    }

    const playerKey = `${teamId}:${playerId}`;

    if (seenPlayerKeys.has(playerKey)) {
      throw new Error(
        `P35 NBA Team Game Logs: Duplicate player ${playerKey} in game ${gameId}.`
      );
    }

    seenPlayerKeys.add(playerKey);

    const fields = [
      ["pts", "points"],
      ["reb", "rebounds"],
      ["ast", "assists"],
      ["fg3m", "threes"]
    ];

    fields.forEach(([apiField, outputField]) => {
      const raw = stat[apiField];

      if (
        raw === null ||
        raw === undefined ||
        raw === "" ||
        !Number.isFinite(Number(raw)) ||
        Number(raw) < 0
      ) {
        throw new Error(
          `P35 NBA Team Game Logs: Invalid ${apiField} for player ${playerId}.`
        );
      }

      totals[teamId][outputField] += Number(raw);
    });

    const rawTurnovers =
      stat.turnover !== undefined &&
      stat.turnover !== null
        ? stat.turnover
        : stat.turnovers;

    if (
      rawTurnovers === null ||
      rawTurnovers === undefined ||
      rawTurnovers === "" ||
      !Number.isFinite(Number(rawTurnovers)) ||
      Number(rawTurnovers) < 0
    ) {
      throw new Error(
        `P35 NBA Team Game Logs: Invalid turnovers for player ${playerId}.`
      );
    }

    totals[teamId].turnovers += Number(rawTurnovers);
    totals[teamId].participatingPlayers++;
  });

  if (
    totals[homeTeamId].participatingPlayers === 0 ||
    totals[awayTeamId].participatingPlayers === 0
  ) {
    throw new Error(
      `P35 NBA Team Game Logs: Missing participating-player coverage for ${gameId}.`
    );
  }

  if (
    totals[homeTeamId].points !== homeScore ||
    totals[awayTeamId].points !== awayScore
  ) {
    throw new Error(
      `P35 NBA Team Game Logs: Player point totals do not match final score for ${gameId}.`
    );
  }

  return {
    gameId,
    homeTeamId,
    awayTeamId,
    home: totals[homeTeamId],
    away: totals[awayTeamId]
  };
}


/**
 * P35 NBA — Team-scoped Team Game Logs row builder.
 *
 * Returns rows for exactly one requested team.
 *
 * READ-ONLY with respect to spreadsheets and pipeline state.
 * Existing discovery/statistics helpers perform NBA API requests.
 *
 * Output schema:
 * Game Date, Game ID, Team, Opponent,
 * Points For, Points Allowed, Rebounds,
 * Assists, Threes, Turnovers
 */
function buildP35NBATeamGameLogRowsForTeam_(
  teamId,
  startDate,
  endDate
) {
  const numericTeamId = Number(teamId);

  if (
    !Number.isInteger(numericTeamId) ||
    numericTeamId <= 0
  ) {
    throw new Error(
      `P35 NBA Team Game Logs: Invalid team ID ${teamId}.`
    );
  }

  const start = new Date(startDate);
  const end = new Date(endDate);

  if (
    Number.isNaN(start.getTime()) ||
    Number.isNaN(end.getTime()) ||
    start > end
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Invalid date range."
    );
  }

  const games = getNBACompletedGamesForTeam_(
    numericTeamId,
    start,
    end
  );

  if (!Array.isArray(games)) {
    throw new Error(
      "P35 NBA Team Game Logs: Game discovery returned invalid data."
    );
  }

  if (games.length === 0) {
    throw new Error(
      `P35 NBA Team Game Logs: No completed games found for team ${numericTeamId}. Refusing an empty refresh.`
    );
  }

  const gameIds = games.map(game => {
    const gameId = String(game && game.id || "").trim();

    if (!gameId) {
      throw new Error(
        "P35 NBA Team Game Logs: Completed game missing ID."
      );
    }

    return gameId;
  });

  if (new Set(gameIds).size !== gameIds.length) {
    throw new Error(
      "P35 NBA Team Game Logs: Duplicate completed game IDs."
    );
  }

  const allStats = fetchAllNBAStatsForGameIds_(gameIds);

  if (!Array.isArray(allStats)) {
    throw new Error(
      "P35 NBA Team Game Logs: Invalid statistics response."
    );
  }

  const rows = [];

  games.forEach(game => {
    const gameId = String(game.id).trim();

    const relevantStats = allStats.filter(stat =>
      String(
        stat && (
          stat.game_id ||
          (stat.game && stat.game.id)
        ) || ""
      ).trim() === gameId
    );

    const coverage =
      validateP35NBATeamGameLogStatCoverage_(
        game,
        relevantStats
      );

    const homeTeam = game.home_team || {};
    const awayTeam = game.visitor_team || {};

    const isHome = Number(homeTeam.id) === numericTeamId;
    const isAway = Number(awayTeam.id) === numericTeamId;

    if (isHome === isAway) {
      throw new Error(
        `P35 NBA Team Game Logs: Team ${numericTeamId} does not uniquely match game ${gameId}.`
      );
    }

    const team = isHome ? homeTeam : awayTeam;
    const opponent = isHome ? awayTeam : homeTeam;

    const teamTotals = isHome
      ? coverage.home
      : coverage.away;

    const opponentTotals = isHome
      ? coverage.away
      : coverage.home;

    const gameDate = getNBAGameAZDate_(game);

    if (
      !gameDate ||
      !/^\d{4}-\d{2}-\d{2}$/.test(gameDate)
    ) {
      throw new Error(
        `P35 NBA Team Game Logs: Invalid Arizona game date for ${gameId}.`
      );
    }

    const teamName = String(team.full_name || "").trim();
    const opponentName = String(opponent.full_name || "").trim();

    if (!teamName || !opponentName) {
      throw new Error(
        `P35 NBA Team Game Logs: Missing team name for ${gameId}.`
      );
    }

    rows.push([
      gameDate,
      gameId,
      teamName,
      opponentName,
      teamTotals.points,
      opponentTotals.points,
      teamTotals.rebounds,
      teamTotals.assists,
      teamTotals.threes,
      teamTotals.turnovers
    ]);
  });

  return rows;
}


/**
 * P35 NBA — Team Game Logs staging payload validator.
 *
 * Pure function:
 * - No spreadsheet access
 * - No API requests
 * - No pipeline state changes
 *
 * Validates one team's complete staging payload.
 */
function validateP35NBATeamGameLogStagingRows_(
  targetTeamName,
  rows
) {
  /*
   * P35 NBA — Strict Team Game Logs staging validation.
   *
   * Pure function:
   * - No API requests
   * - No spreadsheet access
   * - No pipeline state changes
   */

  function normalizeTeamName(value) {
    if (typeof value !== "string") {
      return "";
    }

    return value
      .toLowerCase()
      .replace(/\./g, "")
      .replace(/\s+/g, " ")
      .trim();
  }

  function isValidCalendarDate(value) {
    if (
      typeof value !== "string" ||
      !/^\d{4}-\d{2}-\d{2}$/.test(value)
    ) {
      return false;
    }

    const parts = value.split("-").map(Number);

    const year = parts[0];
    const month = parts[1];
    const day = parts[2];

    if (
      year < 2000 ||
      year > 2100 ||
      month < 1 ||
      month > 12 ||
      day < 1
    ) {
      return false;
    }

    const leapYear =
      year % 4 === 0 &&
      (year % 100 !== 0 || year % 400 === 0);

    const daysInMonth = [
      31,
      leapYear ? 29 : 28,
      31,
      30,
      31,
      30,
      31,
      31,
      30,
      31,
      30,
      31
    ];

    return day <= daysInMonth[month - 1];
  }

  function isValidGameId(value) {
    if (
      typeof value !== "string" &&
      typeof value !== "number"
    ) {
      return false;
    }

    const text = String(value).trim();

    if (!/^[1-9]\d*$/.test(text)) {
      return false;
    }

    const numeric = Number(text);

    return (
      Number.isSafeInteger(numeric) &&
      numeric > 0
    );
  }

  function isValidStatistic(value) {
    if (
      typeof value !== "string" &&
      typeof value !== "number"
    ) {
      return false;
    }

    if (
      typeof value === "string" &&
      !/^\d+$/.test(value.trim())
    ) {
      return false;
    }

    const numeric = Number(value);

    return (
      Number.isSafeInteger(numeric) &&
      numeric >= 0
    );
  }

  const targetKey =
    normalizeTeamName(targetTeamName);

  if (!targetKey) {
    throw new Error(
      "P35 NBA Team Game Logs: Missing target team name."
    );
  }

  if (
    !Array.isArray(rows) ||
    rows.length === 0
  ) {
    throw new Error(
      `P35 NBA Team Game Logs: Empty or invalid staging rows for ${targetTeamName}.`
    );
  }

  const seenGameIds = new Set();

  rows.forEach((row, index) => {
    const rowNumber = index + 1;

    if (
      !Array.isArray(row) ||
      row.length !== 10
    ) {
      throw new Error(
        `P35 NBA Team Game Logs: Row ${rowNumber} must contain exactly 10 columns.`
      );
    }

    const gameDate = row[0];
    const gameId = row[1];

    const teamKey =
      normalizeTeamName(row[2]);

    const opponentKey =
      normalizeTeamName(row[3]);

    if (!isValidCalendarDate(gameDate)) {
      throw new Error(
        `P35 NBA Team Game Logs: Invalid Game Date in row ${rowNumber}.`
      );
    }

    if (!isValidGameId(gameId)) {
      throw new Error(
        `P35 NBA Team Game Logs: Missing or invalid Game ID in row ${rowNumber}.`
      );
    }

    if (teamKey !== targetKey) {
      throw new Error(
        `P35 NBA Team Game Logs: Incorrect team in row ${rowNumber}.`
      );
    }

    if (
      !opponentKey ||
      opponentKey === teamKey
    ) {
      throw new Error(
        `P35 NBA Team Game Logs: Invalid opponent in row ${rowNumber}.`
      );
    }

    const gameIdKey = String(Number(gameId));

    if (seenGameIds.has(gameIdKey)) {
      throw new Error(
        `P35 NBA Team Game Logs: Duplicate Game ID ${gameIdKey}.`
      );
    }

    seenGameIds.add(gameIdKey);

    for (
      let column = 4;
      column < 10;
      column++
    ) {
      if (!isValidStatistic(row[column])) {
        throw new Error(
          `P35 NBA Team Game Logs: Invalid statistic in row ${rowNumber}, column ${column + 1}.`
        );
      }
    }
  });

  return {
    teamName: String(targetTeamName).trim(),
    rowCount: rows.length,
    uniqueGameCount: seenGameIds.size
  };
}


// ============================================================================
// P35 NBA — TEAM GAME LOGS STAGING INITIALIZATION
// ============================================================================

function ensureP35NBATeamGameLogsStaging_() {
  /*
   * Non-destructive staging initializer.
   *
   * Creates the staging sheet only when missing.
   * Never clears existing staging data.
   * Never touches production Team Game Logs.
   */

  const sheetName =
    "NBA Team Game Logs Staging";

  const expectedHeaders = [
    "Game Date",
    "Game ID",
    "Team",
    "Opponent",
    "Points For",
    "Points Allowed",
    "Rebounds",
    "Assists",
    "Threes",
    "Turnovers"
  ];

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();

  let sheet =
    ss.getSheetByName(sheetName);

  if (!sheet) {
    sheet = ss.insertSheet(sheetName);

    sheet
      .getRange(
        1,
        1,
        1,
        expectedHeaders.length
      )
      .setValues([expectedHeaders]);

    sheet
      .getRange("A:A")
      .setNumberFormat("yyyy-mm-dd");

    Logger.log(
      "P35 NBA Team Game Logs staging sheet created."
    );

    return {
      sheetName,
      created: true,
      existingDataRows: 0
    };
  }

  const lastRow =
    sheet.getLastRow();

  const lastColumn =
    sheet.getLastColumn();

  if (
    lastRow < 1 ||
    lastColumn !== expectedHeaders.length
  ) {
    throw new Error(
      `P35 NBA Team Game Logs staging schema mismatch: ` +
      `expected ${expectedHeaders.length} columns; ` +
      `found ${lastColumn}.`
    );
  }

  const actualHeaders =
    sheet
      .getRange(
        1,
        1,
        1,
        expectedHeaders.length
      )
      .getDisplayValues()[0]
      .map(value =>
        String(value || "").trim()
      );

  expectedHeaders.forEach(
    (expected, index) => {
      if (
        actualHeaders[index] !== expected
      ) {
        throw new Error(
          `P35 NBA Team Game Logs staging header mismatch ` +
          `at column ${index + 1}: expected "${expected}", ` +
          `found "${actualHeaders[index]}".`
        );
      }
    }
  );

  const existingDataRows =
    lastRow - 1;

  Logger.log(
    `P35 NBA Team Game Logs staging verified: ` +
    `${existingDataRows} existing data rows preserved.`
  );

  return {
    sheetName,
    created: false,
    existingDataRows
  };
}


// ============================================================================
// P35 NBA — TEAM GAME LOGS STAGING ROW NORMALIZATION
// ============================================================================

function normalizeP35NBATeamGameLogStagingRow_(row) {
  /*
   * Pure normalization helper.
   *
   * Accepts:
   * - YYYY-MM-DD date strings
   * - Valid JavaScript Date objects
   *
   * Returns a new 10-column row.
   *
   * Does not access spreadsheets or modify the input.
   */

  if (
    !Array.isArray(row) ||
    row.length !== 10
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Staging row must contain exactly 10 columns."
    );
  }

  const normalized = row.slice();

  const dateValue = row[0];

  if (dateValue instanceof Date) {
    if (
      !Number.isFinite(dateValue.getTime())
    ) {
      throw new Error(
        "P35 NBA Team Game Logs: Invalid staging Date object."
      );
    }

    normalized[0] =
      Utilities.formatDate(
        dateValue,
        "America/Phoenix",
        "yyyy-MM-dd"
      );

  } else if (
    typeof dateValue === "string"
  ) {
    normalized[0] =
      dateValue.trim();

  } else {
    throw new Error(
      "P35 NBA Team Game Logs: Unsupported staging date type."
    );
  }

  if (
    !/^\d{4}-\d{2}-\d{2}$/.test(
      normalized[0]
    )
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Invalid normalized staging date."
    );
  }

  return normalized;
}


// ============================================================================
// P35 NBA — TEAM GAME LOGS STAGING REPLACEMENT PLANNER
// ============================================================================

function planP35NBATeamGameLogStagingReplacement_(
  targetTeamName,
  existingRows,
  incomingRows
) {
  /*
   * Pure, read-only staging replacement planner.
   *
   * No spreadsheet operations.
   * No API calls.
   * No pipeline state changes.
   *
   * Produces a proposed complete staging dataset.
   * Does not perform the replacement.
   */

  function teamKey(value) {
    return typeof value === "string"
      ? value.toLowerCase()
          .replace(/\./g, "")
          .replace(/\s+/g, " ")
          .trim()
      : "";
  }

  const targetKey = teamKey(targetTeamName);

  if (!targetKey) {
    throw new Error(
      "P35 NBA Team Game Logs: Missing replacement target."
    );
  }

  if (
    !Array.isArray(existingRows) ||
    !Array.isArray(incomingRows)
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Replacement inputs must be arrays."
    );
  }

  const normalizedIncoming =
    incomingRows.map(
      normalizeP35NBATeamGameLogStagingRow_
    );

  validateP35NBATeamGameLogStagingRows_(
    targetTeamName,
    normalizedIncoming
  );

  const normalizedExisting =
    existingRows.map(
      normalizeP35NBATeamGameLogStagingRow_
    );

  const previousTargetRows = [];
  const preservedOtherRows = [];

  normalizedExisting.forEach(row => {
    if (teamKey(row[2]) === targetKey) {
      previousTargetRows.push(row);
    } else {
      preservedOtherRows.push(row);
    }
  });

  if (previousTargetRows.length > 0) {
    validateP35NBATeamGameLogStagingRows_(
      targetTeamName,
      previousTargetRows
    );
  }

  const otherTeams = new Map();

  preservedOtherRows.forEach(row => {
    const key = teamKey(row[2]);

    if (!key) {
      throw new Error(
        "P35 NBA Team Game Logs: Existing staging row has no team."
      );
    }

    if (!otherTeams.has(key)) {
      otherTeams.set(key, {
        name: row[2],
        rows: []
      });
    }

    otherTeams.get(key).rows.push(row);
  });

  otherTeams.forEach(group => {
    validateP35NBATeamGameLogStagingRows_(
      group.name,
      group.rows
    );
  });

  const proposedRows = [
    ...preservedOtherRows,
    ...normalizedIncoming
  ];

  if (
    proposedRows.length !==
    preservedOtherRows.length +
      normalizedIncoming.length
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Replacement row-count mismatch."
    );
  }

  return {
    targetTeamName: String(targetTeamName).trim(),
    previousTargetRowCount:
      previousTargetRows.length,
    preservedOtherRowCount:
      preservedOtherRows.length,
    incomingRowCount:
      normalizedIncoming.length,
    proposedRowCount:
      proposedRows.length,
    previousTargetRows,
    preservedOtherRows,
    incomingRows: normalizedIncoming,
    proposedRows
  };
}


// ============================================================================
// P35 NBA — TEAM GAME LOGS STAGING VERSION COMMIT VALIDATOR
// ============================================================================

function validateP35NBATeamGameLogVersionCommit_(
  evidence
) {
  /*
   * Pure validation helper.
   *
   * Verifies commit eligibility using supplied evidence.
   *
   * Does not:
   * - Read or write spreadsheets
   * - Access script properties
   * - Change authoritative staging versions
   * - Modify pipeline state
   */

  if (
    !evidence ||
    typeof evidence !== "object" ||
    Array.isArray(evidence)
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Invalid commit evidence."
    );
  }

  const {
    expectedRunId,
    actualRunId,
    candidateVersionId,
    expectedRowCount,
    actualRowCount,
    expectedFingerprint,
    actualFingerprint
  } = evidence;

  function validIdentifier(value) {
    return (
      typeof value === "string" &&
      value.trim().length > 0 &&
      value === value.trim() &&
      value.length <= 200 &&
      /^[A-Za-z0-9_-]+$/.test(value)
    );
  }

  if (
    !validIdentifier(expectedRunId) ||
    !validIdentifier(actualRunId) ||
    expectedRunId !== actualRunId
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Commit run identity mismatch."
    );
  }

  if (!validIdentifier(candidateVersionId)) {
    throw new Error(
      "P35 NBA Team Game Logs: Invalid candidate version ID."
    );
  }

  if (
    !Number.isSafeInteger(expectedRowCount) ||
    expectedRowCount <= 0 ||
    !Number.isSafeInteger(actualRowCount) ||
    actualRowCount !== expectedRowCount
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Commit row-count mismatch."
    );
  }

  const fingerprintPattern = /^[a-f0-9]{64}$/;

  if (
    typeof expectedFingerprint !== "string" ||
    typeof actualFingerprint !== "string" ||
    !fingerprintPattern.test(expectedFingerprint) ||
    !fingerprintPattern.test(actualFingerprint) ||
    expectedFingerprint !== actualFingerprint
  ) {
    throw new Error(
      "P35 NBA Team Game Logs: Commit fingerprint mismatch."
    );
  }

  return {
    valid: true,
    runId: expectedRunId,
    versionId: candidateVersionId,
    rowCount: actualRowCount,
    fingerprint: actualFingerprint
  };
}


// ============================================================================
// P35 NBA — TEAM GAME LOGS VERSION-STATE VALIDATOR
